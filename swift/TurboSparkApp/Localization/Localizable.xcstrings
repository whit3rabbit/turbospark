    "Prompt-type hooks are not run by this client. The entry is shown so the gap is visible.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يشغّل هذا العميل الخطافات من نوع المطالبة. يُعرض الإدخال حتى تكون الفجوة واضحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks vom Typ „Prompt“ werden von diesem Client nicht ausgeführt. Der Eintrag wird angezeigt, damit die Lücke sichtbar ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt-type hooks are not run by this client. The entry is shown so the gap is visible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este cliente no ejecuta los ganchos de tipo prompt. La entrada se muestra para que la carencia sea visible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce client n’exécute pas les hooks de type prompt. L’entrée est affichée pour que cette lacune soit visible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לקוח זה אינו מריץ הוקים מסוג הנחיה. הרשומה מוצגת כדי שהפער יהיה גלוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह क्लाइंट प्रॉम्प्ट-प्रकार के हुक नहीं चलाता। प्रविष्टि इसलिए दिखाई जाती है ताकि यह कमी दिखे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook bertipe prompt tidak dijalankan oleh klien ini. Entri ditampilkan agar kekurangannya terlihat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo client non esegue gli hook di tipo prompt. La voce è mostrata perché la lacuna sia visibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプト型のフックはこのクライアントでは実行されません。その差がわかるように項目を表示しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트 유형의 훅은 이 클라이언트에서 실행되지 않습니다. 이 차이를 알 수 있도록 항목을 표시합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks van het type prompt worden niet door deze client uitgevoerd. Het item wordt getoond zodat het gat zichtbaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooki typu prompt nie są uruchamiane przez tego klienta. Wpis jest widoczny, aby ta luka była jawna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooks do tipo prompt não são executados por este cliente. A entrada é exibida para que a lacuna fique visível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки типа «запрос» этот клиент не запускает. Запись показана, чтобы этот пробел был виден."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hookar av prompttyp körs inte av den här klienten. Posten visas så att luckan syns."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstem türündeki kancalar bu istemci tarafından çalıştırılmaz. Eksiklik görünsün diye giriş gösterilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хуки типу «запит» цей клієнт не запускає. Запис показано, щоб цю прогалину було видно."
          }
        },
