          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從精選目錄或 Hugging Face 在本機安裝模型。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت النماذج محليا من الكتالوج المنسق أو من Hugging Face."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקן מודלים מקומית מהקטלוג האצור או מ-Hugging Face."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्यूरेटेड कैटलॉग या Hugging Face से मॉडल स्थानीय रूप से इंस्टॉल करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer modellen lokaal vanuit de samengestelde catalogus of vanaf Hugging Face."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluj modele lokalnie z wyselekcjonowanego katalogu lub z Hugging Face."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelleri seçilmiş katalogdan veya Hugging Face'ten yerel olarak kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлюйте моделі локально з добірного каталогу або з Hugging Face."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
