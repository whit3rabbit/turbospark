    "Delete the agent file for '%@'? This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0644 \u062a\u0631\u064a\u062f \u062d\u0630\u0641 \u0645\u0644\u0641 \u0627\u0644\u0648\u0643\u064a\u0644 '%@'\u061f \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0630\u0644\u0643."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Agent-Datei f\u00fcr \u201e%@\u201c l\u00f6schen? Dies kann nicht r\u00fcckg\u00e4ngig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete the agent file for '%@'? This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfEliminar el archivo del agente '%@'? Esta acci\u00f3n no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer le fichier de l\u2019agent \u00ab %@ \u00bb ? Cette action est irr\u00e9versible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05de\u05d7\u05d5\u05e7 \u05d0\u05ea \u05e7\u05d5\u05d1\u05e5 \u05d4\u05e1\u05d5\u05db\u05df \u05e9\u05dc '%@'? \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05d8\u05dc \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0915\u0940 \u090f\u091c\u0947\u0902\u091f \u092b\u093c\u093e\u0907\u0932 \u0939\u091f\u093e\u090f\u0901? \u0907\u0938\u0947 \u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus berkas agen untuk '%@'? Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare il file dell\u2019agente '%@'? L\u2019operazione non pu\u00f2 essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u30d5\u30a1\u30a4\u30eb\u3092\u524a\u9664\u3057\u307e\u3059\u304b? \u3053\u306e\u64cd\u4f5c\u306f\u53d6\u308a\u6d88\u305b\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc758 \uc5d0\uc774\uc804\ud2b8 \ud30c\uc77c\uc744 \uc0ad\uc81c\ud560\uae4c\uc694? \uc774 \uc791\uc5c5\uc740 \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het agentbestand voor '%@' verwijderen? Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usun\u0105\u0107 plik agenta \u201e%@\u201d? Tej operacji nie mo\u017cna cofn\u0105\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir o arquivo do agente '%@'? Esta a\u00e7\u00e3o n\u00e3o pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0430\u043b\u0438\u0442\u044c \u0444\u0430\u0439\u043b \u0430\u0433\u0435\u043d\u0442\u0430 \u00ab%@\u00bb? \u042d\u0442\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta bort agentfilen f\u00f6r '%@'? Det g\u00e5r inte att \u00e5ngra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ajan dosyas\u0131 silinsin mi? Bu i\u015flem geri al\u0131namaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0434\u0430\u043b\u0438\u0442\u0438 \u0444\u0430\u0439\u043b \u0430\u0433\u0435\u043d\u0442\u0430 \u00ab%@\u00bb? \u0426\u044e \u0434\u0456\u044e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "X\u00f3a t\u1ec7p t\u00e1c t\u1eed c\u1ee7a '%@'? Kh\u00f4ng th\u1ec3 ho\u00e0n t\u00e1c thao t\u00e1c n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8981\u5220\u9664\u201c%@\u201d\u7684\u667a\u80fd\u4f53\u6587\u4ef6\u5417\uff1f\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u9500\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8981\u522a\u9664\u300c%@\u300d\u7684\u4ee3\u7406\u6a94\u6848\u55ce\uff1f\u6b64\u52d5\u4f5c\u7121\u6cd5\u5fa9\u539f\u3002"
          }
        }
      }
    },
