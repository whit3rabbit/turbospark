    "TurboSpark playback is excluded. Only audio is saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark playback is excluded. Only audio is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se excluye la reproducci\u00f3n de TurboSpark. Solo se guarda audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture de TurboSpark est exclue. Seul l'audio est enregistr\u00e9."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe von TurboSpark wird ausgeschlossen. Es wird nur Audio gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione di TurboSpark \u00e8 esclusa. Viene salvato solo l'audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodu\u00e7\u00e3o do TurboSpark \u00e9 exclu\u00edda. Apenas o \u00e1udio \u00e9 salvo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspelen door TurboSpark wordt uitgesloten. Alleen audio wordt opgeslagen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparks uppspelning utesluts. Endast ljud sparas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie TurboSpark jest wykluczone. Zapisywany jest tylko d\u017awi\u0119k."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark oynatmas\u0131 hari\u00e7 tutulur. Yaln\u0131zca ses kaydedilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutaran TurboSpark dikecualikan. Hanya audio yang disimpan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0432\u0443\u043a TurboSpark \u0438\u0441\u043a\u043b\u044e\u0447\u0451\u043d. \u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0430\u0443\u0434\u0438\u043e."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0432\u0443\u043a TurboSpark \u0432\u0438\u043a\u043b\u044e\u0447\u0435\u043d\u043e. \u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u0430\u0443\u0434\u0456\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c2m thanh ph\u00e1t t\u1eeb TurboSpark \u0111\u01b0\u1ee3c lo\u1ea1i tr\u1eeb. Ch\u1ec9 l\u01b0u \u00e2m thanh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark\u306e\u518d\u751f\u97f3\u58f0\u306f\u9664\u5916\u3055\u308c\u307e\u3059\u3002\u4fdd\u5b58\u3055\u308c\u308b\u306e\u306f\u97f3\u58f0\u306e\u307f\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \uc7ac\uc0dd\uc740 \uc81c\uc678\ub429\ub2c8\ub2e4. \uc624\ub514\uc624\ub9cc \uc800\uc7a5\ub429\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u7684\u64ad\u653e\u97f3\u9891\u4f1a\u88ab\u6392\u9664\u3002\u4ec5\u4fdd\u5b58\u97f3\u9891\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u7684\u64ad\u653e\u97f3\u8a0a\u6703\u88ab\u6392\u9664\u3002\u50c5\u5132\u5b58\u97f3\u8a0a\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0633\u062a\u062b\u0646\u0649 \u0635\u0648\u062a \u062a\u0634\u063a\u064a\u0644 TurboSpark. \u064a\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0635\u0648\u062a \u0641\u0642\u0637."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05de\u05e2 \u05e9\u05de\u05e0\u05d2\u05df TurboSpark \u05dc\u05d0 \u05e0\u05db\u05dc\u05dc. \u05e0\u05e9\u05de\u05e8 \u05e9\u05de\u05e2 \u05d1\u05dc\u05d1\u05d3."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u0915\u093e \u092a\u094d\u0932\u0947\u092c\u0948\u0915 \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0915\u0947\u0935\u0932 \u0911\u0921\u093f\u092f\u094b \u0938\u0939\u0947\u091c\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        }
      }
    },
    "Turn a recording into editable text and subtitles.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn a recording into editable text and subtitles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte una grabaci\u00f3n en texto editable y subt\u00edtulos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transformez un enregistrement en texte modifiable et en sous-titres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandle eine Aufnahme in bearbeitbaren Text und Untertitel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma una registrazione in testo modificabile e sottotitoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme uma grava\u00e7\u00e3o em texto edit\u00e1vel e legendas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een opname om in bewerkbare tekst en ondertitels."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omvandla en inspelning till redigerbar text och undertexter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamie\u0144 nagranie na edytowalny tekst i napisy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kayd\u0131 d\u00fczenlenebilir metne ve altyaz\u0131lara d\u00f6n\u00fc\u015ft\u00fcr\u00fcn."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah rekaman menjadi teks yang dapat disunting dan subtitel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0439\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u044c \u0432 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u0443\u0435\u043c\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \u0438 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u044b."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0441 \u043d\u0430 \u0440\u0435\u0434\u0430\u0433\u043e\u0432\u0430\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u0456 \u0441\u0443\u0431\u0442\u0438\u0442\u0440\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuy\u1ec3n b\u1ea3n ghi th\u00e0nh v\u0103n b\u1ea3n c\u00f3 th\u1ec3 ch\u1ec9nh s\u1eeda v\u00e0 ph\u1ee5 \u0111\u1ec1."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9332\u97f3\u3092\u7de8\u96c6\u53ef\u80fd\u306a\u30c6\u30ad\u30b9\u30c8\u3068\u5b57\u5e55\u306b\u5909\u63db\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub179\uc74c\uc744 \ud3b8\uc9d1 \uac00\ub2a5\ud55c \ud14d\uc2a4\ud2b8\uc640 \uc790\ub9c9\uc73c\ub85c \ubcc0\ud658\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u5f55\u97f3\u8f6c\u6362\u4e3a\u53ef\u7f16\u8f91\u7684\u6587\u672c\u548c\u5b57\u5e55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u9304\u97f3\u8f49\u63db\u70ba\u53ef\u7de8\u8f2f\u7684\u6587\u5b57\u548c\u5b57\u5e55\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u0648\u0651\u0644 \u062a\u0633\u062c\u064a\u0644\u0627\u064b \u0625\u0644\u0649 \u0646\u0635 \u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u0639\u062f\u064a\u0644 \u0648\u062a\u0631\u062c\u0645\u0629."
