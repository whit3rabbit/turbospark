    "Large paste attached as \"%@\" (%lld characters).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0625\u0631\u0641\u0627\u0642 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u0644\u0635\u0642 \u0627\u0644\u0643\u0628\u064a\u0631 \u0628\u0627\u0633\u0645 \"%@\" (%lld \u062d\u0631\u0641\u064b\u0627)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gro\u00dfer eingef\u00fcgter Text als \"%@\" angeh\u00e4ngt (%lld Zeichen)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Large paste attached as \"%@\" (%lld characters)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se adjunt\u00f3 el texto pegado grande como \"%@\" (%lld caracteres)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Grand collage joint sous le nom \"%@\" (%lld caract\u00e8res)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d3\u05d1\u05e7\u05d4 \u05d2\u05d3\u05d5\u05dc\u05d4 \u05e6\u05d5\u05e8\u05e4\u05d4 \u05d1\u05e9\u05dd \"%@\" (%lld \u05ea\u05d5\u05d5\u05d9\u05dd)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0921\u093c\u093e \u092a\u0947\u0938\u094d\u091f \"%@\" \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0938\u0902\u0932\u0917\u094d\u0928 \u0915\u093f\u092f\u093e \u0917\u092f\u093e (%lld \u0935\u0930\u094d\u0923)\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks tempelan besar dilampirkan sebagai \"%@\" (%lld karakter)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Grande testo incollato allegato come \"%@\" (%lld caratteri)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5927\u304d\u306a\u8cbc\u308a\u4ed8\u3051\u30c6\u30ad\u30b9\u30c8\u3092\u300c%@\u300d\uff08%lld \u6587\u5b57\uff09\u3068\u3057\u3066\u6dfb\u4ed8\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud070 \ubd99\uc5ec\ub123\uae30 \ud14d\uc2a4\ud2b8\uac00 \"%@\"(%lld\uc790)\ub85c \ucca8\ubd80\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grote plaktekst bijgevoegd als \"%@\" (%lld tekens)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Du\u017cy wklejony tekst do\u0142\u0105czono jako \"%@\" (%lld znak\u00f3w)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto colado grande anexado como \"%@\" (%lld caracteres)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u043e\u043b\u044c\u0448\u043e\u0439 \u0432\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0451\u043d \u043a\u0430\u043a \"%@\" (%lld \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stor inklistrad text bifogad som \"%@\" (%lld tecken)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fcy\u00fck yap\u0131\u015ft\u0131r\u0131lan metin \"%@\" olarak eklendi (%lld karakter)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u043b\u0438\u043a\u0438\u0439 \u0432\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u043f\u0440\u0438\u043a\u0440\u0456\u043f\u043b\u0435\u043d\u043e \u044f\u043a \"%@\" (%lld \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u0103n b\u1ea3n d\u00e1n l\u1edbn \u0111\u00e3 \u0111\u01b0\u1ee3c \u0111\u00ednh k\u00e8m d\u01b0\u1edbi d\u1ea1ng \"%@\" (%lld k\u00fd t\u1ef1)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5c06\u5927\u6bb5\u7c98\u8d34\u6587\u672c\u9644\u52a0\u4e3a\u201c%@\u201d\uff08%lld \u4e2a\u5b57\u7b26\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5c07\u5927\u6bb5\u8cbc\u4e0a\u6587\u5b57\u9644\u52a0\u70ba\u300c%@\u300d\uff08%lld \u500b\u5b57\u5143\uff09\u3002"
          }
        }
      }
    },
