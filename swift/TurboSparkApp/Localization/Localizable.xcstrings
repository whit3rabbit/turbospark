    "Speech recognition is off for TurboSpark. Turn it on in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0627\u0644\u0643\u0644\u0627\u0645 \u0645\u062a\u0648\u0642\u0641 \u0644\u0640 TurboSpark. \u0634\u063a\u0651\u0644\u0647 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645."
          }
        },
        "de": {
          "stringUnit": {
