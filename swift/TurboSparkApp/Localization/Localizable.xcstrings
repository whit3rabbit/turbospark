    "measured on %@, not this machine. Rates do not transfer across silicon.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u064a\u0633 \u0639\u0644\u0649 %@\u060c \u0648\u0644\u064a\u0633 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632. \u0644\u0627 \u062a\u0646\u062a\u0642\u0644 \u0627\u0644\u0645\u0639\u062f\u0644\u0627\u062a \u0628\u064a\u0646 \u0627\u0644\u0634\u0631\u0627\u0626\u062d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "gemessen auf %@, nicht auf diesem Ger\u00e4t. Raten lassen sich nicht auf andere Chips \u00fcbertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "measured on %@, not this machine. Rates do not transfer across silicon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "medido en %@, no en este equipo. Las velocidades no se trasladan entre chips."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "mesur\u00e9 sur %@, pas sur cette machine. Les d\u00e9bits ne se transposent pas d\u2019une puce \u00e0 l\u2019autre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05de\u05d3\u05d3 \u05e2\u05dc %@, \u05dc\u05d0 \u05d1\u05de\u05db\u05e9\u05d9\u05e8 \u05d4\u05d6\u05d4. \u05e7\u05e6\u05d1\u05d9\u05dd \u05d0\u05d9\u05e0\u05dd \u05e2\u05d5\u05d1\u05e8\u05d9\u05dd \u05d1\u05d9\u05df \u05e9\u05d1\u05d1\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u092a\u0930 \u092e\u093e\u092a\u093e \u0917\u092f\u093e, \u0907\u0938 \u092e\u0936\u0940\u0928 \u092a\u0930 \u0928\u0939\u0940\u0902\u0964 \u0917\u0924\u093f \u090f\u0915 \u091a\u093f\u092a \u0938\u0947 \u0926\u0942\u0938\u0930\u0940 \u091a\u093f\u092a \u092a\u0930 \u0932\u093e\u0917\u0942 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "diukur di %@, bukan mesin ini. Kecepatan tidak berlaku lintas chip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "misurato su %@, non su questa macchina. Le velocit\u00e0 non si trasferiscono tra chip diversi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30de\u30b7\u30f3\u3067\u306f\u306a\u304f %@ \u3067\u8a08\u6e2c\u3002\u901f\u5ea6\u306f\u30c1\u30c3\u30d7\u9593\u3067\u901a\u7528\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uae30\uae30\uac00 \uc544\ub2cc %@\uc5d0\uc11c \uce21\uc815\ud588\uc2b5\ub2c8\ub2e4. \uc18d\ub3c4\ub294 \uce69 \uac04\uc5d0 \uadf8\ub300\ub85c \uc801\uc6a9\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "gemeten op %@, niet op deze machine. Snelheden zijn niet overdraagbaar tussen chips."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "zmierzono na %@, nie na tym komputerze. Szybko\u015bci nie przenosz\u0105 si\u0119 mi\u0119dzy chipami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "medido em %@, n\u00e3o nesta m\u00e1quina. As taxas n\u00e3o se transferem entre chips."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0438\u0437\u043c\u0435\u0440\u0435\u043d\u043e \u043d\u0430 %@, \u0430 \u043d\u0435 \u043d\u0430 \u044d\u0442\u043e\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435. \u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u043d\u0435 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442\u0441\u044f \u043c\u0435\u0436\u0434\u0443 \u0447\u0438\u043f\u0430\u043c\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "uppm\u00e4tt p\u00e5 %@, inte p\u00e5 den h\u00e4r datorn. Hastigheter g\u00e5r inte att \u00f6verf\u00f6ra mellan chip."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu makinede de\u011fil, %@ \u00fczerinde \u00f6l\u00e7\u00fcld\u00fc. H\u0131zlar \u00e7ipler aras\u0131nda aktar\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0432\u0438\u043c\u0456\u0440\u044f\u043d\u043e \u043d\u0430 %@, \u0430 \u043d\u0435 \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u043a\u043e\u043c\u043f\u2019\u044e\u0442\u0435\u0440\u0456. \u0428\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u043d\u0435 \u043f\u0435\u0440\u0435\u043d\u043e\u0441\u0438\u0442\u044c\u0441\u044f \u043c\u0456\u0436 \u0447\u0438\u043f\u0430\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0111o tr\u00ean %@, kh\u00f4ng ph\u1ea3i m\u00e1y n\u00e0y. T\u1ed1c \u0111\u1ed9 kh\u00f4ng \u00e1p d\u1ee5ng \u0111\u01b0\u1ee3c gi\u1eefa c\u00e1c chip."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 %@ \u4e0a\u6d4b\u5f97\uff0c\u5e76\u975e\u672c\u673a\u3002\u901f\u7387\u4e0d\u80fd\u8de8\u82af\u7247\u5957\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 %@ \u4e0a\u6e2c\u5f97\uff0c\u4e26\u975e\u672c\u6a5f\u3002\u901f\u7387\u4e0d\u80fd\u8de8\u6676\u7247\u5957\u7528\u3002"
          }
        }
      }
    },
