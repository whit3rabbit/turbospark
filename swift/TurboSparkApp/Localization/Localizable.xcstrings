            "value": "\u63a2\u6d4b\u5b8c\u6210\u3002\u62a5\u544a\u5df2\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a2\u6e2c\u5b8c\u6210\u3002\u5831\u544a\u5df2\u53ef\u7528\u3002"
