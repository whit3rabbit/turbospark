    "I understand this ZIP is not encrypted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0641\u0647\u0645 \u0623\u0646 \u0645\u0644\u0641 ZIP \u0647\u0630\u0627 \u063a\u064a\u0631 \u0645\u0634\u0641\u0631"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mir ist klar, dass diese ZIP-Datei nicht verschl\u00fcsselt ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand this ZIP is not encrypted"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entiendo que este ZIP no est\u00e1 cifrado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je comprends que ce ZIP n'est pas chiffr\u00e9"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05e0\u05d9 \u05de\u05d1\u05d9\u05df/\u05d4 \u05e9\u05e7\u05d5\u05d1\u05e5 \u05d4-ZIP \u05d4\u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05e6\u05e4\u05df"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0948\u0902 \u0938\u092e\u091d\u0924\u093e/\u0938\u092e\u091d\u0924\u0940 \u0939\u0942\u0902 \u0915\u093f \u092f\u0939 ZIP \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u0928\u0939\u0940\u0902 \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya mengerti ZIP ini tidak dienkripsi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho capito che questo ZIP non \u00e8 cifrato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e ZIP \u304c\u6697\u53f7\u5316\u3055\u308c\u3066\u3044\u306a\u3044\u3053\u3068\u3092\u7406\u89e3\u3057\u307e\u3057\u305f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 ZIP\uc774 \uc554\ud638\ud654\ub418\uc9c0 \uc54a\uc558\uc74c\uc744 \uc774\ud574\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik begrijp dat deze ZIP niet versleuteld is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumiem, \u017ce ten plik ZIP nie jest zaszyfrowany"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entendo que este ZIP n\u00e3o \u00e9 criptografado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043f\u043e\u043d\u0438\u043c\u0430\u044e, \u0447\u0442\u043e \u044d\u0442\u043e\u0442 ZIP \u043d\u0435 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag f\u00f6rst\u00e5r att denna ZIP inte \u00e4r krypterad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
