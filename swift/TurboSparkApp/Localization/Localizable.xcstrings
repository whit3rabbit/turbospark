    "Authenticate to inspect and download gated or private repositories.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول لفحص المستودعات المقيدة أو الخاصة وتنزيلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizieren Sie sich, um gesperrte oder private Repositorys zu prüfen und herunterzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticate to inspect and download gated or private repositories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentícate para inspeccionar y descargar repositorios restringidos o privados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiez-vous pour inspecter et télécharger des dépôts restreints ou privés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בצע אימות כדי לבדוק ולהוריד מאגרים מוגבלים או פרטיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रतिबंधित या निजी रिपॉजिटरी देखने और डाउनलोड करने के लिए प्रमाणीकरण करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi untuk memeriksa dan mengunduh repositori terbatas atau privat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticati per ispezionare e scaricare repository con accesso limitato o privati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "制限付きまたは非公開のリポジトリを検査してダウンロードするには認証してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제한되거나 비공개인 리포지토리를 확인하고 다운로드하려면 인증하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer om afgeschermde of privérepository's te bekijken en te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnij się, aby przeglądać i pobierać repozytoria z ograniczonym dostępem lub prywatne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentique-se para inspecionar e baixar repositórios restritos ou privados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдите аутентификацию, чтобы просматривать и загружать закрытые или приватные репозитории."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentisera dig för att granska och ladda ned begränsade eller privata utvecklingskataloger."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısıtlı veya özel depoları incelemek ve indirmek için kimlik doğrulaması yapın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдіть автентифікацію, щоб переглядати та завантажувати обмежені або приватні репозиторії."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác thực để kiểm tra và tải xuống kho lưu trữ bị hạn chế hoặc riêng tư."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "进行认证以检查和下载受限或私有仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "進行驗證以檢查並下載受限或私有儲存庫。"
          }
        }
      }
    },
