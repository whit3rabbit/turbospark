        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc178 \uba85\ub839\uc744 \uc2e4\ud589\ud558\uae30 \uc804\uc5d0 \ud604\uc7ac \ud134\uc744 \uc911\uc9c0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop de huidige beurt voordat je een shell-opdracht uitvoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj bie\u017c\u0105c\u0105 tur\u0119 przed uruchomieniem polecenia pow\u0142oki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompa o turno atual antes de executar um comando de shell."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0442\u0435\u043a\u0443\u0449\u0438\u0439 \u0445\u043e\u0434 \u043f\u0435\u0440\u0435\u0434 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435\u043c \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa den aktuella turen innan du k\u00f6r ett skalkommando."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabuk komutu \u00e7al\u0131\u015ft\u0131rmadan \u00f6nce ge\u00e7erli turu durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 \u0445\u0456\u0434 \u043f\u0435\u0440\u0435\u0434 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f\u043c \u043a\u043e\u043c\u0430\u043d\u0434\u0438 \u043e\u0431\u043e\u043b\u043e\u043d\u043a\u0438."
          }
