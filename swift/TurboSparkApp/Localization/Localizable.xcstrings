    "Encrypted backup restored as a locked profile.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645\u062a \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0627\u0644\u0645\u0634\u0641\u0631\u0629 \u0643\u0645\u0644\u0641 \u0634\u062e\u0635\u064a \u0645\u0642\u0641\u0644."
