    "Compact at completed todo boundaries": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0636\u063a\u0637 \u0639\u0646\u062f \u062d\u062f\u0648\u062f \u0627\u0644\u0645\u0647\u0627\u0645 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An Grenzen abgeschlossener Aufgaben komprimieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compact at completed todo boundaries"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Compactar al completar tareas pendientes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compacter aux limites des t\u00e2ches termin\u00e9es"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d3\u05d7\u05d5\u05e1 \u05d1\u05d2\u05d1\u05d5\u05dc\u05d5\u05ea \u05de\u05e9\u05d9\u05de\u05d5\u05ea \u05e9\u05d4\u05d5\u05e9\u05dc\u05de\u05d5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0942\u0930\u0947 \u0915\u093f\u090f \u0917\u090f \u0915\u093e\u0930\u094d\u092f \u0938\u0940\u092e\u093e\u0913\u0902 \u092a\u0930 \u0938\u0902\u0915\u0941\u091a\u093f\u0924 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Padatkan pada batas tugas yang sudah selesai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatta ai limiti delle attivit\u00e0 completate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u4e86\u3057\u305f\u30bf\u30b9\u30af\u306e\u5883\u754c\u3067\u5727\u7e2e"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc644\ub8cc\ub41c \ud560 \uc77c \uacbd\uacc4\uc5d0\uc11c \uc555\ucd95"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprimeren bij voltooide todo-grenzen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompaktuj na granicach uko\u0144czonych zada\u0144"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compactar nos limites de tarefas conclu\u00eddas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043c\u043f\u0430\u043a\u0442\u0438\u0444\u0438\u0446\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043f\u043e \u0433\u0440\u0430\u043d\u0438\u0446\u0430\u043c \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u0434\u0430\u0447"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Komprimera vid gr\u00e4nser f\u00f6r slutf\u00f6rda uppgifter"
