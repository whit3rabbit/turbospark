          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc801\uc6a9\ud558\ub824\uba74 \ub2e4\uc2dc \ub85c\ub4dc"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
