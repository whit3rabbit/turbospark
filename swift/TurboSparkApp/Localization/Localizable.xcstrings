            "value": "Explora un marketplace o añade una carpeta local que contenga .claude-plugin/plugin.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez une place de marché ou ajoutez un dossier local contenant .claude-plugin/plugin.json."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עיין במרכז או הוסף תיקייה מקומית שמכילה ‎.claude-plugin/plugin.json."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मार्केटप्लेस ब्राउज़ करें, या .claude-plugin/plugin.json वाला स्थानीय फ़ोल्डर जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi marketplace, atau tambahkan folder lokal yang berisi .claude-plugin/plugin.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora un marketplace o aggiungi una cartella locale che contenga .claude-plugin/plugin.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マーケットプレイスを参照するか、.claude-plugin/plugin.json を含むローカルフォルダを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마켓플레이스를 살펴보거나 .claude-plugin/plugin.json이 있는 로컬 폴더를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blader door een marktplaats of voeg een lokale map toe met .claude-plugin/plugin.json."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeglądaj marketplace lub dodaj folder lokalny zawierający .claude-plugin/plugin.json."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue por um marketplace ou adicione uma pasta local que contenha .claude-plugin/plugin.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просмотрите маркетплейс или добавьте локальную папку с файлом .claude-plugin/plugin.json."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bläddra i en marknadsplats eller lägg till en lokal mapp som innehåller .claude-plugin/plugin.json."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pazarı inceleyin veya .claude-plugin/plugin.json içeren yerel bir klasör ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перегляньте маркетплейс або додайте локальну папку з файлом .claude-plugin/plugin.json."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyệt chợ, hoặc thêm thư mục cục bộ chứa .claude-plugin/plugin.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览市场，或添加包含 .claude-plugin/plugin.json 的本地文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
