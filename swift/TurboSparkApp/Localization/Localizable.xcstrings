          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05d4\u05d9\u05d4 \u05dc\u05d4\u05e2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05dc\u05e4\u05d7 \u05d4\u05d0\u05e9\u05e4\u05d4: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0915\u094b \u091f\u094d\u0930\u0948\u0936 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0932\u0947 \u091c\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u093e: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat memindahkan folder profil ke Tong Sampah: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile spostare la cartella del profilo nel Cestino: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u30d5\u30a9\u30eb\u30c0\u3092\u30b4\u30df\u7bb1\u306b\u79fb\u52d5\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\ud544 \ud3f4\ub354\ub97c \ud734\uc9c0\ud1b5\uc73c\ub85c \uc774\ub3d9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de profielmap niet naar de prullenmand verplaatsen: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna przenie\u015b\u0107 folderu profilu do Kosza: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel mover a pasta do perfil para o Lixo: %@"
          }
        },
        "ru": {
