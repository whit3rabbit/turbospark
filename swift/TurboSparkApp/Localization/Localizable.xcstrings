        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель будет удалена с этого Mac. Режим, который её использует, перейдёт на другую установленную модель. Ваши расшифровки останутся без изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort modellen från den här Macen. Ett läge som använder den byter till en annan installerad modell. Dina transkriptioner förblir som de är."
