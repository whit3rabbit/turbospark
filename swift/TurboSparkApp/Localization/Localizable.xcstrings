        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u0434\u0435\u043b\u044c\u043d\u044b\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438, \u0447\u0430\u0442\u044b, \u043d\u0430\u0432\u044b\u043a\u0438, \u043f\u043b\u0430\u0433\u0438\u043d\u044b \u0438 \u0441\u0435\u0440\u0432\u0435\u0440\u044b MCP."
