        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u0938\u0947 30 \u0938\u0947\u0915\u0902\u0921 \u0915\u093e \u0938\u0902\u0926\u0930\u094d\u092d \u092d\u093e\u0937\u0923 \u091a\u0941\u0928\u0947\u0902\u0964"
