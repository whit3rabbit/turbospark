        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0440\u0441\u0438\u044f \u044d\u0442\u043e\u0433\u043e \u0434\u0432\u0438\u0436\u043a\u0430, \u0430 \u043d\u0435 Ollama."
