        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d2\u05d6\u05d5\u05e8 \u05d0\u05ea \u05d4\u05de\u05e4\u05ea\u05d7 \u05de\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05e1\u05d9\u05e1\u05de\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u093e\u0938\u092b\u093c\u094d\u0930\u0947\u091c\u093c \u0938\u0947 \u0915\u0941\u0902\u091c\u0940 \u0935\u094d\u092f\u0941\u0924\u094d\u092a\u0928\u094d\u0928 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e \u0938\u0915\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci frasa sandi tidak dapat diturunkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile derivare la chiave dalla passphrase."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d1\u30b9\u30d5\u30ec\u30fc\u30ba\u304b\u3089\u9375\u3092\u5c0e\u51fa\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc554\ud638\uc5d0\uc11c \ud0a4\ub97c \ud30c\uc0dd\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de sleutel niet afleiden uit de wachtzin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna wyprowadzi\u0107 klucza z has\u0142a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel derivar a chave da frase secreta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u043e\u043b\u0443\u0447\u0438\u0442\u044c \u043a\u043b\u044e\u0447 \u0438\u0437 \u0444\u0440\u0430\u0437\u044b-\u043f\u0430\u0440\u043e\u043b\u044f."
