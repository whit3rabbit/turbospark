    "Supports chain-of-thought and internal reasoning extraction": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062f\u0639\u0645 \u0633\u0644\u0633\u0644\u0629 \u0627\u0644\u0623\u0641\u0643\u0627\u0631 \u0648\u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0627\u0644\u0627\u0633\u062a\u062f\u0644\u0627\u0644 \u0627\u0644\u062f\u0627\u062e\u0644\u064a"
          }
        },
        "de": {
