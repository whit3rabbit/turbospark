          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище моделей находится на '%@', который не подключён. Подключите диск или переместите хранилище моделей в настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellarkivet finns på '%@', som inte är anslutet. Anslut enheten eller flytta modellarkivet i Inställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
