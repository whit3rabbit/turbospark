          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Testuj po\u0142\u0105czenie i wykryj narz\u0119dzia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Testar conex\u00e3o e descobrir ferramentas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435 \u0438 \u043d\u0430\u0439\u0442\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Testa anslutningen och hitta verktyg"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u011flant\u0131y\u0131 test et ve ara\u00e7lar\u0131 ke\u015ffet"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0437'\u0454\u0434\u043d\u0430\u043d\u043d\u044f \u0442\u0430 \u0437\u043d\u0430\u0439\u0442\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki\u1ec3m tra k\u1ebft n\u1ed1i v\u00e0 t\u00ecm c\u00f4ng c\u1ee5"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6d4b\u8bd5\u8fde\u63a5\u5e76\u53d1\u73b0\u5de5\u5177"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e2c\u8a66\u9023\u7dda\u4e26\u63a2\u7d22\u5de5\u5177"
          }
        }
      }
    },
