    "Glob patterns that will trigger activation when editing matching files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0646\u0645\u0627\u0637 glob \u0627\u0644\u062a\u064a \u0633\u062a\u064f\u0634\u063a\u0651\u0644 \u0627\u0644\u062a\u0641\u0639\u064a\u0644 \u0639\u0646\u062f \u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0637\u0627\u0628\u0642\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glob-Muster, die beim Bearbeiten passender Dateien die Aktivierung ausl\u00f6sen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glob patterns that will trigger activation when editing matching files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrones glob que activar\u00e1n la habilidad al editar archivos coincidentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motifs glob qui d\u00e9clencheront l'activation lors de la modification des fichiers correspondants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d1\u05e0\u05d9\u05d5\u05ea glob \u05e9\u05d9\u05e4\u05e2\u05d9\u05dc\u05d5 \u05d0\u05ea \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4 \u05d1\u05e2\u05ea \u05e2\u05e8\u05d9\u05db\u05ea \u05e7\u05d1\u05e6\u05d9\u05dd \u05ea\u05d5\u05d0\u05de\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u094d\u0932\u094b\u092c \u092a\u0948\u091f\u0930\u094d\u0928 \u091c\u094b \u092e\u0947\u0932 \u0916\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0938\u0915\u094d\u0930\u093f\u092f\u0923 \u091f\u094d\u0930\u093f\u0917\u0930 \u0915\u0930\u0947\u0902\u0917\u0947\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola glob yang akan memicu aktivasi saat mengedit berkas yang cocok."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pattern glob che attiveranno l'abilit\u00e0 quando modifichi file corrispondenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u81f4\u3059\u308b\u30d5\u30a1\u30a4\u30eb\u3092\u7de8\u96c6\u3057\u305f\u3068\u304d\u306b\u30a2\u30af\u30c6\u30a3\u30d9\u30fc\u30b7\u30e7\u30f3\u3092\u767a\u52d5\u3055\u305b\u308b glob \u30d1\u30bf\u30fc\u30f3\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\uce58\ud558\ub294 \ud30c\uc77c\uc744 \ud3b8\uc9d1\ud560 \ub54c \ud65c\uc131\ud654\ub97c \ud2b8\ub9ac\uac70\ud558\ub294 glob \ud328\ud134\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glob-patronen die activering starten bij het bewerken van overeenkomende bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzorce glob, kt\u00f3re wyzwol\u0105 aktywacj\u0119 podczas edycji pasuj\u0105cych plik\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padr\u00f5es glob que acionar\u00e3o a ativa\u00e7\u00e3o ao editar arquivos correspondentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0430\u0431\u043b\u043e\u043d\u044b glob, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u044e\u0442 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u044e \u043f\u0440\u0438 \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0438 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u0444\u0430\u0439\u043b\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glob-m\u00f6nster som utl\u00f6ser aktivering n\u00e4r matchande filer redigeras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u015fle\u015fen dosyalar d\u00fczenlendi\u011finde etkinle\u015ftirmeyi tetikleyecek glob desenleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0430\u0431\u043b\u043e\u043d\u0438 glob, \u044f\u043a\u0456 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u044e\u0442\u044c \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u044e \u043f\u0456\u0434 \u0447\u0430\u0441 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0445 \u0444\u0430\u0439\u043b\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c m\u1eabu glob s\u1ebd k\u00edch ho\u1ea1t khi b\u1ea1n ch\u1ec9nh s\u1eeda t\u1ec7p kh\u1edbp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f16\u8f91\u5339\u914d\u6587\u4ef6\u65f6\u5c06\u89e6\u53d1\u6fc0\u6d3b\u7684 glob \u6a21\u5f0f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7de8\u8f2f\u7b26\u5408\u7684\u6a94\u6848\u6642\u5c07\u89f8\u767c\u555f\u7528\u7684 glob \u6a21\u5f0f\u3002"
          }
        }
      }
    },
    "Global personality and communication guidance for the agent.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0631\u0634\u0627\u062f\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0648\u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0639\u0627\u0645\u0629 \u0644\u0644\u0648\u0643\u064a\u0644."
          }
        },
        "de": {
