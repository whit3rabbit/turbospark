        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u091a\u0948\u091f \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940\u0902\u0964"
