        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea, \u05e6'\u05d0\u05d8\u05d9\u05dd, \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea, \u05ea\u05d5\u05e1\u05e4\u05d9\u05dd \u05d5\u05e9\u05e8\u05ea\u05d9 MCP \u05e2\u05e6\u05de\u05d0\u05d9\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0935\u0924\u0902\u0924\u094d\u0930 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938, \u091a\u0948\u091f, \u0938\u094d\u0915\u093f\u0932, \u092a\u094d\u0932\u0917\u0907\u0928 \u0914\u0930 MCP \u0938\u0930\u094d\u0935\u0930\u0964"
          }
        },
        "id": {
          "stringUnit": {
