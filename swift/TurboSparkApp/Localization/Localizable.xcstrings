    "Repair malformed dialect calls and validate schemas": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0635\u0644\u0627\u062d \u0627\u0633\u062a\u062f\u0639\u0627\u0621\u0627\u062a \u0627\u0644\u0644\u0647\u062c\u0629 \u0627\u0644\u0645\u0634\u0648\u0647\u0629 \u0648\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u062e\u0637\u0637\u0627\u062a"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlerhafte Dialektaufrufe reparieren und Schemata validieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair malformed dialect calls and validate schemas"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparar llamadas de dialecto mal formadas y validar esquemas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9parer les appels de dialecte mal form\u00e9s et valider les sch\u00e9mas"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05e7\u05df \u05e7\u05e8\u05d9\u05d0\u05d5\u05ea \u05d3\u05d9\u05d0\u05dc\u05e7\u05d8 \u05e4\u05d2\u05d5\u05de\u05d5\u05ea \u05d5\u05d0\u05de\u05ea \u05e1\u05db\u05de\u05d5\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093f\u0915\u0943\u0924 \u0921\u093e\u092f\u0932\u0947\u0915\u094d\u091f \u0915\u0949\u0932 \u0938\u0941\u0927\u093e\u0930\u0947\u0902 \u0914\u0930 \u0938\u094d\u0915\u0940\u092e\u093e \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perbaiki panggilan dialek yang rusak dan validasi skema"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripara le chiamate di dialetto malformate e convalida gli schemi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u6b63\u306a\u5f62\u5f0f\u306e\u30c0\u30a4\u30a2\u30ec\u30af\u30c8\u547c\u3073\u51fa\u3057\u3092\u4fee\u5fa9\u3057\u3001\u30b9\u30ad\u30fc\u30de\u3092\u691c\u8a3c\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud615\uc2dd\uc774 \uc798\ubabb\ub41c \ub2e4\uc774\uc5bc\ub809\ud2b8 \ud638\ucd9c\uc744 \ubcf5\uad6c\ud558\uace0 \uc2a4\ud0a4\ub9c8\ub97c \uac80\uc99d"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onjuist gevormde dialectaanroepen herstellen en schema's valideren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naprawiaj zniekszta\u0142cone wywo\u0142ania dialektu i sprawdzaj schematy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparar chamadas de dialeto malformadas e validar esquemas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u044c \u043d\u0435\u043a\u043e\u0440\u0440\u0435\u043a\u0442\u043d\u044b\u0435 \u0432\u044b\u0437\u043e\u0432\u044b \u0434\u0438\u0430\u043b\u0435\u043a\u0442\u0430 \u0438 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0442\u044c \u0441\u0445\u0435\u043c\u044b"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Reparera felformade dialektanrop och validera scheman"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozuk leh\u00e7e \u00e7a\u011fr\u0131lar\u0131n\u0131 onar\u0131n ve \u015femalar\u0131 do\u011frulay\u0131n"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043f\u0440\u0430\u0432\u043b\u044f\u0442\u0438 \u043d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0456 \u0432\u0438\u043a\u043b\u0438\u043a\u0438 \u0434\u0456\u0430\u043b\u0435\u043a\u0442\u0443 \u0442\u0430 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0442\u0438 \u0441\u0445\u0435\u043c\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u1eeda c\u00e1c l\u1ec7nh g\u1ecdi dialect sai \u0111\u1ecbnh d\u1ea1ng v\u00e0 x\u00e1c th\u1ef1c l\u01b0\u1ee3c \u0111\u1ed3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fee\u590d\u683c\u5f0f\u9519\u8bef\u7684\u65b9\u8a00\u8c03\u7528\u5e76\u6821\u9a8c\u67b6\u6784"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fee\u5fa9\u683c\u5f0f\u932f\u8aa4\u7684\u65b9\u8a00\u547c\u53eb\u4e26\u9a57\u8b49\u7d50\u69cb\u63cf\u8ff0"
