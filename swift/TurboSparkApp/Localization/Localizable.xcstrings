        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d5\u05e8\u05d9\u05d3 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d5\u05de\u05ea\u05d7\u05d9\u05dc \u05d0\u05d9\u05ea\u05d5 \u05e6'\u05d0\u05d8 \u05d7\u05d3\u05e9"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0909\u0938\u0915\u0947 \u0938\u093e\u0925 \u0928\u0908 \u091a\u0948\u091f \u0936\u0941\u0930\u0942 \u0915\u0930\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh model dan memulai obrolan baru dengannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il modello e avvia una nuova chat con esso"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3001\u305d\u306e\u30e2\u30c7\u30eb\u3067\u65b0\u3057\u3044\u30c1\u30e3\u30c3\u30c8\u3092\u958b\u59cb\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uc0c8 \ucc44\ud305\uc744 \uc2dc\uc791\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
