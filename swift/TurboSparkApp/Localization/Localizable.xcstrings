    "Speech recognition is off for TurboSpark. Turn it on in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التعرّف على الكلام متوقف لـ TurboSpark. شغّله من إعدادات النظام."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist für TurboSpark deaktiviert. Aktiviere sie in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is off for TurboSpark. Turn it on in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz está desactivado para TurboSpark. Actívalo en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est désactivée pour TurboSpark. Activez-la dans Réglages Système."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זיהוי הדיבור כבוי עבור TurboSpark. הפעל אותו בהגדרות המערכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark के लिए वाक् पहचान बंद है। इसे सिस्टम सेटिंग्स में चालू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan ucapan untuk TurboSpark nonaktif. Aktifkan di Pengaturan Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale è disattivato per TurboSpark. Attivalo in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark の音声認識はオフです。システム設定でオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark의 음성 인식이 꺼져 있습니다. 시스템 설정에서 켜세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning staat uit voor TurboSpark. Zet deze aan in Systeeminstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy jest wyłączone dla TurboSpark. Włącz je w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala está desativado para o TurboSpark. Ative-o nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Распознавание речи для TurboSpark выключено. Включите его в Системных настройках."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taligenkänning är avstängd för TurboSpark. Slå på den i Systeminställningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark için konuşma tanıma kapalı. Sistem Ayarları'ndan açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розпізнавання мовлення для TurboSpark вимкнено. Увімкніть його в Системних параметрах."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận dạng giọng nói đang tắt đối với TurboSpark. Hãy bật trong Cài đặt hệ thống."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
