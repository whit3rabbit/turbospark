        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc694\uccad \uc2dc \uc774 \ud0a4\ub97c \ubcf4\ub0b4\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
