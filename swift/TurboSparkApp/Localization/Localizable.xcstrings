    "Some attached files may not fit the free context window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا تتناسب بعض الملفات المرفقة مع المساحة الحرة لنافذة السياق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige angehängte Dateien passen möglicherweise nicht in den freien Platz des Kontextfensters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some attached files may not fit the free context window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que algunos archivos adjuntos no quepan en el espacio libre de la ventana de contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers joints peuvent ne pas tenir dans l'espace libre de la fenêtre de contexte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שחלק מהקבצים המצורפים לא ייכנסו למקום הפנוי בחלון ההקשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ संलग्न फ़ाइलें संदर्भ विंडो के खाली स्थान में नहीं आ सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa file terlampir mungkin tidak muat di ruang kosong jendela konteks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni file allegati potrebbero non entrare nello spazio libero della finestra di contesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の添付ファイルはコンテキストウィンドウの空き容量に収まらない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 첨부 파일은 컨텍스트 창의 여유 공간에 맞지 않을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige bijgevoegde bestanden passen mogelijk niet in de vrije ruimte van het contextvenster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre załączone pliki mogą nie zmieścić się w wolnym miejscu okna kontekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos anexados podem não caber no espaço livre da janela de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые прикреплённые файлы могут не поместиться в свободное место контекстного окна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa bifogade filer kanske inte får plats i det lediga utrymmet i kontextfönstret."
          }
        },
        "tr": {
