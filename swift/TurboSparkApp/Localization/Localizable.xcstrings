        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043a\u0440\u0438\u0442\u0442\u044f \u043c\u043e\u0434\u0435\u043b\u0456: \u0437\u0447\u0438\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0430\u0433 \u0456 \u0432\u0438\u0434\u0456\u043b\u0435\u043d\u043d\u044f KV-\u043a\u0435\u0448\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110ang m\u1edf m\u00f4 h\u00ecnh: \u0111\u1ecdc tr\u1ecdng s\u1ed1 v\u00e0 c\u1ea5p ph\u00e1t b\u1ed9 nh\u1edb \u0111\u1ec7m KV"
          }
        },
        "zh-Hans": {
          "stringUnit": {
