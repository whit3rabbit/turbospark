          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar\u0131na @ ile ba\u015fvurmak i\u00e7in bir proje a\u00e7\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u043f\u0440\u043e\u0454\u043a\u0442, \u0449\u043e\u0431 \u043f\u043e\u0441\u0438\u043b\u0430\u0442\u0438\u0441\u044f \u043d\u0430 \u0439\u043e\u0433\u043e \u0444\u0430\u0439\u043b\u0438 \u0447\u0435\u0440\u0435\u0437 @."
