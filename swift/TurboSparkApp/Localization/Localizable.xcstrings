    "Stored in the Keychain separately from the TurboSpark server key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُخزّن في سلسلة المفاتيح بشكل منفصل عن مفتاح خادم TurboSpark."
          }
        },
        "de": {
