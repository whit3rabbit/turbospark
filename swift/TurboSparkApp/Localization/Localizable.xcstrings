            "state": "translated",
            "value": "\u041f\u043e\u043a\u0438 \u0449\u043e \u043d\u0456\u0447\u043e\u0433\u043e \u043f\u0456\u0434\u0441\u0443\u043c\u043e\u0432\u0443\u0432\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
