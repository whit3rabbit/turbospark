        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ingeschakelde agentdefinitie om dit mee uit te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak w\u0142\u0105czonej definicji agenta do uruchomienia tego zadania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma defini\u00e7\u00e3o de agente ativada para executar isto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u0432\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u043e\u0433\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u044f \u0430\u0433\u0435\u043d\u0442\u0430 \u0434\u043b\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktiverad agentdefinition att k\u00f6ra detta med."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu \u00e7al\u0131\u015ft\u0131racak etkin bir ajan tan\u0131m\u0131 yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e\u0433\u043e \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0430\u0433\u0435\u043d\u0442\u0430 \u0434\u043b\u044f \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 \u0111\u1ecbnh ngh\u0129a t\u00e1c t\u1eed n\u00e0o \u0111\u01b0\u1ee3c b\u1eadt \u0111\u1ec3 ch\u1ea1y vi\u1ec7c n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u5df2\u542f\u7528\u7684\u667a\u80fd\u4f53\u5b9a\u4e49\u53ef\u8fd0\u884c\u6b64\u4efb\u52a1\u3002"
