        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e7\u05d9\u05dd \u05e9\u05dc \u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4 \u05d5\u05de\u05e2\u05e7\u05d5\u05ea \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05e9\u05e0\u05d5\u05e6\u05e8\u05d5 \u05d1\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0910\u092a \u092e\u0947\u0902 \u092c\u0928\u093e\u090f \u0917\u090f \u0911\u091f\u094b\u092e\u0947\u0936\u0928 \u0914\u0930 \u0917\u093e\u0930\u094d\u0921\u0930\u0947\u0932 \u0939\u0941\u0915\u094d\u0938"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook otomatisasi dan pembatas yang dibuat di aplikasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hook di automazione e guardrail creati nell'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30d7\u30ea\u5185\u3067\u4f5c\u6210\u3057\u305f\u81ea\u52d5\u5316\u3068\u30ac\u30fc\u30c9\u30ec\u30fc\u30eb\u306e\u30d5\u30c3\u30af"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc571\uc5d0\uc11c \ub9cc\ub4e0 \uc790\ub3d9\ud654 \ubc0f \uac00\ub4dc\ub808\uc77c \ud6c4\ud06c"
          }
        },
        "nl": {
