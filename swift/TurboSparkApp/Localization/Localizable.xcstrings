    "Chat. Streams by default, unlike every OpenAI route here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629. \u062a\u064f\u0628\u062b \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u064b\u0627\u060c \u0639\u0644\u0649 \u0639\u0643\u0633 \u0643\u0644 \u0645\u0633\u0627\u0631\u0627\u062a OpenAI \u0647\u0646\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat. Streamt standardm\u00e4\u00dfig, anders als alle OpenAI-Routen hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat. Streams by default, unlike every OpenAI route here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat. Transmite por defecto, a diferencia de todas las rutas de OpenAI aqu\u00ed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat. Diffuse en continu par d\u00e9faut, contrairement \u00e0 toutes les routes OpenAI ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e6'\u05d0\u05d8. \u05de\u05e9\u05d5\u05d3\u05e8 \u05d1\u05d6\u05e8\u05d9\u05de\u05d4 \u05db\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc, \u05d1\u05e0\u05d9\u05d2\u05d5\u05d3 \u05dc\u05db\u05dc \u05e0\u05ea\u05d9\u05d1\u05d9 OpenAI \u05db\u05d0\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0948\u091f\u0964 \u092f\u0939\u093e\u0901 \u0915\u0947 \u0938\u092d\u0940 OpenAI \u0930\u0942\u091f \u0915\u0947 \u0935\u093f\u092a\u0930\u0940\u0924, \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u091f\u094d\u0930\u0940\u092e \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat. Streaming secara bawaan, tidak seperti semua rute OpenAI di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat. In streaming per impostazione predefinita, a differenza di tutte le route OpenAI qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c1\u30e3\u30c3\u30c8\u3002\u3053\u3053\u306b\u3042\u308b OpenAI \u306e\u30eb\u30fc\u30c8\u3068\u306f\u7570\u306a\u308a\u3001\u65e2\u5b9a\u3067\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucc44\ud305. \uc5ec\uae30\uc758 \ubaa8\ub4e0 OpenAI \uacbd\ub85c\uc640 \ub2ec\ub9ac \uae30\ubcf8\uc801\uc73c\ub85c \uc2a4\ud2b8\ub9ac\ubc0d\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat. Streamt standaard, anders dan alle OpenAI-routes hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat. Domy\u015blnie strumieniuje, w przeciwie\u0144stwie do wszystkich tras OpenAI tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat. Transmite por padr\u00e3o, ao contr\u00e1rio de todas as rotas OpenAI aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0430\u0442. \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u043f\u0435\u0440\u0435\u0434\u0430\u0451\u0442\u0441\u044f \u043f\u043e\u0442\u043e\u043a\u043e\u043c, \u0432 \u043e\u0442\u043b\u0438\u0447\u0438\u0435 \u043e\u0442 \u0432\u0441\u0435\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u043e\u0432 OpenAI \u0437\u0434\u0435\u0441\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Chatt. Str\u00f6mmar som standard, till skillnad fr\u00e5n alla OpenAI-v\u00e4gar h\u00e4r."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet. Buradaki t\u00fcm OpenAI rotalar\u0131ndan farkl\u0131 olarak varsay\u0131lan olarak ak\u0131\u015f yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0430\u0442. \u0422\u0438\u043f\u043e\u0432\u043e \u043f\u0435\u0440\u0435\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u043e\u0442\u043e\u043a\u043e\u043c, \u043d\u0430 \u0432\u0456\u0434\u043c\u0456\u043d\u0443 \u0432\u0456\u0434 \u0443\u0441\u0456\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0456\u0432 OpenAI \u0442\u0443\u0442."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tr\u00f2 chuy\u1ec7n. M\u1eb7c \u0111\u1ecbnh truy\u1ec1n tr\u1ef1c ti\u1ebfp, kh\u00e1c v\u1edbi m\u1ecdi tuy\u1ebfn OpenAI \u1edf \u0111\u00e2y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u804a\u5929\u3002\u9ed8\u8ba4\u4ee5\u6d41\u5f0f\u8fd4\u56de\uff0c\u8fd9\u4e0e\u6b64\u5904\u6240\u6709 OpenAI \u8def\u7531\u4e0d\u540c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u804a\u5929\u3002\u9810\u8a2d\u4ee5\u4e32\u6d41\u50b3\u56de\uff0c\u9019\u8207\u6b64\u8655\u6240\u6709 OpenAI \u8def\u7531\u4e0d\u540c\u3002"
          }
        }
      }
    },
