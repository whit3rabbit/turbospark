        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0942\u0928\u094d\u092f-\u0915\u0949\u092a\u0940 Metal \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u0928 \u0915\u0947 \u0938\u093e\u0925 \u0928\u0947\u091f\u093f\u0935 Apple MLX .gturbo \u092b\u093c\u0949\u0930\u094d\u092e\u0947\u091f"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format .gturbo Apple MLX asli dengan eksekusi Metal tanpa salinan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato .gturbo nativo Apple MLX con esecuzione Metal senza copie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bc\u30ed\u30b3\u30d4\u30fc\u306eMetal\u5b9f\u884c\u306b\u5bfe\u5fdc\u3057\u305f\u30cd\u30a4\u30c6\u30a3\u30d6Apple MLX .gturbo\u5f62\u5f0f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc81c\ub85c \uce74\ud53c Metal \uc2e4\ud589\uc744 \uc9c0\uc6d0\ud558\ub294 \ub124\uc774\ud2f0\ube0c Apple MLX .gturbo \ud615\uc2dd"
