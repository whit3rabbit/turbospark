          "stringUnit": {
            "state": "translated",
            "value": "Apri un progetto per scrivere un agente con ambito di progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u5358\u4f4d\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3092\u4f5c\u6210\u3059\u308b\u306b\u306f\u3001\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u958b\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
