          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le impostazioni di campionamento non possono essere modificate mentre una generazione è in corso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As configurações de amostragem não podem ser alteradas enquanto uma geração estiver em execução."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steekproefinstellingen kunnen niet worden gewijzigd terwijl er een generatie actief is."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samplingsinställningar kan inte ändras medan en generering pågår."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawień próbkowania nie można zmieniać podczas trwania generowania."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Настройки сэмплирования нельзя изменить во время генерации."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Параметри семплювання не можна змінювати під час створення."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir üretim çalışırken örnekleme ayarları değiştirilemez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير إعدادات أخذ العينات أثناء تشغيل التوليد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
