    "Native Apple MLX .gturbo format with zero-copy Metal execution": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0646\u0633\u064a\u0642 .gturbo \u0627\u0644\u0623\u0635\u0644\u064a \u0644\u0640 Apple MLX \u0645\u0639 \u062a\u0646\u0641\u064a\u0630 Metal \u062f\u0648\u0646 \u0646\u0633\u062e"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Natives Apple-MLX-.gturbo-Format mit Zero-Copy-Ausf\u00fchrung auf Metal"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
