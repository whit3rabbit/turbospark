            "value": "Otomatis (mesin, lalu Apple di perangkat)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatico (motore, poi Apple sul dispositivo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u52d5\uff08\u30a8\u30f3\u30b8\u30f3\u3001\u6b21\u306b\u30c7\u30d0\u30a4\u30b9\u4e0a\u306e Apple\uff09"
