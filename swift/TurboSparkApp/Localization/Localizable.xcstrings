            "value": "他のエージェントツールからスキル、エージェント、MCP サーバーを読み込む"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다른 에이전트 도구에서 스킬, 에이전트 또는 MCP 서버 가져오기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaardigheden, agenten of MCP-servers importeren uit andere agent-tools"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj umiejętności, agentów lub serwery MCP z innych narzędzi agentów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar habilidades, agentes ou servidores MCP de outras ferramentas de agente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт навыков, агентов или MCP-серверов из других агентских инструментов"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera färdigheter, agenter eller MCP-servrar från andra agentverktyg"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Diğer ajan araçlarından beceri, ajan veya MCP sunucusu içe aktarın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Імпорт навичок, агентів або MCP-серверів з інших агентних інструментів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập kỹ năng, tác tử hoặc máy chủ MCP từ công cụ tác tử khác"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从其他智能体工具导入技能、智能体或 MCP 服务器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
