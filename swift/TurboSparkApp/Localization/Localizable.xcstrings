          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen bekende providermappen gevonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono znanych folder\u00f3w dostawc\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pasta de provedor conhecida foi encontrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0432\u0435\u0441\u0442\u043d\u044b\u0435 \u043f\u0430\u043f\u043a\u0438 \u043f\u0440\u043e\u0432\u0430\u0439\u0434\u0435\u0440\u043e\u0432 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga k\u00e4nda leverant\u00f6rsmappar hittades."
          }
        },
        "tr": {
