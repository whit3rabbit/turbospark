        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chamadas de ferramentas: desconhecido"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0437\u043e\u0432\u044b \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432: \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u043d\u043e"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktygsanrop: ok\u00e4nt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara\u00e7 \u00c7a\u011fr\u0131lar\u0131: bilinmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043b\u0438\u043a\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432: \u043d\u0435\u0432\u0456\u0434\u043e\u043c\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u1ecdi c\u00f4ng c\u1ee5: kh\u00f4ng r\u00f5"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5de5\u5177\u8c03\u7528\uff1a\u672a\u77e5"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5de5\u5177\u547c\u53eb\uff1a\u672a\u77e5"
          }
        }
      }
    },
    "Load this model to find out. Whether its own markup frames tool calls is a property of its chat dialect, which is only resolved when the tokenizer loads.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u0645\u0651\u0644 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0644\u0645\u0639\u0631\u0641\u0629 \u0630\u0644\u0643. \u0643\u0648\u0646 \u062a\u0631\u0645\u064a\u0632\u0647 \u064a\u0624\u0637\u0631 \u0627\u0633\u062a\u062f\u0639\u0627\u0621\u0627\u062a \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u062e\u0627\u0635\u064a\u0629 \u0641\u064a \u0644\u0647\u062c\u0629 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647\u060c \u0648\u0644\u0627 \u062a\u064f\u062d\u0633\u0645 \u0625\u0644\u0627 \u0639\u0646\u062f \u062a\u062d\u0645\u064a\u0644 \u0623\u062f\u0627\u0629 \u0627\u0644\u062a\u0631\u0645\u064a\u0632."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade dieses Modell, um es herauszufinden. Ob sein eigenes Markup Tool-Aufrufe einrahmt, h\u00e4ngt vom Chat-Dialekt ab, der erst beim Laden des Tokenizers feststeht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load this model to find out. Whether its own markup frames tool calls is a property of its chat dialect, which is only resolved when the tokenizer loads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga este modelo para averiguarlo. Que su propio marcado delimite las llamadas a herramientas depende de su dialecto de chat, que solo se resuelve al cargar el tokenizador."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez ce mod\u00e8le pour le savoir. Le fait que son balisage encadre les appels d\u2019outils d\u00e9pend de son dialecte de discussion, d\u00e9termin\u00e9 seulement au chargement du tokenizer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05e2\u05e0\u05d5 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05db\u05d3\u05d9 \u05dc\u05d2\u05dc\u05d5\u05ea. \u05d4\u05d0\u05dd \u05d4\u05e1\u05d9\u05de\u05d5\u05df \u05e9\u05dc\u05d5 \u05de\u05de\u05e1\u05d2\u05e8 \u05e7\u05e8\u05d9\u05d0\u05d5\u05ea \u05db\u05dc\u05d9\u05dd \u05ea\u05dc\u05d5\u05d9 \u05d1\u05d3\u05d9\u05d0\u05dc\u05e7\u05d8 \u05d4\u05e6'\u05d0\u05d8 \u05e9\u05dc\u05d5, \u05e9\u05e0\u05e7\u05d1\u05e2 \u05e8\u05e7 \u05db\u05e9\u05d4\u05d8\u05d5\u05e7\u05e0\u05d9\u05d9\u05d6\u05e8 \u05e0\u05d8\u05e2\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0924\u093e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092f\u0939 \u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964 \u0907\u0938\u0915\u093e \u092e\u093e\u0930\u094d\u0915\u0905\u092a \u091f\u0942\u0932 \u0915\u0949\u0932 \u0915\u094b \u092b\u093c\u094d\u0930\u0947\u092e \u0915\u0930\u0924\u093e \u0939\u0948 \u092f\u093e \u0928\u0939\u0940\u0902, \u092f\u0939 \u0907\u0938\u0915\u0940 \u091a\u0948\u091f \u092c\u094b\u0932\u0940 \u092a\u0930 \u0928\u093f\u0930\u094d\u092d\u0930 \u0939\u0948, \u091c\u094b \u091f\u094b\u0915\u0928\u093e\u0907\u091c\u093c\u0930 \u0932\u094b\u0921 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0939\u0940 \u0924\u092f \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat model ini untuk mengetahuinya. Apakah markup-nya membingkai panggilan alat bergantung pada dialek obrolannya, yang baru diketahui saat tokenizer dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica questo modello per scoprirlo. Se il suo markup delimita le chiamate a strumenti dipende dal suo dialetto di chat, che si determina solo al caricamento del tokenizer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u78ba\u8a8d\u3059\u308b\u306b\u306f\u3053\u306e\u30e2\u30c7\u30eb\u3092\u8aad\u307f\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\u3002\u72ec\u81ea\u306e\u30de\u30fc\u30af\u30a2\u30c3\u30d7\u304c\u30c4\u30fc\u30eb\u547c\u3073\u51fa\u3057\u3092\u533a\u5207\u308b\u304b\u3069\u3046\u304b\u306f\u30c1\u30e3\u30c3\u30c8\u65b9\u8a00\u306e\u7279\u6027\u3067\u3001\u30c8\u30fc\u30af\u30ca\u30a4\u30b6\u30fc\u3092\u8aad\u307f\u8fbc\u3093\u3060\u3068\u304d\u306b\u521d\u3081\u3066\u5224\u660e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud655\uc778\ud558\ub824\uba74 \uc774 \ubaa8\ub378\uc744 \ubd88\ub7ec\uc624\uc138\uc694. \uc790\uccb4 \ub9c8\ud06c\uc5c5\uc774 \ub3c4\uad6c \ud638\ucd9c\uc744 \uad6c\ubd84\ud558\ub294\uc9c0\ub294 \ucc44\ud305 \ubc29\uc5b8\uc758 \ud2b9\uc131\uc774\uba70, \ud1a0\ud06c\ub098\uc774\uc800\ub97c \ubd88\ub7ec\uc62c \ub54c\ub9cc \uacb0\uc815\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad dit model om het te weten. Of de eigen markup toolaanroepen omkadert, hangt af van het chatdialect, dat pas bij het laden van de tokenizer bekend is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytaj ten model, aby si\u0119 dowiedzie\u0107. To, czy jego znaczniki obramowuj\u0105 wywo\u0142ania narz\u0119dzi, zale\u017cy od dialektu czatu, ustalanego dopiero przy wczytaniu tokenizera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue este modelo para descobrir. Se a pr\u00f3pria marca\u00e7\u00e3o delimita chamadas de ferramentas depende do dialeto de chat, que s\u00f3 \u00e9 definido quando o tokenizador carrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c, \u0447\u0442\u043e\u0431\u044b \u0443\u0437\u043d\u0430\u0442\u044c. \u041e\u0431\u0440\u0430\u043c\u043b\u044f\u0435\u0442 \u043b\u0438 \u0435\u0451 \u0440\u0430\u0437\u043c\u0435\u0442\u043a\u0430 \u0432\u044b\u0437\u043e\u0432\u044b \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432, \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0434\u0438\u0430\u043b\u0435\u043a\u0442\u0430 \u0447\u0430\u0442\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435 \u0442\u043e\u043a\u0435\u043d\u0438\u0437\u0430\u0442\u043e\u0440\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4s in modellen f\u00f6r att ta reda p\u00e5 det. Om dess egen markering ramar in verktygsanrop beror p\u00e5 chattdialekten, som avg\u00f6rs f\u00f6rst n\u00e4r tokeniseraren l\u00e4ses in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6\u011frenmek i\u00e7in bu modeli y\u00fckleyin. Kendi i\u015faretlemesinin ara\u00e7 \u00e7a\u011fr\u0131lar\u0131n\u0131 \u00e7er\u00e7eveleyip \u00e7er\u00e7evelemedi\u011fi sohbet leh\u00e7esinin bir \u00f6zelli\u011fidir ve yaln\u0131zca belirte\u00e7 ay\u0131r\u0131c\u0131 y\u00fcklendi\u011finde belirlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c, \u0449\u043e\u0431 \u0434\u0456\u0437\u043d\u0430\u0442\u0438\u0441\u044f. \u0427\u0438 \u043e\u0431\u0440\u0430\u043c\u043b\u044e\u0454 \u0457\u0457 \u0440\u043e\u0437\u043c\u0456\u0442\u043a\u0430 \u0432\u0438\u043a\u043b\u0438\u043a\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u0434\u0456\u0430\u043b\u0435\u043a\u0442\u0443 \u0447\u0430\u0442\u0443, \u044f\u043a\u0438\u0439 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0442\u043e\u043a\u0435\u043d\u0456\u0437\u0430\u0442\u043e\u0440\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y t\u1ea3i m\u00f4 h\u00ecnh n\u00e0y \u0111\u1ec3 bi\u1ebft. Vi\u1ec7c markup c\u1ee7a n\u00f3 c\u00f3 \u0111\u00f3ng khung l\u1ec7nh g\u1ecdi c\u00f4ng c\u1ee5 hay kh\u00f4ng ph\u1ee5 thu\u1ed9c v\u00e0o ph\u01b0\u01a1ng ng\u1eef tr\u00f2 chuy\u1ec7n, ch\u1ec9 \u0111\u01b0\u1ee3c x\u00e1c \u0111\u1ecbnh khi t\u1ea3i tokenizer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u8f7d\u6b64\u6a21\u578b\u5373\u53ef\u77e5\u6653\u3002\u5176\u6807\u8bb0\u662f\u5426\u6846\u5b9a\u5de5\u5177\u8c03\u7528\u53d6\u51b3\u4e8e\u5bf9\u8bdd\u65b9\u8a00\uff0c\u53ea\u6709\u5728\u52a0\u8f7d\u5206\u8bcd\u5668\u65f6\u624d\u80fd\u786e\u5b9a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f09\u5165\u6b64\u6a21\u578b\u5373\u53ef\u5f97\u77e5\u3002\u5176\u6a19\u8a18\u662f\u5426\u6846\u5b9a\u5de5\u5177\u547c\u53eb\u53d6\u6c7a\u65bc\u5c0d\u8a71\u65b9\u8a00\uff0c\u53ea\u6709\u5728\u8f09\u5165\u5206\u8a5e\u5668\u6642\u624d\u80fd\u78ba\u5b9a\u3002"
