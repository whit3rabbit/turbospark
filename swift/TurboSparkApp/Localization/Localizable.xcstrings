    "Bundles of commands, skills, agents, hooks and MCP servers, installed from a marketplace or a local folder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزم من الأوامر والمهارات والوكلاء والخطافات وخوادم MCP، تُثبَّت من سوق أو من مجلد محلي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakete aus Befehlen, Skills, Agenten, Hooks und MCP-Servern, installiert aus einem Marketplace oder einem lokalen Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundles of commands, skills, agents, hooks and MCP servers, installed from a marketplace or a local folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paquetes de comandos, habilidades, agentes, ganchos y servidores MCP, instalados desde un mercado o una carpeta local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensembles de commandes, compétences, agents, hooks et serveurs MCP, installés depuis un marketplace ou un dossier local."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבילות של פקודות, כישורים, סוכנים, הוקים ושרתי MCP, המותקנות מ-Marketplace או מתיקייה מקומית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड, कौशल, एजेंट, हुक और MCP सर्वर के बंडल, जो किसी मार्केटप्लेस या स्थानीय फ़ोल्डर से इंस्टॉल होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket perintah, keterampilan, agen, hook, dan server MCP yang dipasang dari marketplace atau folder lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacchetti di comandi, competenze, agenti, hook e server MCP, installati da un marketplace o da una cartella locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド、スキル、エージェント、フック、MCP サーバーをまとめたもので、マーケットプレイスまたはローカルフォルダからインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령, 스킬, 에이전트, 훅, MCP 서버를 묶은 것으로, 마켓플레이스나 로컬 폴더에서 설치합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundels van opdrachten, vaardigheden, agenten, hooks en MCP-servers, geïnstalleerd vanuit een marketplace of een lokale map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakiety poleceń, umiejętności, agentów, hooków i serwerów MCP instalowane z rynku lub folderu lokalnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pacotes de comandos, habilidades, agentes, hooks e servidores MCP, instalados de um marketplace ou de uma pasta local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Наборы команд, навыков, агентов, хуков и MCP-серверов, устанавливаемые из маркетплейса или локальной папки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket med kommandon, färdigheter, agenter, hookar och MCP-servrar, installerade från en marknadsplats eller en lokal mapp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pazaryerinden veya yerel klasörden yüklenen komut, beceri, ajan, kanca ve MCP sunucusu paketleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Набори команд, навичок, агентів, хуків і MCP-серверів, що встановлюються з маркетплейсу або локальної папки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói gồm lệnh, kỹ năng, tác tử, hook và máy chủ MCP, cài đặt từ chợ ứng dụng hoặc thư mục cục bộ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令、技能、智能体、钩子和 MCP 服务器的组合包，可从市场或本地文件夹安装。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "指令、技能、代理、掛鉤與 MCP 伺服器的組合包，可從市集或本機資料夾安裝。"
          }
        }
      }
    },
