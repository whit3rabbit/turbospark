            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u0438 TurboSpark"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta TurboSpark-modeller"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark Modellerini Ta\u015f\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0456\u0441\u0442\u0438\u0442\u0438 \u043c\u043e\u0434\u0435\u043b\u0456 TurboSpark"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuy\u1ec3n m\u00f4 h\u00ecnh TurboSpark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79fb\u52a8 TurboSpark \u6a21\u578b"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79fb\u52d5 TurboSpark \u6a21\u578b"
          }
        }
      }
    },
    "Move the managed text, image, and audio model store to an empty folder. Files owned by Hugging Face, LM Studio, or Ollama are not changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0646\u0642\u0644 \u0645\u062e\u0632\u0646 \u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0646\u0635\u0648\u0635 \u0648\u0627\u0644\u0635\u0648\u0631 \u0648\u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u064f\u062f\u0627\u0631 \u0625\u0644\u0649 \u0645\u062c\u0644\u062f \u0641\u0627\u0631\u063a. \u0644\u0627 \u064a\u062a\u0645 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0645\u0644\u0648\u0643\u0629 \u0644\u0640 Hugging Face \u0623\u0648 LM Studio \u0623\u0648 Ollama."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben Sie den verwalteten Modell-Speicher f\u00fcr Text, Bild und Audio in einen leeren Ordner. Dateien von Hugging Face, LM Studio oder Ollama werden nicht ge\u00e4ndert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the managed text, image, and audio model store to an empty folder. Files owned by Hugging Face, LM Studio, or Ollama are not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el almac\u00e9n administrado de modelos de texto, imagen y audio a una carpeta vac\u00eda. Los archivos pertenecientes a Hugging Face, LM Studio u Ollama no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9placez le magasin de mod\u00e8les g\u00e9r\u00e9 de texte, d'image et d'audio vers un dossier vide. Les fichiers appartenant \u00e0 Hugging Face, LM Studio ou Ollama ne sont pas modifi\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e2\u05d1\u05e8 \u05d0\u05ea \u05de\u05d0\u05d2\u05e8 \u05d4\u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05d4\u05de\u05e0\u05d5\u05d4\u05dc \u05e9\u05dc \u05d8\u05e7\u05e1\u05d8, \u05ea\u05de\u05d5\u05e0\u05d4 \u05d5\u05e9\u05de\u05e2 \u05dc\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05e8\u05d9\u05e7\u05d4. \u05e7\u05d1\u05e6\u05d9\u05dd \u05d1\u05d1\u05e2\u05dc\u05d5\u05ea Hugging Face, LM Studio \u05d0\u05d5 Ollama \u05dc\u05d0 \u05d9\u05e9\u05d5\u05e0\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u091f\u0947\u0915\u094d\u0938\u094d\u091f, \u0907\u092e\u0947\u091c \u0914\u0930 \u0911\u0921\u093f\u092f\u094b \u092e\u0949\u0921\u0932 \u0938\u094d\u091f\u094b\u0930 \u0915\u094b \u090f\u0915 \u0916\u093e\u0932\u0940 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u092e\u0947\u0902 \u0932\u0947 \u091c\u093e\u090f\u0902\u0964 Hugging Face, LM Studio, \u092f\u093e Ollama \u0915\u0947 \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u0935\u093e\u0932\u0940 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan penyimpanan model teks, gambar, dan audio terkelola ke folder kosong. File milik Hugging Face, LM Studio, atau Ollama tidak akan diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta l'archivio gestito dei modelli di testo, immagini e audio in una cartella vuota. I file di propriet\u00e0 di Hugging Face, LM Studio o Ollama non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ba1\u7406\u3055\u308c\u3066\u3044\u308b\u30c6\u30ad\u30b9\u30c8\u3001\u753b\u50cf\u3001\u97f3\u58f0\u306e\u30e2\u30c7\u30eb\u30b9\u30c8\u30a2\u3092\u7a7a\u306e\u30d5\u30a9\u30eb\u30c0\u30fc\u306b\u79fb\u52d5\u3057\u307e\u3059\u3002Hugging Face\u3001LM Studio\u3001Ollama\u304c\u6240\u6709\u3059\u308b\u30d5\u30a1\u30a4\u30eb\u306f\u5909\u66f4\u3055\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad00\ub9ac\ub418\ub294 \ud14d\uc2a4\ud2b8, \uc774\ubbf8\uc9c0 \ubc0f \uc624\ub514\uc624 \ubaa8\ub378 \uc800\uc7a5\uc18c\ub97c \ube48 \ud3f4\ub354\ub85c \uc774\ub3d9\ud569\ub2c8\ub2e4. Hugging Face, LM Studio \ub610\ub294 Ollama \uc18c\uc720\uc758 \ud30c\uc77c\uc740 \ubcc0\uacbd\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats de beheerde modelopslag voor tekst, beeld en audio naar een lege map. Bestanden van Hugging Face, LM Studio of Ollama worden niet gewijzigdd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenie\u015b zarz\u0105dzany magazyn modeli tekstu, obrazu i d\u017awi\u0119ku do pustego folderu. Pliki nale\u017c\u0105ce do Hugging Face, LM Studio lub Ollama nie ulegn\u0105 zmianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o armazenamento gerenciado de modelos de texto, imagem e \u00e1udio para uma pasta vazia. Arquivos pertencentes ao Hugging Face, LM Studio ou Ollama n\u00e3o s\u00e3o alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0435\u0441\u0442\u0438\u0442\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u043e\u0435 \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u044b\u0445, \u0433\u0440\u0430\u0444\u0438\u0447\u0435\u0441\u043a\u0438\u0445 \u0438 \u0430\u0443\u0434\u0438\u043e\u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0432 \u043f\u0443\u0441\u0442\u0443\u044e \u043f\u0430\u043f\u043a\u0443. \u0424\u0430\u0439\u043b\u044b Hugging Face, LM Studio \u0438\u043b\u0438 Ollama \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta den hanterade modellen f\u00f6r text, bild och ljud till en tom mapp. Filer som \u00e4gs av Hugging Face, LM Studio eller Ollama \u00e4ndras inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00f6netilen metin, g\u00f6rsel ve ses modeli deposunu bo\u015f bir klas\u00f6re ta\u015f\u0131y\u0131n. Hugging Face, LM Studio veya Ollama'ya ait dosyalar de\u011fi\u015ftirilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0456\u0441\u0442\u0456\u0442\u044c \u043a\u0435\u0440\u043e\u0432\u0430\u043d\u0435 \u0441\u0445\u043e\u0432\u0438\u0449\u0435 \u0442\u0435\u043a\u0441\u0442\u043e\u0432\u0438\u0445, \u0433\u0440\u0430\u0444\u0456\u0447\u043d\u0438\u0445 \u0442\u0430 \u0430\u0443\u0434\u0456\u043e\u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0443 \u043f\u043e\u0440\u043e\u0436\u043d\u044e \u043f\u0430\u043f\u043a\u0443. \u0424\u0430\u0439\u043b\u0438 Hugging Face, LM Studio \u0430\u0431\u043e Ollama \u043d\u0435 \u0437\u043c\u0456\u043d\u044e\u044e\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuy\u1ec3n kho l\u01b0u tr\u1eef m\u00f4 h\u00ecnh v\u0103n b\u1ea3n, h\u00ecnh \u1ea3nh v\u00e0 \u00e2m thanh \u0111\u01b0\u1ee3c qu\u1ea3n l\u00fd sang m\u1ed9t th\u01b0 m\u1ee5c tr\u1ed1ng. C\u00e1c t\u1ec7p thu\u1ed9c s\u1edf h\u1eefu c\u1ee7a Hugging Face, LM Studio ho\u1eb7c Ollama kh\u00f4ng b\u1ecb thay \u0111\u1ed5i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u53d7\u7ba1\u7406\u7684\u6587\u672c\u3001\u56fe\u50cf\u548c\u97f3\u9891\u6a21\u578b\u5b58\u50a8\u79fb\u52a8\u5230\u7a7a\u6587\u4ef6\u5939\u4e2d\u3002Hugging Face\u3001LM Studio \u6216 Ollama \u62e5\u6709\u7684\u6587\u4ef6\u4e0d\u4f1a\u6539\u53d8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u53d7\u7ba1\u7406\u7684\u6587\u5b57\u3001\u5f71\u50cf\u548c\u97f3\u8a0a\u6a21\u578b\u5b58\u653e\u5340\u79fb\u52d5\u81f3\u7a7a\u8cc7\u6599\u593e\u3002Hugging Face\u3001LM Studio \u6216 Ollama \u6240\u64c1\u6709\u7684\u6a94\u6848\u4e0d\u6703\u8b8a\u66f4\u3002"
          }
        }
      }
    },
    "Moves keyboard focus to the prompt editor": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0646\u0642\u0644 \u062a\u0631\u0643\u064a\u0632 \u0644\u0648\u062d\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0625\u0644\u0649 \u0645\u062d\u0631\u0631 \u0627\u0644\u0625\u062f\u062e\u0627\u0644"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschiebt den Tastaturfokus auf das Eingabefeld"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moves keyboard focus to the prompt editor"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el foco del teclado al editor de texto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9place le focus clavier vers l'\u00e9diteur de saisie"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e2\u05d1\u05d9\u05e8 \u05d0\u05ea \u05de\u05d9\u05e7\u05d5\u05d3 \u05d4\u05de\u05e7\u05dc\u05d3\u05ea \u05dc\u05e2\u05d5\u05e8\u05da \u05d4\u05e7\u05dc\u05d8"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0940\u092c\u094b\u0930\u094d\u0921 \u092b\u093c\u094b\u0915\u0938 \u0915\u094b \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u0938\u0902\u092a\u093e\u0926\u0915 \u092a\u0930 \u0932\u0947 \u091c\u093e\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindahkan fokus keyboard ke editor input"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta il focus della tastiera sull'editor del testo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ad\u30fc\u30dc\u30fc\u30c9\u30d5\u30a9\u30fc\u30ab\u30b9\u3092\u5165\u529b\u30a8\u30c7\u30a3\u30bf\u306b\u79fb\u52d5"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud0a4\ubcf4\ub4dc \ud3ec\ucee4\uc2a4\ub97c \uc785\ub825 \ud3b8\uc9d1\uae30\ub85c \uc774\ub3d9"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaatst de toetsenbordfocus naar de invoereditor"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenosi fokus klawiatury do edytora wprowadzania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Move o foco do teclado para o editor de texto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0435\u0449\u0430\u0435\u0442 \u0444\u043e\u043a\u0443\u0441 \u043a\u043b\u0430\u0432\u0438\u0430\u0442\u0443\u0440\u044b \u043d\u0430 \u043f\u043e\u043b\u0435 \u0432\u0432\u043e\u0434\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flyttar tangentbordsfokus till inmatningseditorn"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klavye oda\u011f\u0131n\u0131 giri\u015f d\u00fczenleyicisine ta\u015f\u0131r"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0456\u0449\u0443\u0454 \u0444\u043e\u043a\u0443\u0441 \u043a\u043b\u0430\u0432\u0456\u0430\u0442\u0443\u0440\u0438 \u043d\u0430 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuy\u1ec3n ti\u00eau \u0111i\u1ec3m b\u00e0n ph\u00edm v\u00e0o tr\u00ecnh so\u1ea1n nh\u1eadp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u952e\u76d8\u7126\u70b9\u79fb\u5230\u8f93\u5165\u7f16\u8f91\u5668"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u9375\u76e4\u7126\u9ede\u79fb\u81f3\u8f38\u5165\u7de8\u8f2f\u5668"
          }
        }
      }
    },
