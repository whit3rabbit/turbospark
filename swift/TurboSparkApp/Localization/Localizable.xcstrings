    "Slow connection. Use a USB-C cable rated for 10 Gb/s or faster.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال بطيء. استخدم كابل USB-C بسرعة 10 Gb/s أو أعلى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langsame Verbindung. Verwenden Sie ein USB-C-Kabel für 10 Gb/s oder schneller."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Slow connection. Use a USB-C cable rated for 10 Gb/s or faster."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexión lenta. Usa un cable USB-C compatible con 10 Gb/s o más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connexion lente. Utilisez un câble USB-C prenant en charge 10 Gb/s ou plus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חיבור איטי. השתמש בכבל USB-C התומך ב-10 Gb/s או מהיר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कनेक्शन धीमा है। 10 Gb/s या उससे तेज़ गति वाली USB-C केबल का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi lambat. Gunakan kabel USB-C dengan kecepatan 10 Gb/s atau lebih cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Connessione lenta. Usa un cavo USB-C da 10 Gb/s o più veloce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続が遅くなっています。10 Gb/s以上に対応したUSB-Cケーブルを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "연결 속도가 느립니다. 10 Gb/s 이상을 지원하는 USB-C 케이블을 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Langzame verbinding. Gebruik een USB-C-kabel voor 10 Gb/s of sneller."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolne połączenie. Użyj kabla USB-C obsługującego 10 Gb/s lub szybszego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conexão lenta. Use um cabo USB-C compatível com 10 Gb/s ou mais rápido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Медленное подключение. Используйте кабель USB-C на 10 Gb/s или быстрее."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Långsam anslutning. Använd en USB-C-kabel för 10 Gb/s eller snabbare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı yavaş. 10 Gb/s veya daha hızlı bir USB-C kablosu kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повільне підключення. Використовуйте кабель USB-C на 10 Gb/s або швидший."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết nối chậm. Hãy dùng cáp USB-C hỗ trợ 10 Gb/s trở lên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接速度较慢。请使用支持 10 Gb/s 或更高速度的 USB-C 线缆。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接速度較慢。請使用支援 10 Gb/s 或更高速度的 USB-C 線材。"
          }
        }
      }
    },
