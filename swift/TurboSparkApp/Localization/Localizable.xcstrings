    "Load a model to see the reasoning levels its chat template accepts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load a model to see the reasoning levels its chat template accepts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga un modelo para ver los niveles de razonamiento que acepta su plantilla de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez un modèle pour voir les niveaux de raisonnement acceptés par son modèle de discussion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie ein Modell, um die Denkstufen zu sehen, die seine Chat-Vorlage akzeptiert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica un modello per vedere i livelli di ragionamento accettati dal suo modello di chat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue um modelo para ver os níveis de raciocínio que o template de chat dele aceita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузите модель, чтобы увидеть уровни рассуждений, которые принимает ее чат-шаблон."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを読み込むと、そのチャットテンプレートが受け付ける推論レベルが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 로드하면 해당 채팅 템플릿이 허용하는 추론 수준을 볼 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载模型即可查看其对话模板接受的推理级别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入模型即可檢視其對話範本接受的推理等級。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حمّل نموذجا لعرض مستويات التفكير التي يقبلها قالب المحادثة الخاص به."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טען מודל כדי לראות אילו רמות חשיבה תבנית השיחה שלו מקבלת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल लोड करें ताकि उसकी चैट टेम्पलेट द्वारा स्वीकार किए जाने वाले रीज़निंग स्तर दिख सकें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad een model om te zien welke redeneerniveaus de chatsjabloon accepteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytaj model, aby zobaczyć poziomy rozumowania akceptowane przez jego szablon czatu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet şablonunun kabul ettiği akıl yürütme düzeylerini görmek için bir model yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажте модель, щоб побачити рівні міркувань, які приймає її чат-шаблон."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läs in en modell för att se vilka resonemangsnivåer dess chattmall accepterar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải một mô hình để xem các mức suy luận mà mẫu trò chuyện của nó chấp nhận."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat model untuk melihat level penalaran yang diterima template obrolannya."
          }
        }
      }
    },
