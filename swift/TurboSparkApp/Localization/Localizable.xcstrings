        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05ea\u05d5\u05d1\u05ea URL \u05d1\u05e1\u05d9\u05e1\u05d9\u05ea \u05dc\u05d4\u05d5\u05e8\u05d3\u05d5\u05ea \u05de-Hugging Face\u200f ($HF_ENDPOINT), \u05dc\u05d3\u05d5\u05d2\u05de\u05d4 https://hf-mirror.com \u05dc\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd."
