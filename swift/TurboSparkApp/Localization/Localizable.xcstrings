    "Configure Model Context Protocol server parameters and execution transport.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضبط معلمات خادم Model Context Protocol ووسيلة نقل التنفيذ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurieren Sie die Parameter des Model-Context-Protocol-Servers und den Ausführungstransport."
