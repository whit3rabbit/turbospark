    "What a real call on this request would prefill. Generates nothing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0627 \u0627\u0644\u0630\u064a \u0633\u064a\u064f\u0639\u0628\u0651\u0623 \u0645\u0633\u0628\u0642\u064b\u0627 \u0639\u0646\u062f \u0627\u0633\u062a\u062f\u0639\u0627\u0621 \u062d\u0642\u064a\u0642\u064a \u0644\u0647\u0630\u0627 \u0627\u0644\u0637\u0644\u0628. \u0644\u0627 \u064a\u0648\u0644\u0651\u062f \u0634\u064a\u0626\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was ein echter Aufruf dieser Anfrage vorab f\u00fcllen w\u00fcrde. Erzeugt nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What a real call on this request would prefill. Generates nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que una llamada real con esta solicitud precargar\u00eda. No genera nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qu'un vrai appel avec cette requ\u00eate pr\u00e9remplirait. Ne g\u00e9n\u00e8re rien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d4 \u05e9\u05e7\u05e8\u05d9\u05d0\u05d4 \u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05e2\u05dd \u05d4\u05d1\u05e7\u05e9\u05d4 \u05d4\u05d6\u05d5 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05de\u05de\u05dc\u05d0\u05ea \u05de\u05e8\u05d0\u05e9. \u05dc\u05d0 \u05de\u05d9\u05d9\u05e6\u05e8 \u05d3\u05d1\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0905\u0928\u0941\u0930\u094b\u0927 \u092a\u0930 \u0905\u0938\u0932\u0940 \u0915\u0949\u0932 \u0915\u094d\u092f\u093e \u092a\u094d\u0930\u0940\u092b\u093c\u093f\u0932 \u0915\u0930\u0947\u0917\u0940\u0964 \u0915\u0941\u091b \u092d\u0940 \u091c\u0928\u0930\u0947\u091f \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang akan di-prefill oleh panggilan nyata pada permintaan ini. Tidak menghasilkan apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci\u00f2 che una chiamata reale con questa richiesta precompilerebbe. Non genera nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30ea\u30af\u30a8\u30b9\u30c8\u3067\u5b9f\u969b\u306b\u547c\u3073\u51fa\u3057\u305f\u5834\u5408\u306b\u30d7\u30ec\u30d5\u30a3\u30eb\u3055\u308c\u308b\u5185\u5bb9\u3002\u4f55\u3082\u751f\u6210\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc694\uccad\uc73c\ub85c \uc2e4\uc81c \ud638\ucd9c\ud560 \ub54c \ubbf8\ub9ac \ucc44\uc6cc\uc9c8 \ub0b4\uc6a9\uc785\ub2c8\ub2e4. \uc544\ubb34\uac83\ub3c4 \uc0dd\uc131\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat een echte aanroep met dit verzoek zou prefillen. Genereert niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co prawdziwe wywo\u0142anie z tym \u017c\u0105daniem wype\u0142ni\u0142oby wst\u0119pnie. Niczego nie generuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que uma chamada real com esta solicita\u00e7\u00e3o pr\u00e9-preencheria. N\u00e3o gera nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0442\u043e \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u043b \u0431\u044b \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0439 \u0432\u044b\u0437\u043e\u0432 \u0441 \u044d\u0442\u0438\u043c \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u043c. \u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0443\u0435\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad ett verkligt anrop med den h\u00e4r f\u00f6rfr\u00e5gan skulle f\u00f6rifylla. Genererar ingenting."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istekle ger\u00e7ek bir \u00e7a\u011fr\u0131n\u0131n \u00f6n dolduraca\u011f\u0131 i\u00e7erik. Hi\u00e7bir \u015fey \u00fcretmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0429\u043e \u0437\u0430\u043f\u043e\u0432\u043d\u0438\u0432 \u0431\u0438 \u0440\u0435\u0430\u043b\u044c\u043d\u0438\u0439 \u0432\u0438\u043a\u043b\u0438\u043a \u0456\u0437 \u0446\u0438\u043c \u0437\u0430\u043f\u0438\u0442\u043e\u043c. \u041d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0433\u0435\u043d\u0435\u0440\u0443\u0454."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u1ed9i dung m\u00e0 l\u1ec7nh g\u1ecdi th\u1ef1c v\u1edbi y\u00eau c\u1ea7u n\u00e0y s\u1ebd \u0111i\u1ec1n tr\u01b0\u1edbc. Kh\u00f4ng t\u1ea1o g\u00ec."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u6b64\u8bf7\u6c42\u771f\u6b63\u8c03\u7528\u65f6\u4f1a\u9884\u586b\u5145\u7684\u5185\u5bb9\u3002\u4e0d\u751f\u6210\u4efb\u4f55\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u6b64\u8acb\u6c42\u5be6\u969b\u547c\u53eb\u6642\u6703\u9810\u5148\u586b\u5165\u7684\u5167\u5bb9\u3002\u4e0d\u7522\u751f\u4efb\u4f55\u5167\u5bb9\u3002"
          }
        }
      }
    },
