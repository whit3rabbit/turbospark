          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u304c\u8a18\u61b6\u3057\u3066\u3044\u308b\u3053\u3068"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
