    "In Flight: %lld": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u064a\u062f \u0627\u0644\u062a\u0646\u0641\u064a\u0630: %lld"
