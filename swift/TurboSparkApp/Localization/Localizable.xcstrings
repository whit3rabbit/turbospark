        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt to PNG. Requires an attached image model; returns base64 JSON."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De prompt a PNG. Requiere un modelo de imagen adjunto; devuelve JSON en base64."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du prompt au PNG. N\u00e9cessite un mod\u00e8le d'image joint ; renvoie du JSON en base64."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d4\u05e0\u05d7\u05d9\u05d4 \u05dc-PNG. \u05d3\u05d5\u05e8\u05e9 \u05de\u05d5\u05d3\u05dc \u05ea\u05de\u05d5\u05e0\u05d4 \u05de\u05e6\u05d5\u05e8\u05e3; \u05de\u05d7\u05d6\u05d9\u05e8 JSON \u05d1\u05e7\u05d9\u05d3\u05d5\u05d3 base64."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u0938\u0947 PNG\u0964 \u0938\u0902\u0932\u0917\u094d\u0928 \u0907\u092e\u0947\u091c \u092e\u0949\u0921\u0932 \u0906\u0935\u0936\u094d\u092f\u0915; base64 JSON \u0932\u094c\u091f\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt ke PNG. Memerlukan model gambar terlampir; mengembalikan JSON base64."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da prompt a PNG. Richiede un modello di immagini collegato; restituisce JSON in base64."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30f3\u30d7\u30c8\u304b\u3089 PNG \u3092\u751f\u6210\u3002\u753b\u50cf\u30e2\u30c7\u30eb\u306e\u63a5\u7d9a\u304c\u5fc5\u8981\u3067\u3001base64 \u306e JSON \u3092\u8fd4\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub86c\ud504\ud2b8\ub97c PNG\ub85c \ubcc0\ud658\ud569\ub2c8\ub2e4. \uc5f0\uacb0\ub41c \uc774\ubbf8\uc9c0 \ubaa8\ub378\uc774 \ud544\uc694\ud558\uba70 base64 JSON\uc744 \ubc18\ud658\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt naar PNG. Vereist een gekoppeld afbeeldingsmodel; geeft base64-JSON terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z promptu do PNG. Wymaga do\u0142\u0105czonego modelu obraz\u00f3w; zwraca JSON w base64."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De prompt para PNG. Requer um modelo de imagem anexado; retorna JSON em base64."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437 \u043f\u0440\u043e\u043c\u043f\u0442\u0430 \u0432 PNG. \u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0451\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439; \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 JSON \u0432 base64."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt till PNG. Kr\u00e4ver en ansluten bildmodell; returnerar base64-JSON."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130stemden PNG'ye. Ba\u011fl\u0131 bir g\u00f6r\u00fcnt\u00fc modeli gerekir; base64 JSON d\u00f6nd\u00fcr\u00fcr."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417 \u043f\u0440\u043e\u043c\u043f\u0442\u0443 \u0432 PNG. \u041f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c; \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454 JSON \u0443 base64."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1eeb l\u1eddi nh\u1eafc ra PNG. C\u1ea7n m\u00f4 h\u00ecnh h\u00ecnh \u1ea3nh \u0111\u00e3 g\u1eafn; tr\u1ea3 v\u1ec1 JSON base64."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u63d0\u793a\u8bcd\u751f\u6210\u4e3a PNG\u3002\u9700\u8981\u5df2\u6302\u8f7d\u7684\u56fe\u50cf\u6a21\u578b\uff1b\u8fd4\u56de base64 JSON\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u63d0\u793a\u8a5e\u7522\u751f\u70ba PNG\u3002\u9700\u8981\u5df2\u639b\u8f09\u7684\u5f71\u50cf\u6a21\u578b\uff1b\u50b3\u56de base64 JSON\u3002"
          }
        }
      }
    },
