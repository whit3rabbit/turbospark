    "%@ took a built-in's name and is held to its tool limits.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ أخذ اسم وكيل مدمج ويخضع لحدود أدواته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verwendet den Namen eines integrierten Agenten und unterliegt dessen Tool-Grenzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ took a built-in's name and is held to its tool limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tomó el nombre de un agente integrado y está sujeto a sus límites de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a pris le nom d’un agent intégré et reste soumis à ses limites d’outils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ קיבל שם של סוכן מובנה וכפוף למגבלות הכלים שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ने एक अंतर्निहित एजेंट का नाम लिया है और उसकी टूल सीमाओं से बँधा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ memakai nama agen bawaan dan tunduk pada batas alatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha preso il nome di un agente integrato ed è soggetto ai suoi limiti di strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ は組み込みエージェントの名前を使っているため、そのツール制限が適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 기본 제공 에이전트의 이름을 사용하므로 해당 도구 제한을 따릅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gebruikt de naam van een ingebouwde agent en valt onder diens toolbeperkingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ używa nazwy wbudowanego agenta i podlega jego limitom narzędzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ usa o nome de um agente integrado e fica sujeito aos limites de ferramentas dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ использует имя встроенного агента и подчиняется его ограничениям инструментов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ använder namnet på en inbyggd agent och omfattas av dess verktygsgränser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yerleşik bir ajanın adını aldı ve onun araç sınırlarına tabidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ використовує назву вбудованого агента й підлягає його обмеженням інструментів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã dùng tên của một tác tử tích hợp sẵn và bị giới hạn công cụ như tác tử đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用了内置智能体的名称，因此受其工具限制约束。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 使用了內建代理的名稱，因此受其工具限制約束。"
          }
        }
      }
    },
    "%@ was disconnected during the install. Nothing was added. Connect it and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم فصل %@ أثناء التثبيت. لم تتم إضافة شيء. صِلها وحاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde während der Installation getrennt. Es wurde nichts hinzugefügt. Schließen Sie es wieder an und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ was disconnected during the install. Nothing was added. Connect it and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se desconectó durante la instalación. No se añadió nada. Conéctala e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été déconnectée pendant l'installation. Rien n'a été ajouté. Reconnectez-la et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ נותקה במהלך ההתקנה. לא נוסף דבר. חבר אותה ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंस्टॉलेशन के दौरान %@ डिस्कनेक्ट हो गई। कुछ भी नहीं जोड़ा गया। उसे कनेक्ट करें और फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terputus selama pemasangan. Tidak ada yang ditambahkan. Hubungkan kembali lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stata scollegata durante l'installazione. Non è stato aggiunto nulla. Ricollegala e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール中に %@ が切断されました。何も追加されていません。接続し直して、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치 중에 %@의 연결이 끊어졌습니다. 아무것도 추가되지 않았습니다. 다시 연결한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is tijdens de installatie losgekoppeld. Er is niets toegevoegd. Sluit de bibliotheek weer aan en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ została odłączona podczas instalacji. Nic nie dodano. Podłącz ją ponownie i spróbuj jeszcze raz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi desconectada durante a instalação. Nada foi adicionado. Conecte-a novamente e tente de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ была отключена во время установки. Ничего не добавлено. Подключите её снова и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kopplades bort under installationen. Inget lades till. Anslut den igen och försök på nytt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum sırasında %@ bağlantısı kesildi. Hiçbir şey eklenmedi. Yeniden bağlayıp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час встановлення %@ було відключено. Нічого не додано. Підключіть її знову й повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã bị ngắt kết nối trong khi cài đặt. Không có gì được thêm. Hãy kết nối lại rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "安装期间 %@ 已断开连接。未添加任何内容。请重新连接后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "安裝期間 %@ 已中斷連接。未新增任何內容。請重新連接後再試一次。"
          }
        }
      }
    },
