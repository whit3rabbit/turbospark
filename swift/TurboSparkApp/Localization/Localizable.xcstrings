        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista modeli w formacie Ollama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A lista de modelos, no formato do Ollama."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u0438\u0441\u043e\u043a \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0432 \u0444\u043e\u0440\u043c\u0430\u0442\u0435 Ollama."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellistan i Ollamas form."
          }
        },
        "tr": {
