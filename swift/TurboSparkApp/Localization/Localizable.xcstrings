        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта операция не может обработать всю запись. Выберите более короткий источник."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця операція не може обробити весь запис. Виберіть коротше джерело."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này không thể xử lý toàn bộ bản ghi. Chọn nguồn ngắn hơn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作では録音全体を処理できません。より短いソースを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 작업은 전체 녹음을 처리할 수 없습니다. 더 짧은 소스를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作无法处理完整录音。请选择较短的来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作無法處理完整錄音。請選擇較短的來源。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن لهذه العملية معالجة التسجيل بالكامل. اختر مصدراً أقصر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה הזו אינה יכולה לעבד את ההקלטה המלאה. בחר מקור קצר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह कार्रवाई पूरी रिकॉर्डिंग को प्रोसेस नहीं कर सकती। छोटा स्रोत चुनें।"
          }
        }
      }
    },
    "This permanently deletes the model files (%@) from the drive of the library %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى حذف ملفات النموذج (%@) نهائيًا من محرك أقراص المكتبة %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Modelldateien (%@) endgültig vom Laufwerk der Bibliothek %@ gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the model files (%@) from the drive of the library %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina de forma permanente los archivos del modelo (%@) de la unidad de la biblioteca %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action supprime définitivement les fichiers du modèle (%@) du disque de la bibliothèque %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תמחק לצמיתות את קובצי המודל (%@) מהכונן של הספרייה %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे मॉडल की फ़ाइलें (%@) लाइब्रेरी %@ की ड्राइव से हमेशा के लिए हट जाएंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus permanen file model (%@) dari drive pustaka %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione elimina definitivamente i file del modello (%@) dall'unità della libreria %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのファイル（%@）を、ライブラリ「%@」のドライブから完全に削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 파일(%@)이 라이브러리 %@의 드라이브에서 영구적으로 삭제됩니다."
