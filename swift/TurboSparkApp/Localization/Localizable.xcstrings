            "state": "translated",
            "value": "Restaurar um backup"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443\u044e \u043a\u043e\u043f\u0438\u044e"
          }
        },
        "sv": {
