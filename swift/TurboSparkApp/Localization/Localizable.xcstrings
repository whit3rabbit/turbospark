        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner l'architecture et sugg\u00e9rer des am\u00e9liorations"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05e7\u05d5\u05e8 \u05d0\u05e8\u05db\u05d9\u05d8\u05e7\u05d8\u05d5\u05e8\u05d4 \u05d5\u05d4\u05e6\u05e2 \u05e9\u05d9\u05e4\u05d5\u05e8\u05d9\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093e\u0938\u094d\u0924\u0941\u0915\u0932\u093e \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902 \u0914\u0930 \u0938\u0941\u0927\u093e\u0930 \u0938\u0941\u091d\u093e\u090f\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tinjau arsitektur dan sarankan perbaikan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rivedi l'architettura e suggerisci miglioramenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30fc\u30ad\u30c6\u30af\u30c1\u30e3\u3092\u30ec\u30d3\u30e5\u30fc\u3057\u3066\u6539\u5584\u6848\u3092\u63d0\u6848\u3057\u3066\u304f\u3060\u3055\u3044"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\ud0a4\ud14d\ucc98\ub97c \uac80\ud1a0\ud558\uace0 \uac1c\uc120\uc810\uc744 \uc81c\uc548\ud574\uc8fc\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Architectuur beoordelen en verbeteringen voorstellen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejrzyj architektur\u0119 i zasugeruj ulepszenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisar a arquitetura e sugerir melhorias"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u0430\u0443\u0434\u0438\u0442 \u0430\u0440\u0445\u0438\u0442\u0435\u043a\u0442\u0443\u0440\u044b \u0438 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0438\u0442\u044c \u0443\u043b\u0443\u0447\u0448\u0435\u043d\u0438\u044f"
          }
        },
        "sv": {
          "stringUnit": {
