          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u043b\u043e\u0432\u0438\u0435 \u0446\u0435\u043b\u0438 \u043c\u043e\u0436\u0435\u0442 \u0441\u043e\u0434\u0435\u0440\u0436\u0430\u0442\u044c \u043d\u0435 \u0431\u043e\u043b\u0435\u0435 %lld \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432; \u0432 \u044d\u0442\u043e\u043c \u0443\u0441\u043b\u043e\u0432\u0438\u0438 \u0438\u0445 %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett m\u00e5lvillkor \u00e4r begr\u00e4nsat till %lld tecken; det h\u00e4r har %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef ko\u015fulu en fazla %lld karakter olabilir; bu ko\u015fulda %lld karakter var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043c\u043e\u0432\u0430 \u0446\u0456\u043b\u0456 \u043c\u043e\u0436\u0435 \u043c\u0456\u0441\u0442\u0438\u0442\u0438 \u043d\u0435 \u0431\u0456\u043b\u044c\u0448\u0435 %lld \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432; \u0443 \u0446\u0456\u0439 \u0443\u043c\u043e\u0432\u0456 \u0457\u0445 %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110i\u1ec1u ki\u1ec7n m\u1ee5c ti\u00eau gi\u1edbi h\u1ea1n \u1edf %lld k\u00fd t\u1ef1; \u0111i\u1ec1u ki\u1ec7n n\u00e0y c\u00f3 %lld k\u00fd t\u1ef1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u6807\u6761\u4ef6\u6700\u591a %lld \u4e2a\u5b57\u7b26\uff1b\u5f53\u524d\u6761\u4ef6\u6709 %lld \u4e2a\u5b57\u7b26\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u6a19\u689d\u4ef6\u6700\u591a %lld \u500b\u5b57\u5143\uff1b\u76ee\u524d\u689d\u4ef6\u6709 %lld \u500b\u5b57\u5143\u3002"
          }
        }
      }
    },
