    "What is on your mind today?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on your mind today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿En qué estás pensando hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quoi pensez-vous aujourd'hui ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was beschäftigt Sie heute?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A cosa stai pensando oggi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que está pensando hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "О чем вы думаете сегодня?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のご用件は何ですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 어떤 생각이 있으신가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有什么想法？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天有什麼想法？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي يدور في ذهنك اليوم؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज आपके मन में क्या है?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat houdt je vandaag bezig?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O czym myślisz dzisiaj?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün aklınızda ne var?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що у вас на думці сьогодні?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad har du på hjärtat idag?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hôm nay bạn đang suy nghĩ điều gì?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ada di pikiran Anda hari ini?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "על מה אתה חושב היום?"
          }
        }
      }
    },
    "What would you like to build or explore?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to build or explore?"
