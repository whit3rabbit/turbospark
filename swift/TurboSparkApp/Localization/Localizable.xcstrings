        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0940 \u0938\u0939\u0947\u091c\u0940 \u0917\u0908 \u0907\u092e\u0947\u091c \u092f\u0939\u093e\u0902 \u0926\u093f\u0916\u0924\u0940 \u0939\u0948\u0902\u0964"
