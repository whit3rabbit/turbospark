          "stringUnit": {
            "state": "translated",
            "value": "Acceso total: ejecutar todas las herramientas sin preguntar, sin entorno aislado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Acc\u00e8s complet : ex\u00e9cuter chaque outil sans demander, bac \u00e0 sable d\u00e9sactiv\u00e9"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d2\u05d9\u05e9\u05d4 \u05de\u05dc\u05d0\u05d4: \u05d4\u05e4\u05e2\u05dc \u05db\u05dc \u05db\u05dc\u05d9 \u05d1\u05dc\u05d9 \u05dc\u05e9\u05d0\u05d5\u05dc, \u05d0\u05e8\u05d2\u05d6 \u05d4\u05d7\u05d5\u05dc \u05db\u05d1\u05d5\u05d9"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0942\u0930\u094d\u0923 \u092a\u0939\u0941\u0901\u091a: \u0939\u0930 \u091f\u0942\u0932 \u092c\u093f\u0928\u093e \u092a\u0942\u091b\u0947 \u091a\u0932\u093e\u090f\u0901, \u0938\u0948\u0902\u0921\u092c\u0949\u0915\u094d\u0938 \u092c\u0902\u0926"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses penuh: jalankan semua alat tanpa bertanya, sandbox nonaktif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accesso completo: esegui ogni strumento senza chiedere, sandbox disattivata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30eb\u30a2\u30af\u30bb\u30b9\uff1a\u3059\u3079\u3066\u306e\u30c4\u30fc\u30eb\u3092\u78ba\u8a8d\u306a\u3057\u3067\u5b9f\u884c\u3001\u30b5\u30f3\u30c9\u30dc\u30c3\u30af\u30b9\u306f\u30aa\u30d5"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc804\uccb4 \uc561\uc138\uc2a4: \ubaa8\ub4e0 \ub3c4\uad6c\ub97c \ubb3b\uc9c0 \uc54a\uace0 \uc2e4\ud589, \uc0cc\ub4dc\ubc15\uc2a4 \uaebc\uc9d0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Volledige toegang: elke tool zonder vragen uitvoeren, sandbox uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe\u0142ny dost\u0119p: ka\u017cde narz\u0119dzie bez pytania, piaskownica wy\u0142\u0105czona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Acesso total: executar todas as ferramentas sem perguntar, sandbox desativado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u043d\u044b\u0439 \u0434\u043e\u0441\u0442\u0443\u043f: \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u044c \u043b\u044e\u0431\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0431\u0435\u0437 \u0432\u043e\u043f\u0440\u043e\u0441\u043e\u0432, \u043f\u0435\u0441\u043e\u0447\u043d\u0438\u0446\u0430 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Full \u00e5tkomst: k\u00f6r alla verktyg utan att fr\u00e5ga, sandl\u00e5dan av"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam eri\u015fim: her arac\u0131 sormadan \u00e7al\u0131\u015ft\u0131r, korumal\u0131 alan kapal\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u043d\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f: \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0442\u0438 \u0431\u0443\u0434\u044c-\u044f\u043a\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u0431\u0435\u0437 \u043f\u0438\u0442\u0430\u043d\u044c, \u043f\u0456\u0441\u043e\u0447\u043d\u0438\u0446\u044e \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "To\u00e0n quy\u1ec1n truy c\u1eadp: ch\u1ea1y m\u1ecdi c\u00f4ng c\u1ee5 kh\u00f4ng c\u1ea7n h\u1ecfi, h\u1ed9p c\u00e1t t\u1eaft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u5168\u8bbf\u95ee\uff1a\u6240\u6709\u5de5\u5177\u76f4\u63a5\u8fd0\u884c\uff0c\u4e0d\u8be2\u95ee\uff0c\u6c99\u76d2\u5173\u95ed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u6574\u5b58\u53d6\uff1a\u6240\u6709\u5de5\u5177\u76f4\u63a5\u57f7\u884c\uff0c\u4e0d\u8a62\u554f\uff0c\u6c99\u76d2\u95dc\u9589"
          }
        }
      }
    },
