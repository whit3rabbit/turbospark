          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie zatwierdzaj narz\u0119dzia (pomi\u0144 interaktywny monit)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar ferramentas automaticamente (ignorar solicita\u00e7\u00e3o interativa)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u043e\u0434\u043e\u0431\u0440\u044f\u0442\u044c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b (\u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0442\u044c \u0437\u0430\u043f\u0440\u043e\u0441)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Godk\u00e4nn verktyg automatiskt (hoppa \u00f6ver interaktiv uppmaning)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara\u00e7lar\u0131 Otomatik Onayla (etkile\u015fimli istemi atla)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0441\u0445\u0432\u0430\u043b\u044e\u0432\u0430\u0442\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 (\u043f\u0440\u043e\u043f\u0443\u0441\u043a\u0430\u0442\u0438 \u0437\u0430\u043f\u0438\u0442)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ef1 \u0111\u1ed9ng ph\u00ea duy\u1ec7t c\u00f4ng c\u1ee5 (b\u1ecf qua l\u1eddi nh\u1eafc t\u01b0\u01a1ng t\u00e1c)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u52a8\u6279\u51c6\u5de5\u5177\uff08\u8df3\u8fc7\u4ea4\u4e92\u5f0f\u63d0\u793a\uff09"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u52d5\u6838\u51c6\u5de5\u5177\uff08\u7565\u904e\u4e92\u52d5\u5f0f\u63d0\u793a\uff09"
          }
        }
      }
    },
