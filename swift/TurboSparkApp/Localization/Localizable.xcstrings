    "Check compatibility by reading checkpoint headers without downloading.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u062a\u0648\u0627\u0641\u0642 \u0628\u0642\u0631\u0627\u0621\u0629 \u062a\u0631\u0648\u064a\u0633\u0627\u062a \u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u062f\u0648\u0646 \u062a\u0646\u0632\u064a\u0644\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00fcfen Sie die Kompatibilit\u00e4t, indem Sie die Checkpoint-Header lesen, ohne herunterzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check compatibility by reading checkpoint headers without downloading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comprueba la compatibilidad leyendo las cabeceras del checkpoint sin descargarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e9rifiez la compatibilit\u00e9 en lisant les en-t\u00eates du checkpoint sans le t\u00e9l\u00e9charger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d3\u05d5\u05e7 \u05ea\u05d0\u05d9\u05de\u05d5\u05ea \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea \u05e7\u05e8\u05d9\u05d0\u05ea \u05db\u05d5\u05ea\u05e8\u05d5\u05ea \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d1\u05dc\u05d9 \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d0\u05d5\u05ea\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u0939\u0947\u0921\u0930 \u092a\u0922\u093c\u0915\u0930 \u0938\u0902\u0917\u0924\u0924\u093e \u091c\u093e\u0902\u091a\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa kompatibilitas dengan membaca header checkpoint tanpa mengunduh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la compatibilit\u00e0 leggendo le intestazioni del checkpoint senza scaricarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u305b\u305a\u306b\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306e\u30d8\u30c3\u30c0\u30fc\u3092\u8aad\u307f\u53d6\u3063\u3066\u4e92\u63db\u6027\u3092\u78ba\u8a8d\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc6b4\ub85c\ub4dc\ud558\uc9c0 \uc54a\uace0 \uccb4\ud06c\ud3ec\uc778\ud2b8 \ud5e4\ub354\ub97c \uc77d\uc5b4 \ud638\ud658\uc131\uc744 \ud655\uc778\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de compatibiliteit door checkpoint-headers te lezen zonder te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawd\u017a zgodno\u015b\u0107, odczytuj\u0105c nag\u0142\u00f3wki punktu kontrolnego bez pobierania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique a compatibilidade lendo os cabe\u00e7alhos do checkpoint sem baix\u00e1-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u044c, \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0432 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u0431\u0435\u0437 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera kompatibiliteten genom att l\u00e4sa checkpoint-huvuden utan att h\u00e4mta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130ndirmeden denetim noktas\u0131 ba\u015fl\u0131klar\u0131n\u0131 okuyarak uyumlulu\u011fu kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0441\u0443\u043c\u0456\u0441\u043d\u0456\u0441\u0442\u044c, \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0432\u0448\u0438 \u0437\u0430\u0433\u043e\u043b\u043e\u0432\u043a\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0457 \u0442\u043e\u0447\u043a\u0438 \u0431\u0435\u0437 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki\u1ec3m tra t\u01b0\u01a1ng th\u00edch b\u1eb1ng c\u00e1ch \u0111\u1ecdc ph\u1ea7n \u0111\u1ea7u c\u1ee7a checkpoint m\u00e0 kh\u00f4ng c\u1ea7n t\u1ea3i xu\u1ed1ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u9700\u4e0b\u8f7d\uff0c\u901a\u8fc7\u8bfb\u53d6\u68c0\u67e5\u70b9\u6587\u4ef6\u5934\u6765\u68c0\u67e5\u517c\u5bb9\u6027\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u9700\u4e0b\u8f09\uff0c\u900f\u904e\u8b80\u53d6\u6aa2\u67e5\u9ede\u6a94\u982d\u4f86\u6aa2\u67e5\u76f8\u5bb9\u6027\u3002"
          }
        }
      }
    },
