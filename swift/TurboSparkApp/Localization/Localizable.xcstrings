          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6697\u53f7\u5316\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3092\u30ed\u30c3\u30af\u3055\u308c\u305f\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3068\u3057\u3066\u5fa9\u5143\u3057\u307e\u3057\u305f\u3002"
