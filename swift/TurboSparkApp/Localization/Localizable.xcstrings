          }
        }
      }
    },
    "Runs with a caveat; see the model notes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u0645\u0644 \u0645\u0639 \u062a\u062d\u0641\u0651\u0638\u061b \u0631\u0627\u062c\u0639 \u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0646\u0645\u0648\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4uft mit Einschr\u00e4nkung; siehe Modellhinweise."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Runs with a caveat; see the model notes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona con una salvedad; consulta las notas del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fonctionne avec une r\u00e9serve ; voir les notes du mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e8\u05e5 \u05e2\u05dd \u05d4\u05e1\u05ea\u05d9\u05d9\u05d2\u05d5\u05ea; \u05e8\u05d0\u05d5 \u05d0\u05ea \u05d4\u05e2\u05e8\u05d5\u05ea \u05d4\u05de\u05d5\u05d3\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u091a\u0947\u0924\u093e\u0935\u0928\u0940 \u0915\u0947 \u0938\u093e\u0925 \u091a\u0932\u0924\u093e \u0939\u0948; \u092e\u0949\u0921\u0932 \u0928\u094b\u091f \u0926\u0947\u0916\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berjalan dengan catatan; lihat catatan model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Funziona con una riserva; vedi le note del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ce8\u610f\u70b9\u3042\u308a\u3002\u30e2\u30c7\u30eb\u306e\u30e1\u30e2\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc8fc\uc758 \uc0ac\ud56d\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ubaa8\ub378 \uba54\ubaa8\ub97c \ucc38\uc870\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werkt met een kanttekening; zie de modelnotities."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzia\u0142a z zastrze\u017ceniem; zobacz uwagi do modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Funciona com uma ressalva; veja as notas do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u0441 \u043e\u0433\u043e\u0432\u043e\u0440\u043a\u043e\u0439; \u0441\u043c. \u0437\u0430\u043c\u0435\u0442\u043a\u0438 \u043a \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00f6rs med f\u00f6rbeh\u00e5ll; se modellanteckningarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir uyar\u0131yla \u00e7al\u0131\u015f\u0131r; model notlar\u0131na bak\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0430\u0446\u044e\u0454 \u0456\u0437 \u0437\u0430\u0441\u0442\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f\u043c; \u0434\u0438\u0432. \u043d\u043e\u0442\u0430\u0442\u043a\u0438 \u0434\u043e \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ea1y v\u1edbi l\u01b0u \u00fd; xem ghi ch\u00fa c\u1ee7a m\u00f4 h\u00ecnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u8fd0\u884c\u4f46\u6709\u6ce8\u610f\u4e8b\u9879\uff1b\u8bf7\u53c2\u9605\u6a21\u578b\u8bf4\u660e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u57f7\u884c\u4f46\u6709\u6ce8\u610f\u4e8b\u9805\uff1b\u8acb\u53c3\u95b1\u6a21\u578b\u8aaa\u660e\u3002"
          }
        }
      }
