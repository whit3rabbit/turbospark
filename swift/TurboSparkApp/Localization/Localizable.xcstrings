        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta sopra la directory radice del codice per abilitare l'indicizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックス作成を有効にするには、上でコードベースのルートディレクトリを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인덱싱을 활성화하려면 위에서 코드베이스 루트 디렉터리를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel hierboven de hoofdmap van de codebase in om indexering in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw powyżej katalog główny kodu, aby włączyć indeksowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina acima a pasta raiz do código para ativar a indexação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите выше корневую папку кода, чтобы включить индексацию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange kodbasens rotmapp ovan för att aktivera indexering."
          }
        },
