            "value": "\u062c\u0627\u0631\u064d \u0642\u0631\u0627\u0621\u0629 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639: %lld \u0645\u0646 %lld"
