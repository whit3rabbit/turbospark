        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d0\u05e1\u05d9\u05de\u05d5\u05df \u05d4\u05e9\u05de\u05d5\u05e8 \u05d4\u05d5\u05e1\u05e8, \u05d0\u05da \u05d0\u05e1\u05d9\u05de\u05d5\u05df \u05d0\u05d7\u05e8 \u05e2\u05d3\u05d9\u05d9\u05df \u05d1\u05ea\u05d5\u05e7\u05e3 (\u05de\u05e9\u05ea\u05e0\u05d4 \u05e1\u05d1\u05d9\u05d1\u05d4 \u05d0\u05d5 \u05de\u05d8\u05de\u05d5\u05df \u05e9\u05dc Hugging Face CLI)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e \u091f\u094b\u0915\u0928 \u0939\u091f\u093e\u092f\u093e \u0917\u092f\u093e, \u0932\u0947\u0915\u093f\u0928 \u0926\u0942\u0938\u0930\u093e \u091f\u094b\u0915\u0928 \u0905\u092d\u0940 \u092d\u0940 \u0932\u093e\u0917\u0942 \u0939\u0948 (\u090f\u0928\u0935\u093e\u092f\u0930\u0928\u092e\u0947\u0902\u091f \u0935\u0947\u0930\u093f\u090f\u092c\u0932 \u092f\u093e Hugging Face CLI \u0915\u0948\u0936)\u0964"
          }
