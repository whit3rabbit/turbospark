    "Apple voices are used until the TurboSpark engine has a voice model.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0623\u0635\u0648\u0627\u062a Apple \u0625\u0644\u0649 \u0623\u0646 \u064a\u062a\u0648\u0641\u0631 \u0644\u0645\u062d\u0631\u0643 TurboSpark \u0646\u0645\u0648\u0630\u062c \u0635\u0648\u062a\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Stimmen werden verwendet, bis die TurboSpark-Engine ein Sprachmodell hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple voices are used until the TurboSpark engine has a voice model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usan las voces de Apple hasta que el motor de TurboSpark tenga un modelo de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix d'Apple sont utilis\u00e9es tant que le moteur TurboSpark n'a pas de mod\u00e8le vocal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d5\u05dc\u05d5\u05ea \u05e9\u05dc Apple \u05de\u05e9\u05de\u05e9\u05d9\u05dd \u05e2\u05d3 \u05e9\u05dc\u05de\u05e0\u05d5\u05e2 TurboSpark \u05d9\u05d4\u05d9\u05d4 \u05de\u05d5\u05d3\u05dc \u05e7\u05d5\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u092c \u0924\u0915 TurboSpark \u0907\u0902\u091c\u0928 \u0915\u0947 \u092a\u093e\u0938 \u0935\u0949\u0907\u0938 \u092e\u0949\u0921\u0932 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e, \u0924\u092c \u0924\u0915 Apple \u0915\u0940 \u0906\u0935\u093e\u091c\u093c\u0947\u0902 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara Apple digunakan sampai mesin TurboSpark memiliki model suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci Apple vengono usate finch\u00e9 il motore TurboSpark non avr\u00e0 un modello vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u30a8\u30f3\u30b8\u30f3\u306b\u97f3\u58f0\u30e2\u30c7\u30eb\u304c\u7528\u610f\u3055\u308c\u308b\u307e\u3067\u306f\u3001Apple \u306e\u97f3\u58f0\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \uc5d4\uc9c4\uc5d0 \uc74c\uc131 \ubaa8\ub378\uc774 \uc0dd\uae38 \ub54c\uae4c\uc9c0 Apple \uc74c\uc131\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-stemmen worden gebruikt totdat de TurboSpark-engine een stemmodel heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u0142osy Apple s\u0105 u\u017cywane, dop\u00f3ki silnik TurboSpark nie b\u0119dzie mie\u0107 modelu g\u0142osu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As vozes da Apple s\u00e3o usadas at\u00e9 que o mecanismo do TurboSpark tenha um modelo de voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u043b\u043e\u0441\u0430 Apple \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u044e\u0442\u0441\u044f, \u043f\u043e\u043a\u0430 \u0443 \u0434\u0432\u0438\u0436\u043a\u0430 TurboSpark \u043d\u0435\u0442 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples r\u00f6ster anv\u00e4nds tills TurboSpark-motorn har en r\u00f6stmodell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark motorunun bir ses modeli olana kadar Apple sesleri kullan\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u043b\u043e\u0441\u0438 Apple \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f, \u0434\u043e\u043a\u0438 \u0440\u0443\u0448\u0456\u0439 TurboSpark \u043d\u0435 \u043c\u0430\u0442\u0438\u043c\u0435 \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u043e\u0457 \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi\u1ecdng Apple \u0111\u01b0\u1ee3c d\u00f9ng cho \u0111\u1ebfn khi b\u1ed9 m\u00e1y TurboSpark c\u00f3 m\u00f4 h\u00ecnh gi\u1ecdng n\u00f3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 TurboSpark \u5f15\u64ce\u62e5\u6709\u8bed\u97f3\u6a21\u578b\u4e4b\u524d\uff0c\u5c06\u4f7f\u7528 Apple \u8bed\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 TurboSpark \u5f15\u64ce\u64c1\u6709\u8a9e\u97f3\u6a21\u578b\u4e4b\u524d\uff0c\u5c07\u4f7f\u7528 Apple \u8a9e\u97f3\u3002"
          }
        }
      }
    },
