        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u540d\u4e3a\u201c%@\u201d\u7684\u667a\u80fd\u4f53\u6587\u4ef6\u5df2\u5b58\u5728\u3002\u8bf7\u91cd\u547d\u540d\u65b0\u667a\u80fd\u4f53\uff0c\u6216\u5148\u5220\u9664\u65e7\u6587\u4ef6\u3002"
          }
