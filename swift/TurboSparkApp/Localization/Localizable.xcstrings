            "state": "translated",
            "value": "\u0639\u0631\u0636 \u0645\u0644\u0641\u0627\u062a .gguf \u0627\u0644\u062a\u064a \u064a\u0646\u0634\u0631\u0647\u0627 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639"
