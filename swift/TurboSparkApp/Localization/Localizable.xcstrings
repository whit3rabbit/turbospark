            "state": "translated",
            "value": "Las páginas solo cargan archivos locales de la propia carpeta del artefacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages ne chargent que des fichiers locaux issus du dossier de l'artefact."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten laden ausschließlich lokale Dateien aus dem eigenen Ordner des Artefakts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine caricano solo file locali dalla cartella dell'artefatto stesso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As páginas carregam apenas arquivos locais da própria pasta do artefato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Страницы загружают только локальные файлы из собственной папки артефакта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページは、アーティファクト自身のフォルダにあるローカルファイルのみを読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이지는 아티팩트 자체 폴더의 로컬 파일만 로드합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "页面只加载工件自身文件夹中的本地文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "頁面只載入成品自身資料夾中的本機檔案。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحمّل الصفحات ملفات محلية من مجلد العنصر نفسه فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדפים טוענים רק קבצים מקומיים מהתיקייה של הפריט עצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेज केवल आर्टिफ़ैक्ट के अपने फ़ोल्डर से स्थानीय फ़ाइलें लोड करते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina's laden alleen lokale bestanden uit de eigen map van het artefact."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strony wczytują wyłącznie pliki lokalne z własnego folderu artefaktu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfalar yalnızca yapıtın kendi klasöründeki yerel dosyaları yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сторінки завантажують лише локальні файли з власної папки артефакту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidor läser bara in lokala filer från artefaktens egen mapp."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các trang chỉ tải tệp cục bộ từ thư mục của chính artifact."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman hanya memuat berkas lokal dari folder artefak itu sendiri."
          }
        }
      }
    },
