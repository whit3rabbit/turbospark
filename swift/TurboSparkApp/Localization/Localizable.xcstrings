    "Tokens per second ceiling. 0 leaves generation uncapped.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحد الأقصى للرموز في الثانية. القيمة 0 تترك التوليد بلا حد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obergrenze in Token pro Sekunde. 0 lässt die Generierung unbegrenzt."
