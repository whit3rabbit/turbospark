    "Keep fans pinned when TurboSpark quits": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0628\u0642\u0627\u0621 \u0627\u0644\u0645\u0631\u0627\u0648\u062d \u0645\u062b\u0628\u062a\u0629 \u0639\u0646\u062f \u0625\u0646\u0647\u0627\u0621 TurboSpark"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00fcfter beim Beenden von TurboSpark fixiert lassen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep fans pinned when TurboSpark quits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener los ventiladores fijados al salir de TurboSpark"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garder les ventilateurs verrouill\u00e9s \u00e0 la fermeture de TurboSpark"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05d0\u05e8 \u05d0\u05ea \u05d4\u05de\u05d0\u05d5\u05d5\u05e8\u05e8\u05d9\u05dd \u05e0\u05e2\u05d5\u05e6\u05d9\u05dd \u05d1\u05d9\u05e6\u05d9\u05d0\u05d4 \u05de-TurboSpark"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u092a\u0930 \u092d\u0940 \u092b\u0948\u0928 \u092a\u093f\u0928 \u0930\u0916\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetap kunci kipas saat TurboSpark ditutup"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le ventole bloccate alla chiusura di TurboSpark"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u7d42\u4e86\u6642\u3082\u30d5\u30a1\u30f3\u3092\u56fa\u5b9a\u3057\u305f\u307e\u307e\u306b\u3059\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \uc885\ub8cc \uc2dc\uc5d0\ub3c4 \ud32c \uace0\uc815 \uc720\uc9c0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ventilatoren vastgezet houden wanneer TurboSpark wordt afgesloten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj przypi\u0119te wentylatory po zamkni\u0119ciu TurboSpark"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter as ventoinhas fixadas ao sair do TurboSpark"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u0432\u043b\u044f\u0442\u044c \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u044b \u0437\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438 \u043f\u0440\u0438 \u0432\u044b\u0445\u043e\u0434\u0435 \u0438\u0437 TurboSpark"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beh\u00e5ll fl\u00e4ktarna l\u00e5sta n\u00e4r TurboSpark avslutas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark kapan\u0131nca fanlar\u0131 sabit tut"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043b\u0438\u0448\u0430\u0442\u0438 \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0438 \u0437\u0430\u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u0438\u043c\u0438 \u043f\u0456\u0441\u043b\u044f \u0432\u0438\u0445\u043e\u0434\u0443 \u0437 TurboSpark"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi\u1eef qu\u1ea1t c\u1ed1 \u0111\u1ecbnh khi tho\u00e1t TurboSpark"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9000\u51fa TurboSpark \u540e\u4fdd\u6301\u98ce\u6247\u9501\u5b9a"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d50\u675f TurboSpark \u5f8c\u4fdd\u6301\u98a8\u6247\u9396\u5b9a"
          }
        }
      }
    },
    "Keep recent messages verbatim": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u062d\u0631\u0641\u064a\u064b\u0627"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuelle Nachrichten w\u00f6rtlich beibehalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep recent messages verbatim"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener los mensajes recientes palabra por palabra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserver les messages r\u00e9cents textuellement"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05de\u05d5\u05e8 \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05d0\u05d7\u05e8\u05d5\u05e0\u05d5\u05ea \u05de\u05d9\u05dc\u05d4 \u05d1\u05de\u05d9\u05dc\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u093e\u0932 \u0915\u0947 \u0938\u0902\u0926\u0947\u0936\u094b\u0902 \u0915\u094b \u0936\u092c\u094d\u0926\u0936\u0903 \u0930\u0916\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan pesan terbaru kata demi kata"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni i messaggi recenti testualmente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u8fd1\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u3092\u305d\u306e\u307e\u307e\u4fdd\u6301"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucd5c\uadfc \uba54\uc2dc\uc9c0\ub97c \uadf8\ub300\ub85c \uc720\uc9c0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Recente berichten woordelijk bewaren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj ostatnie wiadomo\u015bci dos\u0142ownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Manter mensagens recentes na \u00edntegra"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0435 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0434\u043e\u0441\u043b\u043e\u0432\u043d\u043e"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beh\u00e5ll de senaste meddelandena ordagrant"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son mesajlar\u0131 aynen koru"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u043e\u0441\u0442\u0430\u043d\u043d\u0456 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0434\u043e\u0441\u043b\u0456\u0432\u043d\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi\u1eef nguy\u00ean v\u0103n c\u00e1c tin nh\u1eafn g\u1ea7n \u0111\u00e2y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9010\u5b57\u4fdd\u7559\u6700\u8fd1\u7684\u6d88\u606f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9010\u5b57\u4fdd\u7559\u6700\u8fd1\u7684\u8a0a\u606f"
          }
        }
      }
    },
    "Keep running in background when window is closed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629 \u0639\u0646\u062f \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0641\u0630\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Hintergrund weiterlaufen, wenn das Fenster geschlossen ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep running in background when window is closed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir ejecut\u00e1ndose en segundo plano al cerrar la ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer \u00e0 s'ex\u00e9cuter en arri\u00e8re-plan lorsque la fen\u00eatre est ferm\u00e9e"
          }
        },
        "he": {
          "stringUnit": {
