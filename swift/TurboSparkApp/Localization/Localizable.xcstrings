          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0906\u0907\u091f\u092e \u091a\u0941\u0928\u0947\u0902\u0964"
