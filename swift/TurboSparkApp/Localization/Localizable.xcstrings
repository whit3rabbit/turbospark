            "state": "translated",
            "value": "Ollama bi\u00e7iminde model listesi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u0438\u0441\u043e\u043a \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0443 \u0444\u043e\u0440\u043c\u0430\u0442\u0456 Ollama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh s\u00e1ch m\u00f4 h\u00ecnh, theo \u0111\u1ecbnh d\u1ea1ng c\u1ee7a Ollama."
          }
        },
        "zh-Hans": {
          "stringUnit": {
