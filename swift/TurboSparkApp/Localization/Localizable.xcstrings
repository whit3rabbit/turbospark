    "Fits entirely in unified memory, install included.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتسع بالكامل في الذاكرة الموحدة، بما في ذلك التثبيت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Passt vollständig in den gemeinsamen Arbeitsspeicher, einschließlich der Installation."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fits entirely in unified memory, install included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabe por completo en la memoria unificada, incluida la instalación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tient entièrement dans la mémoire unifiée, installation comprise."
          }
