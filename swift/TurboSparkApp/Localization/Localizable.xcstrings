        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0902\u091f\u0930\u0948\u0915\u094d\u091f\u093f\u0935 \u0924\u0924\u094d\u0935\u094b\u0902 \u092a\u0930 \u0939\u094b\u0935\u0930 \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u0915\u0930\u094d\u0938\u0930 \u0915\u094b \u092a\u0949\u0907\u0902\u091f\u0930 \u092e\u0947\u0902 \u092c\u0926\u0932\u0947\u0902"
