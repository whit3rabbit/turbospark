            "value": "\u05d0\u05d9\u05df \u05d4\u05d5\u05e7\u05d9\u05dd \u05e8\u05e9\u05d5\u05de\u05d9\u05dd \u05d1-%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u092e\u0947\u0902 \u0915\u094b\u0908 \u0939\u0941\u0915 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
