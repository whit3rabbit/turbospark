    "Hugging Face API rate limit reached. Retry in %llds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0645\u0639\u062f\u0644 \u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u062a\u0637\u0628\u064a\u0642\u0627\u062a Hugging Face. \u0623\u0639\u062f \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0628\u0639\u062f %lld \u062b\u0627\u0646\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face-API-Ratenlimit erreicht. Wiederholen in %lld s."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API rate limit reached. Retry in %llds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanz\u00f3 el l\u00edmite de solicitudes de la API de Hugging Face. Reintenta en %lld s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de d\u00e9bit de l'API Hugging Face atteinte. R\u00e9essayez dans %lld s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e9\u05d2\u05d4 \u05de\u05d2\u05d1\u05dc\u05ea \u05d4\u05e7\u05e6\u05d1 \u05e9\u05dc Hugging Face API. \u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1 \u05d1\u05e2\u05d5\u05d3 %lld \u05e9\u05e0\u05d9\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0917\u093f\u0902\u0917 \u092b\u0947\u0938 \u090f\u092a\u0940\u0906\u0908 \u0926\u0930 \u0938\u0940\u092e\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u094b \u0917\u0908 \u0939\u0948\u0964 %lld \u0938\u0947\u0915\u0902\u0921 \u092e\u0947\u0902 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas kecepatan API Hugging Face tercapai. Coba lagi dalam %lld dtk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiunto il limite di frequenza dell'API di Hugging Face. Riprova tra %lld s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API \u306e\u30ec\u30fc\u30c8\u5236\u9650\u306b\u9054\u3057\u307e\u3057\u305f\u3002%lld \u79d2\u5f8c\u306b\u518d\u8a66\u884c\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API \uc18d\ub3c4 \uc81c\ud55c\uc5d0 \ub3c4\ub2ec\ud588\uc2b5\ub2c8\ub2e4. %lld\ucd08 \ud6c4\uc5d0 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API-snelheidslimiet bereikt. Probeer over %lld s opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osi\u0105gni\u0119to limit szybko\u015bci interfejsu API Hugging Face. Pon\u00f3w pr\u00f3b\u0119 za %lld s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de taxa da API do Hugging Face atingido. Tente novamente em %lld s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0441\u0442\u0438\u0433\u043d\u0443\u0442 \u043b\u0438\u043c\u0438\u0442 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432 API Hugging Face. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443 \u0447\u0435\u0440\u0435\u0437 %lld \u0441."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hastighetsgr\u00e4nsen f\u00f6r Hugging Face API har n\u00e5tts. F\u00f6rs\u00f6k igen om %lld s."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API h\u0131z s\u0131n\u0131r\u0131na ula\u015f\u0131ld\u0131. %lld sn sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0441\u044f\u0433\u043d\u0443\u0442\u043e \u043b\u0456\u043c\u0456\u0442\u0443 \u0437\u0430\u043f\u0438\u0442\u0456\u0432 API Hugging Face. \u041f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0441\u043f\u0440\u043e\u0431\u0443 \u0447\u0435\u0440\u0435\u0437 %lld \u0441."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 \u0111\u1ea1t \u0111\u1ebfn gi\u1edbi h\u1ea1n t\u1ef7 l\u1ec7 API Hugging Face. Th\u1eed l\u1ea1i sau %lld gi\u00e2y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8fbe\u5230 Hugging Face API \u901f\u7387\u9650\u5236\u3002\u5c06\u5728 %lld \u79d2\u540e\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u9054\u5230 Hugging Face API \u901f\u7387\u9650\u5236\u3002\u5c07\u5728 %lld \u79d2\u5f8c\u91cd\u8a66\u3002"
          }
        }
      }
    },
