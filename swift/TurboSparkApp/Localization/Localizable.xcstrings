        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u72ec\u7acb\u3057\u305f\u8a2d\u5b9a\u3001\u30c1\u30e3\u30c3\u30c8\u3001\u30b9\u30ad\u30eb\u3001\u30d7\u30e9\u30b0\u30a4\u30f3\u3001MCP \u30b5\u30fc\u30d0\u30fc\u3002"
