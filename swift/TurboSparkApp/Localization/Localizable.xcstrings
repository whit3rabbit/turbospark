    "Verified: this port has run this row end to end": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642: \u0634\u063a\u0651\u0644 \u0647\u0630\u0627 \u0627\u0644\u0645\u0646\u0641\u0630 \u0647\u0630\u0627 \u0627\u0644\u0635\u0641 \u0645\u0646 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 \u0625\u0644\u0649 \u0627\u0644\u0646\u0647\u0627\u064a\u0629"
          }
        },
        "de": {
          "stringUnit": {
