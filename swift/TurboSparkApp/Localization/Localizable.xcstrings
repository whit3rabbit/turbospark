        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc784\uc2dc \ucc44\ud305\uc740 \ub0b4\ubcf4\ub0bc \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
