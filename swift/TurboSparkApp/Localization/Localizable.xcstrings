    "Default reasoning effort for incoming requests that do not specify reasoning_effort, matching CLI --reasoning.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مستوى الاستدلال الافتراضي للطلبات الواردة التي لا تحدد reasoning_effort، ويطابق ‎--reasoning في CLI."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standard-Reasoning-Aufwand für eingehende Anfragen ohne reasoning_effort, entspricht CLI --reasoning."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Default reasoning effort for incoming requests that do not specify reasoning_effort, matching CLI --reasoning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esfuerzo de razonamiento predeterminado para las solicitudes que no indican reasoning_effort; equivale a --reasoning en la CLI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effort de raisonnement par défaut pour les requêtes qui ne précisent pas reasoning_effort, comme --reasoning dans la CLI."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רמת הסקה ברירת מחדל לבקשות נכנסות שאינן מציינות reasoning_effort, בהתאם ל-‎--reasoning ב-CLI."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन आने वाले अनुरोधों के लिए डिफ़ॉल्ट रीज़निंग प्रयास जो reasoning_effort नहीं बताते, CLI --reasoning के समान।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Upaya penalaran bawaan untuk permintaan masuk yang tidak menyebutkan reasoning_effort, sama dengan CLI --reasoning."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impegno di ragionamento predefinito per le richieste che non specificano reasoning_effort, come --reasoning nella CLI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "reasoning_effort を指定しない受信リクエストの既定の推論レベル。CLI の --reasoning と同じです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "reasoning_effort를 지정하지 않은 수신 요청의 기본 추론 수준으로, CLI --reasoning과 같습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Standaard redeneerinspanning voor binnenkomende verzoeken zonder reasoning_effort, gelijk aan CLI --reasoning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
