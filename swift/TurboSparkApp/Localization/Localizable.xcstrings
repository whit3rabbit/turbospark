    "%@ is no longer at its original path.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0639\u062f %@ \u0641\u064a \u0645\u0633\u0627\u0631\u0647 \u0627\u0644\u0623\u0635\u0644\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ befindet sich nicht mehr am urspr\u00fcnglichen Pfad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is no longer at its original path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ya no est\u00e1 en su ruta original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est plus \u00e0 son emplacement d'origine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u05db\u05d1\u05e8 \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0 \u05d1\u05e0\u05ea\u05d9\u05d1 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9 \u05e9\u05dc\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u0905\u092c \u0905\u092a\u0928\u0947 \u092e\u0942\u0932 \u092a\u0925 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak lagi berada di jalur aslinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non si trova pi\u00f9 nel percorso originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u306f\u5143\u306e\u30d1\u30b9\u306b\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uc774(\uac00) \ub354 \uc774\uc0c1 \uc6d0\ub798 \uacbd\ub85c\uc5d0 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ staat niet meer op het oorspronkelijke pad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie znajduje si\u0119 ju\u017c pod pierwotn\u0105 \u015bcie\u017ck\u0105."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n\u00e3o est\u00e1 mais no caminho original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u043c\u0443 \u043f\u0443\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ finns inte l\u00e4ngre p\u00e5 sin ursprungliga s\u00f6kv\u00e4g."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ art\u0131k \u00f6zg\u00fcn yolunda de\u011fil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u0438\u043c \u0448\u043b\u044f\u0445\u043e\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kh\u00f4ng c\u00f2n \u1edf \u0111\u01b0\u1eddng d\u1eabn ban \u0111\u1ea7u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u5df2\u4e0d\u5728\u539f\u59cb\u8def\u5f84\u4e2d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
