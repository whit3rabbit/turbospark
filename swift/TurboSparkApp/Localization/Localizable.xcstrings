        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u0439 \u0435\u043a\u0441\u043f\u043e\u0440\u0442 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0435 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0440\u043e\u0437\u043c\u0456\u0440\u0443 ZIP."
