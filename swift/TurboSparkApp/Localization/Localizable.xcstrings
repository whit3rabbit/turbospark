        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4efb\u4f55\u63a5\u53d7\u57fa\u7840 URL \u7684\u5ba2\u6237\u7aef\uff1aCursor\u3001Continue\u3001LangChain\u3002"
