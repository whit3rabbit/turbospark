    "Unloads the model and frees its memory. Loading it again takes several seconds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُلغي تحميل النموذج ويحرر ذاكرته. تستغرق إعادة تحميله عدة ثوانٍ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entlädt das Modell und gibt seinen Speicher frei. Erneutes Laden dauert einige Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unloads the model and frees its memory. Loading it again takes several seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el modelo y libera su memoria. Volver a cargarlo tarda varios segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décharge le modèle et libère sa mémoire. Le recharger prend plusieurs secondes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פורק את המודל ומשחרר את הזיכרון שלו. טעינה מחדש נמשכת כמה שניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल को अनलोड करके उसकी मेमोरी खाली करता है। दोबारा लोड करने में कई सेकंड लगते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membongkar model dan membebaskan memorinya. Memuatnya lagi memerlukan beberapa detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il modello e ne libera la memoria. Ricaricarlo richiede alcuni secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルをアンロードしてメモリを解放します。再読み込みには数秒かかります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 언로드하고 메모리를 해제합니다. 다시 로드하려면 몇 초가 걸립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontlaadt het model en maakt het geheugen vrij. Opnieuw laden duurt enkele seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyładowuje model i zwalnia jego pamięć. Ponowne załadowanie trwa kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega o modelo e libera sua memória. Carregá-lo de novo leva alguns segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выгружает модель и освобождает её память. Повторная загрузка займёт несколько секунд."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar ur modellen och frigör dess minne. Att ladda den igen tar flera sekunder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeli kaldırır ve belleğini boşaltır. Yeniden yüklemek birkaç saniye sürer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вивантажує модель і звільняє її пам'ять. Повторне завантаження займе кілька секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ mô hình và giải phóng bộ nhớ của nó. Tải lại sẽ mất vài giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "卸载模型并释放其内存。重新加载需要几秒钟。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "卸載模型並釋放其記憶體。重新載入需要幾秒鐘。"
          }
        }
      }
    },
    "Unloads the model from memory": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل النموذج من الذاكرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entlädt das Modell aus dem Arbeitsspeicher"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unloads the model from memory"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el modelo de la memoria"
