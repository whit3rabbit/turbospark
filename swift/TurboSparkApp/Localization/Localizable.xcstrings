    "Project \"%@\" declares MCP servers in its config files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u0644\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \"%@\" \u0639\u0646 \u062e\u0648\u0627\u062f\u0645 MCP \u0641\u064a \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u062a\u0643\u0648\u064a\u0646 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt \u201e%@\u201c deklariert MCP-Server in seinen Konfigurationsdateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project \"%@\" declares MCP servers in its config files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto \"%@\" declara servidores MCP en sus archivos de configuraci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet \u00ab %@ \u00bb d\u00e9clare des serveurs MCP dans ses fichiers de configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \"%@\" \u05de\u05e6\u05d4\u05d9\u05e8 \u05e2\u05dc \u05e9\u05e8\u05ea\u05d9 MCP \u05d1\u05e7\u05d5\u05d1\u05e6\u05d9 \u05d4\u05ea\u05e6\u05d5\u05e8\u05d4 \u05e9\u05dc\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \"%@\" \u0905\u092a\u0928\u0940 \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930\u0947\u0936\u0928 \u092b\u093c\u093e\u0907\u0932\u094b\u0902 \u092e\u0947\u0902 MCP \u0938\u0930\u094d\u0935\u0930 \u0918\u094b\u0937\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek \"%@\" mendeklarasikan server MCP dalam file konfigurasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il progetto \"%@\" dichiara server MCP nei relativi file di configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u300c%@\u300d\u306f\u8a2d\u5b9a\u30d5\u30a1\u30a4\u30eb\u3067 MCP \u30b5\u30fc\u30d0\u30fc\u3092\u5ba3\u8a00\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8 \"%@\"\uc774(\uac00) \uad6c\uc131 \ud30c\uc77c\uc5d0\uc11c MCP \uc11c\ubc84\ub97c \uc120\uc5b8\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Project \"%@\" declareert MCP-servers in de configuratiebestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt \u201e%@\u201d deklaruje serwery MCP w plikach konfiguracyjnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto \"%@\" declara servidores MCP em seus arquivos de configura\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0435\u043a\u0442 \u00ab%@\u00bb \u043e\u0431\u044a\u044f\u0432\u043b\u044f\u0435\u0442 \u0441\u0435\u0440\u0432\u0435\u0440\u044b MCP \u0432 \u0441\u0432\u043e\u0438\u0445 \u0444\u0430\u0439\u043b\u0430\u0445 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektet \"%@\" deklarerar MCP-servrar i sina konfigurationsfiler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" projesi, yap\u0131land\u0131rma dosyalar\u0131nda MCP sunucular\u0131n\u0131 bildiriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0435\u043a\u0442 \u00ab%@\u00bb \u043e\u0433\u043e\u043b\u043e\u0448\u0443\u0454 \u0441\u0435\u0440\u0432\u0435\u0440\u0438 MCP \u0443 \u0441\u0432\u043e\u0457\u0445 \u0444\u0430\u0439\u043b\u0430\u0445 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u1ef1 \u00e1n \"%@\" khai b\u00e1o c\u00e1c m\u00e1y ch\u1ee7 MCP trong t\u1ec7p c\u1ea5u h\u00ecnh c\u1ee7a n\u00f3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9879\u76ee\u201c%@\u201d\u5728\u5176\u914d\u7f6e\u6587\u4ef6\u4e2d\u58f0\u660e\u4e86 MCP \u670d\u52a1\u5668\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c08\u6848\u300c%@\u300d\u5728\u5176\u8a2d\u5b9a\u6a94\u4e2d\u5ba3\u544a\u4e86 MCP \u4f3a\u670d\u5668\u3002"
          }
        }
      }
    },
