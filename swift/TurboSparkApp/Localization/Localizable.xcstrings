        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u091c\u0947\u0902\u091f \u092b\u093c\u093e\u0907\u0932 '%@' Markdown \u0928\u0939\u0940\u0902 \u0939\u0948 \u0914\u0930 TurboSpark \u0907\u0938\u0947 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e\u0964"
