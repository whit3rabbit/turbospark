    "This file is larger than the 32 MB control-vector limit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u062c\u0627\u0648\u0632 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641 \u062d\u062f 32 \u0645\u064a\u063a\u0627\u0628\u0627\u064a\u062a \u0644\u0645\u062a\u062c\u0647\u0627\u062a \u0627\u0644\u062a\u062d\u0643\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei \u00fcberschreitet das Limit von 32 MB f\u00fcr Steuervektoren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is larger than the 32 MB control-vector limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este archivo supera el l\u00edmite de 32 MB para vectores de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier d\u00e9passe la limite de 32 Mo pour les vecteurs de contr\u00f4le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d5\u05d1\u05e5 \u05d6\u05d4 \u05d7\u05d5\u05e8\u05d2 \u05de\u05de\u05d2\u05d1\u05dc\u05ea \u05d4-32 MB \u05e9\u05dc \u05d5\u05e7\u05d8\u05d5\u05e8\u05d9 \u05d1\u05e7\u05e8\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092b\u093c\u093e\u0907\u0932 \u0915\u0902\u091f\u094d\u0930\u094b\u0932-\u0935\u0947\u0915\u094d\u091f\u0930 \u0915\u0940 32 MB \u0938\u0940\u092e\u093e \u0938\u0947 \u092c\u0921\u093c\u0940 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File ini melebihi batas 32 MB untuk vektor kontrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo file supera il limite di 32 MB per i vettori di controllo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d5\u30a1\u30a4\u30eb\u306f\u5236\u5fa1\u30d9\u30af\u30c8\u30eb\u306e\u4e0a\u9650 32 MB \u3092\u8d85\u3048\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud30c\uc77c\uc740 \uc81c\uc5b4 \ubca1\ud130 \ud55c\ub3c4\uc778 32MB\ub97c \ucd08\uacfc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit bestand overschrijdt de limiet van 32 MB voor stuurvectoren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten plik przekracza limit 32 MB dla wektor\u00f3w steruj\u0105cych."
