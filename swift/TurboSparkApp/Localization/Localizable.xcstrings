    "Loads live AGENTS.md or CLAUDE.md instructions from the repository root.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0642\u0648\u0645 \u0628\u062a\u062d\u0645\u064a\u0644 \u062a\u0639\u0644\u064a\u0645\u0627\u062a AGENTS.md \u0623\u0648 CLAUDE.md \u0627\u0644\u0645\u0628\u0627\u0634\u0631\u0629 \u0645\u0646 \u062c\u0630\u0631 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4dt Live-Anweisungen aus AGENTS.md oder CLAUDE.md aus dem Repository-Stammverzeichnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loads live AGENTS.md or CLAUDE.md instructions from the repository root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga instrucciones en vivo de AGENTS.md o CLAUDE.md desde la ra\u00edz del repositorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Charge les instructions AGENTS.md ou CLAUDE.md en direct depuis la racine du d\u00e9p\u00f4t."
