        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md de %@ import\u00e9. Activez SOUL.md pour l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u05e9\u05dc %@ \u05d9\u05d5\u05d1\u05d0. \u05d4\u05e4\u05e2\u05dc \u05d0\u05ea SOUL.md \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ SOUL.md \u0906\u092f\u093e\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f SOUL.md \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md %@ diimpor. Aktifkan SOUL.md untuk menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md di %@ importato. Attiva SOUL.md per usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u306eSOUL.md\u3092\u8aad\u307f\u8fbc\u307f\u307e\u3057\u305f\u3002\u4f7f\u7528\u3059\u308b\u306b\u306fSOUL.md\u3092\u6709\u52b9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ SOUL.md\ub97c \uac00\uc838\uc654\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\ud558\ub824\uba74 SOUL.md\ub97c \ucf1c\uc138\uc694."
