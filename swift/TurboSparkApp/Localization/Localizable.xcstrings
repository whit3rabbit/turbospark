          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0930\u094d\u0915\u093e\u0907\u0935 \u092e\u0947\u0902 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092a\u0925 (%@) \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u0909\u0938\u0947 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "arsip berisi jalur yang tidak aman (%@) dan ditolak"
