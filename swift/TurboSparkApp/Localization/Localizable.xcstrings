        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa mô hình khỏi máy Mac này. Chế độ đang dùng nó sẽ chuyển sang một mô hình đã cài đặt khác. Các bản chép lời bạn đã tạo vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从这台 Mac 中移除该模型。使用它的模式会改用另一个已安装的模型。你已生成的转写内容保持不变。"
