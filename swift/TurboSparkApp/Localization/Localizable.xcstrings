        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma habilidade para inspecionar instru\u00e7\u00f5es e par\u00e2metros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0430\u0432\u044b\u043a, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0438 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en f\u00e4rdighet f\u00f6r att granska instruktioner och parametrar."
