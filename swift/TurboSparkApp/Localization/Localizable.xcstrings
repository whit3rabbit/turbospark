          "stringUnit": {
            "state": "translated",
            "value": "Utilisation du contexte : %@ de la fen\u00eatre de contexte du mod\u00e8le"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05d4\u05e7\u05e9\u05e8: %@ \u05de\u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05dc"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0926\u0930\u094d\u092d \u0909\u092a\u092f\u094b\u0917: \u092e\u0949\u0921\u0932 \u0915\u0940 \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u0915\u093e %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penggunaan konteks: %@ dari jendela konteks model"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso del contesto: %@ della finestra di contesto del modello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u4f7f\u7528\u91cf\uff1a\u30e2\u30c7\u30eb\u306e\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u306e %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucee8\ud14d\uc2a4\ud2b8 \uc0ac\uc6a9\ub7c9: \ubaa8\ub378 \ucee8\ud14d\uc2a4\ud2b8 \ucc3d\uc758 %@"
          }
        },
