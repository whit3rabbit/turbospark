    "No sampling presets saved yet. Set the knobs above, then save them under a name.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u062d\u0641\u0638 \u0623\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0645\u0633\u0628\u0642\u0629 \u0644\u0623\u062e\u0630 \u0627\u0644\u0639\u064a\u0646\u0627\u062a \u0628\u0639\u062f. \u0627\u0636\u0628\u0637 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u062d\u0643\u0645 \u0623\u0639\u0644\u0627\u0647\u060c \u062b\u0645 \u0627\u062d\u0641\u0638\u0647\u0627 \u0628\u0627\u0633\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Sampling-Voreinstellungen gespeichert. Stellen Sie die Regler oben ein und speichern Sie sie unter einem Namen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No sampling presets saved yet. Set the knobs above, then save them under a name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan no hay ajustes preestablecidos de muestreo guardados. Ajusta los controles de arriba y gu\u00e1rdalos con un nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pr\u00e9r\u00e9glage d'\u00e9chantillonnage enregistr\u00e9 pour le moment. R\u00e9glez les boutons ci-dessus, puis enregistrez-les sous un nom."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05e0\u05e9\u05de\u05e8\u05d5 \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d3\u05d2\u05d9\u05de\u05d4 \u05de\u05d5\u05d2\u05d3\u05e8\u05d5\u05ea \u05de\u05e8\u05d0\u05e9. \u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05d1\u05e7\u05e8\u05d9\u05dd \u05dc\u05de\u05e2\u05dc\u05d4 \u05d5\u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05e9\u05de\u05d5\u05e8 \u05d0\u05d5\u05ea\u05dd \u05ea\u05d7\u05ea \u05e9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0924\u0915 \u0915\u094b\u0908 \u0938\u0948\u0902\u092a\u0932\u093f\u0902\u0917 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u0938\u0939\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u0917\u092f\u093e \u0939\u0948\u0964 \u090a\u092a\u0930 \u0926\u093f\u090f \u0917\u090f \u0928\u0949\u092c\u094d\u0938 \u0938\u0947\u091f \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u090f\u0915 \u0928\u093e\u092e \u0915\u0947 \u0924\u0939\u0924 \u0938\u0939\u0947\u091c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada preset pengambilan sampel yang disimpan. Atur kenop di atas, lalu simpan dengan nama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun preset di campionamento ancora salvato. Regola i controlli sopra, quindi salvali con un nome."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b5\u30f3\u30d7\u30ea\u30f3\u30b0\u30d7\u30ea\u30bb\u30c3\u30c8\u306f\u307e\u3060\u4fdd\u5b58\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u4e0a\u8a18\u306e\u3064\u307e\u307f\u3092\u8a2d\u5b9a\u3057\u3001\u540d\u524d\u3092\u4ed8\u3051\u3066\u4fdd\u5b58\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\ub41c \uc0d8\ud50c\ub9c1 \ud504\ub9ac\uc14b\uc774 \uc544\uc9c1 \uc5c6\uc2b5\ub2c8\ub2e4. \uc704\uc758 \ub178\ube0c\ub97c \uc870\uc815\ud55c \ub2e4\uc74c \uc774\ub984\uc73c\ub85c \uc800\uc7a5\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen bemonsteringsvoorinstellingen opgeslagen. Stel de knoppen hierboven in en sla ze op onder een naam."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zapisanych ustawie\u0144 pr\u00f3bkowania. Ustaw powy\u017csze suwaki, a nast\u0119pnie zapisz je pod nazw\u0105."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum predefinido de amostragem salvo ainda. Ajuste os controles acima e salve-os com um nome."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438 \u0441\u044d\u043c\u043f\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0435\u0449\u0435 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b. \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u0442\u0435 \u0440\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u044b \u0432\u044b\u0448\u0435 \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u0438\u0445 \u043f\u043e\u0434 \u0438\u043c\u0435\u043d\u0435\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga samplingsf\u00f6rinst\u00e4llningar har sparats \u00e4nnu. St\u00e4ll in knapparna ovan och spara dem sedan under ett namn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hen\u00fcz kaydedilmi\u015f bir \u00f6rnekleme \u00f6n ayar\u0131 yok. Yukar\u0131daki d\u00fc\u011fmeleri ayarlay\u0131n ve ard\u0131ndan bir adla kaydedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0430\u0431\u043b\u043e\u043d\u0438 \u0441\u0435\u043c\u043f\u043b\u044e\u0432\u0430\u043d\u043d\u044f \u0449\u0435 \u043d\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456. \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0439\u0442\u0435 \u0440\u0435\u0433\u0443\u043b\u044f\u0442\u043e\u0440\u0438 \u0432\u0438\u0449\u0435 \u0442\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044c \u0457\u0445 \u043f\u0456\u0434 \u043d\u0430\u0437\u0432\u043e\u044e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00f3 c\u00e0i \u0111\u1eb7t tr\u01b0\u1edbc l\u1ea5y m\u1eabu n\u00e0o \u0111\u01b0\u1ee3c l\u01b0u. \u0110i\u1ec1u ch\u1ec9nh c\u00e1c n\u00fat \u0111i\u1ec1u khi\u1ec3n \u1edf tr\u00ean, sau \u0111\u00f3 l\u01b0u l\u1ea1i d\u01b0\u1edbi m\u1ed9t t\u00ean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u4fdd\u5b58\u91c7\u6837\u9884\u8bbe\u3002\u8c03\u6574\u4e0a\u65b9\u7684\u65cb\u94ae\uff0c\u7136\u540e\u6307\u5b9a\u540d\u79f0\u8fdb\u884c\u4fdd\u5b58\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u5132\u5b58\u53d6\u6a23\u9810\u8a2d\u3002\u8abf\u6574\u4e0a\u65b9\u7684\u65cb\u9215\uff0c\u7136\u5f8c\u6307\u5b9a\u540d\u7a31\u9032\u884c\u5132\u5b58\u3002"
          }
        }
      }
    },
