    "Sending secrets or .env contents to any network endpoint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0631\u0633\u0627\u0644 \u0627\u0644\u0623\u0633\u0631\u0627\u0631 \u0623\u0648 \u0645\u062d\u062a\u0648\u0649 .env \u0625\u0644\u0649 \u0623\u064a \u0646\u0642\u0637\u0629 \u0634\u0628\u0643\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimnisse oder .env-Inhalte an einen Netzwerkendpunkt senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sending secrets or .env contents to any network endpoint"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar secretos o contenido de .env a cualquier punto de red"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyer des secrets ou le contenu de .env vers un point de terminaison r\u00e9seau"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05dc\u05d9\u05d7\u05ea \u05e1\u05d5\u05d3\u05d5\u05ea \u05d0\u05d5 \u05ea\u05d5\u05db\u05df .env \u05dc\u05db\u05dc \u05e0\u05e7\u05d5\u05d3\u05ea \u05e7\u05e6\u05d4 \u05d1\u05e8\u05e9\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0940\u0915\u094d\u0930\u0947\u091f \u092f\u093e .env \u0915\u0940 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u090f\u0902\u0921\u092a\u0949\u0907\u0902\u091f \u092a\u0930 \u092d\u0947\u091c\u0928\u093e"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengirim rahasia atau isi .env ke endpoint jaringan mana pun"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviare segreti o il contenuto di .env a qualsiasi endpoint di rete"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30fc\u30af\u30ec\u30c3\u30c8\u3084 .env \u306e\u5185\u5bb9\u3092\u30cd\u30c3\u30c8\u30ef\u30fc\u30af\u4e0a\u306e\u9001\u4fe1\u5148\u306b\u9001\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube44\ubc00 \uc815\ubcf4\ub098 .env \ub0b4\uc6a9\uc744 \ub124\ud2b8\uc6cc\ud06c \uc5d4\ub4dc\ud3ec\uc778\ud2b8\ub85c \ubcf4\ub0b4\uae30"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimen of .env-inhoud naar een netwerkeindpunt sturen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysy\u0142anie sekret\u00f3w lub zawarto\u015bci .env do dowolnego punktu sieciowego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviar segredos ou o conte\u00fado de .env para qualquer endpoint de rede"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043f\u0440\u0430\u0432\u043a\u0430 \u0441\u0435\u043a\u0440\u0435\u0442\u043e\u0432 \u0438\u043b\u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0433\u043e .env \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u0441\u0435\u0442\u0435\u0432\u043e\u0439 \u0430\u0434\u0440\u0435\u0441"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skicka hemligheter eller .env-inneh\u00e5ll till n\u00e5gon n\u00e4tverksslutpunkt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli bilgileri veya .env i\u00e7eri\u011fini herhangi bir a\u011f u\u00e7 noktas\u0131na g\u00f6ndermek"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f \u0441\u0435\u043a\u0440\u0435\u0442\u0456\u0432 \u0430\u0431\u043e \u0432\u043c\u0456\u0441\u0442\u0443 .env \u043d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0443 \u043c\u0435\u0440\u0435\u0436\u0435\u0432\u0443 \u0430\u0434\u0440\u0435\u0441\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u1eedi b\u00ed m\u1eadt ho\u1eb7c n\u1ed9i dung .env \u0111\u1ebfn b\u1ea5t k\u1ef3 \u0111i\u1ec3m cu\u1ed1i m\u1ea1ng n\u00e0o"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u5bc6\u94a5\u6216 .env \u5185\u5bb9\u53d1\u9001\u5230\u4efb\u4f55\u7f51\u7edc\u7aef\u70b9"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u5bc6\u9470\u6216 .env \u5167\u5bb9\u50b3\u9001\u5230\u4efb\u4f55\u7db2\u8def\u7aef\u9ede"
          }
        }
      }
    },
