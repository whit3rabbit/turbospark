            "value": "Selecione um agente para inspecionar as instruções de sistema e os recursos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите агента, чтобы посмотреть системные инструкции и возможности."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム指示と機能を確認するエージェントを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
