        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e7\u05d5\u05e8 git \u05d3\u05d5\u05e8\u05e9 \u05db\u05ea\u05d5\u05d1\u05ea https:// \u05d0\u05d5 ssh://."
