          "stringUnit": {
            "state": "translated",
            "value": "ماذا تود أن تبني أو تستكشف؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप क्या बनाना या खोजना चाहते हैं?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil je bouwen of ontdekken?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chciałbyś zbudować lub odkryć?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne oluşturmak veya keşfetmek istersiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
