    "Temporary chat: this conversation can't be recovered.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محادثة مؤقتة: لا يمكن استعادة هذه المحادثة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporärer Chat: Diese Unterhaltung kann nicht wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary chat: this conversation can't be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporal: esta conversación no se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussion temporaire : cette conversation ne peut pas être récupérée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שיחה זמנית: לא ניתן לשחזר את השיחה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्थायी चैट: यह बातचीत पुनर्प्राप्त नहीं की जा सकती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan sementara: percakapan ini tidak dapat dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporanea: questa conversazione non può essere recuperata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なチャットです。この会話は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 대화: 이 대화는 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdelijke chat: dit gesprek kan niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat tymczasowy: tej rozmowy nie można odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporário: esta conversa não pode ser recuperada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временный чат: эту беседу нельзя восстановить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillfällig chatt: den här konversationen kan inte återställas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici sohbet: bu konuşma kurtarılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасовий чат: цю розмову не можна відновити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện tạm thời: không thể khôi phục nội dung này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时对话: 此会话无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時對話: 此對話無法復原。"
          }
        }
      }
    },
    "Temporary chats cannot be exported.": {
      "localizations": {
        "ar": {
