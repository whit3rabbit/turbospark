    "Unsupported audio format (.%@). Convert to M4A or WAV and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0646\u0633\u064a\u0642 \u0635\u0648\u062a \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645 (.%@). \u062d\u0648\u0651\u0644\u0647 \u0625\u0644\u0649 M4A \u0623\u0648 WAV \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterst\u00fctztes Audioformat (.%@). Konvertiere es in M4A oder WAV und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported audio format (.%@). Convert to M4A or WAV and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de audio no compatible (.%@). Convi\u00e9rtelo a M4A o WAV e int\u00e9ntalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format audio non pris en charge (.%@). Convertissez-le en M4A ou WAV, puis r\u00e9essayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d1\u05e0\u05d9\u05ea \u05e9\u05de\u05e2 \u05dc\u05d0 \u05e0\u05ea\u05de\u05db\u05ea (.%@). \u05d4\u05de\u05e8 \u05dc\u2011M4A \u05d0\u05d5 \u05dc\u2011WAV \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0911\u0921\u093f\u092f\u094b \u092b\u093c\u0949\u0930\u094d\u092e\u0948\u091f (.%@)\u0964 M4A \u092f\u093e WAV \u092e\u0947\u0902 \u092c\u0926\u0932\u0947\u0902 \u0914\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format audio tidak didukung (.%@). Konversikan ke M4A atau WAV, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato audio non supportato (.%@). Convertilo in M4A o WAV e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u306a\u3044\u30aa\u30fc\u30c7\u30a3\u30aa\u5f62\u5f0f\u3067\u3059\uff08.%@\uff09\u3002M4A \u307e\u305f\u306f WAV \u306b\u5909\u63db\u3057\u3066\u304b\u3089\u3001\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uc6d0\ub418\uc9c0 \uc54a\ub294 \uc624\ub514\uc624 \ud615\uc2dd\uc785\ub2c8\ub2e4(.%@). M4A \ub610\ub294 WAV\ub85c \ubcc0\ud658\ud55c \ud6c4 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet-ondersteunde audio-indeling (.%@). Converteer naar M4A of WAV en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobs\u0142ugiwany format d\u017awi\u0119ku (.%@). Przekonwertuj go na M4A lub WAV i spr\u00f3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de \u00e1udio incompat\u00edvel (.%@). Converta para M4A ou WAV e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0439 \u0430\u0443\u0434\u0438\u043e\u0444\u043e\u0440\u043c\u0430\u0442 (.%@). \u041f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u0443\u0439\u0442\u0435 \u0435\u0433\u043e \u0432 M4A \u0438\u043b\u0438 WAV \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudformatet st\u00f6ds inte (.%@). Konvertera till M4A eller WAV och f\u00f6rs\u00f6k igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenmeyen ses bi\u00e7imi (.%@). M4A veya WAV bi\u00e7imine d\u00f6n\u00fc\u015ft\u00fcr\u00fcp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0438\u0439 \u0430\u0443\u0434\u0456\u043e\u0444\u043e\u0440\u043c\u0430\u0442 (.%@). \u041f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u043d\u0430 M4A \u0430\u0431\u043e WAV \u0456 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ecbnh d\u1ea1ng \u00e2m thanh kh\u00f4ng \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 (.%@). H\u00e3y chuy\u1ec3n sang M4A ho\u1eb7c WAV r\u1ed3i th\u1eed l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u652f\u6301\u7684\u97f3\u9891\u683c\u5f0f\uff08.%@\uff09\u3002\u8bf7\u8f6c\u6362\u4e3a M4A \u6216 WAV \u540e\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u652f\u63f4\u7684\u97f3\u8a0a\u683c\u5f0f\uff08.%@\uff09\u3002\u8acb\u8f49\u63db\u70ba M4A \u6216 WAV \u5f8c\u518d\u8a66\u4e00\u6b21\u3002"
          }
        }
      }
    },
