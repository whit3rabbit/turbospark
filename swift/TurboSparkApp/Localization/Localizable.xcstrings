        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez un mod\u00e8le ou ouvrez un dossier de mod\u00e8les existant pour poursuivre cette discussion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05e7\u05df \u05de\u05d5\u05d3\u05dc \u05d0\u05d5 \u05e4\u05ea\u05d7 \u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05e7\u05d9\u05d9\u05de\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d0\u05ea \u05d4\u05e9\u05d9\u05d7\u05d4 \u05d4\u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u091a\u0948\u091f \u0915\u094b \u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092e\u0949\u0921\u0932 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0947\u0902 \u092f\u093e \u092e\u094c\u091c\u0942\u0926\u093e \u092e\u0949\u0921\u0932 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0916\u094b\u0932\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instal model atau buka folder model yang ada untuk melanjutkan obrolan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa un modello o apri una cartella di modelli esistente per continuare questa chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30c1\u30e3\u30c3\u30c8\u3092\u7d9a\u3051\u308b\u306b\u306f\u3001\u30e2\u30c7\u30eb\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3059\u308b\u304b\u3001\u65e2\u5b58\u306e\u30e2\u30c7\u30eb\u30d5\u30a9\u30eb\u30c0\u3092\u958b\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
