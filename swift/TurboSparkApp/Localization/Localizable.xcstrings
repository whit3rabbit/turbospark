          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7531\u65bc\u672a\u63d0\u4f9b\u539f\u56e0\uff0c\u5df2\u6368\u68c4\u751f\u6210\u7684\u5c3e\u7aef\u5167\u5bb9\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u062a\u062c\u0627\u0647\u0644 \u0627\u0644\u0630\u064a\u0644 \u0627\u0644\u0645\u064f\u0648\u0644\u0651\u062f \u0644\u0639\u062f\u0645 \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0633\u0628\u0628."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u093e\u0930\u0923 \u0928\u093f\u0930\u094d\u0926\u093f\u0937\u094d\u091f \u0928 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u091c\u0928\u0930\u0947\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0905\u0902\u0924\u093f\u092e \u092d\u093e\u0917 \u091b\u094b\u0921\u093c \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
