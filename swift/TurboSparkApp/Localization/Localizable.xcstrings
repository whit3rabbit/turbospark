    "This app version has no runtime for this model, so no mode can use it. You can delete it to free disk space.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الإصدار من التطبيق على بيئة تشغيل لهذا النموذج، لذا لا يمكن لأي وضع استخدامه. يمكنك حذفه لتحرير مساحة على القرص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese App-Version hat keine Laufzeitumgebung für dieses Modell, daher kann kein Modus es nutzen. Du kannst es löschen, um Speicherplatz freizugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app version has no runtime for this model, so no mode can use it. You can delete it to free disk space."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión de la app no tiene un entorno de ejecución para este modelo, así que ningún modo puede usarlo. Puedes eliminarlo para liberar espacio en disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette version de l'app n'a pas d'environnement d'exécution pour ce modèle, aucun mode ne peut donc l'utiliser. Vous pouvez le supprimer pour libérer de l'espace disque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לגרסה זו של האפליקציה אין סביבת הרצה למודל זה, ולכן אף מצב לא יכול להשתמש בו. ניתן למחוק אותו כדי לשחרר מקום בדיסק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ऐप संस्करण में इस मॉडल के लिए कोई रनटाइम नहीं है, इसलिए कोई मोड इसका उपयोग नहीं कर सकता। डिस्क स्थान खाली करने के लिए आप इसे हटा सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi aplikasi ini tidak memiliki runtime untuk model ini, sehingga tidak ada mode yang dapat menggunakannya. Anda dapat menghapusnya untuk mengosongkan ruang disk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione dell'app non ha un runtime per questo modello, quindi nessuna modalità può usarlo. Puoi eliminarlo per liberare spazio su disco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このバージョンのアプリにはこのモデルのランタイムがないため、どのモードでも使えません。削除してディスク容量を空けることができます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 앱 버전에는 이 모델을 위한 런타임이 없으므로 어떤 모드도 사용할 수 없습니다. 삭제하여 디스크 공간을 확보할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze versie van de app heeft geen runtime voor dit model, dus geen enkele modus kan het gebruiken. Je kunt het verwijderen om schijfruimte vrij te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta wersja aplikacji nie ma środowiska uruchomieniowego dla tego modelu, więc żaden tryb nie może go używać. Możesz go usunąć, aby zwolnić miejsce na dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versão do app não tem um ambiente de execução para este modelo, então nenhum modo pode usá-lo. Você pode excluí-lo para liberar espaço em disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой версии приложения нет среды выполнения для этой модели, поэтому её не может использовать ни один режим. Вы можете удалить её, чтобы освободить место на диске."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här versionen av appen har ingen körmiljö för den här modellen, så inget läge kan använda den. Du kan ta bort den för att frigöra diskutrymme."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulama sürümünde bu model için bir çalışma zamanı yok, bu nedenle hiçbir mod onu kullanamaz. Disk alanı boşaltmak için silebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цій версії застосунку немає середовища виконання для цієї моделі, тому її не може використовувати жоден режим. Ви можете видалити її, щоб звільнити місце на диску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản ứng dụng này không có môi trường chạy cho mô hình này, nên không chế độ nào dùng được nó. Bạn có thể xóa nó để giải phóng dung lượng đĩa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 App 没有可运行此模型的运行时，因此任何模式都无法使用它。你可以删除它以释放磁盘空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此版本的 App 沒有可執行此模型的執行環境，因此任何模式都無法使用它。你可以刪除它以釋放磁碟空間。"
          }
        }
      }
    },
    "This audio window is too large. Process the recording in smaller sections.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This audio window is too large. Process the recording in smaller sections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ventana de audio es demasiado grande. Procesa la grabación en secciones más pequeñas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fenêtre audio est trop grande. Traitez l'enregistrement par sections plus petites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Audiofenster ist zu groß. Verarbeite die Aufnahme in kleineren Abschnitten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa finestra audio è troppo grande. Elabora la registrazione in sezioni più piccole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela de áudio é grande demais. Processe a gravação em seções menores."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit audiovenster is te groot. Verwerk de opname in kleinere secties."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här ljudfönstret är för stort. Bearbeta inspelningen i mindre avsnitt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To okno audio jest zbyt duże. Przetwarzaj nagranie w mniejszych sekcjach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ses penceresi çok büyük. Kaydı daha küçük bölümler halinde işleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela audio ini terlalu besar. Proses rekaman dalam bagian yang lebih kecil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это аудиоокно слишком велико. Обработайте запись небольшими разделами."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це аудіовікно завелике. Обробіть запис меншими розділами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cửa sổ âm thanh này quá lớn. Xử lý bản ghi theo các phần nhỏ hơn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この音声ウィンドウは大きすぎます。録音を小さなセクションに分けて処理してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 오디오 구간이 너무 큽니다. 녹음을 더 작은 섹션으로 처리하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此音频窗口过大。请将录音分成较小的段落进行处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此音訊視窗過大。請將錄音分成較小的段落處理。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نافذة الصوت هذه كبيرة جداً. عالج التسجيل في أقسام أصغر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלון השמע הזה גדול מדי. עבד את ההקלטה במקטעים קטנים יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऑडियो विंडो बहुत बड़ी है। रिकॉर्डिंग को छोटे खंडों में प्रोसेस करें।"
          }
        }
      }
    },
