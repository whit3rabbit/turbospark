    "Always allow this tool and command in this session": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0633\u0645\u0627\u062d \u062f\u0627\u0626\u0645\u0627\u064b \u0628\u0647\u0630\u0647 \u0627\u0644\u0623\u062f\u0627\u0629 \u0648\u0647\u0630\u0627 \u0627\u0644\u0623\u0645\u0631 \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u062c\u0644\u0633\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Tool und diesen Befehl in dieser Sitzung immer erlauben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always allow this tool and command in this session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permitir siempre esta herramienta y este comando en esta sesi\u00f3n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours autoriser cet outil et cette commande pendant cette session"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05e4\u05e9\u05e8 \u05ea\u05de\u05d9\u05d3 \u05d0\u05ea \u05d4\u05db\u05dc\u05d9 \u05d5\u05d4\u05e4\u05e7\u05d5\u05d3\u05d4 \u05d4\u05d0\u05dc\u05d4 \u05d1\u05d4\u05e4\u05e2\u05dc\u05d4 \u05d6\u05d5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u0924\u094d\u0930 \u092e\u0947\u0902 \u0907\u0938 \u091f\u0942\u0932 \u0914\u0930 \u0915\u092e\u093e\u0902\u0921 \u0915\u094b \u0939\u092e\u0947\u0936\u093e \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu izinkan alat dan perintah ini di sesi ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti sempre questo strumento e questo comando in questa sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30bb\u30c3\u30b7\u30e7\u30f3\u3067\u3053\u306e\u30c4\u30fc\u30eb\u3068\u30b3\u30de\u30f3\u30c9\u3092\u5e38\u306b\u8a31\u53ef"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc138\uc158\uc5d0\uc11c \uc774 \ub3c4\uad6c\uc640 \uba85\ub839\uc744 \ud56d\uc0c1 \ud5c8\uc6a9"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze tool en opdracht altijd toestaan in deze sessie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze zezwalaj na to narz\u0119dzie i polecenie w tej sesji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre permitir esta ferramenta e este comando nesta sess\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435\u0433\u0434\u0430 \u0440\u0430\u0437\u0440\u0435\u0448\u0430\u0442\u044c \u044d\u0442\u043e\u0442 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0438 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0432 \u044d\u0442\u043e\u043c \u0441\u0435\u0430\u043d\u0441\u0435"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till\u00e5t alltid det h\u00e4r verktyget och kommandot i den h\u00e4r sessionen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu oturumda bu araca ve komuta her zaman izin ver"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0436\u0434\u0438 \u0434\u043e\u0437\u0432\u043e\u043b\u044f\u0442\u0438 \u0446\u0435\u0439 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0456 \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0432 \u0446\u044c\u043e\u043c\u0443 \u0441\u0435\u0430\u043d\u0441\u0456"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lu\u00f4n cho ph\u00e9p c\u00f4ng c\u1ee5 v\u00e0 l\u1ec7nh n\u00e0y trong phi\u00ean n\u00e0y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64\u4f1a\u8bdd\u4e2d\u59cb\u7ec8\u5141\u8bb8\u6b64\u5de5\u5177\u548c\u547d\u4ee4"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64\u5de5\u4f5c\u968e\u6bb5\u4e2d\u6c38\u9060\u5141\u8a31\u6b64\u5de5\u5177\u548c\u6307\u4ee4"
          }
        }
      }
