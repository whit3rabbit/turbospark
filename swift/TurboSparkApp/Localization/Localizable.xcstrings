    "A recording is already active. Stop it before starting another.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A recording is already active. Stop it before starting another."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay una grabaci\u00f3n activa. Detenla antes de iniciar otra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un enregistrement est d\u00e9j\u00e0 en cours. Arr\u00eatez-le avant d'en lancer un autre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Aufnahme l\u00e4uft bereits. Beende sie, bevor du eine weitere startest."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c8 gi\u00e0 in corso una registrazione. Interrompila prima di iniziarne un'altra."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "J\u00e1 h\u00e1 uma grava\u00e7\u00e3o ativa. Pare-a antes de iniciar outra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een opname. Stop die voordat je een nieuwe start."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En inspelning p\u00e5g\u00e5r redan. Stoppa den innan du startar en ny."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie ju\u017c trwa. Zatrzymaj je przed rozpocz\u0119ciem kolejnego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten etkin bir kay\u0131t var. Yenisini ba\u015flatmadan \u00f6nce durdurun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman sudah aktif. Hentikan sebelum memulai yang lain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u044c \u0443\u0436\u0435 \u0438\u0434\u0451\u0442. \u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0435\u0451 \u043f\u0435\u0440\u0435\u0434 \u043d\u0430\u0447\u0430\u043b\u043e\u043c \u043d\u043e\u0432\u043e\u0439."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441 \u0443\u0436\u0435 \u0442\u0440\u0438\u0432\u0430\u0454. \u0417\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u043c \u043d\u043e\u0432\u043e\u0433\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110ang c\u00f3 m\u1ed9t b\u1ea3n ghi ho\u1ea1t \u0111\u1ed9ng. H\u00e3y d\u1eebng tr\u01b0\u1edbc khi b\u1eaft \u0111\u1ea7u b\u1ea3n kh\u00e1c."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3067\u306b\u9332\u97f3\u4e2d\u3067\u3059\u3002\u5225\u306e\u9332\u97f3\u3092\u958b\u59cb\u3059\u308b\u524d\u306b\u505c\u6b62\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubbf8 \ub179\uc74c\uc774 \uc9c4\ud589 \uc911\uc785\ub2c8\ub2e4. \ub2e4\ub978 \ub179\uc74c\uc744 \uc2dc\uc791\ud558\uae30 \uc804\uc5d0 \uc911\uc9c0\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6709\u5f55\u97f3\u6b63\u5728\u8fdb\u884c\u3002\u8bf7\u5148\u505c\u6b62\uff0c\u518d\u5f00\u59cb\u65b0\u7684\u5f55\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6709\u9304\u97f3\u6b63\u5728\u9032\u884c\u3002\u8acb\u5148\u505c\u6b62\uff0c\u518d\u958b\u59cb\u65b0\u7684\u9304\u97f3\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0648\u062c\u062f \u062a\u0633\u062c\u064a\u0644 \u0646\u0634\u0637 \u0628\u0627\u0644\u0641\u0639\u0644. \u0623\u0648\u0642\u0641\u0647 \u0642\u0628\u0644 \u0628\u062f\u0621 \u062a\u0633\u062c\u064a\u0644 \u0622\u062e\u0631."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05d1\u05e8 \u05de\u05ea\u05d1\u05e6\u05e2\u05ea \u05d4\u05e7\u05dc\u05d8\u05d4. \u05e2\u05e6\u05d5\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05ea\u05ea\u05d7\u05d9\u05dc \u05d0\u05d7\u05e8\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u092a\u0939\u0932\u0947 \u0938\u0947 \u091a\u093e\u0932\u0942 \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u0940 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0909\u0938\u0947 \u0930\u094b\u0915\u0947\u0902\u0964"
          }
        }
      }
    },
    "Audio exported": {
      "extractionState": "manual",
