        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u81f4\u3059\u308b\u627f\u8a8d\u6e08\u307f\u30e1\u30e2\u30ea\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
