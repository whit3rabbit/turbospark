            "state": "translated",
            "value": "\u5bbd\u5ea6"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bec\u5ea6"
          }
        }
      }
    },
    "Windows past the trained one still load. Quality beyond it is the checkpoint's business, not this engine's.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0646\u0648\u0627\u0641\u0630 \u0627\u0644\u062a\u064a \u062a\u062a\u062c\u0627\u0648\u0632 \u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u062a\u062f\u0631\u064a\u0628 \u062a\u064f\u062d\u0645\u064e\u0651\u0644 \u0623\u064a\u0636\u064b\u0627. \u0627\u0644\u062c\u0648\u062f\u0629 \u0628\u0639\u062f\u0647\u0627 \u0634\u0623\u0646 \u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u062d\u0642\u0642\u060c \u0644\u0627 \u0634\u0623\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u062d\u0631\u0643."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fenster \u00fcber dem trainierten laden trotzdem. Die Qualit\u00e4t dar\u00fcber hinaus ist Sache des Checkpoints, nicht dieser Engine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Windows past the trained one still load. Quality beyond it is the checkpoint's business, not this engine's."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ventanas mayores que la entrenada se cargan igualmente. La calidad m\u00e1s all\u00e1 de ese punto depende del checkpoint, no de este motor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fen\u00eatres au-del\u00e0 de celle d'entra\u00eenement se chargent quand m\u00eame. La qualit\u00e9 au-del\u00e0 rel\u00e8ve du checkpoint, pas de ce moteur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05dc\u05d5\u05e0\u05d5\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc\u05d6\u05d4 \u05e9\u05d0\u05d5\u05de\u05df \u05d9\u05d9\u05d8\u05e2\u05e0\u05d5 \u05d1\u05db\u05dc \u05d6\u05d0\u05ea. \u05d4\u05d0\u05d9\u05db\u05d5\u05ea \u05de\u05e2\u05d1\u05e8 \u05dc\u05db\u05da \u05d4\u05d9\u05d0 \u05e2\u05e0\u05d9\u05d9\u05e0\u05d4 \u05e9\u05dc \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05d1\u05d3\u05d9\u05e7\u05d4, \u05dc\u05d0 \u05e9\u05dc \u05d4\u05de\u05e0\u05d5\u05e2 \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u093f\u0924 \u0935\u093f\u0902\u0921\u094b \u0938\u0947 \u092c\u0921\u093c\u0940 \u0935\u093f\u0902\u0921\u094b \u092d\u0940 \u0932\u094b\u0921 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964 \u0909\u0938\u0915\u0947 \u0906\u0917\u0947 \u0915\u0940 \u0917\u0941\u0923\u0935\u0924\u094d\u0924\u093e \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u0915\u093e \u092e\u093e\u092e\u0932\u093e \u0939\u0948, \u0907\u0938 \u0907\u0902\u091c\u0928 \u0915\u093e \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela di atas yang dilatih tetap dimuat. Kualitas di luar itu urusan checkpoint, bukan mesin ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le finestre oltre quella addestrata si caricano comunque. La qualit\u00e0 oltre quel punto dipende dal checkpoint, non da questo motore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b66\u7fd2\u6642\u306e\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u8d85\u3048\u3066\u3082\u8aad\u307f\u8fbc\u3081\u307e\u3059\u3002\u305d\u308c\u3092\u8d85\u3048\u305f\u54c1\u8cea\u306f\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u5074\u306e\u554f\u984c\u3067\u3001\u3053\u306e\u30a8\u30f3\u30b8\u30f3\u306e\u554f\u984c\u3067\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud559\uc2b5\ub41c \ucc3d\uc744 \ub118\ub294 \uac12\ub3c4 \ub85c\ub4dc\ub429\ub2c8\ub2e4. \uadf8 \uc774\uc0c1\uc758 \ud488\uc9c8\uc740 \uc774 \uc5d4\uc9c4\uc774 \uc544\ub2c8\ub77c \uccb4\ud06c\ud3ec\uc778\ud2b8\uc758 \ubaab\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vensters voorbij het getrainde laden gewoon. De kwaliteit daarbuiten is een zaak van het checkpoint, niet van deze engine."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Okna wi\u0119ksze ni\u017c wytrenowane te\u017c si\u0119 wczytaj\u0105. Jako\u015b\u0107 powy\u017cej zale\u017cy od checkpointu, nie od tego silnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Janelas al\u00e9m da treinada carregam mesmo assim. A qualidade al\u00e9m dela \u00e9 assunto do checkpoint, n\u00e3o deste motor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043a\u043d\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u043e\u0431\u0443\u0447\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0441\u0451 \u0440\u0430\u0432\u043d\u043e \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044e\u0442\u0441\u044f. \u041a\u0430\u0447\u0435\u0441\u0442\u0432\u043e \u0437\u0430 \u0435\u0433\u043e \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u043c\u0438 \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043e\u0442 \u0447\u0435\u043a\u043f\u043e\u0438\u043d\u0442\u0430, \u0430 \u043d\u0435 \u043e\u0442 \u044d\u0442\u043e\u0433\u043e \u0434\u0432\u0438\u0436\u043a\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00f6nster bortom det tr\u00e4nade laddas \u00e4nd\u00e5. Kvaliteten d\u00e4rut\u00f6ver \u00e4r checkpointens sak, inte den h\u00e4r motorns."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u011fitilen pencerenin \u00f6tesindeki de\u011ferler de y\u00fcklenir. Bunun \u00f6tesindeki kalite bu motorun de\u011fil, denetim noktas\u0131n\u0131n meselesidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u043a\u043d\u0430, \u0431\u0456\u043b\u044c\u0448\u0456 \u0437\u0430 \u043d\u0430\u0432\u0447\u0435\u043d\u0435, \u0432\u0441\u0435 \u043e\u0434\u043d\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u044e\u0442\u044c\u0441\u044f. \u042f\u043a\u0456\u0441\u0442\u044c \u043f\u043e\u0437\u0430 \u043d\u0438\u043c \u0437\u0430\u043b\u0435\u0436\u0438\u0442\u044c \u0432\u0456\u0434 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0457 \u0442\u043e\u0447\u043a\u0438, \u0430 \u043d\u0435 \u0432\u0456\u0434 \u0446\u044c\u043e\u0433\u043e \u0440\u0443\u0448\u0456\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1eeda s\u1ed5 v\u01b0\u1ee3t m\u1ee9c \u0111\u00e3 hu\u1ea5n luy\u1ec7n v\u1eabn t\u1ea3i \u0111\u01b0\u1ee3c. Ch\u1ea5t l\u01b0\u1ee3ng ngo\u00e0i m\u1ee9c \u0111\u00f3 l\u00e0 vi\u1ec7c c\u1ee7a checkpoint, kh\u00f4ng ph\u1ea3i c\u1ee7a engine n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d85\u8fc7\u8bad\u7ec3\u7a97\u53e3\u7684\u8bbe\u7f6e\u4ecd\u53ef\u52a0\u8f7d\u3002\u8d85\u51fa\u90e8\u5206\u7684\u8d28\u91cf\u53d6\u51b3\u4e8e\u68c0\u67e5\u70b9\uff0c\u800c\u975e\u672c\u5f15\u64ce\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d85\u904e\u8a13\u7df4\u8996\u7a97\u7684\u8a2d\u5b9a\u4ecd\u53ef\u8f09\u5165\u3002\u8d85\u51fa\u90e8\u5206\u7684\u54c1\u8cea\u53d6\u6c7a\u65bc\u6aa2\u67e5\u9ede\uff0c\u800c\u975e\u672c\u5f15\u64ce\u3002"
          }
        }
      }
    },
    "With a project attached, the model gets a persistent memory directory and a `memory` tool: it saves durable facts about you and the project as it learns them, and an index of what it remembers is always in its context. Memories live on disk, one folder per project. Type `#` followed by text to save one yourself, or /memory to open the folder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0639 \u0625\u0631\u0641\u0627\u0642 \u0645\u0634\u0631\u0648\u0639\u060c \u064a\u062d\u0635\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0639\u0644\u0649 \u062f\u0644\u064a\u0644 \u0630\u0627\u0643\u0631\u0629 \u062f\u0627\u0626\u0645 \u0648\u0623\u062f\u0627\u0629 `memory`: \u0641\u0647\u0648 \u064a\u062d\u0641\u0638 \u062d\u0642\u0627\u0626\u0642 \u062f\u0627\u0626\u0645\u0629 \u0639\u0646\u0643 \u0648\u0639\u0646 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0623\u062b\u0646\u0627\u0621 \u062a\u0639\u0644\u0645\u0647\u0627\u060c \u0648\u064a\u0643\u0648\u0646 \u0641\u0647\u0631\u0633 \u0645\u0627 \u064a\u062a\u0630\u0643\u0631\u0647 \u0645\u0648\u062c\u0648\u062f\u064b\u0627 \u062f\u0627\u0626\u0645\u064b\u0627 \u0641\u064a \u0633\u064a\u0627\u0642\u0647. \u062a\u0639\u064a\u0634 \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0635\u060c \u0645\u062c\u0644\u062f \u0648\u0627\u062d\u062f \u0644\u0643\u0644 \u0645\u0634\u0631\u0648\u0639. \u0627\u0643\u062a\u0628 `#` \u0645\u062a\u0628\u0648\u0639\u064b\u0627 \u0628\u0646\u0635 \u0644\u062d\u0641\u0638 \u0648\u0627\u062d\u062f\u0629 \u0628\u0646\u0641\u0633\u0643\u060c \u0623\u0648 /memory \u0644\u0641\u062a\u062d \u0627\u0644\u0645\u062c\u0644\u062f."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn ein Projekt angeh\u00e4ngt ist, erh\u00e4lt das Modell ein permanentes Speicherverzeichnis und ein `memory`-Tool: Es speichert dauerhafte Fakten \u00fcber Sie und das Projekt, w\u00e4hrend es diese lernt, und ein Index seiner Erinnerungen ist immer in seinem Kontext. Erinnerungen befinden sich auf der Festplatte, ein Ordner pro Projekt. Geben Sie `#` gefolgt von Text ein, um selbst eine zu speichern, oder /memory, um den Ordner zu \u00f6ffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With a project attached, the model gets a persistent memory directory and a `memory` tool: it saves durable facts about you and the project as it learns them, and an index of what it remembers is always in its context. Memories live on disk, one folder per project. Type `#` followed by text to save one yourself, or /memory to open the folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un proyecto adjunto, el modelo obtiene un directorio de memoria persistente y una herramienta `memory`: guarda datos duraderos sobre ti y el proyecto a medida que los aprende, y un \u00edndice de lo que recuerda est\u00e1 siempre en su contexto. Las memorias se almacenan en el disco, una carpeta por proyecto. Escribe `#` seguido de texto para guardar uno t\u00fa mismo, o /memory para abrir la carpeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un projet joint, le mod\u00e8le dispose d'un r\u00e9pertoire de m\u00e9moire persistant et d'un outil `memory` : il enregistre des faits durables sur vous et le projet au fur et \u00e0 mesure qu'il les apprend, et un index de ce dont il se souvient est toujours dans son contexte. Les souvenirs r\u00e9sident sur le disque, un dossier par projet. Tapez `#` suivi d'un texte pour en enregistrer un vous-m\u00eame, ou /memory pour ouvrir le dossier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05d0\u05e9\u05e8 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05de\u05e6\u05d5\u05e8\u05e3, \u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05e7\u05d1\u05dc \u05e1\u05e4\u05e8\u05d9\u05d9\u05ea \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e7\u05d1\u05d5\u05e2\u05d4 \u05d5\u05db\u05dc\u05d9 `memory`: \u05d4\u05d5\u05d0 \u05e9\u05d5\u05de\u05e8 \u05e2\u05d5\u05d1\u05d3\u05d5\u05ea \u05e2\u05de\u05d9\u05d3\u05d5\u05ea \u05e2\u05dc\u05d9\u05da \u05d5\u05e2\u05dc \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05e9\u05d4\u05d5\u05d0 \u05dc\u05d5\u05de\u05d3 \u05d0\u05d5\u05ea\u05df, \u05d5\u05d0\u05d9\u05e0\u05d3\u05e7\u05e1 \u05e9\u05dc \u05de\u05d4 \u05e9\u05d4\u05d5\u05d0 \u05d6\u05d5\u05db\u05e8 \u05ea\u05de\u05d9\u05d3 \u05e0\u05de\u05e6\u05d0 \u05d1\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc\u05d5. \u05d6\u05d9\u05db\u05e8\u05d5\u05e0\u05d5\u05ea \u05d7\u05d9\u05d9\u05dd \u05d1\u05d3\u05d9\u05e1\u05e7, \u05ea\u05d9\u05e7\u05d9\u05d4 \u05d0\u05d7\u05ea \u05dc\u05db\u05dc \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8. \u05d4\u05e7\u05dc\u05d3 `#` \u05d5\u05d0\u05d7\u05e8\u05d9\u05d5 \u05d8\u05e7\u05e1\u05d8 \u05db\u05d3\u05d9 \u05dc\u05e9\u05de\u05d5\u05e8 \u05d0\u05d7\u05d3 \u05d1\u05e2\u05e6\u05de\u05da, \u05d0\u05d5 /memory \u05db\u05d3\u05d9 \u05dc\u05e4\u05ea\u05d5\u05d7 \u05d0\u05ea \u05d4\u05ea\u05d9\u05e7\u05d9\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0938\u0902\u0932\u0917\u094d\u0928 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0938\u093e\u0925, \u092e\u0949\u0921\u0932 \u0915\u094b \u090f\u0915 \u0938\u094d\u0925\u093e\u092f\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e \u0914\u0930 \u090f\u0915 `memory` \u091f\u0942\u0932 \u092e\u093f\u0932\u0924\u093e \u0939\u0948: \u092f\u0939 \u0906\u092a\u0915\u0947 \u0914\u0930 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091f\u093f\u0915\u093e\u090a \u0924\u0925\u094d\u092f\u094b\u0902 \u0915\u094b \u0938\u0940\u0916\u0924\u093e \u0939\u0948 \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0938\u0939\u0947\u091c\u0924\u093e \u0939\u0948, \u0914\u0930 \u091c\u094b \u0915\u0941\u091b \u092d\u0940 \u092f\u093e\u0926 \u0930\u0916\u0924\u093e \u0939\u0948 \u0909\u0938\u0915\u093e \u090f\u0915 \u0938\u0942\u091a\u0915\u093e\u0902\u0915 \u0939\u092e\u0947\u0936\u093e \u0907\u0938\u0915\u0947 \u0938\u0902\u0926\u0930\u094d\u092d \u092e\u0947\u0902 \u0939\u094b\u0924\u093e \u0939\u0948\u0964 \u092f\u093e\u0926\u0947\u0902 \u0921\u093f\u0938\u094d\u0915 \u092a\u0930 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902, \u092a\u094d\u0930\u0924\u093f \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u090f\u0915 \u092b\u093c\u094b\u0932\u094d\u0921\u0930\u0964 \u0938\u094d\u0935\u092f\u0902 \u0915\u094b \u0938\u0939\u0947\u091c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f `#` \u0915\u0947 \u092c\u093e\u0926 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902, \u092f\u093e \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f /memory \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dengan proyek terlampir, model mendapatkan direktori memori persisten dan alat `memory`: ia menyimpan fakta tahan lama tentang Anda dan proyek saat mempelajarinya, dan indeks dari apa yang diingatnya selalu ada dalam konteksnya. Memori hidup di disk, satu folder per proyek. Ketik `#` diikuti teks untuk menyimpannya sendiri, atau /memory untuk membuka folder."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con un progetto allegato, il modello ottiene una directory di memoria persistente e uno strumento `memory`: salva informazioni durature su di te e sul progetto man mano che le apprende, e un indice di ci\u00f2 che ricorda \u00e8 sempre nel suo contesto. I ricordi risiedono su disco, una cartella per progetto. Digita `#` seguito dal testo per salvarne uno tu stesso, oppure /memory per aprire la cartella."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u304c\u30a2\u30bf\u30c3\u30c1\u3055\u308c\u308b\u3068\u3001\u30e2\u30c7\u30eb\u306f\u6c38\u7d9a\u30e1\u30e2\u30ea\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u3068 `memory` \u30c4\u30fc\u30eb\u3092\u53d6\u5f97\u3057\u307e\u3059\u3002\u5b66\u7fd2\u3057\u305f\u3042\u306a\u305f\u3084\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306b\u95a2\u3059\u308b\u6c38\u7d9a\u7684\u306a\u30d5\u30a1\u30af\u30c8\u3092\u4fdd\u5b58\u3057\u3001\u8a18\u61b6\u3057\u305f\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u306f\u5e38\u306b\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u5185\u306b\u4fdd\u6301\u3055\u308c\u307e\u3059\u3002\u30e1\u30e2\u30ea\u306f\u30c7\u30a3\u30b9\u30af\u4e0a\u306b\u5b58\u5728\u3057\u3001\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3054\u3068\u306b 1 \u3064\u306e\u30d5\u30a9\u30eb\u30c0\u306b\u306a\u308a\u307e\u3059\u3002\u81ea\u5206\u3067\u4fdd\u5b58\u3059\u308b\u306b\u306f `#` \u306e\u5f8c\u306b\u30c6\u30ad\u30b9\u30c8\u3092\u5165\u529b\u3059\u308b\u304b\u3001/memory \u3092\u5165\u529b\u3057\u3066\u30d5\u30a9\u30eb\u30c0\u3092\u958b\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8\uac00 \uc5f0\uacb0\ub418\uba74 \ubaa8\ub378\uc740 \uc601\uad6c \uba54\ubaa8\ub9ac \ub514\ub809\ud130\ub9ac\uc640 `memory` \ub3c4\uad6c\ub97c \uac16\uac8c \ub429\ub2c8\ub2e4. \ud559\uc2b5\ud558\uba74\uc11c \uc0ac\uc6a9\uc790\uc640 \ud504\ub85c\uc81d\ud2b8\uc5d0 \ub300\ud55c \uc9c0\uc18d\uc801\uc778 \uc0ac\uc2e4\uc744 \uc800\uc7a5\ud558\uba70 \uae30\uc5b5\ud558\ub294 \ub0b4\uc6a9\uc758 \uc778\ub371\uc2a4\ub294 \ud56d\uc0c1 \ucee8\ud14d\uc2a4\ud2b8\uc5d0 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uba54\ubaa8\ub9ac\ub294 \ud504\ub85c\uc81d\ud2b8\ub2f9 \ud558\ub098\uc758 \ud3f4\ub354\ub85c \ub514\uc2a4\ud06c\uc5d0 \uc800\uc7a5\ub429\ub2c8\ub2e4. \uc9c1\uc811 \uc800\uc7a5\ud558\ub824\uba74 `#` \ub4a4\uc5d0 \ud14d\uc2a4\ud2b8\ub97c \uc785\ub825\ud558\uac70\ub098 /memory\ub97c \uc785\ub825\ud558\uc5ec \ud3f4\ub354\ub97c \uc5ec\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanneer een project is gekoppeld, krijgt het model een permanente geheugenmap en een `memory`-tool: het slaat duurzame feiten over u en het project op terwijl het deze leert, en een index van wat het zich herinnert bevindt zich altijd in de context. Herinneringen staan op de schijf, \u00e9\u00e9n map per project. Typ `#` gevolgd door tekst om er zelf een op te slaan, of /memory om de map te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po do\u0142\u0105czeniu projektu model otrzymuje trwa\u0142y katalog pami\u0119ci i narz\u0119dzie `memory`: zapisuje trwa\u0142e fakty o Tobie i projekcie w miar\u0119 ich poznawania, a indeks tego, co pami\u0119ta, zawsze znajduje si\u0119 w jego kontek\u015bcie. Wspomnienia znajduj\u0105 si\u0119 na dysku, po jednym folderze na projekt. Wpisz `#`, a nast\u0119pnie tekst, aby zapisa\u0107 wspomnienie samodzielnie, lub /memory, aby otworzy\u0107 folder."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um projeto anexado, o modelo ganha um diret\u00f3rio de mem\u00f3ria persistente e uma ferramenta `memory`: ele salva fatos duradouros sobre voc\u00ea e o projeto conforme os aprende, e um \u00edndice do que ele lembra est\u00e1 sempre em seu contexto. As mem\u00f3rias ficam no disco, uma pasta por projeto. Digite `#` seguido de texto para salvar uma voc\u00ea mesmo, ou /memory para abrir a pasta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u043f\u043e\u0441\u0442\u043e\u044f\u043d\u043d\u044b\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u043f\u0430\u043c\u044f\u0442\u0438 \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 `memory`: \u043e\u043d\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0434\u043e\u043b\u0433\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0444\u0430\u043a\u0442\u044b \u043e \u0432\u0430\u0441 \u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0435 \u043f\u043e \u043c\u0435\u0440\u0435 \u0438\u0445 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f, \u0430 \u0438\u043d\u0434\u0435\u043a\u0441 \u0437\u0430\u043f\u043e\u043c\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u0432\u0441\u0435\u0433\u0434\u0430 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u0432 \u0435\u0435 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0435. \u041f\u0430\u043c\u044f\u0442\u044c \u0445\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u043d\u0430 \u0434\u0438\u0441\u043a\u0435, \u043f\u043e \u043e\u0434\u043d\u043e\u0439 \u043f\u0430\u043f\u043a\u0435 \u043d\u0430 \u043f\u0440\u043e\u0435\u043a\u0442. \u0412\u0432\u0435\u0434\u0438\u0442\u0435 `#`, \u0430 \u0437\u0430\u0442\u0435\u043c \u0442\u0435\u043a\u0441\u0442, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0444\u0430\u043a\u0442 \u0441\u0430\u043c\u043e\u0441\u0442\u043e\u044f\u0442\u0435\u043b\u044c\u043d\u043e, \u0438\u043b\u0438 /memory, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u043f\u0430\u043f\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Med ett projekt bifogat f\u00e5r modellen en best\u00e4ndig minneskatalog och ett `memory`-verktyg: den sparar h\u00e5llbara fakta om dig och projektet n\u00e4r den l\u00e4r sig dem, och ett index \u00f6ver vad den kommer ih\u00e5g finns alltid i dess sammanhang. Minnen lever p\u00e5 disk, en mapp per projekt. Skriv `#` f\u00f6ljt av text f\u00f6r att spara en sj\u00e4lv, eller /memory f\u00f6r att \u00f6ppna mappen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir proje eklendi\u011finde model, kal\u0131c\u0131 bir bellek dizini ve bir `memory` arac\u0131 al\u0131r: \u00f6\u011frendik\u00e7e sizin ve proje hakk\u0131nda kal\u0131c\u0131 ger\u00e7ekleri kaydeder ve hat\u0131rlad\u0131klar\u0131n\u0131n bir dizini her zaman ba\u011flam\u0131nda yer al\u0131r. An\u0131lar diskte, proje ba\u015f\u0131na bir klas\u00f6rde ya\u015far. Kendiniz bir tane kaydetmek i\u00e7in `#` ve ard\u0131ndan metin yaz\u0131n veya klas\u00f6r\u00fc a\u00e7mak i\u00e7in /memory yaz\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043b\u0438 \u043f\u0440\u043e\u0435\u043a\u0442 \u043f\u0440\u0438\u043a\u0440\u0456\u043f\u043b\u0435\u043d\u043e, \u043c\u043e\u0434\u0435\u043b\u044c \u043e\u0442\u0440\u0438\u043c\u0443\u0454 \u043f\u043e\u0441\u0442\u0456\u0439\u043d\u0438\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u043f\u0430\u043c'\u044f\u0442\u0456 \u0442\u0430 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 `memory`: \u0432\u043e\u043d\u0430 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0434\u043e\u0432\u0433\u043e\u0442\u0440\u0438\u0432\u0430\u043b\u0456 \u0444\u0430\u043a\u0442\u0438 \u043f\u0440\u043e \u0432\u0430\u0441 \u0456 \u043f\u0440\u043e\u0435\u043a\u0442 \u0443 \u043c\u0456\u0440\u0443 \u0457\u0445 \u0432\u0438\u0432\u0447\u0435\u043d\u043d\u044f, \u0430 \u043f\u043e\u043a\u0430\u0436\u0447\u0438\u043a \u0442\u043e\u0433\u043e, \u0449\u043e \u0432\u043e\u043d\u0430 \u043f\u0430\u043c'\u044f\u0442\u0430\u0454, \u0437\u0430\u0432\u0436\u0434\u0438 \u0437\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c\u0441\u044f \u0432 \u0457\u0457 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0456. \u0421\u043f\u043e\u0433\u0430\u0434\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0434\u0438\u0441\u043a\u0443, \u043f\u043e \u043e\u0434\u043d\u0456\u0439 \u043f\u0430\u043f\u0446\u0456 \u043d\u0430 \u043f\u0440\u043e\u0435\u043a\u0442. \u0412\u0432\u0435\u0434\u0456\u0442\u044c `#`, \u0430 \u043f\u043e\u0442\u0456\u043c \u0442\u0435\u043a\u0441\u0442, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0441\u043f\u043e\u0433\u0430\u0434 \u0432\u043b\u0430\u0441\u043d\u043e\u0440\u0443\u0447, \u0430\u0431\u043e /memory, \u0449\u043e\u0431 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u043f\u0430\u043f\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi \u0111\u00ednh k\u00e8m m\u1ed9t d\u1ef1 \u00e1n, m\u00f4 h\u00ecnh s\u1ebd c\u00f3 m\u1ed9t th\u01b0 m\u1ee5c b\u1ed9 nh\u1edb li\u00ean t\u1ee5c v\u00e0 m\u1ed9t c\u00f4ng c\u1ee5 `memory`: n\u00f3 l\u01b0u c\u00e1c s\u1ef1 ki\u1ec7n l\u00e2u d\u00e0i v\u1ec1 b\u1ea1n v\u00e0 d\u1ef1 \u00e1n khi t\u00ecm hi\u1ec3u ch\u00fang, \u0111\u1ed3ng th\u1eddi ch\u1ec9 m\u1ee5c nh\u1eefng g\u00ec n\u00f3 ghi nh\u1edb lu\u00f4n n\u1eb1m trong ng\u1eef c\u1ea3nh c\u1ee7a n\u00f3. K\u1ef7 ni\u1ec7m n\u1eb1m tr\u00ean \u0111\u0129a, m\u1ed7i d\u1ef1 \u00e1n m\u1ed9t th\u01b0 m\u1ee5c. Nh\u1eadp `#` theo sau l\u00e0 v\u0103n b\u1ea3n \u0111\u1ec3 t\u1ef1 l\u01b0u m\u1ed9t k\u1ef7 ni\u1ec7m ho\u1eb7c /memory \u0111\u1ec3 m\u1edf th\u01b0 m\u1ee5c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9644\u52a0\u9879\u76ee\u540e\uff0c\u6a21\u578b\u5c06\u83b7\u5f97\u4e00\u4e2a\u6301\u4e45\u8bb0\u5fc6\u76ee\u5f55\u548c\u4e00\u4e2a `memory` \u5de5\u5177\uff1a\u968f\u7740\u5b66\u4e60\uff0c\u5b83\u4f1a\u4fdd\u5b58\u5173\u4e8e\u4f60\u548c\u9879\u76ee\u7684\u957f\u671f\u4e8b\u5b9e\uff0c\u5e76\u4e14\u5176\u8bb0\u5fc6\u7d22\u5f15\u59cb\u7ec8\u5b58\u5728\u4e8e\u5176\u4e0a\u4e0b\u6587\u4e2d\u3002\u8bb0\u5fc6\u4fdd\u5b58\u5728\u78c1\u76d8\u4e0a\uff0c\u6bcf\u4e2a\u9879\u76ee\u4e00\u4e2a\u6587\u4ef6\u5939\u3002\u8f93\u5165 `#` \u540e\u8ddf\u6587\u672c\u53ef\u81ea\u884c\u4fdd\u5b58\u4e00\u6761\u8bb0\u5fc6\uff0c\u6216\u8f93\u5165 /memory \u6253\u5f00\u8be5\u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9644\u52a0\u5c08\u6848\u5f8c\uff0c\u6a21\u578b\u5c07\u7372\u5f97\u4e00\u500b\u6301\u4e45\u8a18\u61b6\u76ee\u9304\u548c\u4e00\u500b `memory` \u5de5\u5177\uff1a\u96a8\u8457\u5b78\u7fd2\uff0c\u5b83\u6703\u4fdd\u5b58\u95dc\u65bc\u4f60\u548c\u5c08\u6848\u7684\u9577\u671f\u4e8b\u5be6\uff0c\u4e26\u4e14\u5176\u8a18\u61b6\u7d22\u5f15\u59cb\u7d42\u5b58\u5728\u65bc\u5176\u4e0a\u4e0b\u6587\u4e2d\u3002\u8a18\u61b6\u4fdd\u5b58\u5728\u78c1\u789f\u4e0a\uff0c\u6bcf\u500b\u5c08\u6848\u4e00\u500b\u8cc7\u6599\u593e\u3002\u8f38\u5165 `#` \u5f8c\u8ddf\u6587\u5b57\u53ef\u81ea\u884c\u4fdd\u5b58\u4e00\u689d\u8a18\u61b6\uff0c\u6216\u8f38\u5165 /memory \u958b\u555f\u8a72\u8cc7\u6599\u593e\u3002"
          }
        }
      }
    },
    "Word document (.docx)": {
