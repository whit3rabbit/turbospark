    "Every installed model is already attached.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جميع النماذج المثبتة مرفقة بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle installierten Modelle sind bereits angehängt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every installed model is already attached."
          }
        },
        "es": {
