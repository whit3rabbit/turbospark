    "No key is set, so the snippets send a placeholder that is never checked.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key is set, so the snippets send a placeholder that is never checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave configurada, así que los fragmentos envían un marcador de posición que nunca se comprueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune clé n'est définie ; les extraits envoient donc un espace réservé qui n'est jamais vérifié."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Schlüssel festgelegt, daher senden die Snippets einen Platzhalter, der nie geprüft wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è impostata alcuna chiave, quindi gli snippet inviano un segnaposto che non viene mai verificato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave está definida, então os trechos enviam um espaço reservado que nunca é verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ не задан, поэтому фрагменты отправляют заполнитель, который никогда не проверяется."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーが設定されていないため、スニペットは検証されないプレースホルダーを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키가 설정되어 있지 않아 스니펫은 검사되지 않는 자리표시자를 보냅니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未设置密钥，因此代码片段发送的是从不校验的占位符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定金鑰，因此程式碼片段送出的是從不驗證的預留位置。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُضبط أي مفتاح، لذا ترسل المقتطفات نائبا لا يُتحقق منه أبدا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא הוגדר מפתח, ולכן קטעי הקוד שולחים ממלא מקום שאינו נבדק לעולם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई कुंजी सेट नहीं है, इसलिए स्निपेट ऐसा प्लेसहोल्डर भेजते हैं जिसकी कभी जांच नहीं होती।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen sleutel ingesteld, dus de snippets sturen een tijdelijke aanduiding die nooit wordt gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono klucza, więc fragmenty wysyłają symbol zastępczy, który nigdy nie jest sprawdzany."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar ayarlanmadığı için parçacıklar hiç denetlenmeyen bir yer tutucu gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ не задано, тому фрагменти надсилають заповнювач, який ніколи не перевіряється."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nyckel är angiven, så kodavsnitten skickar en platshållare som aldrig kontrolleras."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa đặt khóa, nên các đoạn mã gửi một chỗ giữ chỗ không bao giờ được kiểm tra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada kunci yang diatur, jadi cuplikan mengirim placeholder yang tidak pernah diperiksa."
          }
        }
      }
    },
