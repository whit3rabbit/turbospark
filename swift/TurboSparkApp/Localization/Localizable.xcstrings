        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u691c\u7d22\u306b\u4e00\u81f4\u3059\u308b\u30b9\u30bf\u30a4\u30eb\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac80\uc0c9\uacfc \uc77c\uce58\ud558\ub294 \uc2a4\ud0c0\uc77c\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u7b26\u5408\u641c\u7d22\u7684\u98ce\u683c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u7b26\u5408\u641c\u5c0b\u7684\u98a8\u683c\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0623\u0646\u0645\u0627\u0637 \u062a\u0637\u0627\u0628\u0642 \u0628\u062d\u062b\u0643."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05e1\u05d2\u05e0\u05d5\u05e0\u05d5\u05ea \u05e9\u05ea\u05d5\u05d0\u05de\u05d9\u05dd \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e9\u05dc\u05da."
