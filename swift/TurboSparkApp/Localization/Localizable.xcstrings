    "Project sources include user sources. Removing a source keeps installed items.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062a\u0636\u0645\u0646 \u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0645\u0635\u0627\u062f\u0631 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645. \u0625\u0632\u0627\u0644\u0629 \u0627\u0644\u0645\u0635\u062f\u0631 \u062a\u062d\u0627\u0641\u0638 \u0639\u0644\u0649 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u062b\u0628\u062a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektquellen enthalten Benutzerquellen. Beim Entfernen einer Quelle bleiben installierte Elemente erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project sources include user sources. Removing a source keeps installed items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes del proyecto incluyen las fuentes del usuario. Eliminar una fuente conserva los elementos instalados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources du projet incluent les sources utilisateur. La suppression d'une source conserve les \u00e9l\u00e9ments install\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05d5\u05dc\u05dc\u05d9\u05dd \u05de\u05e7\u05d5\u05e8\u05d5\u05ea \u05de\u05e9\u05ea\u05de\u05e9. \u05d4\u05e1\u05e8\u05ea \u05de\u05e7\u05d5\u05e8 \u05e9\u05d5\u05de\u05e8\u05ea \u05e2\u05dc \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05de\u05d5\u05ea\u05e7\u05e0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0938\u094d\u0930\u094b\u0924\u094b\u0902 \u092e\u0947\u0902 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u094d\u0930\u094b\u0924 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964 \u0938\u094d\u0930\u094b\u0924 \u0939\u091f\u093e\u0928\u0947 \u092a\u0930 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0906\u0907\u091f\u092e \u092c\u0928\u0947 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber proyek mencakup sumber pengguna. Menghapus sumber tetap menyimpan item yang terpasang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le origini del progetto includono le origini utente. La rimozione di un'origine mantiene gli elementi installati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30bd\u30fc\u30b9\u306b\u306f\u30e6\u30fc\u30b6\u30fc\u30bd\u30fc\u30b9\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30bd\u30fc\u30b9\u3092\u524a\u9664\u3057\u3066\u3082\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u9805\u76ee\u306f\u4fdd\u6301\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8 \uc18c\uc2a4\uc5d0\ub294 \uc0ac\uc6a9\uc790 \uc18c\uc2a4\uac00 \ud3ec\ud568\ub429\ub2c8\ub2e4. \uc18c\uc2a4\ub97c \uc81c\uac70\ud574\ub3c4 \uc124\uce58\ub41c \ud56d\ubaa9\uc740 \uc720\uc9c0\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projectbronnen omvatten gebruikersbronnen. Het verwijderen van een bron behoudt ge\u00efnstalleerde items."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0179r\u00f3d\u0142a projektu obejmuj\u0105 \u017ar\u00f3d\u0142a u\u017cytkownika. Usuni\u0119cie \u017ar\u00f3d\u0142a zachowuje zainstalowane elementy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes do projeto incluem fontes do usu\u00e1rio. Remover uma fonte mant\u00e9m os itens instalados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0438 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f. \u0423\u0434\u0430\u043b\u0435\u043d\u0438\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektk\u00e4llor inkluderar anv\u00e4ndark\u00e4llor. Att ta bort en k\u00e4lla beh\u00e5ller installerade objekt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje kaynaklar\u0131 kullan\u0131c\u0131 kaynaklar\u0131n\u0131 i\u00e7erir. Bir kayna\u011f\u0131 kald\u0131rmak y\u00fckl\u00fc \u00f6\u011feleri korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0436\u0435\u0440\u0435\u043b\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0443 \u0432\u043a\u043b\u044e\u0447\u0430\u044e\u0442\u044c \u0434\u0436\u0435\u0440\u0435\u043b\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430. \u0412\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f \u0434\u0436\u0435\u0440\u0435\u043b\u0430 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0456 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngu\u1ed3n d\u1ef1 \u00e1n bao g\u1ed3m ngu\u1ed3n ng\u01b0\u1eddi d\u00f9ng. X\u00f3a ngu\u1ed3n v\u1eabn gi\u1eef l\u1ea1i c\u00e1c m\u1ee5c \u0111\u00e3 c\u00e0i \u0111\u1eb7t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9879\u76ee\u6e90\u5305\u542b\u7528\u6237\u6e90\u3002\u79fb\u9664\u6e90\u4f1a\u4fdd\u7559\u5df2\u5b89\u88c5\u7684\u9879\u76ee\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c08\u6848\u4f86\u6e90\u5305\u542b\u4f7f\u7528\u8005\u4f86\u6e90\u3002\u79fb\u9664\u4f86\u6e90\u6703\u4fdd\u7559\u5df2\u5b89\u88dd\u7684\u9805\u76ee\u3002"
          }
        }
      }
    },
