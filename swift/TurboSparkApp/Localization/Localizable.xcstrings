        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфликт восстановления: сохранённый частичный ответ больше не совпадает с расшифровкой."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
