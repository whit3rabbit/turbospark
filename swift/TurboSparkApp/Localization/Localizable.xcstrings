        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente da riepilogare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3060\u307e\u3068\u3081\u308b\u5185\u5bb9\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc9c1 \uc694\uc57d\ud560 \ub0b4\uc6a9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets om samen te vatten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze czego podsumowa\u0107."
