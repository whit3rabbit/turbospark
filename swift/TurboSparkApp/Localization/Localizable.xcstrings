        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "git \u0938\u094d\u0930\u094b\u0924 \u0915\u0947 \u0932\u093f\u090f https:// \u092f\u093e ssh:// URL \u091a\u093e\u0939\u093f\u090f\u0964"
