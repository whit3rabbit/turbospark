        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u0438\u0437 %@ \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 SOUL.md, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e."
