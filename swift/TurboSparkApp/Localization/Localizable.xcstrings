          "stringUnit": {
            "state": "translated",
            "value": "Chiedi approvazione: chiedi prima che gli strumenti modifichino file o usino Internet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認を求める：ツールがファイルを編集したりインターネットを使う前に確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인 요청: 도구가 파일을 편집하거나 인터넷을 쓰기 전에 묻기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om goedkeuring vragen: vragen voordat tools bestanden bewerken of internet gebruiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytaj o zgodę: pytaj, zanim narzędzia zmienią pliki lub użyją internetu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir aprovação: perguntar antes que ferramentas editem arquivos ou usem a internet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрашивать одобрение: спрашивать, прежде чем инструменты изменят файлы или выйдут в интернет"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be om godkännande: fråga innan verktyg redigerar filer eller använder internet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay iste: araçlar dosya düzenlemeden veya internete erişmeden önce sor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запитувати схвалення: питати, перш ніж інструменти змінять файли чи вийдуть в інтернет"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỏi phê duyệt: hỏi trước khi công cụ sửa tệp hoặc dùng internet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求批准：工具编辑文件或访问互联网前先询问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求核准：工具編輯檔案或存取網際網路前先詢問"
          }
        }
      }
    },
    "Ask for each page dialog": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "السؤال عن كل مربع حوار للصفحة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Seitendialog nachfragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask for each page dialog"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar en cada diálogo de la página"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander pour chaque dialogue de page"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לשאול על כל תיבת דו־שיח של דף"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पेज डायलॉग के लिए पूछें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan untuk setiap dialog halaman"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi per ogni finestra di dialogo della pagina"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ページのダイアログごとに確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
