            "value": "\u30ed\u30fc\u30ab\u30eb\u30e2\u30c7\u30eb\u304c\u307e\u3060\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
