        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्थायी चैट: यह बातचीत पुनर्प्राप्त नहीं की जा सकती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan sementara: percakapan ini tidak dapat dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporanea: questa conversazione non può essere recuperata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なチャットです。この会話は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 대화: 이 대화는 복구할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdelijke chat: dit gesprek kan niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat tymczasowy: tej rozmowy nie można odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporário: esta conversa não pode ser recuperada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временный чат: эту беседу нельзя восстановить."
          }
        },
