          "stringUnit": {
            "state": "translated",
            "value": "Acquire skills from local agent harnesses (Claude, Cursor, Codex) or remote Git/HTTPS marketplaces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén habilidades desde entornos de agentes locales (Claude, Cursor, Codex) o desde marketplaces remotos Git/HTTPS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérez des compétences depuis des environnements d'agents locaux (Claude, Cursor, Codex) ou des places de marché Git/HTTPS distantes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehen Sie Skills aus lokalen Agent-Umgebungen (Claude, Cursor, Codex) oder aus entfernten Git/HTTPS-Marktplätzen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Acquisisci competenze da ambienti di agenti locali (Claude, Cursor, Codex) o da marketplace remoti Git/HTTPS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha habilidades de ambientes de agentes locais (Claude, Cursor, Codex) ou de marketplaces remotos Git/HTTPS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получайте навыки из локальных агентских окружений (Claude, Cursor, Codex) или из удаленных маркетплейсов Git/HTTPS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルのエージェント環境 (Claude、Cursor、Codex) やリモートの Git/HTTPS マーケットプレイスからスキルを取得します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 에이전트 환경(Claude, Cursor, Codex) 또는 원격 Git/HTTPS 마켓플레이스에서 스킬을 가져옵니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从本地代理环境 (Claude、Cursor、Codex) 或远程 Git/HTTPS 市场获取技能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從本機代理環境 (Claude、Cursor、Codex) 或遠端 Git/HTTPS 市集取得技能。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على المهارات من بيئات الوكلاء المحلية (Claude أو Cursor أو Codex) أو من أسواق Git/HTTPS البعيدة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל מיומנויות מסביבות סוכן מקומיות (Claude, Cursor, Codex) או ממרכזי Git/HTTPS מרוחקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानीय एजेंट हार्नेस (Claude, Cursor, Codex) या रिमोट Git/HTTPS मार्केटप्लेस से स्किल प्राप्त करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal skills op uit lokale agentomgevingen (Claude, Cursor, Codex) of uit externe Git/HTTPS-marktplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobieraj umiejętności z lokalnych środowisk agentów (Claude, Cursor, Codex) lub ze zdalnych marketplace'ów Git/HTTPS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel aracı ortamlarından (Claude, Cursor, Codex) veya uzak Git/HTTPS pazarlarından beceri edinin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте навички з локальних агентських середовищ (Claude, Cursor, Codex) або з віддалених маркетплейсів Git/HTTPS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hämta färdigheter från lokala agentmiljöer (Claude, Cursor, Codex) eller från fjärrmarknadsplatser via Git/HTTPS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấy kỹ năng từ môi trường tác nhân cục bộ (Claude, Cursor, Codex) hoặc từ chợ Git/HTTPS từ xa."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan keterampilan dari lingkungan agen lokal (Claude, Cursor, Codex) atau dari marketplace Git/HTTPS jarak jauh."
          }
        }
      }
