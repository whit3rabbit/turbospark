          }
        }
      }
    },
    "The encrypted key envelope is malformed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u063a\u0644\u0641 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0645\u0634\u0641\u0631 \u062a\u0627\u0644\u0641."
