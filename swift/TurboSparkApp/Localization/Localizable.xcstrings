        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0434\u0435\u043c\u043e\u043d\u0430 \u043f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u043a\u043b\u044e\u0447 API TypeSafe."
          }
        },
        "vi": {
