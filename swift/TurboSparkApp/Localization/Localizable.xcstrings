        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u9589\u3058\u305f\u5f8c\u3082\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u5b9f\u884c\u3092\u7d99\u7d9a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
