        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u0438 \u043f\u043e\u043c\u043d\u0438\u0442\u044c \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u043c\u0435\u0436\u0434\u0443 \u0434\u0438\u0430\u043b\u043e\u0433\u0430\u043c\u0438"
