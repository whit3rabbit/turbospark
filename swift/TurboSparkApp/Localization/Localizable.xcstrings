    "Re-checks access for every folder listed here": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u064a\u062f \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0643\u0644 \u0645\u062c\u0644\u062f \u0645\u062f\u0631\u062c \u0647\u0646\u0627"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00fcft den Zugriff auf jeden hier aufgef\u00fchrten Ordner erneut"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Re-checks access for every folder listed here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a comprobar el acceso a cada carpeta de esta lista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rev\u00e9rifie l'acc\u00e8s \u00e0 chaque dossier list\u00e9 ici"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d5\u05d3\u05e7 \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05d4\u05d2\u05d9\u05e9\u05d4 \u05dc\u05db\u05dc \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05e9\u05de\u05d5\u05e4\u05d9\u05e2\u05d4 \u05db\u05d0\u05df"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939\u093e\u0901 \u0938\u0942\u091a\u0940\u092c\u0926\u094d\u0927 \u0939\u0930 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0915\u0940 \u090f\u0915\u094d\u0938\u0947\u0938 \u0926\u094b\u092c\u093e\u0930\u093e \u091c\u093e\u0901\u091a\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memeriksa ulang akses ke setiap folder yang tercantum di sini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricontrolla l'accesso a ogni cartella elencata qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u3053\u306b\u8868\u793a\u3055\u308c\u3066\u3044\u308b\u3059\u3079\u3066\u306e\u30d5\u30a9\u30eb\u30c0\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u518d\u78ba\u8a8d\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5ec\uae30\uc5d0 \ub098\uc5f4\ub41c \ubaa8\ub4e0 \ud3f4\ub354\uc758 \uc811\uadfc \uad8c\ud55c\uc744 \ub2e4\uc2dc \ud655\uc778\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleert de toegang tot elke hier vermelde map opnieuw"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponownie sprawdza dost\u0119p do ka\u017cdego wymienionego tu folderu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica novamente o acesso a cada pasta listada aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f \u043a\u043e \u0432\u0441\u0435\u043c \u043f\u0435\u0440\u0435\u0447\u0438\u0441\u043b\u0435\u043d\u043d\u044b\u043c \u0437\u0434\u0435\u0441\u044c \u043f\u0430\u043f\u043a\u0430\u043c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollerar \u00e5tkomsten till varje mapp som visas h\u00e4r igen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada listelenen her klas\u00f6r\u00fcn eri\u015fimini yeniden denetler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0454 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043a\u043e\u0436\u043d\u043e\u0457 \u043f\u0430\u043f\u043a\u0438 \u0437 \u0446\u044c\u043e\u0433\u043e \u0441\u043f\u0438\u0441\u043a\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ki\u1ec3m tra l\u1ea1i quy\u1ec1n truy c\u1eadp v\u00e0o m\u1ecdi th\u01b0 m\u1ee5c \u0111\u01b0\u1ee3c li\u1ec7t k\u00ea \u1edf \u0111\u00e2y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u65b0\u68c0\u67e5\u6b64\u5904\u5217\u51fa\u7684\u6bcf\u4e2a\u6587\u4ef6\u5939\u7684\u8bbf\u95ee\u6743\u9650"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u65b0\u6aa2\u67e5\u6b64\u8655\u5217\u51fa\u7684\u6bcf\u500b\u6a94\u6848\u593e\u7684\u53d6\u7528\u6b0a\u9650"
          }
        }
      }
    },
    "Opens this pane in macOS System Settings": {
