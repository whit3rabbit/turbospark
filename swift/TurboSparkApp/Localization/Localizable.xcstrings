    "The quick brown fox jumps over the lazy dog": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص حكيم له سر قاطع وذو شأن عظيم مكتوب على ثوب أخضر ومغلف بجلد أزرق"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Franz jagt im komplett verwahrlosten Taxi quer durch Bayern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The quick brown fox jumps over the lazy dog"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El veloz murciélago hindú comía feliz cardillo y kiwi"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portez ce vieux whisky au juge blond qui fume"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דג סקרן שט בים מאוכזב ולפתע מצא חברה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऋषियों को सताने वाले दुष्ट राक्षसों के राजा रावण का सर्वनाश करने वाले विष्णुवतार भगवान श्रीराम"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muharjo seorang xenofobia universal yang takut pada kegelapan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pranzo d'acqua fa volti sghembi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いろはにほへと ちりぬるを わかよたれそ つねならむ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다람쥐 헌 쳇바퀴에 타고파"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pa's wijze lynx bezag vroom het fikse aquaduct"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pchnąć w tę łódź jeża lub ośm skrzyń fig"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um pequeno jabuti xereta viu dez cegonhas felizes"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Съешь еще этих мягких французских булок да выпей чаю"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flygande bäckasiner söka hwila på mjuka tuvor"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pijamalı hasta yağız şoföre çabucak güvendi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Чуєш їх, доцю, га? Кумедна ж ти, прощайся без ґольфів"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Con voi sáu chân nhảy qua bờ đê xanh mướt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "天地玄黄，宇宙洪荒，日月盈昃，辰宿列张"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "天地玄黃，宇宙洪荒，日月盈昃，辰宿列張"
          }
        }
      }
    },
