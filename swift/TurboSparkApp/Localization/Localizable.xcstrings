    "Welcome back! What are we working on?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back! What are we working on?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¡Bienvenido de nuevo! ¿En qué estamos trabajando?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour ! Sur quoi travaillons-nous ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zurück! Woran arbeiten wir?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentornato! Su cosa stiamo lavorando?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo de volta! No que estamos trabalhando?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "С возвращением! Над чем мы работаем?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お帰りなさい！何に取り組みましょうか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 오신 것을 환영합니다! 어떤 작업을 진행할까요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎回来！我们接下来做什么？"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "歡迎回來！我們接下來做什麼？"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مرحبًا بعودتك! على ماذا نعمل؟"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वापसी पर स्वागत है! हम किस पर काम कर रहे हैं?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom terug! Waar werken we aan?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witaj z powrotem! Nad czym pracujemy?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar hoş geldiniz! Ne üzerinde çalışıyoruz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З поверненням! Над чим працюємо?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen tillbaka! Vad jobbar vi på?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng trở lại! Chúng ta đang làm gì nào?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang kembali! Apa yang sedang kita kerjakan?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ברוך שובך! על מה אנחנו עובדים?"
          }
        }
      }
    },
