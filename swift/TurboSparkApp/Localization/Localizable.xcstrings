    "Cannot add files or tools while generation is running": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot add files or tools while generation is running"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden agregar archivos o herramientas mientras se genera"
