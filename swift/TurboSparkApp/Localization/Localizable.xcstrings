    "Stop Humanize before deleting its model.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Humanize before deleting its model."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف «أنسنة» قبل حذف نموذجها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie „Vermenschlichen“, bevor Sie das zugehörige Modell löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén «Humanizar» antes de eliminar su modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez « Humaniser » avant de supprimer son modèle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצור את \"הפוך לאנושי\" לפני מחיקת המודל שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसका मॉडल हटाने से पहले \"मानवीय बनाएं\" रोकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan \"Manusiakan\" sebelum menghapus modelnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi \"Umanizza\" prima di eliminarne il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを削除する前に「人間らしくする」を停止してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 삭제하기 전에 '사람처럼 다듬기'를 중지하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop \"Humaniseren\" voordat je het model verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj „Uczłowiecz” przed usunięciem jego modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare o \"Humanizar\" antes de excluir o modelo dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановите «Очеловечить» перед удалением модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa \"Humanisera\" innan du tar bort modellen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelini silmeden önce \"İnsanlaştır\" işlemini durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніть «Олюднити» перед видаленням моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dừng \"Nhân hóa\" trước khi xóa mô hình của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
