          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0928\u093e\u092e \u0915\u093e \u0938\u0930\u094d\u0935\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948\u0964"
