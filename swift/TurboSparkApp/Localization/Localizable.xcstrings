        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0456\u044f \u0437\u0440\u0430\u0437\u043a\u0430 \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n ch\u00e9p l\u1eddi c\u1ee7a gi\u1ecdng n\u00f3i m\u1eabu"
          }
        },
        "zh-Hans": {
