    "Agent '%@' is switched off. Enable it in Settings > Agents to use it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0648\u0643\u064a\u0644 \u00ab%@\u00bb \u0645\u062a\u0648\u0642\u0641. \u0641\u0639\u0651\u0644\u0647 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a > \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent \u201e%@\u201c ist ausgeschaltet. Aktivieren Sie ihn unter Einstellungen > Agenten, um ihn zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent '%@' is switched off. Enable it in Settings > Agents to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El agente \u00ab%@\u00bb est\u00e1 desactivado. Act\u00edvalo en Ajustes > Agentes para usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agent \u00ab %@ \u00bb est d\u00e9sactiv\u00e9. Activez-le dans Param\u00e8tres > Agents pour l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e1\u05d5\u05db\u05df \"%@\" \u05db\u05d1\u05d5\u05d9. \u05d4\u05e4\u05e2\u05dc \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea > \u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u091c\u0947\u0902\u091f '%@' \u092c\u0902\u0926 \u0939\u0948\u0964 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u090f\u091c\u0947\u0902\u091f\u094d\u0938 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agen '%@' dinonaktifkan. Aktifkan di Pengaturan > Agen untuk menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'agente '%@' \u00e8 disattivato. Attivalo in Impostazioni > Agenti per usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u300c%@\u300d\u306f\u30aa\u30d5\u306b\u306a\u3063\u3066\u3044\u307e\u3059\u3002\u4f7f\u7528\u3059\u308b\u306b\u306f\u300c\u8a2d\u5b9a > \u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u300d\u3067\u6709\u52b9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5d0\uc774\uc804\ud2b8 '%@'\uc774(\uac00) \uaebc\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\ud558\ub824\uba74 \uc124\uc815 > \uc5d0\uc774\uc804\ud2b8\uc5d0\uc11c \ucf1c\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent '%@' is uitgeschakeld. Schakel deze in via Instellingen > Agenten om hem te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent \u201e%@\u201d jest wy\u0142\u0105czony. W\u0142\u0105cz go w Ustawienia > Agenci, aby z niego korzysta\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O agente '%@' est\u00e1 desativado. Ative-o em Configura\u00e7\u00f5es > Agentes para us\u00e1-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0433\u0435\u043d\u0442 \u00ab%@\u00bb \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 > \u0410\u0433\u0435\u043d\u0442\u044b, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten '%@' \u00e4r avst\u00e4ngd. Aktivera den under Inst\u00e4llningar > Agenter f\u00f6r att anv\u00e4nda den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ajan\u0131 kapal\u0131. Kullanmak i\u00e7in Ayarlar > Ajanlar b\u00f6l\u00fcm\u00fcnden etkinle\u015ftirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0433\u0435\u043d\u0442\u0430 \u00ab%@\u00bb \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 > \u0410\u0433\u0435\u043d\u0442\u0438, \u0449\u043e\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e1c t\u1eed '%@' \u0111ang t\u1eaft. H\u00e3y b\u1eadt trong C\u00e0i \u0111\u1eb7t > T\u00e1c t\u1eed \u0111\u1ec3 s\u1eed d\u1ee5ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53\u201c%@\u201d\u5df2\u5173\u95ed\u3002\u8bf7\u5728\u201c\u8bbe\u7f6e > \u667a\u80fd\u4f53\u201d\u4e2d\u542f\u7528\u540e\u4f7f\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee3\u7406\u300c%@\u300d\u5df2\u95dc\u9589\u3002\u8acb\u5728\u300c\u8a2d\u5b9a > \u4ee3\u7406\u300d\u4e2d\u555f\u7528\u5f8c\u4f7f\u7528\u3002"
          }
        }
      }
    },
