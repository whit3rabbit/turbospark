    "This model family does not support live steering.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0627\u0626\u0644\u0629 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0647\u0630\u0647 \u0644\u0627 \u062a\u062f\u0639\u0645 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0645\u0628\u0627\u0634\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Modellfamilie unterst\u00fctzt kein Live-Steering."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model family does not support live steering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta familia de modelos no admite la direcci\u00f3n en vivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette famille de mod\u00e8les ne prend pas en charge le pilotage en direct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e9\u05e4\u05d7\u05ea \u05d4\u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05d4\u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05ea\u05d5\u05de\u05db\u05ea \u05d1\u05d4\u05db\u05d5\u05d5\u05e0\u05d4 \u05d7\u05d9\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092e\u0949\u0921\u0932 \u092a\u0930\u093f\u0935\u093e\u0930 \u0932\u093e\u0907\u0935 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarga model ini tidak mendukung pengarahan langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa famiglia di modelli non supporta lo steering in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e2\u30c7\u30eb\u30d5\u30a1\u30df\u30ea\u30fc\u306f\u30e9\u30a4\u30d6\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u306b\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubaa8\ub378 \uacc4\uc5f4\uc740 \uc2e4\uc2dc\uac04 \uc2a4\ud2f0\uc5b4\ub9c1\uc744 \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze modelfamilie ondersteunt geen live sturing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta rodzina modeli nie obs\u0142uguje sterowania na \u017cywo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta fam\u00edlia de modelos n\u00e3o oferece suporte a direcionamento ao vivo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u0441\u0435\u043c\u0435\u0439\u0441\u0442\u0432\u043e \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438."
          }
