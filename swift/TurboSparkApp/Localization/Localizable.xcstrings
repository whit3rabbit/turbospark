            "value": "TypeSafe-service gestopt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Us\u0142uga TypeSafe zatrzymana"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Servi\u00e7o TypeSafe parado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043b\u0443\u0436\u0431\u0430 TypeSafe \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeSafe-tj\u00e4nsten \u00e4r stoppad"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeSafe hizmeti durduruldu"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043b\u0443\u0436\u0431\u0430 TypeSafe \u0437\u0443\u043f\u0438\u043d\u0435\u043d\u0430"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u1ecbch v\u1ee5 TypeSafe \u0111\u00e3 d\u1eebng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeSafe \u670d\u52a1\u5df2\u505c\u6b62"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeSafe \u670d\u52d9\u5df2\u505c\u6b62"
          }
        }
      }
    },
    "Unloads the model and frees its memory. Loading it again takes several seconds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0644\u063a\u064a \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0648\u064a\u062d\u0631\u0631 \u0630\u0627\u0643\u0631\u062a\u0647. \u062a\u0633\u062a\u063a\u0631\u0642 \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644\u0647 \u0639\u062f\u0629 \u062b\u0648\u0627\u0646\u064d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entl\u00e4dt das Modell und gibt seinen Speicher frei. Erneutes Laden dauert einige Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unloads the model and frees its memory. Loading it again takes several seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga el modelo y libera su memoria. Volver a cargarlo tarda varios segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9charge le mod\u00e8le et lib\u00e8re sa m\u00e9moire. Le recharger prend plusieurs secondes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05d5\u05e8\u05e7 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d5\u05de\u05e9\u05d7\u05e8\u05e8 \u05d0\u05ea \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e9\u05dc\u05d5. \u05d8\u05e2\u05d9\u05e0\u05d4 \u05de\u05d7\u05d3\u05e9 \u05e0\u05de\u05e9\u05db\u05ea \u05db\u05de\u05d4 \u05e9\u05e0\u05d9\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0915\u094b \u0905\u0928\u0932\u094b\u0921 \u0915\u0930\u0915\u0947 \u0909\u0938\u0915\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u0916\u093e\u0932\u0940 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0926\u094b\u092c\u093e\u0930\u093e \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0915\u0908 \u0938\u0947\u0915\u0902\u0921 \u0932\u0917\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membongkar model dan membebaskan memorinya. Memuatnya lagi memerlukan beberapa detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica il modello e ne libera la memoria. Ricaricarlo richiede alcuni secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u3092\u30a2\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u30e1\u30e2\u30ea\u3092\u89e3\u653e\u3057\u307e\u3059\u3002\u518d\u8aad\u307f\u8fbc\u307f\u306b\u306f\u6570\u79d2\u304b\u304b\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc744 \uc5b8\ub85c\ub4dc\ud558\uace0 \uba54\ubaa8\ub9ac\ub97c \ud574\uc81c\ud569\ub2c8\ub2e4. \ub2e4\uc2dc \ub85c\ub4dc\ud558\ub824\uba74 \uba87 \ucd08\uac00 \uac78\ub9bd\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontlaadt het model en maakt het geheugen vrij. Opnieuw laden duurt enkele seconden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wy\u0142adowuje model i zwalnia jego pami\u0119\u0107. Ponowne za\u0142adowanie trwa kilka sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarrega o modelo e libera sua mem\u00f3ria. Carreg\u00e1-lo de novo leva alguns segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0433\u0440\u0443\u0436\u0430\u0435\u0442 \u043c\u043e\u0434\u0435\u043b\u044c \u0438 \u043e\u0441\u0432\u043e\u0431\u043e\u0436\u0434\u0430\u0435\u0442 \u0435\u0451 \u043f\u0430\u043c\u044f\u0442\u044c. \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0430\u044f \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u0437\u0430\u0439\u043c\u0451\u0442 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u0441\u0435\u043a\u0443\u043d\u0434."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar ur modellen och frig\u00f6r dess minne. Att ladda den igen tar flera sekunder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modeli kald\u0131r\u0131r ve belle\u011fini bo\u015falt\u0131r. Yeniden y\u00fcklemek birka\u00e7 saniye s\u00fcrer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u043c\u043e\u0434\u0435\u043b\u044c \u0456 \u0437\u0432\u0456\u043b\u044c\u043d\u044f\u0454 \u0457\u0457 \u043f\u0430\u043c'\u044f\u0442\u044c. \u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0437\u0430\u0439\u043c\u0435 \u043a\u0456\u043b\u044c\u043a\u0430 \u0441\u0435\u043a\u0443\u043d\u0434."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u1ee1 m\u00f4 h\u00ecnh v\u00e0 gi\u1ea3i ph\u00f3ng b\u1ed9 nh\u1edb c\u1ee7a n\u00f3. T\u1ea3i l\u1ea1i s\u1ebd m\u1ea5t v\u00e0i gi\u00e2y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5378\u8f7d\u6a21\u578b\u5e76\u91ca\u653e\u5176\u5185\u5b58\u3002\u91cd\u65b0\u52a0\u8f7d\u9700\u8981\u51e0\u79d2\u949f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5378\u8f09\u6a21\u578b\u4e26\u91cb\u653e\u5176\u8a18\u61b6\u9ad4\u3002\u91cd\u65b0\u8f09\u5165\u9700\u8981\u5e7e\u79d2\u9418\u3002"
          }
        }
      }
    },
    "Unsupported. Returns a clear 501 error; image edits are not available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645. \u064a\u0639\u064a\u062f \u062e\u0637\u0623 501 \u0648\u0627\u0636\u062d\u064b\u0627\u061b \u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0627\u0644\u0635\u0648\u0631 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterst\u00fctzt. Liefert einen klaren 501-Fehler; Bildbearbeitung ist nicht verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported. Returns a clear 501 error; image edits are not available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible. Devuelve un error 501 claro; la edici\u00f3n de im\u00e1genes no est\u00e1 disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non pris en charge. Renvoie une erreur 501 explicite ; la modification d'images n'est pas disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05ea\u05de\u05da. \u05de\u05d7\u05d6\u05d9\u05e8 \u05e9\u05d2\u05d9\u05d0\u05ea 501 \u05d1\u05e8\u05d5\u05e8\u05d4; \u05e2\u05e8\u05d9\u05db\u05ea \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902\u0964 \u0938\u094d\u092a\u0937\u094d\u091f 501 \u0924\u094d\u0930\u0941\u091f\u093f \u0932\u094c\u091f\u093e\u0924\u093e \u0939\u0948; \u0907\u092e\u0947\u091c \u0938\u0902\u092a\u093e\u0926\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak didukung. Mengembalikan galat 501 yang jelas; pengeditan gambar tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non supportato. Restituisce un errore 501 esplicito; la modifica delle immagini non \u00e8 disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u975e\u5bfe\u5fdc\u3002\u660e\u78ba\u306a 501 \u30a8\u30e9\u30fc\u3092\u8fd4\u3057\u307e\u3059\u3002\u753b\u50cf\u306e\u7de8\u96c6\u306f\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc74c. \uba85\ud655\ud55c 501 \uc624\ub958\ub97c \ubc18\ud658\ud558\uba70 \uc774\ubbf8\uc9c0 \ud3b8\uc9d1\uc740 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet ondersteund. Geeft een duidelijke 501-fout; afbeeldingen bewerken is niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobs\u0142ugiwane. Zwraca jednoznaczny b\u0142\u0105d 501; edycja obraz\u00f3w jest niedost\u0119pna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o compat\u00edvel. Retorna um erro 501 claro; a edi\u00e7\u00e3o de imagens n\u00e3o est\u00e1 dispon\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f. \u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u044f\u0432\u043d\u0443\u044e \u043e\u0448\u0438\u0431\u043a\u0443 501; \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "St\u00f6ds inte. Returnerar ett tydligt 501-fel; bildredigering \u00e4r inte tillg\u00e4nglig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenmiyor. A\u00e7\u0131k bir 501 hatas\u0131 d\u00f6nd\u00fcr\u00fcr; g\u00f6r\u00fcnt\u00fc d\u00fczenleme kullan\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f. \u041f\u043e\u0432\u0435\u0440\u0442\u0430\u0454 \u044f\u0432\u043d\u0443 \u043f\u043e\u043c\u0438\u043b\u043a\u0443 501; \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3. Tr\u1ea3 v\u1ec1 l\u1ed7i 501 r\u00f5 r\u00e0ng; kh\u00f4ng th\u1ec3 ch\u1ec9nh s\u1eeda h\u00ecnh \u1ea3nh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u652f\u6301\u3002\u8fd4\u56de\u660e\u786e\u7684 501 \u9519\u8bef\uff1b\u56fe\u50cf\u7f16\u8f91\u4e0d\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u652f\u63f4\u3002\u50b3\u56de\u660e\u78ba\u7684 501 \u932f\u8aa4\uff1b\u7121\u6cd5\u7de8\u8f2f\u5f71\u50cf\u3002"
          }
        }
      }
    },
    "Use a %@ token window (%@ of KV cache)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0646\u0627\u0641\u0630\u0629 \u0645\u0646 %@ \u0631\u0645\u0632 (%@ \u0645\u0646 \u0630\u0627\u0643\u0631\u0629 KV \u0627\u0644\u0645\u0624\u0642\u062a\u0629)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Fenster mit %@ Token verwenden (%@ KV-Cache)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a %@ token window (%@ of KV cache)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar una ventana de %@ tokens (%@ de cach\u00e9 KV)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser une fen\u00eatre de %@ jetons (%@ de cache KV)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d7\u05dc\u05d5\u05df \u05e9\u05dc %@ \u05d0\u05e1\u05d9\u05de\u05d5\u05e0\u05d9\u05dd (%@ \u05e9\u05dc \u05de\u05d8\u05de\u05d5\u05df KV)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u091f\u094b\u0915\u0928 \u0935\u093f\u0902\u0921\u094b \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902 (%@ KV \u0915\u0948\u0936)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan jendela %@ token (%@ cache KV)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una finestra di %@ token (%@ di cache KV)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u30c8\u30fc\u30af\u30f3\u306e\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u4f7f\u7528\uff08KV \u30ad\u30e3\u30c3\u30b7\u30e5 %@\uff09"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \ud1a0\ud070 \ucc3d \uc0ac\uc6a9(KV \uce90\uc2dc %@)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een venster van %@ tokens gebruiken (%@ KV-cache)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cyj okna %@ token\u00f3w (%@ pami\u0119ci podr\u0119cznej KV)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar uma janela de %@ tokens (%@ de cache KV)"
          }
        },
        "ru": {
