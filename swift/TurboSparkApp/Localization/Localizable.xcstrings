    "TurboSpark forgets the earlier model store. Its models stay on the drive and are not changed. To use them later, add the folder as a library.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سينسى TurboSpark مخزن النماذج السابق. تبقى نماذجه على محرك الأقراص دون تغيير. لاستخدامها لاحقًا، أضف المجلد كمكتبة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark vergisst den früheren Modellspeicher. Seine Modelle bleiben unverändert auf dem Laufwerk. Um sie später zu verwenden, fügen Sie den Ordner als Bibliothek hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark forgets the earlier model store. Its models stay on the drive and are not changed. To use them later, add the folder as a library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark olvidará el almacén de modelos anterior. Sus modelos permanecen en la unidad sin cambios. Para usarlos más adelante, añade la carpeta como biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark oubliera l'ancien stockage de modèles. Ses modèles restent sur le disque, sans modification. Pour les utiliser plus tard, ajoutez le dossier comme bibliothèque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ישכח את מאגר המודלים הקודם. המודלים שלו יישארו בכונן ללא שינוי. כדי להשתמש בהם בהמשך, הוסף את התיקייה כספרייה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark पहले के मॉडल स्टोर को भूल जाएगा। उसके मॉडल ड्राइव पर बिना बदले रहेंगे। बाद में उनका उपयोग करने के लिए फ़ोल्डर को लाइब्रेरी के रूप में जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark akan melupakan penyimpanan model sebelumnya. Model di dalamnya tetap ada di drive tanpa diubah. Untuk memakainya nanti, tambahkan folder itu sebagai pustaka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark dimenticherà l'archivio di modelli precedente. I suoi modelli restano sull'unità, senza modifiche. Per usarli in seguito, aggiungi la cartella come libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparkは以前のモデルストアを忘れます。モデルはドライブ上にそのまま残り、変更されません。後で使うには、そのフォルダをライブラリとして追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark가 이전 모델 저장소를 잊습니다. 모델은 변경 없이 드라이브에 그대로 남습니다. 나중에 사용하려면 해당 폴더를 라이브러리로 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark vergeet de eerdere modelopslag. De modellen blijven ongewijzigd op de schijf staan. Om ze later te gebruiken, voegt u de map toe als bibliotheek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark zapomni wcześniejszy magazyn modeli. Jego modele pozostaną na dysku bez zmian. Aby ich później użyć, dodaj folder jako bibliotekę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark vai esquecer o armazenamento de modelos anterior. Os modelos dele permanecem na unidade sem alterações. Para usá-los depois, adicione a pasta como biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark забудет прежнее хранилище моделей. Его модели останутся на диске без изменений. Чтобы использовать их позже, добавьте папку как библиотеку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark glömmer det tidigare modellförrådet. Modellerna finns kvar på enheten, oförändrade. Lägg till mappen som ett bibliotek om du vill använda dem senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark önceki model deposunu unutur. Modelleri değişmeden sürücüde kalır. Bunları daha sonra kullanmak için klasörü kitaplık olarak ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark забуде попереднє сховище моделей. Його моделі залишаться на диску без змін. Щоб користуватися ними пізніше, додайте папку як бібліотеку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark sẽ quên kho mô hình trước đây. Các mô hình của nó vẫn nằm trên ổ đĩa và không bị thay đổi. Để dùng sau này, hãy thêm thư mục đó làm thư viện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 将忘记之前的模型存储。其中的模型会原样保留在驱动器上。如需日后使用，请将该文件夹添加为模型库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 將忘記之前的模型儲存空間。其中的模型會原封不動地保留在磁碟機上。如需日後使用，請將該資料夾加入為模型庫。"
          }
        }
      }
    },
    "TurboSpark found the library %@. Add it from Installed Models or Models & Storage.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عثر TurboSpark على المكتبة %@. أضفها من «النماذج المثبتة» أو «النماذج والتخزين»."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark hat die Bibliothek „%@“ gefunden. Fügen Sie sie unter „Installierte Modelle“ oder „Modelle & Speicherplatz“ hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark found the library %@. Add it from Installed Models or Models & Storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark encontró la biblioteca %@. Añádela desde «Modelos instalados» o «Modelos y almacenamiento»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark a trouvé la bibliothèque %@. Ajoutez-la depuis « Modèles installés » ou « Modèles et stockage »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark מצא את הספרייה %@. אפשר להוסיף אותה מ\"מודלים מותקנים\" או מ\"מודלים ואחסון\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark को लाइब्रेरी %@ मिली। इसे “स्थापित मॉडल” या “मॉडल और संग्रहण” से जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark menemukan pustaka %@. Tambahkan dari “Model Terpasang” atau “Model & Penyimpanan”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ha trovato la libreria %@. Aggiungila da «Modelli installati» o «Modelli e archiviazione»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparkがライブラリ「%@」を見つけました。「インストール済みモデル」または「モデルとストレージ」から追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark에서 라이브러리 %@을(를) 찾았습니다. '설치된 모델' 또는 '모델 및 저장 공간'에서 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark heeft de bibliotheek %@ gevonden. Voeg deze toe via ‘Geïnstalleerde modellen’ of ‘Modellen en opslag’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark znalazł bibliotekę %@. Dodaj ją w sekcji „Zainstalowane modele” lub „Modele i pamięć”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark encontrou a biblioteca %@. Adicione-a em “Modelos Instalados” ou “Modelos e armazenamento”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark нашёл библиотеку %@. Добавьте её в разделе «Установленные модели» или «Модели и хранилище»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark hittade biblioteket %@. Lägg till det under ”Installerade modeller” eller ”Modeller och lagring”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark %@ kitaplığını buldu. “Yüklü Modeller” veya “Modeller ve Depolama” bölümünden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark знайшов бібліотеку %@. Додайте її в розділі «Встановлені моделі» або «Моделі та сховище»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark đã tìm thấy thư viện %@. Hãy thêm từ “Mô hình đã cài đặt” hoặc “Mô hình và lưu trữ”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 发现了模型库 %@。请在“已安装模型”或“模型与存储”中添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 發現了模型庫 %@。請在「已安裝模型」或「模型與儲存空間」中加入。"
          }
        }
      }
    },
    "TurboSpark has not finished converting your earlier model store. It tries again each time it starts and when the drive connects.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم ينتهِ TurboSpark من تحويل مخزن النماذج السابق. يعيد المحاولة في كل مرة يبدأ فيها التشغيل وعند توصيل محرك الأقراص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark hat die Umwandlung Ihres früheren Modellspeichers noch nicht abgeschlossen. Es versucht es bei jedem Start und beim Verbinden des Laufwerks erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark has not finished converting your earlier model store. It tries again each time it starts and when the drive connects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark no ha terminado de convertir tu almacén de modelos anterior. Lo intentará de nuevo cada vez que se inicie y cuando se conecte la unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark n'a pas fini de convertir votre ancien stockage de modèles. Il réessaie à chaque démarrage et à la connexion du disque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark עדיין לא סיים להמיר את מאגר המודלים הקודם שלך. הוא ינסה שוב בכל הפעלה וכשהכונן יחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ने आपके पहले के मॉडल स्टोर का रूपांतरण पूरा नहीं किया है। यह हर बार शुरू होने पर और ड्राइव कनेक्ट होने पर फिर कोशिश करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark belum selesai mengubah penyimpanan model Anda sebelumnya. TurboSpark mencoba lagi setiap kali dibuka dan saat drive terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark non ha ancora finito di convertire l'archivio di modelli precedente. Riprova a ogni avvio e quando l'unità viene collegata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparkは以前のモデルストアの変換をまだ完了していません。起動のたびと、ドライブの接続時に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark가 이전 모델 저장소의 변환을 아직 마치지 못했습니다. 시작할 때마다 그리고 드라이브가 연결될 때 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark is nog niet klaar met het omzetten van uw eerdere modelopslag. Het probeert het opnieuw bij elke start en wanneer de schijf wordt aangesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark nie zakończył jeszcze przekształcania wcześniejszego magazynu modeli. Ponawia próbę przy każdym uruchomieniu i po podłączeniu dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark ainda não terminou de converter o armazenamento de modelos anterior. Ele tenta novamente a cada inicialização e quando a unidade é conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ещё не закончил преобразование прежнего хранилища моделей. Он повторяет попытку при каждом запуске и при подключении диска."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark har inte hunnit omvandla det tidigare modellförrådet. Det försöker igen vid varje start och när enheten ansluts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark önceki model deponuzu dönüştürmeyi henüz bitirmedi. Her başlatıldığında ve sürücü bağlandığında yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ще не завершив перетворення попереднього сховища моделей. Він повторює спробу під час кожного запуску та під час підключення диска."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark chưa hoàn tất việc chuyển đổi kho mô hình trước đây. Ứng dụng sẽ thử lại mỗi lần khởi động và khi ổ đĩa được kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 尚未完成对之前模型存储的转换。它会在每次启动以及驱动器连接时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 尚未完成對之前模型儲存空間的轉換。它會在每次啟動以及磁碟機連接時重試。"
          }
        }
      }
    },
    "TurboSpark makes up to three follow-up requests when a response stops at the output limit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل TurboSpark ما يصل إلى ثلاثة طلبات متابعة عندما يتوقف الرد عند حد الإخراج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark sendet bis zu drei Folgeanfragen, wenn eine Antwort am Ausgabelimit endet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark makes up to three follow-up requests when a response stops at the output limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark realiza hasta tres solicitudes adicionales si una respuesta se detiene al alcanzar el límite de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark effectue jusqu’à trois requêtes supplémentaires lorsqu’une réponse s’arrête à la limite de sortie."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark שולח עד שלוש בקשות המשך כשהתשובה נעצרת במגבלת הפלט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब आउटपुट सीमा पर रुकने पर TurboSpark अधिकतम तीन अतिरिक्त अनुरोध करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark mengirim hingga tiga permintaan lanjutan saat jawaban berhenti pada batas keluaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark invia fino a tre richieste successive se una risposta si interrompe al limite di output."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答が出力上限で止まると、TurboSpark は最大 3 回まで追加リクエストを送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "응답이 출력 한도에서 멈추면 TurboSpark가 최대 세 번 추가 요청을 보냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark doet maximaal drie vervolgverzoeken wanneer een antwoord stopt bij de uitvoerlimiet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark wysyła maksymalnie trzy kolejne żądania, gdy odpowiedź zatrzyma się na limicie wyjścia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark faz até três solicitações adicionais quando uma resposta para no limite de saída."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark отправляет до трех дополнительных запросов, если ответ останавливается на лимите вывода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark gör upp till tre följdförfrågningar när ett svar stannar vid utmatningsgränsen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yanıt çıktı sınırında durduğunda TurboSpark en fazla üç ek istek gönderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark надсилає до трьох додаткових запитів, коли відповідь зупиняється на ліміті виводу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark gửi tối đa ba yêu cầu tiếp theo khi câu trả lời dừng ở giới hạn đầu ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果回答在输出达到上限时停止，TurboSpark 最多会再发送三次请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果回答在輸出達到上限時停止，TurboSpark 最多會再傳送三次請求。"
          }
        }
      }
    },
    "TurboSpark playback is excluded. Only audio is saved.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark playback is excluded. Only audio is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se excluye la reproducción de TurboSpark. Solo se guarda audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La lecture de TurboSpark est exclue. Seul l'audio est enregistré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe von TurboSpark wird ausgeschlossen. Es wird nur Audio gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riproduzione di TurboSpark è esclusa. Viene salvato solo l'audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reprodução do TurboSpark é excluída. Apenas o áudio é salvo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afspelen door TurboSpark wordt uitgesloten. Alleen audio wordt opgeslagen."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparks uppspelning utesluts. Endast ljud sparas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odtwarzanie TurboSpark jest wykluczone. Zapisywany jest tylko dźwięk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark oynatması hariç tutulur. Yalnızca ses kaydedilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemutaran TurboSpark dikecualikan. Hanya audio yang disimpan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук TurboSpark исключён. Сохраняется только аудио."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Звук TurboSpark виключено. Зберігається лише аудіо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh phát từ TurboSpark được loại trừ. Chỉ lưu âm thanh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparkの再生音声は除外されます。保存されるのは音声のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 재생은 제외됩니다. 오디오만 저장됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 的播放音频会被排除。仅保存音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 的播放音訊會被排除。僅儲存音訊。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستثنى صوت تشغيل TurboSpark. يتم حفظ الصوت فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השמע שמנגן TurboSpark לא נכלל. נשמר שמע בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark का प्लेबैक शामिल नहीं है। केवल ऑडियो सहेजा जाता है।"
          }
        }
      }
    },
    "TurboSpark ships no directions. A direction is a .gguf control vector in llama.cpp layout that you extract or supply yourself, and this engine has no opinion about what one encodes: the same code path serves concept steering, style vectors and refusal-direction work.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تأتي TurboSpark بأي اتجاهات. الاتجاه هو متجهة تحكم .gguf في تخطيط llama.cpp التي تستخرجها أو تقدمها بنفسك، وليس لهذا المحرك أي رأي حول ما يتم ترميزه: يخدم نفس مسار التعليمات البرمجية توجيه المفهوم ومتجهات النمط وعمل اتجاه الرفض."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark liefert keine Richtungsvektoren mit. Eine Richtung ist ein .gguf-Steuerungsvektor im llama.cpp-Layout, den Sie selbst extrahieren oder bereitstellen, und diese Engine hat keine Meinung darüber, was er codiert: derselbe Codepfad dient der Konzeptsteuerung, Stilvektoren und Ablehnungsrichtungsarbeit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ships no directions. A direction is a .gguf control vector in llama.cpp layout that you extract or supply yourself, and this engine has no opinion about what one encodes: the same code path serves concept steering, style vectors and refusal-direction work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark no incluye vectores de dirección. Una dirección es un vector de control .gguf con diseño de llama.cpp que extraes o suministras tú mismo, y este motor no tiene preferencias sobre lo que codifica: la misma ruta de código sirve para dirección de conceptos, vectores de estilo y trabajo de dirección de rechazo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark n'inclut aucune direction. Une direction est un vecteur de contrôle .gguf au format llama.cpp que vous extrayez ou fournissez vous-même, et ce moteur n'a aucun avis sur ce qu'il encode : le même chemin de code sert au guidage de concepts, aux vecteurs de style et aux directions de refus."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark אינה מגיעה עם כיוונים מובנים. כיוון הוא וקטור בקרה .gguf בפריסת llama.cpp שאתה מחלץ או מספק בעצמך, ולמנוע זה אין דעה לגבי מה שהוא מקודד: אותו נתיב קוד משרת היגוי מושגים, וקטורי סגנון ועבודת כיווני סירוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark कोई दिशाएं नहीं भेजता है। एक दिशा llama.cpp लेआउट में एक .gguf नियंत्रण वेक्टर है जिसे आप स्वयं निकालते हैं या आपूर्ति करते हैं, और इस इंजन की कोई राय नहीं है कि क्या एन्कोड किया गया है: वही कोड पथ अवधारणा संचालन, शैली वैक्टर और इनकार-दिशा कार्य करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark tidak menyertakan vektor arah bawaan. Arah adalah vektor kontrol .gguf dalam tata letak llama.cpp yang Anda ekstrak atau sediakan sendiri, dan mesin ini tidak mempermasalahkan apa yang dienkode: jalur kode yang sama melayani pengemudian konsep, vektor gaya, dan pekerjaan arah penolakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark non fornisce direzioni integrate. Una direzione è un vettore di controllo .gguf con layout llama.cpp estratto o fornito dall'utente, e questo motore non ha preferenze su cosa codifichi: lo stesso percorso di codice serve per sterzo di concetti, vettori di stile e direzioni di rifiuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark には方向ベクトルは同梱されていません。方向とは、ユーザーが抽出または提供する llama.cpp レイアウトの .gguf 制御ベクトルであり、このエンジンは何がエンコードされているかに関与しません。同じコードパスが概念のステアリング、スタイルベクトル、および拒否方向の処理に対応します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark에는 방향 벡터가 포함되어 있지 않습니다. 방향은 사용자가 직접 추출하거나 제공하는 llama.cpp 레이아웃의 .gguf 제어 벡터이며, 이 엔진은 인코딩 내용에 관여하지 않습니다. 동일한 코드 경로가 개념 조향, 스타일 벡터 및 거부 방향 작업에 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark levert geen richtingsvectoren mee. Een richting is een .gguf-besturingsvector in llama.cpp-indeling die u zelf extraheert of levert, en deze engine heeft geen oordeel over wat deze codeert: hetzelfde codepad dient voor conceptsturing, stijlvectoren en weigeringsrichtingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark nie zawiera gotowych wektorów kierunku. Kierunek to wektor kontrolny .gguf w układzie llama.cpp, który wyodrębniasz lub dostarczasz samodzielnie, a silnik nie ocenia jego zawartości: ta sama ścieżka kodu obsługuje sterowanie pojęciami, wektory stylu i wektory odmowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark não inclui direções. Uma direção é um vetor de controle .gguf no layout llama.cpp que você extrai ou fornece por conta própria, e este motor não opina sobre o que ele codifica: o mesmo caminho de código atende ao direcionamento de conceitos, vetores de estilo e recusas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark не поставляет встроенных векторов направления. Направление -- это вектор управления .gguf в формате llama.cpp, который вы извлекаете или предоставляете сами, и движок нейтрален к его содержимому: один и тот же путь кода обслуживает концептуальное управление, векторы стиля и направления отказа."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark levererar inga riktningar. En riktning är en .gguf-kontrollvektor i llama.cpp-layout som du extraherar eller tillhandahåller själv, och den här motorn har ingen åsikt om vad som kodas: samma kodväg tjänar konceptstyrning, stilvektorer och avvisningsriktningsarbete."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark yön vektörleri içermez. Yön, kendinizin ayıkladığı veya sağladığı llama.cpp düzeninde bir .gguf kontrol vektörüdür ve bu motorun neyi kodladığı konusunda hiçbir fikri yoktur: aynı kod yolu kavram yönlendirme, stil vektörleri ve reddetme yönü çalışmasına hizmet eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark не постачає вбудованих векторів напрямку. Напрямок -- це вектор керування .gguf у форматі llama.cpp, який ви вилучаєте або надаєте самі, і рушій нейтральний до його вмісту: той самий шлях коду обслуговує концептуальне керування, вектори стилю та напрямки відмови."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark không cung cấp các hướng vectơ sẵn có. Hướng là một vectơ điều khiển .gguf theo bố cục llama.cpp mà bạn tự trích xuất hoặc cung cấp và công cụ này không can thiệp vào những gì nó mã hóa: cùng một đường dẫn mã phục vụ cho việc điều khiển khái niệm, vectơ phong cách và hướng từ chối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 不附带转向向量。方向向量是 llama.cpp 格式的 .gguf 控制向量，由你自行提取或提供，本引擎对其编码内容保持中立：相同的代码路径适用于概念控制、风格向量和拒绝方向处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 不隨附轉向向量。方向向量是 llama.cpp 格式的 .gguf 控制向量，由你自行擷取或提供，本引擎對其編碼內容保持中立：相同的程式碼路徑適用於概念控制、風格向量和拒絕方向處理。"
          }
        }
      }
    },
    "TurboSpark stops listing this library and its models, and new downloads go to This Mac. The files on the drive are not changed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتوقف TurboSpark عن عرض هذه المكتبة ونماذجها، وستُحفظ التنزيلات الجديدة على هذا الـ Mac. لن تتغير الملفات الموجودة على محرك الأقراص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark listet diese Bibliothek und ihre Modelle nicht mehr auf, und neue Downloads gehen auf diesen Mac. Die Dateien auf dem Laufwerk bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark stops listing this library and its models, and new downloads go to This Mac. The files on the drive are not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark dejará de mostrar esta biblioteca y sus modelos, y las descargas nuevas irán a este Mac. Los archivos de la unidad no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark n'affichera plus cette bibliothèque ni ses modèles, et les nouveaux téléchargements iront sur ce Mac. Les fichiers du disque ne sont pas modifiés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark יפסיק להציג את הספרייה הזו ואת המודלים שלה, והורדות חדשות יישמרו ב-Mac הזה. הקבצים בכונן לא ישתנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark इस लाइब्रेरी और उसके मॉडल को सूची में दिखाना बंद कर देगा, और नए डाउनलोड इस Mac पर जाएंगे। ड्राइव की फ़ाइलें नहीं बदली जाएंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark berhenti menampilkan pustaka ini dan model di dalamnya, dan unduhan baru disimpan di Mac ini. File di drive tidak diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark non mostrerà più questa libreria e i suoi modelli, e i nuovi download andranno su questo Mac. I file sull'unità non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparkはこのライブラリとそのモデルを一覧に表示しなくなり、新しいダウンロードはこのMacに保存されます。ドライブ上のファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark에서 이 라이브러리와 그 모델이 목록에 더 이상 표시되지 않으며, 새 다운로드는 이 Mac에 저장됩니다. 드라이브의 파일은 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark toont deze bibliotheek en de bijbehorende modellen niet meer, en nieuwe downloads gaan naar deze Mac. De bestanden op de schijf blijven ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark przestanie wyświetlać tę bibliotekę i jej modele, a nowe pobrania trafią na ten Mac. Pliki na dysku nie zostaną zmienione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark deixará de listar esta biblioteca e seus modelos, e os novos downloads irão para este Mac. Os arquivos na unidade não serão alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark перестанет показывать эту библиотеку и её модели, а новые загрузки будут сохраняться на этом Mac. Файлы на диске не изменятся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark slutar visa det här biblioteket och dess modeller, och nya nedladdningar hamnar på den här Macen. Filerna på enheten ändras inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark bu kitaplığı ve modellerini listelemeyi bırakır, yeni indirmeler bu Mac'e gider. Sürücüdeki dosyalar değiştirilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark перестане показувати цю бібліотеку та її моделі, а нові завантаження зберігатимуться на цьому Mac. Файли на диску не буде змінено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark sẽ ngừng liệt kê thư viện này và các mô hình của nó, và các bản tải xuống mới sẽ được lưu trên máy Mac này. Các tệp trên ổ đĩa không bị thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 将不再列出此模型库及其模型，新的下载将保存到这台 Mac。驱动器上的文件不会被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 將不再列出此模型庫及其模型，新的下載將儲存到這部 Mac。磁碟機上的檔案不會被更改。"
          }
        }
      }
    },
