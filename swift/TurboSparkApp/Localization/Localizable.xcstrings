          "stringUnit": {
            "state": "translated",
            "value": "\u30b5\u30fc\u30d0\u30fc\u304c\u4e00\u90e8\u306e\u30e2\u30c7\u30eb\u3092\u89e3\u653e\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u307e\u3060 %@ \u3092\u63d0\u4f9b\u3057\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc11c\ubc84\uac00 \uc77c\ubd80 \ubaa8\ub378\uc744 \ud574\uc81c\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \uc544\uc9c1 %@\uc744(\ub97c) \uc81c\uacf5 \uc911\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server kon sommige modellen niet vrijgeven; mogelijk biedt hij %@ nog aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie m\u00f3g\u0142 zwolni\u0107 niekt\u00f3rych modeli; mo\u017ce nadal udost\u0119pnia\u0107 %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor n\u00e3o conseguiu liberar alguns modelos; ele ainda pode estar servindo %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0440\u0432\u0435\u0440\u0443 \u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u044c \u043d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438; \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u043e\u043d \u0432\u0441\u0451 \u0435\u0449\u0451 \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u0435\u0442 %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern kunde inte frig\u00f6ra vissa modeller; den kanske fortfarande tillhandah\u00e5ller %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu baz\u0131 modelleri serbest b\u0131rakamad\u0131; %@ h\u00e2l\u00e2 sunuluyor olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0440\u0432\u0435\u0440\u0443 \u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0432\u0456\u043b\u044c\u043d\u0438\u0442\u0438 \u0434\u0435\u044f\u043a\u0456 \u043c\u043e\u0434\u0435\u043b\u0456; \u043c\u043e\u0436\u043b\u0438\u0432\u043e, \u0432\u0456\u043d \u0434\u043e\u0441\u0456 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0454 %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00e1y ch\u1ee7 kh\u00f4ng th\u1ec3 gi\u1ea3i ph\u00f3ng m\u1ed9t s\u1ed1 m\u00f4 h\u00ecnh; c\u00f3 th\u1ec3 v\u1eabn \u0111ang ph\u1ee5c v\u1ee5 %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u670d\u52a1\u5668\u65e0\u6cd5\u91ca\u653e\u90e8\u5206\u6a21\u578b\uff1b\u5b83\u53ef\u80fd\u4ecd\u5728\u4e3a %@ \u63d0\u4f9b\u670d\u52a1\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f3a\u670d\u5668\u7121\u6cd5\u91cb\u653e\u90e8\u5206\u6a21\u578b\uff1b\u5b83\u53ef\u80fd\u4ecd\u5728\u70ba %@ \u63d0\u4f9b\u670d\u52d9\u3002"
          }
        }
      }
    },
