    "Opens Terminal and launches the agent against the background server; it is started or reused as needed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح الطرفية ويشغّل الوكيل على الخادم في الخلفية؛ يُبدأ الخادم أو يُعاد استخدامه حسب الحاجة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet Terminal und startet den Agenten gegen den Hintergrundserver; dieser wird bei Bedarf gestartet oder wiederverwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Terminal and launches the agent against the background server; it is started or reused as needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Terminal y lanza el agente contra el servidor en segundo plano; se inicia o se reutiliza según sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Terminal et lance l'agent contre le serveur en arrière-plan ; celui-ci est démarré ou réutilisé selon les besoins."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את המסוף ומפעיל את הסוכן מול השרת ברקע; השרת מופעל או מנוצל מחדש לפי הצורך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टर्मिनल खोलता है और बैकग्राउंड सर्वर के विरुद्ध एजेंट लॉन्च करता है; आवश्यकतानुसार सर्वर शुरू या पुनः उपयोग किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Terminal dan meluncurkan agent ke server latar belakang; server dijalankan atau digunakan kembali sesuai kebutuhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Terminale e lancia l'agente contro il server in background; viene avviato o riutilizzato secondo necessità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルを開き、バックグラウンドサーバーに対してエージェントを起動します。サーバーは必要に応じて起動または再利用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "터미널을 열고 백그라운드 서버에 대해 에이전트를 실행합니다. 서버는 필요에 따라 시작되거나 재사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Terminal en start de agent tegen de achtergrondserver; die wordt indien nodig gestart of hergebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Terminal i uruchamia agenta na serwerze w tle; serwer jest w razie potrzeby uruchamiany lub ponownie wykorzystywany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Terminal e inicia o agente no servidor em segundo plano; ele é iniciado ou reutilizado conforme necessário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает Терминал и запускает агента через фоновый сервер; он запускается или переиспользуется при необходимости."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar Terminal och startar agenten mot bakgrundsservern; den startas eller återanvänds vid behov."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal'i açar ve aracıyı arka plan sunucusuna karşı başlatır; sunucu gerektiğinde başlatılır veya yeniden kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває Термінал і запускає агента через фоновий сервер; він запускається або повторно використовується за потреби."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở Terminal và khởi chạy agent với máy chủ nền; máy chủ được khởi động hoặc tái sử dụng khi cần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开“终端”并针对后台服务器启动该代理；服务器会按需启动或复用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開「終端機」並針對背景伺服器啟動該代理；伺服器會視需要啟動或重複使用。"
          }
        }
      }
