    "One JSON object per line, no sentinel. Ollama's framing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كائن JSON واحد في كل سطر، دون علامة نهاية. هذا هو تنسيق Ollama."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein JSON-Objekt pro Zeile, ohne Endmarke. Die Rahmung von Ollama."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One JSON object per line, no sentinel. Ollama's framing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objeto JSON por línea, sin marcador final. El formato de Ollama."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un objet JSON par ligne, sans sentinelle. Le format d'Ollama."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אובייקט JSON אחד בכל שורה, ללא סמן סיום. המסגור של Ollama."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पंक्ति में एक JSON ऑब्जेक्ट, कोई अंत-चिह्न नहीं। Ollama का फ़्रेमिंग।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu objek JSON per baris, tanpa penanda akhir. Format bingkai Ollama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un oggetto JSON per riga, senza sentinella. Il formato di Ollama."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行に 1 つの JSON オブジェクト。終端マーカーなし。Ollama の形式です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 JSON 객체 하나, 종료 표시 없음. Ollama 방식입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén JSON-object per regel, zonder eindmarkering. De framing van Ollama."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden obiekt JSON na wiersz, bez znacznika końca. Format Ollama."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um objeto JSON por linha, sem marcador final. O formato do Ollama."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один JSON-объект на строку, без маркера конца. Формат Ollama."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett JSON-objekt per rad, utan slutmarkör. Ollamas inramning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Satır başına bir JSON nesnesi, bitiş işareti yok. Ollama'nın biçimi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один JSON-об'єкт на рядок, без маркера кінця. Формат Ollama."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi dòng một đối tượng JSON, không có dấu kết thúc. Định dạng của Ollama."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一个 JSON 对象，无结束标记。这是 Ollama 的格式。"
          }
        },
        "zh-Hant": {
