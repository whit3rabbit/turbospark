    "Select a microphone or system audio source before recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a microphone or system audio source before recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un micr\u00f3fono o una fuente de audio del sistema antes de grabar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9lectionnez un microphone ou une source audio syst\u00e8me avant d'enregistrer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle vor der Aufnahme ein Mikrofon oder eine Systemaudioquelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un microfono o una sorgente audio di sistema prima di registrare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um microfone ou uma fonte de \u00e1udio do sistema antes de gravar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een microfoon of systeemaudiobron voordat je opneemt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en mikrofon eller systemljudk\u00e4lla innan du spelar in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed nagrywaniem wybierz mikrofon lub \u017ar\u00f3d\u0142o d\u017awi\u0119ku systemowego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kay\u0131ttan \u00f6nce bir mikrofon veya sistem sesi kayna\u011f\u0131 se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih mikrofon atau sumber audio sistem sebelum merekam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0434 \u0437\u0430\u043f\u0438\u0441\u044c\u044e \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d \u0438\u043b\u0438 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0434 \u0437\u0430\u043f\u0438\u0441\u043e\u043c \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043c\u0456\u043a\u0440\u043e\u0444\u043e\u043d \u0430\u0431\u043e \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn micr\u00f4 ho\u1eb7c ngu\u1ed3n \u00e2m thanh h\u1ec7 th\u1ed1ng tr\u01b0\u1edbc khi ghi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9332\u97f3\u524d\u306b\u30de\u30a4\u30af\u307e\u305f\u306f\u30b7\u30b9\u30c6\u30e0\u97f3\u58f0\u30bd\u30fc\u30b9\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub179\uc74c\ud558\uae30 \uc804\uc5d0 \ub9c8\uc774\ud06c \ub610\ub294 \uc2dc\uc2a4\ud15c \uc624\ub514\uc624 \uc18c\uc2a4\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f55\u97f3\u524d\u8bf7\u9009\u62e9\u9ea6\u514b\u98ce\u6216\u7cfb\u7edf\u97f3\u9891\u6765\u6e90\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9304\u97f3\u524d\u8acb\u9078\u64c7\u9ea5\u514b\u98a8\u6216\u7cfb\u7d71\u97f3\u8a0a\u4f86\u6e90\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u062f\u062f \u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646\u0627\u064b \u0623\u0648 \u0645\u0635\u062f\u0631 \u0635\u0648\u062a \u0644\u0644\u0646\u0638\u0627\u0645 \u0642\u0628\u0644 \u0627\u0644\u062a\u0633\u062c\u064a\u0644."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05d0\u05d5 \u05de\u05e7\u05d5\u05e8 \u05e9\u05de\u05e2 \u05e9\u05dc \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05dc\u05e4\u05e0\u05d9 \u05d4\u05d4\u05e7\u05dc\u05d8\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u092f\u093e \u0938\u093f\u0938\u094d\u091f\u092e \u0911\u0921\u093f\u092f\u094b \u0938\u094d\u0930\u094b\u0924 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "The audio format could not be converted. Try a WAV or M4A file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio format could not be converted. Try a WAV or M4A file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo convertir el formato de audio. Prueba con un archivo WAV o M4A."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format audio n'a pas pu \u00eatre converti. Essayez un fichier WAV ou M4A."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audioformat konnte nicht konvertiert werden. Versuche eine WAV- oder M4A-Datei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile convertire il formato audio. Prova un file WAV o M4A."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel converter o formato de \u00e1udio. Tente um arquivo WAV ou M4A."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het audioformaat kon niet worden geconverteerd. Probeer een WAV- of M4A-bestand."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudformatet kunde inte konverteras. Prova en WAV- eller M4A-fil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uda\u0142o si\u0119 przekonwertowa\u0107 formatu audio. Spr\u00f3buj pliku WAV lub M4A."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses bi\u00e7imi d\u00f6n\u00fc\u015ft\u00fcr\u00fclemedi. Bir WAV veya M4A dosyas\u0131 deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format audio tidak dapat dikonversi. Coba berkas WAV atau M4A."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u0435\u043e\u0431\u0440\u0430\u0437\u043e\u0432\u0430\u0442\u044c \u0444\u043e\u0440\u043c\u0430\u0442 \u0430\u0443\u0434\u0438\u043e. \u041f\u043e\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0444\u0430\u0439\u043b WAV \u0438\u043b\u0438 M4A."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0444\u043e\u0440\u043c\u0430\u0442 \u0430\u0443\u0434\u0456\u043e. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0444\u0430\u0439\u043b WAV \u0430\u0431\u043e M4A."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 chuy\u1ec3n \u0111\u1ed5i \u0111\u1ecbnh d\u1ea1ng \u00e2m thanh. H\u00e3y th\u1eed t\u1ec7p WAV ho\u1eb7c M4A."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u58f0\u5f62\u5f0f\u3092\u5909\u63db\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002WAV\u307e\u305f\u306fM4A\u30d5\u30a1\u30a4\u30eb\u3092\u8a66\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub514\uc624 \ud615\uc2dd\uc744 \ubcc0\ud658\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. WAV \ub610\ub294 M4A \ud30c\uc77c\uc744 \uc0ac\uc6a9\ud574 \ubcf4\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u8f6c\u6362\u97f3\u9891\u683c\u5f0f\u3002\u8bf7\u5c1d\u8bd5 WAV \u6216 M4A \u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u8f49\u63db\u97f3\u8a0a\u683c\u5f0f\u3002\u8acb\u5617\u8a66 WAV \u6216 M4A \u6a94\u6848\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0631 \u062a\u062d\u0648\u064a\u0644 \u062a\u0646\u0633\u064a\u0642 \u0627\u0644\u0635\u0648\u062a. \u062c\u0631\u0651\u0628 \u0645\u0644\u0641 WAV \u0623\u0648 M4A."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05de\u05d9\u05e8 \u05d0\u05ea \u05e4\u05d5\u05e8\u05de\u05d8 \u05d4\u05e9\u05de\u05e2. \u05e0\u05e1\u05d4 \u05e7\u05d5\u05d1\u05e5 WAV \u05d0\u05d5 M4A."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0911\u0921\u093f\u092f\u094b \u092b\u093c\u0949\u0930\u094d\u092e\u0948\u091f \u092c\u0926\u0932\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e\u0964 WAV \u092f\u093e M4A \u092b\u093c\u093e\u0907\u0932 \u0906\u091c\u093c\u092e\u093e\u090f\u0901\u0964"
          }
        }
      }
    },
    "The audio source has an unsupported format. Choose another input device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The audio source has an unsupported format. Choose another input device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente de audio tiene un formato no compatible. Elige otro dispositivo de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le format de la source audio n'est pas pris en charge. Choisissez un autre p\u00e9riph\u00e9rique d'entr\u00e9e."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audioquelle hat ein nicht unterst\u00fctztes Format. W\u00e4hle ein anderes Eingabeger\u00e4t."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sorgente audio ha un formato non supportato. Scegli un altro dispositivo di ingresso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte de \u00e1udio usa um formato incompat\u00edvel. Escolha outro dispositivo de entrada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audiobron heeft een niet-ondersteund formaat. Kies een ander invoerapparaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudk\u00e4llans format st\u00f6ds inte. V\u00e4lj en annan inmatningsenhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0179r\u00f3d\u0142o d\u017awi\u0119ku ma nieobs\u0142ugiwany format. Wybierz inne urz\u0105dzenie wej\u015bciowe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses kayna\u011f\u0131 desteklenmeyen bir bi\u00e7imde. Ba\u015fka bir giri\u015f ayg\u0131t\u0131 se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format sumber audio tidak didukung. Pilih perangkat masukan lain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u043e\u0440\u043c\u0430\u0442 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \u0437\u0432\u0443\u043a\u0430 \u043d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0432\u0432\u043e\u0434\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u043e\u0440\u043c\u0430\u0442 \u0434\u0436\u0435\u0440\u0435\u043b\u0430 \u0437\u0432\u0443\u043a\u0443 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0456\u043d\u0448\u0438\u0439 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngu\u1ed3n \u00e2m thanh c\u00f3 \u0111\u1ecbnh d\u1ea1ng kh\u00f4ng \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3. Ch\u1ecdn thi\u1ebft b\u1ecb \u0111\u1ea7u v\u00e0o kh\u00e1c."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u58f0\u30bd\u30fc\u30b9\u306e\u5f62\u5f0f\u306f\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u5225\u306e\u5165\u529b\u30c7\u30d0\u30a4\u30b9\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub514\uc624 \uc18c\uc2a4\uc758 \ud615\uc2dd\uc774 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \uc785\ub825 \uae30\uae30\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u9891\u6765\u6e90\u7684\u683c\u5f0f\u4e0d\u53d7\u652f\u6301\u3002\u8bf7\u9009\u62e9\u5176\u4ed6\u8f93\u5165\u8bbe\u5907\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u8a0a\u4f86\u6e90\u7684\u683c\u5f0f\u4e0d\u53d7\u652f\u63f4\u3002\u8acb\u9078\u64c7\u5176\u4ed6\u8f38\u5165\u88dd\u7f6e\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0646\u0633\u064a\u0642 \u0645\u0635\u062f\u0631 \u0627\u0644\u0635\u0648\u062a \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645. \u0627\u062e\u062a\u0631 \u062c\u0647\u0627\u0632 \u0625\u062f\u062e\u0627\u0644 \u0622\u062e\u0631."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05d5\u05e8\u05de\u05d8 \u05de\u05e7\u05d5\u05e8 \u05d4\u05e9\u05de\u05e2 \u05d0\u05d9\u05e0\u05d5 \u05e0\u05ea\u05de\u05da. \u05d1\u05d7\u05e8 \u05d4\u05ea\u05e7\u05df \u05e7\u05dc\u05d8 \u05d0\u05d7\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0911\u0921\u093f\u092f\u094b \u0938\u094d\u0930\u094b\u0924 \u0915\u093e \u092b\u093c\u0949\u0930\u094d\u092e\u0948\u091f \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u093e \u0907\u0928\u092a\u0941\u091f \u0921\u093f\u0935\u093e\u0907\u0938 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "The model folder moved. Choose it again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model folder moved. Choose it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta del modelo se ha movido. Vuelve a elegirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier du mod\u00e8le a \u00e9t\u00e9 d\u00e9plac\u00e9. S\u00e9lectionnez-le \u00e0 nouveau."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modellordner wurde verschoben. W\u00e4hle ihn erneut aus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella del modello \u00e8 stata spostata. Selezionala di nuovo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta do modelo foi movida. Escolha-a novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De modelmap is verplaatst. Kies die opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellmappen har flyttats. V\u00e4lj den igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder modelu zosta\u0142 przeniesiony. Wybierz go ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model klas\u00f6r\u00fc ta\u015f\u0131nm\u0131\u015f. Yeniden se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder model telah dipindahkan. Pilih kembali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0430\u043f\u043a\u0430 \u043c\u043e\u0434\u0435\u043b\u0438 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0430. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0451 \u0441\u043d\u043e\u0432\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0430\u043f\u043a\u0443 \u043c\u043e\u0434\u0435\u043b\u0456 \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043e. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0457\u0457 \u0437\u043d\u043e\u0432\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Th\u01b0 m\u1ee5c m\u00f4 h\u00ecnh \u0111\u00e3 \u0111\u01b0\u1ee3c di chuy\u1ec3n. H\u00e3y ch\u1ecdn l\u1ea1i."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u306e\u30d5\u30a9\u30eb\u30c0\u304c\u79fb\u52d5\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u3082\u3046\u4e00\u5ea6\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378 \ud3f4\ub354\uac00 \uc774\ub3d9\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6a21\u578b\u6587\u4ef6\u5939\u5df2\u79fb\u52a8\u3002\u8bf7\u91cd\u65b0\u9009\u62e9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6a21\u578b\u8cc7\u6599\u593e\u5df2\u79fb\u52d5\u3002\u8acb\u91cd\u65b0\u9078\u64c7\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0646\u0642\u0644 \u0645\u062c\u0644\u062f \u0627\u0644\u0646\u0645\u0648\u0630\u062c. \u0627\u062e\u062a\u0631\u0647 \u0645\u062c\u062f\u062f\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d5\u05e2\u05d1\u05e8\u05d4. \u05d1\u05d7\u05e8 \u05d0\u05d5\u05ea\u05d4 \u05e9\u05d5\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u093f\u0924 \u0939\u094b \u0917\u092f\u093e \u0939\u0948\u0964 \u0909\u0938\u0947 \u092b\u093f\u0930 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "The selected audio source is unavailable. Select an available microphone or application.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected audio source is unavailable. Select an available microphone or application."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La fuente de audio seleccionada no est\u00e1 disponible. Selecciona un micr\u00f3fono o una aplicaci\u00f3n disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La source audio s\u00e9lectionn\u00e9e est indisponible. S\u00e9lectionnez un microphone ou une application disponible."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die ausgew\u00e4hlte Audioquelle ist nicht verf\u00fcgbar. W\u00e4hle ein verf\u00fcgbares Mikrofon oder eine Anwendung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sorgente audio selezionata non \u00e8 disponibile. Seleziona un microfono o un'applicazione disponibile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fonte de \u00e1udio selecionada est\u00e1 indispon\u00edvel. Selecione um microfone ou aplicativo dispon\u00edvel."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geselecteerde audiobron is niet beschikbaar. Selecteer een beschikbare microfoon of toepassing."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valda ljudk\u00e4llan \u00e4r inte tillg\u00e4nglig. V\u00e4lj en tillg\u00e4nglig mikrofon eller app."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrane \u017ar\u00f3d\u0142o d\u017awi\u0119ku jest niedost\u0119pne. Wybierz dost\u0119pny mikrofon lub aplikacj\u0119."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00e7ilen ses kayna\u011f\u0131 kullan\u0131lam\u0131yor. Kullan\u0131labilir bir mikrofon veya uygulama se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber audio yang dipilih tidak tersedia. Pilih mikrofon atau aplikasi yang tersedia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0437\u0432\u0443\u043a\u0430 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0439 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d \u0438\u043b\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0440\u0430\u043d\u0435 \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u0437\u0432\u0443\u043a\u0443 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u043c\u0456\u043a\u0440\u043e\u0444\u043e\u043d \u0430\u0431\u043e \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngu\u1ed3n \u00e2m thanh \u0111\u00e3 ch\u1ecdn kh\u00f4ng kh\u1ea3 d\u1ee5ng. Ch\u1ecdn micr\u00f4 ho\u1eb7c \u1ee9ng d\u1ee5ng kh\u1ea3 d\u1ee5ng."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u3057\u305f\u97f3\u58f0\u30bd\u30fc\u30b9\u3092\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002\u5229\u7528\u53ef\u80fd\u306a\u30de\u30a4\u30af\u307e\u305f\u306f\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\ud55c \uc624\ub514\uc624 \uc18c\uc2a4\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9 \uac00\ub2a5\ud55c \ub9c8\uc774\ud06c \ub610\ub294 \uc571\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u9009\u97f3\u9891\u6765\u6e90\u4e0d\u53ef\u7528\u3002\u8bf7\u9009\u62e9\u53ef\u7528\u7684\u9ea6\u514b\u98ce\u6216\u5e94\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u9078\u97f3\u8a0a\u4f86\u6e90\u7121\u6cd5\u4f7f\u7528\u3002\u8acb\u9078\u64c7\u53ef\u7528\u7684\u9ea5\u514b\u98a8\u6216 App\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0635\u062f\u0631 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062d\u062f\u062f \u063a\u064a\u0631 \u0645\u062a\u0627\u062d. \u062d\u062f\u062f \u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646\u0627\u064b \u0623\u0648 \u062a\u0637\u0628\u064a\u0642\u0627\u064b \u0645\u062a\u0627\u062d\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e7\u05d5\u05e8 \u05d4\u05e9\u05de\u05e2 \u05e9\u05e0\u05d1\u05d7\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05d6\u05de\u05d9\u05df. \u05d1\u05d7\u05e8 \u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05d0\u05d5 \u05d9\u05d9\u05e9\u05d5\u05dd \u05d6\u05de\u05d9\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0941\u0928\u093e \u0917\u092f\u093e \u0911\u0921\u093f\u092f\u094b \u0938\u094d\u0930\u094b\u0924 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0909\u092a\u0932\u092c\u094d\u0927 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u092f\u093e \u0910\u092a \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "There is no audio to play or export.": {
      "extractionState": "manual",
      "localizations": {
