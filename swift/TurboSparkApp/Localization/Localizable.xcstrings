    "Choose a folder containing .claude-plugin/plugin.json or plugin directories": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0645\u062c\u0644\u062f\u064b\u0627 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 .claude-plugin/plugin.json \u0623\u0648 \u0645\u062c\u0644\u062f\u0627\u062a \u0645\u0644\u062d\u0642\u0627\u062a"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie einen Ordner mit .claude-plugin/plugin.json oder Plug-in-Verzeichnissen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a folder containing .claude-plugin/plugin.json or plugin directories"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta que contenga .claude-plugin/plugin.json o carpetas de complementos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier contenant .claude-plugin/plugin.json ou des dossiers de plug-ins"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05e9\u05de\u05db\u05d9\u05dc\u05d4 .claude-plugin/plugin.json \u05d0\u05d5 \u05ea\u05d9\u05e7\u05d9\u05d5\u05ea \u05ea\u05d5\u05e1\u05e4\u05d9\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0910\u0938\u093e \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u091a\u0941\u0928\u0947\u0902 \u091c\u093f\u0938\u092e\u0947\u0902 .claude-plugin/plugin.json \u092f\u093e \u092a\u094d\u0932\u0917\u0907\u0928 \u0921\u093e\u092f\u0930\u0947\u0915\u094d\u091f\u0930\u0940 \u0939\u094b\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder yang berisi .claude-plugin/plugin.json atau direktori plugin"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella che contiene .claude-plugin/plugin.json o cartelle di plugin"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
