    "Start the server and these fill in with its real address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the server and these fill in with its real address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el servidor y estos se rellenarán con su dirección real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le serveur et ces champs se rempliront avec son adresse réelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie den Server, dann werden diese mit seiner echten Adresse gefüllt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia il server e questi verranno compilati con il suo indirizzo reale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o servidor e estes serão preenchidos com o endereço real dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите сервер, и здесь появится его настоящий адрес."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを起動すると、これらに実際のアドレスが入ります。"
