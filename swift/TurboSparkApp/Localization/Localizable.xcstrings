    "Every installed model is already attached.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062c\u0645\u064a\u0639 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0645\u062b\u0628\u062a\u0629 \u0645\u0631\u0641\u0642\u0629 \u0628\u0627\u0644\u0641\u0639\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle installierten Modelle sind bereits angeh\u00e4ngt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every installed model is already attached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los modelos instalados ya est\u00e1n adjuntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les mod\u00e8les install\u00e9s sont d\u00e9j\u00e0 attach\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05dc \u05d4\u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05d4\u05de\u05d5\u05ea\u05e7\u05e0\u05d9\u05dd \u05db\u05d1\u05e8 \u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092d\u0940 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u093f\u090f \u0917\u090f \u092e\u0949\u0921\u0932 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0938\u0902\u0932\u0917\u094d\u0928 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua model terpasang sudah dilampirkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i modelli installati sono gi\u00e0 collegati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u306e\u30e2\u30c7\u30eb\u306f\u3059\u3079\u3066\u6dfb\u4ed8\u6e08\u307f\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ub41c \ubaa8\ub4e0 \ubaa8\ub378\uc774 \uc774\ubbf8 \ucca8\ubd80\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle ge\u00efnstalleerde modellen zijn al gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zainstalowane modele s\u0105 ju\u017c do\u0142\u0105czone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os modelos instalados j\u00e1 est\u00e3o anexados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u0443\u0436\u0435 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla installerade modeller \u00e4r redan bifogade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulu t\u00fcm modeller zaten ekli."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0456 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0456 \u043c\u043e\u0434\u0435\u043b\u0456 \u0432\u0436\u0435 \u043f\u0440\u0438\u0454\u0434\u043d\u0430\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ecdi m\u00f4 h\u00ecnh \u0111\u00e3 c\u00e0i \u0111\u1ec1u \u0111\u00e3 \u0111\u01b0\u1ee3c \u0111\u00ednh k\u00e8m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u6709\u5df2\u5b89\u88c5\u7684\u6a21\u578b\u90fd\u5df2\u9644\u52a0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u6709\u5df2\u5b89\u88dd\u7684\u6a21\u578b\u90fd\u5df2\u9644\u52a0\u3002"
          }
        }
      }
    },
    "Every launch opens a temporary chat that exists only in memory. It is never saved, even when tied to a profile, and is encrypted while the app runs. Ghost chats cannot be recovered.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0641\u062a\u062d \u0643\u0644 \u062a\u0634\u063a\u064a\u0644 \u0645\u062d\u0627\u062f\u062b\u0629 \u0645\u0624\u0642\u062a\u0629 \u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0641\u0642\u0637. \u0644\u0627 \u064a\u062a\u0645 \u062d\u0641\u0638\u0647\u0627 \u0623\u0628\u062f\u064b\u0627\u060c \u062d\u062a\u0649 \u0639\u0646\u062f \u0631\u0628\u0637\u0647\u0627 \u0628\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641\u060c \u0648\u062a\u0643\u0648\u0646 \u0645\u0634\u0641\u0631\u0629 \u0623\u062b\u0646\u0627\u0621 \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u0634\u0628\u062d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Start \u00f6ffnet einen tempor\u00e4ren Chat, der nur im Speicher existiert. Er wird nie gespeichert, selbst wenn er an ein Profil gebunden ist, und wird verschl\u00fcsselt, w\u00e4hrend die App l\u00e4uft. Ghost-Chats k\u00f6nnen nicht wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every launch opens a temporary chat that exists only in memory. It is never saved, even when tied to a profile, and is encrypted while the app runs. Ghost chats cannot be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada inicio abre un chat temporal que solo existe en la memoria. Nunca se guarda, incluso si est\u00e1 vinculado a un perfil, y se cifra mientras la app se ejecuta. Los chats fantasma no se pueden recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque lancement ouvre une discussion temporaire qui n'existe qu'en m\u00e9moire. Elle n'est jamais enregistr\u00e9e, m\u00eame li\u00e9e \u00e0 un profil, et est chiffr\u00e9e pendant l'ex\u00e9cution de l'application. Les discussions fant\u00f4mes ne peuvent pas \u00eatre r\u00e9cup\u00e9r\u00e9es."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05dc \u05d4\u05e4\u05e2\u05dc\u05d4 \u05e4\u05d5\u05ea\u05d7\u05ea \u05e6'\u05d0\u05d8 \u05d6\u05de\u05e0\u05d9 \u05e9\u05e7\u05d9\u05d9\u05dd \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d1\u05dc\u05d1\u05d3. \u05d4\u05d5\u05d0 \u05dc\u05e2\u05d5\u05dc\u05dd \u05d0\u05d9\u05e0\u05d5 \u05e0\u05e9\u05de\u05e8, \u05d2\u05dd \u05db\u05d0\u05e9\u05e8 \u05d4\u05d5\u05d0 \u05de\u05e7\u05d5\u05e9\u05e8 \u05dc\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc, \u05d5\u05d4\u05d5\u05d0 \u05de\u05d5\u05e6\u05e4\u05df \u05d1\u05d6\u05de\u05df \u05e9\u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e4\u05d5\u05e2\u05dc\u05ea. \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05d7\u05d6\u05e8 \u05e6'\u05d0\u05d8\u05d9\u05dd \u05e9\u05dc \u05e8\u05e4\u05d0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u094d\u092f\u0947\u0915 \u0932\u0949\u0928\u094d\u091a \u090f\u0915 \u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u091a\u0948\u091f \u0916\u094b\u0932\u0924\u093e \u0939\u0948 \u091c\u094b \u0915\u0947\u0935\u0932 \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u0947\u0902 \u092e\u094c\u091c\u0942\u0926 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u0938\u0939\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u093e \u0939\u0948, \u092d\u0932\u0947 \u0939\u0940 \u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0938\u0947 \u092c\u0902\u0927\u093e \u0939\u094b, \u0914\u0930 \u0910\u092a \u091a\u0932\u0928\u0947 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0918\u094b\u0938\u094d\u091f \u091a\u0948\u091f \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap peluncuran akan membuka obrolan sementara yang hanya ada di memori. Obrolan ini tidak pernah disimpan, bahkan saat dikaitkan dengan profil, dan dienkripsi saat aplikasi berjalan. Obrolan hantu tidak dapat dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni avvio apre una chat temporanea che esiste solo in memoria. Non viene mai salvata, anche se associata a un profilo, ed \u00e8 crittografata durante l'esecuzione dell'app. Le chat fantasma non possono essere recuperate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d77\u52d5\u3059\u308b\u305f\u3073\u306b\u3001\u30e1\u30e2\u30ea\u5185\u306b\u306e\u307f\u5b58\u5728\u3059\u308b\u4e00\u6642\u7684\u306a\u30c1\u30e3\u30c3\u30c8\u304c\u958b\u304d\u307e\u3059\u3002\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u95a2\u9023\u4ed8\u3051\u3089\u308c\u3066\u3044\u308b\u5834\u5408\u3067\u3082\u4fdd\u5b58\u3055\u308c\u305a\u3001\u30a2\u30d7\u30ea\u306e\u5b9f\u884c\u4e2d\u306f\u6697\u53f7\u5316\u3055\u308c\u307e\u3059\u3002\u30b4\u30fc\u30b9\u30c8\u30c1\u30e3\u30c3\u30c8\u306f\u5fa9\u5143\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uc791\ud560 \ub54c\ub9c8\ub2e4 \uba54\ubaa8\ub9ac\uc5d0\ub9cc \uc874\uc7ac\ud558\ub294 \uc784\uc2dc \ucc44\ud305\uc774 \uc5f4\ub9bd\ub2c8\ub2e4. \ud504\ub85c\ud544\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\ub354\ub77c\ub3c4 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc73c\uba70 \uc571\uc774 \uc2e4\ud589\ub418\ub294 \ub3d9\uc548 \uc554\ud638\ud654\ub429\ub2c8\ub2e4. \uace0\uc2a4\ud2b8 \ucc44\ud305\uc740 \ubcf5\uad6c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke start opent een tijdelijke chat die alleen in het geheugen bestaat. Deze wordt nooit opgeslagen, zelfs niet wanneer deze aan een profiel is gekoppeld, en is versleuteld terwijl de app actief is. Ghost-chats kunnen niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka\u017cde uruchomienie otwiera tymczasowy czat, kt\u00f3ry istnieje tylko w pami\u0119ci. Nigdy nie jest zapisywany, nawet po powi\u0105zaniu z profilem, i jest szyfrowany podczas dzia\u0142ania aplikacji. Czat\u00f3w widmo nie mo\u017cna odzyska\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada inicializa\u00e7\u00e3o abre um chat tempor\u00e1rio que existe apenas na mem\u00f3ria. Ele nunca \u00e9 salvo, mesmo quando vinculado a um perfil, e \u00e9 criptografado enquanto o aplicativo \u00e9 executado. Chats fantasmas n\u00e3o podem ser recuperados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u0436\u0434\u044b\u0439 \u0437\u0430\u043f\u0443\u0441\u043a \u043e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0447\u0430\u0442, \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 \u0442\u043e\u043b\u044c\u043a\u043e \u0432 \u043f\u0430\u043c\u044f\u0442\u0438. \u041e\u043d \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u043f\u0440\u0438\u0432\u044f\u0437\u0430\u043d \u043a \u043f\u0440\u043e\u0444\u0438\u043b\u044e, \u0438 \u0448\u0438\u0444\u0440\u0443\u0435\u0442\u0441\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0440\u0430\u0431\u043e\u0442\u044b \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f. \u041f\u0440\u0438\u0437\u0440\u0430\u0447\u043d\u044b\u0435 \u0447\u0430\u0442\u044b \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043d\u0435\u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje start \u00f6ppnar en tillf\u00e4llig chatt som bara finns i minnet. Den sparas aldrig, inte ens n\u00e4r den \u00e4r knuten till en profil, och krypteras medan appen k\u00f6rs. Sp\u00f6kchattar kan inte \u00e5terst\u00e4llas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her ba\u015flatma, yaln\u0131zca bellekte bulunan ge\u00e7ici bir sohbet a\u00e7ar. Bir profile ba\u011fl\u0131 olsa bile asla kaydedilmez ve uygulama \u00e7al\u0131\u015f\u0131rken \u015fifrelenir. Hayalet sohbetler kurtar\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0436\u0435\u043d \u0437\u0430\u043f\u0443\u0441\u043a \u0432\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u0438\u0439 \u0447\u0430\u0442, \u044f\u043a\u0438\u0439 \u0456\u0441\u043d\u0443\u0454 \u043b\u0438\u0448\u0435 \u0432 \u043f\u0430\u043c'\u044f\u0442\u0456. \u0412\u0456\u043d \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f, \u043d\u0430\u0432\u0456\u0442\u044c \u044f\u043a\u0449\u043e \u043f\u0440\u0438\u0432'\u044f\u0437\u0430\u043d\u0438\u0439 \u0434\u043e \u043f\u0440\u043e\u0444\u0456\u043b\u044e, \u0456 \u0448\u0438\u0444\u0440\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u0440\u043e\u0431\u043e\u0442\u0438 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438. \u0427\u0430\u0442-\u043f\u0440\u0438\u0432\u0438\u0434 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed7i l\u1ea7n kh\u1edfi ch\u1ea1y s\u1ebd m\u1edf m\u1ed9t cu\u1ed9c tr\u00f2 chuy\u1ec7n t\u1ea1m th\u1eddi ch\u1ec9 t\u1ed3n t\u1ea1i trong b\u1ed9 nh\u1edb. Cu\u1ed9c tr\u00f2 chuy\u1ec7n n\u00e0y kh\u00f4ng bao gi\u1edd \u0111\u01b0\u1ee3c l\u01b0u, ngay c\u1ea3 khi \u0111\u01b0\u1ee3c li\u00ean k\u1ebft v\u1edbi m\u1ed9t h\u1ed3 s\u01a1 v\u00e0 \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a khi \u1ee9ng d\u1ee5ng ch\u1ea1y. Kh\u00f4ng th\u1ec3 kh\u00f4i ph\u1ee5c c\u00e1c cu\u1ed9c tr\u00f2 chuy\u1ec7n ma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u542f\u52a8\u90fd\u4f1a\u6253\u5f00\u4e00\u4e2a\u4ec5\u5b58\u5728\u4e8e\u5185\u5b58\u4e2d\u7684\u4e34\u65f6\u804a\u5929\u3002\u5373\u4f7f\u5173\u8054\u5230\u914d\u7f6e\u6587\u4ef6\u4e5f\u7edd\u4e0d\u4fdd\u5b58\uff0c\u4e14\u5728\u5e94\u7528\u8fd0\u884c\u671f\u95f4\u5904\u4e8e\u52a0\u5bc6\u72b6\u6001\u3002\u5e7d\u7075\u804a\u5929\u65e0\u6cd5\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u555f\u52d5\u90fd\u6703\u958b\u555f\u4e00\u500b\u50c5\u5b58\u5728\u65bc\u8a18\u61b6\u9ad4\u4e2d\u7684\u66ab\u5b58\u804a\u5929\u3002\u5373\u4f7f\u95dc\u806f\u5230\u8a2d\u5b9a\u6a94\u4e5f\u7d55\u4e0d\u5132\u5b58\uff0c\u4e14\u5728\u61c9\u7528\u7a0b\u5f0f\u57f7\u884c\u671f\u9593\u8655\u65bc\u52a0\u5bc6\u72c0\u614b\u3002\u5e7d\u9748\u804a\u5929\u7121\u6cd5\u5fa9\u539f\u3002"
          }
        }
      }
    },
    "Everything here runs on your Mac. Nothing leaves it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0643\u0644 \u0634\u064a\u0621 \u064a\u0639\u0645\u0644 \u0639\u0644\u0649 \u062c\u0647\u0627\u0632 Mac \u0627\u0644\u062e\u0627\u0635 \u0628\u0643. \u0644\u0627 \u0634\u064a\u0621 \u064a\u063a\u0627\u062f\u0631\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles l\u00e4uft auf deinem Mac. Nichts verl\u00e4sst ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything here runs on your Mac. Nothing leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo esto se ejecuta en tu Mac. Nada sale de \u00e9l."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout s'ex\u00e9cute sur votre Mac. Rien n'en sort."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05db\u05d5\u05dc \u05e8\u05e5 \u05e2\u05dc \u05d4-Mac \u05e9\u05dc\u05da. \u05e9\u05d5\u05dd \u05d3\u05d1\u05e8 \u05dc\u05d0 \u05d9\u05d5\u05e6\u05d0 \u05de\u05de\u05e0\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0938\u092c \u0906\u092a\u0915\u0947 Mac \u092a\u0930 \u091a\u0932\u0924\u093e \u0939\u0948\u0964 \u0915\u0941\u091b \u092d\u0940 \u092c\u093e\u0939\u0930 \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya berjalan di Mac Anda. Tidak ada yang keluar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto gira sul tuo Mac. Niente esce da qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u3053\u306eMac\u4e0a\u3067\u52d5\u4f5c\u3057\u307e\u3059\u3002\u5916\u90e8\u306b\u306f\u4f55\u3082\u9001\u4fe1\u3055\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \uc791\uc5c5\uc740 \uc774 Mac\uc5d0\uc11c \uc2e4\ud589\ub429\ub2c8\ub2e4. \ubc16\uc73c\ub85c \ub098\uac00\ub294 \uac83\uc740 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles draait op je Mac. Er gaat niets naar buiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko dzia\u0142a na Twoim Macu. Nic go nie opuszcza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo roda no seu Mac. Nada sai daqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0451 \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u043d\u0430 \u0432\u0430\u0448\u0435\u043c Mac. \u041d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u043e\u043a\u0438\u0434\u0430\u0435\u0442 \u0435\u0433\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt k\u00f6rs p\u00e5 din Mac. Ingenting l\u00e4mnar den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her \u015fey Mac'inizde \u00e7al\u0131\u015f\u0131r. Hi\u00e7bir \u015fey d\u0131\u015far\u0131 \u00e7\u0131kmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0435 \u043f\u0440\u0430\u0446\u044e\u0454 \u043d\u0430 \u0432\u0430\u0448\u043e\u043c\u0443 Mac. \u041d\u0456\u0449\u043e \u0439\u043e\u0433\u043e \u043d\u0435 \u0437\u0430\u043b\u0438\u0448\u0430\u0454."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ecdi th\u1ee9 ch\u1ea1y tr\u00ean m\u00e1y Mac c\u1ee7a b\u1ea1n. Kh\u00f4ng c\u00f3 g\u00ec r\u1eddi kh\u1ecfi m\u00e1y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u5207\u90fd\u5728\u4f60\u7684 Mac \u4e0a\u8fd0\u884c\uff0c\u6ca1\u6709\u4efb\u4f55\u6570\u636e\u79bb\u5f00\u672c\u673a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u5207\u90fd\u5728\u4f60\u7684 Mac \u4e0a\u57f7\u884c\uff0c\u6c92\u6709\u4efb\u4f55\u8cc7\u6599\u96e2\u958b\u672c\u6a5f\u3002"
          }
        }
      }
    },
    "Excluded from scan": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0633\u062a\u0628\u0639\u062f \u0645\u0646 \u0627\u0644\u0641\u062d\u0635"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von der Suche ausgeschlossen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluded from scan"
          }
        },
