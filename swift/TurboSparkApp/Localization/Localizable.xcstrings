        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No memories match this view."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ning\u00fan recuerdo coincide con esta vista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun souvenir ne correspond \u00e0 cette vue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05d6\u05db\u05e8\u05d5\u05e0\u05d5\u05ea \u05d4\u05ea\u05d5\u05d0\u05de\u05d9\u05dd \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4 \u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0926\u0943\u0936\u094d\u092f \u0938\u0947 \u0915\u094b\u0908 \u092f\u093e\u0926\u0947\u0902 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada memori yang cocok dengan tampilan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun ricordo corrisponde a questa vista."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u8868\u793a\u306b\u4e00\u81f4\u3059\u308b\u30e1\u30e2\u30ea\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubcf4\uae30\uc5d0 \uc77c\uce58\ud558\ub294 \uba54\ubaa8\ub9ac\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen herinneringen komen overeen met deze weergave."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wspomnie\u0144 pasuj\u0105cych do tego widoku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma mem\u00f3ria corresponde a esta visualiza\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0445 \u044d\u0442\u043e\u043c\u0443 \u0432\u0438\u0434\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga minnen matchar denna vy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu g\u00f6r\u00fcn\u00fcmle e\u015fle\u015fen bellek yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0441\u043f\u043e\u0433\u0430\u0434\u0456\u0432, \u0449\u043e \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u044e\u0442\u044c \u0446\u044c\u043e\u043c\u0443 \u0432\u0438\u0433\u043b\u044f\u0434\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 k\u00fd \u1ee9c n\u00e0o kh\u1edbp v\u1edbi ch\u1ebf \u0111\u1ed9 xem n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u7b26\u5408\u6b64\u89c6\u56fe\u7684\u8bb0\u5fc6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
