        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d5\u05de\u05da \u05d1\u05e9\u05e8\u05e9\u05e8\u05ea \u05de\u05d7\u05e9\u05d1\u05d4 \u05d5\u05d1\u05d7\u05d9\u05dc\u05d5\u05e5 \u05d7\u05e9\u05d9\u05d1\u05d4 \u05e4\u05e0\u05d9\u05de\u05d9\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0947\u0928-\u0911\u092b\u093c-\u0925\u0949\u091f \u0914\u0930 \u0906\u0902\u0924\u0930\u093f\u0915 \u0924\u0930\u094d\u0915 \u0928\u093f\u0937\u094d\u0915\u0930\u094d\u0937\u0923 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
