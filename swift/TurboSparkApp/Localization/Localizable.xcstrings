    "Payload is supplied via JSON over stdin. Exit code 2 blocks PreToolUse execution.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payload is supplied via JSON over stdin. Exit code 2 blocks PreToolUse execution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga útil se envía como JSON por stdin. El código de salida 2 bloquea la ejecución de PreToolUse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge utile est fournie en JSON via stdin. Le code de sortie 2 bloque l'exécution de PreToolUse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzlast wird als JSON über stdin übergeben. Exit-Code 2 blockiert die PreToolUse-Ausführung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il payload viene fornito come JSON tramite stdin. Il codice di uscita 2 blocca l'esecuzione di PreToolUse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O payload é fornecido como JSON via stdin. O código de saída 2 bloqueia a execução de PreToolUse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полезная нагрузка передается в формате JSON через stdin. Код выхода 2 блокирует выполнение PreToolUse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ペイロードは stdin 経由の JSON で渡されます。終了コード 2 は PreToolUse の実行をブロックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "페이로드는 stdin을 통해 JSON으로 전달됩니다. 종료 코드 2는 PreToolUse 실행을 차단합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "负载通过 stdin 以 JSON 提供。退出码 2 会阻止 PreToolUse 执行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "負載透過 stdin 以 JSON 提供。結束碼 2 會阻擋 PreToolUse 執行。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُمرَّر الحمولة بصيغة JSON عبر stdin. ورمز الخروج 2 يمنع تنفيذ PreToolUse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המטען מסופק כ-JSON דרך stdin. קוד יציאה 2 חוסם את ההרצה של PreToolUse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेलोड stdin के माध्यम से JSON में दिया जाता है। एग्ज़िट कोड 2 PreToolUse निष्पादन रोक देता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De payload wordt als JSON via stdin aangeleverd. Afsluitcode 2 blokkeert de uitvoering van PreToolUse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ładunek jest przekazywany jako JSON przez stdin. Kod wyjścia 2 blokuje wykonanie PreToolUse."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yük, stdin üzerinden JSON olarak sağlanır. Çıkış kodu 2, PreToolUse yürütmesini engeller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Корисне навантаження передається як JSON через stdin. Код виходу 2 блокує виконання PreToolUse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyttolasten skickas som JSON via stdin. Slutkod 2 blockerar PreToolUse-körning."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Payload được cung cấp dưới dạng JSON qua stdin. Mã thoát 2 chặn việc thực thi PreToolUse."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Payload disediakan sebagai JSON melalui stdin. Kode keluar 2 memblokir eksekusi PreToolUse."
          }
        }
      }
    },
