          }
        }
      }
    },
    "Serve your loaded models over HTTP to any app on this machine.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u062f\u0651\u0645 \u0646\u0645\u0627\u0630\u062c\u0643 \u0627\u0644\u0645\u062d\u0645\u0651\u0644\u0629 \u0639\u0628\u0631 HTTP \u0644\u0623\u064a \u062a\u0637\u0628\u064a\u0642 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle deine geladenen Modelle per HTTP jeder App auf diesem Mac bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Serve your loaded models over HTTP to any app on this machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sirve tus modelos cargados por HTTP a cualquier app de este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Servez vos mod\u00e8les charg\u00e9s en HTTP \u00e0 toute app de cet ordinateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d2\u05e9 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05d4\u05d8\u05e2\u05d5\u05e0\u05d9\u05dd \u05e9\u05dc\u05da \u05d3\u05e8\u05da HTTP \u05dc\u05db\u05dc \u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d1\u05de\u05d7\u05e9\u05d1 \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0932\u094b\u0921 \u0915\u093f\u090f \u0917\u090f \u092e\u0949\u0921\u0932 \u0907\u0938 \u092e\u0936\u0940\u0928 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0910\u092a \u0915\u094b HTTP \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0915\u0930\u093e\u090f\u0901\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sajikan model yang dimuat melalui HTTP ke aplikasi apa pun di mesin ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servi i modelli caricati via HTTP a qualsiasi app su questo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aad\u307f\u8fbc\u3093\u3060\u30e2\u30c7\u30eb\u3092\u3001\u3053\u306e\u30de\u30b7\u30f3\u4e0a\u306e\u30a2\u30d7\u30ea\u306b HTTP \u3067\u63d0\u4f9b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub85c\ub4dc\ud55c \ubaa8\ub378\uc744 HTTP\ub85c \uc774 \ucef4\ud4e8\ud130\uc758 \ubaa8\ub4e0 \uc571\uc5d0 \uc81c\uacf5\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bied je geladen modellen via HTTP aan elke app op deze computer aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udost\u0119pniaj za\u0142adowane modele przez HTTP dowolnej aplikacji na tym komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Disponibilize seus modelos carregados via HTTP para qualquer app neste computador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u043f\u043e HTTP \u043b\u044e\u0431\u043e\u043c\u0443 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044e \u043d\u0430 \u044d\u0442\u043e\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Erbjud dina inl\u00e4sta modeller via HTTP till alla appar p\u00e5 den h\u00e4r datorn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fckl\u00fc modellerinizi bu makinedeki her uygulamaya HTTP \u00fczerinden sunun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u0456 \u043c\u043e\u0434\u0435\u043b\u0456 \u0447\u0435\u0440\u0435\u0437 HTTP \u0431\u0443\u0434\u044c-\u044f\u043a\u043e\u043c\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u043a\u043e\u043c\u043f'\u044e\u0442\u0435\u0440\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cung c\u1ea5p c\u00e1c m\u00f4 h\u00ecnh \u0111\u00e3 t\u1ea3i qua HTTP cho m\u1ecdi \u1ee9ng d\u1ee5ng tr\u00ean m\u00e1y n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7 HTTP \u5c06\u5df2\u52a0\u8f7d\u7684\u6a21\u578b\u63d0\u4f9b\u7ed9\u6b64\u7535\u8111\u4e0a\u7684\u4efb\u4f55 App\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e HTTP \u5c07\u5df2\u8f09\u5165\u7684\u6a21\u578b\u63d0\u4f9b\u7d66\u6b64\u96fb\u8166\u4e0a\u7684\u4efb\u4f55 App\u3002"
          }
        }
      }
    },
