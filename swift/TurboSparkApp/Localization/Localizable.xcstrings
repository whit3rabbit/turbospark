        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30de\u30fc\u30b1\u30c3\u30c8\u30d7\u30ec\u30a4\u30b9\u3092\u53c2\u7167\u3059\u308b\u304b\u3001.claude-plugin/plugin.json \u3092\u542b\u3080\u30ed\u30fc\u30ab\u30eb\u30d5\u30a9\u30eb\u30c0\u3092\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
