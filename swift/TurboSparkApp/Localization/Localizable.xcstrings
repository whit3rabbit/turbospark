        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d5 \u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05d9\u05d5\u05ea \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d5\u05ea \u05d1\u05de\u05d9\u05e7\u05d5\u05de\u05d9 \u05d4\u05e1\u05d5\u05db\u05df \u05d4\u05e8\u05d2\u05d9\u05dc\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u093e\u0928\u0915 \u090f\u091c\u0947\u0902\u091f \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092c\u093e\u0939\u0930\u0940 \u0938\u094d\u0915\u093f\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada keterampilan eksternal ditemukan di lokasi agen standar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna competenza esterna trovata nelle posizioni standard degli agenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6a19\u6e96\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u914d\u7f6e\u5834\u6240\u306b\u5916\u90e8\u30b9\u30ad\u30eb\u306f\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud45c\uc900 \uc5d0\uc774\uc804\ud2b8 \uc704\uce58\uc5d0\uc11c \uc678\ubd80 \uc2a4\ud0ac\uc744 \ucc3e\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."
