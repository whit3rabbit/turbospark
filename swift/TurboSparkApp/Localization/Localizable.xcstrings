    "Inspect and manage macOS filesystem access, protected user folders, and tool execution permissions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افحص وأدر الوصول إلى نظام ملفات macOS ومجلدات المستخدم المحمية وأذونات تنفيذ الأدوات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfen und verwalten Sie den macOS-Dateisystemzugriff, geschützte Benutzerordner und Berechtigungen zur Tool-Ausführung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspect and manage macOS filesystem access, protected user folders, and tool execution permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecciona y gestiona el acceso al sistema de archivos de macOS, las carpetas de usuario protegidas y los permisos de ejecución de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspectez et gérez l'accès au système de fichiers macOS, les dossiers utilisateur protégés et les autorisations d'exécution des outils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק ונהל גישה למערכת הקבצים של macOS, תיקיות משתמש מוגנות והרשאות להרצת כלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS फ़ाइल सिस्टम एक्सेस, सुरक्षित उपयोगकर्ता फ़ोल्डर और टूल निष्पादन अनुमतियां देखें और प्रबंधित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa dan kelola akses sistem berkas macOS, folder pengguna terlindungi, dan izin eksekusi alat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ispeziona e gestisci l'accesso al file system di macOS, le cartelle utente protette e i permessi di esecuzione degli strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS のファイルシステムアクセス、保護されたユーザーフォルダ、ツール実行の権限を確認・管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS 파일 시스템 접근, 보호된 사용자 폴더, 도구 실행 권한을 확인하고 관리합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk en beheer macOS-bestandssysteemtoegang, beschermde gebruikersmappen en machtigingen voor tooluitvoering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzaj i zarządzaj dostępem do systemu plików macOS, chronionymi folderami użytkownika i uprawnieniami do uruchamiania narzędzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspecione e gerencie o acesso ao sistema de arquivos do macOS, as pastas de usuário protegidas e as permissões de execução de ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Просматривайте и настраивайте доступ к файловой системе macOS, защищенные пользовательские папки и разрешения на выполнение инструментов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Granska och hantera macOS-filsystemåtkomst, skyddade användarmappar och behörigheter för verktygskörning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS dosya sistemi erişimini, korumalı kullanıcı klasörlerini ve araç yürütme izinlerini inceleyip yönetin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переглядайте та керуйте доступом до файлової системи macOS, захищеними папками користувача й дозволами на виконання інструментів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra và quản lý quyền truy cập hệ thống tệp macOS, các thư mục người dùng được bảo vệ và quyền thực thi công cụ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查并管理 macOS 文件系统访问、受保护的用户文件夹以及工具执行权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "檢查並管理 macOS 檔案系統存取、受保護的使用者資料夾以及工具執行權限。"
          }
        }
      }
    },
