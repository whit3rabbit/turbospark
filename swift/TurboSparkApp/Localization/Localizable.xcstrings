        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u540d\u70ba\u300c%@\u300d\u7684\u4ee3\u7406\u6a94\u6848\u5df2\u5b58\u5728\u3002\u8acb\u91cd\u65b0\u547d\u540d\u65b0\u4ee3\u7406\uff0c\u6216\u5148\u522a\u9664\u820a\u6a94\u6848\u3002"
