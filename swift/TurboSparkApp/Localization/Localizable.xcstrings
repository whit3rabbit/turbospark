    "This Mac already covers that disk. Choose a folder on a different drive.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا الـ Mac يغطي هذا القرص بالفعل. اختر مجلدًا على محرك أقراص آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Mac deckt diese Festplatte bereits ab. Wählen Sie einen Ordner auf einem anderen Laufwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This Mac already covers that disk. Choose a folder on a different drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac ya cubre ese disco. Elige una carpeta de otra unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce Mac couvre déjà ce disque. Choisissez un dossier sur un autre disque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ה-Mac הזה כבר מכסה את הדיסק הזה. בחר תיקייה בכונן אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह Mac पहले से उस डिस्क को कवर करता है। किसी दूसरी ड्राइव पर कोई फ़ोल्डर चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ini sudah mencakup disk tersebut. Pilih folder di drive yang berbeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo Mac copre già quel disco. Scegli una cartella su un'altra unità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのディスクは、このMacですでにカバーされています。別のドライブのフォルダを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac이 이미 해당 디스크를 포함하고 있습니다. 다른 드라이브의 폴더를 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze Mac dekt die schijf al. Kies een map op een andere schijf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten Mac już obejmuje ten dysk. Wybierz folder na innym dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este Mac já cobre esse disco. Escolha uma pasta em outra unidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этот Mac уже включает этот диск. Выберите папку на другом диске."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här Macen omfattar redan den disken. Välj en mapp på en annan enhet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac o diski zaten kapsıyor. Farklı bir sürücüdeki bir klasör seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей Mac уже охоплює цей диск. Виберіть папку на іншому диску."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy Mac này đã bao gồm ổ đĩa đó. Hãy chọn thư mục trên một ổ đĩa khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 Mac 已经涵盖该磁盘。请选择另一个驱动器上的文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這部 Mac 已涵蓋該磁碟。請選擇另一個磁碟機上的資料夾。"
          }
        }
      }
    },
