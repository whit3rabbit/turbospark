        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID \u092f\u093e Mac \u0932\u0949\u0917\u093f\u0928 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
