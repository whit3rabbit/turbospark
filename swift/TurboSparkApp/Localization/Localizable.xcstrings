            "state": "translated",
            "value": "Bilinen sa\u011flay\u0131c\u0131 klas\u00f6r\u00fc bulunamad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043e\u043c\u0438\u0445 \u043f\u0430\u043f\u043e\u043a \u043f\u043e\u0441\u0442\u0430\u0447\u0430\u043b\u044c\u043d\u0438\u043a\u0456\u0432 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y th\u01b0 m\u1ee5c nh\u00e0 cung c\u1ea5p \u0111\u00e3 bi\u1ebft n\u00e0o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u627e\u5230\u5df2\u77e5\u63d0\u4f9b\u5546\u6587\u4ef6\u5939\u3002"
          }
