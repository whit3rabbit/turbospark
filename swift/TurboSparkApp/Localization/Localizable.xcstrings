          }
        }
      }
    },
    "The key is used until the app quits and is not saved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم المفتاح حتى إغلاق التطبيق ولا يُحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schlüssel gilt, bis die App beendet wird, und wird nicht gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is used until the app quits and is not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave se usa hasta que se cierra la app y no se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé est utilisée jusqu'à la fermeture de l'app et n'est pas enregistrée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתח בשימוש עד שהאפליקציה נסגרת ואינו נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजी ऐप बंद होने तक उपयोग में रहती है और सहेजी नहीं जाती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci dipakai sampai app ditutup dan tidak disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave viene usata finché l'app non si chiude e non viene salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはアプリを終了するまで使用され、保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키는 앱을 종료할 때까지 사용되며 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sleutel wordt gebruikt tot de app stopt en wordt niet opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucz jest używany do zamknięcia aplikacji i nie jest zapisywany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave é usada até o app ser encerrado e não é salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ используется до закрытия приложения и не сохраняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyckeln används tills appen avslutas och sparas inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar uygulama kapanana kadar kullanılır ve kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключ використовується до закриття застосунку і не зберігається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa được dùng cho đến khi ứng dụng thoát và không được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "密钥在应用退出前一直有效，且不会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "金鑰在 App 結束前一直有效，且不會儲存。"
          }
        }
      }
    },
    "The library information on that drive could not be read or written.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّرت قراءة معلومات المكتبة على محرك الأقراص هذا أو كتابتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
