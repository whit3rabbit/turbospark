        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ SOUL.md \u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f SOUL.md \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
