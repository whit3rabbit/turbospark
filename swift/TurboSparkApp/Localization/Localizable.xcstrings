    "Requests go to the TypeSafe service, not the TurboSpark server.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل الطلبات إلى خدمة TypeSafe، وليس إلى خادم TurboSpark."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen gehen an den TypeSafe-Dienst, nicht an den TurboSpark-Server."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests go to the TypeSafe service, not the TurboSpark server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes van al servicio TypeSafe, no al servidor de TurboSpark."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes vont au service TypeSafe, pas au serveur TurboSpark."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבקשות נשלחות לשירות TypeSafe, לא לשרת TurboSpark."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध TypeSafe सेवा को जाते हैं, TurboSpark सर्वर को नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan dikirim ke layanan TypeSafe, bukan ke server TurboSpark."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste vanno al servizio TypeSafe, non al server TurboSpark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストは TurboSpark サーバーではなく TypeSafe サービスに送られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청은 TurboSpark 서버가 아닌 TypeSafe 서비스로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoeken gaan naar de TypeSafe-service, niet naar de TurboSpark-server."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądania trafiają do usługi TypeSafe, a nie do serwera TurboSpark."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações vão para o serviço TypeSafe, não para o servidor TurboSpark."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы идут в службу TypeSafe, а не на сервер TurboSpark."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förfrågningar går till TypeSafe-tjänsten, inte till TurboSpark-servern."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstekler TurboSpark sunucusuna değil, TypeSafe hizmetine gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запити надходять до служби TypeSafe, а не на сервер TurboSpark."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu được gửi đến dịch vụ TypeSafe, không phải máy chủ TurboSpark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求发送到 TypeSafe 服务，而不是 TurboSpark 服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求會傳送到 TypeSafe 服務，而非 TurboSpark 伺服器。"
          }
        }
      }
    },
    "Requests must send this key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن ترسل الطلبات هذا المفتاح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anfragen müssen diesen Schlüssel senden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requests must send this key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las solicitudes deben enviar esta clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les requêtes doivent envoyer cette clé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשות חייבות לשלוח את המפתח הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोधों को यह कुंजी भेजनी होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan harus mengirim kunci ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le richieste devono inviare questa chiave."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストにはこのキーが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청 시 이 키를 보내야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzoeken moeten deze sleutel meesturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądania muszą wysyłać ten klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As solicitações precisam enviar esta chave."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запросы должны передавать этот ключ."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förfrågningar måste skicka den här nyckeln."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstekler bu anahtarı göndermelidir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запити мають передавати цей ключ."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu phải gửi khóa này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请求必须发送此密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請求必須傳送此金鑰。"
          }
        }
      }
    },
    "Require AutoFit to provide at least this many tokens of context. Models that cannot meet this minimum will fail to load. An explicitly chosen context length is not affected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب AutoFit لتوفير هذا العدد على الأقل من رموز السياق. النماذج التي لا تلبي هذا الحد الأدنى ستفشل في التحميل. لا يتأثر طول السياق المختار صراحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfordert, dass AutoFit mindestens so viele Kontext-Token bereitstellt. Modelle, die dieses Minimum nicht erreichen können, können nicht geladen werden. Eine explizit gewählte Kontextlänge ist davon nicht betroffen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Require AutoFit to provide at least this many tokens of context. Models that cannot meet this minimum will fail to load. An explicitly chosen context length is not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige que AutoFit proporcione al menos esta cantidad de tokens de contexto. Los modelos que no alcancen este mínimo no se cargarán. Una longitud de contexto elegida explícitamente no se ve afectada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige qu'AutoFit fournisse au moins ce nombre de jetons de contexte. Les modèles qui ne peuvent pas atteindre ce minimum ne se chargeront pas. Une longueur de contexte explicitement choisie n'est pas affectée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דרוש מ-AutoFit לספק לפחות מספר זה של אסימוני הקשר. מודלים שאינם יכולים לעמוד במינימום זה ייכשלו בטעינה. אורך הקשר שנבחר במפורש אינו מושפע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoFit को संदर्भ के कम से कम इतने टोकन प्रदान करने की आवश्यकता है। जो मॉडल इस न्यूनतम को पूरा नहीं कर सकते वे लोड होने में विफल रहेंगे। स्पष्ट रूप से चुनी गई संदर्भ लंबाई प्रभावित नहीं होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wajibkan AutoFit untuk menyediakan setidaknya token konteks sebanyak ini. Model yang tidak dapat memenuhi batas minimum ini akan gagal dimuat. Panjang konteks yang dipilih secara eksplisit tidak terpengaruh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede che AutoFit fornisca almeno questo numero di token di contesto. I modelli che non soddisfano questo minimo non verranno caricati. Una lunghezza di contesto scelta esplicitamente non è interessata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoFit が少なくともこのトークン数のコンテキストを提供することを要求します。この最小値を満たせないモデルは読み込みに失敗します。明示的に選択されたコンテキスト長は影響を受けません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoFit이 최소 이만큼의 컨텍스트 토큰을 제공하도록 요구합니다. 이 최소값을 충족할 수 없는 모델은 로드되지 않습니다. 명시적으로 선택한 컨텍스트 길이는 영향을 받지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist dat AutoFit ten minste zoveel contexttokens levert. Modellen die niet aan dit minimum kunnen voldoen, kunnen niet worden geladen. Een expliciet gekozen contextlengte wordt niet beïnvloed."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagaj, aby AutoFit zapewnił co najmniej tyle tokenów kontekstu. Modele, które nie spełniają tego minimum, nie załadują się. Wybrana jawnie długość kontekstu pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exige que o AutoFit forneça pelo menos este número de tokens de contexto. Os modelos que não atingirem esse mínimo falharão ao carregar. Uma extensão de contexto escolhida explicitamente não é afetada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требовать, чтобы AutoFit предоставлял как минимум столько токенов контекста. Модели, не соответствующие этому минимуму, не смогут загрузиться. Явно заданный размер контекста не затрагивается."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräv att AutoFit tillhandahåller minst så här många sammanhangstokens. Modeller som inte uppfyller detta minimum kan inte laddas. En uttryckligen vald kontextlängd påverkas inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "AutoFit'in en az bu kadar bağlam belirteci sağlamasını zorunlu kılın. Bu minimumu karşılayamayan modeller yüklenemez. Açıkça seçilen bir bağlam uzunluğu etkilenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимагати, щоб AutoFit надавав принаймні стільки токенів контексту. Моделі, які не відповідають цьому мінімуму, не зможуть завантажитися. Явно обрана довжина контексту не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu AutoFit cung cấp ít nhất số mã thông báo ngữ cảnh này. Các mô hình không đáp ứng mức tối thiểu này sẽ không tải được. Độ dài ngữ cảnh được chọn rõ ràng không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "要求 AutoFit 至少提供指定数量的上下文标记。无法满足此最低要求的模型将无法加载。显式选择的上下文长度不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "要求 AutoFit 至少提供指定數量的上下文標記。無法滿足此最低要求的模型將無法載入。顯式選擇的上下文長度不受影響。"
          }
        }
      }
    },
    "Required on every route except /health, as x-api-key or a Bearer token.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مطلوب في كل المسارات باستثناء ‎/health، بصيغة x-api-key أو رمز Bearer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jeder Route außer /health erforderlich, als x-api-key oder Bearer-Token."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required on every route except /health, as x-api-key or a Bearer token."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatoria en todas las rutas excepto /health, como x-api-key o token Bearer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requise sur toutes les routes sauf /health, en x-api-key ou jeton Bearer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדרש בכל נתיב מלבד ‎/health, כ-x-api-key או כאסימון Bearer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "/health को छोड़कर हर रूट पर x-api-key या Bearer टोकन के रूप में आवश्यक।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wajib di setiap rute kecuali /health, sebagai x-api-key atau token Bearer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obbligatoria su ogni route tranne /health, come x-api-key o token Bearer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/health を除くすべてのルートで、x-api-key または Bearer トークンとして必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/health를 제외한 모든 경로에서 x-api-key 또는 Bearer 토큰으로 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist op elke route behalve /health, als x-api-key of Bearer-token."
          }
        },
        "pl": {
