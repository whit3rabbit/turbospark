        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0926\u0932\u093e\u0935 \u0930\u0902\u0917\u094b\u0902 \u092f\u093e +/- \u092e\u093e\u0930\u094d\u0915\u0930 \u0938\u0947 \u0926\u093f\u0916\u093e\u090f\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan perubahan dengan warna atau penanda +/-"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra le modifiche con colori o indicatori +/-"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5909\u66f4\u3092\u8272\u307e\u305f\u306f +/- \u30de\u30fc\u30ab\u30fc\u3067\u8868\u793a"
