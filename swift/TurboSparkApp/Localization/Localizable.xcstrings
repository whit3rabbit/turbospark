            "value": "Messages, met tools, denken en afbeeldingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages z narz\u0119dziami, my\u015bleniem i obrazami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, com ferramentas, racioc\u00ednio e imagens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages \u0441 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438, \u0440\u0430\u0437\u043c\u044b\u0448\u043b\u0435\u043d\u0438\u044f\u043c\u0438 \u0438 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f\u043c\u0438."
