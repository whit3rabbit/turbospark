    "%@ may still list this model. The model works from its new place.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد تظل %@ تعرض هذا النموذج في قائمتها. يعمل النموذج من مكانه الجديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ führt dieses Modell möglicherweise noch in der Liste. Das Modell funktioniert an seinem neuen Ort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ may still list this model. The model works from its new place."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede que %@ siga mostrando este modelo en su lista. El modelo funciona desde su nueva ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ peut encore lister ce modèle. Le modèle fonctionne depuis son nouvel emplacement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן ש-%@ עדיין מציגה את המודל הזה ברשימה שלה. המודל פועל מהמיקום החדש שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की सूची में यह मॉडल अब भी दिख सकता है। मॉडल अपने नए स्थान से काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mungkin masih mencantumkan model ini. Model berfungsi dari lokasi barunya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ potrebbe elencare ancora questo modello. Il modello funziona dalla sua nuova posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ の一覧にこのモデルが残っている場合があります。モデルは新しい場所から問題なく使えます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 목록에 이 모델이 아직 남아 있을 수 있습니다. 모델은 새 위치에서 정상적으로 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vermeldt dit model mogelijk nog. Het model werkt vanaf de nieuwe locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ może nadal wyświetlać ten model na swojej liście. Model działa z nowej lokalizacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ainda pode listar este modelo. O modelo funciona a partir do novo local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ может по-прежнему показывать эту модель в списке. Модель работает из нового места."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kan fortfarande lista den här modellen. Modellen fungerar från sin nya plats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bu modeli hâlâ listeleyebilir. Model yeni konumundan çalışır."
