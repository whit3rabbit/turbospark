      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062b\u0628\u0651\u062a \u0627\u0644\u062e\u0648\u0627\u062f\u0645 \u0645\u0646 \u0643\u062a\u0627\u0644\u0648\u062c \u0645\u0646\u0634\u0648\u0631 \u0641\u064a \u0645\u0633\u062a\u0648\u062f\u0639 Git \u0623\u0648 \u0645\u062c\u0644\u062f \u0645\u062d\u0644\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie Server aus einem Katalog, der in einem Git-Repository oder einem lokalen Ordner ver\u00f6ffentlicht ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install servers from a catalog published in a Git repository or a local folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala servidores desde un cat\u00e1logo publicado en un repositorio de Git o en una carpeta local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez des serveurs depuis un catalogue publi\u00e9 dans un d\u00e9p\u00f4t Git ou un dossier local."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05e7\u05df \u05e9\u05e8\u05ea\u05d9\u05dd \u05de\u05e7\u05d8\u05dc\u05d5\u05d2 \u05e9\u05e4\u05d5\u05e8\u05e1\u05dd \u05d1\u05de\u05d0\u05d2\u05e8 Git \u05d0\u05d5 \u05d1\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05de\u05e7\u05d5\u05de\u05d9\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git \u0930\u093f\u092a\u0949\u091c\u093f\u091f\u0930\u0940 \u092f\u093e \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u092e\u0947\u0902 \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0948\u091f\u0932\u0949\u0917 \u0938\u0947 \u0938\u0930\u094d\u0935\u0930 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang server dari katalog yang diterbitkan di repositori Git atau folder lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa server da un catalogo pubblicato in un repository Git o in una cartella locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git \u30ea\u30dd\u30b8\u30c8\u30ea\u307e\u305f\u306f\u30ed\u30fc\u30ab\u30eb\u30d5\u30a9\u30eb\u30c0\u306b\u516c\u958b\u3055\u308c\u305f\u30ab\u30bf\u30ed\u30b0\u304b\u3089\u30b5\u30fc\u30d0\u30fc\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git \ub9ac\ud3ec\uc9c0\ud1a0\ub9ac\ub098 \ub85c\uceec \ud3f4\ub354\uc5d0 \uac8c\uc2dc\ub41c \uce74\ud0c8\ub85c\uadf8\uc5d0\uc11c \uc11c\ubc84\ub97c \uc124\uce58\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer servers vanuit een catalogus die is gepubliceerd in een Git-repository of een lokale map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluj serwery z katalogu opublikowanego w repozytorium Git lub w folderze lokalnym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale servidores a partir de um cat\u00e1logo publicado em um reposit\u00f3rio Git ou em uma pasta local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0439\u0442\u0435 \u0441\u0435\u0440\u0432\u0435\u0440\u044b \u0438\u0437 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0430, \u043e\u043f\u0443\u0431\u043b\u0438\u043a\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u0432 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0438 Git \u0438\u043b\u0438 \u0432 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u043f\u0430\u043f\u043a\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera servrar fr\u00e5n en katalog som publicerats i en Git-utvecklingskatalog eller en lokal mapp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Git deposunda veya yerel klas\u00f6rde yay\u0131mlanm\u0131\u015f bir katalogdan sunucu kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0439\u0442\u0435 \u0441\u0435\u0440\u0432\u0435\u0440\u0438 \u0437 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0443, \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u0432 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0456\u0457 Git \u0430\u0431\u043e \u0432 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0456\u0439 \u043f\u0430\u043f\u0446\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e0i \u0111\u1eb7t m\u00e1y ch\u1ee7 t\u1eeb danh m\u1ee5c \u0111\u01b0\u1ee3c c\u00f4ng b\u1ed1 trong kho Git ho\u1eb7c th\u01b0 m\u1ee5c c\u1ee5c b\u1ed9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u53d1\u5e03\u5728 Git \u4ed3\u5e93\u6216\u672c\u5730\u6587\u4ef6\u5939\u4e2d\u7684\u76ee\u5f55\u5b89\u88c5\u670d\u52a1\u5668\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u767c\u5e03\u5728 Git \u5132\u5b58\u5eab\u6216\u672c\u6a5f\u8cc7\u6599\u593e\u4e2d\u7684\u76ee\u9304\u5b89\u88dd\u4f3a\u670d\u5668\u3002"
          }
        }
      }
    },
