        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar tersimpan Anda muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini salvate appaiono qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u5b58\u3057\u305f\u753b\u50cf\u306f\u3053\u3053\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002"
