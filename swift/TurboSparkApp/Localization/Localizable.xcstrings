    "Open a project to write a project-scoped agent.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0641\u062a\u062d \u0645\u0634\u0631\u0648\u0639\u0627 \u0644\u0643\u062a\u0627\u0628\u0629 \u0648\u0643\u064a\u0644 \u0628\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0634\u0631\u0648\u0639."
