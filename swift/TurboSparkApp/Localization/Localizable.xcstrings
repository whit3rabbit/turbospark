        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435 \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u043d\u0435 \u043e\u0433\u043e\u043b\u043e\u0448\u0443\u0454 \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0443\u0432\u0430\u043d\u0438\u0445 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0456\u0432."
