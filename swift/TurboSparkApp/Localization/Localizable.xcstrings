            "value": "Conserve les couleurs actuelles comme Personnalis\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d5\u05de\u05e8 \u05d0\u05ea \u05d4\u05e6\u05d1\u05e2\u05d9\u05dd \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05d9\u05dd \u05db\u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd \u05d0\u05d9\u05e9\u05d9\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u094c\u091c\u0942\u0926\u093e \u0930\u0902\u0917\u094b\u0902 \u0915\u094b \u0915\u0938\u094d\u091f\u092e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0930\u0916\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyimpan warna saat ini sebagai Kustom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene i colori attuali come Personalizzato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u306e\u8272\u3092\u30ab\u30b9\u30bf\u30e0\u3068\u3057\u3066\u6b8b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud604\uc7ac \uc0c9\uc0c1\uc744 \uc0ac\uc6a9\uc790 \uc9c0\uc815\uc73c\ub85c \uc720\uc9c0\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Behoudt de huidige kleuren als Aangepast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowuje bie\u017c\u0105ce kolory jako Niestandardowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mant\u00e9m as cores atuais como Personalizado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043a\u0443\u0449\u0438\u0435 \u0446\u0432\u0435\u0442\u0430 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f \u043a\u0430\u043a \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c\u0441\u043a\u0430\u044f \u0442\u0435\u043c\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beh\u00e5ller de aktuella f\u00e4rgerna som Anpassat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7erli renkleri \u00d6zel olarak korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0442\u043e\u0447\u043d\u0456 \u043a\u043e\u043b\u044c\u043e\u0440\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u044f\u043a \u0432\u043b\u0430\u0441\u043d\u0430 \u0442\u0435\u043c\u0430."
