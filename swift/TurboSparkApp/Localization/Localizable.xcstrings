        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u091a\u0948\u091f \u0938\u0902\u0917\u094d\u0930\u0939\u093f\u0924 \u0915\u0930\u0947\u0902 (\u092f\u093e \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f /unarchive)"
