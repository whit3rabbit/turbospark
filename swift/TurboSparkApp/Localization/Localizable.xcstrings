        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez \u00e0 un autre profil avant de supprimer celui-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d1\u05d5\u05e8 \u05dc\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d0\u05d7\u05e8 \u05dc\u05e4\u05e0\u05d9 \u05de\u05d7\u05d9\u05e7\u05ea \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938\u0947 \u0939\u091f\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u093f\u0938\u0940 \u0926\u0942\u0938\u0930\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralihlah ke profil lain sebelum menghapus profil ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa a un altro profilo prima di eliminare questo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3092\u524a\u9664\u3059\u308b\u524d\u306b\u3001\u5225\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u5207\u308a\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub85c\ud544\uc744 \uc0ad\uc81c\ud558\uae30 \uc804\uc5d0 \ub2e4\ub978 \ud504\ub85c\ud544\ub85c \uc804\ud658\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel over naar een ander profiel voordat je dit profiel verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prze\u0142\u0105cz si\u0119 na inny profil przed usuni\u0119ciem tego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mude para outro perfil antes de excluir este."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u0441\u044c \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0443\u0434\u0430\u043b\u044f\u0442\u044c \u044d\u0442\u043e\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt till en annan profil innan du tar bort den h\u00e4r."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profili silmeden \u00f6nce ba\u015fka bir profile ge\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u043d\u0430 \u0456\u043d\u0448\u0438\u0439 \u043f\u0440\u043e\u0444\u0456\u043b\u044c, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u0432\u0438\u0434\u0430\u043b\u044f\u0442\u0438 \u0446\u0435\u0439."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y chuy\u1ec3n sang h\u1ed3 s\u01a1 kh\u00e1c tr\u01b0\u1edbc khi x\u00f3a h\u1ed3 s\u01a1 n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u5207\u6362\u5230\u5176\u4ed6\u914d\u7f6e\u6863\u6848\uff0c\u518d\u5220\u9664\u6b64\u914d\u7f6e\u6863\u6848\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u5207\u63db\u81f3\u5176\u4ed6\u8a2d\u5b9a\u6a94\uff0c\u518d\u522a\u9664\u6b64\u8a2d\u5b9a\u6a94\u3002"
          }
        }
      }
