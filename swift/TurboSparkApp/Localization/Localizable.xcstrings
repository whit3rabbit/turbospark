          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मूल लाइब्रेरी की सूची में यह मॉडल अब भी दिख सकता है। मॉडल अपने नए स्थान से काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
