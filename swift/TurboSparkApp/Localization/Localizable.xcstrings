        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c \u0438\u043b\u0438 \u043e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u044e\u0449\u0443\u044e \u043f\u0430\u043f\u043a\u0443 \u043c\u043e\u0434\u0435\u043b\u0435\u0439, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0447\u0430\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera en modell eller \u00f6ppna en befintlig modellmapp f\u00f6r att forts\u00e4tta den h\u00e4r chatten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbete devam etmek i\u00e7in bir model y\u00fckleyin veya mevcut bir model klas\u00f6r\u00fcn\u00fc a\u00e7\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c \u0430\u0431\u043e \u0432\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u043d\u0430\u044f\u0432\u043d\u0443 \u043f\u0430\u043f\u043a\u0443 \u043c\u043e\u0434\u0435\u043b\u0435\u0439, \u0449\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438 \u0446\u0435\u0439 \u0447\u0430\u0442."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y c\u00e0i \u0111\u1eb7t m\u1ed9t m\u00f4 h\u00ecnh ho\u1eb7c m\u1edf th\u01b0 m\u1ee5c m\u00f4 h\u00ecnh hi\u1ec7n c\u00f3 \u0111\u1ec3 ti\u1ebfp t\u1ee5c cu\u1ed9c tr\u00f2 chuy\u1ec7n n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b89\u88c5\u6a21\u578b\u6216\u6253\u5f00\u73b0\u6709\u6a21\u578b\u6587\u4ef6\u5939\u4ee5\u7ee7\u7eed\u6b64\u5bf9\u8bdd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b89\u88dd\u6a21\u578b\u6216\u958b\u555f\u73fe\u6709\u6a21\u578b\u8cc7\u6599\u593e\u4ee5\u7e7c\u7e8c\u6b64\u5c0d\u8a71\u3002"
          }
        }
      }
    },
    "Confirm you have the right to use this voice.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm you have the right to use this voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que tienes derecho a usar esta voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmez que vous avez le droit d'utiliser cette voix."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Best\u00e4tigen Sie, dass Sie diese Stimme verwenden d\u00fcrfen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferma di avere il diritto di usare questa voce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme que voc\u00ea tem o direito de usar esta voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435, \u0447\u0442\u043e \u0432\u044b \u0432\u043f\u0440\u0430\u0432\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u044d\u0442\u043e\u0442 \u0433\u043e\u043b\u043e\u0441."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u58f0\u3092\u4f7f\u7528\u3059\u308b\u6a29\u5229\u304c\u3042\u308b\u3053\u3068\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc74c\uc131\uc744 \uc0ac\uc6a9\ud560 \uad8c\ub9ac\uac00 \uc788\ub294\uc9c0 \ud655\uc778\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u786e\u8ba4\u4f60\u6709\u6743\u4f7f\u7528\u8fd9\u4e2a\u58f0\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u78ba\u8a8d\u4f60\u6709\u6b0a\u4f7f\u7528\u9019\u500b\u8072\u97f3\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0643\u0651\u062f \u0623\u0646 \u0644\u062f\u064a\u0643 \u0627\u0644\u062d\u0642 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u0635\u0648\u062a."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05e9\u05e8 \u05e9\u05d9\u05e9 \u05dc\u05da \u05d6\u05db\u05d5\u05ea \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e7\u05d5\u05dc \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902 \u0915\u093f \u0906\u092a\u0915\u094b \u0907\u0938 \u0906\u0935\u093e\u091c\u093c \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0939\u0948\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bevestig dat je het recht hebt om deze stem te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierd\u017a, \u017ce masz prawo u\u017cywa\u0107 tego g\u0142osu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sesi kullanma hakk\u0131n\u0131z oldu\u011funu onaylay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u044c\u0442\u0435, \u0449\u043e \u0432\u0438 \u043c\u0430\u0454\u0442\u0435 \u043f\u0440\u0430\u0432\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0446\u0435\u0439 \u0433\u043e\u043b\u043e\u0441."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekr\u00e4fta att du har r\u00e4tt att anv\u00e4nda den h\u00e4r r\u00f6sten."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y x\u00e1c nh\u1eadn b\u1ea1n c\u00f3 quy\u1ec1n s\u1eed d\u1ee5ng gi\u1ecdng n\u00f3i n\u00e0y."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfirmasikan bahwa Anda berhak menggunakan suara ini."
          }
        }
      }
    },
