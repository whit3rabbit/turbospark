          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt mô hình cục bộ từ danh mục tuyển chọn hoặc từ Hugging Face."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang model secara lokal dari katalog kurasi atau Hugging Face."
          }
        }
      }
    },
    "Install servers from a catalog published in a Git repository or a local folder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install servers from a catalog published in a Git repository or a local folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala servidores desde un catálogo publicado en un repositorio de Git o en una carpeta local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez des serveurs depuis un catalogue publié dans un dépôt Git ou un dossier local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie Server aus einem Katalog, der in einem Git-Repository oder einem lokalen Ordner veröffentlicht ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa server da un catalogo pubblicato in un repository Git o in una cartella locale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale servidores a partir de um catálogo publicado em um repositório Git ou em uma pasta local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливайте серверы из каталога, опубликованного в репозитории Git или в локальной папке."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git リポジトリまたはローカルフォルダに公開されたカタログからサーバーをインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 리포지토리나 로컬 폴더에 게시된 카탈로그에서 서버를 설치합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从发布在 Git 仓库或本地文件夹中的目录安装服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從發布在 Git 儲存庫或本機資料夾中的目錄安裝伺服器。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت الخوادم من كتالوج منشور في مستودع Git أو مجلد محلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקן שרתים מקטלוג שפורסם במאגר Git או בתיקייה מקומית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git रिपॉजिटरी या स्थानीय फ़ोल्डर में प्रकाशित कैटलॉग से सर्वर इंस्टॉल करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer servers vanuit een catalogus die is gepubliceerd in een Git-repository of een lokale map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluj serwery z katalogu opublikowanego w repozytorium Git lub w folderze lokalnym."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
