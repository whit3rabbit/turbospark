        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094c\u0936\u0932 '%@' \u0915\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u0939\u0940\u0902 \u091a\u0932\u093e\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keterampilan '%@' tidak dapat dipanggil oleh pengguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La competenza '%@' non pu\u00f2 essere invocata dall'utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30ad\u30eb'%@'\u306f\u30e6\u30fc\u30b6\u30fc\u304c\u547c\u3073\u51fa\u3059\u3053\u3068\u306f\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\ud0ac '%@'\uc740(\ub294) \uc0ac\uc6a9\uc790\uac00 \ud638\ucd9c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaardigheid '%@' kan niet door de gebruiker worden aangeroepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umiej\u0119tno\u015bci '%@' nie mo\u017ce wywo\u0142a\u0107 u\u017cytkownik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A habilidade '%@' n\u00e3o pode ser invocada pelo usu\u00e1rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0432\u044b\u043a '%@' \u043d\u0435\u043b\u044c\u0437\u044f \u0432\u044b\u0437\u0432\u0430\u0442\u044c \u0432\u0440\u0443\u0447\u043d\u0443\u044e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00e4rdigheten '%@' kan inte anropas av anv\u00e4ndaren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' becerisi kullan\u0131c\u0131 taraf\u0131ndan \u00e7a\u011fr\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0432\u0438\u0447\u043a\u0443 '%@' \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u043a\u043b\u0438\u043a\u0430\u0442\u0438 \u0432\u0440\u0443\u0447\u043d\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ng\u01b0\u1eddi d\u00f9ng kh\u00f4ng th\u1ec3 g\u1ecdi k\u1ef9 n\u0103ng '%@'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6280\u80fd'%@'\u4e0d\u53ef\u7531\u7528\u6237\u8c03\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6280\u80fd'%@'\u7121\u6cd5\u7531\u4f7f\u7528\u8005\u547c\u53eb\u3002"
          }
        }
      }
    },
    "Stop the current turn before clearing.": {
