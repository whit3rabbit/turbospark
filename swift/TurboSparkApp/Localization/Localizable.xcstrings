        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` arac\u0131n\u0131n ba\u011f\u0131ms\u0131z de\u011fi\u015fken \u015femas\u0131 %@ konumunda desteklenmiyor."
