    "Loaded %@. Reasoning %@ is not available here, using %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u062a\u062d\u0645\u064a\u0644 %@. \u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u0627\u0633\u062a\u062f\u0644\u0627\u0644 %@ \u063a\u064a\u0631 \u0645\u062a\u0627\u062d \u0647\u0646\u0627\u060c \u0633\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geladen. Denkniveau %@ ist hier nicht verf\u00fcgbar, %@ wird verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loaded %@. Reasoning %@ is not available here, using %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se carg\u00f3 %@. El razonamiento %@ no est\u00e1 disponible aqu\u00ed; se usar\u00e1 %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ charg\u00e9. Le raisonnement %@ n'est pas disponible ici, utilisation de %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u05e0\u05d8\u05e2\u05df. \u05e8\u05de\u05ea \u05d4\u05d7\u05e9\u05d9\u05d1\u05d4 %@ \u05d0\u05d9\u05e0\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4 \u05db\u05d0\u05df, \u05e0\u05e2\u05e9\u05d4 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1-%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964 \u0924\u0930\u094d\u0915 \u0938\u094d\u0924\u0930 %@ \u092f\u0939\u093e\u0902 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948, %@ \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dimuat. Penalaran %@ tidak tersedia di sini, menggunakan %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ caricato. Il ragionamento %@ non \u00e8 disponibile qui, verr\u00e0 usato %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u3092\u8aad\u307f\u8fbc\u307f\u307e\u3057\u305f\u3002\u63a8\u8ad6\u30ec\u30d9\u30eb %@ \u306f\u3053\u3053\u3067\u306f\u4f7f\u7528\u3067\u304d\u306a\u3044\u305f\u3081\u3001%@ \u3092\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uc744(\ub97c) \ub85c\ub4dc\ud588\uc2b5\ub2c8\ub2e4. \ucd94\ub860 \uc218\uc900 %@\uc740(\ub294) \uc5ec\uae30\uc11c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc5b4 %@\uc744(\ub97c) \uc0ac\uc6a9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ geladen. Redeneerniveau %@ is hier niet beschikbaar, %@ wordt gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytano %@. Poziom rozumowania %@ nie jest tu dost\u0119pny, u\u017cywany jest %@."
