    "Experimental. Runs partly on the GPU, or only on the CPU.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Runs partly on the GPU, or only on the CPU."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Se ejecuta en parte en la GPU o solo en la CPU."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Expérimental. S'exécute en partie sur le GPU, ou uniquement sur le CPU."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentell. Läuft teilweise auf der GPU oder nur auf der CPU."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sperimentale. Viene eseguito in parte sulla GPU o solo sulla CPU."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimental. Executa em parte na GPU ou somente na CPU."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimenteel. Draait deels op de GPU, of alleen op de CPU."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Experimentellt. Körs delvis på GPU:n, eller endast på CPU:n."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperymentalne. Działa częściowo na GPU albo tylko na CPU."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneysel. Kısmen GPU üzerinde ya da yalnızca CPU üzerinde çalışır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperimental. Berjalan sebagian di GPU, atau hanya di CPU."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Экспериментально. Работает частично на GPU или только на CPU."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Експериментально. Працює частково на GPU або лише на CPU."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thử nghiệm. Chạy một phần trên GPU, hoặc chỉ trên CPU."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実験的。一部を GPU で、または CPU のみで実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실험적. 일부는 GPU에서, 또는 CPU에서만 실행됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实验性。部分在 GPU 上运行，或仅在 CPU 上运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "實驗性。部分在 GPU 上執行，或僅在 CPU 上執行。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجريبي. يعمل جزئيًا على GPU، أو على CPU فقط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניסיוני. פועל חלקית על ה-GPU, או על ה-CPU בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रयोगात्मक। कुछ हद तक GPU पर, या केवल CPU पर चलता है।"
          }
        }
      }
    },
