    "Stop generation and unload the current model before moving the store.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0648\u0642\u0641 \u0627\u0644\u062a\u0648\u0644\u064a\u062f \u0648\u0642\u0645 \u0628\u0625\u0644\u063a\u0627\u0621 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062d\u0627\u0644\u064a \u0642\u0628\u0644 \u0646\u0642\u0644 \u0627\u0644\u0645\u062a\u062c\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie die Generierung und entladen Sie das aktuelle Modell, bevor Sie den Speicher verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop generation and unload the current model before moving the store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Det\u00e9n la generaci\u00f3n y descarga el modelo actual antes de mover el almac\u00e9n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eatez la g\u00e9n\u00e9ration et d\u00e9chargez le mod\u00e8le actuel avant de d\u00e9placer le magasin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05e6\u05d5\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e6\u05d9\u05e8\u05d4 \u05d5\u05d1\u05d8\u05dc \u05d0\u05ea \u05d8\u05e2\u05d9\u05e0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e0\u05d5\u05db\u05d7\u05d9 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e2\u05d1\u05e8\u05ea \u05d4\u05de\u05d0\u05d2\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u091f\u094b\u0930 \u0915\u094b \u0938\u094d\u0925\u093e\u0928\u093e\u0902\u0924\u0930\u093f\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092a\u0940\u0922\u093c\u0940 \u0915\u094b \u0930\u094b\u0915\u0947\u0902 \u0914\u0930 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0949\u0921\u0932 \u0915\u094b \u0905\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan pembuatan dan bongkar model saat ini sebelum memindahkan penyimpanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi la generazione e scarica il modello corrente prima di spostare l'archivio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c8\u30a2\u3092\u79fb\u52d5\u3059\u308b\u524d\u306b\u3001\u751f\u6210\u3092\u505c\u6b62\u3057\u3066\u73fe\u5728\u306e\u30e2\u30c7\u30eb\u3092\u30a2\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\uc18c\ub97c \uc774\ub3d9\ud558\uae30 \uc804\uc5d0 \uc0dd\uc131\uc744 \uc911\uc9c0\ud558\uace0 \ud604\uc7ac \ubaa8\ub378\uc744 \uc5b8\ub85c\ub4dc\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop het genereren en ontlaad het huidige model voordat u de opslag verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj generowanie i wy\u0142aduj bie\u017c\u0105cy model przed przeniesieniem magazynu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare a gera\u00e7\u00e3o e descarregue o modelo atual antes de mover o armazenamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044e \u0438 \u0432\u044b\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u0442\u0435\u043a\u0443\u0449\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u0435\u0440\u0435\u0434 \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0435\u043d\u0438\u0435\u043c \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa genereringen och l\u00e4s ur den aktuella modellen innan du flyttar lagringen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depoyu ta\u015f\u0131madan \u00f6nce \u00fcretimi durdurun ve mevcut modeli kald\u0131r\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u044e \u0442\u0430 \u0432\u0438\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043f\u043e\u0442\u043e\u0447\u043d\u0443 \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u0435\u0440\u0435\u0434 \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043d\u044f\u043c \u0441\u0445\u043e\u0432\u0438\u0449\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u1eebng t\u1ea1o v\u00e0 d\u1ee1 m\u00f4 h\u00ecnh hi\u1ec7n t\u1ea1i tr\u01b0\u1edbc khi di chuy\u1ec3n kho l\u01b0u tr\u1eef."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79fb\u52a8\u5b58\u50a8\u524d\u8bf7\u5148\u505c\u6b62\u751f\u6210\u5e76\u5378\u8f7d\u5f53\u524d\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u79fb\u52d5\u5b58\u653e\u5340\u524d\u8acb\u5148\u505c\u6b62\u751f\u6210\u4e26\u5378\u8f09\u76ee\u524d\u7684\u6a21\u578b\u3002"
          }
        }
      }
    },
