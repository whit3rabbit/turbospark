    "Recording did not capture audio. Check the source and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording did not capture audio. Check the source and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabaci\u00f3n no captur\u00f3 audio. Comprueba la fuente e int\u00e9ntalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u2019enregistrement n\u2019a captur\u00e9 aucun son. V\u00e9rifiez la source et r\u00e9essayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wurde kein Audio aufgenommen. Pr\u00fcfe die Quelle und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione non ha acquisito audio. Controlla la sorgente e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A grava\u00e7\u00e3o n\u00e3o capturou \u00e1udio. Verifique a fonte e tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname bevat geen audio. Controleer de bron en probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget ljud spelades in. Kontrollera k\u00e4llan och f\u00f6rs\u00f6k igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zarejestrowano d\u017awi\u0119ku. Sprawd\u017a \u017ar\u00f3d\u0142o i spr\u00f3buj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kay\u0131tta ses yakalanmad\u0131. Kayna\u011f\u0131 kontrol edip tekrar deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman tidak menangkap audio. Periksa sumber dan coba lagi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0432\u0443\u043a \u043d\u0435 \u0431\u044b\u043b \u0437\u0430\u043f\u0438\u0441\u0430\u043d. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0432\u0443\u043a \u043d\u0435 \u0431\u0443\u043b\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043e. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u0442\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n ghi kh\u00f4ng thu \u0111\u01b0\u1ee3c \u00e2m thanh. Ki\u1ec3m tra ngu\u1ed3n v\u00e0 th\u1eed l\u1ea1i."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u58f0\u3092\u9332\u97f3\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u97f3\u6e90\u3092\u78ba\u8a8d\u3057\u3066\u3001\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub514\uc624\uac00 \ub179\uc74c\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \uc18c\uc2a4\ub97c \ud655\uc778\ud558\uace0 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u5f55\u5236\u5230\u97f3\u9891\u3002\u8bf7\u68c0\u67e5\u97f3\u6e90\u540e\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u9304\u88fd\u5230\u97f3\u8a0a\u3002\u8acb\u6aa2\u67e5\u97f3\u6e90\u5f8c\u518d\u8a66\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0644\u062a\u0642\u0637 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0623\u064a \u0635\u0648\u062a. \u062a\u062d\u0642\u0642 \u0645\u0646 \u0627\u0644\u0645\u0635\u062f\u0631 \u0648\u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05e7\u05dc\u05d8 \u05e9\u05de\u05e2 \u05d1\u05d4\u05e7\u05dc\u05d8\u05d4. \u05d9\u05e9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d4\u05de\u05e7\u05d5\u05e8 \u05d5\u05dc\u05e0\u05e1\u05d5\u05ea \u05e9\u05d5\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u092e\u0947\u0902 \u0911\u0921\u093f\u092f\u094b \u0915\u0948\u092a\u094d\u091a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906\u0964 \u0938\u094d\u0930\u094b\u0924 \u091c\u093e\u0901\u091a\u0947\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
