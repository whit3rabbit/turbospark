    "Microphone access is not allowed. Open Check devices and permissions on the Record page to allow it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is not allowed. Open Check devices and permissions on the Record page to allow it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso al micrófono no está permitido. Abre Comprobar dispositivos y permisos en la página Grabar para permitirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès au microphone n'est pas autorisé. Ouvrez Vérifier les appareils et les autorisations dans la page Enregistrer pour l'autoriser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mikrofonzugriff ist nicht erlaubt. Öffne „Geräte und Berechtigungen prüfen“ auf der Seite „Aufnehmen“, um ihn zu erlauben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso al microfono non è consentito. Apri Verifica dispositivi e autorizzazioni nella pagina Registra per consentirlo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso ao microfone não está permitido. Abra Verificar dispositivos e permissões na página Gravar para permitir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к микрофону не разрешён. Откройте «Проверить устройства и разрешения» на странице «Записать», чтобы разрешить его."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクへのアクセスが許可されていません。「録音」ページで「デバイスと権限を確認」を開いて許可してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크 접근이 허용되지 않았습니다. 녹음 페이지에서 기기 및 권한 확인을 열어 허용하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未允许访问麦克风。请在“录音”页面打开“检查设备和权限”来允许访问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未允許存取麥克風。請在「錄音」頁面開啟「檢查裝置和權限」以允許存取。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول إلى الميكروفون غير مسموح. افتح التحقق من الأجهزة والأذونات في صفحة تسجيل للسماح به."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה למיקרופון אינה מותרת. יש לפתוח את בדיקת התקנים והרשאות בדף הקלטה כדי לאפשר אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफ़ोन एक्सेस की अनुमति नहीं है। इसकी अनुमति देने के लिए रिकॉर्ड करें पेज पर डिवाइस और अनुमतियाँ जाँचें खोलें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoontoegang is niet toegestaan. Open Apparaten en machtigingen controleren op de pagina Opnemen om dit toe te staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp do mikrofonu nie jest dozwolony. Otwórz Sprawdź urządzenia i uprawnienia na stronie Nagraj, aby na niego zezwolić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon erişimine izin verilmedi. İzin vermek için Kaydet sayfasında Aygıtları ve izinleri kontrol et seçeneğini açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до мікрофона не дозволено. Відкрийте «Перевірити пристрої та дозволи» на сторінці «Записати», щоб дозволити його."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonåtkomst är inte tillåten. Öppna Kontrollera enheter och behörigheter på sidan Spela in för att tillåta den."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa được phép truy cập micrô. Hãy mở Kiểm tra thiết bị và quyền truy cập trên trang Ghi âm để cho phép."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses mikrofon tidak diizinkan. Buka Periksa perangkat dan izin di halaman Rekam untuk mengizinkannya."
          }
        }
      }
    },
