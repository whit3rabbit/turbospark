        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wiederherstellungsversuch war erfolgreich. Versuch: %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nuovo tentativo di ripristino riuscito. Tentativo: %lld."
