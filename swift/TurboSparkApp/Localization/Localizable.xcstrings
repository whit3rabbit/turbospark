    "Read the headers to size it: turbospark-model recommend --probe": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0642\u0631\u0623 \u0627\u0644\u062a\u0631\u0648\u064a\u0633\u0627\u062a \u0644\u062a\u062d\u062f\u064a\u062f \u062d\u062c\u0645\u0647: turbospark-model recommend --probe"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Header lesen, um die Gr\u00f6\u00dfe zu bestimmen: turbospark-model recommend --probe"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Read the headers to size it: turbospark-model recommend --probe"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lee las cabeceras para calcular su tama\u00f1o: turbospark-model recommend --probe"
