            "state": "translated",
            "value": "La respuesta alcanz\u00f3 su presupuesto total de salida (%lld tokens)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La r\u00e9ponse a atteint son budget total de sortie (%lld jetons)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05d2\u05d9\u05e2\u05d4 \u05dc\u05ea\u05e7\u05e6\u05d9\u05d1 \u05d4\u05e4\u05dc\u05d8 \u05d4\u05db\u05d5\u05dc\u05dc \u05e9\u05dc\u05d4 (\u05d0\u05e1\u05d9\u05de\u05d5\u05e0\u05d9\u05dd: %lld)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0924\u094d\u0924\u0930 \u0905\u092a\u0928\u0947 \u0915\u0941\u0932 \u0906\u0909\u091f\u092a\u0941\u091f \u092c\u091c\u091f (%lld \u091f\u094b\u0915\u0928) \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0917\u092f\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan mencapai total anggaran keluaran (%lld token)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risposta ha raggiunto il budget totale di output (%lld token)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fdc\u7b54\u304c\u51fa\u529b\u306e\u7dcf\u4e88\u7b97 (%lld \u30c8\u30fc\u30af\u30f3) \u306b\u9054\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc751\ub2f5\uc774 \ucd1d \ucd9c\ub825 \uc608\uc0b0(%lld \ud1a0\ud070)\uc5d0 \ub3c4\ub2ec\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het antwoord heeft het totale uitvoerbudget (%lld tokens) bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowied\u017a osi\u0105gn\u0119\u0142a \u0142\u0105czny bud\u017cet wyj\u015bciowy (tokeny: %lld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A resposta atingiu seu or\u00e7amento total de sa\u00edda (%lld tokens)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u0432\u0435\u0442 \u0438\u0441\u0447\u0435\u0440\u043f\u0430\u043b \u043e\u0431\u0449\u0438\u0439 \u0431\u044e\u0434\u0436\u0435\u0442 \u0432\u044b\u0432\u043e\u0434\u0430 (\u0442\u043e\u043a\u0435\u043d\u043e\u0432: %lld)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaret n\u00e5dde sin totala utdatabudget (%lld token)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yan\u0131t toplam \u00e7\u0131kt\u0131 b\u00fct\u00e7esine (%lld token) ula\u015ft\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u0432\u0438\u0447\u0435\u0440\u043f\u0430\u043b\u0430 \u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0438\u0439 \u0431\u044e\u0434\u0436\u0435\u0442 \u0432\u0438\u0432\u043e\u0434\u0443 (\u0442\u043e\u043a\u0435\u043d\u0456\u0432: %lld)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e2u tr\u1ea3 l\u1eddi \u0111\u00e3 \u0111\u1ea1t t\u1ed5ng ng\u00e2n s\u00e1ch \u0111\u1ea7u ra (%lld token)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56de\u590d\u5df2\u8fbe\u5230\u603b\u8f93\u51fa\u9884\u7b97\uff08%lld \u4e2a\u4ee4\u724c\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56de\u8986\u5df2\u9054\u5230\u7e3d\u8f38\u51fa\u9810\u7b97\uff08%lld \u500b\u6b0a\u6756\uff09\u3002"
          }
        }
      }
    },
    "The continuation prompt no longer fits in the model context window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u062a\u0639\u062f \u0645\u0637\u0627\u0644\u0628\u0629 \u0627\u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u062a\u062a\u0633\u0639 \u0641\u064a \u0646\u0627\u0641\u0630\u0629 \u0633\u064a\u0627\u0642 \u0627\u0644\u0646\u0645\u0648\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Fortsetzungs-Prompt passt nicht mehr in das Kontextfenster des Modells."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The continuation prompt no longer fits in the model context window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mensaje de continuaci\u00f3n ya no cabe en la ventana de contexto del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'invite de continuation ne tient plus dans la fen\u00eatre de contexte du mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e0\u05d7\u05d9\u05d9\u05ea \u05d4\u05d4\u05de\u05e9\u05da \u05db\u05d1\u05e8 \u05d0\u05d9\u05e0\u05d4 \u05e0\u05db\u05e0\u05e1\u05ea \u05dc\u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u0930\u0902\u0924\u0930\u0924\u093e \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u0905\u092c \u092e\u0949\u0921\u0932 \u0915\u0940 \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0938\u092e\u093e\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt kelanjutan tidak lagi muat di jendela konteks model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prompt di continuazione non rientra pi\u00f9 nella finestra di contesto del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d99\u7d9a\u7528\u306e\u30d7\u30ed\u30f3\u30d7\u30c8\u304c\u30e2\u30c7\u30eb\u306e\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u306b\u53ce\u307e\u3089\u306a\u304f\u306a\u308a\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\uc5b4\uc4f0\uae30 \ud504\ub86c\ud504\ud2b8\uac00 \ub354 \uc774\uc0c1 \ubaa8\ub378 \ucee8\ud14d\uc2a4\ud2b8 \ucc3d\uc5d0 \ub9de\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervolgprompt past niet meer in het contextvenster van het model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt kontynuacji nie mie\u015bci si\u0119 ju\u017c w oknie kontekstu modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prompt de continua\u00e7\u00e3o n\u00e3o cabe mais na janela de contexto do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0440\u043e\u0441 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0438\u044f \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043f\u043e\u043c\u0435\u0449\u0430\u0435\u0442\u0441\u044f \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u0435 \u043e\u043a\u043d\u043e \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Forts\u00e4ttningsprompten f\u00e5r inte l\u00e4ngre plats i modellens kontextf\u00f6nster."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam istemi art\u0131k modelin ba\u011flam penceresine s\u0131\u011fm\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0442 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0435\u043d\u043d\u044f \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0432\u043c\u0456\u0449\u0443\u0454\u0442\u044c\u0441\u044f \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u0435 \u0432\u0456\u043a\u043d\u043e \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1eddi nh\u1eafc ti\u1ebfp t\u1ee5c kh\u00f4ng c\u00f2n v\u1eeba v\u1edbi c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh c\u1ee7a m\u00f4 h\u00ecnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7eed\u5199\u63d0\u793a\u5df2\u65e0\u6cd5\u653e\u5165\u6a21\u578b\u7684\u4e0a\u4e0b\u6587\u7a97\u53e3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7e8c\u5beb\u63d0\u793a\u5df2\u7121\u6cd5\u653e\u5165\u6a21\u578b\u7684\u4e0a\u4e0b\u6587\u8996\u7a97\u3002"
          }
        }
      }
    },
    "Generation ended without a result.": {
      "extractionState": "manual",
