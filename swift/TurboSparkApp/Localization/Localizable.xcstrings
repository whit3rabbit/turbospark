          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u0440\u0430\u0437\u043c\u0435\u0440 \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e2\u30c7\u30eb\u306f\u30c7\u30d5\u30a9\u30eb\u30c8\u30b5\u30a4\u30ba\u306e\u307f\u3092\u30b5\u30dd\u30fc\u30c8\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubaa8\ub378\uc740 \uae30\ubcf8 \ud06c\uae30\ub9cc \uc9c0\uc6d0\ud569\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u4ec5\u652f\u6301\u9ed8\u8ba4\u5c3a\u5bf8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u50c5\u652f\u63f4\u9810\u8a2d\u5c3a\u5bf8\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062f\u0639\u0645 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u062d\u062c\u0645\u0647 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a \u0641\u0642\u0637."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d5\u05d3\u05dc \u05d6\u05d4 \u05ea\u05d5\u05de\u05da \u05d1\u05d2\u05d5\u05d3\u05dc \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc \u05e9\u05dc\u05d5 \u05d1\u05dc\u05d1\u05d3."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092e\u0949\u0921\u0932 \u0915\u0947\u0935\u0932 \u0905\u092a\u0928\u0947 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0906\u0915\u093e\u0930 \u0915\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit model ondersteunt alleen de standaardgrootte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten model obs\u0142uguje tylko sw\u00f3j domy\u015blny rozmiar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model yaln\u0131zca varsay\u0131lan boyutunu destekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u043b\u0438\u0448\u0435 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438\u0439 \u0440\u043e\u0437\u043c\u0456\u0440."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna modell st\u00f6der endast standardstorleken."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 h\u00ecnh n\u00e0y ch\u1ec9 h\u1ed7 tr\u1ee3 k\u00edch th\u01b0\u1edbc m\u1eb7c \u0111\u1ecbnh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini hanya mendukung ukuran defaultnya."
          }
        }
      }
    },
