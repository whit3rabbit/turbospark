    "Keeps the current colors as Custom.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062d\u062a\u0641\u0638 \u0628\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u062d\u0627\u0644\u064a\u0629 \u0643\u0623\u0644\u0648\u0627\u0646 \u0645\u062e\u0635\u0635\u0629."
          }
        },
        "de": {
          "stringUnit": {
