    "SOUL.md is disabled. Imports stay available and take effect when enabled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u0645\u0639\u0637\u0644. \u062a\u0628\u0642\u0649 \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u062a\u0627\u062d\u0629 \u0648\u062a\u0633\u0631\u064a \u0639\u0646\u062f \u0627\u0644\u062a\u0641\u0639\u064a\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md ist deaktiviert. Importe bleiben verf\u00fcgbar und wirken, sobald es aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md is disabled. Imports stay available and take effect when enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md est\u00e1 desactivado. Las importaciones siguen disponibles y surten efecto al activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md est d\u00e9sactiv\u00e9. Les importations restent disponibles et s'appliquent une fois activ\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u05de\u05d5\u05e9\u05d1\u05ea. \u05d4\u05d9\u05d9\u05d1\u05d5\u05d0 \u05e0\u05e9\u05d0\u05e8 \u05d6\u05de\u05d9\u05df \u05d5\u05e0\u05db\u05e0\u05e1 \u05dc\u05ea\u05d5\u05e7\u05e3 \u05db\u05e9\u05d4\u05d5\u05d0 \u05de\u05d5\u05e4\u05e2\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u092c\u0902\u0926 \u0939\u0948\u0964 \u0906\u092f\u093e\u0924 \u0909\u092a\u0932\u092c\u094d\u0927 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u091a\u093e\u0932\u0942 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md dinonaktifkan. Impor tetap tersedia dan berlaku saat diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u00e8 disattivato. Le importazioni restano disponibili e hanno effetto quando lo attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md\u306f\u7121\u52b9\u3067\u3059\u3002\u8aad\u307f\u8fbc\u307f\u306f\u5f15\u304d\u7d9a\u304d\u5229\u7528\u3067\u304d\u3001\u6709\u52b9\u306b\u3059\u308b\u3068\u53cd\u6620\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md\uac00 \uaebc\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uac00\uc838\uc624\uae30\ub294 \uacc4\uc18d \uc0ac\uc6a9\ud560 \uc218 \uc788\uc73c\uba70 \ucf1c\uba74 \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md is uitgeschakeld. Imports blijven beschikbaar en worden actief zodra het is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md jest wy\u0142\u0105czony. Importy pozostaj\u0105 dost\u0119pne i zaczn\u0105 dzia\u0142a\u0107 po w\u0142\u0105czeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SOUL.md est\u00e1 desativado. As importa\u00e7\u00f5es continuam dispon\u00edveis e entram em vigor quando ele for ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d. \u0418\u043c\u043f\u043e\u0440\u0442 \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u043c \u0438 \u0432\u0441\u0442\u0443\u043f\u0438\u0442 \u0432 \u0441\u0438\u043b\u0443 \u043f\u043e\u0441\u043b\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u00e4r avst\u00e4ngt. Importer f\u00f6rblir tillg\u00e4ngliga och b\u00f6rjar g\u00e4lla n\u00e4r det sl\u00e5s p\u00e5."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md devre d\u0131\u015f\u0131. \u0130\u00e7e aktarmalar kullan\u0131labilir kal\u0131r ve etkinle\u015ftirildi\u011finde ge\u00e7erli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u0406\u043c\u043f\u043e\u0440\u0442 \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u044c\u0441\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u043c \u0456 \u043f\u043e\u0447\u043d\u0435 \u0434\u0456\u044f\u0442\u0438 \u043f\u0456\u0441\u043b\u044f \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u0111ang t\u1eaft. C\u00e1c b\u1ea3n nh\u1eadp v\u1eabn d\u00f9ng \u0111\u01b0\u1ee3c v\u00e0 s\u1ebd c\u00f3 hi\u1ec7u l\u1ef1c khi b\u1eadt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u5df2\u505c\u7528\u3002\u5bfc\u5165\u4ecd\u53ef\u7528\uff0c\u5e76\u4f1a\u5728\u542f\u7528\u540e\u751f\u6548\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md \u5df2\u505c\u7528\u3002\u532f\u5165\u4ecd\u53ef\u4f7f\u7528\uff0c\u4e26\u6703\u5728\u555f\u7528\u5f8c\u751f\u6548\u3002"
          }
        }
      }
    },
    "Enabled. No soul selected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0641\u0639\u0651\u0644. \u0644\u0645 \u064a\u062a\u0645 \u0627\u062e\u062a\u064a\u0627\u0631 \u0631\u0648\u062d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviert. Keine Seele ausgew\u00e4hlt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enabled. No soul selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado. No hay ning\u00fan alma seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activ\u00e9. Aucune \u00e2me s\u00e9lectionn\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d5\u05e4\u05e2\u05dc. \u05dc\u05d0 \u05e0\u05d1\u05d7\u05e8\u05d4 \u05e0\u05e9\u05de\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u093e\u0932\u0942 \u0939\u0948\u0964 \u0915\u094b\u0908 \u0938\u094b\u0932 \u091a\u0941\u0928\u093e \u0928\u0939\u0940\u0902 \u0917\u092f\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktif. Belum ada soul yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato. Nessuna anima selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u52b9\u3067\u3059\u3002\u30bd\u30a6\u30eb\u304c\u9078\u629e\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucf1c\uc9d0. \uc120\ud0dd\ud55c \uc18c\uc6b8\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingeschakeld. Geen ziel geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u0142\u0105czone. Nie wybrano duszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado. Nenhuma alma selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043a\u043b\u044e\u0447\u0435\u043d\u043e. \u0414\u0443\u0448\u0430 \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u00e5. Ingen sj\u00e4l vald."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin. Ruh se\u00e7ilmedi."
