    "Install models locally from the curated catalog or Hugging Face.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install models locally from the curated catalog or Hugging Face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala modelos localmente desde el catálogo curado o desde Hugging Face."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez des modèles en local depuis le catalogue sélectionné ou depuis Hugging Face."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie Modelle lokal aus dem kuratierten Katalog oder von Hugging Face."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa modelli in locale dal catalogo curato o da Hugging Face."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale modelos localmente a partir do catálogo curado ou do Hugging Face."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливайте модели локально из курируемого каталога или с Hugging Face."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳選カタログまたは Hugging Face からモデルをローカルにインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
