      }
    },
    "Unlock this profile before exporting or restoring it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0644\u063a\u0650 \u0642\u0641\u0644 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0642\u0628\u0644 \u062a\u0635\u062f\u064a\u0631\u0647 \u0623\u0648 \u0627\u0633\u062a\u0639\u0627\u062f\u062a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperren Sie dieses Profil, bevor Sie es exportieren oder wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlock this profile before exporting or restoring it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloquea este perfil antes de exportarlo o restaurarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9verrouillez ce profil avant de l'exporter ou de le restaurer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d8\u05dc \u05d0\u05ea \u05e0\u05e2\u05d9\u05dc\u05ea \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d9\u05d9\u05e6\u05d5\u05d0 \u05d0\u05d5 \u05e9\u05d7\u05d6\u05d5\u05e8 \u05e9\u05dc\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092f\u093e \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0907\u0938 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u094b \u0905\u0928\u0932\u0949\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kunci profil ini sebelum mengekspor atau memulihkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sblocca questo profilo prima di esportarlo o ripristinarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f8\u304d\u51fa\u3057\u307e\u305f\u306f\u5fa9\u5143\u306e\u524d\u306b\u3001\u3053\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\ubcf4\ub0b4\uac70\ub098 \ubcf5\uc6d0\ud558\uae30 \uc804\uc5d0 \uc774 \ud504\ub85c\ud544\uc758 \uc7a0\uae08\uc744 \ud574\uc81c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ontgrendel dit profiel voordat u het exporteert of herstelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odblokuj ten profil przed jego eksportem lub przywr\u00f3ceniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desbloqueie este perfil antes de export\u00e1-lo ou restaur\u00e1-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0439\u0442\u0435 \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u043f\u0435\u0440\u0435\u0434 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u043c \u0438\u043b\u0438 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0435\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e5s upp den h\u00e4r profilen innan du exporterar eller \u00e5terst\u00e4ller den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u0131\u015fa aktarmadan veya geri y\u00fcklemeden \u00f6nce bu profilin kilidini a\u00e7\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u043e\u0437\u0431\u043b\u043e\u043a\u0443\u0439\u0442\u0435 \u0446\u0435\u0439 \u043f\u0440\u043e\u0444\u0456\u043b\u044c \u043f\u0435\u0440\u0435\u0434 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u043c \u0430\u0431\u043e \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y m\u1edf kh\u00f3a h\u1ed3 s\u01a1 n\u00e0y tr\u01b0\u1edbc khi xu\u1ea5t ho\u1eb7c kh\u00f4i ph\u1ee5c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u89e3\u9501\u6b64\u914d\u7f6e\u6863\u6848\uff0c\u518d\u5bfc\u51fa\u6216\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u89e3\u9396\u6b64\u8a2d\u5b9a\u6a94\uff0c\u518d\u532f\u51fa\u6216\u9084\u539f\u3002"
          }
        }
      }
    },
    "Only the active unlocked profile can be exported.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0635\u062f\u064a\u0631 \u0625\u0644\u0627 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0646\u0634\u0637 \u063a\u064a\u0631 \u0627\u0644\u0645\u0642\u0641\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur das aktive, entsperrte Profil kann exportiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the active unlocked profile can be exported."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se puede exportar el perfil activo y desbloqueado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le profil actif d\u00e9verrouill\u00e9 peut \u00eatre export\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d9\u05d9\u05e6\u05d0 \u05e8\u05e7 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05e4\u05e2\u05d9\u05dc \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e0\u05e2\u05d5\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0947\u0935\u0932 \u0938\u0915\u094d\u0930\u093f\u092f \u0914\u0930 \u0905\u0928\u0932\u0949\u0915 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u094b \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya profil aktif yang tidak terkunci yang dapat diekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo il profilo attivo e sbloccato pu\u00f2 essere esportato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f8\u304d\u51fa\u305b\u308b\u306e\u306f\u3001\u30a2\u30af\u30c6\u30a3\u30d6\u3067\u30ed\u30c3\u30af\u89e3\u9664\u3055\u308c\u305f\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306e\u307f\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud65c\uc131 \uc0c1\ud0dc\uc774\uba70 \uc7a0\uae08 \ud574\uc81c\ub41c \ud504\ub85c\ud544\ub9cc \ub0b4\ubcf4\ub0bc \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het actieve, ontgrendelde profiel kan worden ge\u00ebxporteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mo\u017cna wyeksportowa\u0107 tylko aktywny, odblokowany profil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o perfil ativo e desbloqueado pode ser exportado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u043c\u043e\u0436\u043d\u043e \u0442\u043e\u043b\u044c\u043a\u043e \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u0439 \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast den aktiva, uppl\u00e5sta profilen kan exporteras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaln\u0131zca etkin ve kilidi a\u00e7\u0131k profil d\u0131\u015fa aktar\u0131labilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u043a\u0441\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u043c\u043e\u0436\u043d\u0430 \u043b\u0438\u0448\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u0439 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u0438\u0439 \u043f\u0440\u043e\u0444\u0456\u043b\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ec9 c\u00f3 th\u1ec3 xu\u1ea5t h\u1ed3 s\u01a1 \u0111ang ho\u1ea1t \u0111\u1ed9ng v\u00e0 \u0111\u00e3 m\u1edf kh\u00f3a."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u80fd\u5bfc\u51fa\u5f53\u524d\u5904\u4e8e\u6d3b\u52a8\u72b6\u6001\u4e14\u5df2\u89e3\u9501\u7684\u914d\u7f6e\u6863\u6848\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u80fd\u532f\u51fa\u76ee\u524d\u4f7f\u7528\u4e2d\u4e14\u5df2\u89e3\u9396\u7684\u8a2d\u5b9a\u6a94\u3002"
          }
        }
      }
    },
    "The encrypted profile backup is malformed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0627\u0644\u0645\u0634\u0641\u0631\u0629 \u0644\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u062a\u0627\u0644\u0641\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das verschl\u00fcsselte Profil-Backup ist fehlerhaft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted profile backup is malformed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La copia de seguridad cifrada del perfil tiene un formato incorrecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sauvegarde chiffr\u00e9e du profil est mal form\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d2\u05d9\u05d1\u05d5\u05d9 \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05d5\u05e6\u05e4\u05df \u05e4\u05d2\u05d5\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092c\u0948\u0915\u0905\u092a \u0935\u093f\u0915\u0943\u0924 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan profil terenkripsi tidak valid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup cifrato del profilo non \u00e8 valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6697\u53f7\u5316\u3055\u308c\u305f\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306e\u5f62\u5f0f\u304c\u6b63\u3057\u304f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc554\ud638\ud654\ub41c \ud504\ub85c\ud544 \ubc31\uc5c5\uc758 \ud615\uc2dd\uc774 \uc798\ubabb\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelde reservekopie van het profiel is ongeldig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaszyfrowana kopia zapasowa profilu jest uszkodzona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup criptografado do perfil est\u00e1 malformado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den krypterade profils\u00e4kerhetskopian \u00e4r felaktig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eifreli profil yede\u011fi hatal\u0131 bi\u00e7imlendirilmi\u015f."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430 \u043a\u043e\u043f\u0456\u044f \u043f\u0440\u043e\u0444\u0456\u043b\u044e \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n sao l\u01b0u h\u1ed3 s\u01a1 \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a b\u1ecb l\u1ed7i \u0111\u1ecbnh d\u1ea1ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u5bc6\u7684\u914d\u7f6e\u6863\u6848\u5907\u4efd\u683c\u5f0f\u9519\u8bef\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u5bc6\u7684\u8a2d\u5b9a\u6a94\u5099\u4efd\u683c\u5f0f\u932f\u8aa4\u3002"
          }
        }
      }
    },
    "This backup uses unsupported format %lld.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0633\u062a\u062e\u062f\u0645 \u0647\u0630\u0647 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u062a\u0646\u0633\u064a\u0642\u064b\u0627 \u063a\u064a\u0631 \u0645\u062f\u0639\u0648\u0645 (%lld)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Backup verwendet ein nicht unterst\u00fctztes Format (%lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup uses unsupported format %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta copia de seguridad usa un formato no compatible (%lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette sauvegarde utilise un format non pris en charge (%lld)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d2\u05d9\u05d1\u05d5\u05d9 \u05d6\u05d4 \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e0\u05ea\u05de\u05da (%lld)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092c\u0948\u0915\u0905\u092a \u0905\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u092a\u094d\u0930\u093e\u0930\u0942\u092a (%lld) \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan ini menggunakan format yang tidak didukung (%lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo backup usa un formato non supportato (%lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306f\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u306a\u3044\u5f62\u5f0f (%lld) \u3092\u4f7f\u7528\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubc31\uc5c5\uc740 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\ub294 \ud615\uc2dd(%lld)\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze reservekopie gebruikt een niet-ondersteunde indeling (%lld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta kopia zapasowa u\u017cywa nieobs\u0142ugiwanego formatu (%lld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este backup usa um formato n\u00e3o compat\u00edvel (%lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u044d\u0442\u043e\u0439 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0439 \u043a\u043e\u043f\u0438\u0438 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043d\u0435\u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0439 \u0444\u043e\u0440\u043c\u0430\u0442 (%lld)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r s\u00e4kerhetskopian anv\u00e4nder ett format som inte st\u00f6ds (%lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu yedek desteklenmeyen bir bi\u00e7im (%lld) kullan\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u044f \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430 \u043a\u043e\u043f\u0456\u044f \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u043d\u0435\u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0438\u0439 \u0444\u043e\u0440\u043c\u0430\u0442 (%lld)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n sao l\u01b0u n\u00e0y d\u00f9ng \u0111\u1ecbnh d\u1ea1ng kh\u00f4ng \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 (%lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
