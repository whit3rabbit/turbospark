        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0938\u094d\u091f\u092e \u0913\u0935\u0930\u0932\u094b\u0921 \u0938\u0947 \u0915\u094b\u0908 \u0938\u093e\u0935\u0927\u093e\u0928\u0940 \u0928\u0939\u0940\u0902"
