    "Write a script in sections. Preview or regenerate each section as a new take.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write a script in sections. Preview or regenerate each section as a new take."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe un guion en secciones. Escucha una vista previa o regenera cada secci\u00f3n como una nueva toma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9digez un script par sections. \u00c9coutez un aper\u00e7u ou r\u00e9g\u00e9n\u00e9rez chaque section comme une nouvelle prise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe ein Skript in Abschnitten. H\u00f6re einen Abschnitt vor oder erzeuge ihn als neuen Take."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi un copione in sezioni. Ascolta un'anteprima o rigenera ogni sezione come una nuova take."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva um roteiro em se\u00e7\u00f5es. Ou\u00e7a uma pr\u00e9via ou gere cada se\u00e7\u00e3o novamente como uma nova tomada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf een script in secties. Beluister een voorbeeld of genereer elke sectie opnieuw als een nieuwe take."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv ett manus i avsnitt. F\u00f6rhandslyssna eller generera varje avsnitt igen som en ny tagning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Napisz scenariusz w sekcjach. Ods\u0142uchaj podgl\u0105d lub wygeneruj ka\u017cd\u0105 sekcj\u0119 ponownie jako now\u0105 wersj\u0119."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00f6l\u00fcmler halinde metin yaz\u0131n. Her b\u00f6l\u00fcm\u00fc \u00f6nizleyin veya yeni bir \u00e7ekim olarak yeniden olu\u015fturun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis naskah dalam beberapa bagian. Pratinjau atau buat ulang tiap bagian sebagai take baru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0439 \u043f\u043e \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u043c. \u041f\u0440\u043e\u0441\u043b\u0443\u0448\u0430\u0439\u0442\u0435 \u0438\u043b\u0438 \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u0443\u0439\u0442\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0440\u0430\u0437\u0434\u0435\u043b \u0437\u0430\u043d\u043e\u0432\u043e \u043a\u0430\u043a \u043d\u043e\u0432\u044b\u0439 \u0434\u0443\u0431\u043b\u044c."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0441\u0446\u0435\u043d\u0430\u0440\u0456\u0439 \u0437\u0430 \u0440\u043e\u0437\u0434\u0456\u043b\u0430\u043c\u0438. \u041f\u0440\u043e\u0441\u043b\u0443\u0445\u0430\u0439\u0442\u0435 \u0430\u0431\u043e \u0437\u0433\u0435\u043d\u0435\u0440\u0443\u0439\u0442\u0435 \u043a\u043e\u0436\u0435\u043d \u0440\u043e\u0437\u0434\u0456\u043b \u0437\u043d\u043e\u0432\u0443 \u044f\u043a \u043d\u043e\u0432\u0438\u0439 \u0434\u0443\u0431\u043b\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi\u1ebft k\u1ecbch b\u1ea3n theo t\u1eebng ph\u1ea7n. Nghe th\u1eed ho\u1eb7c t\u1ea1o l\u1ea1i m\u1ed7i ph\u1ea7n th\u00e0nh m\u1ed9t l\u01b0\u1ee3t thu m\u1edbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30af\u30ea\u30d7\u30c8\u3092\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u5206\u3051\u3066\u66f8\u304d\u307e\u3059\u3002\u5404\u30bb\u30af\u30b7\u30e7\u30f3\u3092\u8a66\u8074\u3057\u305f\u308a\u3001\u65b0\u3057\u3044\u30c6\u30a4\u30af\u3068\u3057\u3066\u518d\u751f\u6210\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\ud06c\ub9bd\ud2b8\ub97c \uc139\uc158\ubcc4\ub85c \uc791\uc131\ud558\uc138\uc694. \uac01 \uc139\uc158\uc744 \ubbf8\ub9ac \ub4e3\uac70\ub098 \uc0c8 \ud14c\uc774\ud06c\ub85c \ub2e4\uc2dc \uc0dd\uc131\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6309\u6bb5\u843d\u7f16\u5199\u811a\u672c\u3002\u8bd5\u542c\u6bcf\u4e2a\u6bb5\u843d\uff0c\u6216\u5c06\u5176\u91cd\u65b0\u751f\u6210\u4e3a\u65b0\u7248\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6309\u6bb5\u843d\u64b0\u5beb\u8173\u672c\u3002\u8a66\u807d\u6bcf\u500b\u6bb5\u843d\uff0c\u6216\u5c07\u5176\u91cd\u65b0\u751f\u6210\u70ba\u65b0\u7248\u672c\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0643\u062a\u0628 \u0646\u0635\u0627\u064b \u0645\u0642\u0633\u0651\u0645\u0627\u064b \u0625\u0644\u0649 \u0623\u0642\u0633\u0627\u0645. \u0627\u0633\u062a\u0645\u0639 \u0625\u0644\u0649 \u0645\u0639\u0627\u064a\u0646\u0629 \u0623\u0648 \u0623\u0639\u062f \u062a\u0648\u0644\u064a\u062f \u0643\u0644 \u0642\u0633\u0645 \u0643\u0646\u0633\u062e\u0629 \u062c\u062f\u064a\u062f\u0629."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05ea\u05d5\u05d1 \u05ea\u05e1\u05e8\u05d9\u05d8 \u05d1\u05de\u05e7\u05d8\u05e2\u05d9\u05dd. \u05d4\u05d0\u05d6\u05df \u05dc\u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05d0\u05d5 \u05e6\u05d5\u05e8 \u05db\u05dc \u05de\u05e7\u05d8\u05e2 \u05de\u05d7\u05d3\u05e9 \u05db\u05d8\u05d9\u05d9\u05e7 \u05d7\u05d3\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u0902\u0921\u094b\u0902 \u092e\u0947\u0902 \u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0932\u093f\u0916\u0947\u0902\u0964 \u0939\u0930 \u0916\u0902\u0921 \u0915\u094b \u092a\u0939\u0932\u0947 \u0938\u0941\u0928\u0947\u0902 \u092f\u093e \u0928\u090f \u091f\u0947\u0915 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092b\u093f\u0930 \u0938\u0947 \u092c\u0928\u093e\u090f\u0901\u0964"
          }
        }
      }
    },
    "Your input and completed takes are kept. Adjust the settings and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your input and completed takes are kept. Adjust the settings and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan tus entradas y las tomas completadas. Ajusta la configuraci\u00f3n e int\u00e9ntalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos saisies et les prises termin\u00e9es sont conserv\u00e9es. Ajustez les r\u00e9glages et r\u00e9essayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingaben und fertigen Takes bleiben erhalten. Passe die Einstellungen an und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati e le take completate vengono conservati. Modifica le impostazioni e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas entradas e tomadas conclu\u00eddas s\u00e3o mantidas. Ajuste as configura\u00e7\u00f5es e tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je invoer en voltooide takes blijven behouden. Pas de instellingen aan en probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina indata och f\u00e4rdiga tagningar beh\u00e5lls. Justera inst\u00e4llningarna och f\u00f6rs\u00f6k igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane wej\u015bciowe i uko\u0144czone wersje zostaj\u0105 zachowane. Zmie\u0144 ustawienia i spr\u00f3buj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdileriniz ve tamamlanan \u00e7ekimler korunur. Ayarlar\u0131 de\u011fi\u015ftirip yeniden deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukan dan take yang selesai tetap disimpan. Sesuaikan pengaturan lalu coba lagi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0430\u0448\u0438 \u0432\u0445\u043e\u0434\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0438 \u0433\u043e\u0442\u043e\u0432\u044b\u0435 \u0434\u0443\u0431\u043b\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f. \u0418\u0437\u043c\u0435\u043d\u0438\u0442\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0430\u0448\u0456 \u0432\u0445\u0456\u0434\u043d\u0456 \u0434\u0430\u043d\u0456 \u0442\u0430 \u0433\u043e\u0442\u043e\u0432\u0456 \u0434\u0443\u0431\u043b\u0456 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f. \u0417\u043c\u0456\u043d\u0456\u0442\u044c \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0442\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u1eef li\u1ec7u \u0111\u1ea7u v\u00e0o v\u00e0 c\u00e1c l\u01b0\u1ee3t thu ho\u00e0n t\u1ea5t \u0111\u01b0\u1ee3c gi\u1eef l\u1ea1i. \u0110i\u1ec1u ch\u1ec9nh c\u00e0i \u0111\u1eb7t v\u00e0 th\u1eed l\u1ea1i."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5165\u529b\u5185\u5bb9\u3068\u5b8c\u6210\u3057\u305f\u30c6\u30a4\u30af\u306f\u4fdd\u6301\u3055\u308c\u307e\u3059\u3002\u8a2d\u5b9a\u3092\u8abf\u6574\u3057\u3066\u518d\u8a66\u884c\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc785\ub825 \ub0b4\uc6a9\uacfc \uc644\ub8cc\ub41c \ud14c\uc774\ud06c\ub294 \uc720\uc9c0\ub429\ub2c8\ub2e4. \uc124\uc815\uc744 \uc870\uc815\ud558\uace0 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u8f93\u5165\u548c\u5df2\u5b8c\u6210\u7684\u7248\u672c\u4f1a\u88ab\u4fdd\u7559\u3002\u8c03\u6574\u8bbe\u7f6e\u540e\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u7684\u8f38\u5165\u548c\u5df2\u5b8c\u6210\u7684\u7248\u672c\u6703\u88ab\u4fdd\u7559\u3002\u8abf\u6574\u8a2d\u5b9a\u5f8c\u518d\u8a66\u4e00\u6b21\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0645 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0645\u062f\u062e\u0644\u0627\u062a\u0643 \u0648\u0627\u0644\u0646\u0633\u062e \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629. \u0627\u0636\u0628\u0637 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0648\u062d\u0627\u0648\u0644 \u0645\u062c\u062f\u062f\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e7\u05dc\u05d8 \u05e9\u05dc\u05da \u05d5\u05d4\u05d8\u05d9\u05d9\u05e7\u05d9\u05dd \u05e9\u05d4\u05d5\u05e9\u05dc\u05de\u05d5 \u05e0\u05e9\u05de\u05e8\u05d9\u05dd. \u05d4\u05ea\u05d0\u05dd \u05d0\u05ea \u05d4\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u093e \u0907\u0928\u092a\u0941\u091f \u0914\u0930 \u092a\u0942\u0930\u0947 \u0939\u0941\u090f \u091f\u0947\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092c\u0926\u0932\u0947\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
