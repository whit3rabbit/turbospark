          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una cartella di checkpoint invece del download fissato. I suoi file non vengono verificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "固定されたダウンロードの代わりにチェックポイントのフォルダを使います。ファイルは検証されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "고정된 다운로드 대신 체크포인트 폴더를 사용합니다. 파일을 검사하지 않습니다."
          }
        },
        "nl": {
