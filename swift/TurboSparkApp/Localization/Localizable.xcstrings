            "value": "\u626b\u63cf\u9879\u76ee\u6839\u76ee\u5f55\u4e2d\u7684 .mcp.json\u3001opencode.json\u3001.cursor\u3001.vscode \u548c .agents \u914d\u7f6e\u3002"
