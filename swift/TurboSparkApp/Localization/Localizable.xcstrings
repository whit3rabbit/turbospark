    "Metal GPU wait per pass from the last run's phase counters. Updates after a generation pass completes; TurboSpark does not measure a live GPU percentage.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتظار وحدة GPU في Metal لكل تمرير من عدادات المراحل في آخر تشغيل. يُحدَّث بعد اكتمال تمرير التوليد؛ لا يقيس TurboSpark نسبة GPU مباشرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal-GPU-Wartezeit pro Durchlauf aus den Phasenzählern des letzten Laufs. Wird nach Abschluss eines Generierungsdurchlaufs aktualisiert; TurboSpark misst keinen Live-GPU-Prozentsatz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal GPU wait per pass from the last run's phase counters. Updates after a generation pass completes; TurboSpark does not measure a live GPU percentage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera de GPU de Metal por pasada según los contadores de fase de la última ejecución. Se actualiza al terminar una pasada de generación; TurboSpark no mide un porcentaje de GPU en tiempo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attente GPU Metal par passe, d'après les compteurs de phase de la dernière exécution. Mise à jour à la fin d'une passe de génération ; TurboSpark ne mesure pas de pourcentage GPU en direct."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המתנת GPU של Metal לכל מעבר, לפי מוני השלבים של ההרצה האחרונה. מתעדכן בסיום מעבר יצירה; TurboSpark אינו מודד אחוז GPU בזמן אמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले रन के फ़ेज़ काउंटर से प्रति पास Metal GPU प्रतीक्षा। जनरेशन पास पूरा होने के बाद अपडेट होता है; TurboSpark लाइव GPU प्रतिशत नहीं मापता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Waktu tunggu GPU Metal per lintasan dari penghitung fase proses terakhir. Diperbarui setelah lintasan pembuatan selesai; TurboSpark tidak mengukur persentase GPU secara langsung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attesa GPU Metal per passaggio, dai contatori di fase dell'ultima esecuzione. Si aggiorna al termine di un passaggio di generazione; TurboSpark non misura una percentuale GPU in tempo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前回の実行のフェーズカウンターから得た、パスごとの Metal GPU 待ち時間。生成パスの完了後に更新されます。TurboSpark はリアルタイムの GPU 使用率を測定しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마지막 실행의 단계 카운터에서 얻은 패스당 Metal GPU 대기 시간입니다. 생성 패스가 끝난 후 업데이트되며, TurboSpark는 실시간 GPU 사용률을 측정하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal-GPU-wachttijd per pass uit de fasetellers van de laatste run. Wordt bijgewerkt nadat een generatiepass is voltooid; TurboSpark meet geen live GPU-percentage."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas oczekiwania GPU Metal na przebieg według liczników faz z ostatniego uruchomienia. Aktualizuje się po zakończeniu przebiegu generowania; TurboSpark nie mierzy bieżącego procentu użycia GPU."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espera da GPU Metal por passagem, a partir dos contadores de fase da última execução. Atualiza após a conclusão de uma passagem de geração; o TurboSpark não mede uma porcentagem de GPU em tempo real."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ожидание GPU Metal за проход по счётчикам фаз последнего запуска. Обновляется после завершения прохода генерации; TurboSpark не измеряет загрузку GPU в реальном времени."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Metal-GPU-väntetid per pass från fasräknarna i den senaste körningen. Uppdateras när ett genereringspass är klart; TurboSpark mäter inte någon live-procentsats för GPU."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son çalıştırmanın aşama sayaçlarından geçiş başına Metal GPU beklemesi. Bir üretim geçişi tamamlandıktan sonra güncellenir; TurboSpark canlı GPU yüzdesi ölçmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Очікування GPU Metal на прохід за лічильниками фаз останнього запуску. Оновлюється після завершення проходу генерації; TurboSpark не вимірює завантаження GPU в реальному часі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thời gian chờ GPU Metal mỗi lượt từ bộ đếm giai đoạn của lần chạy gần nhất. Cập nhật sau khi một lượt tạo hoàn tất; TurboSpark không đo phần trăm GPU theo thời gian thực."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自上次运行阶段计数器的每轮 Metal GPU 等待时间。生成轮次完成后更新；TurboSpark 不测量实时 GPU 百分比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自上次執行階段計數器的每輪 Metal GPU 等待時間。產生輪次完成後更新；TurboSpark 不測量即時 GPU 百分比。"
          }
        }
      }
    },
