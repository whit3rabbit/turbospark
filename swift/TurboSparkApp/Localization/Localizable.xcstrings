        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0635\u0642 \u0645\u0633\u0648\u062f\u0629 \u0644\u0625\u0639\u0627\u062f\u0629 \u0635\u064a\u0627\u063a\u062a\u0647\u0627."
          }
        },
