    "Humanize is using this model. Unload it there, then move it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تستخدم أنسنة هذا النموذج. أزل تحميله هناك ثم انقله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vermenschlichen verwendet dieses Modell. Entladen Sie es dort und verschieben Sie es dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Humanize is using this model. Unload it there, then move it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Humanizar está usando este modelo. Descárgalo allí y luego muévelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Humaniser utilise ce modèle. Déchargez-le là-bas, puis déplacez-le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוך לאנושי משתמש במודל הזה. פרוק אותו שם ואז העבר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मानवीय बनाएं इस मॉडल का उपयोग कर रहा है। इसे वहाँ अनलोड करें, फिर स्थानांतरित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Manusiakan sedang memakai model ini. Bongkar di sana, lalu pindahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Umanizza sta usando questo modello. Scaricalo da lì, poi spostalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「人間らしくする」がこのモデルを使用しています。そちらでアンロードしてから移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'사람처럼 다듬기'가 이 모델을 사용 중입니다. 그곳에서 언로드한 다음 이동하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Humaniseren gebruikt dit model. Ontlaad het daar en verplaats het daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uczłowiecz używa tego modelu. Wyładuj go tam, a potem przenieś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Humanizar está usando este modelo. Descarregue-o lá e depois mova-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Очеловечить» использует эту модель. Выгрузите её там, затем переместите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Humanisera använder den här modellen. Ladda ur den där och flytta den sedan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanlaştır bu modeli kullanıyor. Orada boşaltın, sonra taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Олюднити» використовує цю модель. Вивантажте її там, а потім перемістіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhân hóa đang dùng mô hình này. Hãy dỡ bỏ ở đó rồi di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“人性化改写”正在使用此模型。请先在那里卸载，再移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「人性化改寫」正在使用此模型。請先在那裡卸載，再移動。"
          }
        }
      }
    },
