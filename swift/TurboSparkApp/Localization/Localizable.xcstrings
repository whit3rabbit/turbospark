    "Installation failed: Authentication required. Check your Hugging Face API token in Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u0634\u0644 \u0627\u0644\u062a\u062b\u0628\u064a\u062a: \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0645\u0637\u0644\u0648\u0628\u0629. \u062a\u062d\u0642\u0642 \u0645\u0646 \u0631\u0645\u0632 \u0648\u0627\u062c\u0647\u0629 \u0628\u0631\u0645\u062c\u0629 \u062a\u0637\u0628\u064a\u0642\u0627\u062a Hugging Face \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation fehlgeschlagen: Authentifizierung erforderlich. Pr\u00fcfen Sie Ihr API-Token f\u00fcr Hugging Face in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installation failed: Authentication required. Check your Hugging Face API token in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en la instalaci\u00f3n: se requiere autenticaci\u00f3n. Revisa tu token de API de Hugging Face en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9chec de l'installation : authentification requise. V\u00e9rifiez votre jeton d'API Hugging Face dans les Param\u00e8tres."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d4\u05ea\u05e7\u05e0\u05d4 \u05e0\u05db\u05e9\u05dc\u05d4: \u05e0\u05d3\u05e8\u05e9 \u05d0\u05d9\u05de\u05d5\u05ea. \u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05d0\u05e1\u05d9\u05de\u05d5\u05df \u05d4-API \u05e9\u05dc Hugging Face \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0902\u0938\u094d\u091f\u0949\u0932\u0947\u0936\u0928 \u0935\u093f\u092b\u0932: \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0905\u092a\u0928\u093e Hugging Face API \u091f\u094b\u0915\u0928 \u091c\u093e\u0902\u091a\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemasangan gagal: Autentikasi diperlukan. Periksa token API Hugging Face Anda di Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installazione non riuscita: autenticazione richiesta. Controlla il token API di Hugging Face in Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u306b\u5931\u6557\u3057\u307e\u3057\u305f: \u8a8d\u8a3c\u304c\u5fc5\u8981\u3067\u3059\u3002\u8a2d\u5b9a\u3067 Hugging Face API \u30c8\u30fc\u30af\u30f3\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58 \uc2e4\ud328: \uc778\uc99d\uc774 \ud544\uc694\ud569\ub2c8\ub2e4. \uc124\uc815\uc5d0\uc11c Hugging Face API \ud1a0\ud070\uc744 \ud655\uc778\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installatie mislukt: authenticatie vereist. Controleer je Hugging Face API-token in Instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalacja nie powiod\u0142a si\u0119: wymagane uwierzytelnienie. Sprawd\u017a token API Hugging Face w Ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha na instala\u00e7\u00e3o: autentica\u00e7\u00e3o necess\u00e1ria. Verifique seu token da API do Hugging Face em Configura\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0431\u043e\u0439 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438: \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f. \u041f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0442\u043e\u043a\u0435\u043d API Hugging Face \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installationen misslyckades: autentisering kr\u00e4vs. Kontrollera din Hugging Face API-token i Inst\u00e4llningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurulum ba\u015far\u0131s\u0131z: Kimlik do\u011frulama gerekli. Ayarlar'da Hugging Face API belirtecinizi kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043c\u0438\u043b\u043a\u0430 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f: \u043f\u043e\u0442\u0440\u0456\u0431\u043d\u0430 \u0430\u0432\u0442\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044f. \u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0442\u043e\u043a\u0435\u043d API Hugging Face \u0443 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0430\u0445."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e0i \u0111\u1eb7t th\u1ea5t b\u1ea1i: C\u1ea7n x\u00e1c th\u1ef1c. H\u00e3y ki\u1ec3m tra m\u00e3 th\u00f4ng b\u00e1o API Hugging Face trong C\u00e0i \u0111\u1eb7t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b89\u88c5\u5931\u8d25\uff1a\u9700\u8981\u8eab\u4efd\u9a8c\u8bc1\u3002\u8bf7\u5728\u201c\u8bbe\u7f6e\u201d\u4e2d\u68c0\u67e5\u4f60\u7684 Hugging Face API \u4ee4\u724c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b89\u88dd\u5931\u6557\uff1a\u9700\u8981\u9a57\u8b49\u3002\u8acb\u5728\u300c\u8a2d\u5b9a\u300d\u4e2d\u6aa2\u67e5\u4f60\u7684 Hugging Face API \u6b0a\u6756\u3002"
          }
        }
      }
    },
