        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently remove the model files (%@) from disk at:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminar\u00e1 permanentemente los archivos del modelo (%@) del disco en:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera d\u00e9finitivement les fichiers du mod\u00e8le (%@) du disque \u00e0 l'emplacement :\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d6\u05d5 \u05ea\u05e1\u05d9\u05e8 \u05dc\u05e6\u05de\u05d9\u05ea\u05d5\u05ea \u05d0\u05ea \u05e7\u05d1\u05e6\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc (%@) \u05de\u05d4\u05d3\u05d9\u05e1\u05e7 \u05d1\u05db\u05ea\u05d5\u05d1\u05ea:\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0921\u093f\u0938\u094d\u0915 \u0938\u0947 \u092e\u0949\u0921\u0932 \u092b\u093c\u093e\u0907\u0932\u094b\u0902 (%@) \u0915\u094b \u092f\u0939\u093e\u0901 \u0938\u0947 \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0939\u091f\u093e \u0926\u0947\u0917\u093e:\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus file model (%@) secara permanen dari disk di:\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci\u00f2 rimuover\u00e0 definitivamente i file del modello (%@) dal disco in:\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u308c\u306b\u3088\u308a\u3001\u30c7\u30a3\u30b9\u30af\u4e0a\u306e\u6b21\u306e\u5834\u6240\u306b\u3042\u308b\u30e2\u30c7\u30eb\u30d5\u30a1\u30a4\u30eb\uff08%@\uff09\u304c\u5b8c\u5168\u306b\u524a\u9664\u3055\u308c\u307e\u3059:\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ub807\uac8c \ud558\uba74 \ub514\uc2a4\ud06c\uc758 \ub2e4\uc74c \uc704\uce58\uc5d0\uc11c \ubaa8\ub378 \ud30c\uc77c(%@)\uc774 \uc601\uad6c\uc801\uc73c\ub85c \uc81c\uac70\ub429\ub2c8\ub2e4:\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de modelbestanden (%@) permanent van de schijf verwijderd op:\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwa\u0142e usuni\u0119cie plik\u00f3w modelu (%@) z dysku w lokalizacji:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remover\u00e1 permanentemente os arquivos do modelo (%@) do disco em:\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043a \u0431\u0435\u0437\u0432\u043e\u0437\u0432\u0440\u0430\u0442\u043d\u043e\u043c\u0443 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044e \u0444\u0430\u0439\u043b\u043e\u0432 \u043c\u043e\u0434\u0435\u043b\u0438 (%@) \u0441 \u0434\u0438\u0441\u043a\u0430 \u043f\u043e \u0430\u0434\u0440\u0435\u0441\u0443:\n%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar permanent bort modellfilerna (%@) fr\u00e5n disken p\u00e5:\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu i\u015flem, model dosyalar\u0131n\u0131 (%@) \u015fu konumdaki diskten kal\u0131c\u0131 olarak kald\u0131racakt\u0131r:\n%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435 \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u044c \u0444\u0430\u0439\u043b\u0438 \u043c\u043e\u0434\u0435\u043b\u0456 (%@) \u0437 \u0434\u0438\u0441\u043a\u0430 \u0437\u0430 \u0448\u043b\u044f\u0445\u043e\u043c:\n%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao t\u00e1c n\u00e0y s\u1ebd x\u00f3a v\u0129nh vi\u1ec5n c\u00e1c t\u1ec7p m\u00f4 h\u00ecnh (%@) kh\u1ecfi \u0111\u0129a t\u1ea1i:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u5c06\u4ece\u78c1\u76d8\u4e0a\u7684\u4ee5\u4e0b\u4f4d\u7f6e\u6c38\u4e45\u5220\u9664\u6a21\u578b\u6587\u4ef6\uff08%@\uff09\uff1a\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u5c07\u5f9e\u78c1\u789f\u4e0a\u7684\u4ee5\u4e0b\u4f4d\u7f6e\u6c38\u4e45\u522a\u9664\u6a21\u578b\u6a94\u6848\uff08%@\uff09\uff1a\n%@"
          }
        }
      }
    },
    "This repository publishes %lld GGUF variants. Select a specific file to probe and install.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0646\u0634\u0631 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639 %lld \u0645\u0646 \u0645\u062a\u063a\u064a\u0631\u0627\u062a GGUF. \u062d\u062f\u062f \u0645\u0644\u0641\u064b\u0627 \u0645\u062d\u062f\u062f\u064b\u0627 \u0644\u0641\u062d\u0635\u0647 \u0648\u062a\u062b\u0628\u064a\u062a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository ver\u00f6ffentlicht %lld GGUF-Varianten. W\u00e4hlen Sie eine bestimmte Datei zum Testen und Installieren aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This repository publishes %lld GGUF variants. Select a specific file to probe and install."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este repositorio publica %lld variantes de GGUF. Selecciona un archivo espec\u00edfico para probar e instalar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce d\u00e9p\u00f4t publie %lld variantes GGUF. S\u00e9lectionnez un fichier sp\u00e9cifique \u00e0 sonder et \u00e0 installer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d0\u05d2\u05e8 \u05d6\u05d4 \u05de\u05e4\u05e8\u05e1\u05dd %lld \u05d2\u05e8\u05e1\u05d0\u05d5\u05ea GGUF. \u05d1\u05d7\u05e8 \u05e7\u05d5\u05d1\u05e5 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d5\u05d4\u05ea\u05e7\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0930\u093f\u092a\u0949\u091c\u093f\u091f\u0930\u0940 %lld GGUF \u0935\u0947\u0930\u093f\u090f\u0902\u091f \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 \u0915\u0930\u0924\u0940 \u0939\u0948\u0964 \u091c\u093e\u0902\u091a \u0914\u0930 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u092b\u093c\u093e\u0907\u0932 \u0915\u093e \u091a\u092f\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori ini menerbitkan %lld varian GGUF. Pilih file tertentu untuk diselidiki dan dipasang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo repository pubblica %lld varianti GGUF. Seleziona un file specifico da verificare e installare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u306f %lld \u500b\u306e GGUF \u30d0\u30ea\u30a2\u30f3\u30c8\u3092\u516c\u958b\u3057\u3066\u3044\u307e\u3059\u3002\u30d7\u30ed\u30fc\u30d6\u3057\u3066\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3059\u308b\u7279\u5b9a\u306e\u30d5\u30a1\u30a4\u30eb\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc800\uc7a5\uc18c\ub294 %lld\uac1c\uc758 GGUF \ubcc0\ud615\uc744 \uac8c\uc2dc\ud569\ub2c8\ub2e4. \ud504\ub85c\ube0c\ud558\uace0 \uc124\uce58\ud560 \ud2b9\uc815 \ud30c\uc77c\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze repository publiceert %lld GGUF-varianten. Selecteer een specifiek bestand om te testen en te installeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To repozytorium publikuje %lld wariant\u00f3w GGUF. Wybierz konkretny plik do zbadania i zainstalowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este reposit\u00f3rio publica %lld variantes GGUF. Selecione um arquivo espec\u00edfico para sondar e instalar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e\u0442 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439 \u043f\u0443\u0431\u043b\u0438\u043a\u0443\u0435\u0442 \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u043e\u0432 GGUF: %lld. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u044b\u0439 \u0444\u0430\u0439\u043b \u0434\u043b\u044f \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0438 \u0438 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta arkiv publicerar %lld GGUF-varianter. V\u00e4lj en specifik fil att unders\u00f6ka och installera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo %lld GGUF varyant\u0131 yay\u0131nl\u0131yor. Ara\u015ft\u0131rmak ve y\u00fcklemek i\u00e7in belirli bir dosya se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u0439 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0456\u0439 \u043f\u0443\u0431\u043b\u0456\u043a\u0443\u0454 \u0432\u0430\u0440\u0456\u0430\u043d\u0442\u0456\u0432 GGUF: %lld. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0438\u0439 \u0444\u0430\u0439\u043b \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u0442\u0430 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho l\u01b0u tr\u1eef n\u00e0y xu\u1ea5t b\u1ea3n %lld bi\u1ebfn th\u1ec3 GGUF. Ch\u1ecdn m\u1ed9t t\u1ec7p c\u1ee5 th\u1ec3 \u0111\u1ec3 th\u0103m d\u00f2 v\u00e0 c\u00e0i \u0111\u1eb7t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u4ed3\u5e93\u53d1\u5e03\u4e86 %lld \u4e2a GGUF \u53d8\u4f53\u3002\u8bf7\u9009\u62e9\u7279\u5b9a\u6587\u4ef6\u8fdb\u884c\u63a2\u6d4b\u548c\u5b89\u88c5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u5132\u5b58\u5eab\u767c\u5e03\u4e86 %lld \u500b GGUF \u8b8a\u9ad4\u3002\u8acb\u9078\u64c7\u7279\u5b9a\u6a94\u6848\u9032\u884c\u63a2\u6e2c\u548c\u5b89\u88dd\u3002"
          }
        }
      }
    },
