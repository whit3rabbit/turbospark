        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ex\u00e9cuter en arri\u00e8re-plan de mani\u00e8re asynchrone (non bloquant)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e2\u05dc \u05d1\u05e8\u05e7\u05e2 \u05d1\u05d0\u05d5\u05e4\u05df \u05d0\u05e1\u05d9\u05e0\u05db\u05e8\u05d5\u05e0\u05d9 (\u05dc\u05d0 \u05d7\u05d5\u05e1\u05dd)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0943\u0937\u094d\u0920\u092d\u0942\u092e\u093f \u092e\u0947\u0902 \u090f\u0938\u093f\u0902\u0915\u094d\u0930\u094b\u0928\u0938 \u0930\u0942\u092a \u0938\u0947 \u091a\u0932\u093e\u090f\u0902 (\u0917\u0948\u0930-\u0905\u0935\u0930\u094b\u0927\u0915)"
          }
        },
        "id": {
          "stringUnit": {
