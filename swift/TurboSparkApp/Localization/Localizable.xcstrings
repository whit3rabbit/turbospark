    "The same draft and seed give the same rewrite.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same draft and seed give the same rewrite."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المسودة نفسها مع البذرة نفسها تعطي إعادة الصياغة نفسها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Derselbe Entwurf mit demselben Seed ergibt dieselbe Umschreibung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El mismo borrador con la misma semilla da la misma reescritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le même brouillon avec la même graine donne la même réécriture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אותה טיוטה עם אותו סיד נותנת את אותו שכתוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक ही ड्राफ़्ट और एक ही सीड से एक ही पुनर्लेखन मिलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf dan seed yang sama menghasilkan tulis ulang yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La stessa bozza con lo stesso seed produce la stessa riscrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同じ下書きと同じシードからは同じ書き直しが得られます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "같은 초안과 같은 시드는 같은 결과를 냅니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetzelfde concept met dezelfde seed geeft dezelfde herschrijving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sama wersja robocza z tym samym ziarnem daje ten sam przepisany tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo rascunho com o mesmo seed gera a mesma reescrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один и тот же черновик с тем же сидом даёт тот же результат."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma utkast med samma seed ger samma omskrivning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı taslak ve aynı tohum aynı yeniden yazımı verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Та сама чернетка з тим самим сідом дає той самий результат."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng bản nháp và cùng hạt giống sẽ cho cùng một bản viết lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的草稿和随机种子会得到相同的改写结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "相同的草稿和隨機種子會得到相同的改寫結果。"
          }
        }
      }
    },
