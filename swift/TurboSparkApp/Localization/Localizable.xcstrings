    "Could not open Terminal: %@. The command was copied to the clipboard instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631 \u0641\u062a\u062d Terminal: \u200f%@. \u0646\u064f\u0633\u062e \u0627\u0644\u0623\u0645\u0631 \u0625\u0644\u0649 \u0627\u0644\u062d\u0627\u0641\u0638\u0629 \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0630\u0644\u0643."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal konnte nicht ge\u00f6ffnet werden: %@. Der Befehl wurde stattdessen in die Zwischenablage kopiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not open Terminal: %@. The command was copied to the clipboard instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir Terminal: %@. El comando se copi\u00f3 al portapapeles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'ouvrir Terminal : %@. La commande a \u00e9t\u00e9 copi\u00e9e dans le presse-papiers \u00e0 la place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e4\u05ea\u05d5\u05d7 \u05d0\u05ea Terminal: \u200f%@. \u05d4\u05e4\u05e7\u05d5\u05d3\u05d4 \u05d4\u05d5\u05e2\u05ea\u05e7\u05d4 \u05dc\u05dc\u05d5\u05d7 \u05d1\u05de\u05e7\u05d5\u05dd \u05d6\u05d0\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal \u0928\u0939\u0940\u0902 \u0916\u0941\u0932 \u0938\u0915\u093e: %@\u0964 \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f \u0915\u092e\u093e\u0902\u0921 \u0915\u094d\u0932\u093f\u092a\u092c\u094b\u0930\u094d\u0921 \u092a\u0930 \u0915\u0949\u092a\u0940 \u0915\u0930 \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat membuka Terminal: %@. Perintah disalin ke papan klip sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile aprire Terminale: %@. Il comando \u00e8 stato copiato negli appunti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30fc\u30df\u30ca\u30eb\u3092\u958b\u3051\u307e\u305b\u3093\u3067\u3057\u305f\uff1a%@\u3002\u4ee3\u308f\u308a\u306b\u30b3\u30de\u30f3\u30c9\u3092\u30af\u30ea\u30c3\u30d7\u30dc\u30fc\u30c9\u306b\u30b3\u30d4\u30fc\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud130\ubbf8\ub110\uc744 \uc5f4 \uc218 \uc5c6\uc74c: %@. \ub300\uc2e0 \uba85\ub839\uc744 \ud074\ub9bd\ubcf4\ub4dc\uc5d0 \ubcf5\uc0ac\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan Terminal niet openen: %@. De opdracht is in plaats daarvan naar het klembord gekopieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna otworzy\u0107 Terminala: %@. Zamiast tego skopiowano polecenie do schowka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel abrir o Terminal: %@. O comando foi copiado para a \u00e1rea de transfer\u00eancia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u0422\u0435\u0440\u043c\u0438\u043d\u0430\u043b: %@. \u0412\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u043a\u043e\u043c\u0430\u043d\u0434\u0430 \u0441\u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0430 \u0432 \u0431\u0443\u0444\u0435\u0440 \u043e\u0431\u043c\u0435\u043d\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att \u00f6ppna Terminal: %@. Kommandot kopierades till urklipp i st\u00e4llet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal a\u00e7\u0131lamad\u0131: %@. Bunun yerine komut panoya kopyaland\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438 \u0422\u0435\u0440\u043c\u0456\u043d\u0430\u043b: %@. \u041d\u0430\u0442\u043e\u043c\u0456\u0441\u0442\u044c \u043a\u043e\u043c\u0430\u043d\u0434\u0443 \u0441\u043a\u043e\u043f\u0456\u0439\u043e\u0432\u0430\u043d\u043e \u0432 \u0431\u0443\u0444\u0435\u0440 \u043e\u0431\u043c\u0456\u043d\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 m\u1edf Terminal: %@. L\u1ec7nh \u0111\u00e3 \u0111\u01b0\u1ee3c sao ch\u00e9p v\u00e0o b\u1ea3ng nh\u1edb t\u1ea1m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u6253\u5f00\u7ec8\u7aef\uff1a%@\u3002\u5df2\u6539\u4e3a\u5c06\u547d\u4ee4\u590d\u5236\u5230\u526a\u8d34\u677f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u6253\u958b\u7d42\u7aef\u6a5f\uff1a%@\u3002\u5df2\u6539\u70ba\u5c07\u6307\u4ee4\u8907\u88fd\u5230\u526a\u8cbc\u7c3f\u3002"
          }
        }
      }
    },
