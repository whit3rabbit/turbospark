    "Controls cannot be changed while a model is installing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controls cannot be changed while a model is installing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los controles no se pueden cambiar mientras se instala un modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les commandes ne peuvent pas être modifiées pendant l'installation d'un modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuerelemente können während der Installation eines Modells nicht geändert werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I controlli non possono essere modificati durante l'installazione di un modello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os controles não podem ser alterados enquanto um modelo estiver sendo instalado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bedieningselementen kunnen niet worden gewijzigd terwijl een model wordt geïnstalleerd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontroller kan inte ändras medan en modell installeras."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementów sterujących nie można zmieniać podczas instalowania modelu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элементы управления нельзя изменить во время установки модели."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елементи керування не можна змінювати під час встановлення моделі."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir model yüklenirken kontroller değiştirilemez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير عناصر التحكم أثناء تثبيت النموذج."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשנות פקדים בזמן שהמודל מותקן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल स्थापित होने के दौरान नियंत्रणों को बदला नहीं जा सकता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在安装模型时无法更改控件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在安裝模型時無法變更控制項。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのインストール中はコントロールを変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 설치되는 동안에는 컨트롤을 변경할 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi các nút điều khiển khi mô hình đang được cài đặt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
