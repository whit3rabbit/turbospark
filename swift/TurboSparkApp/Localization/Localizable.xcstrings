          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terus bekerja sampai suatu kondisi terpenuhi: /goal <condition>"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua a lavorare finché una condizione non è soddisfatta: /goal <condition>"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件が満たされるまで作業を続ける: /goal <condition>"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조건이 충족될 때까지 계속 작업: /goal <condition>"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doorwerken tot aan een voorwaarde is voldaan: /goal <condition>"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pracuj dalej, aż warunek zostanie spełniony: /goal <condition>"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuar trabalhando até uma condição ser atendida: /goal <condition>"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Продолжать работу, пока условие не выполнится: /goal <condition>"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsätt arbeta tills ett villkor är uppfyllt: /goal <condition>"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir koşul sağlanana kadar çalışmaya devam et: /goal <condition>"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Продовжувати роботу, доки умову не буде виконано: /goal <condition>"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
