    "This needs up to %@ temporarily, but %@ has only %@ free. Verified download ranges are kept until the install passes verification, then removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا إلى ما يصل إلى %@ مؤقتًا، لكن %@ لا يتوفر فيها سوى %@ مساحة خالية. تُحفَظ نطاقات التنزيل التي تم التحقق منها إلى أن يجتاز التثبيت التحقق، ثم تُزال."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dafür werden vorübergehend bis zu %@ benötigt, aber %@ hat nur %@ frei. Geprüfte Download-Bereiche bleiben erhalten, bis die Installation die Prüfung besteht, und werden dann entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This needs up to %@ temporarily, but %@ has only %@ free. Verified download ranges are kept until the install passes verification, then removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto necesita hasta %@ temporalmente, pero %@ solo tiene %@ libres. Los rangos de descarga verificados se conservan hasta que la instalación supera la verificación y luego se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela nécessite temporairement jusqu'à %@, mais %@ ne dispose que de %@ d'espace libre. Les plages de téléchargement vérifiées sont conservées jusqu'à la réussite de la vérification de l'installation, puis supprimées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה דורשת עד %@ באופן זמני, אבל ב-%@ יש רק %@ פנויים. טווחי ההורדה שאומתו נשמרים עד שההתקנה עוברת אימות, ואז הם מוסרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए अस्थायी रूप से %@ तक की ज़रूरत है, लेकिन %@ में केवल %@ खाली है। सत्यापित डाउनलोड रेंज तब तक रखी जाती हैं जब तक इंस्टॉलेशन सत्यापन पास नहीं कर लेता, फिर उन्हें हटा दिया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini membutuhkan hingga %@ untuk sementara, tetapi %@ hanya memiliki %@ tersedia. Rentang unduhan yang telah diverifikasi disimpan hingga pemasangan lulus verifikasi, lalu dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Servono temporaneamente fino a %@, ma %@ ha solo %@ liberi. Gli intervalli di download verificati vengono conservati finché l'installazione non supera la verifica, poi vengono rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的に最大 %@ が必要ですが、%@ の空き容量は %@ しかありません。検証済みのダウンロード範囲は、インストールが検証に合格するまで保持され、その後削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일시적으로 최대 %@이(가) 필요하지만 %@에는 %@만 남아 있습니다. 검증된 다운로드 범위는 설치가 검증을 통과할 때까지 보관된 후 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiervoor is tijdelijk tot %@ nodig, maar %@ heeft slechts %@ vrij. Geverifieerde downloadbereiken blijven bewaard totdat de installatie de verificatie doorstaat en worden dan verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potrzeba na to tymczasowo do %@, ale %@ ma tylko %@ wolnego miejsca. Zweryfikowane zakresy pobierania są przechowywane, dopóki instalacja nie przejdzie weryfikacji, a następnie usuwane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto precisa de até %@ temporariamente, mas %@ tem apenas %@ livres. Os intervalos de download verificados são mantidos até a instalação passar na verificação e depois são removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временно требуется до %@, но на %@ свободно только %@. Проверенные диапазоны загрузки хранятся, пока установка не пройдёт проверку, после чего удаляются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta behöver tillfälligt upp till %@, men %@ har bara %@ ledigt. Verifierade nedladdningsintervall behålls tills installationen klarar verifieringen och tas sedan bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunun için geçici olarak %@ kadar alan gerekiyor, ancak %@ içinde yalnızca %@ boş alan var. Doğrulanmış indirme aralıkları, kurulum doğrulamayı geçene kadar tutulur, sonra kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цього тимчасово потрібно до %@, але на %@ вільно лише %@. Перевірені діапазони завантаження зберігаються, доки встановлення не пройде перевірку, після чого видаляються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Việc này cần tạm thời tối đa %@, nhưng %@ chỉ còn trống %@. Các phạm vi tải xuống đã xác minh được giữ lại cho đến khi bản cài đặt vượt qua bước xác minh, rồi sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这需要临时占用最多 %@，但 %@ 只剩 %@ 可用空间。已验证的下载片段会保留到安装通过验证，然后被移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這需要暫時佔用最多 %@，但 %@ 只剩 %@ 可用空間。已驗證的下載片段會保留到安裝通過驗證，然後被移除。"
          }
        }
      }
    },
    "This operation cannot process the full recording. Choose a shorter source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation cannot process the full recording. Choose a shorter source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operación no puede procesar la grabación completa. Elige una fuente más corta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette opération ne peut pas traiter l'enregistrement entier. Choisissez une source plus courte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktion kann die vollständige Aufnahme nicht verarbeiten. Wähle eine kürzere Quelle."
