    "Multi-part files not listed: %lld. This port cannot walk a shard set.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0644\u0641\u0627\u062a \u0645\u062a\u0639\u062f\u062f\u0629 \u0627\u0644\u0623\u062c\u0632\u0627\u0621 \u063a\u064a\u0631 \u0645\u062f\u0631\u062c\u0629: %lld. \u0644\u0627 \u064a\u0633\u062a\u0637\u064a\u0639 \u0647\u0630\u0627 \u0627\u0644\u0645\u0646\u0641\u0630 \u0642\u0631\u0627\u0621\u0629 \u0645\u062c\u0645\u0648\u0639\u0629 \u0623\u062c\u0632\u0627\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht aufgef\u00fchrte mehrteilige Dateien: %lld. Diese Portierung kann keine Shard-S\u00e4tze durchlaufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-part files not listed: %lld. This port cannot walk a shard set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivos de varias partes no listados: %lld. Esta versi\u00f3n no puede recorrer un conjunto de fragmentos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichiers en plusieurs parties non list\u00e9s : %lld. Ce portage ne peut pas parcourir un ensemble de fragments."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05e8\u05d5\u05d1\u05d9 \u05d7\u05dc\u05e7\u05d9\u05dd \u05e9\u05dc\u05d0 \u05e0\u05db\u05dc\u05dc\u05d5: %lld. \u05d4\u05e4\u05d5\u05e8\u05d8 \u05d4\u05d6\u05d4 \u05dc\u05d0 \u05d9\u05db\u05d5\u05dc \u05dc\u05e2\u05d1\u05d5\u05e8 \u05e2\u05dc \u05e1\u05d8 \u05de\u05e7\u05d8\u05e2\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0942\u091a\u0940 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0926\u093f\u0916\u093e\u0908 \u0917\u0908 \u092c\u0939\u0941-\u092d\u093e\u0917 \u092b\u093c\u093e\u0907\u0932\u0947\u0902: %lld\u0964 \u092f\u0939 \u092a\u094b\u0930\u094d\u091f \u0936\u093e\u0930\u094d\u0921 \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u092a\u0922\u093c \u0938\u0915\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File multi-bagian yang tidak dicantumkan: %lld. Port ini tidak dapat menelusuri set shard."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "File in pi\u00f9 parti non elencati: %lld. Questo port non pu\u00f2 scorrere un set di shard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u89a7\u306b\u306a\u3044\u5206\u5272\u30d5\u30a1\u30a4\u30eb: %lld\u3002\u3053\u306e\u79fb\u690d\u7248\u306f\u30b7\u30e3\u30fc\u30c9\u30bb\u30c3\u30c8\u3092\u8aad\u307f\u8fbc\u3081\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa9\ub85d\uc5d0 \uc5c6\ub294 \ub2e4\uc911 \ud30c\ud2b8 \ud30c\uc77c: %lld. \uc774 \ud3ec\ud2b8\ub294 \uc0e4\ub4dc \uc138\ud2b8\ub97c \ud0d0\uc0c9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet-weergegeven bestanden uit meerdere delen: %lld. Deze port kan geen shardset doorlopen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pomini\u0119te pliki wielocz\u0119\u015bciowe: %lld. Ten port nie obs\u0142uguje zestaw\u00f3w fragment\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivos em v\u00e1rias partes n\u00e3o listados: %lld. Este port n\u00e3o consegue percorrer um conjunto de fragmentos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u043c\u043d\u043e\u0433\u043e\u0447\u0430\u0441\u0442\u043d\u044b\u0445 \u0444\u0430\u0439\u043b\u043e\u0432: %lld. \u042d\u0442\u043e\u0442 \u043f\u043e\u0440\u0442 \u043d\u0435 \u0443\u043c\u0435\u0435\u0442 \u0447\u0438\u0442\u0430\u0442\u044c \u043d\u0430\u0431\u043e\u0440\u044b \u0448\u0430\u0440\u0434\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flerdelade filer som inte listas: %lld. Den h\u00e4r porten kan inte g\u00e5 igenom en shard-upps\u00e4ttning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Listelenmeyen \u00e7ok par\u00e7al\u0131 dosyalar: %lld. Bu port par\u00e7a k\u00fcmelerini i\u015fleyemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u043e\u043a\u0430\u0437\u0430\u043d\u043e \u0431\u0430\u0433\u0430\u0442\u043e\u0447\u0430\u0441\u0442\u0438\u043d\u043d\u0438\u0445 \u0444\u0430\u0439\u043b\u0456\u0432: %lld. \u0426\u0435\u0439 \u043f\u043e\u0440\u0442 \u043d\u0435 \u0432\u043c\u0456\u0454 \u0447\u0438\u0442\u0430\u0442\u0438 \u043d\u0430\u0431\u043e\u0440\u0438 \u0448\u0430\u0440\u0434\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ec7p nhi\u1ec1u ph\u1ea7n kh\u00f4ng \u0111\u01b0\u1ee3c li\u1ec7t k\u00ea: %lld. B\u1ea3n port n\u00e0y kh\u00f4ng th\u1ec3 duy\u1ec7t b\u1ed9 ph\u00e2n \u0111o\u1ea1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u5217\u51fa\u7684\u5206\u7247\u6587\u4ef6\uff1a%lld\u3002\u6b64\u79fb\u690d\u7248\u672c\u65e0\u6cd5\u904d\u5386\u5206\u7247\u96c6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u5217\u51fa\u7684\u5206\u7247\u6a94\u6848\uff1a%lld\u3002\u6b64\u79fb\u690d\u7248\u672c\u7121\u6cd5\u8d70\u8a2a\u5206\u7247\u96c6\u3002"
          }
        }
      }
    },
