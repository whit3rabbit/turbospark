        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa dalla pagina visualizzata al suo sorgente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8868\u793a\u30da\u30fc\u30b8\u3068\u30bd\u30fc\u30b9\u3092\u5207\u308a\u66ff\u3048\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub80c\ub354\ub9c1\ub41c \ud398\uc774\uc9c0\uc640 \uc18c\uc2a4 \uac04 \uc804\ud658"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisselen tussen de weergegeven pagina en de bron"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prze\u0142\u0105cz mi\u0119dzy wyrenderowan\u0105 stron\u0105 a jej \u017ar\u00f3d\u0142em"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alternar entre a p\u00e1gina renderizada e o c\u00f3digo-fonte"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u044c\u0441\u044f \u043c\u0435\u0436\u0434\u0443 \u043e\u0442\u043e\u0431\u0440\u0430\u0436\u0451\u043d\u043d\u043e\u0439 \u0441\u0442\u0440\u0430\u043d\u0438\u0446\u0435\u0439 \u0438 \u0435\u0451 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u043c \u043a\u043e\u0434\u043e\u043c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4xla mellan den \u00e5tergivna sidan och k\u00e4llkoden"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130\u015flenmi\u015f sayfa ile kayna\u011f\u0131 aras\u0131nda ge\u00e7i\u015f yap"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u043a\u043d\u0443\u0442\u0438\u0441\u044f \u043c\u0456\u0436 \u0432\u0456\u0434\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043e\u044e \u0441\u0442\u043e\u0440\u0456\u043d\u043a\u043e\u044e \u0442\u0430 \u0457\u0457 \u043a\u043e\u0434\u043e\u043c"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuy\u1ec3n gi\u1eefa trang \u0111\u00e3 hi\u1ec3n th\u1ecb v\u00e0 m\u00e3 ngu\u1ed3n c\u1ee7a n\u00f3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6e32\u67d3\u9875\u9762\u548c\u6e90\u4ee3\u7801\u4e4b\u95f4\u5207\u6362"
          }
        },
        "zh-Hant": {
