            "state": "translated",
            "value": "З поверненням! Над чим працюємо?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välkommen tillbaka! Vad jobbar vi på?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng trở lại! Chúng ta đang làm gì nào?"
