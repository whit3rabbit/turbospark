    "Repeat a hook or phrase across sections so the song feels connected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat a hook or phrase across sections so the song feels connected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كرّر جملة لافتة أو عبارة عبر الأقسام ليبدو للأغنية ترابط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole einen Hook oder eine Phrase über Abschnitte hinweg, damit der Song zusammenhängend wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite un gancho o una frase entre secciones para que la canción se sienta cohesionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répétez une accroche ou une phrase d'une section à l'autre pour donner de la cohésion au morceau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חזור על הוק או ביטוי בין המקטעים כדי שהשיר ירגיש מחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गाने में जुड़ाव महसूस हो, इसलिए किसी हुक या वाक्यांश को अलग-अलग सेक्शन में दोहराएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi hook atau frasa di beberapa bagian agar lagu terasa menyatu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti un hook o una frase tra le sezioni per far sembrare la canzone coerente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "曲にまとまりを持たせるため、フックやフレーズを複数のセクションで繰り返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "곡이 하나로 이어지도록 후크나 구절을 여러 섹션에 걸쳐 반복하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaal een hook of zinsdeel in meerdere secties zodat het nummer samenhangend aanvoelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powtórz chwytliwy motyw lub frazę w kilku sekcjach, aby piosenka brzmiała spójnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita um gancho ou uma frase entre as seções para que a música soe conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторяйте хук или фразу в разных разделах, чтобы песня казалась цельной."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upprepa en hook eller fras mellan sektionerna så att låten känns sammanhängande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Akılda kalıcı bir ifadeyi bölümler arasında tekrarlayın, böylece şarkı bütünlüklü hissettirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повторюйте хук або фразу в різних розділах, щоб пісня здавалася цілісною."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lặp lại một đoạn hook hoặc cụm từ giữa các phần để bài hát có cảm giác liền mạch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在不同段落重复钩子或短语，让歌曲听起来前后连贯。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在不同段落重複鉤子或短語，讓歌曲聽起來前後連貫。"
          }
        }
      }
    },
