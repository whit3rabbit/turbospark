    "A device policy blocks a selected source. Turn that source off to record without it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A device policy blocks a selected source. Turn that source off to record without it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una política del dispositivo bloquea una fuente seleccionada. Desactiva esa fuente para grabar sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une règle de l'appareil bloque une source sélectionnée. Désactivez cette source pour enregistrer sans elle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Geräterichtlinie blockiert eine ausgewählte Quelle. Schalte diese Quelle aus, um ohne sie aufzunehmen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un criterio del dispositivo blocca una sorgente selezionata. Disattiva quella sorgente per registrare senza di essa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma política do dispositivo bloqueia uma fonte selecionada. Desative essa fonte para gravar sem ela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Политика устройства блокирует выбранный источник. Отключите этот источник, чтобы записывать без него."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスのポリシーにより、選択したソースがブロックされています。そのソースをオフにすると、それ以外で録音できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기기 정책이 선택한 소스를 차단합니다. 해당 소스를 끄면 그 소스 없이 녹음할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备策略阻止了所选来源。关闭该来源即可在不使用它的情况下录音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "裝置原則封鎖了所選來源。關閉該來源即可在不使用它的情況下錄音。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحظر سياسة الجهاز مصدرًا محددًا. أوقف تشغيل هذا المصدر للتسجيل بدونه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מדיניות מכשיר חוסמת מקור שנבחר. יש לכבות את המקור הזה כדי להקליט בלעדיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिवाइस नीति किसी चुने गए स्रोत को ब्लॉक करती है। उसके बिना रिकॉर्ड करने के लिए उस स्रोत को बंद करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een apparaatbeleid blokkeert een geselecteerde bron. Schakel die bron uit om zonder die bron op te nemen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zasady urządzenia blokują wybrane źródło. Wyłącz to źródło, aby nagrywać bez niego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir cihaz politikası seçili bir kaynağı engelliyor. Onsuz kayıt yapmak için o kaynağı kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Політика пристрою блокує вибране джерело. Вимкніть це джерело, щоб записувати без нього."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En enhetspolicy blockerar en vald källa. Stäng av den källan för att spela in utan den."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chính sách thiết bị đang chặn một nguồn đã chọn. Hãy tắt nguồn đó để ghi mà không có nó."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kebijakan perangkat memblokir sumber yang dipilih. Matikan sumber tersebut untuk merekam tanpanya."
          }
        }
      }
    },
