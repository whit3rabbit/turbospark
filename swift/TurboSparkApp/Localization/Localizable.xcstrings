            "value": "\u05e4\u05d5\u05ea\u05d7 \u05d1\u05d5\u05d7\u05e8 \u05e7\u05d1\u05e6\u05d9\u05dd \u05dc\u05e6\u05d9\u05e8\u05d5\u05e3 \u05de\u05e1\u05de\u05db\u05d9\u05dd \u05dc\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d6\u05d5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u092e\u0947\u0902 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u0938\u0902\u0932\u0917\u094d\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u093c\u093e\u0907\u0932 \u091a\u092f\u0928\u0915\u0930\u094d\u0924\u093e \u0916\u094b\u0932\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka pemilih file untuk melampirkan dokumen ke prompt ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre un selettore di file per allegare documenti a questo prompt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30f3\u30d7\u30c8\u306b\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u3092\u6dfb\u4ed8\u3059\u308b\u305f\u3081\u306e\u30d5\u30a1\u30a4\u30eb\u9078\u629e\u3092\u958b\u304d\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub86c\ud504\ud2b8\uc5d0 \ubb38\uc11c\ub97c \ucca8\ubd80\ud560 \ud30c\uc77c \uc120\ud0dd\uae30\ub97c \uc5fd\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een bestandskiezer om documenten aan deze prompt toe te voegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera okno wyboru plik\u00f3w, aby za\u0142\u0105czy\u0107 dokumenty do tego promptu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um seletor de arquivos para anexar documentos a este prompt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u043e\u043a\u043d\u043e \u0432\u044b\u0431\u043e\u0440\u0430 \u0444\u0430\u0439\u043b\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u044c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b \u043a \u0437\u0430\u043f\u0440\u043e\u0441\u0443"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ppnar en filv\u00e4ljare f\u00f6r att bifoga dokument till prompten"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu isteme belge eklemek i\u00e7in dosya se\u00e7iciyi a\u00e7ar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u0432\u0438\u0431\u0456\u0440 \u0444\u0430\u0439\u043b\u0456\u0432, \u0449\u043e\u0431 \u043f\u0440\u0438\u043a\u0440\u0456\u043f\u0438\u0442\u0438 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438 \u0434\u043e \u0437\u0430\u043f\u0438\u0442\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1edf tr\u00ecnh ch\u1ecdn t\u1ec7p \u0111\u1ec3 \u0111\u00ednh k\u00e8m t\u00e0i li\u1ec7u v\u00e0o l\u1eddi nh\u1eafc n\u00e0y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u5f00\u6587\u4ef6\u9009\u62e9\u5668\uff0c\u4e3a\u6b64\u63d0\u793a\u9644\u52a0\u6587\u6863"
