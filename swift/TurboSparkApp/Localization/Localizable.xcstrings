    "Brief summary of what this skill does and when to activate it...": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0644\u062e\u0635 \u0642\u0635\u064a\u0631 \u0644\u0645\u0627 \u062a\u0641\u0639\u0644\u0647 \u0647\u0630\u0647 \u0627\u0644\u0645\u0647\u0627\u0631\u0629 \u0648\u0645\u062a\u0649 \u062a\u064f\u0641\u0639\u064e\u0651\u0644\u2026"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurze Zusammenfassung, was dieser Skill tut und wann er aktiviert werden soll\u2026"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brief summary of what this skill does and when to activate it..."
