          "stringUnit": {
            "state": "translated",
            "value": "Otw\u00f3rz projekt, aby odwo\u0142ywa\u0107 si\u0119 do jego plik\u00f3w przez @."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um projeto para referenciar seus arquivos com @."
          }
