    "Welcome back! What are we working on?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back! What are we working on?"
          }
        },
        "es": {
          "stringUnit": {
