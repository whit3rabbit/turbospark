    "Path or alias to an encoder model (e.g. snowflake-arctic-embed-m) to enable /v1/embeddings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0633\u0627\u0631 \u0646\u0645\u0648\u0630\u062c \u062a\u0631\u0645\u064a\u0632 \u0623\u0648 \u0627\u0633\u0645\u0647 \u0627\u0644\u0645\u0633\u062a\u0639\u0627\u0631 (\u0645\u062b\u0644 snowflake-arctic-embed-m) \u0644\u062a\u0641\u0639\u064a\u0644 \u200e/v1/embeddings."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfad oder Alias eines Encoder-Modells (z. B. snowflake-arctic-embed-m), um /v1/embeddings zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path or alias to an encoder model (e.g. snowflake-arctic-embed-m) to enable /v1/embeddings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta o alias de un modelo codificador (p. ej., snowflake-arctic-embed-m) para habilitar /v1/embeddings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chemin ou alias d'un mod\u00e8le encodeur (p. ex. snowflake-arctic-embed-m) pour activer /v1/embeddings."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05ea\u05d9\u05d1 \u05d0\u05d5 \u05db\u05d9\u05e0\u05d5\u05d9 \u05e9\u05dc \u05de\u05d5\u05d3\u05dc \u05de\u05e7\u05d5\u05d3\u05d3 (\u05dc\u05d3\u05d5\u05d2\u05de\u05d4 snowflake-arctic-embed-m) \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u200e/v1/embeddings."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1/embeddings \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0928\u094d\u0915\u094b\u0921\u0930 \u092e\u0949\u0921\u0932 \u0915\u093e \u092a\u0925 \u092f\u093e \u0909\u092a\u0928\u093e\u092e (\u091c\u0948\u0938\u0947 snowflake-arctic-embed-m)\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalur atau alias model encoder (mis. snowflake-arctic-embed-m) untuk mengaktifkan /v1/embeddings."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorso o alias di un modello encoder (ad es. snowflake-arctic-embed-m) per abilitare /v1/embeddings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1/embeddings \u3092\u6709\u52b9\u306b\u3059\u308b\u30a8\u30f3\u30b3\u30fc\u30c0\u30fc\u30e2\u30c7\u30eb\u306e\u30d1\u30b9\u307e\u305f\u306f\u30a8\u30a4\u30ea\u30a2\u30b9\uff08\u4f8b\uff1asnowflake-arctic-embed-m\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1/embeddings\ub97c \uc0ac\uc6a9\ud558\ub824\uba74 \uc778\ucf54\ub354 \ubaa8\ub378\uc758 \uacbd\ub85c\ub098 \ubcc4\uce6d(\uc608: snowflake-arctic-embed-m)\uc744 \uc785\ub825\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pad of alias van een encodermodel (bijv. snowflake-arctic-embed-m) om /v1/embeddings in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015acie\u017cka lub alias modelu enkodera (np. snowflake-arctic-embed-m), aby w\u0142\u0105czy\u0107 /v1/embeddings."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminho ou alias de um modelo codificador (por ex. snowflake-arctic-embed-m) para ativar /v1/embeddings."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0443\u0442\u044c \u0438\u043b\u0438 \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0438\u043c \u043c\u043e\u0434\u0435\u043b\u0438-\u044d\u043d\u043a\u043e\u0434\u0435\u0440\u0430 (\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, snowflake-arctic-embed-m) \u0434\u043b\u044f \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f /v1/embeddings."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f6kv\u00e4g eller alias till en kodarmodell (t.ex. snowflake-arctic-embed-m) f\u00f6r att aktivera /v1/embeddings."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "/v1/embeddings'i etkinle\u015ftirmek i\u00e7in bir kodlay\u0131c\u0131 modelin yolu veya takma ad\u0131 (\u00f6r. snowflake-arctic-embed-m)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u043b\u044f\u0445 \u0430\u0431\u043e \u043f\u0441\u0435\u0432\u0434\u043e\u043d\u0456\u043c \u043c\u043e\u0434\u0435\u043b\u0456-\u0435\u043d\u043a\u043e\u0434\u0435\u0440\u0430 (\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, snowflake-arctic-embed-m), \u0449\u043e\u0431 \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 /v1/embeddings."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u01b0\u1eddng d\u1eabn ho\u1eb7c b\u00ed danh c\u1ee7a m\u00f4 h\u00ecnh m\u00e3 h\u00f3a (v\u00ed d\u1ee5 snowflake-arctic-embed-m) \u0111\u1ec3 b\u1eadt /v1/embeddings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f16\u7801\u5668\u6a21\u578b\u7684\u8def\u5f84\u6216\u522b\u540d\uff08\u5982 snowflake-arctic-embed-m\uff09\uff0c\u7528\u4e8e\u542f\u7528 /v1/embeddings\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7de8\u78bc\u5668\u6a21\u578b\u7684\u8def\u5f91\u6216\u5225\u540d\uff08\u5982 snowflake-arctic-embed-m\uff09\uff0c\u7528\u65bc\u555f\u7528 /v1/embeddings\u3002"
          }
        }
      }
    },
    "Path to a GGUF control vector file. Leave blank to disable directional steering.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0633\u0627\u0631 \u0645\u0644\u0641 \u0645\u062a\u062c\u0647 \u062a\u062d\u0643\u0645 \u0628\u062a\u0646\u0633\u064a\u0642 GGUF. \u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u062a\u0639\u0637\u064a\u0644 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0627\u062a\u062c\u0627\u0647\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pfad zu einer GGUF-Steuerungsvektordatei. Leer lassen, um die direktionale Steuerung zu deaktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Path to a GGUF control vector file. Leave blank to disable directional steering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruta a un archivo de vector de control GGUF. D\u00e9jalo en blanco para desactivar la direcci\u00f3n vectorial."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chemin vers un fichier de vecteur de contr\u00f4le GGUF. Laissez vide pour d\u00e9sactiver le guidage directionnel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05ea\u05d9\u05d1 \u05dc\u05e7\u05d5\u05d1\u05e5 \u05d5\u05e7\u05d8\u05d5\u05e8 \u05d1\u05e7\u05e8\u05d4 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 GGUF. \u05d4\u05e9\u05d0\u05e8 \u05e8\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05d1\u05d9\u05ea \u05d4\u05d9\u05d2\u05d5\u05d9 \u05db\u05d9\u05d5\u05d5\u05e0\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0935\u0947\u0915\u094d\u091f\u0930 \u092b\u093c\u093e\u0907\u0932 \u0915\u093e \u092a\u0925\u0964 \u0926\u093f\u0936\u093e\u0924\u094d\u092e\u0915 \u0938\u0902\u091a\u093e\u0932\u0928 \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalur ke file vektor kontrol GGUF. Kosongkan untuk menonaktifkan kemudi terarah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Percorso di un file di vettore di controllo GGUF. Lascia vuoto per disattivare lo sterzo direzionale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF \u5236\u5fa1\u30d9\u30af\u30c8\u30eb\u30d5\u30a1\u30a4\u30eb\u306e\u30d1\u30b9\u3002\u7a7a\u6b04\u306b\u3059\u308b\u3068\u65b9\u5411\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u3092\u7121\u52b9\u306b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF \uc81c\uc5b4 \ubca1\ud130 \ud30c\uc77c \uacbd\ub85c\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \ubc29\ud5a5\uc131 \uc870\ud5a5\uc774 \uaebc\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pad naar een GGUF-besturingsvectorbestand. Laat leeg om directionele besturing uit te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015acie\u017cka do pliku wektora kontrolnego GGUF. Pozostaw puste, aby wy\u0142\u0105czy\u0107 sterowanie kierunkowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Caminho para um arquivo de vetor de controle GGUF. Deixe em branco para desativar o direcionamento vetorial."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0443\u0442\u044c \u043a \u0444\u0430\u0439\u043b\u0443 \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f GGUF. \u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f6kv\u00e4g till en GGUF-kontrollvektorfil. L\u00e4mna tomt f\u00f6r att st\u00e4nga av riktningsstyrning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir GGUF kontrol vekt\u00f6r\u00fc dosyas\u0131n\u0131n yolu. Y\u00f6nlendirmeyi kapatmak i\u00e7in bo\u015f b\u0131rak\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u043b\u044f\u0445 \u0434\u043e \u0444\u0430\u0439\u043b\u0443 \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f GGUF. \u0417\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c, \u0449\u043e\u0431 \u0432\u0438\u043c\u043a\u043d\u0443\u0442\u0438 \u0441\u043f\u0440\u044f\u043c\u043e\u0432\u0430\u043d\u0435 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u01b0\u1eddng d\u1eabn t\u1edbi t\u1ec7p vect\u01a1 \u0111i\u1ec1u khi\u1ec3n GGUF. \u0110\u1ec3 tr\u1ed1ng \u0111\u1ec3 t\u1eaft \u0111i\u1ec1u khi\u1ec3n h\u01b0\u1edbng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF \u63a7\u5236\u5411\u91cf\u6587\u4ef6\u7684\u8def\u5f84\u3002\u7559\u7a7a\u5373\u53ef\u5173\u95ed\u5b9a\u5411\u8f6c\u5411\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF \u63a7\u5236\u5411\u91cf\u6a94\u6848\u7684\u8def\u5f91\u3002\u7559\u7a7a\u5373\u53ef\u95dc\u9589\u5b9a\u5411\u8f49\u5411\u3002"
          }
        }
      }
    },
    "Pause console display. Metrics continue updating.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u064a\u0642\u0627\u0641 \u0639\u0631\u0636 \u0648\u062d\u062f\u0629 \u0627\u0644\u062a\u062d\u0643\u0645 \u0645\u0624\u0642\u062a\u064b\u0627. \u062a\u0633\u062a\u0645\u0631 \u0627\u0644\u0645\u0642\u0627\u064a\u064a\u0633 \u0641\u064a \u0627\u0644\u062a\u062d\u062f\u064a\u062b."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsolenanzeige anhalten. Die Messwerte werden weiter aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause console display. Metrics continue updating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar la consola. Las m\u00e9tricas siguen actualiz\u00e1ndose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause l'affichage de la console. Les mesures continuent d'\u00eatre mises \u00e0 jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05d4\u05d4 \u05d0\u05ea \u05ea\u05e6\u05d5\u05d2\u05ea \u05d4\u05de\u05e1\u05d5\u05e3. \u05d4\u05de\u05d3\u05d3\u05d9\u05dd \u05de\u05de\u05e9\u05d9\u05db\u05d9\u05dd \u05dc\u05d4\u05ea\u05e2\u05d3\u05db\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0902\u0938\u094b\u0932 \u0921\u093f\u0938\u094d\u092a\u094d\u0932\u0947 \u0930\u094b\u0915\u0947\u0902\u0964 \u092e\u0947\u091f\u094d\u0930\u093f\u0915\u094d\u0938 \u0905\u092a\u0921\u0947\u091f \u0939\u094b\u0924\u0947 \u0930\u0939\u0947\u0902\u0917\u0947\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda tampilan konsol. Metrik tetap diperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa la console. Le metriche continuano ad aggiornarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30f3\u30bd\u30fc\u30eb\u8868\u793a\u3092\u4e00\u6642\u505c\u6b62\u3057\u307e\u3059\u3002\u30e1\u30c8\u30ea\u30af\u30b9\u306f\u66f4\u65b0\u3055\u308c\u7d9a\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucf58\uc194 \ud45c\uc2dc\ub97c \uc77c\uc2dc \uc815\uc9c0\ud569\ub2c8\ub2e4. \uc9c0\ud45c\ub294 \uacc4\uc18d \uc5c5\ub370\uc774\ud2b8\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Consoleweergave pauzeren. Statistieken blijven bijwerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymaj wy\u015bwietlanie konsoli. Metryki nadal si\u0119 aktualizuj\u0105."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar a exibi\u00e7\u00e3o do console. As m\u00e9tricas continuam sendo atualizadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0432\u044b\u0432\u043e\u0434 \u043a\u043e\u043d\u0441\u043e\u043b\u0438. \u041c\u0435\u0442\u0440\u0438\u043a\u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u044e\u0442 \u043e\u0431\u043d\u043e\u0432\u043b\u044f\u0442\u044c\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausa konsolvisningen. M\u00e4tv\u00e4rdena forts\u00e4tter att uppdateras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsol g\u00f6r\u00fcnt\u00fcs\u00fcn\u00fc duraklat. \u00d6l\u00e7\u00fcmler g\u00fcncellenmeye devam eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0437\u0443\u043f\u0438\u043d\u0438\u0442\u0438 \u0432\u0438\u0432\u0435\u0434\u0435\u043d\u043d\u044f \u043a\u043e\u043d\u0441\u043e\u043b\u0456. \u041c\u0435\u0442\u0440\u0438\u043a\u0438 \u0439 \u0434\u0430\u043b\u0456 \u043e\u043d\u043e\u0432\u043b\u044e\u044e\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea1m d\u1eebng hi\u1ec3n th\u1ecb b\u1ea3ng \u0111i\u1ec1u khi\u1ec3n. S\u1ed1 li\u1ec7u v\u1eabn ti\u1ebfp t\u1ee5c c\u1eadp nh\u1eadt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6682\u505c\u63a7\u5236\u53f0\u663e\u793a\u3002\u6307\u6807\u4f1a\u7ee7\u7eed\u66f4\u65b0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66ab\u505c\u4e3b\u63a7\u53f0\u986f\u793a\u3002\u6307\u6a19\u6703\u7e7c\u7e8c\u66f4\u65b0\u3002"
          }
        }
      }
    },
