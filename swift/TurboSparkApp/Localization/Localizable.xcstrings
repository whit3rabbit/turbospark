    "Select your Desktop folder to grant TurboSpark access.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u062f\u062f \u0645\u062c\u0644\u062f \u0633\u0637\u062d \u0627\u0644\u0645\u0643\u062a\u0628 \u0644\u0645\u0646\u062d TurboSpark \u062d\u0642 \u0627\u0644\u0648\u0635\u0648\u0644."
