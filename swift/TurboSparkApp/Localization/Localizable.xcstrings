    "'%@' could not be changed because of a file system error.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر تغيير '%@' بسبب خطأ في نظام الملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' konnte wegen eines Dateisystemfehlers nicht geändert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' could not be changed because of a file system error."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo modificar '%@' por un error del sistema de archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' n'a pas pu être modifié en raison d'une erreur du système de fichiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשנות את '%@' בגלל שגיאת מערכת קבצים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल सिस्टम त्रुटि के कारण '%@' को बदला नहीं जा सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' tidak dapat diubah karena kesalahan sistem file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile modificare '%@' a causa di un errore del file system."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファイルシステムのエラーのため、'%@' を変更できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파일 시스템 오류로 '%@'을(를) 변경하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' kon niet worden gewijzigd vanwege een bestandssysteemfout."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zmienić '%@' z powodu błędu systemu plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível alterar '%@' por causa de um erro do sistema de arquivos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось изменить '%@' из-за ошибки файловой системы."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' kunde inte ändras på grund av ett filsystemfel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya sistemi hatası nedeniyle '%@' değiştirilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося змінити '%@' через помилку файлової системи."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thay đổi '%@' do lỗi hệ thống tệp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于文件系统错误，无法更改 '%@'。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於檔案系統錯誤，無法更改 '%@'。"
          }
        }
      }
    },
    "'%@' is attached to the running server. Detach it there first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' مرفق بالخادم قيد التشغيل. افصله من هناك أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ist mit dem laufenden Server verbunden. Trennen Sie es zuerst dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is attached to the running server. Detach it there first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' está adjunto al servidor en ejecución. Sepáralo allí primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' est joint au serveur en cours d'exécution. Détachez-le d'abord depuis le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' מצורף לשרת הפועל. נתק אותו שם תחילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' चल रहे सर्वर से संलग्न है। पहले उसे वहां से अलग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' terlampir ke server yang sedang berjalan. Lepaskan di sana terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' è collegato al server in esecuzione. Scollegalo prima da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' は実行中のサーバーに接続されています。先にサーバー側で切り離してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'이(가) 실행 중인 서버에 연결되어 있습니다. 먼저 서버에서 분리하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is gekoppeld aan de actieve server. Ontkoppel het daar eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' jest dołączony do działającego serwera. Najpierw odłącz go tam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' está anexado ao servidor em execução. Desanexe-o lá primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель '%@' подключена к работающему серверу. Сначала отсоедините её там."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' är ansluten till den körande servern. Koppla från den där först."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' çalışan sunucuya bağlı. Önce oradan ayırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель '%@' підключено до запущеного сервера. Спершу від'єднайте її там."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' đang được gắn vào máy chủ đang chạy. Hãy tách rời nó ở đó trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 已挂载到正在运行的服务器。请先在服务器中将其分离。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 已掛載到正在執行的伺服器。請先在伺服器中將其分離。"
          }
        }
      }
    },
    "'%@' is in a read-only library, so it was left as it is.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقع '%@' في مكتبة للقراءة فقط، لذا تُرك كما هو."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' liegt in einer schreibgeschützten Bibliothek und wurde daher nicht verändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is in a read-only library, so it was left as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' está en una biblioteca de solo lectura, así que no se modificó."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' se trouve dans une bibliothèque en lecture seule et n'a donc pas été modifié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' נמצא בספרייה לקריאה בלבד, ולכן נשאר כפי שהיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' केवल-पठन वाली लाइब्रेरी में है, इसलिए उसे जैसा था वैसा ही छोड़ा गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' berada di pustaka hanya-baca, jadi dibiarkan apa adanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' si trova in una libreria di sola lettura, quindi non è stato modificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' は読み取り専用のライブラリにあるため、変更されませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'은(는) 읽기 전용 라이브러리에 있어 변경되지 않았습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' staat in een alleen-lezen bibliotheek en is daarom niet gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' znajduje się w bibliotece tylko do odczytu, więc pozostał bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' está em uma biblioteca somente leitura, então não foi alterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' находится в библиотеке только для чтения, поэтому остался без изменений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' finns i ett skrivskyddat bibliotek och lämnades därför som det var."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' salt okunur bir kitaplıkta olduğu için değiştirilmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' розташовано в бібліотеці лише для читання, тому його залишено без змін."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' nằm trong thư viện chỉ đọc nên được giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 位于只读模型库中，因此未被更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 位於唯讀模型庫中，因此未被更改。"
          }
        }
      }
    },
    "'%@' is no longer in the model list.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
