    "On-device speech recognition is not available for this language.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0627\u0644\u0643\u0644\u0627\u0645 \u0639\u0644\u0649 \u0627\u0644\u062c\u0647\u0627\u0632 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d \u0644\u0647\u0630\u0647 \u0627\u0644\u0644\u063a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Spracherkennung auf dem Ger\u00e4t ist f\u00fcr diese Sprache nicht verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On-device speech recognition is not available for this language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz en el dispositivo no est\u00e1 disponible para este idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale sur l'appareil n'est pas disponible pour cette langue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d3\u05d9\u05d1\u05d5\u05e8 \u05d1\u05de\u05db\u05e9\u05d9\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05d6\u05de\u05d9\u05df \u05dc\u05e9\u05e4\u05d4 \u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092d\u093e\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0930 \u0935\u093e\u0915\u094d \u092a\u0939\u091a\u093e\u0928 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan ucapan di perangkat tidak tersedia untuk bahasa ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale sul dispositivo non \u00e8 disponibile per questa lingua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u8a00\u8a9e\u3067\u306f\u30c7\u30d0\u30a4\u30b9\u4e0a\u306e\u97f3\u58f0\u8a8d\u8b58\u3092\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc5b8\uc5b4\uc5d0\uc11c\ub294 \uae30\uae30 \ub0b4 \uc74c\uc131 \uc778\uc2dd\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning op het apparaat is niet beschikbaar voor deze taal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy na urz\u0105dzeniu nie jest dost\u0119pne dla tego j\u0119zyka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala no dispositivo n\u00e3o est\u00e1 dispon\u00edvel para este idioma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0438\u0435 \u0440\u0435\u0447\u0438 \u043d\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u044f\u0437\u044b\u043a\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taligenk\u00e4nning p\u00e5 enheten \u00e4r inte tillg\u00e4nglig f\u00f6r det h\u00e4r spr\u00e5ket."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dil i\u00e7in cihaz \u00fczerinde konu\u015fma tan\u0131ma kullan\u0131lam\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u043d\u0430 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u0457 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435 \u0434\u043b\u044f \u0446\u0456\u0454\u0457 \u043c\u043e\u0432\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1eadn d\u1ea1ng gi\u1ecdng n\u00f3i tr\u00ean thi\u1ebft b\u1ecb kh\u00f4ng kh\u1ea3 d\u1ee5ng cho ng\u00f4n ng\u1eef n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u8bed\u8a00\u4e0d\u652f\u6301\u8bbe\u5907\u7aef\u8bed\u97f3\u8bc6\u522b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u8a9e\u8a00\u4e0d\u652f\u63f4\u88dd\u7f6e\u7aef\u8a9e\u97f3\u8fa8\u8b58\u3002"
          }
        }
      }
    },
    "Only record audio you have the right to use. Protected streams may record as silence.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0633\u062c\u0651\u0644 \u0625\u0644\u0627 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0630\u064a \u064a\u062d\u0642 \u0644\u0643 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647. \u0642\u062f \u062a\u064f\u0633\u062c\u064e\u0651\u0644 \u0627\u0644\u0628\u062b\u0648\u062b \u0627\u0644\u0645\u062d\u0645\u064a\u0629 \u0639\u0644\u0649 \u0634\u0643\u0644 \u0635\u0645\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm nur Audio auf, das du verwenden darfst. Gesch\u00fctzte Streams werden m\u00f6glicherweise als Stille aufgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only record audio you have the right to use. Protected streams may record as silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba solo audio que tengas derecho a usar. Las transmisiones protegidas pueden grabarse como silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'enregistrez que du son que vous avez le droit d'utiliser. Les flux prot\u00e9g\u00e9s peuvent \u00eatre enregistr\u00e9s comme du silence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e7\u05dc\u05d8 \u05e8\u05e7 \u05e9\u05de\u05e2 \u05e9\u05d9\u05e9 \u05dc\u05da \u05d6\u05db\u05d5\u05ea \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5. \u05d6\u05e8\u05de\u05d9\u05dd \u05de\u05d5\u05d2\u05e0\u05d9\u05dd \u05e2\u05e9\u05d5\u05d9\u05d9\u05dd \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05d5\u05e7\u05dc\u05d8\u05d9\u05dd \u05db\u05e9\u05e7\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0947\u0935\u0932 \u0935\u0939\u0940 \u0911\u0921\u093f\u092f\u094b \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0947\u0902 \u091c\u093f\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u093e \u0906\u092a\u0915\u094b \u0905\u0927\u093f\u0915\u093e\u0930 \u0939\u0948\u0964 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u094d\u091f\u094d\u0930\u0940\u092e \u092e\u094c\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0939\u094b \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam hanya audio yang berhak Anda gunakan. Aliran yang dilindungi mungkin terekam sebagai keheningan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra solo audio che hai il diritto di usare. I flussi protetti potrebbero essere registrati come silenzio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u3059\u308b\u6a29\u5229\u306e\u3042\u308b\u30aa\u30fc\u30c7\u30a3\u30aa\u306e\u307f\u3092\u9332\u97f3\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4fdd\u8b77\u3055\u308c\u305f\u30b9\u30c8\u30ea\u30fc\u30e0\u306f\u7121\u97f3\u3067\u9332\u97f3\u3055\u308c\u308b\u5834\u5408\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uc6a9\ud560 \uad8c\ub9ac\uac00 \uc788\ub294 \uc624\ub514\uc624\ub9cc \ub179\uc74c\ud558\uc138\uc694. \ubcf4\ud638\ub41c \uc2a4\ud2b8\ub9bc\uc740 \ubb34\uc74c\uc73c\ub85c \ub179\uc74c\ub420 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem alleen audio op die je mag gebruiken. Beveiligde streams kunnen als stilte worden opgenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywaj tylko d\u017awi\u0119k, do kt\u00f3rego masz prawa. Chronione strumienie mog\u0105 zosta\u0107 nagrane jako cisza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave apenas \u00e1udio que voc\u00ea tem o direito de usar. Transmiss\u00f5es protegidas podem ser gravadas como sil\u00eancio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0439\u0442\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0437\u0432\u0443\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0432\u044b \u0432\u043f\u0440\u0430\u0432\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c. \u0417\u0430\u0449\u0438\u0449\u0451\u043d\u043d\u044b\u0435 \u043f\u043e\u0442\u043e\u043a\u0438 \u043c\u043e\u0433\u0443\u0442 \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c\u0441\u044f \u043a\u0430\u043a \u0442\u0438\u0448\u0438\u043d\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela bara in ljud som du har r\u00e4tt att anv\u00e4nda. Skyddade str\u00f6mmar kan spelas in som tystnad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaln\u0131zca kullanma hakk\u0131n\u0131z olan sesi kaydedin. Korumal\u0131 ak\u0131\u015flar sessizlik olarak kaydedilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u0443\u0439\u0442\u0435 \u043b\u0438\u0448\u0435 \u0437\u0432\u0443\u043a, \u044f\u043a\u0438\u0439 \u0432\u0438 \u043c\u0430\u0454\u0442\u0435 \u043f\u0440\u0430\u0432\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438. \u0417\u0430\u0445\u0438\u0449\u0435\u043d\u0456 \u043f\u043e\u0442\u043e\u043a\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u0438\u0441\u044f \u044f\u043a \u0442\u0438\u0448\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ec9 ghi \u00e2m thanh m\u00e0 b\u1ea1n c\u00f3 quy\u1ec1n s\u1eed d\u1ee5ng. Lu\u1ed3ng \u0111\u01b0\u1ee3c b\u1ea3o v\u1ec7 c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c ghi th\u00e0nh kho\u1ea3ng l\u1eb7ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u5f55\u5236\u4f60\u6709\u6743\u4f7f\u7528\u7684\u97f3\u9891\u3002\u53d7\u4fdd\u62a4\u7684\u97f3\u9891\u6d41\u53ef\u80fd\u4f1a\u88ab\u5f55\u5236\u4e3a\u9759\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50c5\u9304\u88fd\u4f60\u6709\u6b0a\u4f7f\u7528\u7684\u97f3\u8a0a\u3002\u53d7\u4fdd\u8b77\u7684\u4e32\u6d41\u53ef\u80fd\u6703\u88ab\u9304\u88fd\u70ba\u975c\u97f3\u3002"
          }
        }
      }
    },
