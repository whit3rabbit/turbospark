    "Describe the image you want to create.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the image you want to create."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe la imagen que quieres crear."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9crivez l'image que vous souhaitez cr\u00e9er."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie das Bild, das Sie erstellen m\u00f6chten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi l'immagine che vuoi creare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva a imagem que voc\u00ea deseja criar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0445\u043e\u0442\u0438\u0442\u0435 \u0441\u043e\u0437\u0434\u0430\u0442\u044c."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f5c\u6210\u3057\u305f\u3044\u753b\u50cf\u3092\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\uc131\ud558\ub824\ub294 \uc774\ubbf8\uc9c0\ub97c \uc124\uba85\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63cf\u8ff0\u60a8\u60f3\u8981\u521b\u5efa\u7684\u56fe\u50cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63cf\u8ff0\u60a8\u60f3\u8981\u5efa\u7acb\u7684\u5f71\u50cf\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0635\u0641 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u062a\u064a \u062a\u0631\u064a\u062f \u0625\u0646\u0634\u0627\u0621\u0647\u0627."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05ea\u05de\u05d5\u05e0\u05d4 \u05e9\u05d1\u05e8\u05e6\u05d5\u05e0\u05da \u05dc\u05d9\u05e6\u05d5\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0938 \u091b\u0935\u093f \u0915\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0947\u0902 \u091c\u093f\u0938\u0947 \u0906\u092a \u092c\u0928\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf de afbeelding die je wilt maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz obraz, kt\u00f3ry chcesz utworzy\u0107."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olu\u015fturmak istedi\u011finiz resmi a\u00e7\u0131klay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0456\u0442\u044c \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f, \u044f\u043a\u0435 \u0445\u043e\u0447\u0435\u0442\u0435 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv bilden du vill skapa."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 t\u1ea3 h\u00ecnh \u1ea3nh b\u1ea1n mu\u1ed1n t\u1ea1o."
          }
        },
        "id": {
          "stringUnit": {
