    "Connect a drive, or turn off Available now to see every model.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صِل محرك أقراص، أو أوقف «المتاحة الآن» لعرض كل النماذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie ein Laufwerk oder schalten Sie „Jetzt verfügbar“ aus, um alle Modelle zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect a drive, or turn off Available now to see every model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecta una unidad o desactiva «Disponibles ahora» para ver todos los modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez un disque ou désactivez « Disponibles maintenant » pour voir tous les modèles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבר כונן, או כבה את \"זמינים עכשיו\" כדי לראות את כל המודלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी मॉडल देखने के लिए ड्राइव कनेक्ट करें या “अभी उपलब्ध” बंद करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hubungkan drive, atau matikan “Tersedia sekarang” untuk melihat semua model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega un'unità o disattiva «Disponibili ora» per vedere tutti i modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブを接続するか、「今すぐ使用可能」をオフにすると、すべてのモデルを表示できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브를 연결하거나 '지금 사용 가능'을 끄면 모든 모델을 볼 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit een schijf aan of schakel ‘Nu beschikbaar’ uit om alle modellen te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podłącz dysk lub wyłącz „Dostępne teraz”, aby zobaczyć wszystkie modele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conecte uma unidade ou desative “Disponíveis agora” para ver todos os modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключите диск или выключите «Доступны сейчас», чтобы увидеть все модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut en enhet eller stäng av ”Tillgängliga nu” för att se alla modeller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm modelleri görmek için bir sürücü bağlayın veya “Şu an kullanılabilir” seçeneğini kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підключіть диск або вимкніть «Доступні зараз», щоб побачити всі моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy kết nối ổ đĩa hoặc tắt “Có sẵn ngay” để xem mọi mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请连接驱动器，或关闭“当前可用”以查看所有模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請連接磁碟機，或關閉「目前可用」以查看所有模型。"
          }
        }
      }
    },
