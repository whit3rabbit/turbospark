        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0440\u0430\u043d\u0438\u0439 \u043f\u0440\u043e\u0444\u0456\u043b\u044c Chrome \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439."
