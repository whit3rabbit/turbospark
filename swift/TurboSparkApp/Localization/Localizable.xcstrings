    "Refused even if the allowlist would permit them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u064f\u0631\u0641\u0636 \u062d\u062a\u0649 \u0644\u0648 \u0633\u0645\u062d\u062a \u0628\u0647\u0627 \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0633\u0645\u0627\u062d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden abgelehnt, selbst wenn die Zulassungsliste sie erlauben w\u00fcrde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refused even if the allowlist would permit them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazan aunque la lista de permitidos los autorizara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refus\u00e9s m\u00eame si la liste d'autorisation les permettrait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d3\u05d7\u05d9\u05dd \u05d2\u05dd \u05d0\u05dd \u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05d4\u05d9\u05ea\u05e8 \u05d4\u05d9\u05d9\u05ea\u05d4 \u05de\u05ea\u05d9\u05e8\u05d4 \u05d0\u05d5\u05ea\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0928\u0941\u092e\u0924-\u0938\u0942\u091a\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u093f\u090f \u091c\u093e\u0928\u0947 \u092a\u0930 \u092d\u0940 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditolak meskipun daftar izin mengizinkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifiutati anche se l'elenco consentito li permetterebbe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a31\u53ef\u30ea\u30b9\u30c8\u3067\u8a8d\u3081\u3089\u308c\u3066\u3044\u308b\u5834\u5408\u3067\u3082\u62d2\u5426\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud5c8\uc6a9 \ubaa9\ub85d\uc774 \ud5c8\uac00\ud558\ub354\ub77c\ub3c4 \uac70\ubd80\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Worden geweigerd, zelfs als de toegestane lijst ze zou toelaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucane, nawet je\u015bli lista dozwolonych by je przepu\u015bci\u0142a."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recusados mesmo que a lista de permitidos os autorize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u043b\u043e\u043d\u044f\u044e\u0442\u0441\u044f, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u0441\u043f\u0438\u0441\u043e\u043a \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u0439 \u0438\u0445 \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u0435\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas \u00e4ven om till\u00e5telselistan skulle till\u00e5ta dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130zin listesi izin verse bile reddedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u0445\u0438\u043b\u044f\u044e\u0442\u044c\u0441\u044f, \u043d\u0430\u0432\u0456\u0442\u044c \u044f\u043a\u0449\u043e \u0441\u043f\u0438\u0441\u043e\u043a \u0434\u043e\u0437\u0432\u043e\u043b\u0456\u0432 \u0457\u0445 \u0434\u043e\u043f\u0443\u0441\u043a\u0430\u0454."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ecb t\u1eeb ch\u1ed1i ngay c\u1ea3 khi danh s\u00e1ch cho ph\u00e9p ch\u1ea5p nh\u1eadn ch\u00fang."
