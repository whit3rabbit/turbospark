    "No live AGENTS.md or CLAUDE.md detected in project root.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u0643\u062a\u0634\u0641 AGENTS.md \u0623\u0648 CLAUDE.md \u0641\u0639\u0651\u0627\u0644 \u0641\u064a \u062c\u0630\u0631 \u0627\u0644\u0645\u0634\u0631\u0648\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein aktives AGENTS.md oder CLAUDE.md im Projektstammverzeichnis gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No live AGENTS.md or CLAUDE.md detected in project root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se detect\u00f3 ning\u00fan AGENTS.md o CLAUDE.md activo en la ra\u00edz del proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun AGENTS.md ou CLAUDE.md actif d\u00e9tect\u00e9 \u00e0 la racine du projet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05d6\u05d5\u05d4\u05d4 AGENTS.md \u05d0\u05d5 CLAUDE.md \u05e4\u05e2\u05d9\u05dc \u05d1\u05e9\u05d5\u05e8\u05e9 \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0930\u0942\u091f \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f AGENTS.md \u092f\u093e CLAUDE.md \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada AGENTS.md atau CLAUDE.md aktif yang terdeteksi di root proyek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun AGENTS.md o CLAUDE.md attivo rilevato nella radice del progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u30eb\u30fc\u30c8\u306b\u6709\u52b9\u306a AGENTS.md \u307e\u305f\u306f CLAUDE.md \u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8 \ub8e8\ud2b8\uc5d0\uc11c \ud65c\uc131 AGENTS.md \ub610\ub294 CLAUDE.md\ub97c \ucc3e\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen actieve AGENTS.md of CLAUDE.md gevonden in de hoofdmap van het project."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wykryto aktywnego pliku AGENTS.md ani CLAUDE.md w katalogu g\u0142\u00f3wnym projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum AGENTS.md ou CLAUDE.md ativo detectado na raiz do projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043a\u043e\u0440\u043d\u0435 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0439 AGENTS.md \u0438\u043b\u0438 CLAUDE.md."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktiv AGENTS.md eller CLAUDE.md hittades i projektets rot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje k\u00f6k\u00fcnde etkin bir AGENTS.md veya CLAUDE.md bulunamad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u043a\u043e\u0440\u0435\u043d\u0456 \u043f\u0440\u043e\u0454\u043a\u0442\u0443 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e \u0447\u0438\u043d\u043d\u043e\u0433\u043e AGENTS.md \u0430\u0431\u043e CLAUDE.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng ph\u00e1t hi\u1ec7n AGENTS.md ho\u1eb7c CLAUDE.md \u0111ang d\u00f9ng trong th\u01b0 m\u1ee5c g\u1ed1c d\u1ef1 \u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u5728\u9879\u76ee\u6839\u76ee\u5f55\u68c0\u6d4b\u5230\u6709\u6548\u7684 AGENTS.md \u6216 CLAUDE.md\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u5728\u5c08\u6848\u6839\u76ee\u9304\u5075\u6e2c\u5230\u6709\u6548\u7684 AGENTS.md \u6216 CLAUDE.md\u3002"
          }
        }
      }
