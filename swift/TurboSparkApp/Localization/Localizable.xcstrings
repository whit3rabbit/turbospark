    "Use the up and down arrows to choose, Return to accept, Escape to dismiss.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم السهمين لأعلى ولأسفل للاختيار، وReturn للقبول، وEscape للإغلاق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit den Pfeiltasten nach oben und unten wählen, mit Return übernehmen, mit Escape schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the up and down arrows to choose, Return to accept, Escape to dismiss."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa las flechas arriba y abajo para elegir, Retorno para aceptar y Escape para descartar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez les flèches haut et bas pour choisir, Retour pour accepter, Échap pour fermer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בחצים למעלה ולמטה לבחירה, Return לאישור ו-Escape לסגירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनने के लिए ऊपर और नीचे तीर, स्वीकार करने के लिए Return और बंद करने के लिए Escape दबाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan panah atas dan bawah untuk memilih, Return untuk menerima, Escape untuk menutup."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa le frecce su e giù per scegliere, A capo per accettare, Esc per chiudere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下矢印キーで選択、Return で確定、Escape で閉じます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위아래 화살표로 선택하고, Return으로 수락하고, Escape로 닫습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de pijltjes omhoog en omlaag om te kiezen, Return om te accepteren en Escape om te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strzałki w górę i w dół wybierają, Return akceptuje, Escape zamyka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use as setas para cima e para baixo para escolher, Return para aceitar e Esc para fechar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрелки вверх и вниз для выбора, Return для подтверждения, Escape для закрытия."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd uppåt- och nedåtpilarna för att välja, Retur för att godkänna och Escape för att stänga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçmek için yukarı ve aşağı okları, kabul etmek için Return'ü, kapatmak için Escape'i kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стрілки вгору й униз для вибору, Return для підтвердження, Escape для закриття."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng phím mũi tên lên và xuống để chọn, Return để chấp nhận, Escape để đóng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用上下方向键选择，按 Return 确认，按 Escape 关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用上下方向鍵選擇，按 Return 確認，按 Escape 關閉。"
          }
        }
      }
    },
