            "state": "translated",
            "value": "Type or paste what the cloned voice should say."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe o pega lo que debe decir la voz clonada."
          }
        },
        "fr": {
