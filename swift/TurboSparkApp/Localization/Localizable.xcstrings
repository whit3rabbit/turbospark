        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05d5\u05e8\u05de\u05d8 \u200e.gturbo \u05de\u05e7\u05d5\u05e8\u05d9 \u05e9\u05dc Apple MLX \u05e2\u05dd \u05d4\u05e8\u05e6\u05d4 \u05d1-Metal \u05dc\u05dc\u05d0 \u05d4\u05e2\u05ea\u05e7\u05d4"
