    "This action requires your confirmation to execute.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0637\u0644\u0628 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621 \u062a\u0623\u0643\u064a\u062f\u0643 \u0644\u062a\u0646\u0641\u064a\u0630\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Aktion erfordert Ihre Best\u00e4tigung zur Ausf\u00fchrung."
