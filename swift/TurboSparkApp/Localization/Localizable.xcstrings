        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz projekt, aby ustawi\u0107 nadpisanie wtyczki dla projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um projeto para definir uma substitui\u00e7\u00e3o de plugin por projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0440\u043e\u0435\u043a\u0442, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0434\u0430\u0442\u044c \u043f\u0435\u0440\u0435\u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u043f\u043b\u0430\u0433\u0438\u043d\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj ett projekt f\u00f6r att ange en projektspecifik \u00e5sidos\u00e4ttning f\u00f6r till\u00e4gget."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projeye \u00f6zel eklenti ge\u00e7ersiz k\u0131lmas\u0131 ayarlamak i\u00e7in bir proje se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0440\u043e\u0454\u043a\u0442, \u0449\u043e\u0431 \u0437\u0430\u0434\u0430\u0442\u0438 \u043f\u0435\u0440\u0435\u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u043f\u043b\u0430\u0433\u0456\u043d\u0430 \u0434\u043b\u044f \u043f\u0440\u043e\u0454\u043a\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn m\u1ed9t d\u1ef1 \u00e1n \u0111\u1ec3 \u0111\u1eb7t ghi \u0111\u00e8 plugin theo d\u1ef1 \u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u9009\u62e9\u4e00\u4e2a\u9879\u76ee\u4ee5\u8bbe\u7f6e\u6309\u9879\u76ee\u7684\u63d2\u4ef6\u8986\u76d6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u9078\u64c7\u4e00\u500b\u5c08\u6848\u4ee5\u8a2d\u5b9a\u500b\u5225\u5c08\u6848\u7684\u5916\u639b\u8986\u5beb\u3002"
          }
        }
      }
    },
    "Select a supported MLX image model from the curated list.": {
