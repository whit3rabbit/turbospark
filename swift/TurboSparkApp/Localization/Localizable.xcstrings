        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0915\u094b\u0921, \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092f\u093e \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092b\u093c\u093e\u0907\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964"
