    "Eject the loaded model and free its memory": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u062e\u0631\u0627\u062c \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062d\u0645\u0644 \u0648\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0630\u0627\u0643\u0631\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladenes Modell auswerfen und Speicher freigeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eject the loaded model and free its memory"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Expulsa el modelo cargado y libera su memoria"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9jecte le mod\u00e8le charg\u00e9 et lib\u00e8re sa m\u00e9moire"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05dc\u05d5\u05d8 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d8\u05e2\u05d5\u05df \u05d5\u05e9\u05d7\u05e8\u05e8 \u05d0\u05ea \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e9\u05dc\u05d5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u094b\u0921 \u0915\u093f\u090f \u0917\u090f \u092e\u0949\u0921\u0932 \u0915\u094b \u0928\u093f\u0915\u093e\u0932\u0947\u0902 \u0914\u0930 \u0909\u0938\u0915\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u0916\u093e\u0932\u0940 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarkan model yang dimuat dan kosongkan memorinya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Espelle il modello caricato e libera la memoria"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aad\u307f\u8fbc\u307e\u308c\u305f\u30e2\u30c7\u30eb\u3092\u53d6\u308a\u51fa\u3057\u3066\u30e1\u30e2\u30ea\u3092\u89e3\u653e"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub85c\ub4dc\ub41c \ubaa8\ub378\uc744 \uc5b8\ub85c\ub4dc\ud558\uace0 \uba54\ubaa8\ub9ac \ud574\uc81c"
          }
        },
