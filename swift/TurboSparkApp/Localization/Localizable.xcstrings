        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d6\u05e8\u05d9\u05dd \u05de\u05e9\u05e7\u05dc\u05d9\u05dd \u05d1\u05d0\u05d5\u05e4\u05df \u05d3\u05d9\u05e0\u05de\u05d9 \u05e2\u05dd \u05e6\u05e8\u05d9\u05db\u05ea RAM \u05de\u05d9\u05e0\u05d9\u05de\u05dc\u05d9\u05ea"
