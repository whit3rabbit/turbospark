    "Set your own limit for maximum model size that can be loaded": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u062f\u062f \u0628\u0646\u0641\u0633\u0643 \u0627\u0644\u062d\u062c\u0645 \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0630\u064a \u064a\u0645\u0643\u0646 \u062a\u062d\u0645\u064a\u0644\u0647"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege selbst fest, wie gro\u00df ein ladbares Modell h\u00f6chstens sein darf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your own limit for maximum model size that can be loaded"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece tu propio l\u00edmite de tama\u00f1o m\u00e1ximo de modelo que se puede cargar"
