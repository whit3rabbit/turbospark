        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e9\u30f3\u30ca\u30fc\u3092\u5f85\u3063\u3066\u3044\u307e\u3059\u3002\u30e2\u30c7\u30eb\u3054\u3068\u306b\u4e00\u5ea6\u306b 1 \u30bf\u30fc\u30f3\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub7ec\ub108\ub97c \uae30\ub2e4\ub9ac\ub294 \uc911. \ubaa8\ub378\ub2f9 \ud55c \ubc88\uc5d0 \ud55c \ud134\uc529 \uc2e4\ud589\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wachten op de runner. E\u00e9n beurt tegelijk per model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oczekiwanie na runnera. Jedna tura naraz na model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aguardando o executor. Uma rodada por vez por modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0436\u0438\u0434\u0430\u043d\u0438\u0435 \u0438\u0441\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044f. \u041f\u043e \u043e\u0434\u043d\u043e\u043c\u0443 \u0445\u043e\u0434\u0443 \u0437\u0430 \u0440\u0430\u0437 \u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4ntar p\u00e5 k\u00f6rningen. En omg\u00e5ng i taget per modell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7al\u0131\u015ft\u0131r\u0131c\u0131 bekleniyor. Model ba\u015f\u0131na ayn\u0131 anda bir tur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0447\u0456\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0438\u043a\u043e\u043d\u0430\u0432\u0446\u044f. \u041f\u043e \u043e\u0434\u043d\u043e\u043c\u0443 \u0445\u043e\u0434\u0443 \u0437\u0430 \u0440\u0430\u0437 \u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110ang ch\u1edd tr\u00ecnh ch\u1ea1y. M\u1ed7i m\u00f4 h\u00ecnh ch\u1ea1y t\u1eebng l\u01b0\u1ee3t m\u1ed9t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u7b49\u5f85\u8fd0\u884c\u5668\u3002\u6bcf\u4e2a\u6a21\u578b\u4e00\u6b21\u53ea\u8fd0\u884c\u4e00\u8f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u7b49\u5f85\u57f7\u884c\u5668\u3002\u6bcf\u500b\u6a21\u578b\u4e00\u6b21\u53ea\u57f7\u884c\u4e00\u8f2a\u3002"
          }
        }
      }
    },
