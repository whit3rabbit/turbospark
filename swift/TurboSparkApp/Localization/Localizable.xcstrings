    "TurboSpark accepts GGUF control vectors here. Research .pt axes need offline conversion first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقبل TurboSpark متجهات تحكم GGUF هنا. تحتاج محاور البحث .pt إلى تحويل دون اتصال أولاً."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark akzeptiert hier GGUF-Kontrollvektoren. Forschungsachsen im .pt-Format müssen zuerst offline konvertiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark accepts GGUF control vectors here. Research .pt axes need offline conversion first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark acepta vectores de control GGUF aquí. Los ejes de investigación .pt necesitan conversión fuera de línea primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark accepte les vecteurs de contrôle GGUF ici. Les axes de recherche .pt nécessitent d'abord une conversion hors ligne."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark מקבל כאן וקטורי בקרה של GGUF. צירי מחקר מסוג .pt זקוקים להמרה לא מקוונת תחילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark यहाँ GGUF नियंत्रण वैक्टर स्वीकार करता है। शोध .pt अक्षों को पहले ऑफ़लाइन रूपांतरण की आवश्यकता होती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark menerima vektor kontrol GGUF di sini. Sumbu penelitian .pt memerlukan konversi offline terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark accetta vettori di controllo GGUF qui. Gli assi di ricerca .pt richiedono prima la conversione offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark はここで GGUF コントロールベクトルを受け入れます。研究用の .pt 軸は最初にオフライン変換が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark는 여기서 GGUF 제어 벡터를 허용합니다. 연구용 .pt 축은 먼저 오프라인 변환이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark accepteert hier GGUF-controlevectoren. Onderzoeks-.pt-assen hebben eerst offline conversie nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark akceptuje tutaj wektory kontrolne GGUF. Osie badawcze .pt wymagają wcześniejszej konwersji offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark aceita vetores de controle GGUF aqui. Os eixos .pt de pesquisa precisam de conversão offline primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark принимает здесь векторы управления GGUF. Оси исследований .pt требуют предварительного офлайн-преобразования."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark accepterar GGUF-kontrollvektorer här. Forsknings-.pt-axlar behöver offlinekonvertering först."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark burada GGUF kontrol vektörlerini kabul eder. Araştırma amaçlı .pt eksenlerinin önce çevrimdışı dönüştürülmesi gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark приймає тут контрольні вектори GGUF. Дослідницькі осі .pt спочатку потребують офлайн-конвертації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark chấp nhận các vector điều khiển GGUF tại đây. Các trục nghiên cứu .pt cần chuyển đổi ngoại tuyến trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 在此处接受 GGUF 控制向量。研究用的 .pt 轴需要先进行离线转换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 在此處接受 GGUF 控制向量。研究用的 .pt 軸需要先進行離線轉換。"
          }
        }
      }
    },
