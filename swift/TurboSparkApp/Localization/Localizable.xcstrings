    "Use a checkpoint folder instead of the pinned download. Its files are not checked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدام مجلد نقطة حفظ بدلًا من التنزيل المثبّت. لا يتم التحقق من ملفاته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einen Checkpoint-Ordner statt des festgelegten Downloads verwenden. Seine Dateien werden nicht geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a checkpoint folder instead of the pinned download. Its files are not checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar una carpeta de checkpoint en lugar de la descarga fijada. Sus archivos no se comprueban."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser un dossier de checkpoint au lieu du téléchargement épinglé. Ses fichiers ne sont pas vérifiés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שימוש בתיקיית נקודת ביקורת במקום ההורדה המקובעת. הקבצים בה אינם נבדקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन किए गए डाउनलोड की जगह चेकपॉइंट फ़ोल्डर इस्तेमाल करें। इसकी फ़ाइलों की जाँच नहीं होती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
