          "stringUnit": {
            "state": "translated",
            "value": "Geçici sohbet: bu konuşma kurtarılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасовий чат: цю розмову не можна відновити."
