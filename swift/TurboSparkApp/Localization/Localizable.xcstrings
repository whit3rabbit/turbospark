    "Spell abbreviations and unusual names the way they should sound.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spell abbreviations and unusual names the way they should sound."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتب الاختصارات والأسماء غير المألوفة كما ينبغي أن تُنطق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe Abkürzungen und ungewöhnliche Namen so, wie sie klingen sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe las abreviaturas y los nombres poco comunes tal como deben sonar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Écrivez les abréviations et les noms inhabituels comme ils doivent sonner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתוב ראשי תיבות ושמות יוצאי דופן כפי שהם אמורים להישמע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संक्षिप्त रूपों और असामान्य नामों को वैसे ही लिखें जैसे वे बोले जाने चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Eja singkatan dan nama yang tidak biasa sesuai cara pengucapannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi le abbreviazioni e i nomi insoliti come devono suonare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "略語や珍しい名前は、発音してほしい通りに表記します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약어와 특이한 이름은 소리 나야 하는 대로 표기하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf afkortingen en ongewone namen zoals ze moeten klinken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj skróty i nietypowe nazwy tak, jak mają brzmieć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva siglas e nomes incomuns do jeito que devem soar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте аббревиатуры и необычные имена так, как они должны звучать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stava förkortningar och ovanliga namn så som de ska låta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısaltmaları ve alışılmadık adları nasıl duyulmaları gerekiyorsa öyle yazın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте абревіатури та незвичні імена так, як вони мають звучати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Viết các từ viết tắt và tên lạ đúng như cách chúng cần được phát âm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "缩写和不常见的名字请按发音写出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "縮寫和不常見的名字請依發音寫出。"
          }
        }
      }
    },
