            "value": "\u3053\u306e\u30ab\u30bf\u30ed\u30b0\u9805\u76ee\u306b\u306f\u30b5\u30fc\u30d0\u30fc\u540d\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
