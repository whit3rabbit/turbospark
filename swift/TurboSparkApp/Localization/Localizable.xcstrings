          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे ड्राफ़्ट और पुनर्लेखन हट जाएंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
