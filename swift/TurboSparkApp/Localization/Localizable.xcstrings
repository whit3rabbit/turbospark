    },
    "Cannot attach files while generating.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0625\u0631\u0641\u0627\u0642 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0648\u0644\u064a\u062f."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hrend der Generierung k\u00f6nnen keine Dateien angeh\u00e4ngt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot attach files while generating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden adjuntar archivos mientras se genera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre des fichiers pendant la g\u00e9n\u00e9ration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e6\u05e8\u05e3 \u05e7\u05d1\u05e6\u05d9\u05dd \u05d1\u05d6\u05de\u05df \u05d9\u05e6\u05d9\u05e8\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u0928\u0930\u0947\u091f \u0915\u0930\u0924\u0947 \u0938\u092e\u092f \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0938\u0902\u0932\u0917\u094d\u0928 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat melampirkan file saat sedang menghasilkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile allegare file durante la generazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u4e2d\u306f\u30d5\u30a1\u30a4\u30eb\u3092\u6dfb\u4ed8\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\uc131 \uc911\uc5d0\ub294 \ud30c\uc77c\uc744 \ucca8\ubd80\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan geen bestanden bijvoegen tijdens het genereren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna za\u0142\u0105cza\u0107 plik\u00f3w podczas generowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o \u00e9 poss\u00edvel anexar arquivos durante a gera\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043b\u044c\u0437\u044f \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u044f\u0442\u044c \u0444\u0430\u0439\u043b\u044b \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det g\u00e5r inte att bifoga filer under generering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olu\u015fturma s\u0131ras\u0131nda dosya eklenemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043c\u043e\u0436\u043d\u0430 \u043f\u0440\u0438\u043a\u0440\u0456\u043f\u043b\u044e\u0432\u0430\u0442\u0438 \u0444\u0430\u0439\u043b\u0438 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 \u0111\u00ednh k\u00e8m t\u1ec7p khi \u0111ang t\u1ea1o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u8fc7\u7a0b\u4e2d\u65e0\u6cd5\u9644\u52a0\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u904e\u7a0b\u4e2d\u7121\u6cd5\u9644\u52a0\u6a94\u6848\u3002"
          }
        }
      }
    },
    "Cannot change the workspace root while a turn is running.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u062c\u0644\u062f \u0627\u0644\u062c\u0630\u0631 \u0644\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u0639\u0645\u0644 \u0623\u062b\u0646\u0627\u0621 \u062a\u0634\u063a\u064a\u0644 \u062f\u0648\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Stammverzeichnis des Arbeitsbereichs kann nicht ge\u00e4ndert werden, w\u00e4hrend eine Runde l\u00e4uft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot change the workspace root while a turn is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar la ra\u00edz del espacio de trabajo mientras hay un turno en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer la racine de l'espace de travail pendant qu'un tour est en cours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05e0\u05d5\u05ea \u05d0\u05ea \u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05e9\u05d5\u05e8\u05e9 \u05e9\u05dc \u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d1\u05d6\u05de\u05df \u05e9\u05ea\u05d5\u05e8 \u05e4\u05d5\u05e2\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0930\u094d\u0928 \u091a\u0932\u0924\u0947 \u0938\u092e\u092f \u0935\u0930\u094d\u0915\u0938\u094d\u092a\u0947\u0938 \u0930\u0942\u091f \u0928\u0939\u0940\u0902 \u092c\u0926\u0932\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mengubah root ruang kerja saat giliran sedang berjalan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile cambiare la radice dell'area di lavoro mentre \u00e8 in corso un turno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30fc\u30f3\u306e\u5b9f\u884c\u4e2d\u306f\u30ef\u30fc\u30af\u30b9\u30da\u30fc\u30b9\u306e\u30eb\u30fc\u30c8\u3092\u5909\u66f4\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud134\uc774 \uc2e4\ud589 \uc911\uc77c \ub54c\ub294 \uc791\uc5c5 \uacf5\uac04 \ub8e8\ud2b8\ub97c \ubcc0\uacbd\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan de hoofdmap van de werkruimte niet wijzigen terwijl er een beurt loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna zmieni\u0107 katalogu g\u0142\u00f3wnego obszaru roboczego, gdy trwa tura."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o \u00e9 poss\u00edvel alterar a raiz do espa\u00e7o de trabalho enquanto um turno est\u00e1 em andamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043b\u044c\u0437\u044f \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u043a\u043e\u0440\u043d\u0435\u0432\u0443\u044e \u043f\u0430\u043f\u043a\u0443 \u0440\u0430\u0431\u043e\u0447\u0435\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0445\u043e\u0434\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det g\u00e5r inte att \u00e4ndra arbetsytans rotmapp medan en tur k\u00f6rs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tur \u00e7al\u0131\u015f\u0131rken \u00e7al\u0131\u015fma alan\u0131 k\u00f6k\u00fc de\u011fi\u015ftirilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u043a\u043e\u0440\u0435\u043d\u0435\u0432\u0443 \u043f\u0430\u043f\u043a\u0443 \u0440\u043e\u0431\u043e\u0447\u043e\u0457 \u043e\u0431\u043b\u0430\u0441\u0442\u0456, \u043f\u043e\u043a\u0438 \u0432\u0438\u043a\u043e\u043d\u0443\u0454\u0442\u044c\u0441\u044f \u0445\u0456\u0434."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 thay \u0111\u1ed5i th\u01b0 m\u1ee5c g\u1ed1c c\u1ee7a kh\u00f4ng gian l\u00e0m vi\u1ec7c khi m\u1ed9t l\u01b0\u1ee3t \u0111ang ch\u1ea1y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f6e\u6b21\u8fd0\u884c\u671f\u95f4\u65e0\u6cd5\u66f4\u6539\u5de5\u4f5c\u533a\u6839\u76ee\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56de\u5408\u57f7\u884c\u671f\u9593\u7121\u6cd5\u8b8a\u66f4\u5de5\u4f5c\u5340\u6839\u76ee\u9304\u3002"
          }
        }
      }
    },
    "Cannot delete '%@' while a model is loading. Wait for it to finish.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062d\u0630\u0641 '%@' \u0623\u062b\u0646\u0627\u0621 \u062a\u062d\u0645\u064a\u0644 \u0646\u0645\u0648\u0630\u062c. \u0627\u0646\u062a\u0638\u0631 \u062d\u062a\u0649 \u064a\u0646\u062a\u0647\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' kann nicht gel\u00f6scht werden, w\u00e4hrend ein Modell geladen wird. Warten Sie, bis der Vorgang abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot delete '%@' while a model is loading. Wait for it to finish."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar '%@' mientras se carga un modelo. Espera a que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer '%@' pendant le chargement d'un mod\u00e8le. Attendez la fin du chargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05de\u05d7\u05d5\u05e7 \u05d0\u05ea '%@' \u05d1\u05d6\u05de\u05df \u05e9\u05de\u05d5\u05d3\u05dc \u05e0\u05d8\u05e2\u05df. \u05d4\u05de\u05ea\u05df \u05dc\u05e1\u05d9\u05d5\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0939\u094b\u0924\u0947 \u0938\u092e\u092f '%@' \u0915\u094b \u0939\u091f\u093e\u092f\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0924\u093e\u0964 \u0907\u0938\u0915\u0947 \u092a\u0942\u0930\u093e \u0939\u094b\u0928\u0947 \u0924\u0915 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghapus '%@' saat model sedang dimuat. Tunggu hingga selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare '%@' mentre \u00e8 in corso il caricamento di un modello. Attendi che termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u306e\u8aad\u307f\u8fbc\u307f\u4e2d\u306f '%@' \u3092\u524a\u9664\u3067\u304d\u307e\u305b\u3093\u3002\u5b8c\u4e86\u3059\u308b\u307e\u3067\u304a\u5f85\u3061\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc744 \ub85c\ub4dc\ud558\ub294 \uc911\uc5d0\ub294 '%@'\uc744(\ub97c) \uc0ad\uc81c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc644\ub8cc\ub420 \ub54c\uae4c\uc9c0 \uae30\ub2e4\ub9ac\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan '%@' niet verwijderen terwijl een model wordt geladen. Wacht tot dit klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna usun\u0105\u0107 '%@' podczas wczytywania modelu. Poczekaj na zako\u0144czenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o \u00e9 poss\u00edvel excluir '%@' enquanto um modelo est\u00e1 carregando. Aguarde a conclus\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043b\u044c\u0437\u044f \u0443\u0434\u0430\u043b\u0438\u0442\u044c '%@', \u043f\u043e\u043a\u0430 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0442\u0441\u044f \u043c\u043e\u0434\u0435\u043b\u044c. \u0414\u043e\u0436\u0434\u0438\u0442\u0435\u0441\u044c \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det g\u00e5r inte att ta bort '%@' medan en modell l\u00e4ses in. V\u00e4nta tills den \u00e4r klar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir model y\u00fcklenirken '%@' silinemez. Bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 '%@', \u043f\u043e\u043a\u0438 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454\u0442\u044c\u0441\u044f \u043c\u043e\u0434\u0435\u043b\u044c. \u0414\u043e\u0447\u0435\u043a\u0430\u0439\u0442\u0435\u0441\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 x\u00f3a '%@' khi \u0111ang t\u1ea3i m\u00f4 h\u00ecnh. H\u00e3y \u0111\u1ee3i cho \u0111\u1ebfn khi ho\u00e0n t\u1ea5t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u52a0\u8f7d\u6a21\u578b\u65f6\u65e0\u6cd5\u5220\u9664 '%@'\u3002\u8bf7\u7b49\u5f85\u52a0\u8f7d\u5b8c\u6210\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u8f09\u5165\u6a21\u578b\u6642\u7121\u6cd5\u522a\u9664 '%@'\u3002\u8acb\u7b49\u5f85\u8f09\u5165\u5b8c\u6210\u3002"
          }
        }
      }
    },
    "Cannot delete '%@' while a turn is running. Stop it first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062d\u0630\u0641 '%@' \u0623\u062b\u0646\u0627\u0621 \u062a\u0646\u0641\u064a\u0630 \u062f\u0648\u0631. \u0623\u0648\u0642\u0641\u0647 \u0623\u0648\u0644\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' kann nicht gel\u00f6scht werden, w\u00e4hrend eine Runde l\u00e4uft. Stoppen Sie sie zuerst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot delete '%@' while a turn is running. Stop it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar '%@' mientras hay un turno en curso. Detenlo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer '%@' pendant qu'un tour est en cours. Arr\u00eatez-le d'abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05de\u05d7\u05d5\u05e7 \u05d0\u05ea '%@' \u05d1\u05d6\u05de\u05df \u05e9\u05ea\u05d5\u05e8 \u05e4\u05d5\u05e2\u05dc. \u05e2\u05e6\u05d5\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05ea\u05d7\u05d9\u05dc\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0930\u094d\u0928 \u091a\u0932\u0924\u0947 \u0938\u092e\u092f '%@' \u0915\u094b \u0939\u091f\u093e\u092f\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0924\u093e\u0964 \u092a\u0939\u0932\u0947 \u0909\u0938\u0947 \u0930\u094b\u0915\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghapus '%@' saat giliran sedang berjalan. Hentikan terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare '%@' mentre \u00e8 in corso un turno. Interrompilo prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30fc\u30f3\u306e\u5b9f\u884c\u4e2d\u306f '%@' \u3092\u524a\u9664\u3067\u304d\u307e\u305b\u3093\u3002\u5148\u306b\u505c\u6b62\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud134\uc774 \uc2e4\ud589 \uc911\uc77c \ub54c\ub294 '%@'\uc744(\ub97c) \uc0ad\uc81c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc911\uc9c0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan '%@' niet verwijderen terwijl er een beurt loopt. Stop die eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna usun\u0105\u0107 '%@', gdy trwa tura. Najpierw j\u0105 zatrzymaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o \u00e9 poss\u00edvel excluir '%@' enquanto um turno est\u00e1 em execu\u00e7\u00e3o. Pare-o primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043b\u044c\u0437\u044f \u0443\u0434\u0430\u043b\u0438\u0442\u044c '%@', \u043f\u043e\u043a\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u044f\u0435\u0442\u0441\u044f \u0445\u043e\u0434. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0435\u0433\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det g\u00e5r inte att ta bort '%@' medan en tur k\u00f6rs. Stoppa den f\u00f6rst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tur \u00e7al\u0131\u015f\u0131rken '%@' silinemez. \u00d6nce turu durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u0438 '%@', \u043f\u043e\u043a\u0438 \u0432\u0438\u043a\u043e\u043d\u0443\u0454\u0442\u044c\u0441\u044f \u0445\u0456\u0434. \u0421\u043f\u0435\u0440\u0448\u0443 \u0437\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u0439\u043e\u0433\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 x\u00f3a '%@' khi m\u1ed9t l\u01b0\u1ee3t \u0111ang ch\u1ea1y. H\u00e3y d\u1eebng l\u01b0\u1ee3t \u0111\u00f3 tr\u01b0\u1edbc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u8f6e\u6b21\u6b63\u5728\u8fd0\u884c\u65f6\u65e0\u6cd5\u5220\u9664 '%@'\u3002\u8bf7\u5148\u505c\u6b62\u8be5\u8f6e\u6b21\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u56de\u5408\u6b63\u5728\u57f7\u884c\u6642\u7121\u6cd5\u522a\u9664 '%@'\u3002\u8acb\u5148\u505c\u6b62\u8a72\u56de\u5408\u3002"
          }
        }
      }
    },
