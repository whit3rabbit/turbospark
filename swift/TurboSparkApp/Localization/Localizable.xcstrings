          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目标条件最多 %lld 个字符；当前条件有 %lld 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目標條件最多 %lld 個字元；目前條件有 %lld 個字元。"
          }
        }
      }
    },
    "A local classifier reviews each tool call: safe ones run, risky ones are blocked with a reason, and uncertain ones ask you": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يراجع مصنف محلي كل استدعاء أداة: الآمنة تُنفَّذ، والخطرة تُحظر مع ذكر السبب، وغير المؤكدة تُعرض عليك"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein lokaler Klassifikator prüft jeden Tool-Aufruf: sichere laufen, riskante werden mit Begründung blockiert, unklare fragen dich"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A local classifier reviews each tool call: safe ones run, risky ones are blocked with a reason, and uncertain ones ask you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un clasificador local revisa cada llamada: las seguras se ejecutan, las arriesgadas se bloquean con un motivo y las dudosas te preguntan"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un classificateur local examine chaque appel d'outil : les sûrs s'exécutent, les risqués sont bloqués avec un motif et les incertains vous sont soumis"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסווג מקומי בודק כל קריאת כלי: בטוחות רצות, מסוכנות נחסמות עם סיבה, ולא ודאיות שואלות אותך"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्थानीय क्लासिफ़ायर हर टूल कॉल की जाँच करता है: सुरक्षित चलते हैं, जोखिम भरे कारण सहित रोके जाते हैं, और अनिश्चित आपसे पूछते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengklasifikasi lokal meninjau setiap panggilan alat: yang aman berjalan, yang berisiko diblokir dengan alasan, dan yang tidak pasti menanyakan Anda"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un classificatore locale esamina ogni chiamata: quelle sicure vengono eseguite, quelle rischiose bloccate con un motivo e quelle incerte chiedono a te"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルの分類器が各ツール呼び出しを審査します。安全なものは実行、危険なものは理由付きでブロック、判断できないものはあなたに確認します"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로컬 분류기가 각 도구 호출을 검토합니다. 안전한 호출은 실행되고, 위험한 호출은 이유와 함께 차단되며, 불확실한 호출은 사용자에게 묻습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een lokale classificatie beoordeelt elke toolaanroep: veilige worden uitgevoerd, riskante met reden geblokkeerd en twijfelgevallen aan jou voorgelegd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalny klasyfikator ocenia każde wywołanie: bezpieczne są wykonywane, ryzykowne blokowane z podaniem powodu, a niepewne trafiają do ciebie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um classificador local revisa cada chamada: as seguras rodam, as arriscadas são bloqueadas com um motivo e as incertas perguntam a você"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальный классификатор проверяет каждый вызов: безопасные выполняются, рискованные блокируются с объяснением, а сомнительные требуют вашего решения"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En lokal klassificerare granskar varje verktygsanrop: säkra körs, riskabla blockeras med en motivering och osäkra frågar dig"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel bir sınıflandırıcı her araç çağrısını inceler: güvenliler çalışır, riskliler gerekçeyle engellenir, belirsizler size sorulur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Локальний класифікатор перевіряє кожен виклик: безпечні виконуються, ризиковані блокуються з поясненням, а сумнівні потребують вашого рішення"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ phân loại cục bộ xem xét từng lệnh gọi công cụ: lệnh an toàn được chạy, lệnh rủi ro bị chặn kèm lý do, lệnh chưa chắc chắn sẽ hỏi bạn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地分类器会审查每次工具调用：安全的直接运行，有风险的附理由拦截，不确定的会询问你"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機分類器會審查每次工具呼叫：安全的直接執行，有風險的附理由封鎖，不確定的會詢問你"
          }
        }
      }
    },
    "A managed file failed authentication and cannot be backed up (%@).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل ملف مُدار في المصادقة ولا يمكن نسخه احتياطيًا (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine verwaltete Datei hat die Authentifizierung nicht bestanden und kann nicht gesichert werden (%@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A managed file failed authentication and cannot be backed up (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo gestionado no superó la autenticación y no se puede incluir en la copia de seguridad (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier géré n'a pas passé l'authentification et ne peut pas être sauvegardé (%@)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ מנוהל נכשל באימות ולא ניתן לגבות אותו (%@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रबंधित फ़ाइल प्रमाणीकरण में विफल रही और उसका बैकअप नहीं लिया जा सकता (%@)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File terkelola gagal diautentikasi dan tidak dapat dicadangkan (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file gestito non ha superato l'autenticazione e non può essere incluso nel backup (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理対象ファイルが認証に失敗したため、バックアップできません (%@)。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리 파일이 인증에 실패하여 백업할 수 없습니다(%@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beheerd bestand is niet geverifieerd en kan niet worden geback-upt (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zarządzany nie przeszedł uwierzytelniania i nie można go uwzględnić w kopii zapasowej (%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo gerenciado falhou na autenticação e não pode ser incluído no backup (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляемый файл не прошел проверку подлинности, и его нельзя включить в резервную копию (%@)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En hanterad fil klarade inte autentiseringen och kan inte säkerhetskopieras (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetilen bir dosya kimlik doğrulamasından geçemedi ve yedeklenemiyor (%@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керований файл не пройшов автентифікацію, і його не можна включити до резервної копії (%@)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một tệp được quản lý không vượt qua xác thực và không thể sao lưu (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "托管文件未通过认证，无法备份（%@）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "受管理檔案未通過驗證，無法備份（%@）。"
          }
        }
      }
    },
    "A mode that uses a model you delete moves to another installed model.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل الوضع الذي يستخدم نموذجًا تحذفه إلى نموذج مثبت آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modus, der ein gelöschtes Modell nutzt, wechselt zu einem anderen installierten Modell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A mode that uses a model you delete moves to another installed model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modo que usa un modelo que eliminas pasa a otro modelo instalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un mode qui utilise un modèle que vous supprimez passe à un autre modèle installé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מצב שמשתמש במודל שמחקת עובר למודל מותקן אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस मोड में हटाया गया मॉडल इस्तेमाल होता है, वह किसी दूसरे स्थापित मॉडल पर चला जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode yang memakai model yang Anda hapus akan beralih ke model terpasang lainnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una modalità che usa un modello che elimini passa a un altro modello installato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除したモデルを使っているモードは、インストール済みの別のモデルに切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "삭제한 모델을 사용하던 모드는 설치된 다른 모델로 바뀝니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een modus die een verwijderd model gebruikt, schakelt over op een ander geïnstalleerd model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb, który używa usuniętego modelu, przechodzi na inny zainstalowany model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modo que usa um modelo que você apaga passa para outro modelo instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим, использующий удалённую модель, переходит на другую установленную модель."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett läge som använder en modell du raderar byter till en annan installerad modell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sildiğiniz modeli kullanan mod, yüklü başka bir modele geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Режим, що використовує видалену модель, переходить на іншу встановлену модель."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chế độ đang dùng mô hình bạn xóa sẽ chuyển sang một mô hình đã cài đặt khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已删除模型的模式会改用另一个已安装的模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用已刪除模型的模式會改用另一個已安裝的模型。"
          }
        }
      }
    },
    "A model is installing or moving, so '%@' was left as it is. Try again when it finishes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجري تثبيت نموذج أو نقله، لذا تُرك '%@' كما هو. حاول مرة أخرى عند انتهاء ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modell wird gerade installiert oder verschoben, daher wurde '%@' nicht verändert. Versuchen Sie es erneut, wenn der Vorgang abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model is installing or moving, so '%@' was left as it is. Try again when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está instalando o moviendo un modelo, así que '%@' no se modificó. Inténtalo de nuevo cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle est en cours d'installation ou de déplacement, '%@' n'a donc pas été modifié. Réessayez une fois l'opération terminée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודל מותקן או מועבר כעת, ולכן '%@' נשאר כפי שהיה. נסה שוב בסיום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई मॉडल इंस्टॉल या स्थानांतरित हो रहा है, इसलिए '%@' को जैसा था वैसा ही छोड़ा गया। इसके पूरा होने पर फिर प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah model sedang diinstal atau dipindahkan, jadi '%@' dibiarkan apa adanya. Coba lagi setelah selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello è in fase di installazione o spostamento, quindi '%@' non è stato modificato. Riprova al termine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのインストールまたは移動中のため、'%@' は変更されませんでした。完了してからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 설치하거나 이동하는 중이어서 '%@'은(는) 변경되지 않았습니다. 완료된 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt een model geïnstalleerd of verplaatst, dus '%@' is niet gewijzigd. Probeer het opnieuw als dit klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trwa instalowanie lub przenoszenie modelu, więc '%@' pozostał bez zmian. Spróbuj ponownie po jego zakończeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um modelo está sendo instalado ou movido, então '%@' não foi alterado. Tente novamente quando terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Идёт установка или перемещение модели, поэтому '%@' остался без изменений. Повторите попытку после завершения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En modell installeras eller flyttas, så '%@' lämnades som det var. Försök igen när det är klart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir model yükleniyor veya taşınıyor, bu yüzden '%@' değiştirilmedi. Bittiğinde yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Триває встановлення або переміщення моделі, тому '%@' залишено без змін. Повторіть спробу після завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mô hình đang được cài đặt hoặc di chuyển nên '%@' được giữ nguyên. Hãy thử lại khi hoàn tất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有模型正在安装或移动，因此未更改 '%@'。请在完成后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有模型正在安裝或移動，因此未更改 '%@'。請在完成後再試一次。"
          }
        }
      }
    },
