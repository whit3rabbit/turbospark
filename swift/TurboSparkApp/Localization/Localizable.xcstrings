        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0924\u093e\u090f\u0902 \u0915\u093f \u092f\u0939 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0948\u0938\u0947 \u0915\u093e\u092e \u0915\u0930\u0924\u093e \u0939\u0948"
