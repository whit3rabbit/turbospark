          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u062a\u062a\u0645 \u0625\u0632\u0627\u0644\u0629 \"%@\" \u0648\u0633\u062c\u0644 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u062e\u0627\u0635 \u0628\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201e%@\u201c und sein Konversationsverlauf werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" and its conversation history will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminar\u00e1n \"%@\" y su historial de conversaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab %@ \u00bb et son historique de conversation seront supprim\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" \u05d5\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d9\u05ea \u05d4\u05e9\u05d9\u05d7\u05d5\u05ea \u05e9\u05dc\u05d5 \u05d9\u05d5\u05e1\u05e8\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" \u0914\u0930 \u0907\u0938\u0915\u093e \u092c\u093e\u0924\u091a\u0940\u0924 \u0907\u0924\u093f\u0939\u093e\u0938 \u0939\u091f\u093e \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" dan riwayat percakapannya akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" e la relativa cronologia della conversazione verranno rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u3068\u305d\u306e\u4f1a\u8a71\u5c65\u6b74\u304c\u524a\u9664\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" \ubc0f \ub300\ud654 \uae30\ub85d\uc774 \uc0ad\uc81c\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" en de bijbehorende gespreksgeschiedenis worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element \u201e%@\u201d i jego historia konwersacji zostan\u0105 usuni\u0119te."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" e o hist\u00f3rico de conversas ser\u00e3o removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u044f \u044d\u0442\u043e\u0433\u043e \u0434\u0438\u0430\u043b\u043e\u0433\u0430 \u0431\u0443\u0434\u0443\u0442 \u0443\u0434\u0430\u043b\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" och dess konversationshistorik tas bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ve konu\u015fma ge\u00e7mi\u015fi kald\u0131r\u0131lacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb \u0442\u0430 \u0456\u0441\u0442\u043e\u0440\u0456\u044f \u0446\u0456\u0454\u0457 \u0440\u043e\u0437\u043c\u043e\u0432\u0438 \u0431\u0443\u0434\u0443\u0442\u044c \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" v\u00e0 l\u1ecbch s\u1eed tr\u00f2 chuy\u1ec7n c\u1ee7a n\u00f3 s\u1ebd b\u1ecb x\u00f3a."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c%@\u201d\u53ca\u5176\u5bf9\u8bdd\u5386\u53f2\u8bb0\u5f55\u5c06\u88ab\u5220\u9664\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u53ca\u5176\u5c0d\u8a71\u6b77\u53f2\u8a18\u9304\u5c07\u88ab\u522a\u9664\u3002"
          }
        }
      }
    },
