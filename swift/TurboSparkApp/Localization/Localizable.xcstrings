            "value": "Transformez un enregistrement en texte modifiable et en sous-titres."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwandle eine Aufnahme in bearbeitbaren Text und Untertitel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma una registrazione in testo modificabile e sottotitoli."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme uma gravação em texto editável e legendas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet een opname om in bewerkbare tekst en ondertitels."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omvandla en inspelning till redigerbar text och undertexter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień nagranie na edytowalny tekst i napisy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kaydı düzenlenebilir metne ve altyazılara dönüştürün."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ubah rekaman menjadi teks yang dapat disunting dan subtitel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Преобразуйте запись в редактируемый текст и субтитры."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетворіть запис на редагований текст і субтитри."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển bản ghi thành văn bản có thể chỉnh sửa và phụ đề."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を編集可能なテキストと字幕に変換します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음을 편집 가능한 텍스트와 자막으로 변환하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将录音转换为可编辑的文本和字幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將錄音轉換為可編輯的文字和字幕。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حوّل تسجيلاً إلى نص قابل للتعديل وترجمة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפוך הקלטה לטקסט ניתן לעריכה ולכתוביות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग को संपादन योग्य टेक्स्ट और उपशीर्षकों में बदलें।"
          }
        }
      }
    },
    "Turn on TurboSpark in System Settings, then return here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on TurboSpark in System Settings, then return here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa TurboSpark en Ajustes del Sistema y luego vuelve aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez TurboSpark dans Réglages Système, puis revenez ici."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere TurboSpark in den Systemeinstellungen und kehre dann hierher zurück."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva TurboSpark in Impostazioni di Sistema, poi torna qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o TurboSpark nos Ajustes do Sistema e depois volte aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите TurboSpark в Системных настройках, затем вернитесь сюда."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム設定でTurboSparkをオンにしてから、ここに戻ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 설정에서 TurboSpark를 켠 다음 여기로 돌아오세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在系统设置中打开 TurboSpark，然后返回此处。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在系統設定中開啟 TurboSpark，然後返回這裡。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فعّل TurboSpark في إعدادات النظام، ثم عد إلى هنا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להפעיל את TurboSpark בהגדרות המערכת ולאחר מכן לחזור לכאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम सेटिंग्ज़ में TurboSpark को चालू करें, फिर यहाँ लौटें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakel TurboSpark in via Systeeminstellingen en kom dan hier terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz TurboSpark w Ustawieniach systemowych, a następnie wróć tutaj."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem Ayarları'nda TurboSpark'ı açın, ardından buraya dönün."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Увімкніть TurboSpark у Системних параметрах, а потім поверніться сюди."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktivera TurboSpark i Systeminställningar och gå sedan tillbaka hit."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy bật TurboSpark trong Cài đặt hệ thống, rồi quay lại đây."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktifkan TurboSpark di Pengaturan Sistem, lalu kembali ke sini."
          }
        }
      }
