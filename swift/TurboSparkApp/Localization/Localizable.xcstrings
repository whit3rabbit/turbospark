                  "value": "%lld \u4e2a\u672c\u5730\u5bf9\u8bdd"
                }
              }
            }
          }
        },
        "zh-Hant": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld \u500b\u672c\u5730\u5c0d\u8a71"
                }
              }
            }
          }
        }
      }
    },
    "A backup comes back as a new user with a fresh identity and a name of its own, even when it was exported from the Default user. Keychain-stored hook secrets are not part of a backup.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0648\u062f \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0643\u0645\u0633\u062a\u062e\u062f\u0645 \u062c\u062f\u064a\u062f \u0628\u0647\u0648\u064a\u0629 \u062c\u062f\u064a\u062f\u0629 \u0648\u0627\u0633\u0645 \u062e\u0627\u0635 \u0628\u0647\u0627\u060c \u062d\u062a\u0649 \u0625\u0630\u0627 \u062a\u0645 \u062a\u0635\u062f\u064a\u0631\u0647\u0627 \u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a. \u0623\u0633\u0631\u0627\u0631 \u0627\u0644\u062e\u0637\u0627\u0641\u0627\u062a \u0627\u0644\u0645\u062e\u0632\u0646\u0629 \u0641\u064a \u0633\u0644\u0633\u0644\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0644\u064a\u0633\u062a \u062c\u0632\u0621\u0627 \u0645\u0646 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Backup kommt als neuer Benutzer mit eigener Identit\u00e4t und eigenem Namen zur\u00fcck, selbst wenn es vom Standardbenutzer exportiert wurde. Im Schl\u00fcsselbund gespeicherte Hook-Geheimnisse sind nicht Teil eines Backups."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A backup comes back as a new user with a fresh identity and a name of its own, even when it was exported from the Default user. Keychain-stored hook secrets are not part of a backup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una copia de seguridad se restaura como un usuario nuevo con identidad propia y su propio nombre, incluso si se export\u00f3 del usuario predeterminado. Los secretos de hooks guardados en el llavero no forman parte de una copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une sauvegarde revient comme un nouvel utilisateur avec une identit\u00e9 neuve et son propre nom, m\u00eame si elle a \u00e9t\u00e9 export\u00e9e depuis l'utilisateur par d\u00e9faut. Les secrets de hooks stock\u00e9s dans le trousseau ne font pas partie d'une sauvegarde."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d2\u05d9\u05d1\u05d5\u05d9 \u05d7\u05d5\u05d6\u05e8 \u05db\u05de\u05e9\u05ea\u05de\u05e9 \u05d7\u05d3\u05e9 \u05e2\u05dd \u05d6\u05d4\u05d5\u05ea \u05d7\u05d3\u05e9\u05d4 \u05d5\u05e9\u05dd \u05de\u05e9\u05dc\u05d5, \u05d2\u05dd \u05d0\u05dd \u05d9\u05d5\u05e6\u05d0 \u05de\u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05e8\u05d9\u05e8\u05ea \u05d4\u05de\u05d7\u05d3\u05dc. \u05e1\u05d5\u05d3\u05d5\u05ea \u05d4\u05d5\u05e7 \u05d4\u05de\u05d0\u05d5\u05d7\u05e1\u05e0\u05d9\u05dd \u05d1\u05e6\u05e8\u05d5\u05e8 \u05d4\u05de\u05e4\u05ea\u05d7\u05d5\u05ea \u05d0\u05d9\u05e0\u05dd \u05d7\u05dc\u05e7 \u05de\u05d2\u05d9\u05d1\u05d5\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0948\u0915\u0905\u092a \u090f\u0915 \u0928\u090f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0932\u094c\u091f\u0924\u093e \u0939\u0948 \u091c\u093f\u0938\u0915\u0940 \u0928\u0908 \u092a\u0939\u091a\u093e\u0928 \u0914\u0930 \u0905\u092a\u0928\u093e \u0928\u093e\u092e \u0939\u094b\u0924\u093e \u0939\u0948, \u092d\u0932\u0947 \u0939\u0940 \u0935\u0939 \u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u0947 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u094b\u0964 \u0915\u0940\u091a\u0947\u0928 \u092e\u0947\u0902 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0939\u0941\u0915 \u0930\u0939\u0938\u094d\u092f \u092c\u0948\u0915\u0905\u092a \u0915\u093e \u0939\u093f\u0938\u094d\u0938\u093e \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0947\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan kembali sebagai pengguna baru dengan identitas baru dan namanya sendiri, bahkan jika diekspor dari pengguna bawaan. Rahasia hook yang disimpan di Keychain bukan bagian dari cadangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un backup torna come un nuovo utente con una nuova identit\u00e0 e un nome proprio, anche se \u00e8 stato esportato dall'utente predefinito. I segreti degli hook memorizzati nel portachiavi non fanno parte di un backup."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306f\u3001\u30c7\u30d5\u30a9\u30eb\u30c8\u30e6\u30fc\u30b6\u30fc\u304b\u3089\u66f8\u304d\u51fa\u3055\u308c\u305f\u3082\u306e\u3067\u3042\u3063\u3066\u3082\u3001\u65b0\u3057\u3044\u8b58\u5225\u5b50\u3068\u72ec\u81ea\u306e\u540d\u524d\u3092\u6301\u3064\u65b0\u3057\u3044\u30e6\u30fc\u30b6\u30fc\u3068\u3057\u3066\u5fa9\u5143\u3055\u308c\u307e\u3059\u3002\u30ad\u30fc\u30c1\u30a7\u30fc\u30f3\u306b\u4fdd\u5b58\u3055\u308c\u305f\u30d5\u30c3\u30af\u306e\u30b7\u30fc\u30af\u30ec\u30c3\u30c8\u306f\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306b\u542b\u307e\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc31\uc5c5\uc740 \uae30\ubcf8 \uc0ac\uc6a9\uc790\uc5d0\uc11c \ub0b4\ubcf4\ub0b8 \uac83\uc774\ub354\ub77c\ub3c4 \uc0c8\ub85c\uc6b4 \uc2dd\ubcc4\uc790\uc640 \uace0\uc720\ud55c \uc774\ub984\uc744 \uac00\uc9c4 \uc0c8 \uc0ac\uc6a9\uc790\ub85c \ubcf5\uc6d0\ub429\ub2c8\ub2e4. \ud0a4\uccb4\uc778\uc5d0 \uc800\uc7a5\ub41c \ud6c5 \uc2dc\ud06c\ub9bf\uc740 \ubc31\uc5c5\uc5d0 \ud3ec\ud568\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een back-up komt terug als een nieuwe gebruiker met een nieuwe identiteit en een eigen naam, zelfs als deze is ge\u00ebxporteerd van de standaardgebruiker. In de sleutelhanger opgeslagen hook-geheimen maken geen deel uit van een back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia zapasowa wraca jako nowy u\u017cytkownik z now\u0105 to\u017csamo\u015bci\u0105 i w\u0142asn\u0105 nazw\u0105, nawet je\u015bli zosta\u0142a wyeksportowana z u\u017cytkownika domy\u015blnego. Sekrety hook\u00f3w przechowywane w p\u0119ku kluczy nie s\u0105 cz\u0119\u015bci\u0105 kopii zapasowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um backup volta como um novo usu\u00e1rio com identidade pr\u00f3pria e um nome pr\u00f3prio, mesmo quando exportado do usu\u00e1rio padr\u00e3o. Segredos de hooks guardados no chaveiro n\u00e3o fazem parte de um backup."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044f \u043a\u0430\u043a \u043d\u043e\u0432\u044b\u0439 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044c \u0441 \u043d\u043e\u0432\u043e\u0439 \u0438\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u0435\u0439 \u0438 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u043c \u0438\u043c\u0435\u043d\u0435\u043c, \u0434\u0430\u0436\u0435 \u0435\u0441\u043b\u0438 \u043e\u043d\u0430 \u0431\u044b\u043b\u0430 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430 \u0438\u0437 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e. \u0421\u0435\u043a\u0440\u0435\u0442\u044b \u0445\u0443\u043a\u043e\u0432, \u0445\u0440\u0430\u043d\u044f\u0449\u0438\u0435\u0441\u044f \u0432 \u0421\u0432\u044f\u0437\u043a\u0435 \u043a\u043b\u044e\u0447\u0435\u0439, \u043d\u0435 \u0432\u0445\u043e\u0434\u044f\u0442 \u0432 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443\u044e \u043a\u043e\u043f\u0438\u044e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En s\u00e4kerhetskopia kommer tillbaka som en ny anv\u00e4ndare med en ny identitet och ett eget namn, \u00e4ven om den exporterades fr\u00e5n standardanv\u00e4ndaren. Nyckelringlagrade hookhemligheter ing\u00e5r inte i en s\u00e4kerhetskopia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yedek, varsay\u0131lan kullan\u0131c\u0131dan d\u0131\u015fa aktar\u0131lm\u0131\u015f olsa bile yeni bir kimlik ve kendi ad\u0131yla yeni bir kullan\u0131c\u0131 olarak geri gelir. Anahtar zincirinde saklanan kanca s\u0131rlar\u0131 bir yede\u011fin par\u00e7as\u0131 de\u011fildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0437\u0435\u0440\u0432\u043d\u0430 \u043a\u043e\u043f\u0456\u044f \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0454\u0442\u044c\u0441\u044f \u044f\u043a \u043d\u043e\u0432\u0438\u0439 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447 \u0437 \u043d\u043e\u0432\u043e\u044e \u0456\u0434\u0435\u043d\u0442\u0438\u0447\u043d\u0456\u0441\u0442\u044e \u0442\u0430 \u0432\u043b\u0430\u0441\u043d\u0438\u043c \u0456\u043c'\u044f\u043c, \u043d\u0430\u0432\u0456\u0442\u044c \u044f\u043a\u0449\u043e \u0432\u043e\u043d\u0430 \u0431\u0443\u043b\u0430 \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0430 \u0437 \u0442\u0438\u043f\u043e\u0432\u043e\u0433\u043e \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430. \u0421\u0435\u043a\u0440\u0435\u0442\u0438 \u0445\u0443\u043a\u0456\u0432, \u0449\u043e \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u0432 \u0417\u0432'\u044f\u0437\u0446\u0456 \u043a\u043b\u044e\u0447\u0456\u0432, \u043d\u0435 \u0454 \u0447\u0430\u0441\u0442\u0438\u043d\u043e\u044e \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0457 \u043a\u043e\u043f\u0456\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n sao l\u01b0u quay l\u1ea1i nh\u01b0 m\u1ed9t ng\u01b0\u1eddi d\u00f9ng m\u1edbi v\u1edbi danh t\u00ednh m\u1edbi v\u00e0 t\u00ean ri\u00eang, ngay c\u1ea3 khi n\u00f3 \u0111\u01b0\u1ee3c xu\u1ea5t t\u1eeb ng\u01b0\u1eddi d\u00f9ng m\u1eb7c \u0111\u1ecbnh. C\u00e1c b\u00ed m\u1eadt hook l\u01b0u trong Keychain kh\u00f4ng ph\u1ea3i l\u00e0 m\u1ed9t ph\u1ea7n c\u1ee7a b\u1ea3n sao l\u01b0u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5907\u4efd\u4f1a\u4f5c\u4e3a\u4e00\u4e2a\u62e5\u6709\u5168\u65b0\u6807\u8bc6\u548c\u72ec\u7acb\u540d\u79f0\u7684\u65b0\u7528\u6237\u6062\u590d,\u5373\u4f7f\u5b83\u662f\u4ece\u9ed8\u8ba4\u7528\u6237\u5bfc\u51fa\u7684\u3002\u5b58\u50a8\u5728\u94a5\u5319\u4e32\u4e2d\u7684\u94a9\u5b50\u5bc6\u94a5\u4e0d\u5c5e\u4e8e\u5907\u4efd\u7684\u4e00\u90e8\u5206\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5099\u4efd\u6703\u4ee5\u64c1\u6709\u5168\u65b0\u8b58\u5225\u8207\u7368\u7acb\u540d\u7a31\u7684\u65b0\u4f7f\u7528\u8005\u8eab\u5206\u6062\u5fa9,\u5373\u4f7f\u662f\u5f9e\u9810\u8a2d\u4f7f\u7528\u8005\u532f\u51fa\u7684\u3002\u5132\u5b58\u5728\u9470\u5319\u5708\u4e2d\u7684\u639b\u9264\u5bc6\u9470\u4e0d\u5c6c\u65bc\u5099\u4efd\u7684\u4e00\u90e8\u5206\u3002"
          }
        }
      }
    },
    "A pinned hold outlives this app: quitting restores Apple's curve unless the toggle above is on. Fans can always be released with `thermalforge auto`.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0633\u062a\u0645\u0631 \u062a\u062b\u0628\u064a\u062a \u0627\u0644\u0645\u0631\u0648\u062d\u0629 \u0628\u0639\u062f \u0625\u063a\u0644\u0627\u0642 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642: \u064a\u0624\u062f\u064a \u0627\u0644\u062e\u0631\u0648\u062c \u0625\u0644\u0649 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0645\u0646\u062d\u0646\u0649 Apple \u0645\u0627 \u0644\u0645 \u064a\u0643\u0646 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0623\u0639\u0644\u0627\u0647 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644. \u064a\u0645\u0643\u0646 \u062f\u0627\u0626\u0645\u064b\u0627 \u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0645\u0631\u0627\u0648\u062d \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 `thermalforge auto`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein fixierter Zustand \u00fcberdauert diese App: Das Beenden stellt die Apple-Kurve wieder her, sofern der Schalter oben nicht aktiviert ist. L\u00fcfter k\u00f6nnen jederzeit mit `thermalforge auto` freigegeben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pinned hold outlives this app: quitting restores Apple's curve unless the toggle above is on. Fans can always be released with `thermalforge auto`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fijaci\u00f3n de ventilador sobrevive al cierre de esta app: salir restaura la curva de Apple a menos que el interruptor superior est\u00e9 activado. Los ventiladores siempre se pueden liberar con `thermalforge auto`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un maintien forc\u00e9 survit \u00e0 cette application : quitter restaure la courbe d'Apple \u00e0 moins que le bouton ci-dessus ne soit activ\u00e9. Les ventilateurs peuvent toujours \u00eatre lib\u00e9r\u00e9s avec `thermalforge auto`."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d7\u05d6\u05e7\u05d4 \u05de\u05e7\u05d5\u05d1\u05e2\u05ea \u05de\u05de\u05e9\u05d9\u05db\u05d4 \u05de\u05e2\u05d1\u05e8 \u05dc\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d6\u05d5: \u05d9\u05e6\u05d9\u05d0\u05d4 \u05de\u05e9\u05d7\u05d6\u05e8\u05ea \u05d0\u05ea \u05d4\u05e2\u05e7\u05d5\u05de\u05d4 \u05e9\u05dc Apple \u05d0\u05dc\u05d0 \u05d0\u05dd \u05d4\u05de\u05ea\u05d2 \u05dc\u05de\u05e2\u05dc\u05d4 \u05e4\u05d5\u05e2\u05dc. \u05ea\u05de\u05d9\u05d3 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05d7\u05e8\u05e8 \u05de\u05d0\u05d5\u05d5\u05e8\u05e8\u05d9\u05dd \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea `thermalforge auto`."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u093f\u0928 \u0915\u0940 \u0917\u0908 \u092a\u0915\u0921\u093c \u0907\u0938 \u0910\u092a \u0938\u0947 \u0906\u0917\u0947 \u0930\u0939\u0924\u0940 \u0939\u0948: \u091c\u092c \u0924\u0915 \u0915\u093f \u090a\u092a\u0930 \u0915\u093e \u091f\u0949\u0917\u0932 \u091a\u093e\u0932\u0942 \u0928 \u0939\u094b, \u091b\u094b\u0921\u093c\u0928\u093e Apple \u0915\u0947 \u0935\u0915\u094d\u0930 \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092a\u0902\u0916\u0947 \u0939\u092e\u0947\u0936\u093e `thermalforge auto` \u0915\u0947 \u0938\u093e\u0925 \u091c\u093e\u0930\u0940 \u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penahanan yang disematkan bertahan lebih lama dari aplikasi ini: keluar akan memulihkan kurva Apple kecuali tombol di atas aktif. Kipas selalu dapat dilepaskan dengan `thermalforge auto`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un blocco della ventola sopravvive alla chiusura dell'app: uscire ripristina la curva di Apple a meno che l'interruttore sopra non sia attivo. Le ventole possono sempre essere sbloccate con `thermalforge auto`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30f3\u306e\u56fa\u5b9a\u72b6\u614b\u306f\u3053\u306e\u30a2\u30d7\u30ea\u306e\u7d42\u4e86\u5f8c\u3082\u7dad\u6301\u3055\u308c\u307e\u3059\u3002\u4e0a\u8a18\u306e\u30c8\u30b0\u30eb\u304c\u30aa\u30f3\u306b\u306a\u3063\u3066\u3044\u306a\u3044\u9650\u308a\u3001\u7d42\u4e86\u3059\u308b\u3068 Apple \u306e\u66f2\u7dda\u306b\u623b\u308a\u307e\u3059\u3002\u30d5\u30a1\u30f3\u306f\u3044\u3064\u3067\u3082 `thermalforge auto` \u3067\u89e3\u653e\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud32c \uc18d\ub3c4 \uace0\uc815\uc740 \uc774 \uc571\uc774 \uc885\ub8cc\ub41c \ud6c4\uc5d0\ub3c4 \uc720\uc9c0\ub429\ub2c8\ub2e4. \uc704\uc758 \ud1a0\uae00\uc774 \ucf1c\uc838 \uc788\uc9c0 \uc54a\uc73c\uba74 \uc885\ub8cc \uc2dc Apple \uace1\uc120\uc73c\ub85c \ubcf5\uc6d0\ub429\ub2c8\ub2e4. \ud32c\uc740 \uc5b8\uc81c\ub4e0\uc9c0 `thermalforge auto`\ub85c \ud574\uc81c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vastgezette hold blijft behouden na het afsluiten van deze app: stoppen herstelt de Apple-curve, tenzij de schakelaar hierboven aan staat. Ventilatoren kunnen altijd worden vrijgegeven met `thermalforge auto`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypi\u0119ta blokada dzia\u0142a d\u0142u\u017cej ni\u017c ta aplikacja: wyj\u015bcie przywraca krzyw\u0105 Apple, chyba \u017ce powy\u017cszy prze\u0142\u0105cznik jest w\u0142\u0105czony. Wentylatory mo\u017cna zawsze zwolni\u0107 za pomoc\u0105 `thermalforge auto`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixa\u00e7\u00e3o da velocidade sobrevive ao encerramento do app: sair restaura a curva da Apple, a menos que a op\u00e7\u00e3o acima esteja ativada. As ventoinhas sempre podem ser liberadas com `thermalforge auto`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0438\u043a\u0441\u0430\u0446\u0438\u044f \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u043e\u0432 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u044f \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f: \u0432\u044b\u0445\u043e\u0434 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u043a\u0440\u0438\u0432\u0443\u044e Apple, \u0435\u0441\u043b\u0438 \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0442\u0435\u043b\u044c \u0432\u044b\u0448\u0435 \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d. \u0412\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u044b \u0432\u0441\u0435\u0433\u0434\u0430 \u043c\u043e\u0436\u043d\u043e \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u044c \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e `thermalforge auto`."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett f\u00e4st l\u00e4ge \u00f6verlever den h\u00e4r appen: avsluta \u00e5terst\u00e4ller Apples kurva om inte reglaget ovan \u00e4r p\u00e5. Fl\u00e4ktar kan alltid sl\u00e4ppas med `thermalforge auto`."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmi\u015f tutma bu uygulaman\u0131n \u00f6tesinde s\u00fcrer: yukar\u0131daki ge\u00e7i\u015f a\u00e7\u0131k olmad\u0131\u011f\u0131 s\u00fcrece \u00e7\u0131k\u0131\u015f Apple'\u0131n e\u011frisini geri y\u00fckler. Fanlar her zaman `thermalforge auto` ile serbest b\u0131rak\u0131labilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0456\u043a\u0441\u0430\u0446\u0456\u044f \u0432\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0456\u0432 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u0437\u0430\u043a\u0440\u0438\u0442\u0442\u044f \u0446\u0456\u0454\u0457 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438: \u0432\u0438\u0445\u0456\u0434 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u044e\u0454 \u043a\u0440\u0438\u0432\u0443 Apple, \u044f\u043a\u0449\u043e \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0447 \u0432\u0438\u0449\u0435 \u043d\u0435 \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e. \u0412\u0435\u043d\u0442\u0438\u043b\u044f\u0442\u043e\u0440\u0438 \u0437\u0430\u0432\u0436\u0434\u0438 \u043c\u043e\u0436\u043d\u0430 \u0437\u0432\u0456\u043b\u044c\u043d\u0438\u0442\u0438 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e `thermalforge auto`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tr\u1ea1ng th\u00e1i ghim qu\u1ea1t v\u1eabn t\u1ed3n t\u1ea1i sau \u1ee9ng d\u1ee5ng n\u00e0y: tho\u00e1t s\u1ebd kh\u00f4i ph\u1ee5c \u0111\u01b0\u1eddng cong c\u1ee7a Apple tr\u1eeb khi b\u1eadt n\u00fat chuy\u1ec3n \u0111\u1ed5i \u1edf tr\u00ean. Qu\u1ea1t lu\u00f4n c\u00f3 th\u1ec3 \u0111\u01b0\u1ee3c gi\u1ea3i ph\u00f3ng b\u1eb1ng `thermalforge auto`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56fa\u5b9a\u8f6c\u901f\u5728\u6b64\u5e94\u7528\u9000\u51fa\u540e\u4f9d\u7136\u751f\u6548\uff1a\u9664\u975e\u5f00\u542f\u4e0a\u65b9\u5f00\u5173\uff0c\u5426\u5219\u9000\u51fa\u5e94\u7528\u4f1a\u6062\u590d Apple \u9ed8\u8ba4\u98ce\u6247\u66f2\u7ebf\u3002\u968f\u65f6\u53ef\u901a\u8fc7 `thermalforge auto` \u91ca\u653e\u98ce\u6247\u63a7\u5236\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56fa\u5b9a\u8f49\u901f\u5728\u6b64\u61c9\u7528\u7a0b\u5f0f\u7d50\u675f\u5f8c\u4f9d\u7136\u751f\u6548\uff1a\u9664\u975e\u958b\u555f\u4e0a\u65b9\u958b\u95dc\uff0c\u5426\u5247\u7d50\u675f\u61c9\u7528\u7a0b\u5f0f\u6703\u6062\u5fa9 Apple \u9810\u8a2d\u98a8\u6247\u66f2\u7dda\u3002\u96a8\u6642\u53ef\u900f\u904e `thermalforge auto` \u91cb\u653e\u98a8\u6247\u63a7\u5236\u3002"
          }
        }
      }
    },
