    "Temporary chat: this conversation can't be recovered.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062d\u0627\u062f\u062b\u0629 \u0645\u0624\u0642\u062a\u0629: \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempor\u00e4rer Chat: Diese Unterhaltung kann nicht wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary chat: this conversation can't be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporal: esta conversaci\u00f3n no se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussion temporaire : cette conversation ne peut pas \u00eatre r\u00e9cup\u00e9r\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d9\u05d7\u05d4 \u05d6\u05de\u05e0\u05d9\u05ea: \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e9\u05d7\u05d6\u05e8 \u05d0\u05ea \u05d4\u05e9\u05d9\u05d7\u05d4 \u05d4\u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u091a\u0948\u091f: \u092f\u0939 \u092c\u093e\u0924\u091a\u0940\u0924 \u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan sementara: percakapan ini tidak dapat dipulihkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporanea: questa conversazione non pu\u00f2 essere recuperata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6642\u7684\u306a\u30c1\u30e3\u30c3\u30c8\u3067\u3059\u3002\u3053\u306e\u4f1a\u8a71\u306f\u5fa9\u5143\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc784\uc2dc \ub300\ud654: \uc774 \ub300\ud654\ub294 \ubcf5\uad6c\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tijdelijke chat: dit gesprek kan niet worden hersteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czat tymczasowy: tej rozmowy nie mo\u017cna odzyska\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat tempor\u00e1rio: esta conversa n\u00e3o pode ser recuperada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0447\u0430\u0442: \u044d\u0442\u0443 \u0431\u0435\u0441\u0435\u0434\u0443 \u043d\u0435\u043b\u044c\u0437\u044f \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tillf\u00e4llig chatt: den h\u00e4r konversationen kan inte \u00e5terst\u00e4llas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7ici sohbet: bu konu\u015fma kurtar\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u0438\u0439 \u0447\u0430\u0442: \u0446\u044e \u0440\u043e\u0437\u043c\u043e\u0432\u0443 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cu\u1ed9c tr\u00f2 chuy\u1ec7n t\u1ea1m th\u1eddi: kh\u00f4ng th\u1ec3 kh\u00f4i ph\u1ee5c n\u1ed9i dung n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e34\u65f6\u5bf9\u8bdd: \u6b64\u4f1a\u8bdd\u65e0\u6cd5\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66ab\u6642\u5c0d\u8a71: \u6b64\u5c0d\u8a71\u7121\u6cd5\u5fa9\u539f\u3002"
          }
        }
      }
    },
    "Temporary chats cannot be exported.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0635\u062f\u064a\u0631 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u0645\u0624\u0642\u062a\u0629."
