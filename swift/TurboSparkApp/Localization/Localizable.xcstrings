    "Manage local vectors": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u062a\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u062d\u0644\u064a\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Vektoren verwalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage local vectors"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionar vectores locales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
