    "Dropped %lld older turns to fit the context window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0623\u0642\u062f\u0645 \u0627\u0644\u062a\u064a \u0623\u064f\u0632\u064a\u0644\u062a \u0644\u0645\u0644\u0627\u0621\u0645\u0629 \u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0633\u064a\u0627\u0642: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld \u00e4ltere Runden entfernt, um ins Kontextfenster zu passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropped %lld older turns to fit the context window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartaron %lld turnos anteriores para ajustarse a la ventana de contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld anciens tours retir\u00e9s pour tenir dans la fen\u00eatre de contexte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d5\u05e8\u05d5\u05ea \u05d9\u05e9\u05e0\u05d9\u05dd \u05e9\u05d4\u05d5\u05e1\u05e8\u05d5 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d0\u05d9\u05dd \u05dc\u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8: %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u092e\u0947\u0902 \u092b\u093c\u093f\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f %lld \u092a\u0941\u0930\u093e\u0928\u0947 \u091f\u0930\u094d\u0928 \u0939\u091f\u093e\u090f \u0917\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giliran lama dibuang agar muat di jendela konteks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld turni precedenti rimossi per rientrare nella finestra di contesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u306b\u53ce\u3081\u308b\u305f\u3081\u3001\u53e4\u3044\u30bf\u30fc\u30f3\u3092 %lld \u4ef6\u524a\u9664\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucee8\ud14d\uc2a4\ud2b8 \uc708\ub3c4\uc6b0\uc5d0 \ub9de\ucd94\uae30 \uc704\ud574 \uc774\uc804 \ud134 %lld\uac1c\ub97c \uc81c\uc678\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld oudere beurten verwijderd om binnen het contextvenster te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starsze tury usuni\u0119te, aby zmie\u015bci\u0107 si\u0119 w oknie kontekstu: %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld turnos anteriores descartados para caber na janela de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0434\u0430\u043b\u0435\u043d\u043e \u0441\u0442\u0430\u0440\u044b\u0445 \u0445\u043e\u0434\u043e\u0432, \u0447\u0442\u043e\u0431\u044b \u0443\u043b\u043e\u0436\u0438\u0442\u044c\u0441\u044f \u0432 \u043e\u043a\u043d\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld \u00e4ldre turer togs bort f\u00f6r att rymmas i kontextf\u00f6nstret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u011flam penceresine s\u0131\u011fmas\u0131 i\u00e7in %lld eski tur \u00e7\u0131kar\u0131ld\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0434\u0430\u043b\u0435\u043d\u043e \u0441\u0442\u0430\u0440\u0456\u0448\u0438\u0445 \u0445\u043e\u0434\u0456\u0432, \u0449\u043e\u0431 \u0432\u043c\u0456\u0441\u0442\u0438\u0442\u0438\u0441\u044f \u0443 \u0432\u0456\u043a\u043d\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443: %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 b\u1ecf %lld l\u01b0\u1ee3t c\u0169 \u0111\u1ec3 v\u1eeba c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u9002\u5e94\u4e0a\u4e0b\u6587\u7a97\u53e3\uff0c\u5df2\u79fb\u9664 %lld \u4e2a\u8f83\u65e9\u7684\u8f6e\u6b21\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u7b26\u5408\u4e0a\u4e0b\u6587\u8996\u7a97\uff0c\u5df2\u79fb\u9664 %lld \u500b\u8f03\u65e9\u7684\u56de\u5408\u3002"
          }
        }
      }
    },
    "Dropped 1 older turn to fit the context window.": {
