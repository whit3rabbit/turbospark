    "Manage per-folder permissions in macOS Privacy & Security.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u062f\u0627\u0631\u0629 \u0623\u0630\u0648\u0646\u0627\u062a \u0643\u0644 \u0645\u062c\u0644\u062f \u0641\u064a \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0648\u0627\u0644\u0623\u0645\u0627\u0646 \u0641\u064a macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordnerbezogene Berechtigungen unter \u201eDatenschutz & Sicherheit\u201c von macOS verwalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage per-folder permissions in macOS Privacy & Security."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona los permisos de cada carpeta en Privacidad y seguridad de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e9rez les autorisations par dossier dans Confidentialit\u00e9 et s\u00e9curit\u00e9 de macOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d4\u05dc \u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05dc\u05db\u05dc \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05d1\u05e4\u05e8\u05d8\u05d9\u05d5\u05ea \u05d5\u05d0\u05d1\u05d8\u05d7\u05d4 \u05e9\u05dc macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u092e\u0947\u0902 \u0939\u0930 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0901 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola izin per folder di Privasi & Keamanan macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci i permessi per cartella in Privacy e sicurezza di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS\u306e\u300c\u30d7\u30e9\u30a4\u30d0\u30b7\u30fc\u3068\u30bb\u30ad\u30e5\u30ea\u30c6\u30a3\u300d\u3067\u30d5\u30a9\u30eb\u30c0\u3054\u3068\u306e\u6a29\u9650\u3092\u7ba1\u7406\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \uac1c\uc778\uc815\ubcf4 \ubcf4\ud638 \ubc0f \ubcf4\uc548\uc5d0\uc11c \ud3f4\ub354\ubcc4 \uad8c\ud55c\uc744 \uad00\ub9ac\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer machtigingen per map in Privacy en beveiliging van macOS."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarz\u0105dzaj uprawnieniami dla poszczeg\u00f3lnych folder\u00f3w w sekcji Prywatno\u015b\u0107 i ochrona systemu macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie as permiss\u00f5es de cada pasta em Privacidade e Seguran\u00e7a do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u0434\u043b\u044f \u043a\u0430\u0436\u0434\u043e\u0439 \u043f\u0430\u043f\u043a\u0438 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u041a\u043e\u043d\u0444\u0438\u0434\u0435\u043d\u0446\u0438\u0430\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u0438 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c\u00bb macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera beh\u00f6righeter per mapp i Integritet och s\u00e4kerhet i macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klas\u00f6r ba\u015f\u0131na izinleri macOS Gizlilik ve G\u00fcvenlik'te y\u00f6netin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0435\u0440\u0443\u0439\u0442\u0435 \u0434\u043e\u0437\u0432\u043e\u043b\u0430\u043c\u0438 \u0434\u043b\u044f \u043a\u043e\u0436\u043d\u043e\u0457 \u043f\u0430\u043f\u043a\u0438 \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u041f\u0440\u0438\u0432\u0430\u0442\u043d\u0456\u0441\u0442\u044c \u0456 \u0431\u0435\u0437\u043f\u0435\u043a\u0430\u00bb macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu\u1ea3n l\u00fd quy\u1ec1n cho t\u1eebng th\u01b0 m\u1ee5c trong Quy\u1ec1n ri\u00eang t\u01b0 & B\u1ea3o m\u1eadt c\u1ee7a macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 macOS \u7684\u201c\u9690\u79c1\u4e0e\u5b89\u5168\u6027\u201d\u4e2d\u7ba1\u7406\u6bcf\u4e2a\u6587\u4ef6\u5939\u7684\u6743\u9650\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 macOS \u7684\u300c\u96b1\u79c1\u6b0a\u8207\u5b89\u5168\u6027\u300d\u4e2d\u7ba1\u7406\u6bcf\u500b\u6a94\u6848\u593e\u7684\u6b0a\u9650\u3002"
          }
        }
      }
    },
    "Grant broad filesystem access for developer workflows.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0645\u0646\u062d \u0648\u0635\u0648\u0644\u064b\u0627 \u0648\u0627\u0633\u0639\u064b\u0627 \u0625\u0644\u0649 \u0646\u0638\u0627\u0645 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0644\u0633\u064a\u0631 \u0639\u0645\u0644 \u0627\u0644\u0645\u0637\u0648\u0631\u064a\u0646."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfassenden Dateisystemzugriff f\u00fcr Entwickler-Workflows gew\u00e4hren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Grant broad filesystem access for developer workflows."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Concede acceso amplio al sistema de archivos para flujos de trabajo de desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accordez un acc\u00e8s \u00e9tendu au syst\u00e8me de fichiers pour les flux de travail de d\u00e9veloppement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e2\u05e0\u05e7 \u05d2\u05d9\u05e9\u05d4 \u05e8\u05d7\u05d1\u05d4 \u05dc\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05e7\u05d1\u05e6\u05d9\u05dd \u05dc\u05ea\u05d4\u05dc\u05d9\u05db\u05d9 \u05e2\u05d1\u05d5\u05d3\u05d4 \u05e9\u05dc \u05de\u05e4\u05ea\u05d7\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u0947\u0935\u0932\u092a\u0930 \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b \u0915\u0947 \u0932\u093f\u090f \u092b\u093c\u093e\u0907\u0932 \u0938\u093f\u0938\u094d\u091f\u092e \u0915\u0940 \u0935\u094d\u092f\u093e\u092a\u0915 \u090f\u0915\u094d\u0938\u0947\u0938 \u0926\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berikan akses sistem file yang luas untuk alur kerja pengembang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Concedi un accesso ampio al file system per i flussi di lavoro di sviluppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u958b\u767a\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u306e\u305f\u3081\u306b\u30d5\u30a1\u30a4\u30eb\u30b7\u30b9\u30c6\u30e0\u3078\u306e\u5e83\u7bc4\u306a\u30a2\u30af\u30bb\u30b9\u3092\u8a31\u53ef\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac1c\ubc1c\uc790 \uc6cc\ud06c\ud50c\ub85c\ub97c \uc704\ud574 \ud30c\uc77c \uc2dc\uc2a4\ud15c\uc5d0 \ub300\ud55c \uad11\ubc94\uc704\ud55c \uc811\uadfc\uc744 \ud5c8\uc6a9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verleen brede bestandssysteemtoegang voor ontwikkelaarsworkflows."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyznaj szeroki dost\u0119p do systemu plik\u00f3w na potrzeby pracy programistycznej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conceda acesso amplo ao sistema de arquivos para fluxos de trabalho de desenvolvimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u0444\u0430\u0439\u043b\u043e\u0432\u043e\u0439 \u0441\u0438\u0441\u0442\u0435\u043c\u0435 \u0434\u043b\u044f \u0437\u0430\u0434\u0430\u0447 \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge bred \u00e5tkomst till filsystemet f\u00f6r utvecklarfl\u00f6den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geli\u015ftirici i\u015f ak\u0131\u015flar\u0131 i\u00e7in geni\u015f dosya sistemi eri\u015fimi verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0434\u0430\u0439\u0442\u0435 \u0448\u0438\u0440\u043e\u043a\u0438\u0439 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u0444\u0430\u0439\u043b\u043e\u0432\u043e\u0457 \u0441\u0438\u0441\u0442\u0435\u043c\u0438 \u0434\u043b\u044f \u0437\u0430\u0434\u0430\u0447 \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1ea5p quy\u1ec1n truy c\u1eadp r\u1ed9ng v\u00e0o h\u1ec7 th\u1ed1ng t\u1ec7p cho quy tr\u00ecnh l\u00e0m vi\u1ec7c c\u1ee7a nh\u00e0 ph\u00e1t tri\u1ec3n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u5f00\u53d1\u8005\u5de5\u4f5c\u6d41\u7a0b\u6388\u4e88\u5e7f\u6cdb\u7684\u6587\u4ef6\u7cfb\u7edf\u8bbf\u95ee\u6743\u9650\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u958b\u767c\u8005\u5de5\u4f5c\u6d41\u7a0b\u6388\u4e88\u5ee3\u6cdb\u7684\u6a94\u6848\u7cfb\u7d71\u53d6\u7528\u6b0a\u9650\u3002"
          }
        }
      }
    },
    "System control for global shortcuts and automation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u062d\u0643\u0645 \u0641\u064a \u0627\u0644\u0646\u0638\u0627\u0645 \u0644\u0644\u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0627\u0644\u0623\u062a\u0645\u062a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemsteuerung f\u00fcr globale Kurzbefehle und Automatisierung."
          }
        },
        "en": {
          "stringUnit": {
