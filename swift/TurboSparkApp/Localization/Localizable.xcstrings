    "Attach PDFs, Office documents, or source files to give a chat something to read.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0631\u0641\u0642 \u0645\u0644\u0641\u0627\u062a PDF \u0623\u0648 \u0645\u0633\u062a\u0646\u062f\u0627\u062a Office \u0623\u0648 \u0645\u0644\u0641\u0627\u062a \u0645\u0635\u062f\u0631\u064a\u0629 \u0644\u062a\u0645\u0646\u062d \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0634\u064a\u0626\u064b\u0627 \u062a\u0642\u0631\u0624\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e4nge PDFs, Office-Dokumente oder Quelldateien an, damit ein Chat etwas zum Lesen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach PDFs, Office documents, or source files to give a chat something to read."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta PDF, documentos de Office o archivos de c\u00f3digo para que un chat tenga algo que leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez des PDF, des documents Office ou des fichiers source pour donner \u00e0 une discussion quelque chose \u00e0 lire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e6\u05e8\u05e4\u05d5 \u05e7\u05d5\u05d1\u05e6\u05d9 PDF, \u05de\u05e1\u05de\u05db\u05d9 Office \u05d0\u05d5 \u05e7\u05d5\u05d1\u05e6\u05d9 \u05e7\u05d5\u05d3 \u05db\u05d3\u05d9 \u05dc\u05ea\u05ea \u05dc\u05e6'\u05d0\u05d8 \u05de\u05e9\u05d4\u05d5 \u05dc\u05e7\u05e8\u05d5\u05d0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0948\u091f \u0915\u094b \u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0926\u0947\u0928\u0947 \u0939\u0947\u0924\u0941 PDF, Office \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092f\u093e \u0938\u094b\u0930\u094d\u0938 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0938\u0902\u0932\u0917\u094d\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampirkan PDF, dokumen Office, atau file sumber agar obrolan punya bahan untuk dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Allega PDF, documenti Office o file sorgente per dare a una chat qualcosa da leggere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF\u3001Office\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u3001\u30bd\u30fc\u30b9\u30d5\u30a1\u30a4\u30eb\u3092\u6dfb\u4ed8\u3059\u308b\u3068\u3001\u30c1\u30e3\u30c3\u30c8\u3067\u8aad\u307f\u8fbc\u3081\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "PDF, Office \ubb38\uc11c \ub610\ub294 \uc18c\uc2a4 \ud30c\uc77c\uc744 \ucca8\ubd80\ud574 \ucc44\ud305\uc774 \uc77d\uc744 \uc790\ub8cc\ub97c \uc81c\uacf5\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg pdf\u2019s, Office-documenten of bronbestanden toe zodat een chat iets te lezen heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za\u0142\u0105cz pliki PDF, dokumenty Office lub pliki \u017ar\u00f3d\u0142owe, aby czat mia\u0142 co czyta\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe PDFs, documentos do Office ou arquivos de c\u00f3digo para dar ao chat algo para ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u0435 PDF, \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u044b Office \u0438\u043b\u0438 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0435 \u0444\u0430\u0439\u043b\u044b, \u0447\u0442\u043e\u0431\u044b \u0447\u0430\u0442\u0443 \u0431\u044b\u043b\u043e \u0447\u0442\u043e \u0447\u0438\u0442\u0430\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bifoga PDF:er, Office-dokument eller k\u00e4llfiler s\u00e5 att chatten har n\u00e5got att l\u00e4sa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetin okuyaca\u011f\u0131 bir \u015fey olmas\u0131 i\u00e7in PDF, Office belgeleri veya kaynak dosyalar\u0131 ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0434\u0430\u0439\u0442\u0435 PDF, \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0438 Office \u0430\u0431\u043e \u0432\u0438\u0445\u0456\u0434\u043d\u0456 \u0444\u0430\u0439\u043b\u0438, \u0449\u043e\u0431 \u0447\u0430\u0442\u0443 \u0431\u0443\u043b\u043e \u0449\u043e \u0447\u0438\u0442\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00ednh k\u00e8m PDF, t\u00e0i li\u1ec7u Office ho\u1eb7c t\u1ec7p ngu\u1ed3n \u0111\u1ec3 cu\u1ed9c tr\u00f2 chuy\u1ec7n c\u00f3 n\u1ed9i dung \u0111\u1ec3 \u0111\u1ecdc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9644\u52a0 PDF\u3001Office \u6587\u6863\u6216\u6e90\u6587\u4ef6\uff0c\u4e3a\u5bf9\u8bdd\u63d0\u4f9b\u53ef\u8bfb\u53d6\u7684\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9644\u52a0 PDF\u3001Office \u6587\u4ef6\u6216\u539f\u59cb\u78bc\u6a94\u6848\uff0c\u70ba\u5c0d\u8a71\u63d0\u4f9b\u53ef\u8b80\u53d6\u7684\u5167\u5bb9\u3002"
          }
        }
      }
    },
