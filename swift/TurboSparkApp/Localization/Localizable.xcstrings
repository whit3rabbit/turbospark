    "Downloads the model and starts a new chat with it": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0646\u0632\u0651\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0648\u064a\u0628\u062f\u0623 \u0645\u062d\u0627\u062f\u062b\u0629 \u062c\u062f\u064a\u062f\u0629 \u0628\u0647"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4dt das Modell herunter und startet damit einen neuen Chat"
