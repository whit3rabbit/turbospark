        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt grezzo legacy, senza modello di chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f93\u6765\u306e\u751f\u30d7\u30ed\u30f3\u30d7\u30c8\u3002\u30c1\u30e3\u30c3\u30c8\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u306f\u9069\u7528\u3055\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucc44\ud305 \ud15c\ud50c\ub9bf\uc744 \uc801\uc6a9\ud558\uc9c0 \uc54a\ub294 \ub808\uac70\uc2dc \uc6d0\uc2dc \ud504\ub86c\ud504\ud2b8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verouderde ruwe prompt, zonder chatsjabloon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starszy surowy prompt, bez szablonu czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt bruto legado, sem modelo de chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u0440\u0435\u0432\u0448\u0438\u0439 \u043d\u0435\u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u043c\u043f\u0442 \u0431\u0435\u0437 \u0448\u0430\u0431\u043b\u043e\u043d\u0430 \u0447\u0430\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4ldre r\u00e5 prompt, utan chattmall."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eski ham istem, sohbet \u015fablonu uygulanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0441\u0442\u0430\u0440\u0456\u043b\u0438\u0439 \u043d\u0435\u043e\u0431\u0440\u043e\u0431\u043b\u0435\u043d\u0438\u0439 \u043f\u0440\u043e\u043c\u043f\u0442 \u0431\u0435\u0437 \u0448\u0430\u0431\u043b\u043e\u043d\u0443 \u0447\u0430\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1eddi nh\u1eafc th\u00f4 ki\u1ec3u c\u0169, kh\u00f4ng \u00e1p d\u1ee5ng m\u1eabu tr\u00f2 chuy\u1ec7n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e7\u7248\u539f\u59cb\u63d0\u793a\u8bcd\uff0c\u4e0d\u5e94\u7528\u804a\u5929\u6a21\u677f\u3002"
