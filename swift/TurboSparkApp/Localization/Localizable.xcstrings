        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0915\u093e\u0930 \u091c\u093e\u0901\u091a\u093e \u0928\u0939\u0940\u0902 \u0917\u092f\u093e: \u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u093e \u092e\u0948\u0928\u093f\u092b\u093c\u0947\u0938\u094d\u091f \u0915\u094b\u0908 \u0939\u093f\u0921\u0928 \u0938\u093e\u0907\u091c\u093c \u0918\u094b\u0937\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964"
