    "Nothing attached yet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u0631\u0641\u0642 \u0623\u064a \u0634\u064a\u0621 \u0628\u0639\u062f."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts angeh\u00e4ngt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing attached yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan no hay nada adjunto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est encore joint."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05e6\u05d5\u05e8\u05e3 \u05d3\u05d1\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0924\u0915 \u0915\u0941\u091b \u092d\u0940 \u0938\u0902\u0932\u0917\u094d\u0928 \u0928\u0939\u0940\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada lampiran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non \u00e8 ancora stato allegato nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3060\u4f55\u3082\u6dfb\u4ed8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc9c1 \ucca8\ubd80\ub41c \ud56d\ubaa9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic jeszcze nie do\u0142\u0105czono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda n\u00e3o h\u00e1 nada anexado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget bifogat \u00e4n."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hen\u00fcz bir \u015fey eklenmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0438 \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0434\u043e\u0434\u0430\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a \u0111\u00ednh k\u00e8m g\u00ec."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u9644\u52a0\u4efb\u4f55\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u9644\u52a0\u4efb\u4f55\u5167\u5bb9\u3002"
          }
        }
      }
    },
    "Nothing has read this checkpoint's header, so its working set is unknown. `turbospark-model recommend --probe` reads it without downloading anything.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0642\u0631\u0623 \u0623\u062d\u062f \u062a\u0631\u0648\u064a\u0633\u0629 \u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0647\u0630\u0647\u060c \u0644\u0630\u0627 \u0641\u0625\u0646 \u0645\u062c\u0645\u0648\u0639\u0629 \u0639\u0645\u0644\u0647\u0627 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629. \u064a\u0642\u0631\u0623\u0647\u0627 `turbospark-model recommend --probe` \u062f\u0648\u0646 \u062a\u0646\u0632\u064a\u0644 \u0623\u064a \u0634\u064a\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand hat den Header dieses Checkpoints gelesen, daher ist sein Arbeitssatz unbekannt. `turbospark-model recommend --probe` liest ihn, ohne etwas herunterzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has read this checkpoint's header, so its working set is unknown. `turbospark-model recommend --probe` reads it without downloading anything."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ha le\u00eddo la cabecera de este checkpoint, as\u00ed que su conjunto de trabajo es desconocido. `turbospark-model recommend --probe` la lee sin descargar nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a lu l'en-t\u00eate de ce checkpoint, son jeu de travail est donc inconnu. `turbospark-model recommend --probe` le lit sans rien t\u00e9l\u00e9charger."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05e9 \u05dc\u05d0 \u05e7\u05e8\u05d0 \u05d0\u05ea \u05d4\u05db\u05d5\u05ea\u05e8\u05ea \u05e9\u05dc \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d4\u05d6\u05d5, \u05d5\u05dc\u05db\u05df \u05e7\u05d1\u05d5\u05e6\u05ea \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05e9\u05dc\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d9\u05d3\u05d5\u05e2\u05d4. \u05d4\u05e4\u05e7\u05d5\u05d3\u05d4 `turbospark-model recommend --probe` \u05e7\u05d5\u05e8\u05d0\u05ea \u05d0\u05d5\u05ea\u05d4 \u05d1\u05dc\u05d9 \u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05d3\u05d1\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u0915\u093e \u0939\u0947\u0921\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0928\u0939\u0940\u0902 \u092a\u0922\u093c\u093e, \u0907\u0938\u0932\u093f\u090f \u0907\u0938\u0915\u093e \u0935\u0930\u094d\u0915\u093f\u0902\u0917 \u0938\u0947\u091f \u0905\u091c\u094d\u091e\u093e\u0924 \u0939\u0948\u0964 `turbospark-model recommend --probe` \u0907\u0938\u0947 \u092c\u093f\u0928\u093e \u0915\u0941\u091b \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u093f\u090f \u092a\u0922\u093c\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang membaca header checkpoint ini, jadi working set-nya tidak diketahui. `turbospark-model recommend --probe` membacanya tanpa mengunduh apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno ha letto l'intestazione di questo checkpoint, quindi il suo working set \u00e8 sconosciuto. `turbospark-model recommend --probe` la legge senza scaricare nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306e\u30d8\u30c3\u30c0\u30fc\u306f\u307e\u3060\u8aad\u307f\u53d6\u3089\u308c\u3066\u3044\u306a\u3044\u305f\u3081\u3001\u30ef\u30fc\u30ad\u30f3\u30b0\u30bb\u30c3\u30c8\u306f\u4e0d\u660e\u3067\u3059\u3002`turbospark-model recommend --probe` \u306f\u4f55\u3082\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u305b\u305a\u306b\u30d8\u30c3\u30c0\u30fc\u3092\u8aad\u307f\u53d6\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uccb4\ud06c\ud3ec\uc778\ud2b8\uc758 \ud5e4\ub354\ub97c \uc77d\uc740 \uc801\uc774 \uc5c6\uc5b4 \uc791\uc5c5 \uc9d1\ud569\uc744 \uc54c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. `turbospark-model recommend --probe`\ub294 \uc544\ubb34\uac83\ub3c4 \ub0b4\ub824\ubc1b\uc9c0 \uc54a\uace0 \ud5e4\ub354\ub97c \uc77d\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets heeft de header van dit checkpoint gelezen, dus de werkset is onbekend. `turbospark-model recommend --probe` leest die zonder iets te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie odczyta\u0142 nag\u0142\u00f3wka tego punktu kontrolnego, wi\u0119c jego zbi\u00f3r roboczy jest nieznany. `turbospark-model recommend --probe` odczytuje go bez pobierania czegokolwiek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada leu o cabe\u00e7alho deste checkpoint, ent\u00e3o o conjunto de trabalho dele \u00e9 desconhecido. `turbospark-model recommend --probe` o l\u00ea sem baixar nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u044d\u0442\u043e\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0447\u0438\u0442\u0430\u043b, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0435\u0435 \u0440\u0430\u0431\u043e\u0447\u0438\u0439 \u043d\u0430\u0431\u043e\u0440 \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d. `turbospark-model recommend --probe` \u0447\u0438\u0442\u0430\u0435\u0442 \u0435\u0433\u043e, \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting har l\u00e4st det h\u00e4r checkpointens huvud, s\u00e5 dess arbetsm\u00e4ngd \u00e4r ok\u00e4nd. `turbospark-model recommend --probe` l\u00e4ser det utan att h\u00e4mta n\u00e5got."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu denetim noktas\u0131n\u0131n ba\u015fl\u0131\u011f\u0131n\u0131 hi\u00e7bir \u015fey okumad\u0131, bu y\u00fczden \u00e7al\u0131\u015fma k\u00fcmesi bilinmiyor. `turbospark-model recommend --probe` onu hi\u00e7bir \u015fey indirmeden okur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u043e\u043b\u043e\u0432\u043e\u043a \u0446\u0456\u0454\u0457 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0457 \u0442\u043e\u0447\u043a\u0438 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0447\u0438\u0442\u0430\u0432, \u0442\u043e\u0436 \u0457\u0457 \u0440\u043e\u0431\u043e\u0447\u0438\u0439 \u043d\u0430\u0431\u0456\u0440 \u043d\u0435\u0432\u0456\u0434\u043e\u043c\u0438\u0439. `turbospark-model recommend --probe` \u0447\u0438\u0442\u0430\u0454 \u0439\u043e\u0433\u043e, \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u044e\u0447\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00f3 g\u00ec \u0111\u1ecdc ph\u1ea7n \u0111\u1ea7u c\u1ee7a checkpoint n\u00e0y, n\u00ean t\u1eadp l\u00e0m vi\u1ec7c c\u1ee7a n\u00f3 ch\u01b0a x\u00e1c \u0111\u1ecbnh. `turbospark-model recommend --probe` \u0111\u1ecdc n\u00f3 m\u00e0 kh\u00f4ng t\u1ea3i xu\u1ed1ng b\u1ea5t c\u1ee9 th\u1ee9 g\u00ec."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u65e0\u4efb\u4f55\u64cd\u4f5c\u8bfb\u53d6\u8fc7\u8be5\u68c0\u67e5\u70b9\u7684\u6587\u4ef6\u5934\uff0c\u56e0\u6b64\u5176\u5de5\u4f5c\u96c6\u672a\u77e5\u3002`turbospark-model recommend --probe` \u53ef\u5728\u4e0d\u4e0b\u8f7d\u4efb\u4f55\u5185\u5bb9\u7684\u60c5\u51b5\u4e0b\u8bfb\u53d6\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u7121\u4efb\u4f55\u64cd\u4f5c\u8b80\u53d6\u904e\u8a72\u6aa2\u67e5\u9ede\u7684\u6a94\u982d\uff0c\u56e0\u6b64\u5176\u5de5\u4f5c\u96c6\u672a\u77e5\u3002`turbospark-model recommend --probe` \u53ef\u5728\u4e0d\u4e0b\u8f09\u4efb\u4f55\u5167\u5bb9\u7684\u60c5\u6cc1\u4e0b\u8b80\u53d6\u5b83\u3002"
          }
        }
      }
    },
    "Nothing has read this checkpoint's shape, so its footprint is unknown.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0642\u0631\u0623 \u0623\u062d\u062f \u0634\u0643\u0644 \u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0647\u0630\u0647\u060c \u0644\u0630\u0627 \u0641\u0625\u0646 \u0627\u0633\u062a\u0647\u0644\u0627\u0643\u0647\u0627 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand hat die Form dieses Checkpoints gelesen, daher ist sein Speicherbedarf unbekannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has read this checkpoint's shape, so its footprint is unknown."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ha le\u00eddo la forma de este checkpoint, as\u00ed que su huella es desconocida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a lu la forme de ce checkpoint, son empreinte est donc inconnue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05e9 \u05dc\u05d0 \u05e7\u05e8\u05d0 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05d4 \u05e9\u05dc \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d4\u05d6\u05d5, \u05d5\u05dc\u05db\u05df \u05d8\u05d1\u05d9\u05e2\u05ea \u05d4\u05e8\u05d2\u05dc \u05e9\u05dc\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d9\u05d3\u05d5\u05e2\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u0915\u093e \u0906\u0915\u093e\u0930 \u0915\u093f\u0938\u0940 \u0928\u0947 \u0928\u0939\u0940\u0902 \u092a\u0922\u093c\u093e, \u0907\u0938\u0932\u093f\u090f \u0907\u0938\u0915\u0940 \u0916\u092a\u0924 \u0905\u091c\u094d\u091e\u093e\u0924 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang membaca bentuk checkpoint ini, jadi jejak memorinya tidak diketahui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno ha letto la forma di questo checkpoint, quindi il suo ingombro \u00e8 sconosciuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306e\u5f62\u72b6\u306f\u307e\u3060\u8aad\u307f\u53d6\u3089\u308c\u3066\u3044\u306a\u3044\u305f\u3081\u3001\u5360\u6709\u91cf\u306f\u4e0d\u660e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uccb4\ud06c\ud3ec\uc778\ud2b8\uc758 \ud615\ud0dc\ub97c \uc77d\uc740 \uc801\uc774 \uc5c6\uc5b4 \uc0ac\uc6a9\ub7c9\uc744 \uc54c \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets heeft de vorm van dit checkpoint gelezen, dus het geheugenbeslag is onbekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie odczyta\u0142 kszta\u0142tu tego punktu kontrolnego, wi\u0119c jego zaj\u0119to\u015b\u0107 jest nieznana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada leu o formato deste checkpoint, ent\u00e3o o consumo dele \u00e9 desconhecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u043e\u0440\u043c\u0443 \u044d\u0442\u043e\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u043d\u0438\u043a\u0442\u043e \u043d\u0435 \u0447\u0438\u0442\u0430\u043b, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0435\u0435 \u043e\u0431\u044a\u0435\u043c \u043d\u0435\u0438\u0437\u0432\u0435\u0441\u0442\u0435\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting har l\u00e4st det h\u00e4r checkpointens form, s\u00e5 dess minnesanv\u00e4ndning \u00e4r ok\u00e4nd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu denetim noktas\u0131n\u0131n \u015feklini hi\u00e7bir \u015fey okumad\u0131, bu y\u00fczden kaplad\u0131\u011f\u0131 alan bilinmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u043e\u0440\u043c\u0443 \u0446\u0456\u0454\u0457 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0457 \u0442\u043e\u0447\u043a\u0438 \u043d\u0456\u0445\u0442\u043e \u043d\u0435 \u0447\u0438\u0442\u0430\u0432, \u0442\u043e\u0436 \u0457\u0457 \u043e\u0431\u0441\u044f\u0433 \u043d\u0435\u0432\u0456\u0434\u043e\u043c\u0438\u0439."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00f3 g\u00ec \u0111\u1ecdc h\u00ecnh d\u1ea1ng c\u1ee7a checkpoint n\u00e0y, n\u00ean m\u1ee9c chi\u1ebfm d\u1ee5ng ch\u01b0a x\u00e1c \u0111\u1ecbnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u65e0\u4efb\u4f55\u64cd\u4f5c\u8bfb\u53d6\u8fc7\u8be5\u68c0\u67e5\u70b9\u7684\u5f62\u72b6\uff0c\u56e0\u6b64\u5176\u5360\u7528\u672a\u77e5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u7121\u4efb\u4f55\u64cd\u4f5c\u8b80\u53d6\u904e\u8a72\u6aa2\u67e5\u9ede\u7684\u5f62\u72c0\uff0c\u56e0\u6b64\u5176\u5360\u7528\u672a\u77e5\u3002"
          }
        }
      }
    },
    "Nothing is installed. Choose a curated variant above to get started.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u0634\u064a\u0621 \u0645\u062b\u0628\u062a. \u0627\u062e\u062a\u0631 \u0645\u062a\u063a\u064a\u0631\u064b\u0627 \u0645\u0646\u0633\u0642\u064b\u0627 \u0623\u0639\u0644\u0627\u0647 \u0644\u0644\u0628\u062f\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist installiert. Wahlen Sie oben eine ausgewahlte Variante, um zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is installed. Choose a curated variant above to get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada instalado. Elige una variante seleccionada arriba para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est installe. Choisissez une variante selectionnee ci-dessus pour commencer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d5\u05dd \u05d3\u05d1\u05e8 \u05dc\u05d0 \u05de\u05d5\u05ea\u05e7\u05df. \u05d1\u05d7\u05e8\u05d5 \u05d2\u05e8\u05e1\u05d4 \u05e0\u05d1\u05d7\u05e8\u05ea \u05dc\u05de\u05e2\u05dc\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0941\u091b \u092d\u0940 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090a\u092a\u0930 \u0938\u0947 \u091a\u0941\u0928\u093e \u0939\u0941\u0906 \u0935\u0948\u0930\u093f\u090f\u0902\u091f \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang terpasang. Pilih varian pilihan di atas untuk memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non e installato nulla. Scegli una variante selezionata sopra per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u305f\u3082\u306e\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u4e0a\u306e\u5019\u88dc\u3092\u9078\u3093\u3067\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ub41c \ud56d\ubaa9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc704\uc5d0\uc11c \uc5c4\uc120\ud55c \ubcc0\ud615\uc744 \uc120\ud0dd\ud574 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is niets geinstalleerd. Kies hierboven een geselecteerde variant om te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie jest zainstalowane. Wybierz powyzej wybrany wariant, aby zaczac."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada esta instalado. Escolha uma variante selecionada acima para comecar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichego ne ustanovleno. Vyberite vyshe podobrannyi variant dlya nachala."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget ar installerat. Valj en utvald variant ovan for att borja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hicbir sey yuklu degil. Baslamak icin yukaridan secili bir varyant secin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0456\u0447\u043e\u0433\u043e \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0432\u0438\u0449\u0435 \u043f\u0456\u0434\u0456\u0431\u0440\u0430\u043d\u0438\u0439 \u0432\u0430\u0440\u0456\u0430\u043d\u0442, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chua cai dat gi. Hay chon mot bien the da chon o tren de bat dau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u5b89\u88c5\u4efb\u4f55\u5185\u5bb9\u3002\u8bf7\u9009\u62e9\u4e0a\u9762\u7684\u7cbe\u9009\u53d8\u4f53\u5f00\u59cb\u4f7f\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u5b89\u88dd\u4efb\u4f55\u5167\u5bb9\u3002\u8acb\u9078\u64c7\u4e0a\u65b9\u7684\u7cbe\u9078\u8b8a\u9ad4\u958b\u59cb\u4f7f\u7528\u3002"
          }
        }
      }
    },
    "Nothing yet. The model saves memories as it learns durable facts; you can save one with `#` followed by text.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u0634\u064a\u0621 \u0628\u0639\u062f. \u064a\u062d\u0641\u0638 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0630\u0643\u0631\u064a\u0627\u062a \u0623\u062b\u0646\u0627\u0621 \u062a\u0639\u0644\u0645\u0647 \u062d\u0642\u0627\u0626\u0642 \u062f\u0627\u0626\u0645\u0629\u061b \u064a\u0645\u0643\u0646\u0643 \u062d\u0641\u0638 \u0630\u0643\u0631\u0649 \u0628\u0643\u062a\u0627\u0628\u0629 `#` \u064a\u062a\u0628\u0639\u0647\u0627 \u0646\u0635."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts vorhanden. Das Modell speichert Eintr\u00e4ge, wenn es dauerhafte Fakten lernt; Sie k\u00f6nnen einen Eintrag mit `#` gefolgt von Text speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet. The model saves memories as it learns durable facts; you can save one with `#` followed by text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan no hay nada. El modelo guarda recuerdos a medida que aprende datos duraderos; puedes guardar uno con `#` seguido de texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour le moment. Le mod\u00e8le enregistre des m\u00e9moires \u00e0 mesure qu'il apprend des faits durables ; vous pouvez en enregistrer une avec `#` suivi de texte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d3\u05d9\u05d9\u05df \u05d0\u05d9\u05df \u05db\u05dc\u05d5\u05dd. \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05d5\u05de\u05e8 \u05d6\u05d9\u05db\u05e8\u05d5\u05e0\u05d5\u05ea \u05db\u05e9\u05d4\u05d5\u05d0 \u05dc\u05d5\u05de\u05d3 \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd \u05d1\u05e0\u05d9 \u05e7\u05d9\u05d9\u05de\u05d0; \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e9\u05de\u05d5\u05e8 \u05d0\u05d7\u05d3 \u05d1\u05d0\u05de\u05e6\u05e2\u05d5\u05ea `#` \u05d5\u05d0\u05d7\u05e8\u05d9\u05d5 \u05d8\u05e7\u05e1\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0915\u0941\u091b \u0928\u0939\u0940\u0902\u0964 \u092e\u0949\u0921\u0932 \u091f\u093f\u0915\u093e\u090a \u0924\u0925\u094d\u092f \u0938\u0940\u0916\u0928\u0947 \u092a\u0930 \u092e\u0947\u092e\u094b\u0930\u0940 \u0938\u0939\u0947\u091c\u0924\u093e \u0939\u0948; \u0906\u092a `#` \u0915\u0947 \u092c\u093e\u0926 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0932\u093f\u0916\u0915\u0930 \u090f\u0915 \u0938\u0939\u0947\u091c \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada apa pun. Model menyimpan memori saat mempelajari fakt yang bertahan; Anda dapat menyimpannya dengan `#` diikuti teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente. Il modello salva memorie mentre apprende fatti duraturi; puoi salvarne una con `#` seguito da testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3060\u4f55\u3082\u3042\u308a\u307e\u305b\u3093\u3002\u30e2\u30c7\u30eb\u304c\u6c38\u7d9a\u7684\u306a\u4e8b\u5b9f\u3092\u5b66\u3076\u3068\u30e1\u30e2\u30ea\u304c\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002`#` \u306b\u7d9a\u3051\u3066\u30c6\u30ad\u30b9\u30c8\u3092\u5165\u529b\u3059\u308b\u3068\u4fdd\u5b58\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc9c1 \uc5c6\uc2b5\ub2c8\ub2e4. \ubaa8\ub378\uc774 \uc9c0\uc18d\uc801\uc778 \uc0ac\uc2e4\uc744 \ud559\uc2b5\ud558\uba74\uc11c \uba54\ubaa8\ub9ac\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. `#` \ub4a4\uc5d0 \ud14d\uc2a4\ud2b8\ub97c \uc785\ub825\ud558\uc5ec \uc800\uc7a5\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets. Het model slaat herinneringen op terwijl het duurzame feiten leert; je kunt er een opslaan met `#` gevolgd door tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na razie pusto. Model zapisuje wpisy pami\u0119ci w miar\u0119 uczenia si\u0119 trwa\u0142ych fakt\u00f3w; mo\u017cesz zapisa\u0107 wpis, wpisuj\u0105c `#` i tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada por enquanto. O modelo salva mem\u00f3rias \u00e0 medida que aprende fatos duradouros; voc\u00ea pode salvar uma com `#` seguido de texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430 \u043d\u0438\u0447\u0435\u0433\u043e \u043d\u0435\u0442. \u041c\u043e\u0434\u0435\u043b\u044c \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0437\u0430\u043f\u0438\u0441\u0438 \u043f\u0430\u043c\u044f\u0442\u0438 \u043f\u043e \u043c\u0435\u0440\u0435 \u0438\u0437\u0443\u0447\u0435\u043d\u0438\u044f \u0443\u0441\u0442\u043e\u0439\u0447\u0438\u0432\u044b\u0445 \u0444\u0430\u043a\u0442\u043e\u0432; \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u044c \u043c\u043e\u0436\u043d\u043e \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e `#` \u0438 \u0442\u0435\u043a\u0441\u0442\u0430 \u043f\u043e\u0441\u043b\u0435 \u043d\u0435\u0433\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget \u00e4nnu. Modellen sparar minnen n\u00e4r den l\u00e4r sig varaktiga fakta; du kan spara ett med `#` f\u00f6ljt av text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hen\u00fcz bir \u015fey yok. Model kal\u0131c\u0131 olgular\u0131 \u00f6\u011frenirken an\u0131lar kaydeder; `#` yaz\u0131p metin ekleyerek bir an\u0131 kaydedebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0438 \u043d\u0456\u0447\u043e\u0433\u043e \u043d\u0435\u043c\u0430\u0454. \u041c\u043e\u0434\u0435\u043b\u044c \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0437\u0430\u043f\u0438\u0441\u0438 \u043f\u0430\u043c'\u044f\u0442\u0456, \u043a\u043e\u043b\u0438 \u0432\u0438\u0432\u0447\u0430\u0454 \u0441\u0442\u0456\u0439\u043a\u0456 \u0444\u0430\u043a\u0442\u0438; \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u0437\u0430\u043f\u0438\u0441 \u043c\u043e\u0436\u043d\u0430 \u0447\u0435\u0440\u0435\u0437 `#` \u0456 \u0442\u0435\u043a\u0441\u0442 \u043f\u0456\u0441\u043b\u044f \u043d\u044c\u043e\u0433\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00f3 g\u00ec. M\u00f4 h\u00ecnh l\u01b0u ghi nh\u1edb khi h\u1ecdc \u0111\u01b0\u1ee3c c\u00e1c s\u1ef1 ki\u1ec7n b\u1ec1n v\u1eefng; b\u1ea1n c\u00f3 th\u1ec3 l\u01b0u m\u1ed9t ghi nh\u1edb b\u1eb1ng c\u00e1ch nh\u1eadp `#` k\u00e8m theo v\u0103n b\u1ea3n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6682\u65e0\u5185\u5bb9\u3002\u6a21\u578b\u4f1a\u5728\u5b66\u4e60\u5230\u6301\u4e45\u4e8b\u5b9e\u65f6\u4fdd\u5b58\u8bb0\u5fc6\uff1b\u4f60\u53ef\u4ee5\u8f93\u5165 `#` \u52a0\u6587\u672c\u624b\u52a8\u4fdd\u5b58\u4e00\u6761\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u7121\u5167\u5bb9\u3002\u6a21\u578b\u6703\u5728\u5b78\u5230\u6301\u4e45\u4e8b\u5be6\u6642\u4fdd\u5b58\u8a18\u61b6\uff1b\u4f60\u53ef\u4ee5\u8f38\u5165 `#` \u52a0\u6587\u5b57\u624b\u52d5\u5132\u5b58\u4e00\u689d\u3002"
          }
        }
      }
    },
