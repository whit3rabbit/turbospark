            "value": "\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0438 \u043f\u0440\u043e\u0439\u0434\u0435\u043d\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 qua ki\u1ec3m tra"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u68c0\u67e5\u901a\u8fc7"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6aa2\u67e5\u901a\u904e"
          }
        }
