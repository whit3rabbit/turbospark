    "Nothing to rewind: this conversation has no finished turn yet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u0634\u064a\u0621 \u0644\u0625\u0631\u062c\u0627\u0639\u0647: \u0644\u0627 \u062a\u0648\u062c\u062f \u0641\u064a \u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0623\u062f\u0648\u0627\u0631 \u0645\u0643\u062a\u0645\u0644\u0629 \u0628\u0639\u062f."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts zum Zur\u00fcckspulen: Diese Unterhaltung hat noch keine abgeschlossene Runde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to rewind: this conversation has no finished turn yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada que rebobinar: esta conversaci\u00f3n a\u00fan no tiene ning\u00fan turno terminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien \u00e0 annuler : cette conversation n'a encore aucun tour termin\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05de\u05d4 \u05dc\u05d4\u05d7\u05d6\u05d9\u05e8: \u05d1\u05e9\u05d9\u05d7\u05d4 \u05d4\u05d6\u05d5 \u05e2\u05d3\u05d9\u05d9\u05df \u05d0\u05d9\u05df \u05ea\u05d5\u05e8 \u05e9\u05d4\u05e1\u05ea\u05d9\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0940\u091b\u0947 \u0932\u0947 \u091c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0928\u0939\u0940\u0902: \u0907\u0938 \u092c\u093e\u0924\u091a\u0940\u0924 \u092e\u0947\u0902 \u0905\u092d\u0940 \u0915\u094b\u0908 \u092a\u0942\u0930\u093e \u091a\u0930\u0923 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada yang bisa dimundurkan: percakapan ini belum punya giliran yang selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente da riavvolgere: questa conversazione non ha ancora turni completati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5dfb\u304d\u623b\u305b\u308b\u3082\u306e\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u3053\u306e\u4f1a\u8a71\u306b\u306f\u307e\u3060\u5b8c\u4e86\u3057\u305f\u30bf\u30fc\u30f3\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub418\uac10\uc744 \ub0b4\uc6a9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc774 \ub300\ud654\uc5d0\ub294 \uc544\uc9c1 \uc644\ub8cc\ub41c \ud134\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets om terug te spoelen: dit gesprek heeft nog geen afgeronde beurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma czego cofa\u0107: ta rozmowa nie ma jeszcze zako\u0144czonej tury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada para voltar: esta conversa ainda n\u00e3o tem nenhum turno conclu\u00eddo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0447\u0435\u0433\u043e \u043e\u0442\u043a\u0430\u0442\u044b\u0432\u0430\u0442\u044c: \u0432 \u044d\u0442\u043e\u043c \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0435 \u0435\u0449\u0451 \u043d\u0435\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d\u043d\u044b\u0445 \u0445\u043e\u0434\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att spola tillbaka: konversationen har ingen avslutad tur \u00e4n."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sar\u0131lacak bir \u015fey yok: bu konu\u015fmada hen\u00fcz tamamlanm\u0131\u015f bir tur yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0447\u043e\u0433\u043e \u043f\u043e\u0432\u0435\u0440\u0442\u0430\u0442\u0438: \u0443 \u0446\u0456\u0439 \u0440\u043e\u0437\u043c\u043e\u0432\u0456 \u0449\u0435 \u043d\u0435\u043c\u0430\u0454 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0438\u0445 \u0445\u043e\u0434\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 g\u00ec \u0111\u1ec3 tua l\u1ea1i: cu\u1ed9c tr\u00f2 chuy\u1ec7n n\u00e0y ch\u01b0a c\u00f3 l\u01b0\u1ee3t n\u00e0o ho\u00e0n t\u1ea5t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u53ef\u56de\u9000\u7684\u5185\u5bb9\uff1a\u6b64\u5bf9\u8bdd\u8fd8\u6ca1\u6709\u5b8c\u6210\u7684\u8f6e\u6b21\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u53ef\u5012\u56de\u7684\u5167\u5bb9\uff1a\u6b64\u5c0d\u8a71\u9084\u6c92\u6709\u5b8c\u6210\u7684\u8f2a\u6b21\u3002"
          }
        }
      }
    },
    "Off. No edit is applied to the residual stream.": {
