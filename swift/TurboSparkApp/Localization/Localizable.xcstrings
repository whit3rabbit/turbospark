    "Unloaded %@ and ejected the drive.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء تحميل %@ وإخراج محرك الأقراص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde entladen und das Laufwerk wurde ausgeworfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unloaded %@ and ejected the drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descargó %@ y se expulsó la unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été déchargé et le disque a été éjecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ נפרק והכונן הוצא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अनलोड किया गया और ड्राइव इजेक्ट कर दी गई।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dibongkar dan drive dikeluarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato scaricato e l'unità è stata espulsa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をアンロードし、ドライブを取り出しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 언로드하고 드라이브를 추출했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is ontladen en de schijf is uitgeworpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyładowano %@ i wysunięto dysk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi descarregado e a unidade foi ejetada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выгружено, диск извлечён."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har laddats ur och enheten har matats ut."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ boşaltıldı ve sürücü çıkarıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вивантажено, диск витягнуто."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dỡ bỏ %@ và đã đẩy ổ đĩa ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已卸载 %@ 并推出驱动器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已卸載 %@ 並退出磁碟機。"
          }
        }
      }
    },
    "Unloaded %@ because its drive was disconnected. Eject a drive before disconnecting it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إلغاء تحميل %@ لأن محرك الأقراص الخاص به فُصل. أخرج محرك الأقراص قبل فصله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde entladen, weil das zugehörige Laufwerk getrennt wurde. Werfen Sie ein Laufwerk aus, bevor Sie es trennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unloaded %@ because its drive was disconnected. Eject a drive before disconnecting it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descargó %@ porque se desconectó su unidad. Expulsa la unidad antes de desconectarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été déchargé car son disque a été déconnecté. Éjectez un disque avant de le déconnecter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ נפרק מכיוון שהכונן שלו נותק. הוצא כונן לפני שמנתקים אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अनलोड किया गया क्योंकि उसकी ड्राइव डिस्कनेक्ट कर दी गई थी। ड्राइव को डिस्कनेक्ट करने से पहले इजेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ dibongkar karena drive-nya terputus. Keluarkan drive sebelum melepasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato scaricato perché la sua unità è stata scollegata. Espelli un'unità prima di scollegarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ドライブが取り外されたため、%@ をアンロードしました。ドライブを取り外す前に、取り出してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "드라이브 연결이 끊겨 %@을(를) 언로드했습니다. 드라이브를 분리하기 전에 먼저 추출하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is ontladen omdat de bijbehorende schijf is losgekoppeld. Werp een schijf uit voordat u deze loskoppelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyładowano %@, ponieważ jego dysk został odłączony. Przed odłączeniem dysku należy go wysunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ foi descarregado porque a unidade foi desconectada. Ejete a unidade antes de desconectá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ выгружено, потому что диск был отключён. Извлекайте диск, прежде чем отключать его."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har laddats ur eftersom enheten kopplades bort. Mata ut en enhet innan du kopplar bort den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sürücü bağlantısı kesildiği için %@ boşaltıldı. Bir sürücüyü ayırmadan önce çıkarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ вивантажено, бо диск було відключено. Витягайте диск, перш ніж відключати його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã dỡ bỏ %@ vì ổ đĩa của nó đã bị ngắt kết nối. Hãy đẩy ổ đĩa ra trước khi ngắt kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由于驱动器已断开连接，已卸载 %@。请先推出驱动器，再将其断开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由於磁碟機已中斷連線，已卸載 %@。請先退出磁碟機，再將其拔除。"
          }
        }
      }
    },
    "Unloaded %@, but the drive could not be ejected: %@": {
