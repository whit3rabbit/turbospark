          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093f\u0930\u093e\u0938\u0924 \u092e\u0947\u0902 \u092e\u093f\u0932\u0947 \u0938\u094d\u0930\u094b\u0924 \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
