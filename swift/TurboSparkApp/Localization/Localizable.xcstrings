        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het genereren is zonder resultaat be\u00ebindigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Generowanie zako\u0144czy\u0142o si\u0119 bez wyniku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gera\u00e7\u00e3o terminou sem resultado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0430\u0441\u044c \u0431\u0435\u0437 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0430."
