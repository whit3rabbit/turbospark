    "In-app audio is off. Turn it on in Settings > Audio & Voice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0635\u0648\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u062a\u0648\u0642\u0641. \u0634\u063a\u0651\u0644\u0647 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a > \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0643\u0644\u0627\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In-App-Audio ist aus. Aktiviere es unter Einstellungen > Audio & Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In-app audio is off. Turn it on in Settings > Audio & Voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio en la app est\u00e1 desactivado. Act\u00edvalo en Ajustes > Audio y voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio dans l'app est d\u00e9sactiv\u00e9. Activez-le dans R\u00e9glages > Audio et voix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05de\u05e2 \u05d1\u05ea\u05d5\u05da \u05d4\u05d9\u05d9\u05e9\u05d5\u05dd \u05db\u05d1\u05d5\u05d9. \u05d4\u05e4\u05e2\u05dc \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea > \u05e9\u05de\u05e2 \u05d5\u05e7\u05d5\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0928-\u0910\u092a \u0911\u0921\u093f\u092f\u094b \u092c\u0902\u0926 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u0911\u0921\u093f\u092f\u094b \u0914\u0930 \u0935\u0949\u0907\u0938 \u092e\u0947\u0902 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dalam aplikasi nonaktif. Aktifkan di Pengaturan > Audio & Suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio nell'app \u00e8 disattivato. Attivalo in Impostazioni > Audio e voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30d7\u30ea\u5185\u30aa\u30fc\u30c7\u30a3\u30aa\u306f\u30aa\u30d5\u3067\u3059\u3002\u300c\u8a2d\u5b9a\u300d>\u300c\u30aa\u30fc\u30c7\u30a3\u30aa\u3068\u97f3\u58f0\u300d\u3067\u30aa\u30f3\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc571 \ub0b4 \uc624\ub514\uc624\uac00 \uaebc\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc124\uc815 > \uc624\ub514\uc624 \ubc0f \uc74c\uc131\uc5d0\uc11c \ucf1c\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio in de app staat uit. Zet het aan via Instellingen > Audio en stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u017awi\u0119k w aplikacji jest wy\u0142\u0105czony. W\u0142\u0105cz go w Ustawienia > D\u017awi\u0119k i g\u0142os."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O \u00e1udio no app est\u00e1 desativado. Ative-o em Ajustes > \u00c1udio e voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0432\u0443\u043a \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u00bb > \u00ab\u0417\u0432\u0443\u043a \u0438 \u0433\u043e\u043b\u043e\u0441\u00bb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljud i appen \u00e4r avst\u00e4ngt. Sl\u00e5 p\u00e5 det i Inst\u00e4llningar > Ljud och r\u00f6st."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama i\u00e7i ses kapal\u0131. Ayarlar > Ses ve Konu\u015fma b\u00f6l\u00fcm\u00fcnden a\u00e7\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0432\u0443\u043a \u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u00bb > \u00ab\u0417\u0432\u0443\u043a \u0456 \u0433\u043e\u043b\u043e\u0441\u00bb."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c2m thanh trong \u1ee9ng d\u1ee5ng \u0111ang t\u1eaft. H\u00e3y b\u1eadt trong C\u00e0i \u0111\u1eb7t > \u00c2m thanh v\u00e0 gi\u1ecdng n\u00f3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e94\u7528\u5185\u97f3\u9891\u5df2\u5173\u95ed\u3002\u8bf7\u5728\u201c\u8bbe\u7f6e\u201d>\u201c\u97f3\u9891\u4e0e\u8bed\u97f3\u201d\u4e2d\u5f00\u542f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App \u5167\u97f3\u8a0a\u5df2\u95dc\u9589\u3002\u8acb\u5728\u300c\u8a2d\u5b9a\u300d>\u300c\u97f3\u8a0a\u8207\u8a9e\u97f3\u300d\u4e2d\u958b\u555f\u3002"
          }
        }
      }
    },
