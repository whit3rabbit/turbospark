    "Cancels the download; nothing is kept, and the model can be re-installed after the cancelled walk exits": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يلغي التنزيل؛ لا يُحتفظ بشيء، ويمكن إعادة تثبيت النموذج بعد انتهاء العملية الملغاة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bricht den Download ab; nichts wird behalten, und das Modell kann nach Ende des abgebrochenen Durchlaufs neu installiert werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancels the download; nothing is kept, and the model can be re-installed after the cancelled walk exits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela la descarga; no se conserva nada y el modelo puede reinstalarse cuando termine el proceso cancelado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Annule le téléchargement ; rien n’est conservé et le modèle peut être réinstallé une fois le parcours annulé terminé"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מבטל את ההורדה; דבר אינו נשמר, ואפשר להתקין את המודל מחדש לאחר שהתהליך שבוטל מסתיים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डाउनलोड रद्द करता है; कुछ भी नहीं रखा जाता, और रद्द की गई प्रक्रिया पूरी होने के बाद मॉडल फिर से इंस्टॉल किया जा सकता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membatalkan unduhan; tidak ada yang disimpan, dan model dapat diinstal ulang setelah proses yang dibatalkan selesai"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annulla il download; non viene conservato nulla e il modello può essere reinstallato al termine del processo annullato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダウンロードをキャンセルします。何も保持されず、キャンセルされた処理が終了した後にモデルを再インストールできます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다운로드를 취소합니다. 아무것도 남지 않으며, 취소된 작업이 끝나면 모델을 다시 설치할 수 있습니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Annuleert de download; er wordt niets bewaard en het model kan opnieuw worden geïnstalleerd zodra het geannuleerde proces is gestopt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anuluje pobieranie; nic nie zostaje zachowane, a model można zainstalować ponownie po zakończeniu anulowanego procesu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancela o download; nada é mantido e o modelo pode ser reinstalado depois que o processo cancelado terminar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отменяет загрузку; ничего не сохраняется, и модель можно установить заново после завершения отменённого процесса"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avbryter nedladdningen; inget sparas och modellen kan installeras igen när den avbrutna processen har avslutats"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İndirmeyi iptal eder; hiçbir şey saklanmaz ve iptal edilen işlem bittikten sonra model yeniden yüklenebilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скасовує завантаження; нічого не зберігається, і модель можна встановити знову після завершення скасованого процесу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hủy tải xuống; không giữ lại gì và có thể cài lại mô hình sau khi tiến trình đã hủy kết thúc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消下载；不会保留任何内容，取消的过程结束后可以重新安装模型"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "取消下載；不會保留任何內容，取消的程序結束後可以重新安裝模型"
          }
        }
      }
    },
