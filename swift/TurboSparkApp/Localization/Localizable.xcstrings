    "No engine speech model is installed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u062b\u0628\u064e\u0651\u062a \u0623\u064a \u0646\u0645\u0648\u0630\u062c \u0643\u0644\u0627\u0645 \u0644\u0644\u0645\u062d\u0631\u0643."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Spracherkennungsmodell f\u00fcr die Engine installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No engine speech model is installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ning\u00fan modelo de voz del motor instalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mod\u00e8le de reconnaissance vocale du moteur n'est install\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05de\u05d5\u05ea\u05e7\u05df \u05de\u05d5\u05d3\u05dc \u05d3\u05d9\u05d1\u05d5\u05e8 \u05dc\u05de\u05e0\u05d5\u05e2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0907\u0902\u091c\u0928 \u0938\u094d\u092a\u0940\u091a \u092e\u0949\u0921\u0932 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada model ucapan mesin yang terpasang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello vocale del motore \u00e8 installato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a8\u30f3\u30b8\u30f3\u7528\u306e\u97f3\u58f0\u8a8d\u8b58\u30e2\u30c7\u30eb\u304c\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5d4\uc9c4 \uc74c\uc131 \uc778\uc2dd \ubaa8\ub378\uc774 \uc124\uce58\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen spraakmodel voor de engine ge\u00efnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie zainstalowano modelu mowy dla silnika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo de fala do mecanismo est\u00e1 instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0438\u044f \u0440\u0435\u0447\u0438 \u0434\u043b\u044f \u0434\u0432\u0438\u0436\u043a\u0430 \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen talmodell f\u00f6r motorn \u00e4r installerad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fckl\u00fc bir motor konu\u015fma modeli yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0440\u0443\u0448\u0456\u044f \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00e0i m\u00f4 h\u00ecnh nh\u1eadn d\u1ea1ng gi\u1ecdng n\u00f3i cho b\u1ed9 m\u00e1y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u5b89\u88c5\u5f15\u64ce\u8bed\u97f3\u8bc6\u522b\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u5b89\u88dd\u5f15\u64ce\u8a9e\u97f3\u8fa8\u8b58\u6a21\u578b\u3002"
          }
        }
      }
    },
