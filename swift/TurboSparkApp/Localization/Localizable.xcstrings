            "state": "translated",
            "value": "\u00d6ffnungs- & Architekturoptionen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open & Architecture Options"
          }
        },
        "es": {
          "stringUnit": {
