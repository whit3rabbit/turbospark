    "The same address and API key as Text. One installed MLX image model can be attached at a time.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نفس العنوان ومفتاح API الخاص بالنص. يمكن إرفاق نموذج صورة MLX مثبت واحد فقط في كل مرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Adresse und API-Schlüssel wie Text. Es kann jeweils nur ein installiertes MLX-Bildmodell angehängt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same address and API key as Text. One installed MLX image model can be attached at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma dirección y clave API que Texto. Solo se puede conectar un modelo de imagen MLX instalado a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même adresse et clé API que Texte. Un seul modèle d'image MLX installé peut être associé à la fois."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אותה כתובת ומפתח API כמו בטקסט. ניתן לחבר מודל תמונות MLX מותקן אחד בכל פעם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेक्स्ट के समान पता और API कुंजी। एक समय में केवल एक स्थापित MLX छवि मॉडल संलग्न किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat dan kunci API yang sama dengan Teks. Hanya satu model gambar MLX terpasang yang dapat dilampirkan dalam satu waktu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stesso indirizzo e chiave API del testo. È possibile collegare un solo modello di immagine MLX installato alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "テキストと同じアドレスおよびAPIキー。同時に接続できるインストール済みのMLX画像モデルは1つのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "텍스트와 동일한 주소 및 API 키입니다. 한 번에 하나의 설치된 MLX 이미지 모델만 연결할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hetzelfde adres en dezelfde API-sleutel als Tekst. Er kan één geïnstalleerd MLX-beeldmodel tegelijk worden gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten sam adres i klucz API co dla tekstu. W danym momencie można podłączyć tylko jeden zainstalowany model obrazu MLX."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O mesmo endereço e chave de API do Texto. Apenas um modelo de imagem MLX instalado pode ser anexado por vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тот же адрес и ключ API, что и для текста. Одновременно может быть подключена только одна установленная модель изображений MLX."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samma adress och API-nyckel som Text. Endast en installerad MLX-bildmodell kan anslutas åt gången."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin ile aynı adres ve API anahtarı. Aynı anda yalnızca bir kurulu MLX görüntü modeli bağlanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Та сама адреса та ключ API, що й для тексту. Одночасно можна підключити лише одну встановлену модель зображень MLX."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng địa chỉ và khóa API như Văn bản. Chỉ có thể gắn một mô hình hình ảnh MLX đã cài đặt cùng một lúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与文本相同的地址和 API 密钥。一次只能附加一个已安装的 MLX 图像模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與文字相同的位址和 API 金鑰。一次只能附加一個已安裝的 MLX 圖像模型。"
          }
        }
      }
    },
    "The same address and API key as Text. Serves OpenAI-compatible /v1/audio/speech with voice cloning extensions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
