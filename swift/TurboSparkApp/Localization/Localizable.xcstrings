          "stringUnit": {
            "state": "translated",
            "value": "\u30d9\u30f3\u30c1\u30de\u30fc\u30af\u8868\u793a: \u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u30b0\u30e9\u30d5 (\u30af\u30ea\u30c3\u30af\u3067\u6570\u5024\u306b\u5207\u308a\u66ff\u3048)"
