    "Nothing to recap yet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u0627 \u064a\u064f\u0644\u062e\u064e\u0651\u0635 \u0628\u0639\u062f."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zusammenzufassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to recap yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan no hay nada que resumir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien \u00e0 r\u00e9capituler pour l'instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05d4 \u05dc\u05e1\u05db\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0938\u093e\u0930\u093e\u0902\u0936 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang bisa diringkas."
