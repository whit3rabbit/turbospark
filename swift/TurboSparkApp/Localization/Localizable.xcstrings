    "Set a codebase root directory above to enable indexing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u064a\u0651\u0646 \u062f\u0644\u064a\u0644 \u062c\u0630\u0631 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0629 \u0623\u0639\u0644\u0627\u0647 \u0644\u062a\u0645\u0643\u064a\u0646 \u0627\u0644\u0641\u0647\u0631\u0633\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie oben das Stammverzeichnis des Codes fest, um die Indizierung zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a codebase root directory above to enable indexing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define arriba el directorio ra\u00edz del c\u00f3digo para activar la indexaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9finissez ci-dessus le dossier racine du code pour activer l'indexation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05e9 \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05dc\u05de\u05e2\u05dc\u05d4 \u05d0\u05ea \u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05e9\u05d5\u05e8\u05e9 \u05e9\u05dc \u05d1\u05e1\u05d9\u05e1 \u05d4\u05e7\u05d5\u05d3 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05d9\u05e0\u05d3\u05d5\u05e7\u05e1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0902\u0921\u0947\u0915\u094d\u0938\u093f\u0902\u0917 \u091a\u093e\u0932\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090a\u092a\u0930 \u0915\u094b\u0921\u092c\u0947\u0938 \u0930\u0942\u091f \u0921\u093e\u092f\u0930\u0947\u0915\u094d\u091f\u0930\u0940 \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan direktori root basis kode di atas untuk mengaktifkan pengindeksan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta sopra la directory radice del codice per abilitare l'indicizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u4f5c\u6210\u3092\u6709\u52b9\u306b\u3059\u308b\u306b\u306f\u3001\u4e0a\u3067\u30b3\u30fc\u30c9\u30d9\u30fc\u30b9\u306e\u30eb\u30fc\u30c8\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u3092\u8a2d\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc778\ub371\uc2f1\uc744 \ud65c\uc131\ud654\ud558\ub824\uba74 \uc704\uc5d0\uc11c \ucf54\ub4dc\ubca0\uc774\uc2a4 \ub8e8\ud2b8 \ub514\ub809\ud130\ub9ac\ub97c \uc124\uc815\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel hierboven de hoofdmap van de codebase in om indexering in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw powy\u017cej katalog g\u0142\u00f3wny kodu, aby w\u0142\u0105czy\u0107 indeksowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina acima a pasta raiz do c\u00f3digo para ativar a indexa\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0432\u044b\u0448\u0435 \u043a\u043e\u0440\u043d\u0435\u0432\u0443\u044e \u043f\u0430\u043f\u043a\u0443 \u043a\u043e\u0434\u0430, \u0447\u0442\u043e\u0431\u044b \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0438\u043d\u0434\u0435\u043a\u0441\u0430\u0446\u0438\u044e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange kodbasens rotmapp ovan f\u00f6r att aktivera indexering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizinlemeyi etkinle\u015ftirmek i\u00e7in yukar\u0131da kod taban\u0131 k\u00f6k dizinini ayarlay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0456\u0442\u044c \u0432\u0438\u0449\u0435 \u043a\u043e\u0440\u0435\u043d\u0435\u0432\u0443 \u043f\u0430\u043f\u043a\u0443 \u043a\u043e\u0434\u0443, \u0449\u043e\u0431 \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0456\u043d\u0434\u0435\u043a\u0441\u0443\u0432\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t th\u01b0 m\u1ee5c g\u1ed1c c\u1ee7a m\u00e3 ngu\u1ed3n \u1edf tr\u00ean \u0111\u1ec3 b\u1eadt l\u1eadp ch\u1ec9 m\u1ee5c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728\u4e0a\u65b9\u8bbe\u7f6e\u4ee3\u7801\u5e93\u6839\u76ee\u5f55\u4ee5\u542f\u7528\u7d22\u5f15\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728\u4e0a\u65b9\u8a2d\u5b9a\u7a0b\u5f0f\u78bc\u5eab\u6839\u76ee\u9304\u4ee5\u555f\u7528\u7d22\u5f15\u3002"
          }
        }
      }
    },
