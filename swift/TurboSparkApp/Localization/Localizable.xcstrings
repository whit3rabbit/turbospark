        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz nazw\u0119 identyfikuj\u0105c\u0105 ten czat."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um nome que identifique este chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u043c\u044f, \u043a\u043e\u0442\u043e\u0440\u043e\u0435 \u0431\u0443\u0434\u0435\u0442 \u043e\u0431\u043e\u0437\u043d\u0430\u0447\u0430\u0442\u044c \u044d\u0442\u043e\u0442 \u0447\u0430\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj ett namn som identifierar den h\u00e4r chatten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sohbeti tan\u0131mlayan bir ad se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043d\u0430\u0437\u0432\u0443, \u044f\u043a\u0430 \u0456\u0434\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0443\u0454 \u0446\u0435\u0439 \u0447\u0430\u0442."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn t\u00ean nh\u1eadn di\u1ec7n cu\u1ed9c tr\u00f2 chuy\u1ec7n n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u4e00\u4e2a\u80fd\u6807\u8bc6\u6b64\u5bf9\u8bdd\u7684\u540d\u79f0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u4e00\u500b\u80fd\u6a19\u8b58\u6b64\u5c0d\u8a71\u7684\u540d\u7a31\u3002"
          }
        }
      }
    },
    "Choose a palette for both Light and Dark. Your fonts and text sizes stay the same.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0644\u0648\u062d\u0629 \u0623\u0644\u0648\u0627\u0646 \u0644\u0644\u0648\u0636\u0639\u064a\u0646 \u0627\u0644\u0641\u0627\u062a\u062d \u0648\u0627\u0644\u062f\u0627\u0643\u0646. \u062a\u0638\u0644 \u0627\u0644\u062e\u0637\u0648\u0637 \u0648\u0623\u062d\u062c\u0627\u0645 \u0627\u0644\u0646\u0635\u0648\u0635 \u0643\u0645\u0627 \u0647\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie eine Palette f\u00fcr Hell und Dunkel. Ihre Schriften und Textgr\u00f6\u00dfen bleiben unver\u00e4ndert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a palette for both Light and Dark. Your fonts and text sizes stay the same."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una paleta para claro y oscuro. Las fuentes y tama\u00f1os de texto no cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une palette pour les modes clair et sombre. Vos polices et tailles de texte restent inchang\u00e9es."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05e4\u05dc\u05d8\u05d4 \u05dc\u05de\u05e6\u05d1 \u05d1\u05d4\u05d9\u05e8 \u05d5\u05db\u05d4\u05d4 \u05db\u05d0\u05d7\u05d3. \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05dd \u05d5\u05d2\u05d3\u05dc\u05d9 \u05d4\u05d8\u05e7\u05e1\u05d8 \u05d9\u05d9\u05e9\u05d0\u05e8\u05d5 \u05dc\u05dc\u05d0 \u05e9\u05d9\u05e0\u05d5\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u093e\u0907\u091f \u0914\u0930 \u0921\u093e\u0930\u094d\u0915 \u0926\u094b\u0928\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u092a\u0948\u0932\u0947\u091f \u091a\u0941\u0928\u0947\u0902\u0964 \u0906\u092a\u0915\u0947 \u092b\u093c\u0949\u0928\u094d\u091f \u0914\u0930 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0906\u0915\u093e\u0930 \u0935\u0939\u0940 \u0930\u0939\u0947\u0902\u0917\u0947\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih palet untuk Terang dan Gelap. Font dan ukuran teks Anda tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una tavolozza per chiaro e scuro. Caratteri e dimensioni del testo restano invariati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e9\u30a4\u30c8\u3068\u30c0\u30fc\u30af\u4e21\u65b9\u306e\u30d1\u30ec\u30c3\u30c8\u3092\u9078\u629e\u3057\u307e\u3059\u3002\u30d5\u30a9\u30f3\u30c8\u3068\u30c6\u30ad\u30b9\u30c8\u30b5\u30a4\u30ba\u306f\u5909\u308f\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub77c\uc774\ud2b8 \ubc0f \ub2e4\ud06c \ubaa8\ub4dc\uc5d0 \ub9de\ub294 \uc0c9\uc0c1\ud45c\ub97c \uc120\ud0dd\ud558\uc138\uc694. \uae00\uaf34\uacfc \ud14d\uc2a4\ud2b8 \ud06c\uae30\ub294 \uadf8\ub300\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een palet voor zowel Licht als Donker. Uw lettertypen en tekstgroottes blijven hetzelfde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz palet\u0119 dla trybu jasnego i ciemnego. Czcionki i rozmiary tekstu pozostan\u0105 bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma paleta para claro e escuro. Suas fontes e tamanhos de texto permanecem os mesmos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0430\u043b\u0438\u0442\u0440\u0443 \u0434\u043b\u044f \u0441\u0432\u0435\u0442\u043b\u043e\u0433\u043e \u0438 \u0442\u0435\u043c\u043d\u043e\u0433\u043e \u0440\u0435\u0436\u0438\u043c\u043e\u0432. \u0428\u0440\u0438\u0444\u0442\u044b \u0438 \u0440\u0430\u0437\u043c\u0435\u0440\u044b \u0442\u0435\u043a\u0441\u0442\u0430 \u043e\u0441\u0442\u0430\u043d\u0443\u0442\u0441\u044f \u043f\u0440\u0435\u0436\u043d\u0438\u043c\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en palett f\u00f6r b\u00e5de ljust och m\u00f6rkt l\u00e4ge. Dina teckensnitt och textstorlekar f\u00f6rblir desamma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hem A\u00e7\u0131k hem Koyu i\u00e7in bir palet se\u00e7in. Yaz\u0131 tipleriniz ve metin boyutlar\u0131n\u0131z ayn\u0131 kal\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0430\u043b\u0456\u0442\u0440\u0443 \u0434\u043b\u044f \u0441\u0432\u0456\u0442\u043b\u043e\u0457 \u0442\u0430 \u0442\u0435\u043c\u043d\u043e\u0457 \u0442\u0435\u043c. \u0428\u0440\u0438\u0444\u0442\u0438 \u0442\u0430 \u0440\u043e\u0437\u043c\u0456\u0440\u0438 \u0442\u0435\u043a\u0441\u0442\u0443 \u0437\u0430\u043b\u0438\u0448\u0430\u0442\u044c\u0441\u044f \u043d\u0435\u0437\u043c\u0456\u043d\u043d\u0438\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn b\u1ea3ng m\u00e0u cho c\u1ea3 ch\u1ebf \u0111\u1ed9 S\u00e1ng v\u00e0 T\u1ed1i. Ph\u00f4ng ch\u1eef v\u00e0 c\u1ee1 ch\u1eef c\u1ee7a b\u1ea1n gi\u1eef nguy\u00ean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u6d45\u8272\u548c\u6df1\u8272\u6a21\u5f0f\u9009\u62e9\u8c03\u8272\u677f\u3002\u60a8\u7684\u5b57\u4f53\u548c\u6587\u672c\u5b57\u53f7\u5c06\u4fdd\u6301\u4e0d\u53d8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u6dfa\u8272\u548c\u6df1\u8272\u6a21\u5f0f\u9078\u64c7\u8abf\u8272\u76e4\u3002\u60a8\u7684\u5b57\u578b\u548c\u6587\u5b57\u5927\u5c0f\u5c07\u4fdd\u6301\u4e0d\u8b8a\u3002"
          }
        }
      }
    },
    "Choose a prompt, edit it, or write your own.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0645\u0637\u0627\u0644\u0628\u0629 \u0623\u0648 \u0639\u062f\u0651\u0644\u0647\u0627 \u0623\u0648 \u0627\u0643\u062a\u0628 \u0645\u0637\u0627\u0644\u0628\u062a\u0643 \u0627\u0644\u062e\u0627\u0635\u0629."
