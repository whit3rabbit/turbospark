            "state": "translated",
            "value": "Coba hapus pencarian atau filter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova a cancellare la ricerca o i filtri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u691c\u7d22\u8a9e\u3084\u30d5\u30a3\u30eb\u30bf\u3092\u89e3\u9664\u3057\u3066\u307f\u3066\u304f\u3060\u3055\u3044\u3002"
