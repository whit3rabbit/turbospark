    "Audio and edits are saved in your encrypted profile.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio and edits are saved in your encrypted profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio y los cambios se guardan en tu perfil cifrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio et les modifications sont enregistr\u00e9s dans votre profil chiffr\u00e9."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio und \u00c4nderungen werden in deinem verschl\u00fcsselten Profil gespeichert."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio e le modifiche vengono salvati nel tuo profilo crittografato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O \u00e1udio e as edi\u00e7\u00f5es s\u00e3o salvos no seu perfil criptografado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio en bewerkingen worden opgeslagen in je versleutelde profiel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljud och \u00e4ndringar sparas i din krypterade profil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u017awi\u0119k i zmiany s\u0105 zapisywane w zaszyfrowanym profilu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses ve d\u00fczenlemeler \u015fifreli profilinize kaydedilir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio dan suntingan disimpan dalam profil terenkripsi Anda."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0434\u0438\u043e \u0438 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f \u0432 \u0432\u0430\u0448\u0435\u043c \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c \u043f\u0440\u043e\u0444\u0438\u043b\u0435."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0434\u0456\u043e \u0442\u0430 \u0437\u043c\u0456\u043d\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u0443 \u0432\u0430\u0448\u043e\u043c\u0443 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0444\u0456\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c2m thanh v\u00e0 c\u00e1c ch\u1ec9nh s\u1eeda \u0111\u01b0\u1ee3c l\u01b0u trong h\u1ed3 s\u01a1 \u0111\u00e3 m\u00e3 h\u00f3a c\u1ee7a b\u1ea1n."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u58f0\u3068\u7de8\u96c6\u5185\u5bb9\u306f\u6697\u53f7\u5316\u3055\u308c\u305f\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub514\uc624\uc640 \ud3b8\uc9d1 \ub0b4\uc6a9\uc740 \uc554\ud638\ud654\ub41c \ud504\ub85c\ud544\uc5d0 \uc800\uc7a5\ub429\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u9891\u548c\u7f16\u8f91\u5185\u5bb9\u4f1a\u4fdd\u5b58\u5728\u60a8\u7684\u52a0\u5bc6\u4e2a\u4eba\u8d44\u6599\u4e2d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u8a0a\u548c\u7de8\u8f2f\u5167\u5bb9\u6703\u5132\u5b58\u5728\u60a8\u7684\u52a0\u5bc6\u500b\u4eba\u6a94\u6848\u4e2d\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0645 \u062d\u0641\u0638 \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a \u0641\u064a \u0645\u0644\u0641\u0643 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0645\u0634\u0641\u0651\u0631."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05de\u05e2 \u05d5\u05d4\u05e2\u05e8\u05d9\u05db\u05d5\u05ea \u05e0\u05e9\u05de\u05e8\u05d9\u05dd \u05d1\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05d5\u05e6\u05e4\u05df \u05e9\u05dc\u05da."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0911\u0921\u093f\u092f\u094b \u0914\u0930 \u0938\u0902\u092a\u093e\u0926\u0928 \u0906\u092a\u0915\u0940 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u0940 \u0917\u0908 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u0938\u0939\u0947\u091c\u0947 \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        }
      }
    },
