    "Set a codebase root directory above to enable indexing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عيّن دليل جذر قاعدة التعليمات البرمجية أعلاه لتمكين الفهرسة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie oben das Stammverzeichnis des Codes fest, um die Indizierung zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set a codebase root directory above to enable indexing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define arriba el directorio raíz del código para activar la indexación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez ci-dessus le dossier racine du code pour activer l'indexation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להגדיר למעלה את תיקיית השורש של בסיס הקוד כדי להפעיל אינדוקס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंडेक्सिंग चालू करने के लिए ऊपर कोडबेस रूट डायरेक्टरी सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan direktori root basis kode di atas untuk mengaktifkan pengindeksan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta sopra la directory radice del codice per abilitare l'indicizzazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インデックス作成を有効にするには、上でコードベースのルートディレクトリを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인덱싱을 활성화하려면 위에서 코드베이스 루트 디렉터리를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel hierboven de hoofdmap van de codebase in om indexering in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw powyżej katalog główny kodu, aby włączyć indeksowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina acima a pasta raiz do código para ativar a indexação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите выше корневую папку кода, чтобы включить индексацию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange kodbasens rotmapp ovan för att aktivera indexering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizinlemeyi etkinleştirmek için yukarıda kod tabanı kök dizinini ayarlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть вище кореневу папку коду, щоб увімкнути індексування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt thư mục gốc của mã nguồn ở trên để bật lập chỉ mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在上方设置代码库根目录以启用索引。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在上方設定程式碼庫根目錄以啟用索引。"
          }
        }
      }
    },
