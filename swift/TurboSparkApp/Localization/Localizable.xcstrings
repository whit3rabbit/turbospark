    "A server named '%@' already exists. Rename or remove it first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد خادم باسم «%@» بالفعل. أعد تسميته أو أزله أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Server mit dem Namen „%@“ ist bereits vorhanden. Benennen Sie ihn zuerst um oder entfernen Sie ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server named '%@' already exists. Rename or remove it first."
