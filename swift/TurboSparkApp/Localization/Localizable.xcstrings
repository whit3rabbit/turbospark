            "value": "תקרת אסימונים לשנייה. 0 משאיר את היצירה ללא הגבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रति सेकंड टोकन की ऊपरी सीमा। 0 रखने पर जनरेशन असीमित रहता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas atas token per detik. 0 membuat pembuatan tanpa batas."
          }
        },
        "it": {
