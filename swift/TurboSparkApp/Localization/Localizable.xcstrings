    "Stop serving this and release it from memory.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u064a\u0642\u0627\u0641 \u062a\u0642\u062f\u064a\u0645 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0648\u062a\u062d\u0631\u064a\u0631\u0647 \u0645\u0646 \u0627\u0644\u0630\u0627\u0643\u0631\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereitstellung beenden und aus dem Speicher entfernen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop serving this and release it from memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de servirlo y liberarlo de la memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eater de le servir et le lib\u00e9rer de la m\u00e9moire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e1\u05e7 \u05dc\u05d4\u05d2\u05d9\u05e9 \u05d0\u05d5\u05ea\u05d5 \u05d5\u05e9\u05d7\u05e8\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05de\u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938\u0947 \u0938\u0930\u094d\u0935 \u0915\u0930\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u0947\u0902 \u0914\u0930 \u092e\u0947\u092e\u094b\u0930\u0940 \u0938\u0947 \u0939\u091f\u093e\u090f\u0901\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti menyajikan ini dan lepaskan dari memori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi il servizio e liberalo dalla memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u4f9b\u3092\u505c\u6b62\u3057\u3001\u30e1\u30e2\u30ea\u304b\u3089\u89e3\u653e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc81c\uacf5\uc744 \uc911\uc9c0\ud558\uace0 \uba54\ubaa8\ub9ac\uc5d0\uc11c \ud574\uc81c\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen met aanbieden en uit het geheugen vrijgeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesta\u0144 udost\u0119pnia\u0107 i zwolnij z pami\u0119ci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar de servir e liberar da mem\u00f3ria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0442\u044c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u0438 \u0432\u044b\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0438\u0437 \u043f\u0430\u043c\u044f\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluta tillhandah\u00e5lla och frig\u00f6r den fr\u00e5n minnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunmay\u0131 durdur ve bellekten kald\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043f\u0438\u043d\u0438\u0442\u0438 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0439 \u0432\u0438\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0437 \u043f\u0430\u043c'\u044f\u0442\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ng\u1eebng ph\u1ee5c v\u1ee5 v\u00e0 gi\u1ea3i ph\u00f3ng kh\u1ecfi b\u1ed9 nh\u1edb."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u63d0\u4f9b\u5e76\u4ece\u5185\u5b58\u4e2d\u91ca\u653e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u63d0\u4f9b\u4e26\u5f9e\u8a18\u61b6\u9ad4\u4e2d\u91cb\u653e\u3002"
          }
        }
      }
    },
    "Stop serving this over HTTP. It stays loaded for the Chat pane.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u064a\u0642\u0627\u0641 \u062a\u0642\u062f\u064a\u0645 \u0647\u0630\u0627 \u0639\u0628\u0631 HTTP. \u064a\u0628\u0642\u0649 \u0645\u062d\u0645\u0651\u0644\u064b\u0627 \u0641\u064a \u062c\u0632\u0621 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereitstellung per HTTP beenden. Das Modell bleibt f\u00fcr den Chat geladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop serving this over HTTP. It stays loaded for the Chat pane."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dejar de servirlo por HTTP. Sigue cargado para el panel de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eater de le servir en HTTP. Il reste charg\u00e9 pour le panneau Chat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e1\u05e7 \u05dc\u05d4\u05d2\u05d9\u05e9 \u05d0\u05d5\u05ea\u05d5 \u05d3\u05e8\u05da HTTP. \u05d4\u05d5\u05d0 \u05e0\u05e9\u05d0\u05e8 \u05d8\u05e2\u05d5\u05df \u05e2\u05d1\u05d5\u05e8 \u05d7\u05dc\u05d5\u05e0\u05d9\u05ea \u05d4\u05e6'\u05d0\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938\u0947 HTTP \u092a\u0930 \u0938\u0930\u094d\u0935 \u0915\u0930\u0928\u093e \u092c\u0902\u0926 \u0915\u0930\u0947\u0902\u0964 \u092f\u0939 \u091a\u0948\u091f \u092a\u0947\u0928 \u0915\u0947 \u0932\u093f\u090f \u0932\u094b\u0921 \u0930\u0939\u0947\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti menyajikan ini melalui HTTP. Model tetap dimuat untuk panel Chat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi il servizio via HTTP. Resta caricato per il pannello Chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP \u3067\u306e\u63d0\u4f9b\u3092\u505c\u6b62\u3057\u307e\u3059\u3002\u30c1\u30e3\u30c3\u30c8\u30d1\u30cd\u30eb\u7528\u306b\u306f\u8aad\u307f\u8fbc\u307e\u308c\u305f\u307e\u307e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP \uc81c\uacf5\uc744 \uc911\uc9c0\ud569\ub2c8\ub2e4. \ucc44\ud305 \ud328\ub110\uc5d0\ub294 \uacc4\uc18d \ub85c\ub4dc\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen met aanbieden via HTTP. Het blijft geladen voor het chatpaneel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesta\u0144 udost\u0119pnia\u0107 przez HTTP. Model pozostaje za\u0142adowany w panelu czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Parar de servir via HTTP. Continua carregado para o painel de chat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u043a\u0440\u0430\u0442\u0438\u0442\u044c \u043e\u0431\u0441\u043b\u0443\u0436\u0438\u0432\u0430\u043d\u0438\u0435 \u043f\u043e HTTP. \u041c\u043e\u0434\u0435\u043b\u044c \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0439 \u0434\u043b\u044f \u0447\u0430\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluta tillhandah\u00e5lla via HTTP. Den f\u00f6rblir inl\u00e4st f\u00f6r chattpanelen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "HTTP \u00fczerinden sunmay\u0131 durdur. Sohbet b\u00f6lmesi i\u00e7in y\u00fckl\u00fc kal\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043f\u0438\u043d\u0438\u0442\u0438 \u043e\u0431\u0441\u043b\u0443\u0433\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0447\u0435\u0440\u0435\u0437 HTTP. \u041c\u043e\u0434\u0435\u043b\u044c \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u044c\u0441\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e\u044e \u0434\u043b\u044f \u0447\u0430\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ng\u1eebng ph\u1ee5c v\u1ee5 qua HTTP. M\u00f4 h\u00ecnh v\u1eabn \u0111\u01b0\u1ee3c t\u1ea3i cho khung Tr\u00f2 chuy\u1ec7n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u901a\u8fc7 HTTP \u63d0\u4f9b\u3002\u5b83\u4ecd\u4e3a\u804a\u5929\u9762\u677f\u4fdd\u6301\u52a0\u8f7d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u900f\u904e HTTP \u63d0\u4f9b\u3002\u5b83\u4ecd\u70ba\u804a\u5929\u9762\u677f\u4fdd\u6301\u8f09\u5165\u3002"
          }
        }
      }
    },
