            "state": "translated",
            "value": "Geçici sohbet çoğaltılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасовий чат не можна дублювати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể nhân bản cuộc trò chuyện tạm thời."
          }
