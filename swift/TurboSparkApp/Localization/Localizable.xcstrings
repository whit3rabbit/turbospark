        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0938\u0915\u094d\u0930\u093f\u092f \u092e\u0949\u0921\u0932 \u0938\u0924\u094d\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0915\u0943\u092a\u092f\u093e \u092a\u0939\u0932\u0947 \u090f\u0915 \u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada sesi model aktif. Muat model terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna sessione del modello attiva. Carica prima un modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u30e2\u30c7\u30eb\u30bb\u30c3\u30b7\u30e7\u30f3\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u5148\u306b\u30e2\u30c7\u30eb\u3092\u8aad\u307f\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud65c\uc131 \ubaa8\ub378 \uc138\uc158\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \ubaa8\ub378\uc744 \ubd88\ub7ec\uc624\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen actieve modelsessie. Laad eerst een model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak aktywnej sesji modelu. Najpierw za\u0142aduj model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma sess\u00e3o de modelo ativa. Carregue um modelo primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0441\u0435\u0430\u043d\u0441\u0430 \u043c\u043e\u0434\u0435\u043b\u0438. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen aktiv modellsession. Ladda en modell f\u00f6rst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin model oturumu yok. L\u00fctfen \u00f6nce bir model y\u00fckleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u0441\u0435\u0430\u043d\u0441\u0443 \u043c\u043e\u0434\u0435\u043b\u0456. \u0421\u043f\u0435\u0440\u0448\u0443 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 phi\u00ean m\u00f4 h\u00ecnh \u0111ang ho\u1ea1t \u0111\u1ed9ng. Vui l\u00f2ng t\u1ea3i m\u00f4 h\u00ecnh tr\u01b0\u1edbc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u6d3b\u52a8\u7684\u6a21\u578b\u4f1a\u8bdd\u3002\u8bf7\u5148\u52a0\u8f7d\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u4f5c\u7528\u4e2d\u7684\u6a21\u578b\u5de5\u4f5c\u968e\u6bb5\u3002\u8acb\u5148\u8f09\u5165\u6a21\u578b\u3002"
          }
        }
      }
    },
    "No enabled agent definition to run this on.": {
