            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30e1\u30e2\u30ea\u306b\u4fdd\u5b58\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8 \uba54\ubaa8\ub9ac\uc5d0 \uc800\uc7a5\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen in het projectgeheugen."
          }
        },
        "pl": {
          "stringUnit": {
