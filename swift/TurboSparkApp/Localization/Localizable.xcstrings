    "TypeSafe API key is required to start the daemon.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0641\u062a\u0627\u062d TypeSafe API \u0645\u0637\u0644\u0648\u0628 \u0644\u0628\u062f\u0621 \u0627\u0644\u0628\u0631\u0646\u0627\u0645\u062c \u0627\u0644\u062e\u0641\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Starten des Daemons ist ein TypeSafe-API-Schl\u00fcssel erforderlich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TypeSafe API key is required to start the daemon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se requiere la clave de API de TypeSafe para iniciar el daemon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une cl\u00e9 API TypeSafe est requise pour d\u00e9marrer le daemon."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d3\u05e8\u05e9 \u05de\u05e4\u05ea\u05d7 API \u05e9\u05dc TypeSafe \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d4-daemon."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u0947\u092e\u0928 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f TypeSafe API \u0915\u0941\u0902\u091c\u0940 \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API TypeSafe diperlukan untuk memulai daemon."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per avviare il daemon \u00e8 necessaria la chiave API TypeSafe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c7\u30fc\u30e2\u30f3\u3092\u8d77\u52d5\u3059\u308b\u306b\u306f TypeSafe API \u30ad\u30fc\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub370\ubaac\uc744 \uc2dc\uc791\ud558\ub824\uba74 TypeSafe API \ud0a4\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een TypeSafe-API-sleutel is vereist om de daemon te starten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do uruchomienia demona wymagany jest klucz API TypeSafe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API do TypeSafe \u00e9 necess\u00e1ria para iniciar o daemon."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0437\u0430\u043f\u0443\u0441\u043a\u0430 \u0434\u0435\u043c\u043e\u043d\u0430 \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043a\u043b\u044e\u0447 API TypeSafe."
