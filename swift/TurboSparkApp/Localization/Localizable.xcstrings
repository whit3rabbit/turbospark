        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l'installation : authentification requise. Vérifiez votre jeton d'API Hugging Face dans les Paramètres."
          }
        },
        "he": {
          "stringUnit": {
