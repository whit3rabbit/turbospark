    "Select an agent to inspect system instructions and capabilities.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0648\u0643\u064a\u0644\u0627 \u0644\u0641\u062d\u0635 \u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0648\u0627\u0644\u0642\u062f\u0631\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie einen Agent, um Systemanweisungen und F\u00e4higkeiten zu pr\u00fcfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an agent to inspect system instructions and capabilities."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un agente para ver sus instrucciones de sistema y capacidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9lectionnez un agent pour examiner ses instructions syst\u00e8me et ses capacit\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05e1\u05d5\u05db\u05df \u05db\u05d3\u05d9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05de\u05e2\u05e8\u05db\u05ea \u05d5\u05d9\u05db\u05d5\u05dc\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0938\u094d\u091f\u092e \u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0914\u0930 \u0915\u094d\u0937\u092e\u0924\u093e\u090f\u0902 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u090f\u091c\u0947\u0902\u091f \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih agen untuk memeriksa instruksi sistem dan kemampuannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un agente per esaminarne le istruzioni di sistema e le capacit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30b9\u30c6\u30e0\u6307\u793a\u3068\u6a5f\u80fd\u3092\u78ba\u8a8d\u3059\u308b\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uc2a4\ud15c \uc9c0\uce68\uacfc \uae30\ub2a5\uc744 \ud655\uc778\ud560 \uc5d0\uc774\uc804\ud2b8\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een agent om systeeminstructies en mogelijkheden te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz agenta, aby zobaczy\u0107 instrukcje systemowe i mo\u017cliwo\u015bci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um agente para inspecionar as instru\u00e7\u00f5es de sistema e os recursos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0430\u0433\u0435\u043d\u0442\u0430, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0438 \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e\u0441\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en agent f\u00f6r att granska systeminstruktioner och funktioner."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem y\u00f6nergelerini ve yetenekleri incelemek i\u00e7in bir arac\u0131 se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0430\u0433\u0435\u043d\u0442\u0430, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457 \u0442\u0430 \u043c\u043e\u0436\u043b\u0438\u0432\u043e\u0441\u0442\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn m\u1ed9t t\u00e1c nh\u00e2n \u0111\u1ec3 xem h\u01b0\u1edbng d\u1eabn h\u1ec7 th\u1ed1ng v\u00e0 kh\u1ea3 n\u0103ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u4ee3\u7406\u4ee5\u67e5\u770b\u5176\u7cfb\u7edf\u6307\u4ee4\u548c\u80fd\u529b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u53d6\u4ee3\u7406\u4ee5\u6aa2\u8996\u5176\u7cfb\u7d71\u6307\u4ee4\u8207\u80fd\u529b\u3002"
          }
        }
      }
    },
    "Select an installed model to view specifications, runtime options, or load it into memory.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0646\u0645\u0648\u0630\u062c\u0627 \u0645\u062b\u0628\u062a\u0627 \u0644\u0639\u0631\u0636 \u0627\u0644\u0645\u0648\u0627\u0635\u0641\u0627\u062a \u0648\u062e\u064a\u0627\u0631\u0627\u062a \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0623\u0648 \u0644\u062a\u062d\u0645\u064a\u0644\u0647 \u0641\u064a \u0627\u0644\u0630\u0627\u0643\u0631\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie ein installiertes Modell, um Spezifikationen und Laufzeitoptionen anzuzeigen oder es in den Speicher zu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an installed model to view specifications, runtime options, or load it into memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un modelo instalado para ver sus especificaciones, sus opciones de ejecuci\u00f3n o cargarlo en memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9lectionnez un mod\u00e8le install\u00e9 pour afficher ses sp\u00e9cifications, ses options d'ex\u00e9cution ou le charger en m\u00e9moire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05de\u05d5\u05d3\u05dc \u05de\u05d5\u05ea\u05e7\u05df \u05db\u05d3\u05d9 \u05dc\u05d4\u05e6\u05d9\u05d2 \u05de\u05e4\u05e8\u05d8\u05d9\u05dd \u05d5\u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05d4\u05e8\u05e6\u05d4, \u05d0\u05d5 \u05db\u05d3\u05d9 \u05dc\u05d8\u05e2\u05d5\u05df \u05d0\u05d5\u05ea\u05d5 \u05dc\u05d6\u05d9\u05db\u05e8\u05d5\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093f\u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0914\u0930 \u0930\u0928\u091f\u093e\u0907\u092e \u0935\u093f\u0915\u0932\u094d\u092a \u0926\u0947\u0916\u0928\u0947 \u092f\u093e \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u0947\u0902 \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092e\u0949\u0921\u0932 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih model terpasang untuk melihat spesifikasi, opsi runtime, atau memuatnya ke memori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un modello installato per vederne le specifiche e le opzioni di esecuzione o per caricarlo in memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u30e2\u30c7\u30eb\u3092\u9078\u629e\u3059\u308b\u3068\u3001\u4ed5\u69d8\u3084\u5b9f\u884c\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u8868\u793a\u3057\u305f\u308a\u3001\u30e1\u30e2\u30ea\u306b\u8aad\u307f\u8fbc\u3093\u3060\u308a\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ub41c \ubaa8\ub378\uc744 \uc120\ud0dd\ud558\uba74 \uc0ac\uc591\uacfc \uc2e4\ud589 \uc635\uc158\uc744 \ubcf4\uac70\ub098 \uba54\ubaa8\ub9ac\uc5d0 \ub85c\ub4dc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een ge\u00efnstalleerd model om specificaties en uitvoeringsopties te bekijken of het in het geheugen te laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zainstalowany model, aby zobaczy\u0107 specyfikacje i opcje uruchamiania lub wczyta\u0107 go do pami\u0119ci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um modelo instalado para ver especifica\u00e7\u00f5es, op\u00e7\u00f5es de execu\u00e7\u00e3o ou carreg\u00e1-lo na mem\u00f3ria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0441\u043c\u043e\u0442\u0440\u0435\u0442\u044c \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438 \u0438 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0435\u0435 \u0432 \u043f\u0430\u043c\u044f\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en installerad modell f\u00f6r att visa specifikationer och k\u00f6rningsalternativ eller l\u00e4sa in den i minnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknik \u00f6zellikleri ve \u00e7al\u0131\u015fma se\u00e7eneklerini g\u00f6rmek veya belle\u011fe y\u00fcklemek i\u00e7in kurulu bir model se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0443 \u043c\u043e\u0434\u0435\u043b\u044c, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0438\u0441\u0442\u0438\u043a\u0438 \u0442\u0430 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0430\u0431\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0457\u0457 \u0432 \u043f\u0430\u043c'\u044f\u0442\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn m\u1ed9t m\u00f4 h\u00ecnh \u0111\u00e3 c\u00e0i \u0111\u1ec3 xem th\u00f4ng s\u1ed1, t\u00f9y ch\u1ecdn ch\u1ea1y, ho\u1eb7c t\u1ea3i v\u00e0o b\u1ed9 nh\u1edb."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u4e00\u4e2a\u5df2\u5b89\u88c5\u7684\u6a21\u578b\uff0c\u4ee5\u67e5\u770b\u89c4\u683c\u3001\u8fd0\u884c\u9009\u9879\uff0c\u6216\u5c06\u5176\u52a0\u8f7d\u5230\u5185\u5b58\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u53d6\u4e00\u500b\u5df2\u5b89\u88dd\u7684\u6a21\u578b\uff0c\u4ee5\u6aa2\u8996\u898f\u683c\u3001\u57f7\u884c\u9078\u9805\uff0c\u6216\u5c07\u5176\u8f09\u5165\u8a18\u61b6\u9ad4\u3002"
          }
        }
      }
    },
