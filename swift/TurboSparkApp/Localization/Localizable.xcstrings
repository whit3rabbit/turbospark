        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Touch ID \u307e\u305f\u306f Mac \u306e\u30ed\u30b0\u30a4\u30f3\u306b\u3088\u308b\u8a8d\u8a3c\u306f\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"
          }
