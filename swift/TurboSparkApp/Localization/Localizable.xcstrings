    "Dictate. Right-click for voice notes and app audio.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0645\u0644\u0627\u0621. \u0627\u0646\u0642\u0631 \u0628\u0632\u0631 \u0627\u0644\u0641\u0623\u0631\u0629 \u0627\u0644\u0623\u064a\u0645\u0646 \u0644\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0648\u0635\u0648\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktieren. Rechtsklick f\u00fcr Sprachnotizen und App-Audio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictate. Right-click for voice notes and app audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dictar. Clic derecho para notas de voz y audio de apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicter. Clic droit pour les notes vocales et le son des apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05db\u05ea\u05d1\u05d4. \u05dc\u05d7\u05e5 \u05dc\u05d7\u05d9\u05e6\u05d4 \u05d9\u05de\u05e0\u05d9\u05ea \u05dc\u05d4\u05e2\u05e8\u05d5\u05ea \u05e7\u05d5\u05dc\u05d9\u05d5\u05ea \u05d5\u05dc\u05e9\u05de\u05e2 \u05de\u05d9\u05d9\u05e9\u05d5\u05de\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u093f\u0915\u094d\u091f\u0947\u091f \u0915\u0930\u0947\u0902\u0964 \u0935\u0949\u0907\u0938 \u0928\u094b\u091f\u094d\u0938 \u0914\u0930 \u0910\u092a \u0911\u0921\u093f\u092f\u094b \u0915\u0947 \u0932\u093f\u090f \u0930\u093e\u0907\u091f-\u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte. Klik kanan untuk catatan suara dan audio aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta. Clic destro per note vocali e audio delle app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u58f0\u5165\u529b\u3002\u53f3\u30af\u30ea\u30c3\u30af\u3067\u30dc\u30a4\u30b9\u30e1\u30e2\u3068\u30a2\u30d7\u30ea\u306e\u30aa\u30fc\u30c7\u30a3\u30aa\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc1b\uc544\uc4f0\uae30. \uc74c\uc131 \uba54\ubaa8\uc640 \uc571 \uc624\ub514\uc624\ub294 \uc624\ub978\ucabd \ud074\ub9ad\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dicteren. Rechtsklik voor spraaknotities en app-audio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie. Kliknij prawym przyciskiem, aby nagra\u0107 notatk\u0119 g\u0142osow\u0105 lub d\u017awi\u0119k aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditar. Clique com o bot\u00e3o direito para notas de voz e \u00e1udio de apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0438\u043a\u0442\u043e\u0432\u043a\u0430. \u0429\u0451\u043b\u043a\u043d\u0438\u0442\u0435 \u043f\u0440\u0430\u0432\u043e\u0439 \u043a\u043d\u043e\u043f\u043a\u043e\u0439 \u0434\u043b\u044f \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u044b\u0445 \u0437\u0430\u043c\u0435\u0442\u043e\u043a \u0438 \u0437\u0432\u0443\u043a\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Diktera. H\u00f6gerklicka f\u00f6r r\u00f6stanteckningar och appljud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte et. Sesli notlar ve uygulama sesi i\u00e7in sa\u011f t\u0131klay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0438\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f. \u041a\u043b\u0430\u0446\u043d\u0456\u0442\u044c \u043f\u0440\u0430\u0432\u043e\u044e \u043a\u043d\u043e\u043f\u043a\u043e\u044e \u0434\u043b\u044f \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0438\u0445 \u043d\u043e\u0442\u0430\u0442\u043e\u043a \u0456 \u0437\u0432\u0443\u043a\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ecdc ch\u00ednh t\u1ea3. Nh\u1ea5p chu\u1ed9t ph\u1ea3i \u0111\u1ec3 ghi ch\u00fa tho\u1ea1i v\u00e0 \u00e2m thanh \u1ee9ng d\u1ee5ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u542c\u5199\u3002\u53f3\u952e\u70b9\u6309\u53ef\u5f55\u5236\u8bed\u97f3\u5907\u5fd8\u548c\u5e94\u7528\u97f3\u9891\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u807d\u5beb\u3002\u6309\u53f3\u9375\u53ef\u9304\u88fd\u8a9e\u97f3\u5099\u5fd8\u548c App \u97f3\u8a0a\u3002"
          }
        }
      }
    },
