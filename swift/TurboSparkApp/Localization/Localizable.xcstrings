    "Approve for me: run tools, ask before high-risk actions": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة نيابةً عني: شغّل الأدوات واسأل قبل الإجراءات عالية الخطورة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für mich genehmigen: Tools ausführen, vor riskanten Aktionen fragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve for me: run tools, ask before high-risk actions"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar por mí: ejecutar herramientas y preguntar antes de acciones de alto riesgo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver pour moi : exécuter les outils, demander avant les actions à risque"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר בשמי: הפעל כלים, שאל לפני פעולות בסיכון גבוה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मेरी ओर से अनुमोदित करें: टूल चलाएँ, उच्च जोखिम वाले कार्यों से पहले पूछें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setujui untuk saya: jalankan alat, tanya sebelum tindakan berisiko tinggi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva per me: esegui gli strumenti, chiedi prima delle azioni ad alto rischio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代わりに承認：ツールは実行し、高リスクな操作の前に確認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대신 승인: 도구는 실행하고, 고위험 작업 전에 묻기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor mij goedkeuren: tools uitvoeren, vragen vóór risicovolle acties"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzaj za mnie: uruchamiaj narzędzia, pytaj przed ryzykownymi działaniami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar por mim: executar ferramentas, perguntar antes de ações de alto risco"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрять за меня: выполнять инструменты, спрашивать перед рискованными действиями"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkänn åt mig: kör verktyg, fråga före riskfyllda åtgärder"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Benim yerime onayla: araçları çalıştır, yüksek riskli işlemlerden önce sor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схвалювати за мене: виконувати інструменти, питати перед ризикованими діями"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phê duyệt giúp tôi: chạy công cụ, hỏi trước thao tác rủi ro cao"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替我批准：运行工具，高风险操作前询问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替我核准：執行工具，高風險操作前詢問"
          }
        }
      }
    },
