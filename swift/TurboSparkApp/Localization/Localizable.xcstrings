          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0645\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0648\u0627\u0644\u062a\u0648\u0642\u0641 \u0639\u0646 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0635\u0646\u0641 \u0644\u0628\u0642\u064a\u0629 \u0647\u0630\u0647 \u0627\u0644\u062c\u0644\u0633\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal genehmigen und den Klassifikator f\u00fcr den Rest dieser Sitzung nicht mehr verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve once and stop using the classifier for the rest of this session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar una vez y dejar de usar el clasificador durante el resto de esta sesi\u00f3n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver une fois et ne plus utiliser le classificateur pour le reste de cette session"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05e9\u05e8 \u05e4\u05e2\u05dd \u05d0\u05d7\u05ea \u05d5\u05d4\u05e4\u05e1\u05e7 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05de\u05e1\u05d5\u05d5\u05d2 \u05e2\u05d3 \u05e1\u05d5\u05e3 \u05d4\u05d4\u05e4\u05e2\u05dc\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u092c\u093e\u0930 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0907\u0938 \u0938\u0924\u094d\u0930 \u0915\u0947 \u092c\u093e\u0915\u0940 \u0938\u092e\u092f \u0915\u094d\u0932\u093e\u0938\u093f\u092b\u093c\u093e\u092f\u0930 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setujui sekali dan berhenti menggunakan pengklasifikasi selama sisa sesi ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva una volta e smetti di usare il classificatore per il resto della sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1\u56de\u3060\u3051\u627f\u8a8d\u3057\u3001\u3053\u306e\u30bb\u30c3\u30b7\u30e7\u30f3\u306e\u6b8b\u308a\u3067\u306f\u5206\u985e\u5668\u3092\u4f7f\u7528\u3057\u306a\u3044"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud55c \ubc88 \uc2b9\uc778\ud558\uace0 \uc774 \uc138\uc158\uc758 \ub098\uba38\uc9c0 \ub3d9\uc548 \ubd84\ub958\uae30 \uc0ac\uc6a9 \uc911\uc9c0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmaal goedkeuren en de classificatie de rest van deze sessie niet meer gebruiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierd\u017a raz i przesta\u0144 u\u017cywa\u0107 klasyfikatora do ko\u0144ca tej sesji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar uma vez e parar de usar o classificador pelo resto desta sess\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0434\u043e\u0431\u0440\u0438\u0442\u044c \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0438 \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0434\u043e \u043a\u043e\u043d\u0446\u0430 \u044d\u0442\u043e\u0433\u043e \u0441\u0435\u0430\u043d\u0441\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Godk\u00e4nn en g\u00e5ng och sluta anv\u00e4nda klassificeraren under resten av sessionen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez onayla ve bu oturumun geri kalan\u0131nda s\u0131n\u0131fland\u0131r\u0131c\u0131y\u0131 kullanma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0445\u0432\u0430\u043b\u0438\u0442\u0438 \u043e\u0434\u0438\u043d \u0440\u0430\u0437 \u0456 \u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440 \u0434\u043e \u043a\u0456\u043d\u0446\u044f \u0446\u044c\u043e\u0433\u043e \u0441\u0435\u0430\u043d\u0441\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ea5p thu\u1eadn m\u1ed9t l\u1ea7n v\u00e0 ng\u1eebng d\u00f9ng b\u1ed9 ph\u00e2n lo\u1ea1i trong ph\u1ea7n c\u00f2n l\u1ea1i c\u1ee7a phi\u00ean n\u00e0y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6279\u51c6\u4e00\u6b21\uff0c\u5e76\u5728\u672c\u4f1a\u8bdd\u5269\u4f59\u65f6\u95f4\u5185\u505c\u7528\u5206\u7c7b\u5668"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6838\u51c6\u4e00\u6b21\uff0c\u4e26\u5728\u672c\u5de5\u4f5c\u968e\u6bb5\u5269\u9918\u6642\u9593\u5167\u505c\u7528\u5206\u985e\u5668"
          }
        }
      }
    },
