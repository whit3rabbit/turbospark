    "Start the server and these fill in with its real address.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the server and these fill in with its real address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el servidor y estos se rellenarán con su dirección real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarrez le serveur et ces champs se rempliront avec son adresse réelle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie den Server, dann werden diese mit seiner echten Adresse gefüllt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia il server e questi verranno compilati con il suo indirizzo reale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o servidor e estes serão preenchidos com o endereço real dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустите сервер, и здесь появится его настоящий адрес."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーを起動すると、これらに実際のアドレスが入ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버를 시작하면 실제 주소로 채워집니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "启动服务器后，这些会填入其真实地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "啟動伺服器後，這些會填入其真實位址。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل الخادم وستُملأ هذه بعنوانه الحقيقي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל את השרת והשדות האלה יתמלאו בכתובת האמיתית שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर शुरू करें और इनमें उसका वास्तविक पता भर जाएगा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de server, dan worden deze gevuld met het echte adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom serwer, a te pola wypełnią się jego rzeczywistym adresem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuyu başlatın; bunlar gerçek adresiyle dolar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запустіть сервер, і тут з'явиться його справжня адреса."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta servern så fylls dessa i med dess riktiga adress."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khởi động máy chủ và các mục này sẽ điền địa chỉ thật của nó."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
