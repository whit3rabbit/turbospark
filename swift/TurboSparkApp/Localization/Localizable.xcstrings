        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted key envelope is malformed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El contenedor de la clave cifrada tiene un formato incorrecto."
