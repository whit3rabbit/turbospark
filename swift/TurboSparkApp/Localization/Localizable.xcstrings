    "%@ or %@ is read-only, so the model cannot be moved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ أو %@ للقراءة فقط، لذا لا يمكن نقل النموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ oder %@ ist schreibgeschützt, daher kann das Modell nicht verschoben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ or %@ is read-only, so the model cannot be moved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ o %@ es de solo lectura, así que el modelo no se puede mover."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ou %@ est en lecture seule ; le modèle ne peut donc pas être déplacé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחת הספריות, %@ או %@, היא לקריאה בלבד, ולכן אי אפשר להעביר את המודל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ या %@ केवल-पठन है, इसलिए मॉडल को स्थानांतरित नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ atau %@ hanya-baca, jadi model tidak dapat dipindahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ o %@ è di sola lettura, quindi il modello non può essere spostato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ または %@ が読み取り専用のため、モデルを移動できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 또는 %@은(는) 읽기 전용이라 모델을 이동할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ of %@ is alleen-lezen, dus het model kan niet worden verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ lub %@ jest tylko do odczytu, więc nie można przenieść modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ou %@ é somente leitura, então o modelo não pode ser movido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна из библиотек, %@ или %@, доступна только для чтения, поэтому модель нельзя переместить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ eller %@ är skrivskyddat, så modellen kan inte flyttas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ veya %@ salt okunur, bu nedenle model taşınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна з бібліотек, %@ або %@, доступна лише для читання, тому модель не можна перемістити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hoặc %@ chỉ đọc nên không thể di chuyển mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 或 %@ 是只读的，因此无法移动模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 或 %@ 是唯讀的，因此無法移動模型。"
          }
        }
      }
    },
    "%@ timed out. The repository may be unreachable, or it may require credentials this app cannot supply.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت مهلة %@. قد يتعذر الوصول إلى المستودع، أو قد يتطلب بيانات اعتماد لا يمكن لهذا التطبيق توفيرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeitüberschreitung bei %@. Das Repository ist möglicherweise nicht erreichbar oder erfordert Anmeldedaten, die diese App nicht bereitstellen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ timed out. The repository may be unreachable, or it may require credentials this app cannot supply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera de %@. Es posible que no se pueda acceder al repositorio o que requiera credenciales que esta app no puede proporcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a expiré. Le dépôt est peut-être inaccessible ou exige des identifiants que cette app ne peut pas fournir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תם הזמן של %@. ייתכן שהמאגר אינו נגיש, או שהוא דורש פרטי התחברות שאפליקציה זו אינה יכולה לספק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का समय समाप्त हो गया। रिपॉज़िटरी पहुँच से बाहर हो सकती है, या उसे ऐसे क्रेडेंशियल चाहिए जो यह ऐप नहीं दे सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ habis waktu. Repositori mungkin tidak dapat dijangkau, atau memerlukan kredensial yang tidak dapat diberikan aplikasi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è scaduto. Il repository potrebbe non essere raggiungibile o richiedere credenziali che questa app non può fornire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ がタイムアウトしました。リポジトリにアクセスできないか、このアプリが提供できない認証情報が必要な可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 시간이 초과되었습니다. 저장소에 연결할 수 없거나 이 앱이 제공할 수 없는 자격 증명이 필요할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Time-out bij %@. De repository is mogelijk onbereikbaar of vereist inloggegevens die deze app niet kan leveren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upłynął limit czasu dla %@. Repozytorium może być nieosiągalne lub wymagać danych logowania, których ta aplikacja nie może podać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ expirou. O repositório pode estar inacessível ou exigir credenciais que este app não pode fornecer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Время ожидания %@ истекло. Репозиторий может быть недоступен или требовать учетные данные, которые это приложение не может предоставить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ överskred tidsgränsen. Förrådet kan vara oåtkomligt eller kräva inloggningsuppgifter som den här appen inte kan ange."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ zaman aşımına uğradı. Depoya erişilemiyor olabilir veya bu uygulamanın sağlayamayacağı kimlik bilgileri gerekiyor olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Час очікування %@ минув. Репозиторій може бути недоступним або вимагати облікові дані, які ця програма не може надати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ đã hết thời gian chờ. Kho lưu trữ có thể không truy cập được hoặc yêu cầu thông tin xác thực mà ứng dụng này không thể cung cấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 超时。仓库可能无法访问，或者需要此应用无法提供的凭据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 逾時。儲存庫可能無法存取，或需要此 App 無法提供的憑證。"
          }
        }
      }
    },
