    "Pause console display. Metrics continue updating.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف عرض وحدة التحكم مؤقتًا. تستمر المقاييس في التحديث."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Konsolenanzeige anhalten. Die Messwerte werden weiter aktualisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause console display. Metrics continue updating."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausar la consola. Las métricas siguen actualizándose."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mettre en pause l'affichage de la console. Les mesures continuent d'être mises à jour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השהה את תצוגת המסוף. המדדים ממשיכים להתעדכן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंसोल डिस्प्ले रोकें। मेट्रिक्स अपडेट होते रहेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeda tampilan konsol. Metrik tetap diperbarui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti in pausa la console. Le metriche continuano ad aggiornarsi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンソール表示を一時停止します。メトリクスは更新され続けます。"
