    "Used when the tool approval mode is \"Agent (classifier)\"": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عندما يكون وضع الموافقة على الأدوات \"وكيل (مصنف)\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn der Tool-Genehmigungsmodus \"Agent (Klassifikator)\" ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when the tool approval mode is \"Agent (classifier)\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando el modo de aprobación de herramientas es \"Agente (clasificador)\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lorsque le mode d'approbation des outils est \"Agent (classificateur)\""
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשימוש כאשר מצב אישור הכלים הוא \"סוכן (מסווג)\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब उपयोग किया जाता है जब टूल अनुमोदन मोड \"एजेंट (क्लासिफ़ायर)\" हो"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan saat mode persetujuan alat adalah \"Agen (pengklasifikasi)\""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando la modalità di approvazione degli strumenti è \"Agente (classificatore)\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール承認モードが「エージェント (分類器)」のときに使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 승인 모드가 \"에이전트(분류기)\"일 때 사용됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt wanneer de goedkeuringsmodus voor tools \"Agent (classificatie)\" is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane, gdy tryb zatwierdzania narzędzi to \"Agent (klasyfikator)\""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando o modo de aprovação de ferramentas é \"Agente (classificador)\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, когда режим одобрения инструментов - \"Агент (классификатор)\""
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används när verktygens godkännandeläge är \"Agent (klassificerare)\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç onay kipi \"Aracı (sınıflandırıcı)\" olduğunda kullanılır"
