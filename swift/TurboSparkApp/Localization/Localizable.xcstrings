    "Give the directive: /fork Turn the last answer into a test plan.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل التوجيه: /fork حوّل الإجابة الأخيرة إلى خطة اختبار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die Anweisung an: /fork Mach aus der letzten Antwort einen Testplan."
          }
