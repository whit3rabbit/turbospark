            "value": "\ube0c\ub79c\uce58 \uc0dd\uc131 \ubc0f \ub2e4\uc2dc \uc2e4\ud589"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vertakking maken en opnieuw uitvoeren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utw\u00f3rz ga\u0142\u0105\u017a i uruchom ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar ramifica\u00e7\u00e3o e reexecutar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0437\u0434\u0430\u0442\u044c \u0432\u0435\u0442\u043a\u0443 \u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa gren och k\u00f6r igen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dal olu\u015ftur ve yeniden \u00e7al\u0131\u015ft\u0131r"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0433\u0456\u043b\u043a\u0443 \u0442\u0430 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea1o nh\u00e1nh v\u00e0 ch\u1ea1y l\u1ea1i"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u521b\u5efa\u5206\u652f\u5e76\u91cd\u65b0\u8fd0\u884c"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5efa\u7acb\u5206\u652f\u4e26\u91cd\u65b0\u57f7\u884c"
          }
        }
      }
    },
    "Creates a new chat containing the conversation up to this message, with your edit in place, and continues there. \"%@\" is left unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0646\u0634\u0626 \u0645\u062d\u0627\u062f\u062b\u0629 \u062c\u062f\u064a\u062f\u0629 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u062d\u062a\u0649 \u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629\u060c \u0645\u0639 \u062a\u0637\u0628\u064a\u0642 \u062a\u0639\u062f\u064a\u0644\u0643\u060c \u0648\u064a\u0633\u062a\u0645\u0631 \u0647\u0646\u0627\u0643. \u064a\u0638\u0644 \"%@\" \u062f\u0648\u0646 \u062a\u063a\u064a\u064a\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstellt einen neuen Chat mit der Konversation bis zu dieser Nachricht, \u00fcbernimmt Ihre Bearbeitung und setzt dort fort. \u201e%@\u201c bleibt unver\u00e4ndert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creates a new chat containing the conversation up to this message, with your edit in place, and continues there. \"%@\" is left unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un nuevo chat con la conversaci\u00f3n hasta este mensaje, aplicando tu edici\u00f3n, y contin\u00faa all\u00ed. \"%@\" no se modifica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cr\u00e9e une nouvelle discussion contenant la conversation jusqu'\u00e0 ce message, avec votre modification, et continue l\u00e0-bas. \u00ab %@ \u00bb reste inchang\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05d5\u05e6\u05e8 \u05e6'\u05d0\u05d8 \u05d7\u05d3\u05e9 \u05d4\u05de\u05db\u05d9\u05dc \u05d0\u05ea \u05d4\u05e9\u05d9\u05d7\u05d4 \u05e2\u05d3 \u05dc\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d6\u05d5, \u05e2\u05dd \u05d4\u05e2\u05e8\u05d9\u05db\u05d4 \u05e9\u05dc\u05da, \u05d5\u05de\u05de\u05e9\u05d9\u05da \u05e9\u05dd. \"%@\" \u05e0\u05e9\u05d0\u05e8 \u05dc\u05dc\u05d0 \u05e9\u05d9\u05e0\u05d5\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u0902\u0926\u0947\u0936 \u0924\u0915 \u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0935\u093e\u0932\u093e \u090f\u0915 \u0928\u092f\u093e \u091a\u0948\u091f \u092c\u0928\u093e\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u0902\u092a\u093e\u0926\u0928 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u093e \u0939\u0948, \u0914\u0930 \u0935\u0939\u093e\u0902 \u091c\u093e\u0930\u0940 \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \"%@\" \u0905\u092a\u0930\u093f\u0935\u0930\u094d\u0924\u093f\u0924 \u0930\u0939\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat obrolan baru yang berisi percakapan hingga pesan ini, dengan hasil edit Anda diterapkan, dan melanjutkan di sana. \"%@\" tidak berubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una nuova chat contenente la conversazione fino a questo messaggio, con la tua modifica applicata, e continua l\u00ec. \"%@\" rimane invariata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u307e\u3067\u306e\u4f1a\u8a71\u3092\u542b\u3080\u65b0\u3057\u3044\u30c1\u30e3\u30c3\u30c8\u3092\u4f5c\u6210\u3057\u3001\u7de8\u96c6\u3092\u53cd\u6620\u3057\u3066\u305d\u3053\u3067\u7d9a\u884c\u3057\u307e\u3059\u3002\u300c%@\u300d\u306f\u5909\u66f4\u3055\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uba54\uc2dc\uc9c0\uae4c\uc9c0\uc758 \ub300\ud654\uac00 \ud3ec\ud568\ub41c \uc0c8 \ucc44\ud305\uc744 \ub9cc\ub4e4\uace0 \ud3b8\uc9d1 \ub0b4\uc6a9\uc744 \uc801\uc6a9\ud558\uc5ec \uacc4\uc18d \uc9c4\ud589\ud569\ub2c8\ub2e4. \"%@\"\uc740(\ub294) \ubcc0\uacbd\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maakt een nieuwe chat aan met het gesprek tot aan dit bericht, met uw bewerking toegepast, en gaat daar verder. \"%@\" blijft ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tworzy nowy czat zawieraj\u0105cy konwersacj\u0119 do tej wiadomo\u015bci z Twoj\u0105 edycj\u0105 i kontynuuje tam. Czat \u201e%@\u201d pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cria um novo chat contendo a conversa at\u00e9 esta mensagem, com sua edi\u00e7\u00e3o aplicada, e continua a partir dali. \"%@\" permanece inalterado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0437\u0434\u0430\u0435\u0442 \u043d\u043e\u0432\u044b\u0439 \u0447\u0430\u0442 \u0441 \u0434\u0438\u0430\u043b\u043e\u0433\u043e\u043c \u0434\u043e \u044d\u0442\u043e\u0433\u043e \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u0441 \u0432\u0430\u0448\u0435\u0439 \u043f\u0440\u0430\u0432\u043a\u043e\u0439 \u0438 \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0430\u0435\u0442\u0441\u044f \u0442\u0430\u043c. \u00ab%@\u00bb \u043e\u0441\u0442\u0430\u0435\u0442\u0441\u044f \u0431\u0435\u0437 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapar en ny chatt som inneh\u00e5ller konversationen fram till detta meddelande, med din redigering p\u00e5 plats, och forts\u00e4tter d\u00e4r. \"%@\" l\u00e4mnas of\u00f6r\u00e4ndrad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesaja kadar olan konu\u015fmay\u0131 i\u00e7eren, d\u00fczenlemenizin yer ald\u0131\u011f\u0131 yeni bir sohbet olu\u015fturur ve oradan devam eder. \"%@\" de\u011fi\u015fmeden kal\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0432\u043e\u0440\u044e\u0454 \u043d\u043e\u0432\u0438\u0439 \u0447\u0430\u0442 \u0456\u0437 \u0440\u043e\u0437\u043c\u043e\u0432\u043e\u044e \u0434\u043e \u0446\u044c\u043e\u0433\u043e \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0437 \u0432\u0430\u0448\u0438\u043c \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f\u043c \u0456 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0443\u0454 \u0442\u0430\u043c. \u00ab%@\u00bb \u0437\u0430\u043b\u0438\u0448\u0430\u0454\u0442\u044c\u0441\u044f \u0431\u0435\u0437 \u0437\u043c\u0456\u043d."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea1o m\u1ed9t cu\u1ed9c tr\u00f2 chuy\u1ec7n m\u1edbi ch\u1ee9a n\u1ed9i dung cu\u1ed9c tr\u00f2 chuy\u1ec7n cho \u0111\u1ebfn tin nh\u1eafn n\u00e0y, k\u00e8m theo ch\u1ec9nh s\u1eeda c\u1ee7a b\u1ea1n v\u00e0 ti\u1ebfp t\u1ee5c \u1edf \u0111\u00f3. \"%@\" \u0111\u01b0\u1ee3c gi\u1eef nguy\u00ean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u521b\u5efa\u4e00\u4e2a\u5305\u542b\u622a\u81f3\u6b64\u6d88\u606f\u7684\u5bf9\u8bdd\u7684\u65b0\u804a\u5929\uff0c\u4fdd\u7559\u4f60\u7684\u7f16\u8f91\u5e76\u5728\u6b64\u7ee7\u7eed\u3002\u201c%@\u201d\u4fdd\u6301\u4e0d\u53d8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5efa\u7acb\u4e00\u500b\u5305\u542b\u622a\u81f3\u6b64\u8a0a\u606f\u7684\u5c0d\u8a71\u7684\u65b0\u804a\u5929\uff0c\u4fdd\u7559\u4f60\u7684\u7de8\u8f2f\u4e26\u5728\u6b64\u7e7c\u7e8c\u3002\u300c%@\u300d\u4fdd\u6301\u4e0d\u8b8a\u3002"
          }
        }
      }
    },
