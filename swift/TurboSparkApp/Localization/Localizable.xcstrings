        }
      }
    },
    "This model picks the voice. To speak in a voice you choose, use Voice Cloning.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يختار هذا النموذج الصوت بنفسه. للتحدث بصوت تختاره، استخدم استنساخ الصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell wählt die Stimme selbst. Um mit einer Stimme Ihrer Wahl zu sprechen, verwenden Sie Stimmklonen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model picks the voice. To speak in a voice you choose, use Voice Cloning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo elige la voz. Para hablar con una voz que tú elijas, usa Clonación de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle choisit la voix. Pour parler avec une voix de votre choix, utilisez Clonage de voix."
