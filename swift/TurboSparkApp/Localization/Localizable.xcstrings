          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görsel artık yazıldığı yolda değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зображення більше немає за шляхом, куди його було записано."
          }
        },
        "vi": {
