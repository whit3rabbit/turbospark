        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y ch\u1ecdn m\u1ed9t m\u00f4 h\u00ecnh h\u00ecnh \u1ea3nh MLX \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 t\u1eeb danh s\u00e1ch tuy\u1ec3n ch\u1ecdn."
