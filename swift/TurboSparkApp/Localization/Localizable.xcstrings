        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivia questa chat (o /unarchive per ripristinarla)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30c1\u30e3\u30c3\u30c8\u3092\u30a2\u30fc\u30ab\u30a4\u30d6\uff08\u623b\u3059\u306b\u306f /unarchive\uff09"
