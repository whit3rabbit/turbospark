        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u0949 \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f, \u092e\u0949\u0921\u0932 \u0915\u0947 \u0905\u092a\u0928\u0947 \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0915\u0947 \u091c\u093c\u0930\u093f\u090f\u0964"
