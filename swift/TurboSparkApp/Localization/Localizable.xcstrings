        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u094d\u0930\u094b\u0924 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930 \u0915\u0930\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u0935\u093f\u0915\u0932\u094d\u092a \u0918\u094b\u0937\u093f\u0924 \u0928\u0939\u0940\u0902\u0964"
