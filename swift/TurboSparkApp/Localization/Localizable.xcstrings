    "What This Project Remembers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0627 \u064a\u062a\u0630\u0643\u0631\u0647 \u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
