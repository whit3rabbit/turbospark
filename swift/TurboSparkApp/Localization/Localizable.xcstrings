            "value": "Humanizer modeli y\u00fckl\u00fc de\u011fil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c Humanizer \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00e0i \u0111\u1eb7t m\u00f4 h\u00ecnh Humanizer."
          }
        },
        "zh-Hans": {
