    "Probe complete. Report is available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0643\u062a\u0645\u0644 \u0627\u0644\u0641\u062d\u0635. \u0627\u0644\u062a\u0642\u0631\u064a\u0631 \u0645\u062a\u0627\u062d."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
