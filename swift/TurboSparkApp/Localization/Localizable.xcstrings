    "The source file has moved; only the extracted text remains.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u064f\u0642\u0644 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0645\u0635\u062f\u0631\u061b \u0648\u0644\u0645 \u064a\u062a\u0628\u0642\u064e\u0651 \u0633\u0648\u0649 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u0633\u062a\u062e\u0631\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Quelldatei wurde verschoben; nur der extrahierte Text ist noch vorhanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source file has moved; only the extracted text remains."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de origen se movi\u00f3; solo queda el texto extra\u00eddo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier source a \u00e9t\u00e9 d\u00e9plac\u00e9 ; seul le texte extrait subsiste."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8 \u05d4\u05d5\u05e2\u05d1\u05e8; \u05e0\u05e9\u05d0\u05e8 \u05e8\u05e7 \u05d4\u05d8\u05e7\u05e1\u05d8 \u05e9\u05d7\u05d5\u05dc\u05e5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0930\u094b\u0924 \u092b\u093c\u093e\u0907\u0932 \u0939\u091f\u093e \u0926\u0940 \u0917\u0908 \u0939\u0948; \u0915\u0947\u0935\u0932 \u0928\u093f\u0915\u093e\u0932\u093e \u0917\u092f\u093e \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092c\u091a\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File sumber telah dipindahkan; hanya teks hasil ekstraksi yang tersisa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di origine \u00e8 stato spostato; resta solo il testo estratto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5143\u306e\u30d5\u30a1\u30a4\u30eb\u306f\u79fb\u52d5\u3055\u308c\u307e\u3057\u305f\u3002\u62bd\u51fa\u3055\u308c\u305f\u30c6\u30ad\u30b9\u30c8\u306e\u307f\u6b8b\u3063\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6d0\ubcf8 \ud30c\uc77c\uc774 \uc774\ub3d9\ub418\uc5b4 \ucd94\ucd9c\ub41c \ud14d\uc2a4\ud2b8\ub9cc \ub0a8\uc544 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bronbestand is verplaatst; alleen de gehaalde tekst is over."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik \u017ar\u00f3d\u0142owy zosta\u0142 przeniesiony; pozosta\u0142 tylko wyodr\u0119bniony tekst."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de origem foi movido; resta apenas o texto extra\u00eddo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u0444\u0430\u0439\u043b \u043f\u0435\u0440\u0435\u043c\u0435\u0449\u0451\u043d; \u043e\u0441\u0442\u0430\u043b\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0438\u0437\u0432\u043b\u0435\u0447\u0451\u043d\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00e4llfilen har flyttats; bara den extraherade texten finns kvar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak dosya ta\u015f\u0131nd\u0131; yaln\u0131zca \u00e7\u0131kar\u0131lan metin kald\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0445\u0456\u0434\u043d\u0438\u0439 \u0444\u0430\u0439\u043b \u043f\u0435\u0440\u0435\u043c\u0456\u0449\u0435\u043d\u043e; \u0437\u0430\u043b\u0438\u0448\u0438\u0432\u0441\u044f \u043b\u0438\u0448\u0435 \u0432\u0438\u043b\u0443\u0447\u0435\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ec7p ngu\u1ed3n \u0111\u00e3 b\u1ecb di chuy\u1ec3n; ch\u1ec9 c\u00f2n l\u1ea1i v\u0103n b\u1ea3n \u0111\u00e3 tr\u00edch xu\u1ea5t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e90\u6587\u4ef6\u5df2\u79fb\u52a8\uff1b\u53ea\u5269\u4e0b\u63d0\u53d6\u7684\u6587\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f86\u6e90\u6a94\u6848\u5df2\u79fb\u52d5\uff1b\u53ea\u5269\u4e0b\u64f7\u53d6\u7684\u6587\u5b57\u3002"
          }
        }
      }
    },
