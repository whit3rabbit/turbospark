      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u062f\u0627\u0631\u0629 \u0627\u0644\u0645\u062a\u062c\u0647\u0627\u062a \u0627\u0644\u0645\u062d\u0644\u064a\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokale Vektoren verwalten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage local vectors"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionar vectores locales"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e9rer les vecteurs locaux"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d4\u05dc \u05d5\u05e7\u05d8\u05d5\u05e8\u05d9\u05dd \u05de\u05e7\u05d5\u05de\u05d9\u05d9\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0935\u0947\u0915\u094d\u091f\u0930 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
