        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ea\u30dd\u30b8\u30c8\u30ea\u306e\u30eb\u30fc\u30c8\u304b\u3089\u30e9\u30a4\u30d6\u306e AGENTS.md \u307e\u305f\u306f CLAUDE.md \u306e\u6307\u793a\u3092\u8aad\u307f\u8fbc\u307f\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\uc18c \ub8e8\ud2b8\uc5d0\uc11c \uc2e4\uc2dc\uac04 AGENTS.md \ub610\ub294 CLAUDE.md \uc9c0\uce68\uc744 \ub85c\ub4dc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadt live AGENTS.md- of CLAUDE.md-instructies vanuit de hoofdmap van de repository."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0141aduje instrukcje na \u017cywo z plik\u00f3w AGENTS.md lub CLAUDE.md z katalogu g\u0142\u00f3wnego repozytorium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega instru\u00e7\u00f5es din\u00e2micas do AGENTS.md ou CLAUDE.md da raiz do reposit\u00f3rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u0442 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 AGENTS.md \u0438\u043b\u0438 CLAUDE.md \u0438\u0437 \u043a\u043e\u0440\u043d\u044f \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4ser in aktiva AGENTS.md- eller CLAUDE.md-instruktioner fr\u00e5n lagringsplatsens rot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo k\u00f6k dizininden canl\u0131 AGENTS.md veya CLAUDE.md talimatlar\u0131n\u0131 y\u00fckler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457 AGENTS.md \u0430\u0431\u043e CLAUDE.md \u0437 \u043a\u043e\u0440\u0435\u043d\u044f \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0456\u044e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i h\u01b0\u1edbng d\u1eabn tr\u1ef1c ti\u1ebfp c\u1ee7a AGENTS.md ho\u1eb7c CLAUDE.md t\u1eeb th\u01b0 m\u1ee5c g\u1ed1c c\u1ee7a kho l\u01b0u tr\u1eef."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u4ed3\u5e93\u6839\u76ee\u5f55\u52a0\u8f7d\u5b9e\u65f6 AGENTS.md \u6216 CLAUDE.md \u6307\u4ee4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u5132\u5b58\u5eab\u6839\u76ee\u9304\u8f09\u5165\u5373\u6642 AGENTS.md \u6216 CLAUDE.md \u6307\u793a\u3002"
          }
        }
      }
    },
    "No project folder attached. Set a folder in project settings to read AGENTS.md.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u062c\u0644\u062f \u0645\u0634\u0631\u0648\u0639 \u0645\u0631\u0641\u0642. \u062d\u062f\u062f \u0645\u062c\u0644\u062f\u064b\u0627 \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0644\u0642\u0631\u0627\u0621\u0629 AGENTS.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Projektordner angeh\u00e4ngt. Legen Sie einen Ordner in den Projekteinstellungen fest, um AGENTS.md zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No project folder attached. Set a folder in project settings to read AGENTS.md."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay carpeta de proyecto adjunta. Establece una carpeta en la configuraci\u00f3n del proyecto para leer AGENTS.md."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier de projet associ\u00e9. D\u00e9finissez un dossier dans les param\u00e8tres du projet pour lire AGENTS.md."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e6\u05d5\u05e8\u05e4\u05d4 \u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8. \u05d4\u05d2\u05d3\u05e8 \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05d3\u05d9 \u05dc\u05e7\u05e8\u05d5\u05d0 \u05d0\u05ea AGENTS.md."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0938\u0902\u0932\u0917\u094d\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 AGENTS.md \u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u090f\u0915 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada folder proyek yang dilampirkan. Tetapkan folder di pengaturan proyek untuk membaca AGENTS.md."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna cartella di progetto allegata. Imposta una cartella nelle impostazioni del progetto per leggere AGENTS.md."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30d5\u30a9\u30eb\u30c0\u30fc\u304c\u6dfb\u4ed8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002AGENTS.md \u3092\u8aad\u307f\u53d6\u308b\u306b\u306f\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u8a2d\u5b9a\u3067\u30d5\u30a9\u30eb\u30c0\u30fc\u3092\u8a2d\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucca8\ubd80\ub41c \ud504\ub85c\uc81d\ud2b8 \ud3f4\ub354\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. AGENTS.md\ub97c \uc77d\uc73c\ub824\uba74 \ud504\ub85c\uc81d\ud2b8 \uc124\uc815\uc5d0\uc11c \ud3f4\ub354\ub97c \uc124\uc815\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen projectmap gekoppeld. Stel een map in bij de projectinstellingen om AGENTS.md te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie do\u0142\u0105czono folderu projektu. Ustaw folder w ustawieniach projektu, aby odczyta\u0107 AGENTS.md."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pasta de projeto anexada. Defina uma pasta nas configura\u00e7\u00f5es do projeto para ler AGENTS.md."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0430\u043f\u043a\u0430 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u043d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0430. \u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u043f\u0430\u043f\u043a\u0443 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0434\u043b\u044f \u0447\u0442\u0435\u043d\u0438\u044f AGENTS.md."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen projektmapp bifogad. Ange en mapp i projektinst\u00e4llningarna f\u00f6r att l\u00e4sa AGENTS.md."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekli proje klas\u00f6r\u00fc yok. AGENTS.md dosyas\u0131n\u0131 okumak i\u00e7in proje ayarlar\u0131nda bir klas\u00f6r belirleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0430\u043f\u043a\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0443 \u043d\u0435 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043e. \u0412\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u043f\u0430\u043f\u043a\u0443 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 \u043f\u0440\u043e\u0435\u043a\u0442\u0443 \u0434\u043b\u044f \u0447\u0438\u0442\u0430\u043d\u043d\u044f AGENTS.md."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a \u0111\u00ednh k\u00e8m th\u01b0 m\u1ee5c d\u1ef1 \u00e1n. \u0110\u1eb7t th\u01b0 m\u1ee5c trong c\u00e0i \u0111\u1eb7t d\u1ef1 \u00e1n \u0111\u1ec3 \u0111\u1ecdc AGENTS.md."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u9644\u52a0\u9879\u76ee\u6587\u4ef6\u5939\u3002\u5728\u9879\u76ee\u8bbe\u7f6e\u4e2d\u8bbe\u7f6e\u6587\u4ef6\u5939\u4ee5\u8bfb\u53d6 AGENTS.md\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u9644\u52a0\u5c08\u6848\u8cc7\u6599\u593e\u3002\u5728\u5c08\u6848\u8a2d\u5b9a\u4e2d\u8a2d\u5b9a\u8cc7\u6599\u593e\u4ee5\u8b80\u53d6 AGENTS.md\u3002"
          }
        }
      }
    },
    "This will permanently remove the model files (%@) from disk at:\n%@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u064a\u0624\u062f\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u0625\u0632\u0627\u0644\u0629 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0646\u0645\u0648\u0630\u062c (%@) \u0646\u0647\u0627\u0626\u064a\u064b\u0627 \u0645\u0646 \u0627\u0644\u0642\u0631\u0635 \u0641\u064a:\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Modelldateien (%@) dauerhaft von der Festplatte gel\u00f6scht unter:\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently remove the model files (%@) from disk at:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminar\u00e1 permanentemente los archivos del modelo (%@) del disco en:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera d\u00e9finitivement les fichiers du mod\u00e8le (%@) du disque \u00e0 l'emplacement :\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d6\u05d5 \u05ea\u05e1\u05d9\u05e8 \u05dc\u05e6\u05de\u05d9\u05ea\u05d5\u05ea \u05d0\u05ea \u05e7\u05d1\u05e6\u05d9 \u05d4\u05de\u05d5\u05d3\u05dc (%@) \u05de\u05d4\u05d3\u05d9\u05e1\u05e7 \u05d1\u05db\u05ea\u05d5\u05d1\u05ea:\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0921\u093f\u0938\u094d\u0915 \u0938\u0947 \u092e\u0949\u0921\u0932 \u092b\u093c\u093e\u0907\u0932\u094b\u0902 (%@) \u0915\u094b \u092f\u0939\u093e\u0901 \u0938\u0947 \u0938\u094d\u0925\u093e\u092f\u0940 \u0930\u0942\u092a \u0938\u0947 \u0939\u091f\u093e \u0926\u0947\u0917\u093e:\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus file model (%@) secara permanen dari disk di:\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci\u00f2 rimuover\u00e0 definitivamente i file del modello (%@) dal disco in:\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u308c\u306b\u3088\u308a\u3001\u30c7\u30a3\u30b9\u30af\u4e0a\u306e\u6b21\u306e\u5834\u6240\u306b\u3042\u308b\u30e2\u30c7\u30eb\u30d5\u30a1\u30a4\u30eb\uff08%@\uff09\u304c\u5b8c\u5168\u306b\u524a\u9664\u3055\u308c\u307e\u3059:\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ub807\uac8c \ud558\uba74 \ub514\uc2a4\ud06c\uc758 \ub2e4\uc74c \uc704\uce58\uc5d0\uc11c \ubaa8\ub378 \ud30c\uc77c(%@)\uc774 \uc601\uad6c\uc801\uc73c\ub85c \uc81c\uac70\ub429\ub2c8\ub2e4:\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de modelbestanden (%@) permanent van de schijf verwijderd op:\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwa\u0142e usuni\u0119cie plik\u00f3w modelu (%@) z dysku w lokalizacji:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remover\u00e1 permanentemente os arquivos do modelo (%@) do disco em:\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u043f\u0440\u0438\u0432\u0435\u0434\u0435\u0442 \u043a \u0431\u0435\u0437\u0432\u043e\u0437\u0432\u0440\u0430\u0442\u043d\u043e\u043c\u0443 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u044e \u0444\u0430\u0439\u043b\u043e\u0432 \u043c\u043e\u0434\u0435\u043b\u0438 (%@) \u0441 \u0434\u0438\u0441\u043a\u0430 \u043f\u043e \u0430\u0434\u0440\u0435\u0441\u0443:\n%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar permanent bort modellfilerna (%@) fr\u00e5n disken p\u00e5:\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu i\u015flem, model dosyalar\u0131n\u0131 (%@) \u015fu konumdaki diskten kal\u0131c\u0131 olarak kald\u0131racakt\u0131r:\n%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435 \u043d\u0430\u0437\u0430\u0432\u0436\u0434\u0438 \u0432\u0438\u0434\u0430\u043b\u0438\u0442\u044c \u0444\u0430\u0439\u043b\u0438 \u043c\u043e\u0434\u0435\u043b\u0456 (%@) \u0437 \u0434\u0438\u0441\u043a\u0430 \u0437\u0430 \u0448\u043b\u044f\u0445\u043e\u043c:\n%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao t\u00e1c n\u00e0y s\u1ebd x\u00f3a v\u0129nh vi\u1ec5n c\u00e1c t\u1ec7p m\u00f4 h\u00ecnh (%@) kh\u1ecfi \u0111\u0129a t\u1ea1i:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fd9\u5c06\u4ece\u78c1\u76d8\u4e0a\u7684\u4ee5\u4e0b\u4f4d\u7f6e\u6c38\u4e45\u5220\u9664\u6a21\u578b\u6587\u4ef6\uff08%@\uff09\uff1a\n%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9019\u5c07\u5f9e\u78c1\u789f\u4e0a\u7684\u4ee5\u4e0b\u4f4d\u7f6e\u6c38\u4e45\u522a\u9664\u6a21\u578b\u6a94\u6848\uff08%@\uff09\uff1a\n%@"
          }
        }
      }
    },
    "This repository publishes %lld GGUF variants. Select a specific file to probe and install.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0646\u0634\u0631 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639 %lld \u0645\u0646 \u0645\u062a\u063a\u064a\u0631\u0627\u062a GGUF. \u062d\u062f\u062f \u0645\u0644\u0641\u064b\u0627 \u0645\u062d\u062f\u062f\u064b\u0627 \u0644\u0641\u062d\u0635\u0647 \u0648\u062a\u062b\u0628\u064a\u062a\u0647."
          }
        },
        "de": {
          "stringUnit": {
