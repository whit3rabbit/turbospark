        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie hooks de ciclo de vida vindos da configuração e dos plugins ativados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте хуками жизненного цикла из конфигурации и включенных плагинов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "構成と有効なプラグインから読み込まれたライフサイクルフックを管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
