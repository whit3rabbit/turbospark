    "Speech recognition is off for TurboSpark. Turn it on in System Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u0639\u0631\u0651\u0641 \u0639\u0644\u0649 \u0627\u0644\u0643\u0644\u0627\u0645 \u0645\u062a\u0648\u0642\u0641 \u0644\u0640 TurboSpark. \u0634\u063a\u0651\u0644\u0647 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Spracherkennung ist f\u00fcr TurboSpark deaktiviert. Aktiviere sie in den Systemeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speech recognition is off for TurboSpark. Turn it on in System Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reconocimiento de voz est\u00e1 desactivado para TurboSpark. Act\u00edvalo en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La reconnaissance vocale est d\u00e9sactiv\u00e9e pour TurboSpark. Activez-la dans R\u00e9glages Syst\u00e8me."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05d3\u05d9\u05d1\u05d5\u05e8 \u05db\u05d1\u05d5\u05d9 \u05e2\u05d1\u05d5\u05e8 TurboSpark. \u05d4\u05e4\u05e2\u05dc \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u0915\u0947 \u0932\u093f\u090f \u0935\u093e\u0915\u094d \u092a\u0939\u091a\u093e\u0928 \u092c\u0902\u0926 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan ucapan untuk TurboSpark nonaktif. Aktifkan di Pengaturan Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale \u00e8 disattivato per TurboSpark. Attivalo in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u306e\u97f3\u58f0\u8a8d\u8b58\u306f\u30aa\u30d5\u3067\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u8a2d\u5b9a\u3067\u30aa\u30f3\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
