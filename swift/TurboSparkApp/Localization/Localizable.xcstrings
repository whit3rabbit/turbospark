    "Portable experiments run on the CPU and have not passed production quality or performance gates.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Portable experiments run on the CPU and have not passed production quality or performance gates."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los experimentos portables usan la CPU y no han superado las pruebas de calidad o rendimiento para producción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les essais portables utilisent le processeur et n'ont pas passé les tests de qualité ou de performances requis pour la production."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Portable Experimente laufen auf der CPU und haben die Qualitäts- oder Leistungstests für den Produktionseinsatz noch nicht bestanden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esperimenti portabili usano la CPU e non hanno superato le verifiche di qualità o prestazioni per la produzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os experimentos portáteis usam a CPU e não passaram pelos testes de qualidade ou desempenho para produção."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Draagbare experimenten draaien op de CPU en hebben de kwaliteits- of prestatietests voor productie niet doorstaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Portabla experiment körs på CPU:n och har inte klarat kvalitets- eller prestandakraven för produktion."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperymenty przenośne korzystają z CPU i nie przeszły testów jakości lub wydajności wymaganych w produkcji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşınabilir deneyler CPU üzerinde çalışır ve üretim kalitesi veya performans testlerini geçmemiştir."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Eksperimen portabel berjalan pada CPU dan belum lulus uji kualitas atau performa untuk produksi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносимые эксперименты работают на CPU и не прошли проверки качества или производительности для рабочего использования."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переносні експерименти працюють на CPU та не пройшли перевірок якості або продуктивності для робочого використання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thử nghiệm đa nền tảng chạy trên CPU và chưa vượt qua kiểm tra chất lượng hoặc hiệu năng để sử dụng chính thức."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ポータブル実験はCPU上で実行され、実運用の品質や性能の検証を完了していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이식 가능한 실험은 CPU에서 실행되며 실제 사용을 위한 품질 또는 성능 검증을 통과하지 않았습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可移植实验在 CPU 上运行，尚未通过正式使用所需的质量或性能验证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可攜式實驗在 CPU 上執行，尚未通過正式使用所需的品質或效能驗證。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل التجارب المحمولة على المعالج المركزي ولم تجتز اختبارات الجودة أو الأداء المطلوبة للاستخدام الفعلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניסויים ניידים פועלים על המעבד ולא עברו בדיקות איכות או ביצועים לשימוש בייצור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पोर्टेबल प्रयोग CPU पर चलते हैं और उत्पादन उपयोग के लिए गुणवत्ता या प्रदर्शन की जाँच पास नहीं कर पाए हैं।"
          }
        }
      }
    },
