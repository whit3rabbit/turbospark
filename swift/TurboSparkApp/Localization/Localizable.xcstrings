    "Select an installed model to view specifications, runtime options, or load it into memory.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجا مثبتا لعرض المواصفات وخيارات التشغيل أو لتحميله في الذاكرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein installiertes Modell, um Spezifikationen und Laufzeitoptionen anzuzeigen oder es in den Speicher zu laden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select an installed model to view specifications, runtime options, or load it into memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un modelo instalado para ver sus especificaciones, sus opciones de ejecución o cargarlo en memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un modèle installé pour afficher ses spécifications, ses options d'exécution ou le charger en mémoire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר מודל מותקן כדי להציג מפרטים ואפשרויות הרצה, או כדי לטעון אותו לזיכרון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "विनिर्देश और रनटाइम विकल्प देखने या मेमोरी में लोड करने के लिए कोई इंस्टॉल किया गया मॉडल चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih model terpasang untuk melihat spesifikasi, opsi runtime, atau memuatnya ke memori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un modello installato per vederne le specifiche e le opzioni di esecuzione o per caricarlo in memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストール済みモデルを選択すると、仕様や実行オプションを表示したり、メモリに読み込んだりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 모델을 선택하면 사양과 실행 옵션을 보거나 메모리에 로드할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een geïnstalleerd model om specificaties en uitvoeringsopties te bekijken of het in het geheugen te laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz zainstalowany model, aby zobaczyć specyfikacje i opcje uruchamiania lub wczytać go do pamięci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione um modelo instalado para ver especificações, opções de execução ou carregá-lo na memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите установленную модель, чтобы посмотреть характеристики и параметры выполнения или загрузить ее в память."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en installerad modell för att visa specifikationer och körningsalternativ eller läsa in den i minnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Teknik özellikleri ve çalışma seçeneklerini görmek veya belleğe yüklemek için kurulu bir model seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть встановлену модель, щоб переглянути характеристики та параметри виконання або завантажити її в пам'ять."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một mô hình đã cài để xem thông số, tùy chọn chạy, hoặc tải vào bộ nhớ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择一个已安装的模型，以查看规格、运行选项，或将其加载到内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取一個已安裝的模型，以檢視規格、執行選項，或將其載入記憶體。"
          }
        }
      }
    },
