        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel draf untuk ditulis ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla una bozza da riscrivere."
          }
        },
        "ja": {
