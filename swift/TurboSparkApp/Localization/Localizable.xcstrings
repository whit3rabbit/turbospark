        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05e2\u05df \u05de\u05d5\u05d3\u05dc \u05ea\u05d7\u05d9\u05dc\u05d4: \u05d4\u05e1\u05d9\u05db\u05d5\u05dd \u05d6\u05e7\u05d5\u05e7 \u05dc\u05de\u05d5\u05d3\u05dc \u05db\u05d3\u05d9 \u05dc\u05e4\u05e2\u05d5\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0939\u0932\u0947 \u090f\u0915 \u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902: \u0938\u093e\u0930\u093e\u0902\u0936 \u091a\u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0949\u0921\u0932 \u091a\u093e\u0939\u093f\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat model terlebih dahulu: ringkasan memerlukan model untuk berjalan."
