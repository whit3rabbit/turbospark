          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िग और सक्षम प्लगइन से आने वाले लाइफ़साइकल हुक प्रबंधित करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer levenscyclus-hooks uit de configuratie en ingeschakelde plug-ins."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj hookami cyklu życia z konfiguracji i włączonych wtyczek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
