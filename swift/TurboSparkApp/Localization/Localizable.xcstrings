          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не отключайте диски, пока перемещение не завершится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Låt enheterna vara anslutna tills flytten är klar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taşıma bitene kadar sürücüleri bağlı tutun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не відключайте диски, доки переміщення не завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy giữ các ổ đĩa được kết nối cho đến khi quá trình di chuyển hoàn tất."
          }
        },
        "zh-Hans": {
