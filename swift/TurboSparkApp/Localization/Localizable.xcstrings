    "Active servers are available to the assistant during turns in this project.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062a\u0648\u0641\u0631 \u0627\u0644\u062e\u0648\u0627\u062f\u0645 \u0627\u0644\u0646\u0634\u0637\u0629 \u0644\u0644\u0645\u0633\u0627\u0639\u062f \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Server stehen dem Assistenten w\u00e4hrend der Z\u00fcge in diesem Projekt zur Verf\u00fcgung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active servers are available to the assistant during turns in this project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores activos estan disponibles para el asistente durante los turnos de este proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs actifs sont disponibles pour l'assistant pendant les tours de ce projet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05e8\u05ea\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd \u05d6\u05de\u05d9\u05e0\u05d9\u05dd \u05dc\u05e2\u05d5\u05d6\u05e8 \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05ea\u05d5\u05e8\u05d5\u05ea \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0915\u094d\u0930\u093f\u092f \u0938\u0930\u094d\u0935\u0930 \u0907\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0947 \u091f\u0930\u094d\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0905\u0938\u093f\u0938\u094d\u091f\u0947\u0902\u091f \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u0932\u092c\u094d\u0927 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server aktif tersedia untuk asisten selama giliran dalam proyek ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I server attivi sono disponibili per l'assistente durante i turni di questo progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u52b9\u306a\u30b5\u30fc\u30d0\u30fc\u306f\u3001\u3053\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u30bf\u30fc\u30f3\u4e2d\u306b\u30a2\u30b7\u30b9\u30bf\u30f3\u30c8\u304b\u3089\u5229\u7528\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud65c\uc131 \uc11c\ubc84\ub294 \uc774 \ud504\ub85c\uc81d\ud2b8\uc758 \ud134 \ub3d9\uc548 \uc5b4\uc2dc\uc2a4\ud134\ud2b8\uac00 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve servers zijn tijdens beurten in dit project beschikbaar voor de assistent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywne serwery s\u0105 dost\u0119pne dla asystenta podczas tur w tym projekcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os servidores ativos ficam dispon\u00edveis para o assistente durante os turnos deste projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u043a\u0442\u0438\u0432\u043d\u044b\u0435 \u0441\u0435\u0440\u0432\u0435\u0440\u044b \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0443 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0445\u043e\u0434\u043e\u0432 \u0432 \u044d\u0442\u043e\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiva servrar \u00e4r tillg\u00e4ngliga f\u00f6r assistenten under turer i det h\u00e4r projektet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin sunucular, bu projedeki turlar s\u0131ras\u0131nda asistan taraf\u0131ndan kullan\u0131labilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u043a\u0442\u0438\u0432\u043d\u0456 \u0441\u0435\u0440\u0432\u0435\u0440\u0438 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0430\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0443 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0445\u043e\u0434\u0456\u0432 \u0443 \u0446\u044c\u043e\u043c\u0443 \u043f\u0440\u043e\u0454\u043a\u0442\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c m\u00e1y ch\u1ee7 \u0111ang ho\u1ea1t \u0111\u1ed9ng s\u1eb5n s\u00e0ng cho tr\u1ee3 l\u00fd trong c\u00e1c l\u01b0\u1ee3t c\u1ee7a d\u1ef1 \u00e1n n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6d3b\u8dc3\u7684\u670d\u52a1\u5668\u53ef\u4f9b\u52a9\u624b\u5728\u672c\u9879\u76ee\u7684\u5bf9\u8bdd\u8f6e\u6b21\u4e2d\u4f7f\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u4e2d\u7684\u4f3a\u670d\u5668\u53ef\u4f9b\u52a9\u7406\u5728\u672c\u5c08\u6848\u7684\u56de\u5408\u4e2d\u4f7f\u7528\u3002"
          }
        }
      }
    },
