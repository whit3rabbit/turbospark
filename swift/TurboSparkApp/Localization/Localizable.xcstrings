    "Live or last run decoding throughput (tokens per second)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معدل فك التشفير المباشر أو لآخر تشغيل (رموز في الثانية)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekodierdurchsatz live oder des letzten Laufs (Token pro Sekunde)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live or last run decoding throughput (tokens per second)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendimiento de decodificación en vivo o de la última ejecución (tokens por segundo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Débit de décodage en direct ou de la dernière exécution (tokens par seconde)"
          }
        },
        "he": {
