            "state": "translated",
            "value": "\u627e\u4e0d\u5230\u5df2\u77e5\u7684\u63d0\u4f9b\u8005\u8cc7\u6599\u593e\u3002"
          }
        }
      }
    },
    "No local models are installed yet.": {
