    "Record a call with your microphone and the app playing it. Speakers are labeled after you stop.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل مكالمة باستخدام الميكروفون والتطبيق الذي يشغّلها. تُحدَّد هوية المتحدثين بعد الإيقاف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm ein Gespräch mit deinem Mikrofon und der App auf, die es wiedergibt. Die Sprecher werden nach dem Stoppen benannt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a call with your microphone and the app playing it. Speakers are labeled after you stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una llamada con tu micrófono y la app que la reproduce. Los hablantes se identifican al detener la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un appel avec votre micro et l'app qui le diffuse. Les intervenants sont identifiés après l'arrêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלט שיחה עם המיקרופון שלך והיישום שמשמיע אותה. הדוברים מסומנים לאחר העצירה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने माइक्रोफ़ोन और कॉल चला रहे ऐप से कॉल रिकॉर्ड करें। रोकने के बाद वक्ताओं को लेबल किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam panggilan dengan mikrofon Anda dan aplikasi yang memutarnya. Pembicara diberi label setelah Anda berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una chiamata con il microfono e l'app che la riproduce. Gli interlocutori vengono etichettati quando ti fermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクと通話を再生しているアプリで通話を録音します。停止すると話者がラベル付けされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크와 통화를 재생하는 앱으로 통화를 녹음하세요. 중지하면 화자가 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een gesprek op met je microfoon en de app die het afspeelt. Sprekers worden gelabeld nadat je stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj rozmowę mikrofonem i z aplikacji, która ją odtwarza. Mówcy są oznaczani po zatrzymaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma chamada com seu microfone e o aplicativo que a reproduz. Os falantes são identificados depois que você para."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите звонок через микрофон и приложение, в котором он идёт. Говорящие размечаются после остановки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in ett samtal med mikrofonen och appen som spelar upp det. Talarna märks när du stoppar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonunuzla ve görüşmeyi çalan uygulamayla bir görüşme kaydedin. Konuşmacılar durdurduktan sonra etiketlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть дзвінок через мікрофон і програму, у якій він звучить. Мовців позначають після зупинки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi cuộc gọi bằng micrô và ứng dụng đang phát cuộc gọi. Người nói được gắn nhãn sau khi bạn dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用麦克风和正在播放通话的应用录制通话。停止后会标注说话人。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用麥克風和正在播放通話的 App 錄製通話。停止後會標註說話者。"
          }
        }
      }
    },
    "Record a meeting, add markers, and keep the original audio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a meeting, add markers, and keep the original audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una reunión, añade marcadores y conserva el audio original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une réunion, ajoutez des repères et conservez l'audio original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm ein Meeting auf, füge Markierungen hinzu und behalte das Originalaudio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una riunione, aggiungi marcatori e conserva l'audio originale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma reunião, adicione marcadores e mantenha o áudio original."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een vergadering op, voeg markeringen toe en behoud de oorspronkelijke audio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in ett möte, lägg till markörer och behåll originalljudet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj spotkanie, dodaj znaczniki i zachowaj oryginalny dźwięk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir toplantıyı kaydedin, işaretler ekleyin ve orijinal sesi koruyun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam rapat, tambahkan penanda, dan simpan audio aslinya."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите встречу, добавьте метки и сохраните исходное аудио."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть зустріч, додайте мітки та збережіть початкове аудіо."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi lại cuộc họp, thêm dấu mốc và giữ âm thanh gốc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議を録音し、マーカーを追加して、元の音声を保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 녹음하고 마커를 추가하며 원본 오디오를 보관하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制会议、添加标记并保留原始音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製會議、新增標記並保留原始音訊。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل اجتماعاً وأضف علامات واحتفظ بالصوت الأصلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלט פגישה, הוסף סמנים ושמור את השמע המקורי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीटिंग रिकॉर्ड करें, मार्कर जोड़ें और मूल ऑडियो रखें।"
          }
        }
      }
    },
    "Record a voice note. The words appear as you speak, and the note keeps its audio.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل ملاحظة صوتية. تظهر الكلمات أثناء حديثك، وتحتفظ الملاحظة بصوتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm eine Sprachnotiz auf. Die Wörter erscheinen beim Sprechen, und die Notiz behält ihr Audio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a voice note. The words appear as you speak, and the note keeps its audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una nota de voz. Las palabras aparecen mientras hablas y la nota conserva su audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez un mémo vocal. Les mots s'affichent pendant que vous parlez, et le mémo garde son audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלט הערה קולית. המילים מופיעות בזמן שאתה מדבר, וההערה שומרת את השמע שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉइस नोट रिकॉर्ड करें। बोलते समय शब्द दिखते हैं, और नोट अपना ऑडियो रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam catatan suara. Kata-kata muncul saat Anda berbicara, dan catatan menyimpan audionya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una nota vocale. Le parole compaiono mentre parli e la nota conserva il suo audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ボイスメモを録音します。話すと同時に言葉が表示され、メモには音声も残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음성 메모를 녹음하세요. 말하는 동안 단어가 나타나고, 메모에 오디오가 보관됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een spraaknotitie op. De woorden verschijnen terwijl je spreekt, en de notitie bewaart de audio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj notatkę głosową. Słowa pojawiają się w trakcie mówienia, a notatka zachowuje swój dźwięk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma nota de voz. As palavras aparecem enquanto você fala, e a nota mantém o áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите голосовую заметку. Слова появляются по ходу речи, а заметка сохраняет звук."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in en röstanteckning. Orden visas medan du talar, och anteckningen behåller sitt ljud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli not kaydedin. Siz konuşurken kelimeler görünür ve not sesini saklar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть голосову нотатку. Слова з'являються під час мовлення, а нотатка зберігає звук."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi một ghi chú giọng nói. Chữ hiện ra khi bạn nói, và ghi chú giữ lại âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制语音备忘。说话时文字会随即出现，备忘也会保留音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製語音備忘。說話時文字會隨即出現，備忘也會保留音訊。"
          }
        }
      }
    },
