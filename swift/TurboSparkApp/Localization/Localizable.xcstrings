        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0915\u0948\u091f\u0932\u0949\u0917 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f \u0915\u093e \u0915\u094b\u0908 \u0938\u0930\u094d\u0935\u0930 \u0928\u093e\u092e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
