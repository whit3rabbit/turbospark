            "value": "\u05e0\u05d9\u05e7\u05d5\u05d9 \u05e0\u05ea\u05d5\u05e0\u05d9 \u05de\u05e0\u05d5\u05e2 \u05d4\u05d4\u05e7\u05e9\u05e8"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0926\u0930\u094d\u092d \u0907\u0902\u091c\u0928 \u0915\u093e \u0921\u0947\u091f\u093e \u0938\u093e\u092b\u093c \u0915\u0930\u0947\u0902"
          }
