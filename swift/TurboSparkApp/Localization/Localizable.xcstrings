        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Outils interdits (s\u00e9par\u00e9s par des virgules)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05dc\u05d9\u05dd \u05d0\u05e1\u05d5\u05e8\u05d9\u05dd (\u05de\u05d5\u05e4\u05e8\u05d3\u05d9\u05dd \u05d1\u05e4\u05e1\u05d9\u05e7\u05d9\u05dd)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0928\u0928\u0941\u092e\u0924 \u091f\u0942\u0932 (\u0905\u0932\u094d\u092a\u0935\u093f\u0930\u093e\u092e \u0938\u0947 \u0905\u0932\u0917)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat yang tidak diizinkan (dipisahkan koma)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumenti non consentiti (separati da virgole)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7981\u6b62\u3059\u308b\u30c4\u30fc\u30eb (\u30ab\u30f3\u30de\u533a\u5207\u308a)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud5c8\uc6a9\ub418\uc9c0 \uc54a\ub294 \ub3c4\uad6c(\uc27c\ud45c\ub85c \uad6c\ubd84)"
          }
        },
        "nl": {
