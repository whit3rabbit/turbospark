    "Generation stops when the model emits any of these comma-separated strings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation stops when the model emits any of these comma-separated strings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generación se detiene cuando el modelo emite cualquiera de estas cadenas separadas por comas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La génération s'arrête lorsque le modèle produit l'une de ces chaînes séparées par des virgules."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Generierung stoppt, sobald das Modell eine dieser kommagetrennten Zeichenfolgen ausgibt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La generazione si interrompe quando il modello emette una di queste stringhe separate da virgole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A geração para quando o modelo emite qualquer uma destas cadeias separadas por vírgula."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Генерация останавливается, когда модель выдает любую из этих строк, перечисленных через запятую."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルがこれらのカンマ区切り文字列のいずれかを出力すると生成が停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 쉼표로 구분된 이 문자열 중 하나를 출력하면 생성이 중지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当模型输出这些以逗号分隔的字符串中的任意一个时，生成即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當模型輸出這些以逗號分隔的字串中的任一個時，生成即停止。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتوقف التوليد عندما يُخرج النموذج أيا من هذه السلاسل المفصولة بفواصل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היצירה נעצרת כאשר המודל פולט אחת מהמחרוזות האלה, המופרדות בפסיקים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब मॉडल इन अल्पविराम से अलग स्ट्रिंग्स में से कोई भी उत्पन्न करता है, तो जनरेशन रुक जाता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het genereren stopt zodra het model een van deze kommagescheiden tekenreeksen produceert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Generowanie zatrzymuje się, gdy model wygeneruje dowolny z tych ciągów oddzielonych przecinkami."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model, virgülle ayrılmış bu dizelerden herhangi birini ürettiğinde üretim durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Генерація зупиняється, коли модель видає будь-який із цих рядків, розділених комами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereringen stoppar när modellen skickar ut någon av dessa kommaseparerade strängar."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình tạo dừng lại khi mô hình xuất ra bất kỳ chuỗi nào trong danh sách phân tách bằng dấu phẩy này."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembuatan berhenti saat model mengeluarkan salah satu string yang dipisahkan koma ini."
          }
        }
      }
    },
