        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093f\u0902\u0921\u094b \u092c\u0902\u0926 \u0939\u094b\u0928\u0947 \u092a\u0930 \u092a\u0943\u0937\u094d\u0920\u092d\u0942\u092e\u093f \u092e\u0947\u0902 \u091a\u0932\u0924\u0947 \u0930\u0939\u0947\u0902"
