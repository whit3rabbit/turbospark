        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generation ended without a result."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generaci\u00f3n termin\u00f3 sin resultado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La g\u00e9n\u00e9ration s'est termin\u00e9e sans r\u00e9sultat."
