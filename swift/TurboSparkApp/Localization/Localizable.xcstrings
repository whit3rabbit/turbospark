    "Always ask before tool calls edit files or use the internet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسأل دائمًا قبل أن تعدّل استدعاءات الأدوات الملفات أو تستخدم الإنترنت"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Immer fragen, bevor Tool-Aufrufe Dateien bearbeiten oder das Internet nutzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always ask before tool calls edit files or use the internet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Preguntar siempre antes de que las herramientas editen archivos o usen internet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toujours demander avant qu'un outil modifie des fichiers ou utilise Internet"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאל תמיד לפני שקריאות כלים עורכות קבצים או משתמשות באינטרנט"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूल कॉल द्वारा फ़ाइलें संपादित करने या इंटरनेट उपयोग करने से पहले हमेशा पूछें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selalu tanya sebelum panggilan alat mengedit file atau memakai internet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi sempre prima che uno strumento modifichi file o usi Internet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールがファイルを編集したりインターネットを使ったりする前に必ず確認する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 호출이 파일을 편집하거나 인터넷을 사용하기 전에 항상 묻기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Altijd vragen voordat tools bestanden bewerken of internet gebruiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zawsze pytaj, zanim narzędzia zmienią pliki lub użyją internetu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sempre perguntar antes que ferramentas editem arquivos ou usem a internet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всегда спрашивать, прежде чем инструменты изменят файлы или выйдут в интернет"
          }
        },
        "sv": {
          "stringUnit": {
