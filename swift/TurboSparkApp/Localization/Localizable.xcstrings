    "Summarize older turns to free context": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u062e\u0651\u0635 \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0623\u0642\u062f\u0645 \u0644\u062a\u062d\u0631\u064a\u0631 \u0627\u0644\u0633\u064a\u0627\u0642"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4ltere Runden zusammenfassen, um Kontext freizugeben"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarize older turns to free context"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumir los turnos antiguos para liberar contexto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9sumer les anciens tours pour lib\u00e9rer du contexte"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05db\u05dd \u05ea\u05d5\u05e8\u05d5\u05ea \u05d9\u05e9\u05e0\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05e4\u05e0\u05d5\u05ea \u05d4\u05e7\u05e9\u05e8"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0926\u0930\u094d\u092d \u0916\u093e\u0932\u0940 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u0941\u0930\u093e\u0928\u0947 \u091a\u0930\u0923\u094b\u0902 \u0915\u093e \u0938\u093e\u0930\u093e\u0902\u0936 \u092c\u0928\u093e\u090f\u0901"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringkas giliran lama untuk mengosongkan konteks"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riassume i turni pi\u00f9 vecchi per liberare contesto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53e4\u3044\u30bf\u30fc\u30f3\u3092\u8981\u7d04\u3057\u3066\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u3092\u7a7a\u3051\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\uc804 \ud134\uc744 \uc694\uc57d\ud574 \ucee8\ud14d\uc2a4\ud2b8 \ud655\ubcf4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudere beurten samenvatten om context vrij te maken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumuj starsze tury, aby zwolni\u0107 kontekst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumir turnos antigos para liberar contexto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0436\u0430\u0442\u044c \u0441\u0442\u0430\u0440\u044b\u0435 \u0445\u043e\u0434\u044b \u0432 \u0441\u0432\u043e\u0434\u043a\u0443, \u0447\u0442\u043e\u0431\u044b \u043e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u044c \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanfatta \u00e4ldre turer f\u00f6r att frig\u00f6ra kontext"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u011flam a\u00e7mak i\u00e7in eski turlar\u0131 \u00f6zetle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434\u0441\u0443\u043c\u0443\u0432\u0430\u0442\u0438 \u0441\u0442\u0430\u0440\u0456\u0448\u0456 \u0445\u043e\u0434\u0438, \u0449\u043e\u0431 \u0437\u0432\u0456\u043b\u044c\u043d\u0438\u0442\u0438 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f3m t\u1eaft c\u00e1c l\u01b0\u1ee3t c\u0169 \u0111\u1ec3 gi\u1ea3i ph\u00f3ng ng\u1eef c\u1ea3nh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u603b\u7ed3\u8f83\u65e9\u7684\u8f6e\u6b21\u4ee5\u91ca\u653e\u4e0a\u4e0b\u6587"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6458\u8981\u8f03\u65e9\u7684\u8f2a\u6b21\u4ee5\u91cb\u653e\u4e0a\u4e0b\u6587"
          }
        }
      }
    },
