            "state": "translated",
            "value": "Niet-toegestane tools (kommagescheiden)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niedozwolone narz\u0119dzia (oddzielone przecinkami)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferramentas n\u00e3o permitidas (separadas por v\u00edrgula)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0440\u0435\u0449\u0435\u043d\u043d\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b (\u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043f\u044f\u0442\u0443\u044e)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Otill\u00e5tna verktyg (kommaseparerade)"
          }
        },
        "tr": {
