            "value": "\u0417\u0433\u0435\u043d\u0435\u0440\u043e\u0432\u0430\u043d\u0438\u0439 \u0445\u0432\u0456\u0441\u0442 \u0432\u0456\u0434\u043a\u0438\u043d\u0443\u0442\u043e: %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genererad slutdel kastades bort: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 lo\u1ea1i b\u1ecf ph\u1ea7n cu\u1ed1i \u0111\u01b0\u1ee3c t\u1ea1o: %@."
          }
        },
        "id": {
