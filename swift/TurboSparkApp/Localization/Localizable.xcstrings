        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e0i s\u1ea3n \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a b\u1ecb l\u1ed7i \u0111\u1ecbnh d\u1ea1ng ho\u1eb7c \u0111\u00e3 b\u1ecb s\u1eeda \u0111\u1ed5i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
