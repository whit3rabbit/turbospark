        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天"
          }
        }
      }
    },
    "You can invoke this subagent in chat or via slash command with clean context isolation:": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك استدعاء هذا الوكيل الفرعي في المحادثة أو عبر أمر شرطة مائلة، مع عزل سياق نظيف:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können diesen Subagent im Chat oder per Slash-Befehl aufrufen, mit sauberer Kontextisolierung:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can invoke this subagent in chat or via slash command with clean context isolation:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes invocar este subagente en el chat o mediante un comando de barra, con aislamiento de contexto limpio:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez invoquer ce sous-agent dans la discussion ou via une commande slash, avec une isolation de contexte propre :"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להפעיל את תת-הסוכן הזה בשיחה או באמצעות פקודת סלאש, עם בידוד הקשר נקי:"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इस सबएजेंट को चैट में या स्लैश कमांड से, स्वच्छ संदर्भ पृथक्करण के साथ बुला सकते हैं:"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat memanggil subagen ini di obrolan atau lewat perintah garis miring, dengan isolasi konteks yang bersih:"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi richiamare questo sottoagente nella chat o tramite comando slash, con un isolamento del contesto pulito:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサブエージェントは、チャットまたはスラッシュコマンドから、クリーンなコンテキスト分離で呼び出せます:"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서브에이전트는 대화에서 또는 슬래시 명령으로 깨끗한 컨텍스트 격리 상태에서 호출할 수 있습니다:"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt deze subagent aanroepen in de chat of via een slash-opdracht, met schone contextisolatie:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz wywołać tego podagenta w czacie lub poleceniem ukośnika, z czystą izolacją kontekstu:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode invocar este subagente no chat ou por comando de barra, com isolamento de contexto limpo:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете вызвать этого субагента в чате или slash-командой с чистой изоляцией контекста:"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan anropa den här underagenten i chatten eller via ett snedstreckskommando, med ren kontextisolering:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu alt aracıyı sohbette veya eğik çizgi komutuyla, temiz bağlam yalıtımıyla çağırabilirsiniz:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви можете викликати цього субагента в чаті або slash-командою з чистою ізоляцією контексту:"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể gọi tác nhân phụ này trong cuộc trò chuyện hoặc bằng lệnh gạch chéo, với ngữ cảnh được cô lập sạch:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在对话中或通过斜杠命令调用此子代理，并获得干净的上下文隔离:"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在對話中或透過斜線命令呼叫此子代理，並獲得乾淨的上下文隔離:"
          }
        }
      }
    },
    "You can rename anyone later from the transcript.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك إعادة تسمية أي شخص لاحقًا من النص المفرّغ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst jeden später in der Transkription umbenennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can rename anyone later from the transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar el nombre de cualquiera más tarde desde la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez renommer chacun plus tard depuis la transcription."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשנות את השם של כל אחד מאוחר יותר מהתמליל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप बाद में ट्रांसक्रिप्ट से किसी का भी नाम बदल सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda bisa mengganti nama siapa pun nanti dari transkrip."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi rinominare chiunque più tardi dalla trascrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで文字起こしから誰でも名前を変更できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 변환된 텍스트에서 누구든 이름을 바꿀 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt iedereen later hernoemen vanuit de transcriptie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdego możesz później przemianować w transkrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode renomear qualquer pessoa depois pela transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любого можно переименовать позже в расшифровке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan byta namn på vem som helst senare från transkriptionen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkesi daha sonra dökümden yeniden adlandırabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-кого можна перейменувати пізніше в розшифровці."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đổi tên bất kỳ ai sau trong bản chép lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后可以在转写文本中为任何人重命名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後可以在轉寫文字中為任何人重新命名。"
          }
        }
      }
    },
    "Your earlier model store converts to a library when its drive is connected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيتحول مخزن النماذج الذي نقلته سابقًا إلى مكتبة عند توصيل محرك الأقراص الخاص به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihr früher verschobener Modellspeicher wird in eine Bibliothek umgewandelt, sobald sein Laufwerk verbunden ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your earlier model store converts to a library when its drive is connected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu almacén de modelos anterior se convertirá en biblioteca cuando se conecte su unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre ancien stockage de modèles sera converti en bibliothèque dès que son disque sera connecté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאגר המודלים הקודם שלך יומר לספרייה כשהכונן שלו יחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पहले का मॉडल स्टोर तब लाइब्रेरी में बदल जाएगा जब उसकी ड्राइव कनेक्ट होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan model Anda sebelumnya akan diubah menjadi pustaka saat drive-nya terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archivio di modelli precedente diventerà una libreria quando la sua unità sarà collegata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前に移動したモデルストアは、そのドライブが接続されるとライブラリに変換されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전에 옮긴 모델 저장소는 해당 드라이브가 연결되면 라이브러리로 변환됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uw eerdere modelopslag wordt omgezet naar een bibliotheek zodra de bijbehorende schijf is aangesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wcześniejszy magazyn modeli zostanie przekształcony w bibliotekę po podłączeniu jego dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu armazenamento de modelos anterior será convertido em biblioteca quando a unidade dele for conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше прежнее хранилище моделей станет библиотекой, когда его диск будет подключён."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditt tidigare modellförråd omvandlas till ett bibliotek när dess enhet ansluts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki model deponuz, sürücüsü bağlandığında kitaplığa dönüştürülür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше попереднє сховище моделей перетвориться на бібліотеку, коли його диск буде підключено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho mô hình trước đây của bạn sẽ được chuyển thành thư viện khi ổ đĩa của nó được kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你之前移动的模型存储会在其驱动器连接后转换为模型库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你之前移動的模型儲存空間會在其磁碟機連接後轉換為模型庫。"
          }
        }
      }
    },
    "Your input and completed takes are kept. Adjust the settings and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your input and completed takes are kept. Adjust the settings and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conservan tus entradas y las tomas completadas. Ajusta la configuración e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos saisies et les prises terminées sont conservées. Ajustez les réglages et réessayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Eingaben und fertigen Takes bleiben erhalten. Passe die Einstellungen an und versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati e le take completate vengono conservati. Modifica le impostazioni e riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Suas entradas e tomadas concluídas são mantidas. Ajuste as configurações e tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je invoer en voltooide takes blijven behouden. Pas de instellingen aan en probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina indata och färdiga tagningar behålls. Justera inställningarna och försök igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane wejściowe i ukończone wersje zostają zachowane. Zmień ustawienia i spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Girdileriniz ve tamamlanan çekimler korunur. Ayarları değiştirip yeniden deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukan dan take yang selesai tetap disimpan. Sesuaikan pengaturan lalu coba lagi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши входные данные и готовые дубли сохраняются. Измените настройки и повторите попытку."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші вхідні дані та готові дублі зберігаються. Змініть налаштування та спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu đầu vào và các lượt thu hoàn tất được giữ lại. Điều chỉnh cài đặt và thử lại."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力内容と完成したテイクは保持されます。設定を調整して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 내용과 완료된 테이크는 유지됩니다. 설정을 조정하고 다시 시도하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您的输入和已完成的版本会被保留。调整设置后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "您的輸入和已完成的版本會被保留。調整設定後再試一次。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم الاحتفاظ بمدخلاتك والنسخ المكتملة. اضبط الإعدادات وحاول مجدداً."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלט שלך והטייקים שהושלמו נשמרים. התאם את ההגדרות ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका इनपुट और पूरे हुए टेक सुरक्षित रखे जाते हैं। सेटिंग्स बदलें और फिर कोशिश करें।"
          }
        }
      }
    },
