            "state": "translated",
            "value": "\u0421\u0435\u0440\u0432\u0435\u0440 \u0437 \u043d\u0430\u0437\u0432\u043e\u044e '%@' \u0443\u0436\u0435 \u0456\u0441\u043d\u0443\u0454."
