    "A name applies to every line from that voice, and to exported transcripts and subtitles.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينطبق الاسم على كل سطر من ذلك الصوت، وعلى النصوص والترجمات المُصدَّرة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name gilt für jede Zeile dieser Stimme und für exportierte Transkriptionen und Untertitel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A name applies to every line from that voice, and to exported transcripts and subtitles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre se aplica a cada línea de esa voz y a las transcripciones y subtítulos exportados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom s'applique à chaque ligne de cette voix, ainsi qu'aux transcriptions et sous-titres exportés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם חל על כל שורה של הקול הזה, ועל תמלילים וכתוביות שמיוצאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम उस आवाज़ की हर पंक्ति पर और निर्यात किए गए ट्रांसक्रिप्ट व सबटाइटल पर लागू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama berlaku untuk setiap baris dari suara itu, serta transkrip dan subtitel yang diekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome vale per ogni riga di quella voce e per le trascrizioni e i sottotitoli esportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前はその声のすべての行と、書き出した文字起こしや字幕に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 그 목소리의 모든 줄과 내보낸 텍스트 및 자막에 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een naam geldt voor elke regel van die stem en voor geëxporteerde transcripties en ondertitels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa dotyczy każdej linii tego głosu oraz eksportowanych transkrypcji i napisów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome vale para cada linha dessa voz e para as transcrições e legendas exportadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя применяется ко всем репликам этого голоса, а также к экспортированным расшифровкам и субтитрам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett namn gäller varje rad från den rösten och exporterade transkriptioner och undertexter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad, o sesin her satırına ve dışa aktarılan dökümlere ve altyazılara uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ім'я застосовується до кожної репліки цього голосу, а також до експортованих розшифровок і субтитрів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên áp dụng cho mọi dòng của giọng đó, cùng bản chép lời và phụ đề đã xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称会应用到该声音的每一行，以及导出的转写文本和字幕。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱會套用到該聲音的每一行，以及匯出的轉寫文字和字幕。"
          }
        }
      }
    },
    "A new key is generated each time the app starts and is not saved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُنشأ مفتاح جديد في كل مرة يبدأ فيها التطبيق ولا يُحفظ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Start der App wird ein neuer Schlüssel erzeugt, der nicht gespeichert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new key is generated each time the app starts and is not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se genera una clave nueva cada vez que se inicia la app y no se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle clé est générée à chaque démarrage de l'app et n'est pas enregistrée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח חדש נוצר בכל הפעלה של האפליקציה ואינו נשמר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप हर बार शुरू होने पर एक नई कुंजी बनाता है, जिसे सहेजा नहीं जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci baru dibuat setiap kali app dimulai dan tidak disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni avvio dell'app viene generata una nuova chiave, che non viene salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーはアプリの起動ごとに新しく生成され、保存されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱을 시작할 때마다 새 키가 생성되며 저장되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij elke start van de app wordt een nieuwe sleutel gemaakt, die niet wordt opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy klucz jest generowany przy każdym uruchomieniu aplikacji i nie jest zapisywany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova chave é gerada a cada abertura do app e não é salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При каждом запуске приложения создаётся новый ключ, который не сохраняется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny nyckel skapas varje gång appen startar och sparas inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama her başladığında yeni bir anahtar oluşturulur ve kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час кожного запуску застосунку створюється новий ключ, який не зберігається."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một khóa mới được tạo mỗi khi ứng dụng khởi động và không được lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次启动应用时都会生成新密钥，且不会保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每次啟動 App 時都會產生新金鑰，且不會儲存。"
          }
        }
      }
    },
    "A newer version of TurboSpark made this library. You can use its models, but you cannot change it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنشأ إصدار أحدث من TurboSpark هذه المكتبة. يمكنك استخدام نماذجها، لكن لا يمكنك تغييرها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine neuere Version von TurboSpark hat diese Bibliothek erstellt. Sie können ihre Modelle verwenden, die Bibliothek aber nicht ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A newer version of TurboSpark made this library. You can use its models, but you cannot change it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versión más reciente de TurboSpark creó esta biblioteca. Puedes usar sus modelos, pero no modificarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une version plus récente de TurboSpark a créé cette bibliothèque. Vous pouvez utiliser ses modèles, mais pas la modifier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרסה חדשה יותר של TurboSpark יצרה את הספרייה הזו. אפשר להשתמש במודלים שלה, אבל אי אפשר לשנות אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark के नए संस्करण ने यह लाइब्रेरी बनाई है। आप इसके मॉडल इस्तेमाल कर सकते हैं, लेकिन लाइब्रेरी को बदल नहीं सकते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Versi TurboSpark yang lebih baru membuat pustaka ini. Anda dapat memakai modelnya, tetapi tidak dapat mengubah pustaka ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una versione più recente di TurboSpark ha creato questa libreria. Puoi usare i suoi modelli, ma non modificarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリは、より新しいバージョンのTurboSparkで作成されました。モデルは使用できますが、ライブラリは変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 새로운 버전의 TurboSpark에서 만든 라이브러리입니다. 모델은 사용할 수 있지만 라이브러리는 변경할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuwere versie van TurboSpark heeft deze bibliotheek gemaakt. Je kunt de modellen gebruiken, maar de bibliotheek niet wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tę bibliotekę utworzyła nowsza wersja TurboSpark. Możesz używać jej modeli, ale nie możesz jej zmieniać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma versão mais recente do TurboSpark criou esta biblioteca. Você pode usar os modelos dela, mas não alterá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эту библиотеку создала более новая версия TurboSpark. Её модели можно использовать, но саму библиотеку изменить нельзя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En nyare version av TurboSpark har skapat det här biblioteket. Du kan använda modellerna, men inte ändra biblioteket."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaplığı TurboSpark'ın daha yeni bir sürümü oluşturdu. Modellerini kullanabilirsiniz ancak kitaplığı değiştiremezsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю бібліотеку створила новіша версія TurboSpark. Її моделі можна використовувати, але саму бібліотеку змінити не можна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một phiên bản TurboSpark mới hơn đã tạo thư viện này. Bạn có thể dùng các mô hình của nó nhưng không thể thay đổi thư viện."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型库由更新版本的 TurboSpark 创建。你可以使用其中的模型，但无法更改该模型库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型庫由較新版本的 TurboSpark 建立。你可以使用其中的模型，但無法更改此模型庫。"
          }
        }
      }
    },
    "A pinned hold outlives this app: quitting restores Apple's curve unless the toggle above is on. Fans can always be released with `thermalforge auto`.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمر تثبيت المروحة بعد إغلاق هذا التطبيق: يؤدي الخروج إلى استعادة منحنى Apple ما لم يكن المفتاح أعلاه قيد التشغيل. يمكن دائمًا تحرير المراوح باستخدام `thermalforge auto`."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein fixierter Zustand überdauert diese App: Das Beenden stellt die Apple-Kurve wieder her, sofern der Schalter oben nicht aktiviert ist. Lüfter können jederzeit mit `thermalforge auto` freigegeben werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A pinned hold outlives this app: quitting restores Apple's curve unless the toggle above is on. Fans can always be released with `thermalforge auto`."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fijación de ventilador sobrevive al cierre de esta app: salir restaura la curva de Apple a menos que el interruptor superior esté activado. Los ventiladores siempre se pueden liberar con `thermalforge auto`."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un maintien forcé survit à cette application : quitter restaure la courbe d'Apple à moins que le bouton ci-dessus ne soit activé. Les ventilateurs peuvent toujours être libérés avec `thermalforge auto`."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החזקה מקובעת ממשיכה מעבר לאפליקציה זו: יציאה משחזרת את העקומה של Apple אלא אם המתג למעלה פועל. תמיד ניתן לשחרר מאווררים באמצעות `thermalforge auto`."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिन की गई पकड़ इस ऐप से आगे रहती है: जब तक कि ऊपर का टॉगल चालू न हो, छोड़ना Apple के वक्र को पुनर्स्थापित करता है। पंखे हमेशा `thermalforge auto` के साथ जारी किए जा सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penahanan yang disematkan bertahan lebih lama dari aplikasi ini: keluar akan memulihkan kurva Apple kecuali tombol di atas aktif. Kipas selalu dapat dilepaskan dengan `thermalforge auto`."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un blocco della ventola sopravvive alla chiusura dell'app: uscire ripristina la curva di Apple a meno che l'interruttore sopra non sia attivo. Le ventole possono sempre essere sbloccate con `thermalforge auto`."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ファンの固定状態はこのアプリの終了後も維持されます。上記のトグルがオンになっていない限り、終了すると Apple の曲線に戻ります。ファンはいつでも `thermalforge auto` で解放できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팬 속도 고정은 이 앱이 종료된 후에도 유지됩니다. 위의 토글이 켜져 있지 않으면 종료 시 Apple 곡선으로 복원됩니다. 팬은 언제든지 `thermalforge auto`로 해제할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een vastgezette hold blijft behouden na het afsluiten van deze app: stoppen herstelt de Apple-curve, tenzij de schakelaar hierboven aan staat. Ventilatoren kunnen altijd worden vrijgegeven met `thermalforge auto`."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypięta blokada działa dłużej niż ta aplikacja: wyjście przywraca krzywą Apple, chyba że powyższy przełącznik jest włączony. Wentylatory można zawsze zwolnić za pomocą `thermalforge auto`."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fixação da velocidade sobrevive ao encerramento do app: sair restaura a curva da Apple, a menos que a opção acima esteja ativada. As ventoinhas sempre podem ser liberadas com `thermalforge auto`."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фиксация вентиляторов сохраняется после закрытия этого приложения: выход восстанавливает кривую Apple, если переключатель выше не включен. Вентиляторы всегда можно освободить с помощью `thermalforge auto`."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett fäst läge överlever den här appen: avsluta återställer Apples kurva om inte reglaget ovan är på. Fläktar kan alltid släppas med `thermalforge auto`."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabitlenmiş tutma bu uygulamanın ötesinde sürer: yukarıdaki geçiş açık olmadığı sürece çıkış Apple'ın eğrisini geri yükler. Fanlar her zaman `thermalforge auto` ile serbest bırakılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фіксація вентиляторів зберігається після закриття цієї програми: вихід відновлює криву Apple, якщо перемикач вище не ввімкнено. Вентилятори завжди можна звільнити за допомогою `thermalforge auto`."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái ghim quạt vẫn tồn tại sau ứng dụng này: thoát sẽ khôi phục đường cong của Apple trừ khi bật nút chuyển đổi ở trên. Quạt luôn có thể được giải phóng bằng `thermalforge auto`."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "固定转速在此应用退出后依然生效：除非开启上方开关，否则退出应用会恢复 Apple 默认风扇曲线。随时可通过 `thermalforge auto` 释放风扇控制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "固定轉速在此應用程式結束後依然生效：除非開啟上方開關，否則結束應用程式會恢復 Apple 預設風扇曲線。隨時可透過 `thermalforge auto` 釋放風扇控制。"
          }
        }
      }
    },
