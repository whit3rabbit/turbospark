          "stringUnit": {
            "state": "translated",
            "value": "Ongeldig token. Hugging Face heeft deze inloggegevens geweigerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawid\u0142owy token. Hugging Face odrzuci\u0142 te dane uwierzytelniaj\u0105ce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Token inv\u00e1lido. O Hugging Face rejeitou estas credenciais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0442\u043e\u043a\u0435\u043d. Hugging Face \u043e\u0442\u043a\u043b\u043e\u043d\u0438\u043b \u044d\u0442\u0438 \u0443\u0447\u0451\u0442\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogiltig token. Hugging Face avvisade de h\u00e4r inloggningsuppgifterna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7ersiz belirte\u00e7. Hugging Face bu kimlik bilgilerini reddetti."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0434\u0456\u0439\u0441\u043d\u0438\u0439 \u0442\u043e\u043a\u0435\u043d. Hugging Face \u0432\u0456\u0434\u0445\u0438\u043b\u0438\u0432 \u0446\u0456 \u043e\u0431\u043b\u0456\u043a\u043e\u0432\u0456 \u0434\u0430\u043d\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00e3 th\u00f4ng b\u00e1o kh\u00f4ng h\u1ee3p l\u1ec7. Hugging Face \u0111\u00e3 t\u1eeb ch\u1ed1i th\u00f4ng tin x\u00e1c th\u1ef1c n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee4\u724c\u65e0\u6548\u3002Hugging Face \u62d2\u7edd\u4e86\u8fd9\u4e9b\u51ed\u636e\u3002"
