            "state": "translated",
            "value": "TurboSpark '%@' öğesini değiştiremedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark не вдалося змінити '%@'."
          }
        },
        "vi": {
