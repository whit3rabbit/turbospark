    "User applies to every chat in the %@ profile. A project scope applies to that project only.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسري نطاق المستخدم على كل محادثة في الملف الشخصي %@. ويسري نطاق المشروع على ذلك المشروع فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Benutzer“ gilt für jeden Chat im Profil %@. Ein Projektbereich gilt nur für dieses Projekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "User applies to every chat in the %@ profile. A project scope applies to that project only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuario se aplica a todos los chats del perfil %@. Un ámbito de proyecto solo se aplica a ese proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisateur s’applique à toutes les discussions du profil %@. Une portée de projet ne s’applique qu’à ce projet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משתמש חל על כל צ'אט בפרופיל %@. היקף פרויקט חל על אותו פרויקט בלבד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उपयोगकर्ता %@ प्रोफ़ाइल की हर चैट पर लागू होता है। प्रोजेक्ट स्कोप केवल उसी प्रोजेक्ट पर लागू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengguna berlaku untuk setiap obrolan di profil %@. Cakupan proyek hanya berlaku untuk proyek tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utente si applica a ogni chat del profilo %@. Un ambito di progetto si applica solo a quel progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザーはプロファイル「%@」のすべてのチャットに適用されます。プロジェクトのスコープはそのプロジェクトにのみ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자는 %@ 프로필의 모든 대화에 적용됩니다. 프로젝트 범위는 해당 프로젝트에만 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruiker geldt voor elke chat in het profiel %@. Een projectbereik geldt alleen voor dat project."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użytkownik dotyczy każdego czatu w profilu %@. Zakres projektu dotyczy tylko tego projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuário se aplica a todos os chats do perfil %@. Um escopo de projeto se aplica somente a esse projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Пользователь» действует во всех чатах профиля %@. Область проекта действует только в этом проекте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användare gäller alla chattar i profilen %@. Ett projektomfång gäller bara det projektet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanıcı, %@ profilindeki her sohbete uygulanır. Proje kapsamı yalnızca o projeye uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Користувач» діє в усіх чатах профілю %@. Область проєкту діє лише в цьому проєкті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người dùng áp dụng cho mọi cuộc trò chuyện trong hồ sơ %@. Phạm vi dự án chỉ áp dụng cho dự án đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“用户”适用于 %@ 配置档案中的所有对话。项目范围仅适用于该项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「使用者」適用於 %@ 設定檔中的所有對話。專案範圍僅適用於該專案。"
          }
        }
      }
    },
