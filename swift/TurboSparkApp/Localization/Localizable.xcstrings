    "This checkpoint ships no reasoning knob, so a level would change nothing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This checkpoint ships no reasoning knob, so a level would change nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este checkpoint no incluye ningún control de razonamiento, así que un nivel no cambiaría nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce checkpoint ne fournit aucun réglage de raisonnement ; un niveau ne changerait donc rien."
