    "The selected profile Bookmarks file exceeds the size limit.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected profile Bookmarks file exceeds the size limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de marcadores del perfil seleccionado supera el límite de tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de favoris du profil sélectionné dépasse la limite de taille."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Lesezeichendatei des ausgewählten Profils überschreitet das Größenlimit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file dei segnalibri del profilo selezionato supera il limite di dimensione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de favoritos do perfil selecionado excede o limite de tamanho."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bladwijzerbestand van het geselecteerde profiel overschrijdt de maximale grootte."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bokmärkesfilen för den valda profilen överskrider storleksgränsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zakładek wybranego profilu przekracza limit rozmiaru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл закладок выбранного профиля превышает ограничение по размеру."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл закладок вибраного профілю перевищує обмеження за розміром."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçilen profilin Yer İmleri dosyası boyut sınırını aşıyor."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتجاوز ملف إشارات الملف الشخصي المحدد الحد المسموح للحجم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קובץ הסימניות של הפרופיל שנבחר חורג ממגבלת הגודל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चयनित प्रोफ़ाइल बुकमार्क फ़ाइल आकार सीमा से अधिक है।"
          }
        },
        "zh-Hans": {
