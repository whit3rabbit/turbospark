    "Stored token removed, but another token is still in effect (environment variable or Hugging Face CLI cache).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمت إزالة الرمز المخزن، لكن رمزًا آخر لا يزال ساريًا (متغير بيئة أو ذاكرة Hugging Face CLI المؤقتة)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeichertes Token entfernt, aber ein anderes Token ist noch aktiv (Umgebungsvariable oder Hugging Face CLI-Cache)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored token removed, but another token is still in effect (environment variable or Hugging Face CLI cache)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminó el token guardado, pero otro token sigue activo (variable de entorno o caché de la CLI de Hugging Face)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton enregistré supprimé, mais un autre jeton reste actif (variable d'environnement ou cache de la CLI Hugging Face)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האסימון השמור הוסר, אך אסימון אחר עדיין בתוקף (משתנה סביבה או מטמון של Hugging Face CLI)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजा गया टोकन हटाया गया, लेकिन दूसरा टोकन अभी भी लागू है (एनवायरनमेंट वेरिएबल या Hugging Face CLI कैश)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token tersimpan dihapus, tetapi token lain masih berlaku (variabel lingkungan atau cache Hugging Face CLI)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token salvato rimosso, ma un altro token è ancora attivo (variabile d'ambiente o cache della CLI di Hugging Face)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存したトークンを削除しましたが、別のトークンがまだ有効です（環境変数またはHugging Face CLIのキャッシュ）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 토큰을 제거했지만 다른 토큰이 여전히 적용 중입니다(환경 변수 또는 Hugging Face CLI 캐시)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen token verwijderd, maar er is nog een ander token actief (omgevingsvariabele of Hugging Face CLI-cache)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięto zapisany token, ale nadal działa inny token (zmienna środowiskowa lub pamięć podręczna Hugging Face CLI)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Token salvo removido, mas outro token ainda está em vigor (variável de ambiente ou cache da CLI do Hugging Face)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый токен удалён, но действует другой токен (переменная окружения или кэш Hugging Face CLI)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
