    "Backup import failed: the profile name is no longer available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u0634\u0644 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629: \u0627\u0633\u0645 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0644\u0645 \u064a\u0639\u062f \u0645\u062a\u0627\u062d\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup-Import fehlgeschlagen: Der Profilname ist nicht mehr verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup import failed: the profile name is no longer available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error al importar la copia de seguridad: el nombre del perfil ya no est\u00e1 disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9chec de l'importation de la sauvegarde : le nom du profil n'est plus disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05d9\u05d1\u05d5\u05d0 \u05d4\u05d2\u05d9\u05d1\u05d5\u05d9 \u05e0\u05db\u05e9\u05dc: \u05e9\u05dd \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05db\u05d1\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05d6\u05de\u05d9\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0948\u0915\u0905\u092a \u0906\u092f\u093e\u0924 \u0935\u093f\u092b\u0932: \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0928\u093e\u092e \u0905\u092c \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor cadangan gagal: nama profil tidak lagi tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importazione del backup non riuscita: il nome del profilo non \u00e8 pi\u00f9 disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306e\u30a4\u30f3\u30dd\u30fc\u30c8\u306b\u5931\u6557\u3057\u307e\u3057\u305f: \u3053\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u540d\u306f\u4f7f\u7528\u3067\u304d\u306a\u304f\u306a\u308a\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc31\uc5c5 \uac00\uc838\uc624\uae30 \uc2e4\ud328: \ud504\ub85c\ud544 \uc774\ub984\uc744 \ub354 \uc774\uc0c1 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeren van back-up mislukt: de profielnaam is niet meer beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Import kopii zapasowej nie powi\u00f3d\u0142 si\u0119: nazwa profilu nie jest ju\u017c dost\u0119pna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao importar o backup: o nome do perfil n\u00e3o est\u00e1 mais dispon\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443\u044e \u043a\u043e\u043f\u0438\u044e: \u0438\u043c\u044f \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att importera s\u00e4kerhetskopian: profilnamnet \u00e4r inte l\u00e4ngre tillg\u00e4ngligt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek i\u00e7e aktar\u0131lamad\u0131: Profil ad\u0131 art\u0131k kullan\u0131lam\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u0432\u0430\u0442\u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443 \u043a\u043e\u043f\u0456\u044e: \u0456\u043c'\u044f \u043f\u0440\u043e\u0444\u0456\u043b\u044e \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1eadp b\u1ea3n sao l\u01b0u th\u1ea5t b\u1ea1i: t\u00ean h\u1ed3 s\u01a1 kh\u00f4ng c\u00f2n kh\u1ea3 d\u1ee5ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5907\u4efd\u5bfc\u5165\u5931\u8d25\uff1a\u8be5\u914d\u7f6e\u6863\u6848\u540d\u79f0\u5df2\u4e0d\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5099\u4efd\u532f\u5165\u5931\u6557\uff1a\u8a72\u8a2d\u5b9a\u6a94\u540d\u7a31\u5df2\u7121\u6cd5\u4f7f\u7528\u3002"
          }
        }
      }
    },
