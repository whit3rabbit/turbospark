          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przykładowy tekst interfejsu z aktywnym stylem, kontrastem i kolorami akcentu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de interface de exemplo com o estilo, o contraste e as cores de destaque ativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Образец текста интерфейса с активным оформлением, контрастом и акцентными цветами."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
