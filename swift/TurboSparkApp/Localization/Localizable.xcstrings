            "value": "\u0644\u0645 \u064a\u0639\u062f \u0645\u0644\u0641 Chrome \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0645\u062d\u062f\u062f \u0645\u062a\u0627\u062d\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgew\u00e4hlte Chrome-Profil ist nicht mehr verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected Chrome profile is no longer available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil de Chrome seleccionado ya no est\u00e1 disponible."
