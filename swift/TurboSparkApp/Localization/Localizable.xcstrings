    "Cannot delete while audio is active or recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot delete while audio is active or recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede eliminar mientras el audio está activo o grabando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de supprimer pendant que l'audio est actif ou en cours d'enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löschen nicht möglich, während Audio aktiv ist oder aufgenommen wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile eliminare mentre l'audio è attivo o in registrazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível excluir enquanto o áudio estiver ativo ou gravando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan niet verwijderen terwijl audio actief is of opneemt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte radera medan ljud är aktivt eller spelas in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można usunąć, gdy dźwięk jest aktywny lub trwa nagrywanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно удалить, пока аудио активно или идет запись."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо видалити, поки аудіо активне або йде запис."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses aktifken veya kayıt yapılırken silinemez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن الحذف أثناء تشغيل الصوت أو التسجيل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן למחוק כאשר השמע פעיל או מוקלט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो सक्रिय या रिकॉर्डिंग के दौरान हटाया नहीं जा सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频处于活动状态或正在录制时无法删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊處於活動狀態或正在錄製時無法刪除。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声がアクティブまたは録音中のため削除できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오가 활성화되어 있거나 녹음 중일 때는 삭제할 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xóa khi âm thanh đang hoạt động hoặc đang ghi âm."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menghapus saat audio aktif atau sedang merekam."
          }
        }
      }
    },
    "Cannot change model while audio is active or recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot change model while audio is active or recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede cambiar de modelo mientras el audio está activo o grabando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de changer de modèle pendant que l'audio est actif ou en cours d'enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell kann nicht gewechselt werden, während Audio aktiv ist oder aufgenommen wird."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile cambiare modello mentre l'audio è attivo o in registrazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível alterar o modelo enquanto o áudio estiver ativo ou gravando."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan model niet wijzigen terwijl audio actief is of opneemt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte byta modell medan ljud är aktivt eller spelas in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zmienić modelu, gdy dźwięk jest aktywny lub trwa nagrywanie."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно изменить модель, пока аудио активно или идет запись."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо змінити модель, поки аудіо активне або йде запис."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses aktifken veya kayıt yapılırken model değiştirilemez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير النموذج أثناء تشغيل الصوت أو التسجيل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשנות מודל כאשר השמע פעיל או מוקלט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो सक्रिय या रिकॉर्डिंग के दौरान मॉडल बदला नहीं जा सकता।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频处于活动状态或正在录制时无法更改模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊處於活動狀態或正在錄製時無法變更模型。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声がアクティブまたは録音中のためモデルを変更できません。"
          }
        },
        "ko": {
          "stringUnit": {
