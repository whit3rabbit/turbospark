    "Check the live AGENTS.md, CLAUDE.md, CONTEXT.md, and SOUL.md files for this project": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0644\u0641\u0627\u062a AGENTS.md \u0648CLAUDE.md \u0648CONTEXT.md \u0648SOUL.md \u0627\u0644\u062d\u064a\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuellen Dateien AGENTS.md, CLAUDE.md, CONTEXT.md und SOUL.md dieses Projekts pr\u00fcfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check the live AGENTS.md, CLAUDE.md, CONTEXT.md, and SOUL.md files for this project"
