        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada profil yang dapat dijalankan untuk operasi ini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u044d\u0442\u043e\u0439 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442 \u043f\u0440\u043e\u0444\u0438\u043b\u044f, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0446\u0456\u0454\u0457 \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0457 \u043f\u043e\u043a\u0438 \u043d\u0435\u043c\u0430\u0454 \u043f\u0440\u043e\u0444\u0456\u043b\u044e, \u044f\u043a\u0438\u0439 \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u1ec7n ch\u01b0a c\u00f3 c\u1ea5u h\u00ecnh c\u00f3 th\u1ec3 ch\u1ea1y cho thao t\u00e1c n\u00e0y."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u64cd\u4f5c\u3067\u5b9f\u884c\u3067\u304d\u308b\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306f\u307e\u3060\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc791\uc5c5\uc5d0 \uc2e4\ud589 \uac00\ub2a5\ud55c \ud504\ub85c\ud544\uc774 \uc544\uc9c1 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u64cd\u4f5c\u5c1a\u65e0\u53ef\u8fd0\u884c\u7684\u914d\u7f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u64cd\u4f5c\u5c1a\u7121\u53ef\u57f7\u884c\u7684\u8a2d\u5b9a\u6a94\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u062a\u0648\u0641\u0631 \u0628\u0639\u062f \u0645\u0644\u0641 \u0625\u0639\u062f\u0627\u062f \u0642\u0627\u0628\u0644 \u0644\u0644\u062a\u0634\u063a\u064a\u0644 \u0644\u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d3\u05d9\u05d9\u05df \u05d0\u05d9\u05df \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e8\u05d9\u05e5 \u05dc\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u0915\u0947 \u0932\u093f\u090f \u0905\u092d\u0940 \u0915\u094b\u0908 \u091a\u0932\u093e\u0928\u0947 \u092f\u094b\u0917\u094d\u092f \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
