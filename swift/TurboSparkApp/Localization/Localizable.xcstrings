    "Import agents from other agent tools": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0645\u0646 \u0623\u062f\u0648\u0627\u062a \u0648\u0643\u0644\u0627\u0621 \u0623\u062e\u0631\u0649"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten aus anderen Agent-Tools importieren"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import agents from other agent tools"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar agentes de otras herramientas de agentes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer des agents depuis d\u2019autres outils d\u2019agents"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05d9\u05d1\u05d5\u05d0 \u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05de\u05db\u05dc\u05d9 \u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0928\u094d\u092f \u090f\u091c\u0947\u0902\u091f \u091f\u0942\u0932 \u0938\u0947 \u090f\u091c\u0947\u0902\u091f \u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor agen dari alat agen lain"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa agenti da altri strumenti per agenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u30c4\u30fc\u30eb\u304b\u3089\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3092\u8aad\u307f\u8fbc\u3080"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\ub978 \uc5d0\uc774\uc804\ud2b8 \ub3c4\uad6c\uc5d0\uc11c \uc5d0\uc774\uc804\ud2b8 \uac00\uc838\uc624\uae30"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agenten importeren uit andere agent-tools"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj agent\u00f3w z innych narz\u0119dzi agent\u00f3w"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
