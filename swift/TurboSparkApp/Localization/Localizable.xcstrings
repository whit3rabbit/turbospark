    "Switch takes while keeping the playback position.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch takes while keeping the playback position."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia de toma conservando la posici\u00f3n de reproducci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Changez de prise en conservant la position de lecture."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechsle Takes und behalte die Wiedergabeposition bei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia take mantenendo la posizione di riproduzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterne entre tomadas mantendo a posi\u00e7\u00e3o de reprodu\u00e7\u00e3o."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wissel tussen takes met behoud van de afspeelpositie."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Byt tagning och beh\u00e5ll uppspelningspositionen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prze\u0142\u0105czaj wersje, zachowuj\u0105c pozycj\u0119 odtwarzania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynatma konumunu koruyarak \u00e7ekimler aras\u0131nda ge\u00e7i\u015f yap\u0131n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganti take sambil mempertahankan posisi pemutaran."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0439\u0442\u0435 \u0434\u0443\u0431\u043b\u0438, \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044f \u043f\u043e\u0437\u0438\u0446\u0438\u044e \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0439\u0442\u0435 \u0434\u0443\u0431\u043b\u0456, \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0447\u0438 \u043f\u043e\u0437\u0438\u0446\u0456\u044e \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuy\u1ec3n l\u01b0\u1ee3t thu trong khi gi\u1eef nguy\u00ean v\u1ecb tr\u00ed ph\u00e1t."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u518d\u751f\u4f4d\u7f6e\u3092\u7dad\u6301\u3057\u305f\u307e\u307e\u30c6\u30a4\u30af\u3092\u5207\u308a\u66ff\u3048\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7ac\uc0dd \uc704\uce58\ub97c \uc720\uc9c0\ud558\uba74\uc11c \ud14c\uc774\ud06c\ub97c \uc804\ud658\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4fdd\u6301\u64ad\u653e\u4f4d\u7f6e\u7684\u540c\u65f6\u5207\u6362\u7248\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4fdd\u7559\u64ad\u653e\u4f4d\u7f6e\u7684\u540c\u6642\u5207\u63db\u7248\u672c\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u062f\u0651\u0644 \u0628\u064a\u0646 \u0627\u0644\u0646\u0633\u062e \u0645\u0639 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0645\u0648\u0636\u0639 \u0627\u0644\u062a\u0634\u063a\u064a\u0644."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d7\u05dc\u05e3 \u05d8\u05d9\u05d9\u05e7\u05d9\u05dd \u05ea\u05d5\u05da \u05e9\u05de\u05d9\u05e8\u05d4 \u05e2\u05dc \u05de\u05d9\u05e7\u05d5\u05dd \u05d4\u05e0\u05d9\u05d2\u05d5\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0932\u0947\u092c\u0948\u0915 \u0938\u094d\u0925\u093e\u0928 \u092c\u0928\u093e\u090f \u0930\u0916\u0924\u0947 \u0939\u0941\u090f \u091f\u0947\u0915 \u092c\u0926\u0932\u0947\u0902\u0964"
          }
        }
      }
    },
