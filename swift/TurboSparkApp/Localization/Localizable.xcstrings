    "e.g. Knowledge graph and symbol search": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062b\u0644: \u0627\u0644\u0631\u0633\u0645 \u0627\u0644\u0645\u0639\u0631\u0641\u064a \u0648\u0627\u0644\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0631\u0645\u0648\u0632"
