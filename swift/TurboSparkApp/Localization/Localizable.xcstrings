            "value": "System control for global shortcuts and automation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Control del sistema para atajos globales y automatizaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contr\u00f4le du syst\u00e8me pour les raccourcis globaux et l'automatisation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05dc\u05d9\u05d8\u05d4 \u05d1\u05de\u05e2\u05e8\u05db\u05ea \u05e2\u05d1\u05d5\u05e8 \u05e7\u05d9\u05e6\u05d5\u05e8\u05d9 \u05d3\u05e8\u05da \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05d9\u05dd \u05d5\u05d0\u05d5\u05d8\u05d5\u05de\u05e6\u05d9\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u094d\u0932\u094b\u092c\u0932 \u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0914\u0930 \u0911\u091f\u094b\u092e\u0947\u0936\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u093f\u0938\u094d\u091f\u092e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol sistem untuk pintasan global dan otomatisasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllo del sistema per scorciatoie globali e automazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b0\u30ed\u30fc\u30d0\u30eb\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u3068\u81ea\u52d5\u5316\u306e\u305f\u3081\u306e\u30b7\u30b9\u30c6\u30e0\u5236\u5fa1\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc804\uc5ed \ub2e8\ucd95\ud0a4\uc640 \uc790\ub3d9\ud654\ub97c \uc704\ud55c \uc2dc\uc2a4\ud15c \uc81c\uc5b4\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeembediening voor algemene sneltoetsen en automatisering."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterowanie systemem dla globalnych skr\u00f3t\u00f3w i automatyzacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Controle do sistema para atalhos globais e automa\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u0439 \u0434\u043b\u044f \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u044b\u0445 \u0441\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u0439 \u043a\u043b\u0430\u0432\u0438\u0448 \u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0438\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemstyrning f\u00f6r globala kortkommandon och automatisering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel k\u0131sayollar ve otomasyon i\u00e7in sistem denetimi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0438\u0441\u0442\u0435\u043c\u043e\u044e \u0434\u043b\u044f \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0438\u0445 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u044c \u0456 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0456\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110i\u1ec1u khi\u1ec3n h\u1ec7 th\u1ed1ng cho ph\u00edm t\u1eaft to\u00e0n c\u1ee5c v\u00e0 t\u1ef1 \u0111\u1ed9ng h\u00f3a."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u4e8e\u5168\u5c40\u5feb\u6377\u952e\u548c\u81ea\u52a8\u5316\u7684\u7cfb\u7edf\u63a7\u5236\u3002"
          }
        },
        "zh-Hant": {
