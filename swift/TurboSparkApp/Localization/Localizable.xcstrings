    "Guardrails unknown (restart the server to report it)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u0627\u0644\u0629 \u0627\u0644\u062d\u0648\u0627\u062c\u0632 \u0627\u0644\u0648\u0642\u0627\u0626\u064a\u0629 \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629 (\u0623\u0639\u062f \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062e\u0627\u062f\u0645 \u0644\u0639\u0631\u0636\u0647\u0627)"
