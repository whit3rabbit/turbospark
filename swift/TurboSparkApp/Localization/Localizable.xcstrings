    "SOUL.md is disabled. Imports stay available and take effect when enabled.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md معطل. تبقى عمليات الاستيراد متاحة وتسري عند التفعيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md ist deaktiviert. Importe bleiben verfügbar und wirken, sobald es aktiviert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md is disabled. Imports stay available and take effect when enabled."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md está desactivado. Las importaciones siguen disponibles y surten efecto al activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md est désactivé. Les importations restent disponibles et s'appliquent une fois activé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md מושבת. הייבוא נשאר זמין ונכנס לתוקף כשהוא מופעל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md बंद है। आयात उपलब्ध रहते हैं और चालू करने पर लागू होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md dinonaktifkan. Impor tetap tersedia dan berlaku saat diaktifkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md è disattivato. Le importazioni restano disponibili e hanno effetto quando lo attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.mdは無効です。読み込みは引き続き利用でき、有効にすると反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md가 꺼져 있습니다. 가져오기는 계속 사용할 수 있으며 켜면 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md is uitgeschakeld. Imports blijven beschikbaar en worden actief zodra het is ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md jest wyłączony. Importy pozostają dostępne i zaczną działać po włączeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O SOUL.md está desativado. As importações continuam disponíveis e entram em vigor quando ele for ativado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md отключён. Импорт остаётся доступным и вступит в силу после включения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md är avstängt. Importer förblir tillgängliga och börjar gälla när det slås på."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md devre dışı. İçe aktarmalar kullanılabilir kalır ve etkinleştirildiğinde geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md вимкнено. Імпорт залишається доступним і почне діяти після ввімкнення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md đang tắt. Các bản nhập vẫn dùng được và sẽ có hiệu lực khi bật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md 已停用。导入仍可用，并会在启用后生效。"
          }
        },
        "zh-Hant": {
