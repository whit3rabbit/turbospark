    "Comma-separated start:end layer range; blank means all layers": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0637\u0627\u0642 \u0637\u0628\u0642\u0627\u062a \u0628\u0635\u064a\u063a\u0629 \u0627\u0644\u0628\u062f\u0627\u064a\u0629:\u0627\u0644\u0646\u0647\u0627\u064a\u0629 \u0645\u0641\u0635\u0648\u0644 \u0628\u0641\u0648\u0627\u0635\u0644\u061b \u0627\u0644\u0641\u0631\u0627\u063a \u064a\u0639\u0646\u064a \u0643\u0644 \u0627\u0644\u0637\u0628\u0642\u0627\u062a"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Kommas getrennter Schichtbereich Start:Ende; leer bedeutet alle Schichten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma-separated start:end layer range; blank means all layers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rango de capas inicio:fin separado por comas; en blanco significa todas las capas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plage de couches d\u00e9but:fin s\u00e9par\u00e9e par des virgules ; vide signifie toutes les couches"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05d5\u05d5\u05d7 \u05e9\u05db\u05d1\u05d5\u05ea \u05d4\u05ea\u05d7\u05dc\u05d4:\u05e1\u05d9\u05d5\u05dd \u05de\u05d5\u05e4\u05e8\u05d3 \u05d1\u05e4\u05e1\u05d9\u05e7\u05d9\u05dd; \u05e8\u05d9\u05e7 \u05e4\u05d9\u05e8\u05d5\u05e9\u05d5 \u05db\u05dc \u05d4\u05e9\u05db\u05d1\u05d5\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0932\u094d\u092a\u0935\u093f\u0930\u093e\u092e \u0938\u0947 \u0905\u0932\u0917 \u092a\u094d\u0930\u093e\u0930\u0902\u092d:\u0905\u0902\u0924 \u092a\u0930\u0924 \u0938\u0940\u092e\u093e; \u0916\u093e\u0932\u0940 \u0939\u094b\u0928\u0947 \u0915\u093e \u0905\u0930\u094d\u0925 \u0939\u0948 \u0938\u092d\u0940 \u092a\u0930\u0924\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rentang lapisan mulai:selesai yang dipisahkan koma; kosong berarti semua lapisan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervallo di livelli inizio:fine separato da virgole; vuoto significa tutti i livelli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ab\u30f3\u30de\u533a\u5207\u308a\u306e \u958b\u59cb:\u7d42\u4e86 \u30ec\u30a4\u30e4\u30fc\u7bc4\u56f2\u3002\u7a7a\u6b04\u306f\u3059\u3079\u3066\u306e\u30ec\u30a4\u30e4\u30fc"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc27c\ud45c\ub85c \uad6c\ubd84\ud55c \uc2dc\uc791:\ub05d \ub808\uc774\uc5b4 \ubc94\uc704. \ube44\uc6b0\uba74 \ubaa8\ub4e0 \ub808\uc774\uc5b4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door komma's gescheiden laagbereik start:einde; leeg betekent alle lagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakres warstw pocz\u0105tek:koniec rozdzielony przecinkami; puste oznacza wszystkie warstwy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Intervalo de camadas in\u00edcio:fim separado por v\u00edrgulas; vazio significa todas as camadas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0441\u043b\u043e\u0435\u0432 \u043d\u0430\u0447\u0430\u043b\u043e:\u043a\u043e\u043d\u0435\u0446 \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043f\u044f\u0442\u0443\u044e; \u043f\u0443\u0441\u0442\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0435\u0442 \u0432\u0441\u0435 \u0441\u043b\u043e\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommaavgr\u00e4nsat lagerintervall start:slut; tomt betyder alla lager"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Virg\u00fclle ayr\u0131lm\u0131\u015f ba\u015flang\u0131\u00e7:biti\u015f katman aral\u0131\u011f\u0131; bo\u015f, t\u00fcm katmanlar demektir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0456\u0430\u043f\u0430\u0437\u043e\u043d \u0448\u0430\u0440\u0456\u0432 \u043f\u043e\u0447\u0430\u0442\u043e\u043a:\u043a\u0456\u043d\u0435\u0446\u044c \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u043c\u0443; \u043f\u043e\u0440\u043e\u0436\u043d\u044c\u043e \u043e\u0437\u043d\u0430\u0447\u0430\u0454 \u0432\u0441\u0456 \u0448\u0430\u0440\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ph\u1ea1m vi l\u1edbp b\u1eaft \u0111\u1ea7u:k\u1ebft th\u00fac ph\u00e2n t\u00e1ch b\u1eb1ng d\u1ea5u ph\u1ea9y; \u0111\u1ec3 tr\u1ed1ng ngh\u0129a l\u00e0 t\u1ea5t c\u1ea3 c\u00e1c l\u1edbp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee5\u9017\u53f7\u5206\u9694\u7684 \u8d77\u59cb:\u7ed3\u675f \u5c42\u8303\u56f4\uff1b\u7559\u7a7a\u8868\u793a\u6240\u6709\u5c42"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee5\u9017\u865f\u5206\u9694\u7684 \u8d77\u59cb:\u7d50\u675f \u5c64\u7bc4\u570d\uff1b\u7559\u7a7a\u8868\u793a\u6240\u6709\u5c64"
          }
        }
      }
    },
    "Comma-separated strings that stop generation when produced": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u0644\u0627\u0633\u0644 \u0645\u0641\u0635\u0648\u0644\u0629 \u0628\u0641\u0648\u0627\u0635\u0644 \u062a\u0648\u0642\u0641 \u0627\u0644\u062a\u0648\u0644\u064a\u062f \u0639\u0646\u062f \u0625\u0646\u062a\u0627\u062c\u0647\u0627"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Kommas getrennte Zeichenfolgen, die die Generierung beenden, sobald sie erzeugt werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comma-separated strings that stop generation when produced"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadenas separadas por comas que detienen la generaci\u00f3n cuando se producen"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cha\u00eenes s\u00e9par\u00e9es par des virgules qui arr\u00eatent la g\u00e9n\u00e9ration lorsqu'elles sont produites"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d7\u05e8\u05d5\u05d6\u05d5\u05ea \u05de\u05d5\u05e4\u05e8\u05d3\u05d5\u05ea \u05d1\u05e4\u05e1\u05d9\u05e7\u05d9\u05dd \u05e9\u05e2\u05d5\u05e6\u05e8\u05d5\u05ea \u05d0\u05ea \u05d4\u05d9\u05e6\u05d9\u05e8\u05d4 \u05db\u05e9\u05d4\u05df \u05de\u05d5\u05e4\u05e7\u05d5\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0932\u094d\u092a\u0935\u093f\u0930\u093e\u092e \u0938\u0947 \u0905\u0932\u0917 \u0938\u094d\u091f\u094d\u0930\u093f\u0902\u0917 \u091c\u094b \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0939\u094b\u0928\u0947 \u092a\u0930 \u091c\u0928\u0930\u0947\u0936\u0928 \u0930\u094b\u0915 \u0926\u0947\u0924\u0940 \u0939\u0948\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "String yang dipisahkan koma yang menghentikan pembuatan saat dihasilkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stringhe separate da virgole che interrompono la generazione quando vengono prodotte"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u3055\u308c\u308b\u3068\u51fa\u529b\u3092\u505c\u6b62\u3059\u308b\u3001\u30ab\u30f3\u30de\u533a\u5207\u308a\u306e\u6587\u5b57\u5217"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\uc131\ub418\uba74 \uc0dd\uc131\uc744 \uc911\uc9c0\ud558\ub294 \uc27c\ud45c\ub85c \uad6c\ubd84\ub41c \ubb38\uc790\uc5f4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Door komma's gescheiden tekenreeksen die het genereren stoppen zodra ze worden geproduceerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci\u0105gi rozdzielone przecinkami, kt\u00f3re zatrzymuj\u0105 generowanie, gdy si\u0119 pojawi\u0105"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Strings separadas por v\u00edrgula que interrompem a gera\u00e7\u00e3o quando produzidas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0440\u043e\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 \u0437\u0430\u043f\u044f\u0442\u0443\u044e, \u043f\u0440\u0438 \u043f\u043e\u044f\u0432\u043b\u0435\u043d\u0438\u0438 \u043a\u043e\u0442\u043e\u0440\u044b\u0445 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u043e\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442\u0441\u044f"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommaavgr\u00e4nsade str\u00e4ngar som stoppar genereringen n\u00e4r de skapas"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00dcretildi\u011finde \u00fcretimi durduran, virg\u00fclle ayr\u0131lm\u0131\u015f dizeler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u044f\u0434\u043a\u0438 \u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u043c\u0443, \u043f\u043e\u044f\u0432\u0430 \u044f\u043a\u0438\u0445 \u0437\u0443\u043f\u0438\u043d\u044f\u0454 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u044e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c chu\u1ed7i ph\u00e2n t\u00e1ch b\u1eb1ng d\u1ea5u ph\u1ea9y s\u1ebd d\u1eebng vi\u1ec7c t\u1ea1o khi xu\u1ea5t hi\u1ec7n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee5\u9017\u53f7\u5206\u9694\u7684\u5b57\u7b26\u4e32\uff0c\u751f\u6210\u5230\u8fd9\u4e9b\u5185\u5bb9\u65f6\u505c\u6b62\u751f\u6210"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee5\u9017\u865f\u5206\u9694\u7684\u5b57\u4e32\uff0c\u7522\u751f\u9019\u4e9b\u5167\u5bb9\u6642\u505c\u6b62\u751f\u6210"
          }
        }
      }
    },
