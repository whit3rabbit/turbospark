    "One per line as old -> new. Applied to the rewrite after the model's own checks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per line as old -> new. Applied to the rewrite after the model's own checks."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0648\u0627\u062d\u062f \u0641\u064a \u0643\u0644 \u0633\u0637\u0631 \u0628\u0635\u064a\u063a\u0629 \u0642\u062f\u064a\u0645 -> \u062c\u062f\u064a\u062f. \u064a\u064f\u0637\u0628\u064e\u0651\u0642 \u0639\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0635\u064a\u0627\u063a\u0629 \u0628\u0639\u062f \u0641\u062d\u0648\u0635\u0627\u062a \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0646\u0641\u0633\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine pro Zeile als alt -> neu. Wird nach den eigenen Pr\u00fcfungen des Modells auf die Umschreibung angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una por l\u00ednea como antiguo -> nuevo. Se aplica a la reescritura despu\u00e9s de las comprobaciones del propio modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une par ligne sous la forme ancien -> nouveau. Appliqu\u00e9 \u00e0 la r\u00e9\u00e9criture apr\u00e8s les v\u00e9rifications du mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d7\u05ea \u05d1\u05db\u05dc \u05e9\u05d5\u05e8\u05d4 \u05d1\u05ea\u05d1\u05e0\u05d9\u05ea \u05d9\u05e9\u05df -> \u05d7\u05d3\u05e9. \u05de\u05d5\u05d7\u05dc \u05e2\u05dc \u05d4\u05e9\u05db\u05ea\u05d5\u05d1 \u05d0\u05d7\u05e8\u05d9 \u05d4\u05d1\u05d3\u05d9\u05e7\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05dc \u05e2\u05e6\u05de\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u092a\u0902\u0915\u094d\u0924\u093f \u092e\u0947\u0902 \u090f\u0915, \u092a\u0941\u0930\u093e\u0928\u093e -> \u0928\u092f\u093e \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902\u0964 \u092e\u0949\u0921\u0932 \u0915\u0940 \u0905\u092a\u0928\u0940 \u091c\u093e\u0901\u091a \u0915\u0947 \u092c\u093e\u0926 \u092a\u0941\u0928\u0930\u094d\u0932\u0947\u0916\u0928 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu per baris sebagai lama -> baru. Diterapkan ke hasil tulis ulang setelah pemeriksaan model sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una per riga come vecchio -> nuovo. Applicate alla riscrittura dopo i controlli del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \u884c\u306b 1 \u3064\u305a\u3064\u300c\u65e7 -> \u65b0\u300d\u306e\u5f62\u5f0f\u3067\u8a18\u5165\u3057\u307e\u3059\u3002\u30e2\u30c7\u30eb\u81ea\u8eab\u306e\u30c1\u30a7\u30c3\u30af\u306e\u5f8c\u306b\u66f8\u304d\u76f4\u3057\u3078\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud55c \uc904\uc5d0 \ud558\ub098\uc529 \uc774\uc804 -> \uc0c8 \ud615\uc2dd\uc73c\ub85c \uc785\ub825\ud569\ub2c8\ub2e4. \ubaa8\ub378 \uc790\uccb4 \uac80\uc0ac \ud6c4 \ub2e4\uc2dc \uc4f4 \uae00\uc5d0 \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u00e9n per regel als oud -> nieuw. Toegepast op de herschrijving na de eigen controles van het model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna w wierszu w formacie stare -> nowe. Stosowane do przepisanego tekstu po w\u0142asnych kontrolach modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma por linha no formato antigo -> novo. Aplicada \u00e0 reescrita depois das verifica\u00e7\u00f5es do pr\u00f3prio modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e \u043e\u0434\u043d\u043e\u0439 \u043d\u0430 \u0441\u0442\u0440\u043e\u043a\u0443 \u0432 \u0432\u0438\u0434\u0435 \u0441\u0442\u0430\u0440\u043e\u0435 -> \u043d\u043e\u0432\u043e\u0435. \u041f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043a \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043d\u043d\u043e\u043c\u0443 \u0442\u0435\u043a\u0441\u0442\u0443 \u043f\u043e\u0441\u043b\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u043e\u043a \u0441\u0430\u043c\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En per rad som gammalt -> nytt. Till\u00e4mpas p\u00e5 omskrivningen efter modellens egna kontroller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sat\u0131ra bir tane, eski -> yeni bi\u00e7iminde. Modelin kendi denetimlerinden sonra yeniden yaz\u0131ma uygulan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e \u043e\u0434\u043d\u0456\u0439 \u0443 \u0440\u044f\u0434\u043a\u0443 \u0443 \u0432\u0438\u0433\u043b\u044f\u0434\u0456 \u0441\u0442\u0430\u0440\u0435 -> \u043d\u043e\u0432\u0435. \u0417\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043d\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0443 \u043f\u0456\u0441\u043b\u044f \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043e\u043a \u0441\u0430\u043c\u043e\u0457 \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed7i d\u00f2ng m\u1ed9t c\u1eb7p d\u1ea1ng c\u0169 -> m\u1edbi. \u00c1p d\u1ee5ng cho b\u1ea3n vi\u1ebft l\u1ea1i sau khi m\u00f4 h\u00ecnh t\u1ef1 ki\u1ec3m tra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u884c\u4e00\u6761\uff0c\u683c\u5f0f\u4e3a \u65e7 -> \u65b0\u3002\u5728\u6a21\u578b\u81ea\u8eab\u68c0\u67e5\u4e4b\u540e\u5e94\u7528\u5230\u6539\u5199\u7ed3\u679c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u884c\u4e00\u689d\uff0c\u683c\u5f0f\u70ba \u820a -> \u65b0\u3002\u5728\u6a21\u578b\u81ea\u8eab\u6aa2\u67e5\u4e4b\u5f8c\u5957\u7528\u5230\u6539\u5beb\u7d50\u679c\u3002"
          }
        }
      }
    },
