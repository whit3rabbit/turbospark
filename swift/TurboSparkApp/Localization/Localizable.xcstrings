          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden het concept en de herschrijving verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie wersji roboczej i przepisanego tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o rascunho e a reescrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это удалит черновик и переписанный текст."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar bort utkastet och omskrivningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem taslağı ve yeniden yazımı kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це видалить чернетку та переписаний текст."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa bản nháp và bản viết lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将移除草稿和改写结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這將移除草稿和改寫結果。"
          }
        }
      }
    },
    "This removes the item and its edits from your audio library. Files saved to other folders are kept.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يؤدي هذا إلى إزالة العنصر وتعديلاته من مكتبة الصوت. يتم الاحتفاظ بالملفات المحفوظة في مجلدات أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden das Element und seine Bearbeitungen aus deiner Audiobibliothek entfernt. In anderen Ordnern gespeicherte Dateien bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the item and its edits from your audio library. Files saved to other folders are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán el elemento y sus ediciones de tu biblioteca de audio. Se conservarán los archivos guardados en otras carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément et ses modifications seront supprimés de votre bibliothèque audio. Les fichiers enregistrés dans d'autres dossiers seront conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפריט והעריכות שלו יוסרו מספריית השמע שלך. קבצים שנשמרו בתיקיות אחרות יישמרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आइटम और उसके संपादन आपकी ऑडियो लाइब्रेरी से हटा देगा। अन्य फ़ोल्डरों में सहेजी गई फ़ाइलें बनी रहेंगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Item dan hasil editnya akan dihapus dari pustaka audio Anda. File yang disimpan di folder lain tetap disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’elemento e le sue modifiche verranno rimossi dalla libreria audio. I file salvati in altre cartelle verranno conservati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目と編集内容がオーディオライブラリから削除されます。他のフォルダに保存したファイルは保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 항목과 편집 내용이 오디오 라이브러리에서 삭제됩니다. 다른 폴더에 저장한 파일은 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit verwijdert het item en de bewerkingen uit je audiobibliotheek. Bestanden die in andere mappen zijn opgeslagen, blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element i jego zmiany zostaną usunięte z biblioteki audio. Pliki zapisane w innych folderach zostaną zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o item e suas edições da biblioteca de áudio. Os arquivos salvos em outras pastas são mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Элемент и его изменения будут удалены из аудиобиблиотеки. Файлы, сохранённые в других папках, останутся."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Objektet och dess ändringar tas bort från ditt ljudbibliotek. Filer som sparats i andra mappar behålls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe ve düzenlemeleri ses kitaplığınızdan kaldırılır. Diğer klasörlere kaydedilen dosyalar korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Елемент і його зміни буде видалено з аудіобібліотеки. Файли, збережені в інших папках, залишаться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này xóa mục và các chỉnh sửa khỏi thư viện âm thanh. Các tệp đã lưu vào thư mục khác vẫn được giữ lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从音频库中移除此项目及其编辑内容。保存在其他文件夹中的文件将被保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這會從音訊資料庫中移除此項目及其編輯內容。儲存在其他資料夾中的檔案會予以保留。"
          }
        }
      }
    },
    "This removes the model from this Mac. A mode that uses it moves to another installed model. Transcripts you made stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة النموذج من هذا الـ Mac. ينتقل أي وضع يستخدمه إلى نموذج مثبت آخر. تبقى النصوص التي أنشأتها كما هي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch wird das Modell von diesem Mac entfernt. Ein Modus, der es nutzt, wechselt zu einem anderen installierten Modell. Deine Transkripte bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the model from this Mac. A mode that uses it moves to another installed model. Transcripts you made stay as they are."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el modelo de este Mac. Un modo que lo use pasa a otro modelo instalado. Tus transcripciones se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle sera supprimé de ce Mac. Un mode qui l'utilise passera à un autre modèle installé. Vos transcriptions restent inchangées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו מסירה את המודל מה-Mac הזה. מצב שמשתמש בו יעבור למודל מותקן אחר. התמלולים שיצרת יישארו כפי שהם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह इस Mac से मॉडल हटा देता है। जो मोड इसका उपयोग करता है, वह किसी दूसरे स्थापित मॉडल पर चला जाता है। आपके बनाए ट्रांसक्रिप्ट जैसे हैं वैसे ही रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini menghapus model dari Mac ini. Mode yang memakainya beralih ke model terpasang lainnya. Transkrip yang sudah Anda buat tetap seperti semula."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello viene rimosso da questo Mac. Una modalità che lo usa passa a un altro modello installato. Le tue trascrizioni restano invariate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacからモデルを削除します。このモデルを使っているモードは、インストール済みの別のモデルに切り替わります。作成済みの文字起こしはそのまま残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에서 모델을 제거합니다. 이 모델을 사용하던 모드는 설치된 다른 모델로 바뀝니다. 만든 전사 내용은 그대로 유지됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee wordt het model van deze Mac verwijderd. Een modus die het gebruikt, schakelt over op een ander geïnstalleerd model. Je transcripten blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to usunięcie modelu z tego Maca. Tryb, który go używa, przejdzie na inny zainstalowany model. Twoje transkrypcje pozostaną bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso remove o modelo deste Mac. Um modo que o usa passa para outro modelo instalado. Suas transcrições continuam como estão."
