    "Put each section tag on its own line. Words on the same line as a tag are dropped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put each section tag on its own line. Words on the same line as a tag are dropped."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ضع كل وسم قسم في سطر مستقل. تُهمل الكلمات الموجودة في السطر نفسه مع الوسم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze jedes Abschnitts-Tag in eine eigene Zeile. Wörter in derselben Zeile wie ein Tag werden verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon cada etiqueta de sección en su propia línea. Las palabras en la misma línea que una etiqueta se descartan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez chaque balise de section sur sa propre ligne. Les mots situés sur la même ligne qu'une balise sont ignorés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצב כל תגית מקטע בשורה משלה. מילים באותה שורה עם תגית מושמטות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेक्शन टैग को अलग पंक्ति में रखें। टैग वाली पंक्ति में लिखे शब्द छोड़ दिए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan setiap tag bagian di barisnya sendiri. Kata di baris yang sama dengan tag akan dibuang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti ogni tag di sezione su una riga a sé. Le parole sulla stessa riga di un tag vengono scartate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "セクションタグはそれぞれ別の行に置いてください。タグと同じ行にある言葉は無視されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "섹션 태그는 각각 별도의 줄에 넣으세요. 태그와 같은 줄에 있는 단어는 무시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet elke sectietag op een eigen regel. Woorden op dezelfde regel als een tag worden genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umieść każdy znacznik sekcji w osobnej linii. Słowa w tej samej linii co znacznik są pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque cada tag de seção em sua própria linha. Palavras na mesma linha de uma tag são descartadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставьте каждый тег раздела на отдельной строке. Слова в одной строке с тегом отбрасываются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placera varje sektionstagg på en egen rad. Ord på samma rad som en tagg tas bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her bölüm etiketini kendi satırına koyun. Etiketle aynı satırdaki sözcükler yok sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ставте кожен тег розділу в окремому рядку. Слова в тому ж рядку, що й тег, відкидаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt mỗi thẻ phần trên một dòng riêng. Chữ cùng dòng với thẻ sẽ bị bỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个段落标签单独占一行。与标签在同一行的文字会被忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個段落標籤單獨一行。與標籤在同一行的文字會被忽略。"
          }
        }
      }
    },
