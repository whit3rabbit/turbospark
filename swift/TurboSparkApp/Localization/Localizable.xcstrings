          "stringUnit": {
            "state": "translated",
            "value": "Commencez une conversation pour voir l\u2019historique ici"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05d7\u05d9\u05dc\u05d5 \u05e9\u05d9\u05d7\u05d4 \u05db\u05d3\u05d9 \u05dc\u05e8\u05d0\u05d5\u05ea \u05db\u05d0\u05df \u05d0\u05ea \u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939\u093e\u0901 \u0907\u0924\u093f\u0939\u093e\u0938 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092c\u093e\u0924\u091a\u0940\u0924 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mulai percakapan untuk melihat riwayat di sini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia una conversazione per vedere qui la cronologia"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f1a\u8a71\u3092\u59cb\u3081\u308b\u3068\u5c65\u6b74\u304c\u3053\u3053\u306b\u8868\u793a\u3055\u308c\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub300\ud654\ub97c \uc2dc\uc791\ud558\uba74 \uc5ec\uae30\uc5d0 \uae30\ub85d\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Begin een gesprek om hier de geschiedenis te zien"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpocznij rozmow\u0119, aby zobaczy\u0107 tu histori\u0119"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie uma conversa para ver o hist\u00f3rico aqui"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0438\u0441\u0442\u043e\u0440\u0438\u044e \u0437\u0434\u0435\u0441\u044c"
