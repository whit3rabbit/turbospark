        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda n\u00e3o h\u00e1 nada para resumir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430 \u043d\u0435\u0447\u0435\u0433\u043e \u043f\u043e\u0434\u044b\u0442\u043e\u0436\u0438\u0432\u0430\u0442\u044c."
