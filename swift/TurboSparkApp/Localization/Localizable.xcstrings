    "Live text could not keep up. The full transcript appears when you stop.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على النص المباشر المواكبة. سيظهر النص الكامل عند الإيقاف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Live-Text kam nicht mit. Das vollständige Transkript erscheint, wenn Sie die Aufnahme beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live text could not keep up. The full transcript appears when you stop."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto en directo no pudo seguir el ritmo. La transcripción completa aparecerá al detener la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte en direct n'a pas pu suivre. La transcription complète apparaîtra à l'arrêt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט החי לא הצליח לעמוד בקצב. התמלול המלא יופיע כשתעצרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव टेक्स्ट साथ नहीं चल सका। रोकने पर पूरा ट्रांसक्रिप्ट दिखेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks langsung tidak dapat mengikuti. Transkrip lengkap muncul saat Anda berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo in diretta non è riuscito a tenere il passo. La trascrizione completa apparirà quando ti fermi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブテキストが追いつきませんでした。停止すると完全な文字起こしが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 텍스트가 따라가지 못했습니다. 중지하면 전체 전사본이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De live tekst kon het niet bijhouden. Het volledige transcript verschijnt wanneer je stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst na żywo nie nadążał. Pełna transkrypcja pojawi się po zatrzymaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto ao vivo não conseguiu acompanhar. A transcrição completa aparece quando você parar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст в реальном времени не успевал. Полная расшифровка появится после остановки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Livetexten hann inte med. Hela transkriptionen visas när du stoppar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı metin yetişemedi. Tam transkript durdurduğunuzda görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст наживо не встигав. Повна розшифровка з'явиться після зупинки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản trực tiếp không theo kịp. Bản chép lời đầy đủ sẽ xuất hiện khi bạn dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时文字跟不上。停止后将显示完整转写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時文字跟不上。停止後將顯示完整轉錄。"
          }
        }
      }
    },
    "Live text is a draft. Saved audio remains available when transcription falls behind.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live text is a draft. Saved audio remains available when transcription falls behind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto en directo es un borrador. El audio guardado sigue disponible si la transcripción se retrasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte en direct est un brouillon. L'audio enregistré reste disponible si la transcription prend du retard."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Live-Text ist ein Entwurf. Gespeichertes Audio bleibt verfügbar, wenn die Transkription zurückliegt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo in diretta è una bozza. L'audio salvato rimane disponibile se la trascrizione accumula ritardo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto ao vivo é um rascunho. O áudio salvo continua disponível quando a transcrição atrasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Livetekst is een concept. Opgeslagen audio blijft beschikbaar wanneer de transcriptie achterloopt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Livetext är ett utkast. Sparat ljud finns kvar om transkriptionen halkar efter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst na żywo jest wersją roboczą. Zapisany dźwięk pozostaje dostępny, gdy transkrypcja jest opóźniona."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı metin bir taslaktır. Transkripsiyon geciktiğinde kaydedilen ses kullanılabilir kalır."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks langsung adalah draf. Audio tersimpan tetap tersedia saat transkripsi tertinggal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст в реальном времени является черновиком. Сохранённое аудио остаётся доступным, если расшифровка отстаёт."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст наживо є чернеткою. Збережене аудіо залишається доступним, якщо розшифровка відстає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản trực tiếp là bản nháp. Âm thanh đã lưu vẫn có sẵn khi quá trình chép lời bị chậm."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブテキストは下書きです。文字起こしが遅れても、保存した音声は利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 텍스트는 초안입니다. 전사가 지연되어도 저장된 오디오는 계속 사용할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时文本是草稿。即使转录滞后，已保存的音频仍然可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時文字是草稿。即使轉錄落後，已儲存的音訊仍然可用。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النص المباشر مسودة. يظل الصوت المحفوظ متاحاً عندما يتأخر التفريغ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט חי הוא טיוטה. השמע השמור נותר זמין כאשר התמלול מתעכב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव टेक्स्ट एक ड्राफ़्ट है। ट्रांसक्रिप्शन पीछे रहने पर भी सहेजा गया ऑडियो उपलब्ध रहता है।"
          }
        }
      }
    },
