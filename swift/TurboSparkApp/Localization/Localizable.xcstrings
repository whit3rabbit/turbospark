          }
        }
      }
    },
    "Required on every route except /health, as x-api-key or a Bearer token. Stored in the Keychain, not settings.json.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0637\u0644\u0648\u0628 \u0641\u064a \u0643\u0644 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a \u0628\u0627\u0633\u062a\u062b\u0646\u0627\u0621 \u200e/health\u060c \u0628\u0635\u064a\u063a\u0629 x-api-key \u0623\u0648 \u0631\u0645\u0632 Bearer. \u064a\u064f\u062e\u0632\u0651\u0646 \u0641\u064a \u0633\u0644\u0633\u0644\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0648\u0644\u064a\u0633 \u0641\u064a settings.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf jeder Route au\u00dfer /health erforderlich, als x-api-key oder Bearer-Token. Wird im Schl\u00fcsselbund gespeichert, nicht in settings.json."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Required on every route except /health, as x-api-key or a Bearer token. Stored in the Keychain, not settings.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obligatoria en todas las rutas excepto /health, como x-api-key o token Bearer. Se guarda en el Llavero, no en settings.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Requise sur toutes les routes sauf /health, en x-api-key ou jeton Bearer. Stock\u00e9e dans le trousseau, pas dans settings.json."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d3\u05e8\u05e9 \u05d1\u05db\u05dc \u05e0\u05ea\u05d9\u05d1 \u05de\u05dc\u05d1\u05d3 \u200e/health, \u05db-x-api-key \u05d0\u05d5 \u05db\u05d0\u05e1\u05d9\u05de\u05d5\u05df Bearer. \u05e0\u05e9\u05de\u05e8 \u05d1\u05de\u05d7\u05d6\u05d9\u05e7 \u05d4\u05de\u05e4\u05ea\u05d7\u05d5\u05ea, \u05dc\u05d0 \u05d1-settings.json."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "/health \u0915\u094b \u091b\u094b\u0921\u093c\u0915\u0930 \u0939\u0930 \u0930\u0942\u091f \u092a\u0930 x-api-key \u092f\u093e Bearer \u091f\u094b\u0915\u0928 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0906\u0935\u0936\u094d\u092f\u0915\u0964 settings.json \u092e\u0947\u0902 \u0928\u0939\u0940\u0902, \u0915\u0940\u091a\u0947\u0928 \u092e\u0947\u0902 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Wajib di setiap rute kecuali /health, sebagai x-api-key atau token Bearer. Disimpan di Keychain, bukan di settings.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Obbligatoria su ogni route tranne /health, come x-api-key o token Bearer. Salvata nel Portachiavi, non in settings.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/health \u3092\u9664\u304f\u3059\u3079\u3066\u306e\u30eb\u30fc\u30c8\u3067\u3001x-api-key \u307e\u305f\u306f Bearer \u30c8\u30fc\u30af\u30f3\u3068\u3057\u3066\u5fc5\u8981\u3067\u3059\u3002settings.json \u3067\u306f\u306a\u304f\u30ad\u30fc\u30c1\u30a7\u30fc\u30f3\u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "/health\ub97c \uc81c\uc678\ud55c \ubaa8\ub4e0 \uacbd\ub85c\uc5d0\uc11c x-api-key \ub610\ub294 Bearer \ud1a0\ud070\uc73c\ub85c \ud544\uc694\ud569\ub2c8\ub2e4. settings.json\uc774 \uc544\ub2cc \ud0a4\uccb4\uc778\uc5d0 \uc800\uc7a5\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vereist op elke route behalve /health, als x-api-key of Bearer-token. Opgeslagen in de sleutelhanger, niet in settings.json."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymagany na ka\u017cdej trasie opr\u00f3cz /health jako x-api-key lub token Bearer. Przechowywany w p\u0119ku kluczy, nie w settings.json."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrigat\u00f3ria em todas as rotas, exceto /health, como x-api-key ou token Bearer. Armazenada nas Chaves, n\u00e3o em settings.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u043d\u0430 \u0432\u0441\u0435\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u0445, \u043a\u0440\u043e\u043c\u0435 /health, \u043a\u0430\u043a x-api-key \u0438\u043b\u0438 \u0442\u043e\u043a\u0435\u043d Bearer. \u0425\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u0432 \u0421\u0432\u044f\u0437\u043a\u0435 \u043a\u043b\u044e\u0447\u0435\u0439, \u0430 \u043d\u0435 \u0432 settings.json."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kr\u00e4vs p\u00e5 alla v\u00e4gar utom /health, som x-api-key eller Bearer-token. Lagras i nyckelringen, inte i settings.json."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "/health d\u0131\u015f\u0131ndaki t\u00fcm rotalarda x-api-key veya Bearer belirteci olarak gereklidir. settings.json'da de\u011fil, Anahtar Zinciri'nde saklan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u043d\u0430 \u0432\u0441\u0456\u0445 \u043c\u0430\u0440\u0448\u0440\u0443\u0442\u0430\u0445, \u043a\u0440\u0456\u043c /health, \u044f\u043a x-api-key \u0430\u0431\u043e \u0442\u043e\u043a\u0435\u043d Bearer. \u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0443 \u0417\u0432'\u044f\u0437\u0446\u0456 \u043a\u043b\u044e\u0447\u0456\u0432, \u0430 \u043d\u0435 \u0432 settings.json."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1eaft bu\u1ed9c tr\u00ean m\u1ecdi tuy\u1ebfn tr\u1eeb /health, d\u01b0\u1edbi d\u1ea1ng x-api-key ho\u1eb7c m\u00e3 Bearer. \u0110\u01b0\u1ee3c l\u01b0u trong Chu\u1ed7i kh\u00f3a, kh\u00f4ng ph\u1ea3i settings.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9664 /health \u5916\u7684\u6240\u6709\u8def\u7531\u90fd\u9700\u8981\uff0c\u4ee5 x-api-key \u6216 Bearer \u4ee4\u724c\u5f62\u5f0f\u63d0\u4f9b\u3002\u5b58\u50a8\u5728\u94a5\u5319\u4e32\u4e2d\uff0c\u800c\u4e0d\u662f settings.json\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9664 /health \u5916\u7684\u6240\u6709\u8def\u7531\u90fd\u9700\u8981\uff0c\u4ee5 x-api-key \u6216 Bearer \u6b0a\u6756\u5f62\u5f0f\u63d0\u4f9b\u3002\u5132\u5b58\u5728\u9470\u5319\u5708\u4e2d\uff0c\u800c\u975e settings.json\u3002"
          }
        }
      }
    },
