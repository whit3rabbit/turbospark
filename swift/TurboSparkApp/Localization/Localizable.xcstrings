          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0930\u0923\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u092a\u0942\u0930\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u092c\u091c\u093e\u092f \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0938\u094d\u0925\u093f\u0924\u093f \u0930\u0916\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa status ringkas antarlangkah alih-alih seluruh transkrip"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa uno stato compatto tra i passaggi invece dell'intera trascrizione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c6\u30c3\u30d7\u9593\u3067\u5168\u6587\u306e\u4ee3\u308f\u308a\u306b\u30b3\u30f3\u30d1\u30af\u30c8\u306a\u72b6\u614b\u3092\u5f15\u304d\u7d99\u3050"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e8\uacc4 \uc0ac\uc774\uc5d0 \uc804\uccb4 \uae30\ub85d \ub300\uc2e0 \uc555\ucd95\ub41c \uc0c1\ud0dc \uc804\ub2ec"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tussen stappen een compacte toestand meegeven in plaats van het volledige transcript"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazuj mi\u0119dzy krokami zwi\u0119z\u0142y stan zamiast pe\u0142nej transkrypcji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levar um estado compacto entre as etapas em vez da transcri\u00e7\u00e3o completa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u044c \u043c\u0435\u0436\u0434\u0443 \u0448\u0430\u0433\u0430\u043c\u0438 \u0441\u0436\u0430\u0442\u043e\u0435 \u0441\u043e\u0441\u0442\u043e\u044f\u043d\u0438\u0435 \u0432\u043c\u0435\u0441\u0442\u043e \u0432\u0441\u0435\u0439 \u0438\u0441\u0442\u043e\u0440\u0438\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00f6r \u00f6ver ett kompakt tillst\u00e5nd mellan stegen i st\u00e4llet f\u00f6r hela utskriften"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad\u0131mlar aras\u0131nda t\u00fcm d\u00f6k\u00fcm yerine kompakt bir durum ta\u015f\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0442\u0438 \u043c\u0456\u0436 \u043a\u0440\u043e\u043a\u0430\u043c\u0438 \u0441\u0442\u0438\u0441\u043b\u0438\u0439 \u0441\u0442\u0430\u043d \u0437\u0430\u043c\u0456\u0441\u0442\u044c \u0443\u0441\u0456\u0454\u0457 \u0456\u0441\u0442\u043e\u0440\u0456\u0457"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuy\u1ec3n tr\u1ea1ng th\u00e1i r\u00fat g\u1ecdn gi\u1eefa c\u00e1c b\u01b0\u1edbc thay v\u00ec to\u00e0n b\u1ed9 b\u1ea3n ghi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b65\u9aa4\u4e4b\u95f4\u4f20\u9012\u7cbe\u7b80\u72b6\u6001\uff0c\u800c\u4e0d\u662f\u5b8c\u6574\u8bb0\u5f55"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b65\u9a5f\u4e4b\u9593\u50b3\u905e\u7cbe\u7c21\u72c0\u614b\uff0c\u800c\u4e0d\u662f\u5b8c\u6574\u8a18\u9304"
          }
        }
      }
    },
