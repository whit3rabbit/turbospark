        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera en server fr\u00e5n en publicerad katalog"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yay\u0131mlanm\u0131\u015f bir katalogdan sunucu kur"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438 \u0441\u0435\u0440\u0432\u0435\u0440 \u0437 \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e0i m\u00e1y ch\u1ee7 t\u1eeb danh m\u1ee5c \u0111\u00e3 xu\u1ea5t b\u1ea3n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u5df2\u53d1\u5e03\u7684\u76ee\u5f55\u5b89\u88c5\u670d\u52a1\u5668"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u5df2\u767c\u5e03\u7684\u76ee\u9304\u5b89\u88dd\u4f3a\u670d\u5668"
          }
        }
      }
    },
    "Installed '%@' to %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u062a\u062b\u0628\u064a\u062a '%@' \u0641\u064a %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201e%@\u201c wurde in %@ installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed '%@' to %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se instal\u00f3 '%@' en %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab %@ \u00bb a \u00e9t\u00e9 install\u00e9 dans %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u05d4\u05d5\u05ea\u05e7\u05df \u05d1-%@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0915\u094b %@ \u092e\u0947\u0902 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' dipasang ke %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' installato in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u3092%@\u306b\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc744(\ub97c) %@\uc5d0 \uc124\uce58\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ge\u00efnstalleerd in %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstalowano \u201e%@\u201d w: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' instalado em %@."
          }
        },
        "ru": {
