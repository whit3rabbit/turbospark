    "Load a model first: a recap needs one to run.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u0645\u0650\u0651\u0644 \u0646\u0645\u0648\u0630\u062c\u064b\u0627 \u0623\u0648\u0644\u0627\u064b: \u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0645\u0644\u062e\u0635 \u0625\u0644\u0649 \u0646\u0645\u0648\u0630\u062c \u0644\u0644\u062a\u0634\u063a\u064a\u0644."
