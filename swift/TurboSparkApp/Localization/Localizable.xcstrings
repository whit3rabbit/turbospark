        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\u3078\u306e\u30d5\u30a1\u30a4\u30eb\u30a2\u30af\u30bb\u30b9\u3092\u8a31\u53ef\u3059\u308b\u3088\u3046macOS\u306b\u6c42\u3081\u307e\u3059"
