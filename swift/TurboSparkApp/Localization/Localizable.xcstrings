    "Saved chunks from the same source overlap. Export each track separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved chunks from the same source overlap. Export each track separately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los fragmentos guardados de la misma fuente se superponen. Exporta cada pista por separado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des fragments enregistr\u00e9s de la m\u00eame source se chevauchent. Exportez chaque piste s\u00e9par\u00e9ment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Abschnitte derselben Quelle \u00fcberlappen sich. Exportiere jede Spur einzeln."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I frammenti salvati della stessa sorgente si sovrappongono. Esporta ogni traccia separatamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os trechos salvos da mesma fonte se sobrep\u00f5em. Exporte cada faixa separadamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen fragmenten van dezelfde bron overlappen. Exporteer elk spoor afzonderlijk."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade delar fr\u00e5n samma k\u00e4lla \u00f6verlappar. Exportera varje sp\u00e5r separat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane fragmenty z tego samego \u017ar\u00f3d\u0142a nak\u0142adaj\u0105 si\u0119. Wyeksportuj ka\u017cd\u0105 \u015bcie\u017ck\u0119 osobno."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayn\u0131 kaynaktan kaydedilmi\u015f par\u00e7alar \u00e7ak\u0131\u015f\u0131yor. Her kanal\u0131 ayr\u0131 d\u0131\u015fa aktar\u0131n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Potongan tersimpan dari sumber yang sama bertumpang tindih. Ekspor setiap trek secara terpisah."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u044b \u043e\u0434\u043d\u043e\u0433\u043e \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a\u0430 \u043f\u0435\u0440\u0435\u043a\u0440\u044b\u0432\u0430\u044e\u0442\u0441\u044f. \u042d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u043a\u0430\u0436\u0434\u0443\u044e \u0434\u043e\u0440\u043e\u0436\u043a\u0443 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438 \u043e\u0434\u043d\u043e\u0433\u043e \u0434\u0436\u0435\u0440\u0435\u043b\u0430 \u043f\u0435\u0440\u0435\u043a\u0440\u0438\u0432\u0430\u044e\u0442\u044c\u0441\u044f. \u0415\u043a\u0441\u043f\u043e\u0440\u0442\u0443\u0439\u0442\u0435 \u043a\u043e\u0436\u043d\u0443 \u0434\u043e\u0440\u0456\u0436\u043a\u0443 \u043e\u043a\u0440\u0435\u043c\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c \u0111o\u1ea1n \u0111\u00e3 l\u01b0u t\u1eeb c\u00f9ng m\u1ed9t ngu\u1ed3n b\u1ecb ch\u1ed3ng l\u1ea5n. Xu\u1ea5t t\u1eebng r\u00e3nh ri\u00eang bi\u1ec7t."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u540c\u3058\u30bd\u30fc\u30b9\u306e\u4fdd\u5b58\u6e08\u307f\u30c1\u30e3\u30f3\u30af\u304c\u91cd\u8907\u3057\u3066\u3044\u307e\u3059\u3002\u5404\u30c8\u30e9\u30c3\u30af\u3092\u500b\u5225\u306b\u66f8\u304d\u51fa\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub3d9\uc77c\ud55c \uc18c\uc2a4\uc5d0\uc11c \uc800\uc7a5\ub41c \uccad\ud06c\uac00 \uacb9\uce69\ub2c8\ub2e4. \uac01 \ud2b8\ub799\uc744 \uac1c\ubcc4\uc801\uc73c\ub85c \ub0b4\ubcf4\ub0b4\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6765\u81ea\u540c\u4e00\u6765\u6e90\u7684\u5df2\u4fdd\u5b58\u7247\u6bb5\u76f8\u4e92\u91cd\u53e0\u3002\u8bf7\u5355\u72ec\u5bfc\u51fa\u6bcf\u6761\u97f3\u8f68\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f86\u81ea\u540c\u4e00\u4f86\u6e90\u7684\u5df2\u5132\u5b58\u7247\u6bb5\u4e92\u76f8\u91cd\u758a\u3002\u8acb\u500b\u5225\u8f38\u51fa\u6bcf\u689d\u97f3\u8ecc\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062a\u062f\u0627\u062e\u0644 \u0627\u0644\u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u0645\u0646 \u0627\u0644\u0645\u0635\u062f\u0631 \u0646\u0641\u0633\u0647. \u0635\u062f\u0651\u0631 \u0643\u0644 \u0645\u0633\u0627\u0631 \u0639\u0644\u0649 \u062d\u062f\u0629."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e7\u05d8\u05e2\u05d9\u05dd \u05e9\u05de\u05d5\u05e8\u05d9\u05dd \u05de\u05d0\u05d5\u05ea\u05d5 \u05de\u05e7\u05d5\u05e8 \u05d7\u05d5\u05e4\u05e4\u05d9\u05dd. \u05d9\u05d9\u05e6\u05d0 \u05db\u05dc \u05e2\u05e8\u05d5\u05e5 \u05d1\u05e0\u05e4\u05e8\u05d3."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0939\u0940 \u0938\u094d\u0930\u094b\u0924 \u0915\u0947 \u0938\u0939\u0947\u091c\u0947 \u0917\u090f \u0916\u0902\u0921 \u090f\u0915-\u0926\u0942\u0938\u0930\u0947 \u092a\u0930 \u0906\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u0930 \u091f\u094d\u0930\u0948\u0915 \u0905\u0932\u0917 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
