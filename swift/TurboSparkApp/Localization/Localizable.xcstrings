    "Sampling settings cannot be changed while a generation is running.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampling settings cannot be changed while a generation is running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ajustes de muestreo no se pueden cambiar mientras se ejecuta una generación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paramètres d'échantillonnage ne peuvent pas être modifiés pendant qu'une génération est en cours."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
