    "Unsupported audio format (.%@). Convert to M4A or WAV and try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تنسيق صوت غير مدعوم (.%@). حوّله إلى M4A أو WAV ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstütztes Audioformat (.%@). Konvertiere es in M4A oder WAV und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported audio format (.%@). Convert to M4A or WAV and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de audio no compatible (.%@). Conviértelo a M4A o WAV e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format audio non pris en charge (.%@). Convertissez-le en M4A ou WAV, puis réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תבנית שמע לא נתמכת (.%@). המר ל‑M4A או ל‑WAV ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असमर्थित ऑडियो फ़ॉर्मैट (.%@)। M4A या WAV में बदलें और पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format audio tidak didukung (.%@). Konversikan ke M4A atau WAV, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato audio non supportato (.%@). Convertilo in M4A o WAV e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サポートされていないオーディオ形式です（.%@）。M4A または WAV に変換してから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않는 오디오 형식입니다(.%@). M4A 또는 WAV로 변환한 후 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet-ondersteunde audio-indeling (.%@). Converteer naar M4A of WAV en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobsługiwany format dźwięku (.%@). Przekonwertuj go na M4A lub WAV i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato de áudio incompatível (.%@). Converta para M4A ou WAV e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Неподдерживаемый аудиоформат (.%@). Преобразуйте его в M4A или WAV и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudformatet stöds inte (.%@). Konvertera till M4A eller WAV och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenmeyen ses biçimi (.%@). M4A veya WAV biçimine dönüştürüp tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Непідтримуваний аудіоформат (.%@). Перетворіть його на M4A або WAV і спробуйте ще раз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Định dạng âm thanh không được hỗ trợ (.%@). Hãy chuyển sang M4A hoặc WAV rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的音频格式（.%@）。请转换为 M4A 或 WAV 后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援的音訊格式（.%@）。請轉換為 M4A 或 WAV 後再試一次。"
          }
        }
      }
    },
    "Unsupported. Returns a clear 501 error; image edits are not available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "غير مدعوم. يعيد خطأ 501 واضحًا؛ تعديلات الصور غير متاحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht unterstützt. Liefert einen klaren 501-Fehler; Bildbearbeitung ist nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unsupported. Returns a clear 501 error; image edits are not available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No compatible. Devuelve un error 501 claro; la edición de imágenes no está disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Non pris en charge. Renvoie une erreur 501 explicite ; la modification d'images n'est pas disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נתמך. מחזיר שגיאת 501 ברורה; עריכת תמונות אינה זמינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "समर्थित नहीं। स्पष्ट 501 त्रुटि लौटाता है; इमेज संपादन उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak didukung. Mengembalikan galat 501 yang jelas; pengeditan gambar tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non supportato. Restituisce un errore 501 esplicito; la modifica delle immagini non è disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "非対応。明確な 501 エラーを返します。画像の編集は利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원되지 않음. 명확한 501 오류를 반환하며 이미지 편집은 사용할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet ondersteund. Geeft een duidelijke 501-fout; afbeeldingen bewerken is niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobsługiwane. Zwraca jednoznaczny błąd 501; edycja obrazów jest niedostępna."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não compatível. Retorna um erro 501 claro; a edição de imagens não está disponível."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не поддерживается. Возвращает явную ошибку 501; редактирование изображений недоступно."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stöds inte. Returnerar ett tydligt 501-fel; bildredigering är inte tillgänglig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenmiyor. Açık bir 501 hatası döndürür; görüntü düzenleme kullanılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не підтримується. Повертає явну помилку 501; редагування зображень недоступне."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không được hỗ trợ. Trả về lỗi 501 rõ ràng; không thể chỉnh sửa hình ảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持。返回明确的 501 错误；图像编辑不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不支援。傳回明確的 501 錯誤；無法編輯影像。"
          }
        }
      }
    },
