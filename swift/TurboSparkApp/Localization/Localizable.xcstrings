            "value": "Kr\u00f3tkie, skupione rozumowanie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Racioc\u00ednio breve e focado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0440\u0430\u0442\u043a\u0438\u0435, \u0441\u0444\u043e\u043a\u0443\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort, fokuserat resonemang"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0131sa ve odakl\u0131 d\u00fc\u015f\u00fcnme"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0440\u043e\u0442\u043a\u0456, \u0437\u043e\u0441\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u0456 \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u043d\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suy ngh\u0129 ng\u1eafn g\u1ecdn, t\u1eadp trung"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7b80\u77ed\u3001\u4e13\u6ce8\u7684\u601d\u8003"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7c21\u77ed\u3001\u5c08\u6ce8\u7684\u601d\u8003"
          }
        }
      }
    },
