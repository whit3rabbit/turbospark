            "value": "\u05e9\u05d9\u05e0\u05d5\u05d9 \u05e7\u05e0\u05d4 \u05d4\u05de\u05d9\u05d3\u05d4 \u05e9\u05dc \u05d8\u05e7\u05e1\u05d8 \u05d4\u05de\u05de\u05e9\u05e7, \u05d4\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05d5\u05d4\u05ea\u05de\u05dc\u05d9\u05dc"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0902\u091f\u0930\u092b\u093c\u0947\u0938, \u0938\u0902\u0926\u0947\u0936\u094b\u0902 \u0914\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u093e \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092c\u0921\u093c\u093e-\u091b\u094b\u091f\u093e \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skalakan teks antarmuka, pesan, dan transkrip"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridimensiona il testo di interfaccia, messaggi e trascrizione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30a4\u30b9\u3001\u30e1\u30c3\u30bb\u30fc\u30b8\u3001\u8a18\u9332\u306e\u6587\u5b57\u3092\u62e1\u5927\u7e2e\u5c0f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc778\ud130\ud398\uc774\uc2a4, \uba54\uc2dc\uc9c0, \ub300\ud654 \uae30\ub85d \ud14d\uc2a4\ud2b8 \ud06c\uae30 \uc870\uc808"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst van interface, berichten en transcript schalen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skaluj tekst interfejsu, wiadomo\u015bci i transkrypcji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta o texto da interface, das mensagens e da transcri\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0430\u0441\u0448\u0442\u0430\u0431 \u0442\u0435\u043a\u0441\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430, \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439 \u0438 \u0438\u0441\u0442\u043e\u0440\u0438\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skala text i gr\u00e4nssnitt, meddelanden och transkript"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aray\u00fcz, mesaj ve d\u00f6k\u00fcm metnini \u00f6l\u00e7eklendir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0430\u0441\u0448\u0442\u0430\u0431 \u0442\u0435\u043a\u0441\u0442\u0443 \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443, \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c \u0456 \u0456\u0441\u0442\u043e\u0440\u0456\u0457"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay \u0111\u1ed5i c\u1ee1 ch\u1eef giao di\u1ec7n, tin nh\u1eafn v\u00e0 b\u1ea3n ghi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f29\u653e\u754c\u9762\u3001\u6d88\u606f\u548c\u8bb0\u5f55\u6587\u5b57"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7e2e\u653e\u4ecb\u9762\u3001\u8a0a\u606f\u8207\u8a18\u9304\u6587\u5b57"
          }
        }
      }
    },
