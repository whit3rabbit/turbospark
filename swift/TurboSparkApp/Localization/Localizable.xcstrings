        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e1\u05e3 \u05e9\u05e8\u05ea MCP \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9 \u05d7\u05d3\u05e9"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u092f\u093e \u0917\u094d\u0932\u094b\u092c\u0932 MCP \u0938\u0930\u094d\u0935\u0930 \u091c\u094b\u0921\u093c\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan server MCP global baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un nuovo server MCP globale"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65b0\u3057\u3044\u30b0\u30ed\u30fc\u30d0\u30eb MCP \u30b5\u30fc\u30d0\u30fc\u3092\u8ffd\u52a0"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0c8 \uc804\uc5ed MCP \uc11c\ubc84 \ucd94\uac00"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een nieuwe globale MCP-server toevoegen"
