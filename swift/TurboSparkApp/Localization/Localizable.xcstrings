    "Probe an arbitrary Hugging Face repository by header alone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u062d\u0635 \u0623\u064a \u0645\u0633\u062a\u0648\u062f\u0639 Hugging Face \u0645\u0646 \u062e\u0644\u0627\u0644 \u0627\u0644\u062a\u0631\u0648\u064a\u0633\u0627\u062a \u0641\u0642\u0637"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein beliebiges Hugging-Face-Repository nur anhand der Header pr\u00fcfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Probe an arbitrary Hugging Face repository by header alone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Examinar cualquier repositorio de Hugging Face solo por sus encabezados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examiner n\u2019importe quel d\u00e9p\u00f4t Hugging Face par ses seuls en-t\u00eates"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d3\u05d9\u05e7\u05ea \u05db\u05dc \u05de\u05d0\u05d2\u05e8 Hugging Face \u05dc\u05e4\u05d9 \u05d4\u05db\u05d5\u05ea\u05e8\u05d5\u05ea \u05d1\u05dc\u05d1\u05d3"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
