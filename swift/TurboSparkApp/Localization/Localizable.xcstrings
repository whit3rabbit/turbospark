    "Memory cost per window is unavailable for this model.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0643\u0644\u0641\u0629 \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0644\u0643\u0644 \u0646\u0627\u0641\u0630\u0629 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherbedarf pro Fenster ist f\u00fcr dieses Modell nicht verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory cost per window is unavailable for this model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El coste de memoria por ventana no est\u00e1 disponible para este modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le co\u00fbt m\u00e9moire par fen\u00eatre n'est pas disponible pour ce mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05dc\u05d5\u05ea \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05dc\u05db\u05dc \u05d7\u05dc\u05d5\u05df \u05d0\u05d9\u05e0\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05de\u05d5\u05d3\u05dc \u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0924\u093f \u0935\u093f\u0902\u0921\u094b \u092e\u0947\u092e\u094b\u0930\u0940 \u0932\u093e\u0917\u0924 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biaya memori per jendela tidak tersedia untuk model ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il costo di memoria per finestra non \u00e8 disponibile per questo modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e2\u30c7\u30eb\u3067\u306f\u30a6\u30a3\u30f3\u30c9\u30a6\u3054\u3068\u306e\u30e1\u30e2\u30ea\u4f7f\u7528\u91cf\u3092\u53d6\u5f97\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubaa8\ub378\uc740 \ucc3d\ubcc4 \uba54\ubaa8\ub9ac \ube44\uc6a9\uc744 \ud655\uc778\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geheugengebruik per venster is niet beschikbaar voor dit model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koszt pami\u0119ci na okno jest niedost\u0119pny dla tego modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O custo de mem\u00f3ria por janela n\u00e3o est\u00e1 dispon\u00edvel para este modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0445\u043e\u0434 \u043f\u0430\u043c\u044f\u0442\u0438 \u043d\u0430 \u043e\u043a\u043d\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d \u0434\u043b\u044f \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnes\u00e5tg\u00e5ngen per f\u00f6nster \u00e4r inte tillg\u00e4nglig f\u00f6r den h\u00e4r modellen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model i\u00e7in pencere ba\u015f\u0131na bellek maliyeti yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0442\u0440\u0430\u0442\u0438 \u043f\u0430\u043c'\u044f\u0442\u0456 \u043d\u0430 \u0432\u0456\u043a\u043d\u043e \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456 \u0434\u043b\u044f \u0446\u0456\u0454\u0457 \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 d\u1eef li\u1ec7u b\u1ed9 nh\u1edb theo t\u1eebng c\u1eeda s\u1ed5 cho m\u00f4 h\u00ecnh n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u65e0\u6cd5\u83b7\u53d6\u6bcf\u4e2a\u7a97\u53e3\u7684\u5185\u5b58\u5f00\u9500\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u7121\u6cd5\u53d6\u5f97\u6bcf\u500b\u8996\u7a97\u7684\u8a18\u61b6\u9ad4\u958b\u92b7\u3002"
          }
        }
