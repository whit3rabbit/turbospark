    "Load a local chat model to summarize this transcript.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load a local chat model to summarize this transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga un modelo de chat local para resumir esta transcripci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez un mod\u00e8le de discussion local pour r\u00e9sumer cette transcription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade ein lokales Chatmodell, um dieses Transkript zusammenzufassen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica un modello di chat locale per riassumere questa trascrizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue um modelo de chat local para resumir esta transcri\u00e7\u00e3o."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad een lokaal chatmodel om dit transcript samen te vatten."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4s in en lokal chattmodell f\u00f6r att sammanfatta transkriptionen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za\u0142aduj lokalny model czatu, aby podsumowa\u0107 t\u0119 transkrypcj\u0119."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu transkripti \u00f6zetlemek i\u00e7in yerel bir sohbet modeli y\u00fckleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat model obrolan lokal untuk meringkas transkrip ini."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0443\u044e \u0447\u0430\u0442-\u043c\u043e\u0434\u0435\u043b\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u043e\u0434\u0432\u0435\u0441\u0442\u0438 \u0438\u0442\u043e\u0433\u0438 \u044d\u0442\u043e\u0439 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0443 \u0447\u0430\u0442-\u043c\u043e\u0434\u0435\u043b\u044c, \u0449\u043e\u0431 \u043f\u0456\u0434\u0441\u0443\u043c\u0443\u0432\u0430\u0442\u0438 \u0446\u044e \u0440\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i m\u00f4 h\u00ecnh tr\u00f2 chuy\u1ec7n c\u1ee5c b\u1ed9 \u0111\u1ec3 t\u00f3m t\u1eaft b\u1ea3n ch\u00e9p l\u1eddi n\u00e0y."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u6587\u5b57\u8d77\u3053\u3057\u3092\u8981\u7d04\u3059\u308b\u306b\u306f\u3001\u30ed\u30fc\u30ab\u30eb\u306e\u30c1\u30e3\u30c3\u30c8\u30e2\u30c7\u30eb\u3092\u8aad\u307f\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc804\uc0ac\ub97c \uc694\uc57d\ud558\ub824\uba74 \ub85c\uceec \ucc44\ud305 \ubaa8\ub378\uc744 \ub85c\ub4dc\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u8f7d\u672c\u5730\u804a\u5929\u6a21\u578b\u4ee5\u603b\u7ed3\u6b64\u8f6c\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f09\u5165\u672c\u6a5f\u804a\u5929\u6a21\u578b\u4ee5\u7e3d\u7d50\u6b64\u8f49\u9304\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u0645\u0651\u0644 \u0646\u0645\u0648\u0630\u062c \u0645\u062d\u0627\u062f\u062b\u0629 \u0645\u062d\u0644\u064a\u0627\u064b \u0644\u062a\u0644\u062e\u064a\u0635 \u0647\u0630\u0627 \u0627\u0644\u062a\u0641\u0631\u064a\u063a."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05e2\u05df \u05de\u05d5\u05d3\u05dc \u05e6\u05f3\u05d0\u05d8 \u05de\u05e7\u05d5\u05de\u05d9 \u05db\u05d3\u05d9 \u05dc\u05e1\u05db\u05dd \u05d0\u05ea \u05d4\u05ea\u05de\u05dc\u05d5\u05dc \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u091f\u094d\u0930\u093e\u0902\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u093e \u0938\u093e\u0930\u093e\u0902\u0936 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u091a\u0948\u091f \u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
    "The local model returned an empty summary. Try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local model returned an empty summary. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo local devolvi\u00f3 un resumen vac\u00edo. Vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mod\u00e8le local a renvoy\u00e9 un r\u00e9sum\u00e9 vide. R\u00e9essayez."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lokale Modell hat eine leere Zusammenfassung zur\u00fcckgegeben. Versuche es erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello locale ha restituito un riepilogo vuoto. Riprova."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo local retornou um resumo vazio. Tente novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het lokale model gaf een lege samenvatting terug. Probeer het opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den lokala modellen returnerade en tom sammanfattning. F\u00f6rs\u00f6k igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lokalny model zwr\u00f3ci\u0142 puste podsumowanie. Spr\u00f3buj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel model bo\u015f bir \u00f6zet d\u00f6nd\u00fcrd\u00fc. Yeniden deneyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model lokal mengembalikan ringkasan kosong. Coba lagi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u0432\u0435\u0440\u043d\u0443\u043b\u0430 \u043f\u0443\u0441\u0442\u043e\u0435 \u0440\u0435\u0437\u044e\u043c\u0435. \u041f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u043b\u0430 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u0439 \u043f\u0456\u0434\u0441\u0443\u043c\u043e\u043a. \u0421\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 h\u00ecnh c\u1ee5c b\u1ed9 tr\u1ea3 v\u1ec1 b\u1ea3n t\u00f3m t\u1eaft tr\u1ed1ng. H\u00e3y th\u1eed l\u1ea1i."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ed\u30fc\u30ab\u30eb\u30e2\u30c7\u30eb\u304c\u7a7a\u306e\u8981\u7d04\u3092\u8fd4\u3057\u307e\u3057\u305f\u3002\u518d\u8a66\u884c\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub85c\uceec \ubaa8\ub378\uc774 \ube48 \uc694\uc57d\uc744 \ubc18\ud658\ud588\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u5730\u6a21\u578b\u8fd4\u56de\u4e86\u7a7a\u6458\u8981\u3002\u8bf7\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u6a5f\u6a21\u578b\u50b3\u56de\u4e86\u7a7a\u767d\u6458\u8981\u3002\u8acb\u518d\u8a66\u4e00\u6b21\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0639\u0627\u062f \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062d\u0644\u064a \u0645\u0644\u062e\u0635\u0627\u064b \u0641\u0627\u0631\u063a\u0627\u064b. \u062d\u0627\u0648\u0644 \u0645\u062c\u062f\u062f\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05de\u05e7\u05d5\u05de\u05d9 \u05d4\u05d7\u05d6\u05d9\u05e8 \u05e1\u05d9\u05db\u05d5\u05dd \u05e8\u05d9\u05e7. \u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092e\u0949\u0921\u0932 \u0928\u0947 \u0916\u093e\u0932\u0940 \u0938\u093e\u0930\u093e\u0902\u0936 \u0932\u094c\u091f\u093e\u092f\u093e\u0964 \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
    "The saved model is unavailable. Choose a model and create a new take.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved model is unavailable. Choose a model and create a new take."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo guardado no est\u00e1 disponible. Elige un modelo y crea una nueva toma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mod\u00e8le enregistr\u00e9 est indisponible. Choisissez un mod\u00e8le et cr\u00e9ez une nouvelle prise."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das gespeicherte Modell ist nicht verf\u00fcgbar. W\u00e4hle ein Modell und erstelle einen neuen Take."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello salvato non \u00e8 disponibile. Scegli un modello e crea una nuova take."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo salvo est\u00e1 indispon\u00edvel. Escolha um modelo e crie uma nova tomada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het opgeslagen model is niet beschikbaar. Kies een model en maak een nieuwe take."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sparade modellen \u00e4r inte tillg\u00e4nglig. V\u00e4lj en modell och skapa en ny tagning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisany model jest niedost\u0119pny. Wybierz model i utw\u00f3rz now\u0105 wersj\u0119."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilmi\u015f model kullan\u0131lam\u0131yor. Bir model se\u00e7in ve yeni bir \u00e7ekim olu\u015fturun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model tersimpan tidak tersedia. Pilih model dan buat take baru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c \u0438 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0439 \u0434\u0443\u0431\u043b\u044c."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c \u0456 \u0441\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u043d\u043e\u0432\u0438\u0439 \u0434\u0443\u0431\u043b\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 h\u00ecnh \u0111\u00e3 l\u01b0u kh\u00f4ng kh\u1ea3 d\u1ee5ng. Ch\u1ecdn m\u00f4 h\u00ecnh v\u00e0 t\u1ea1o l\u01b0\u1ee3t thu m\u1edbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u5b58\u3057\u305f\u30e2\u30c7\u30eb\u3092\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002\u30e2\u30c7\u30eb\u3092\u9078\u629e\u3057\u3066\u65b0\u3057\u3044\u30c6\u30a4\u30af\u3092\u4f5c\u6210\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\ub41c \ubaa8\ub378\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ubaa8\ub378\uc744 \uc120\ud0dd\ud558\uace0 \uc0c8 \ud14c\uc774\ud06c\ub97c \ub9cc\ub4dc\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4fdd\u5b58\u7684\u6a21\u578b\u4e0d\u53ef\u7528\u3002\u8bf7\u9009\u62e9\u6a21\u578b\u5e76\u521b\u5efa\u65b0\u7248\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5132\u5b58\u7684\u6a21\u578b\u7121\u6cd5\u4f7f\u7528\u3002\u8acb\u9078\u64c7\u6a21\u578b\u4e26\u5efa\u7acb\u65b0\u7248\u672c\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062d\u0641\u0648\u0638 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d. \u0627\u062e\u062a\u0631 \u0646\u0645\u0648\u0630\u062c\u0627\u064b \u0648\u0623\u0646\u0634\u0626 \u0646\u0633\u062e\u0629 \u062c\u062f\u064a\u062f\u0629."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05e9\u05de\u05d5\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05d6\u05de\u05d9\u05df. \u05d1\u05d7\u05e8 \u05de\u05d5\u05d3\u05dc \u05d5\u05e6\u05d5\u05e8 \u05d8\u05d9\u05d9\u05e7 \u05d7\u05d3\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e \u092e\u0949\u0921\u0932 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092e\u0949\u0921\u0932 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0928\u092f\u093e \u091f\u0947\u0915 \u092c\u0928\u093e\u090f\u0901\u0964"
          }
        }
      }
    },
