        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u306b\u5bfe\u5fdc\u3059\u308b\u30b3\u30fc\u30c9\u3001\u30c6\u30ad\u30b9\u30c8\u3001\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u30d5\u30a1\u30a4\u30eb\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3002"
