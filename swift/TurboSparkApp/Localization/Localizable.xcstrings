    "Import MP3, WAV, M4A, FLAC, AIFF, or other audio formats supported by macOS.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u0645 \u0628\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0644\u0641\u0627\u062a MP3\u060c \u0623\u0648 WAV\u060c \u0623\u0648 M4A\u060c \u0623\u0648 FLAC\u060c \u0623\u0648 AIFF\u060c \u0623\u0648 \u062a\u0646\u0633\u064a\u0642\u0627\u062a \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0623\u062e\u0631\u0649 \u0627\u0644\u062a\u064a \u064a\u062f\u0639\u0645\u0647\u0627 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 macOS."
