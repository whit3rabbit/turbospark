    "Automatically detect and run GGUF models downloaded by LM Studio without copying or redownloading files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اكتشف نماذج GGUF التي نزّلها LM Studio وشغّلها تلقائيا دون نسخ الملفات أو إعادة تنزيلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von LM Studio heruntergeladene GGUF-Modelle automatisch erkennen und ausführen, ohne Dateien zu kopieren oder erneut herunterzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically detect and run GGUF models downloaded by LM Studio without copying or redownloading files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta y ejecuta automáticamente los modelos GGUF descargados por LM Studio sin copiar ni volver a descargar archivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détectez et exécutez automatiquement les modèles GGUF téléchargés par LM Studio sans copier ni retélécharger de fichiers."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זהה והרץ אוטומטית מודלי GGUF שהורדו על ידי LM Studio בלי להעתיק או להוריד קבצים מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio द्वारा डाउनलोड किए गए GGUF मॉडल को फ़ाइलें कॉपी या दोबारा डाउनलोड किए बिना स्वतः पहचानें और चलाएं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deteksi dan jalankan otomatis model GGUF yang diunduh LM Studio tanpa menyalin atau mengunduh ulang berkas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rileva ed esegui automaticamente i modelli GGUF scaricati da LM Studio senza copiare né riscaricare i file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio でダウンロードした GGUF モデルを、ファイルをコピーしたり再ダウンロードしたりせずに自動検出して実行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio로 내려받은 GGUF 모델을 파일 복사나 재다운로드 없이 자동으로 감지해 실행합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecteer en start automatisch GGUF-modellen die door LM Studio zijn gedownload, zonder bestanden te kopiëren of opnieuw te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie wykrywaj i uruchamiaj modele GGUF pobrane przez LM Studio bez kopiowania ani ponownego pobierania plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecte e execute automaticamente modelos GGUF baixados pelo LM Studio sem copiar nem baixar os arquivos novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически обнаруживать и запускать модели GGUF, загруженные LM Studio, без копирования и повторной загрузки файлов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifiera och kör automatiskt GGUF-modeller som hämtats av LM Studio utan att kopiera eller hämta om filer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "LM Studio tarafından indirilen GGUF modellerini dosyaları kopyalamadan veya yeniden indirmeden otomatik olarak algılayıp çalıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично виявляйте та запускайте моделі GGUF, завантажені LM Studio, без копіювання чи повторного завантаження файлів."
          }
        },
        "vi": {
