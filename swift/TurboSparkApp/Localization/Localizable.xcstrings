    "Carry a compact state between steps instead of the full transcript": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نقل حالة مختصرة بين الخطوات بدلًا من النص الكامل"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwischen Schritten einen kompakten Zustand statt des ganzen Verlaufs mitführen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carry a compact state between steps instead of the full transcript"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevar un estado compacto entre pasos en lugar de la transcripción completa"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transmettre un état compact entre les étapes au lieu de toute la transcription"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העבר מצב קומפקטי בין צעדים במקום התמליל המלא"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चरणों के बीच पूरी बातचीत के बजाय संक्षिप्त स्थिति रखें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawa status ringkas antarlangkah alih-alih seluruh transkrip"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa uno stato compatto tra i passaggi invece dell'intera trascrizione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステップ間で全文の代わりにコンパクトな状態を引き継ぐ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단계 사이에 전체 기록 대신 압축된 상태 전달"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tussen stappen een compacte toestand meegeven in plaats van het volledige transcript"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazuj między krokami zwięzły stan zamiast pełnej transkrypcji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Levar um estado compacto entre as etapas em vez da transcrição completa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Передавать между шагами сжатое состояние вместо всей истории"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För över ett kompakt tillstånd mellan stegen i stället för hela utskriften"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adımlar arasında tüm döküm yerine kompakt bir durum taşı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Передавати між кроками стислий стан замість усієї історії"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuyển trạng thái rút gọn giữa các bước thay vì toàn bộ bản ghi"
          }
        },
        "zh-Hans": {
