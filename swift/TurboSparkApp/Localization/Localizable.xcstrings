            "state": "translated",
            "value": "\u0639\u0631\u0636 \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0628\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0623\u0648 \u0628\u0639\u0644\u0627\u0645\u0627\u062a +/-"
