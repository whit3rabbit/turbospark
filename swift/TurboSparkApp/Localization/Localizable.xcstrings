        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d0\u05d2\u05e8 \u05d6\u05d4 \u05de\u05e4\u05e8\u05e1\u05dd %lld \u05d2\u05e8\u05e1\u05d0\u05d5\u05ea GGUF. \u05d1\u05d7\u05e8 \u05e7\u05d5\u05d1\u05e5 \u05e1\u05e4\u05e6\u05d9\u05e4\u05d9 \u05dc\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d5\u05d4\u05ea\u05e7\u05e0\u05d4."
