    "Long draft: rewritten in parts at paragraph breaks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Long draft: rewritten in parts at paragraph breaks."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0633\u0648\u062f\u0629 \u0637\u0648\u064a\u0644\u0629: \u062a\u064f\u0639\u0627\u062f \u0635\u064a\u0627\u063a\u062a\u0647\u0627 \u0639\u0644\u0649 \u0623\u062c\u0632\u0627\u0621 \u0639\u0646\u062f \u0641\u0648\u0627\u0635\u0644 \u0627\u0644\u0641\u0642\u0631\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Langer Entwurf: wird an Absatzgrenzen in Teilen umgeschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borrador largo: se reescribe por partes en los saltos de p\u00e1rrafo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Brouillon long : r\u00e9\u00e9crit par parties, aux sauts de paragraphe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05d9\u05d5\u05d8\u05d4 \u05d0\u05e8\u05d5\u05db\u05d4: \u05de\u05e9\u05d5\u05db\u05ea\u05d1\u05ea \u05d1\u05d7\u05dc\u05e7\u05d9\u05dd, \u05d1\u05de\u05e2\u05d1\u05e8\u05d9 \u05e4\u05e1\u05e7\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u0902\u092c\u093e \u0921\u094d\u0930\u093e\u092b\u093c\u094d\u091f: \u0905\u0928\u0941\u091a\u094d\u091b\u0947\u0926 \u0935\u093f\u0930\u093e\u092e\u094b\u0902 \u092a\u0930 \u092d\u093e\u0917\u094b\u0902 \u092e\u0947\u0902 \u0926\u094b\u092c\u093e\u0930\u093e \u0932\u093f\u0916\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf panjang: ditulis ulang per bagian pada batas paragraf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozza lunga: riscritta in parti, alle interruzioni di paragrafo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9577\u3044\u4e0b\u66f8\u304d: \u6bb5\u843d\u306e\u533a\u5207\u308a\u3067\u5206\u5272\u3057\u3066\u66f8\u304d\u76f4\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae34 \ucd08\uc548: \ubb38\ub2e8 \uad6c\ubd84\uc5d0\uc11c \ub098\ub204\uc5b4 \ub2e4\uc2dc \uc501\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lang concept: wordt in delen herschreven, bij alinea-overgangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u0142uga wersja robocza: przepisywana w cz\u0119\u015bciach, na granicach akapit\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Rascunho longo: reescrito em partes, nas quebras de par\u00e1grafo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u0438\u043d\u043d\u044b\u0439 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a: \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043f\u043e \u0447\u0430\u0441\u0442\u044f\u043c, \u0441 \u0440\u0430\u0437\u0431\u0438\u0435\u043d\u0438\u0435\u043c \u043f\u043e \u0430\u0431\u0437\u0430\u0446\u0430\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e5ngt utkast: skrivs om i delar vid styckebrytningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun taslak: paragraf sonlar\u0131ndan b\u00f6l\u00fcnerek par\u00e7a par\u00e7a yeniden yaz\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0432\u0433\u0430 \u0447\u0435\u0440\u043d\u0435\u0442\u043a\u0430: \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0443\u0454\u0442\u044c\u0441\u044f \u0447\u0430\u0441\u0442\u0438\u043d\u0430\u043c\u0438, \u0437 \u043f\u043e\u0434\u0456\u043b\u043e\u043c \u0437\u0430 \u0430\u0431\u0437\u0430\u0446\u0430\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n nh\u00e1p d\u00e0i: \u0111\u01b0\u1ee3c vi\u1ebft l\u1ea1i theo t\u1eebng ph\u1ea7n t\u1ea1i c\u00e1c ch\u1ed7 ng\u1eaft \u0111o\u1ea1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8349\u7a3f\u8f83\u957f\uff1a\u5c06\u5728\u6bb5\u843d\u5206\u9694\u5904\u62c6\u5206\u540e\u5206\u6bb5\u6539\u5199\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8349\u7a3f\u8f03\u9577\uff1a\u5c07\u5728\u6bb5\u843d\u5206\u9694\u8655\u62c6\u5206\u5f8c\u5206\u6bb5\u6539\u5beb\u3002"
          }
        }
      }
    },
    "Stopped. The rewrite is incomplete.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
