            "state": "translated",
            "value": "임시 채팅은 복제할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tijdelijke chat kan niet worden gedupliceerd."
          }
        },
