    "Any client that takes a base URL: Cursor, Continue, LangChain.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أي عميل يقبل عنوان URL أساسيًا: Cursor وContinue وLangChain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Client, der eine Basis-URL akzeptiert: Cursor, Continue, LangChain."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any client that takes a base URL: Cursor, Continue, LangChain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier cliente que acepte una URL base: Cursor, Continue, LangChain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout client qui accepte une URL de base : Cursor, Continue, LangChain."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל לקוח שמקבל כתובת URL בסיסית: Cursor,‏ Continue,‏ LangChain."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई भी क्लाइंट जो बेस URL लेता है: Cursor, Continue, LangChain।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klien apa pun yang menerima URL dasar: Cursor, Continue, LangChain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi client che accetta un URL di base: Cursor, Continue, LangChain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベース URL を指定できるクライアントすべて：Cursor、Continue、LangChain。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 URL을 받는 모든 클라이언트: Cursor, Continue, LangChain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke client die een basis-URL accepteert: Cursor, Continue, LangChain."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy klient przyjmujący bazowy URL: Cursor, Continue, LangChain."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer cliente que aceite uma URL base: Cursor, Continue, LangChain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой клиент, принимающий базовый URL: Cursor, Continue, LangChain."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla klienter som tar en bas-URL: Cursor, Continue, LangChain."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel URL alan her istemci: Cursor, Continue, LangChain."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-який клієнт, що приймає базовий URL: Cursor, Continue, LangChain."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi ứng dụng khách nhận URL gốc: Cursor, Continue, LangChain."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何接受基础 URL 的客户端：Cursor、Continue、LangChain。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "任何接受基礎 URL 的用戶端：Cursor、Continue、LangChain。"
          }
        }
      }
    },
    "Any process on this machine can reach this server. Set a key under Advanced.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأي عملية على هذا الجهاز الوصول إلى هذا الخادم. عيّن مفتاحًا ضمن الإعدادات المتقدمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Prozess auf diesem Mac kann diesen Server erreichen. Lege unter „Erweitert“ einen Schlüssel fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any process on this machine can reach this server. Set a key under Advanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier proceso de este equipo puede acceder a este servidor. Define una clave en Avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout processus de cet ordinateur peut atteindre ce serveur. Définissez une clé dans Avancé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל תהליך במחשב הזה יכול לגשת לשרת. הגדר מפתח תחת 'מתקדם'."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मशीन की कोई भी प्रोसेस इस सर्वर तक पहुँच सकती है। उन्नत में एक कुंजी सेट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses apa pun di mesin ini dapat menjangkau server ini. Atur kunci di Lanjutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi processo su questo computer può raggiungere il server. Imposta una chiave in Avanzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このマシン上のどのプロセスもこのサーバーにアクセスできます。詳細設定でキーを設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 컴퓨터의 모든 프로세스가 이 서버에 접근할 수 있습니다. 고급에서 키를 설정하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk proces op deze computer kan deze server bereiken. Stel een sleutel in onder Geavanceerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy proces na tym komputerze może połączyć się z tym serwerem. Ustaw klucz w sekcji Zaawansowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer processo neste computador pode acessar este servidor. Defina uma chave em Avançado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Любой процесс на этом компьютере может обратиться к серверу. Задайте ключ в разделе «Дополнительно»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla processer på den här datorn kan nå servern. Ange en nyckel under Avancerat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makinedeki her işlem bu sunucuya erişebilir. Gelişmiş bölümünden bir anahtar belirleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Будь-який процес на цьому комп'ютері може звернутися до сервера. Задайте ключ у розділі «Додатково»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi tiến trình trên máy này đều có thể truy cập máy chủ. Hãy đặt khóa trong Nâng cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此电脑上的任何进程都能访问此服务器。请在“高级”中设置密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此電腦上的任何程序都能存取此伺服器。請在「進階」中設定金鑰。"
          }
        }
      }
    },
