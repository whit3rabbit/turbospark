    "Backup of \"%@\" exported %@ with app version %@; %lld items inside.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0633\u062e\u0629 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0644\u0640 \u201c%@\u201d \u0635\u064f\u062f\u0651\u0631\u062a \u0641\u064a %@ \u0628\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 %@\u061b \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 %lld \u0639\u0646\u0635\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup von \u201e%@\u201c, exportiert am %@ mit App-Version %@; enth\u00e4lt %lld Elemente."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup of \"%@\" exported %@ with app version %@; %lld items inside."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia de \u201c%@\u201d exportada el %@ con la versi\u00f3n %@ de la app; contiene %lld elementos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegarde de \u00ab\u00a0%@\u00a0\u00bb export\u00e9e le %@ avec la version %@ de l'app ; %lld \u00e9l\u00e9ments \u00e0 l'int\u00e9rieur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d2\u05d9\u05d1\u05d5\u05d9 \u05e9\u05dc \u201d%@\u201d \u05e9\u05d9\u05d5\u05e6\u05d0 \u05d1-%@ \u05e2\u05dd \u05d2\u05e8\u05e1\u05ea \u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 %@; \u05de\u05db\u05d9\u05dc %lld \u05e4\u05e8\u05d9\u05d8\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c%@\u201d \u0915\u093e \u092c\u0948\u0915\u0905\u092a, %@ \u0915\u094b \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e, \u0910\u092a \u0938\u0902\u0938\u094d\u0915\u0930\u0923 %@; \u0907\u0938\u092e\u0947\u0902 %lld \u0906\u0907\u091f\u092e \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Cadangan \u201c%@\u201d diekspor pada %@ dengan versi aplikasi %@; berisi %lld item."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup di \u201c%@\u201d esportato il %@ con la versione %@ dell'app; contiene %lld elementi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7 (%@ \u306b\u66f8\u304d\u51fa\u3057\u3001\u30a2\u30d7\u30ea\u30d0\u30fc\u30b8\u30e7\u30f3 %@\u3001%lld \u9805\u76ee)\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\u2018%@\u2019\uc758 \ubc31\uc5c5 (%@\uc5d0 \ub0b4\ubcf4\ub0c4, \uc571 \ubc84\uc804 %@, \ud56d\ubaa9 %lld\uac1c)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reservekopie van \u2018%@\u2019, ge\u00ebxporteerd op %@ met appversie %@; bevat %lld onderdelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia \u201e%@\u201d wyeksportowana %@ w wersji aplikacji %@; liczba element\u00f3w: %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Backup de \u201c%@\u201d exportado em %@ com a vers\u00e3o %@ do app; cont\u00e9m %lld itens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043f\u0438\u044f \u00ab%@\u00bb \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0430 %@ \u0432 \u0432\u0435\u0440\u0441\u0438\u0438 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f %@; \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u0432 \u0432\u043d\u0443\u0442\u0440\u0438: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e4kerhetskopia av \u201d%@\u201d exporterad %@ med appversion %@; inneh\u00e5ller %lld objekt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c%@\u201d yede\u011fi, %@ tarihinde d\u0131\u015fa aktar\u0131ld\u0131, uygulama s\u00fcr\u00fcm\u00fc %@; i\u00e7inde %lld \u00f6\u011fe var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043f\u0456\u044f \u00ab%@\u00bb \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0430 %@ \u0443 \u0432\u0435\u0440\u0441\u0456\u0457 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 %@; \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0456\u0432 \u0443\u0441\u0435\u0440\u0435\u0434\u0438\u043d\u0456: %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n sao l\u01b0u c\u1ee7a \u201c%@\u201d \u0111\u01b0\u1ee3c xu\u1ea5t l\u00fac %@ b\u1eb1ng phi\u00ean b\u1ea3n \u1ee9ng d\u1ee5ng %@; ch\u1ee9a %lld m\u1ee5c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c%@\u201d\u7684\u5907\u4efd\uff0c\u5bfc\u51fa\u4e8e %@\uff0c\u5e94\u7528\u7248\u672c %@\uff0c\u5305\u542b %lld \u4e2a\u9879\u76ee\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u7684\u5099\u4efd\uff0c\u532f\u51fa\u65bc %@\uff0cApp \u7248\u672c %@\uff0c\u5305\u542b %lld \u500b\u9805\u76ee\u3002"
          }
        }
      }
    },
    "\"Default\" is reserved for the built-in user.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" \u0645\u062d\u062c\u0648\u0632 \u0644\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0645\u062f\u0645\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" ist f\u00fcr den integrierten Benutzer reserviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" is reserved for the built-in user."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" est\u00e1 reservado para el usuario integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" est r\u00e9serv\u00e9 \u00e0 l'utilisateur int\u00e9gr\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" \u05e9\u05de\u05d5\u05e8 \u05dc\u05de\u05e9\u05ea\u05de\u05e9 \u05d4\u05de\u05d5\u05d1\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" \u0905\u0902\u0924\u0930\u094d\u0928\u093f\u0939\u093f\u0924 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0906\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" dicadangkan untuk pengguna bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" \u00e8 riservato all'utente integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\"\u306f\u7d44\u307f\u8fbc\u307f\u30e6\u30fc\u30b6\u30fc\u7528\u306b\u4e88\u7d04\u3055\u308c\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\"\ub294 \uae30\ubcf8 \uc81c\uacf5 \uc0ac\uc6a9\uc790\uc6a9\uc73c\ub85c \uc608\uc57d\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" is gereserveerd voor de ingebouwde gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa \"Default\" jest zarezerwowana dla wbudowanego u\u017cytkownika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" \u00e9 reservado para o usu\u00e1rio integrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043c\u044f \"Default\" \u0437\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u0434\u043b\u044f \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" \u00e4r reserverat f\u00f6r den inbyggda anv\u00e4ndaren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" yerle\u015fik kullan\u0131c\u0131 i\u00e7in ayr\u0131lm\u0131\u015ft\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0437\u0432\u0443 \"Default\" \u0437\u0430\u0440\u0435\u0437\u0435\u0440\u0432\u043e\u0432\u0430\u043d\u043e \u0434\u043b\u044f \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" \u0111\u01b0\u1ee3c d\u00e0nh ri\u00eang cho ng\u01b0\u1eddi d\u00f9ng t\u00edch h\u1ee3p s\u1eb5n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\"\u4e3a\u5185\u7f6e\u7528\u6237\u4fdd\u7559\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\"\u4fdd\u7559\u7d66\u5167\u5efa\u4f7f\u7528\u8005\u3002"
          }
        }
      }
    },
