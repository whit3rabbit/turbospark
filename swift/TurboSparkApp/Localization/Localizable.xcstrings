        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que este projeto lembra"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0442\u043e \u043f\u043e\u043c\u043d\u0438\u0442 \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0435\u043a\u0442"
          }
        },
        "sv": {
