        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u044c \u0456 \u0432\u0438\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u0432\u043d\u0443\u0442\u0440\u0456\u0448\u043d\u0456\u0445 \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u044c"
          }
        },
        "vi": {
