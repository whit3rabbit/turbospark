    "Describe an idea below. Your images will be saved here automatically.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0635\u0650\u0641 \u0641\u0643\u0631\u0629 \u0623\u062f\u0646\u0627\u0647. \u0633\u062a\u064f\u062d\u0641\u0638 \u0635\u0648\u0631\u0643 \u0647\u0646\u0627 \u062a\u0644\u0642\u0627\u0626\u064a\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe unten eine Idee. Deine Bilder werden hier automatisch gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe an idea below. Your images will be saved here automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe una idea abajo. Tus im\u00e1genes se guardar\u00e1n aqu\u00ed autom\u00e1ticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9crivez une id\u00e9e ci-dessous. Vos images seront enregistr\u00e9es ici automatiquement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d0\u05e8\u05d5 \u05e8\u05e2\u05d9\u05d5\u05df \u05dc\u05de\u05d8\u05d4. \u05d4\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05e9\u05dc\u05db\u05dd \u05d9\u05d9\u05e9\u05de\u05e8\u05d5 \u05db\u05d0\u05df \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0940\u091a\u0947 \u0915\u094b\u0908 \u0935\u093f\u091a\u093e\u0930 \u0932\u093f\u0916\u0947\u0902\u0964 \u0906\u092a\u0915\u0940 \u0907\u092e\u0947\u091c \u092f\u0939\u093e\u0902 \u0905\u092a\u0928\u0947 \u0906\u092a \u0938\u0939\u0947\u091c\u0940 \u091c\u093e\u090f\u0902\u0917\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan ide di bawah. Gambar Anda akan disimpan di sini secara otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi un\u2019idea qui sotto. Le immagini verranno salvate qui automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u306b\u30a2\u30a4\u30c7\u30a2\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u753b\u50cf\u306f\u3053\u3053\u306b\u81ea\u52d5\u3067\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\ub798\uc5d0 \uc544\uc774\ub514\uc5b4\ub97c \uc124\uba85\ud558\uc138\uc694. \uc774\ubbf8\uc9c0\ub294 \uc5ec\uae30\uc5d0 \uc790\ub3d9\uc73c\ub85c \uc800\uc7a5\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf hieronder een idee. Je afbeeldingen worden hier automatisch opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz pomys\u0142 poni\u017cej. Obrazy zostan\u0105 tu automatycznie zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma ideia abaixo. Suas imagens ser\u00e3o salvas aqui automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0438\u0434\u0435\u044e \u043d\u0438\u0436\u0435. \u0418\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u0431\u0443\u0434\u0443\u0442 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c\u0441\u044f \u0437\u0434\u0435\u0441\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv en id\u00e9 nedan. Dina bilder sparas h\u00e4r automatiskt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u015fa\u011f\u0131da bir fikir anlat\u0131n. G\u00f6r\u00fcnt\u00fcleriniz otomatik olarak buraya kaydedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0456\u0442\u044c \u0456\u0434\u0435\u044e \u043d\u0438\u0436\u0447\u0435. \u0417\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438\u043c\u0443\u0442\u044c\u0441\u044f \u0442\u0443\u0442."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 t\u1ea3 m\u1ed9t \u00fd t\u01b0\u1edfng b\u00ean d\u01b0\u1edbi. \u1ea2nh c\u1ee7a b\u1ea1n s\u1ebd t\u1ef1 \u0111\u1ed9ng \u0111\u01b0\u1ee3c l\u01b0u \u1edf \u0111\u00e2y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4e0b\u65b9\u63cf\u8ff0\u4e00\u4e2a\u60f3\u6cd5\u3002\u56fe\u50cf\u4f1a\u81ea\u52a8\u4fdd\u5b58\u5728\u8fd9\u91cc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4e0b\u65b9\u63cf\u8ff0\u4e00\u500b\u60f3\u6cd5\u3002\u5f71\u50cf\u6703\u81ea\u52d5\u5132\u5b58\u5728\u9019\u88e1\u3002"
          }
        }
