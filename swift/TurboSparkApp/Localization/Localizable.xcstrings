            "state": "translated",
            "value": "Confirma tus cambios para ver la cronolog\u00eda del proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Validez vos modifications pour afficher la chronologie du projet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05e6\u05e2 \u05e7\u05d5\u05de\u05d9\u05d8 \u05dc\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd \u05e9\u05dc\u05da \u05db\u05d3\u05d9 \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05ea \u05e6\u05d9\u05e8 \u05d4\u05d6\u05de\u05df \u05e9\u05dc \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u091f\u093e\u0907\u092e\u0932\u093e\u0907\u0928 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u092a\u0928\u0947 \u092c\u0926\u0932\u093e\u0935 \u0915\u092e\u093f\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit perubahan Anda untuk melihat linimasa proyek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il commit delle modifiche per visualizzare la cronologia del progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5909\u66f4\u3092\u30b3\u30df\u30c3\u30c8\u3059\u308b\u3068\u3001\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u30bf\u30a4\u30e0\u30e9\u30a4\u30f3\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcc0\uacbd \uc0ac\ud56d\uc744 \ucee4\ubc0b\ud558\uba74 \ud504\ub85c\uc81d\ud2b8 \ud0c0\uc784\ub77c\uc778\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit je wijzigingen om de projecttijdlijn te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierd\u017a swoje zmiany, aby zobaczy\u0107 o\u015b czasu projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa\u00e7a commit das suas altera\u00e7\u00f5es para ver a linha do tempo do projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0444\u0438\u043a\u0441\u0438\u0440\u0443\u0439\u0442\u0435 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0438\u044e \u043f\u0440\u043e\u0435\u043a\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Checka in dina \u00e4ndringar f\u00f6r att se projektets tidslinje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje zaman \u00e7izelgesini g\u00f6rmek i\u00e7in de\u011fi\u015fikliklerinizi i\u015fleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0444\u0456\u043a\u0441\u0443\u0439\u0442\u0435 \u0437\u043c\u0456\u043d\u0438, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0445\u0440\u043e\u043d\u043e\u043b\u043e\u0433\u0456\u044e \u043f\u0440\u043e\u0454\u043a\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit c\u00e1c thay \u0111\u1ed5i c\u1ee7a b\u1ea1n \u0111\u1ec3 xem d\u00f2ng th\u1eddi gian d\u1ef1 \u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u4ea4\u4f60\u7684\u66f4\u6539\u4ee5\u67e5\u770b\u9879\u76ee\u65f6\u95f4\u7ebf\u3002"
          }
        },
        "zh-Hant": {
