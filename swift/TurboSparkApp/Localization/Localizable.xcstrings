          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollera kompatibiliteten genom att läsa checkpoint-huvuden utan att hämta."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra tương thích bằng cách đọc phần đầu của checkpoint mà không cần tải xuống."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa kompatibilitas dengan membaca header checkpoint tanpa mengunduh."
          }
        }
      }
    },
    "Checks out only these subtrees, for a repository too large to clone whole.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checks out only these subtrees, for a repository too large to clone whole."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga solo estos subárboles, para un repositorio demasiado grande para clonarlo entero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrait uniquement ces sous-arborescences, pour un dépôt trop volumineux pour être cloné en entier."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkt nur diese Teilbäume aus, für ein Repository, das zu groß ist, um es vollständig zu klonen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estrae solo questi sottoalberi, per un repository troppo grande da clonare per intero."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faz checkout apenas destas subárvores, para um repositório grande demais para clonar inteiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Извлекает только эти поддеревья, для репозитория, слишком большого для полного клонирования."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリ全体を複製するには大きすぎる場合に、これらのサブツリーのみをチェックアウトします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체를 복제하기에 너무 큰 리포지토리에서 이 하위 트리만 체크아웃합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅检出这些子树，适用于过大而无法整体克隆的仓库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅簽出這些子樹，適用於過大而無法整體複製的儲存庫。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسحب هذه الأشجار الفرعية فقط، لمستودع أكبر من أن يُستنسخ بالكامل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוציא רק את תת-העצים האלה, עבור מאגר גדול מדי לשכפול מלא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल ये सबट्री चेकआउट करता है, ऐसी रिपॉजिटरी के लिए जो पूरी क्लोन करने के लिए बहुत बड़ी है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt alleen deze substructuren op, voor een repository die te groot is om volledig te klonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera tylko te poddrzewa, dla repozytorium zbyt dużego, by sklonować je w całości."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamı klonlanamayacak kadar büyük bir depo için yalnızca bu alt ağaçları alır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримує лише ці піддерева для репозиторію, завеликого для повного клонування."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Checkar bara ut dessa underträd, för en utvecklingskatalog som är för stor att klona i sin helhet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ lấy các cây con này, dành cho kho lưu trữ quá lớn để sao chép toàn bộ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya mengambil subpohon ini, untuk repositori yang terlalu besar untuk dikloning seluruhnya."
          }
        }
      }
    },
