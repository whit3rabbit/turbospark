            "value": "Arrastra sobre la forma de onda para seleccionar un rango que conservar o exportar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser sur la forme d'onde pour sélectionner une plage à conserver ou à exporter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור לאורך צורת הגל כדי לבחור טווח לשמירה או לייצוא."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रखने या निर्यात करने के लिए रेंज चुनने हेतु वेवफ़ॉर्म पर खींचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret di sepanjang bentuk gelombang untuk memilih rentang yang akan disimpan atau diekspor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina sulla forma d'onda per selezionare un intervallo da mantenere o esportare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "波形をドラッグして、残す範囲または書き出す範囲を選択します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "파형을 가로질러 드래그하여 유지하거나 내보낼 구간을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep over de golfvorm om een bereik te selecteren om te behouden of te exporteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij po wykresie fali, aby zaznaczyć fragment do zachowania lub eksportu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste sobre a forma de onda para selecionar um trecho para manter ou exportar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведите по волновой форме, чтобы выбрать фрагмент для сохранения или экспорта."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dra över vågformen för att markera ett intervall att behålla eller exportera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklamak veya dışa aktarmak için bir aralık seçmek üzere dalga biçimi boyunca sürükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проведіть по хвильовій формі, щоб вибрати фрагмент для збереження або експорту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kéo qua dạng sóng để chọn đoạn cần giữ hoặc xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在波形上拖动以选择要保留或导出的范围。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在波形上拖移以選取要保留或輸出的範圍。"
          }
        }
      }
    },
    "Drop an audio file here, import one, record your voice, or choose saved audio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drop an audio file here, import one, record your voice, or choose saved audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suelta aquí un archivo de audio, importa uno, graba tu voz o elige audio guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déposez un fichier audio ici, importez-en un, enregistrez votre voix ou choisissez un audio enregistré."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege hier eine Audiodatei ab, importiere eine, nimm deine Stimme auf oder wähle gespeichertes Audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina qui un file audio, importane uno, registra la tua voce o scegli un audio salvato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Solte um arquivo de áudio aqui, importe um, grave sua voz ou escolha um áudio salvo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетащите сюда аудиофайл, импортируйте его, запишите свой голос или выберите сохранённое аудио."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここに音声ファイルをドロップするか、読み込む、自分の声を録音する、保存した音声を選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 오디오 파일을 놓거나, 가져오거나, 목소리를 녹음하거나, 저장된 오디오를 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将音频文件拖到这里，或导入文件、录制你的声音、选择已保存的音频。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將音訊檔案拖到這裡，或匯入檔案、錄製你的聲音、選擇已儲存的音訊。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أفلت ملفًا صوتيًا هنا، أو استورد ملفًا، أو سجّل صوتك، أو اختر صوتًا محفوظًا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גרור לכאן קובץ שמע, ייבא קובץ, הקלט את הקול שלך או בחר שמע שמור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ ऑडियो फ़ाइल छोड़ें, कोई फ़ाइल आयात करें, अपनी आवाज़ रिकॉर्ड करें या सहेजा गया ऑडियो चुनें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep hier een audiobestand naartoe, importeer er een, neem je stem op of kies opgeslagen audio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Upuść tutaj plik audio, zaimportuj go, nagraj swój głos lub wybierz zapisany dźwięk."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ses dosyasını buraya bırakın, içe aktarın, sesinizi kaydedin veya kaydedilmiş bir ses seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перетягніть сюди аудіофайл, імпортуйте його, запишіть свій голос або виберіть збережене аудіо."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Släpp en ljudfil här, importera en, spela in din röst eller välj sparat ljud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thả tệp âm thanh vào đây, nhập tệp, ghi âm giọng của bạn hoặc chọn âm thanh đã lưu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan file audio di sini, impor file, rekam suara Anda, atau pilih audio tersimpan."
          }
        }
      }
    },
    "Dropped %lld older turns to fit the context window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأدوار الأقدم التي أُزيلت لملاءمة نافذة السياق: %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ältere Runden entfernt, um ins Kontextfenster zu passen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dropped %lld older turns to fit the context window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se descartaron %lld turnos anteriores para ajustarse a la ventana de contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld anciens tours retirés pour tenir dans la fenêtre de contexte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תורות ישנים שהוסרו כדי להתאים לחלון ההקשר: %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदर्भ विंडो में फ़िट करने के लिए %lld पुराने टर्न हटाए गए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld giliran lama dibuang agar muat di jendela konteks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld turni precedenti rimossi per rientrare nella finestra di contesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コンテキストウィンドウに収めるため、古いターンを %lld 件削除しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨텍스트 윈도우에 맞추기 위해 이전 턴 %lld개를 제외했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld oudere beurten verwijderd om binnen het contextvenster te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starsze tury usunięte, aby zmieścić się w oknie kontekstu: %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld turnos anteriores descartados para caber na janela de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалено старых ходов, чтобы уложиться в окно контекста: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld äldre turer togs bort för att rymmas i kontextfönstret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlam penceresine sığması için %lld eski tur çıkarıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалено старіших ходів, щоб вміститися у вікно контексту: %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã bỏ %lld lượt cũ để vừa cửa sổ ngữ cảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为适应上下文窗口，已移除 %lld 个较早的轮次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為符合上下文視窗，已移除 %lld 個較早的回合。"
          }
        }
      }
    },
