          "stringUnit": {
            "state": "translated",
            "value": "הגרסה המחודשת מעתיקה ביטויים ארוכים מהמקור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोबारा लिखा गया पाठ मूल पाठ से लंबे वाक्यांश ज्यों के त्यों उठाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil tulis ulang menyalin frasa panjang dari teks asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riscrittura copia frasi lunghe dall'originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き直しが元の文章の長いフレーズをそのまま使っています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 쓴 글이 원문의 긴 구절을 그대로 가져왔습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herschrijving neemt lange zinsneden over uit het origineel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisany tekst kopiuje długie fragmenty z oryginału."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reescrita copia trechos longos do original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переписанный текст дословно повторяет длинные фразы оригинала."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskrivningen kopierar långa fraser från originalet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yazım, orijinaldeki uzun ifadeleri aynen alıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Переписаний текст дослівно повторює довгі фрази оригіналу."
