    "Let the model remember across conversations": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0633\u0645\u0627\u062d \u0644\u0644\u0646\u0645\u0648\u0630\u062c \u0628\u0627\u0644\u062a\u0630\u0643\u0631 \u0639\u0628\u0631 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a"
