        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 x\u00f3a h\u1ed3 s\u01a1 \"%@\" (th\u01b0 m\u1ee5c c\u1ee7a h\u1ed3 s\u01a1 \u0111\u00e3 \u0111\u01b0\u1ee3c chuy\u1ec3n v\u00e0o Th\u00f9ng r\u00e1c)."
