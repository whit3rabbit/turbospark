        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan cara kerja proyek ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spiega come funziona questo progetto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u4ed5\u7d44\u307f\u3092\u8aac\u660e\u3057\u3066\u304f\u3060\u3055\u3044"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub85c\uc81d\ud2b8\uac00 \uc5b4\ub5bb\uac8c \uc791\ub3d9\ud558\ub294\uc9c0 \uc124\uba85\ud574\uc8fc\uc138\uc694"
