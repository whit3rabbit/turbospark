    "Benchmarks view: Live Graphs (click to switch to Numbers)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0631\u0636 \u0627\u0644\u0645\u0642\u0627\u064a\u064a\u0633: \u0631\u0633\u0648\u0645 \u0628\u064a\u0627\u0646\u064a\u0629 \u062d\u064a\u0629 (\u0627\u0646\u0642\u0631 \u0644\u0644\u062a\u0628\u062f\u064a\u0644 \u0625\u0644\u0649 \u0627\u0644\u0623\u0631\u0642\u0627\u0645)"
