    "Attach a project to see its memories.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0631\u0641\u0642 \u0645\u0634\u0631\u0648\u0639\u064b\u0627 \u0644\u0639\u0631\u0636 \u0630\u0627\u0643\u0631\u062a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e4ngen Sie ein Projekt an, um seine Memory-Eintr\u00e4ge zu sehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach a project to see its memories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta un proyecto para ver su memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Attachez un projet pour voir sa m\u00e9moire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05d1\u05e8\u05d5 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05d3\u05d9 \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e9\u05dc\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u094b \u0938\u0902\u0932\u0917\u094d\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0909\u0938\u0915\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u0926\u0947\u0916\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampirkan proyek untuk melihat memorinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega un progetto per vederne la memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u63a5\u7d9a\u3059\u308b\u3068\u3001\u305d\u306e\u30e1\u30e2\u30ea\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8\ub97c \uc5f0\uacb0\ud558\uba74 \ud574\ub2f9 \uba54\ubaa8\ub9ac\uac00 \ud45c\uc2dc\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel een project om het geheugen ervan te zien."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do\u0142\u0105cz projekt, aby zobaczy\u0107 jego pami\u0119\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe um projeto para ver a mem\u00f3ria dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043f\u0440\u043e\u0435\u043a\u0442, \u0447\u0442\u043e\u0431\u044b \u0432\u0438\u0434\u0435\u0442\u044c \u0435\u0433\u043e \u043f\u0430\u043c\u044f\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppla ett projekt f\u00f6r att se dess minne."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belle\u011fini g\u00f6rmek i\u00e7in bir proje ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0456\u0442\u044c \u043f\u0440\u043e\u0454\u043a\u0442, \u0449\u043e\u0431 \u0431\u0430\u0447\u0438\u0442\u0438 \u0439\u043e\u0433\u043e \u043f\u0430\u043c'\u044f\u0442\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00ednh k\u00e8m m\u1ed9t d\u1ef1 \u00e1n \u0111\u1ec3 xem b\u1ed9 nh\u1edb c\u1ee7a d\u1ef1 \u00e1n \u0111\u00f3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9644\u52a0\u4e00\u4e2a\u9879\u76ee\u4ee5\u67e5\u770b\u5176\u8bb0\u5fc6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9644\u52a0\u4e00\u500b\u5c08\u6848\u4ee5\u67e5\u770b\u5176\u8a18\u61b6\u3002"
          }
        }
      }
    },
