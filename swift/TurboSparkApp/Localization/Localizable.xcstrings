            "state": "translated",
            "value": "\u91cd\u65b0\u8f09\u5165\u4ee5\u5957\u7528"
          }
        }
      }
    },
    "Download a GGUF control vector, check its shape, and select it for the next model load.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u0645 \u0628\u062a\u0646\u0632\u064a\u0644 \u0645\u062a\u062c\u0647 \u062a\u062d\u0643\u0645 GGUF \u0648\u062a\u062d\u0642\u0642 \u0645\u0646 \u0634\u0643\u0644\u0647 \u0648\u062d\u062f\u062f\u0647 \u0644\u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062a\u0627\u0644\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie einen GGUF-Kontrollvektor herunter, \u00fcberpr\u00fcfen Sie seine Form und w\u00e4hlen Sie ihn f\u00fcr den n\u00e4chsten Modellladevorgang aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download a GGUF control vector, check its shape, and select it for the next model load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga un vector de control GGUF, comprueba su forma y selecci\u00f3nalo para la pr\u00f3xima carga del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e9l\u00e9chargez un vecteur de contr\u00f4le GGUF, v\u00e9rifiez sa forme et s\u00e9lectionnez-le pour le prochain chargement de mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e8\u05d3 \u05d5\u05e7\u05d8\u05d5\u05e8 \u05d1\u05e7\u05e8\u05ea GGUF, \u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05e6\u05d5\u05e8\u05ea\u05d5 \u05d5\u05d1\u05d7\u05e8 \u05d1\u05d5 \u05dc\u05d8\u05e2\u05d9\u05e0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d1\u05d0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 GGUF \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0935\u0947\u0915\u094d\u091f\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902, \u0907\u0938\u0915\u0947 \u0906\u0915\u093e\u0930 \u0915\u0940 \u091c\u093e\u0902\u091a \u0915\u0930\u0947\u0902, \u0914\u0930 \u0907\u0938\u0947 \u0905\u0917\u0932\u0947 \u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0915\u0947 \u0932\u093f\u090f \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh vektor kontrol GGUF, periksa bentuknya, dan pilih untuk pemuatan model berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica un vettore di controllo GGUF, controllane la forma e selezionalo per il successivo caricamento del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30d9\u30af\u30c8\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3001\u305d\u306e\u5f62\u72b6\u3092\u78ba\u8a8d\u3057\u3066\u3001\u6b21\u56de\u306e\u30e2\u30c7\u30eb\u30ed\u30fc\u30c9\u7528\u306b\u9078\u629e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF \uc81c\uc5b4 \ubca1\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \ud615\uc0c1\uc744 \ud655\uc778\ud55c \ud6c4 \ub2e4\uc74c \ubaa8\ub378 \ub85c\ub4dc \uc2dc \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download een GGUF-controlevector, controleer de vorm en selecteer deze voor de volgende modellading."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz wektor kontrolny GGUF, sprawd\u017a jego kszta\u0142t i wybierz go do nast\u0119pnego za\u0142adowania modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe um vetor de controle GGUF, verifique sua forma e selecione-o para o pr\u00f3ximo carregamento do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u0432\u0435\u043a\u0442\u043e\u0440 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f GGUF, \u043f\u0440\u043e\u0432\u0435\u0440\u044c\u0442\u0435 \u0435\u0433\u043e \u0444\u043e\u0440\u043c\u0443 \u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u043b\u044f \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ner en GGUF-kontrollvektor, kontrollera dess form och v\u00e4lj den f\u00f6r n\u00e4sta modellinl\u00e4sning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir GGUF kontrol vekt\u00f6r\u00fc indirin, \u015feklini kontrol edin ve bir sonraki model y\u00fcklemesi i\u00e7in se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u0438\u0439 \u0432\u0435\u043a\u0442\u043e\u0440 GGUF, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0442\u0435 \u0439\u043e\u0433\u043e \u0444\u043e\u0440\u043c\u0443 \u0442\u0430 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u043b\u044f \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i xu\u1ed1ng vector \u0111i\u1ec1u khi\u1ec3n GGUF, ki\u1ec3m tra h\u00ecnh d\u1ea1ng c\u1ee7a n\u00f3 v\u00e0 ch\u1ecdn n\u00f3 cho l\u1ea7n t\u1ea3i m\u00f4 h\u00ecnh ti\u1ebfp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f7d GGUF \u63a7\u5236\u5411\u91cf\uff0c\u68c0\u67e5\u5176\u5f62\u72b6\uff0c\u5e76\u5c06\u5176\u9009\u7528\u4e8e\u4e0b\u4e00\u6b21\u6a21\u578b\u52a0\u8f7d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f09 GGUF \u63a7\u5236\u5411\u91cf\uff0c\u6aa2\u67e5\u5176\u5f62\u72c0\uff0c\u4e26\u5c07\u5176\u9078\u7528\u65bc\u4e0b\u4e00\u6b21\u6a21\u578b\u8f09\u5165\u3002"
          }
        }
      }
    },
