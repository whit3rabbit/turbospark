        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa esportazione supera il limite di dimensione standard dei file ZIP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u66f8\u304d\u51fa\u3057\u306f\u6a19\u6e96 ZIP \u306e\u30b5\u30a4\u30ba\u4e0a\u9650\u3092\u8d85\u3048\u3066\u3044\u307e\u3059\u3002"
