            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0441\u0442\u0438\u043b\u0456\u0432, \u0449\u043e \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u044e\u0442\u044c \u0432\u0430\u0448\u043e\u043c\u0443 \u0437\u0430\u043f\u0438\u0442\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga stilar matchar din s\u00f6kning."
