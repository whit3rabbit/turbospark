        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05e2\u05e7\u05d9\u05e4\u05ea \u05ea\u05d5\u05e1\u05e3 \u05dc\u05e4\u05d9 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u093f-\u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u092a\u094d\u0932\u0917\u0907\u0928 \u0913\u0935\u0930\u0930\u093e\u0907\u0921 \u0938\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih proyek untuk mengatur penggantian plugin per proyek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona un progetto per impostare un override del plugin per progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3054\u3068\u306b\u30d7\u30e9\u30b0\u30a4\u30f3\u8a2d\u5b9a\u3092\u4e0a\u66f8\u304d\u3059\u308b\u306b\u306f\u3001\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8\ubcc4 \ud50c\ub7ec\uadf8\uc778 \uc7ac\uc815\uc758\ub97c \uc124\uc815\ud558\ub824\uba74 \ud504\ub85c\uc81d\ud2b8\ub97c \uc120\ud0dd\ud558\uc138\uc694."
