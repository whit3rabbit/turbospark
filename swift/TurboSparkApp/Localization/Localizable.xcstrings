    "Approve once and stop using the classifier for the rest of this session": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة مرة واحدة والتوقف عن استخدام المصنف لبقية هذه الجلسة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal genehmigen und den Klassifikator für den Rest dieser Sitzung nicht mehr verwenden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve once and stop using the classifier for the rest of this session"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar una vez y dejar de usar el clasificador durante el resto de esta sesión"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver une fois et ne plus utiliser le classificateur pour le reste de cette session"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר פעם אחת והפסק להשתמש במסווג עד סוף ההפעלה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक बार स्वीकृत करें और इस सत्र के बाकी समय क्लासिफ़ायर का उपयोग बंद करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setujui sekali dan berhenti menggunakan pengklasifikasi selama sisa sesi ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva una volta e smetti di usare il classificatore per il resto della sessione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1回だけ承認し、このセッションの残りでは分類器を使用しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번 승인하고 이 세션의 나머지 동안 분류기 사용 중지"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eenmaal goedkeuren en de classificatie de rest van deze sessie niet meer gebruiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdź raz i przestań używać klasyfikatora do końca tej sesji"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar uma vez e parar de usar o classificador pelo resto desta sessão"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрить один раз и не использовать классификатор до конца этого сеанса"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkänn en gång och sluta använda klassificeraren under resten av sessionen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kez onayla ve bu oturumun geri kalanında sınıflandırıcıyı kullanma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схвалити один раз і не використовувати класифікатор до кінця цього сеансу"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chấp thuận một lần và ngừng dùng bộ phân loại trong phần còn lại của phiên này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准一次，并在本会话剩余时间内停用分类器"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准一次，並在本工作階段剩餘時間內停用分類器"
          }
        }
      }
    },
    "Approve this server and every server this project declares in the future without prompting": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الموافقة على هذا الخادم وعلى كل خادم يعرّفه هذا المشروع مستقبلًا دون سؤال"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Server und alle künftig von diesem Projekt deklarierten Server ohne Nachfrage genehmigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve this server and every server this project declares in the future without prompting"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar este servidor y todos los que este proyecto declare en el futuro sin preguntar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver ce serveur et tous ceux que ce projet déclarera à l'avenir, sans demander"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אשר שרת זה וכל שרת שהפרויקט יצהיר עליו בעתיד, ללא שאלה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सर्वर और भविष्य में यह प्रोजेक्ट जो भी सर्वर घोषित करे, सबको बिना पूछे अनुमोदित करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setujui server ini dan semua server yang dideklarasikan proyek ini di masa depan tanpa bertanya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva questo server e tutti quelli che il progetto dichiarerà in futuro, senza chiedere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーと、今後このプロジェクトが宣言するすべてのサーバーを確認なしで承認"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버와 이 프로젝트가 앞으로 선언하는 모든 서버를 묻지 않고 승인"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server en elke server die dit project later declareert zonder vragen goedkeuren"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdź ten serwer i każdy serwer, który ten projekt zadeklaruje w przyszłości, bez pytania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar este servidor e todos os que este projeto declarar no futuro sem perguntar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрить этот сервер и все серверы, которые проект объявит в будущем, без запроса"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Godkänn den här servern och alla servrar som projektet deklarerar i framtiden utan att fråga"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucuyu ve bu projenin gelecekte tanımlayacağı tüm sunucuları sormadan onayla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схвалити цей сервер і всі сервери, які проєкт оголосить у майбутньому, без запиту"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duyệt máy chủ này và mọi máy chủ dự án khai báo sau này mà không hỏi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准此服务器以及此项目今后声明的所有服务器，不再询问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准此伺服器以及此專案日後宣告的所有伺服器，不再詢問"
          }
        }
      }
    },
