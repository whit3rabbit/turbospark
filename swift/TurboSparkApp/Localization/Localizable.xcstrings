          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u6307\u5b9a reasoning_effort \u7684\u4f20\u5165\u8bf7\u6c42\u6240\u7528\u7684\u9ed8\u8ba4\u63a8\u7406\u5f3a\u5ea6\uff0c\u4e0e CLI \u7684 --reasoning \u76f8\u540c\u3002"
