        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d2\u05d5\u05dc\u05de\u05d9\u05ea \u05de\u05d3\u05d5\u05e8 \u05e7\u05d5\u05d3\u05dd, \u05dc\u05dc\u05d0 \u05ea\u05d1\u05e0\u05d9\u05ea \u05e6'\u05d0\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0930\u093e\u0928\u093e \u0930\u0949 \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f, \u092c\u093f\u0928\u093e \u091a\u0948\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0915\u0947\u0964"
