        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5de5\u5177\u300c%@\u300d\u7684\u5f15\u6578\u7d50\u69cb\u5728 %@ \u8655\u4e0d\u53d7\u652f\u63f4\u3002"
