            "value": "此模型系列不支援即時引導。"
          }
        }
      }
    },
    "This model family runs here, but no recorded test covers these files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
