    "Older tool-result bodies are shortened only in model requests. The saved transcript remains unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم اختصار نص نتائج الأدوات القديمة فقط في طلبات النموذج. يظل النص المحفوظ دون تغيير."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur die Inhalte älterer Tool-Ergebnisse werden in Modellanfragen gekürzt. Das gespeicherte Transkript bleibt unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older tool-result bodies are shortened only in model requests. The saved transcript remains unchanged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se acorta el contenido de los resultados antiguos de herramientas en las solicitudes al modelo. La transcripción guardada no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les contenus des anciens résultats d’outils sont raccourcis dans les requêtes au modèle. La transcription enregistrée reste inchangée."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק תוכן התוצאות הישנות של כלים מתקצר בבקשות למודל. התמליל השמור נשאר ללא שינוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल अनुरोधों में केवल पुराने टूल नतीजों का मुख्य भाग छोटा किया जाता है। सहेजी गई बातचीत नहीं बदलती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya isi hasil alat yang lama dipersingkat dalam permintaan ke model. Transkrip yang disimpan tetap sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nelle richieste al modello vengono abbreviati solo i contenuti dei vecchi risultati degli strumenti. La trascrizione salvata non cambia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルへのリクエストでは、古いツール結果の本文だけを短縮します。保存された文字起こしは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 요청에서는 오래된 도구 결과의 내용만 줄입니다. 저장된 대화 기록은 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de inhoud van oudere toolresultaten wordt ingekort in modelverzoeken. Het opgeslagen transcript blijft ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W żądaniach do modelu skracana jest tylko treść starszych wyników narzędzi. Zapisany transkrypt pozostaje bez zmian."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente o conteúdo de resultados antigos das ferramentas é encurtado nas solicitações ao modelo. A transcrição salva permanece igual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В запросах к модели сокращается только содержимое старых результатов инструментов. Сохраненная стенограмма остается неизменной."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast innehållet i äldre verktygsresultat kortas i modellförfrågningar. Den sparade transkriptionen ändras inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model isteklerinde yalnızca eski araç sonuçlarının içeriği kısaltılır. Kaydedilen döküm değişmeden kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У запитах до моделі скорочується лише вміст старих результатів інструментів. Збережений транскрипт не змінюється."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ phần nội dung của kết quả công cụ cũ được rút gọn trong yêu cầu gửi đến mô hình. Bản ghi đã lưu không thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在发给模型的请求中，仅缩短较早工具结果的正文。已保存的对话记录保持不变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在傳送給模型的請求中，只會縮短較早工具結果的內容。已儲存的對話記錄維持不變。"
          }
        }
      }
    },
    "Older turns are summarized automatically once this reaches zero.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُلخَّص الأدوار الأقدم تلقائيًا عندما تصل هذه القيمة إلى الصفر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Runden werden automatisch zusammengefasst, sobald dieser Wert null erreicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Older turns are summarized automatically once this reaches zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los turnos anteriores se resumen automáticamente cuando esto llega a cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les anciens tours sont résumés automatiquement quand cette valeur atteint zéro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תורות ישנים מסוכמים אוטומטית כשהערך מגיע לאפס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह शून्य पर पहुँचते ही पुराने टर्न का सारांश अपने आप बन जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Giliran lama diringkas otomatis setelah nilai ini mencapai nol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I turni precedenti vengono riepilogati automaticamente quando questo valore arriva a zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この値がゼロになると、古いターンが自動的に要約されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 값이 0이 되면 이전 턴이 자동으로 요약됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudere beurten worden automatisch samengevat zodra dit nul bereikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Starsze tury są automatycznie podsumowywane, gdy ta wartość spadnie do zera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os turnos antigos são resumidos automaticamente quando isso chega a zero."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Старые реплики автоматически сводятся, когда это значение достигает нуля."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Äldre turer sammanfattas automatiskt när detta når noll."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu değer sıfıra ulaştığında eski turlar otomatik olarak özetlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
