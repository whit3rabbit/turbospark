        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una grabaci\u00f3n mejorada o separa las pistas conservando el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cr\u00e9ez un enregistrement am\u00e9lior\u00e9 ou s\u00e9parez les pistes en conservant l'original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstelle eine bereinigte Aufnahme oder trenne Spuren und behalte das Original."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una registrazione migliorata o separa le tracce mantenendo l'originale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Crie uma grava\u00e7\u00e3o aprimorada ou separe as faixas mantendo o original."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak een opgeschoonde opname of splits de sporen en behoud het origineel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skapa en f\u00f6rb\u00e4ttrad inspelning eller separera sp\u00e5r och beh\u00e5ll originalet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utw\u00f3rz oczyszczone nagranie lub rozdziel \u015bcie\u017cki, zachowuj\u0105c orygina\u0142."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orijinali koruyarak temizlenmi\u015f bir kay\u0131t olu\u015fturun veya kanallar\u0131 ay\u0131r\u0131n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buat rekaman yang lebih jernih atau pisahkan stem sambil mempertahankan aslinya."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u043e\u0447\u0438\u0449\u0435\u043d\u043d\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c \u0438\u043b\u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u0438\u0442\u0435 \u0434\u043e\u0440\u043e\u0436\u043a\u0438, \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0432 \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u043e\u0447\u0438\u0449\u0435\u043d\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0430\u0431\u043e \u0440\u043e\u0437\u0434\u0456\u043b\u0456\u0442\u044c \u0434\u043e\u0440\u0456\u0436\u043a\u0438, \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0447\u0438 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea1o b\u1ea3n ghi \u0111\u01b0\u1ee3c l\u00e0m s\u1ea1ch ho\u1eb7c t\u00e1ch c\u00e1c b\u00e8 \u00e2m thanh v\u00e0 gi\u1eef nguy\u00ean b\u1ea3n g\u1ed1c."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5143\u306e\u97f3\u58f0\u3092\u6b8b\u3057\u305f\u307e\u307e\u3001\u97f3\u8cea\u3092\u6539\u5584\u3057\u305f\u9332\u97f3\u3084\u5206\u96e2\u3057\u305f\u30b9\u30c6\u30e0\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6d0\ubcf8\uc744 \ubcf4\uc874\ud558\uba74\uc11c \uc815\ub9ac\ub41c \ub179\uc74c\uc744 \ub9cc\ub4e4\uac70\ub098 \uc2a4\ud15c\uc744 \ubd84\ub9ac\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4fdd\u7559\u539f\u59cb\u97f3\u9891\u7684\u540c\u65f6\uff0c\u521b\u5efa\u964d\u566a\u5f55\u97f3\u6216\u5206\u79bb\u5206\u8f68\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4fdd\u7559\u539f\u59cb\u97f3\u8a0a\u7684\u540c\u6642\uff0c\u5efa\u7acb\u964d\u566a\u9304\u97f3\u6216\u5206\u96e2\u5206\u8ecc\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0646\u0634\u0626 \u062a\u0633\u062c\u064a\u0644\u0627\u064b \u0645\u0646\u0642\u0651\u0649 \u0623\u0648 \u0627\u0641\u0635\u0644 \u0627\u0644\u0645\u0633\u0627\u0631\u0627\u062a \u0645\u0639 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0627\u0644\u0623\u0635\u0644."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e6\u05d5\u05e8 \u05d4\u05e7\u05dc\u05d8\u05d4 \u05e0\u05e7\u05d9\u05d9\u05d4 \u05d0\u05d5 \u05d4\u05e4\u05e8\u05d3 \u05e2\u05e8\u05d5\u05e6\u05d9\u05dd \u05ea\u05d5\u05da \u05e9\u05de\u05d9\u05e8\u05ea \u05d4\u05de\u05e7\u05d5\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0942\u0932 \u0911\u0921\u093f\u092f\u094b \u0915\u094b \u0930\u0916\u0924\u0947 \u0939\u0941\u090f \u0938\u093e\u092b\u093c \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u092c\u0928\u093e\u090f\u0901 \u092f\u093e \u0905\u0932\u0917 \u091f\u094d\u0930\u0948\u0915 \u0928\u093f\u0915\u093e\u0932\u0947\u0902\u0964"
          }
        }
      }
    },
