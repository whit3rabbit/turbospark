    "Queued behind the running turn; drains when it finishes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631 \u062e\u0644\u0641 \u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u062c\u0627\u0631\u064a\u061b \u064a\u064f\u0631\u0633\u0644 \u0639\u0646\u062f \u0627\u0646\u062a\u0647\u0627\u0626\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet hinter dem laufenden Durchlauf; wird gesendet, wenn er abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued behind the running turn; drains when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola detr\u00e1s del turno en curso; se env\u00eda cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En file derri\u00e8re le tour en cours ; envoy\u00e9 quand il se termine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05ea\u05d5\u05e8 \u05de\u05d0\u05d7\u05d5\u05e8\u05d9 \u05d4\u05ea\u05d5\u05e8 \u05d4\u05e4\u05e2\u05d9\u05dc; \u05d9\u05d9\u05e9\u05dc\u05d7 \u05db\u05e9\u05d9\u05e1\u05ea\u05d9\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0932 \u0930\u0939\u0947 \u091f\u0930\u094d\u0928 \u0915\u0947 \u092a\u0940\u091b\u0947 \u0915\u0924\u093e\u0930 \u092e\u0947\u0902; \u0909\u0938\u0915\u0947 \u092a\u0942\u0930\u093e \u0939\u094b\u0928\u0947 \u092a\u0930 \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengantre di belakang giliran yang berjalan; terkirim saat giliran selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda dietro il turno in corso; viene inviato quando termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9f\u884c\u4e2d\u306e\u30bf\u30fc\u30f3\u306e\u5f8c\u306b\u5f85\u6a5f\u4e2d\u3002\u30bf\u30fc\u30f3\u7d42\u4e86\u5f8c\u306b\u9001\u4fe1\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\ud589 \uc911\uc778 \ud134 \ub4a4\uc5d0\uc11c \ub300\uae30 \uc911\uc774\uba70, \ud134\uc774 \ub05d\ub098\uba74 \uc804\uc1a1\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de wachtrij achter de lopende beurt; wordt verzonden zodra die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kolejce za bie\u017c\u0105c\u0105 tur\u0105; zostanie wys\u0142ane po jej zako\u0144czeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fila atr\u00e1s do turno em andamento; ser\u00e1 enviado quando ele terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043e\u0447\u0435\u0440\u0435\u0434\u0438 \u0437\u0430 \u0442\u0435\u043a\u0443\u0449\u0438\u043c \u0445\u043e\u0434\u043e\u043c; \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u043e\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I k\u00f6 bakom det p\u00e5g\u00e5ende varvet; skickas n\u00e4r det \u00e4r klart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c7al\u0131\u015fan turun arkas\u0131nda s\u0131rada; tur bitince g\u00f6nderilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0447\u0435\u0440\u0437\u0456 \u0437\u0430 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u043c \u0445\u043e\u0434\u043e\u043c; \u043d\u0430\u0434\u0456\u0448\u043b\u0435\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0432\u0456\u043d \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110ang x\u1ebfp sau l\u01b0\u1ee3t \u0111ang ch\u1ea1y; s\u1ebd g\u1eedi khi l\u01b0\u1ee3t \u0111\u00f3 xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6392\u5728\u5f53\u524d\u56de\u5408\u4e4b\u540e\uff1b\u56de\u5408\u7ed3\u675f\u540e\u81ea\u52a8\u53d1\u9001\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6392\u5728\u76ee\u524d\u56de\u5408\u4e4b\u5f8c\uff1b\u56de\u5408\u7d50\u675f\u5f8c\u81ea\u52d5\u9001\u51fa\u3002"
          }
        }
      }
    },
