        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d5\u05de\u05e8 \u05d4\u05db\u05d5\u05dc \u05d5\u05de\u05e4\u05e2\u05d9\u05dc \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e2\u05dd \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d6\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u092c \u0915\u0941\u091b \u0938\u0939\u0947\u091c\u0924\u093e \u0939\u0948 \u0914\u0930 \u0910\u092a \u0915\u094b \u0907\u0938 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0926\u094b\u092c\u093e\u0930\u093e \u0932\u0949\u0928\u094d\u091a \u0915\u0930\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
