          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1eefng g\u00ec c\u1ea7n \u0111\u01b0a v\u00e0o b\u1ea3n sao l\u01b0u n\u00e0y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u5907\u4efd\u8981\u5305\u542b\u54ea\u4e9b\u5185\u5bb9"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u5099\u4efd\u8981\u5305\u542b\u54ea\u4e9b\u5167\u5bb9"
          }
        }
      }
    },
    "What would you like to build or explore?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0627\u0630\u0627 \u062a\u0648\u062f \u0623\u0646 \u062a\u0628\u0646\u064a \u0623\u0648 \u062a\u0633\u062a\u0643\u0634\u0641\u061f"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was m\u00f6chten Sie erstellen oder erkunden?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What would you like to build or explore?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfQu\u00e9 te gustar\u00eda construir o explorar?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Que souhaitez-vous cr\u00e9er ou explorer ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d4 \u05ea\u05e8\u05e6\u05d4 \u05dc\u05d1\u05e0\u05d5\u05ea \u05d0\u05d5 \u05dc\u05d7\u05e7\u05d5\u05e8?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a \u0915\u094d\u092f\u093e \u092c\u0928\u093e\u0928\u093e \u092f\u093e \u0916\u094b\u091c\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u0948\u0902?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ingin Anda buat atau jelajahi?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa vorresti costruire o esplorare?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f55\u3092\u4f5c\u6210\u307e\u305f\u306f\u63a2\u7d22\u3057\u305f\u3044\u3067\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb34\uc5c7\uc744 \ub9cc\ub4e4\uac70\ub098 \ud0d0\uc0c9\ud558\uace0 \uc2f6\uc73c\uc2e0\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat wil je bouwen of ontdekken?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co chcia\u0142by\u015b zbudowa\u0107 lub odkry\u0107?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que voc\u00ea gostaria de construir ou explorar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0442\u043e \u0431\u044b \u0432\u044b \u0445\u043e\u0442\u0435\u043b\u0438 \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0438\u043b\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u0442\u044c?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad vill du bygga eller utforska?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne olu\u015fturmak veya ke\u015ffetmek istersiniz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0429\u043e \u0431 \u0432\u0438 \u0445\u043e\u0442\u0456\u043b\u0438 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0447\u0438 \u0434\u043e\u0441\u043b\u0456\u0434\u0438\u0442\u0438?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea1n mu\u1ed1n x\u00e2y d\u1ef1ng ho\u1eb7c kh\u00e1m ph\u00e1 \u0111i\u1ec1u g\u00ec?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u60f3\u6784\u5efa\u6216\u63a2\u7d22\u4ec0\u4e48\uff1f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u60a8\u60f3\u8981\u5efa\u69cb\u6216\u63a2\u7d22\u4ec0\u9ebc\uff1f"
          }
        }
      }
    },
    "When enabled, closing the main window leaves the server and menu bar active. Use Quit TurboSpark from the menu bar or Command-Q to exit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0646\u062f \u0627\u0644\u062a\u0645\u0643\u064a\u0646\u060c \u064a\u0624\u062f\u064a \u0625\u063a\u0644\u0627\u0642 \u0627\u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629 \u0625\u0644\u0649 \u062a\u0631\u0643 \u0627\u0644\u062e\u0627\u062f\u0645 \u0648\u0634\u0631\u064a\u0637 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0646\u0634\u0637\u064a\u0646. \u0627\u0633\u062a\u062e\u062f\u0645 \u0625\u0646\u0647\u0627\u0621 TurboSpark \u0645\u0646 \u0634\u0631\u064a\u0637 \u0627\u0644\u0642\u0648\u0627\u0626\u0645 \u0623\u0648 Command-Q \u0644\u0644\u062e\u0631\u0648\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn aktiviert, bleibt der Server und die Men\u00fcleiste aktiv, wenn das Hauptfenster geschlossen wird. Verwenden Sie TurboSpark beenden in der Men\u00fcleiste oder Befehl-Q zum Beenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When enabled, closing the main window leaves the server and menu bar active. Use Quit TurboSpark from the menu bar or Command-Q to exit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando est\u00e1 habilitado, cerrar la ventana principal deja activos el servidor y la barra de men\u00fas. Usa Salir de TurboSpark en la barra de men\u00fas o Comando-Q para salir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lorsqu'elle est activ\u00e9e, la fermeture de la fen\u00eatre principale laisse le serveur et la barre de menus actifs. Utilisez Quitter TurboSpark dans la barre de menus ou Commande-Q pour quitter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05d0\u05e9\u05e8 \u05de\u05d5\u05e4\u05e2\u05dc, \u05e1\u05d2\u05d9\u05e8\u05ea \u05d4\u05d7\u05dc\u05d5\u05df \u05d4\u05e8\u05d0\u05e9\u05d9 \u05de\u05e9\u05d0\u05d9\u05e8\u05d4 \u05d0\u05ea \u05d4\u05e9\u05e8\u05ea \u05d5\u05e9\u05d5\u05e8\u05ea \u05d4\u05ea\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05e4\u05e2\u05d9\u05dc\u05d9\u05dd. \u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d9\u05e6\u05d9\u05d0\u05d4 \u05de-TurboSpark \u05de\u05e9\u05d5\u05e8\u05ea \u05d4\u05ea\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d0\u05d5 \u05d1-Command-Q \u05db\u05d3\u05d9 \u05dc\u05e6\u05d0\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0915\u094d\u0937\u092e \u0939\u094b\u0928\u0947 \u092a\u0930, \u092e\u0941\u0916\u094d\u092f \u0935\u093f\u0902\u0921\u094b \u0915\u094b \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0938\u0930\u094d\u0935\u0930 \u0914\u0930 \u092e\u0947\u0928\u0942 \u092c\u093e\u0930 \u0938\u0915\u094d\u0930\u093f\u092f \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0947\u0928\u0942 \u092c\u093e\u0930 \u0938\u0947 TurboSpark \u091b\u094b\u0921\u093c\u0947\u0902 \u092f\u093e Command-Q \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saat diaktifkan, menutup jendela utama akan membiarkan server dan bilah menu tetap aktif. Gunakan Keluar dari TurboSpark dari bilah menu atau Command-Q untuk keluar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando abilitato, la chiusura della finestra principale lascia attivi il server e la barra dei menu. Usa Esci da TurboSpark dalla barra dei menu o Comando-Q per uscire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u52b9\u306b\u3059\u308b\u3068\u3001\u30e1\u30a4\u30f3\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u9589\u3058\u3066\u3082\u30b5\u30fc\u30d0\u30fc\u3068\u30e1\u30cb\u30e5\u30fc\u30d0\u30fc\u304c\u30a2\u30af\u30c6\u30a3\u30d6\u306e\u307e\u307e\u306b\u306a\u308a\u307e\u3059\u3002\u7d42\u4e86\u3059\u308b\u306b\u306f\u30e1\u30cb\u30e5\u30fc\u30d0\u30fc\u306e [TurboSpark \u3092\u7d42\u4e86] \u307e\u305f\u306f Command-Q \u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud65c\uc131\ud654\ud558\uba74 \uba54\uc778 \ucc3d\uc744 \ub2eb\uc544\ub3c4 \uc11c\ubc84\uc640 \uba54\ub274 \ub9c9\ub300\uac00 \ud65c\uc131 \uc0c1\ud0dc\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4. \uc885\ub8cc\ud558\ub824\uba74 \uba54\ub274 \ub9c9\ub300\uc5d0\uc11c TurboSpark \uc885\ub8cc\ub97c \uc0ac\uc6a9\ud558\uac70\ub098 Command-Q\ub97c \ub204\ub974\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indien ingeschakeld, laat het sluiten van het hoofdvenster de server en menubalk actief. Gebruik TurboSpark stoppen in de menubalk of Command-Q om af te sluiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy ta opcja jest w\u0142\u0105czona, zamkni\u0119cie g\u0142\u00f3wnego okna pozostawia serwer i pasek menu aktywnymi. U\u017cyj opcji Zako\u0144cz TurboSpark z paska menu lub skr\u00f3tu Command-Q, aby wyj\u015b\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando ativado, fechar a janela principal mant\u00e9m o servidor e a barra de menus ativos. Use Encerrar TurboSpark na barra de menus ou Command-Q para sair."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0441\u043b\u0438 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u0437\u0430\u043a\u0440\u044b\u0442\u0438\u0435 \u0433\u043b\u0430\u0432\u043d\u043e\u0433\u043e \u043e\u043a\u043d\u0430 \u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0441\u0435\u0440\u0432\u0435\u0440 \u0438 \u0441\u0442\u0440\u043e\u043a\u0443 \u043c\u0435\u043d\u044e \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c\u0438. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043f\u0443\u043d\u043a\u0442 \u00ab\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u044c TurboSpark\u00bb \u0432 \u0441\u0442\u0440\u043e\u043a\u0435 \u043c\u0435\u043d\u044e \u0438\u043b\u0438 Command-Q \u0434\u043b\u044f \u0432\u044b\u0445\u043e\u0434\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e4r den \u00e4r aktiverad l\u00e4mnar st\u00e4ngning av huvudf\u00f6nstret servern och menyraden aktiva. Anv\u00e4nd Avsluta TurboSpark fr\u00e5n menyraden eller Command-Q f\u00f6r att avsluta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinle\u015ftirildi\u011finde, ana pencerenin kapat\u0131lmas\u0131 sunucuyu ve men\u00fc \u00e7ubu\u011funu etkin b\u0131rak\u0131r. \u00c7\u0131kmak i\u00e7in men\u00fc \u00e7ubu\u011fundan TurboSpark'tan \u00c7\u0131k'\u0131 veya Command-Q'yu kullan\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f\u043a\u0449\u043e \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e, \u0437\u0430\u043a\u0440\u0438\u0442\u0442\u044f \u0433\u043e\u043b\u043e\u0432\u043d\u043e\u0433\u043e \u0432\u0456\u043a\u043d\u0430 \u0437\u0430\u043b\u0438\u0448\u0430\u0454 \u0441\u0435\u0440\u0432\u0435\u0440 \u0456 \u0440\u044f\u0434\u043e\u043a \u043c\u0435\u043d\u044e \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u043c\u0438. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u043f\u0443\u043d\u043a\u0442 \u00ab\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0438 TurboSpark\u00bb \u0443 \u0440\u044f\u0434\u043a\u0443 \u043c\u0435\u043d\u044e \u0430\u0431\u043e Command-Q \u0434\u043b\u044f \u0432\u0438\u0445\u043e\u0434\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi \u0111\u01b0\u1ee3c b\u1eadt, vi\u1ec7c \u0111\u00f3ng c\u1eeda s\u1ed5 ch\u00ednh v\u1eabn gi\u1eef cho m\u00e1y ch\u1ee7 v\u00e0 thanh menu ho\u1ea1t \u0111\u1ed9ng. S\u1eed d\u1ee5ng Tho\u00e1t TurboSpark t\u1eeb thanh menu ho\u1eb7c Command-Q \u0111\u1ec3 tho\u00e1t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u542f\u7528\u540e\uff0c\u5173\u95ed\u4e3b\u7a97\u53e3\u4ecd\u4f1a\u4fdd\u6301\u670d\u52a1\u5668\u548c\u83dc\u5355\u680f\u5904\u4e8e\u6d3b\u52a8\u72b6\u6001\u3002\u4ece\u83dc\u5355\u680f\u4e2d\u9009\u62e9\u201c\u9000\u51fa TurboSpark\u201d\u6216\u4f7f\u7528 Command-Q \u9000\u51fa\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u555f\u7528\u5f8c\uff0c\u95dc\u9589\u4e3b\u8996\u7a97\u4ecd\u6703\u4fdd\u6301\u4f3a\u670d\u5668\u548c\u9078\u55ae\u5217\u8655\u65bc\u6d3b\u52d5\u72c0\u614b\u3002\u5f9e\u9078\u55ae\u5217\u4e2d\u9078\u64c7\u300c\u7d50\u675f TurboSpark\u300d\u6216\u4f7f\u7528 Command-Q \u9000\u51fa\u3002"
          }
        }
      }
    },
