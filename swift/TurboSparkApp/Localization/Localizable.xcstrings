          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0928\u0947\u0915\u094d\u0936\u0928 \u091c\u093e\u0901\u091a\u0947\u0902 \u0914\u0930 \u091f\u0942\u0932 \u0916\u094b\u091c\u0947\u0902"
