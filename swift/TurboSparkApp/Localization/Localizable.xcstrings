    "Cannot save project while generation or tool execution is active": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot save project while generation or tool execution is active"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede guardar el proyecto mientras la generación o la ejecución de herramientas están activas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer le projet pendant que la génération ou l'exécution d'un outil est active"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt kann nicht gespeichert werden, während Generierung oder Werkzeugausführung aktiv ist"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il progetto mentre la generazione o l'esecuzione dello strumento è attiva"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível salvar o projeto enquanto a geração ou a execução da ferramenta estiver ativa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan project niet opslaan terwijl generatie of tooluitvoering actief is"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan inte spara projekt medan generering eller verktygskörning är aktiv"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać projektu, gdy trwa generowanie lub wykonywanie narzędzia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Невозможно сохранить проект, пока активна генерация или выполнение инструментов"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Неможливо зберегти проект, поки активна генерація або виконання інструментів"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üretim veya araç yürütme etkinken proje kaydedilemez"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن حفظ المشروع أثناء نشاط التوليد أو تنفيذ الأداة"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשמור פרויקט בזמן שיצירה או הפעלת כלים פעילים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पीढ़ी या उपकरण निष्पादन सक्रिय होने के दौरान प्रोजेक्ट को सहेजा नहीं जा सकता"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在生成或工具执行处于活动状态时无法保存项目"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在生成或工具執行處於活動狀態時無法儲存專案"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成またはツールの実行がアクティブな間はプロジェクトを保存できません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 또는 도구 실행이 활성 상태인 동안에는 프로젝트를 저장할 수 없습니다"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu dự án khi quá trình tạo hoặc thực thi công cụ đang hoạt động"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan proyek saat pembuatan atau eksekusi alat sedang aktif"
          }
        }
      }
    },
