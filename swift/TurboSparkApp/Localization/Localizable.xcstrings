            "state": "translated",
            "value": "Im Hintergrund l\u00e4uft nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is running in the background."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada ejecut\u00e1ndose en segundo plano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne s'ex\u00e9cute en arri\u00e8re-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d5\u05dd \u05d3\u05d1\u05e8 \u05dc\u05d0 \u05e4\u05d5\u05e2\u05dc \u05d1\u05e8\u05e7\u05e2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0943\u0937\u094d\u0920\u092d\u0942\u092e\u093f \u092e\u0947\u0902 \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u091a\u0932 \u0930\u0939\u093e \u0939\u0948\u0964"
          }
