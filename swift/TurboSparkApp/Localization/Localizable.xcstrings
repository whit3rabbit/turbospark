            "value": "\u05dc\u05d0 \u05e0\u05ea\u05de\u05da \u05d1\u05de\u05e9\u05e4\u05d7\u05d4 \u05e9\u05dc \u05de\u05d5\u05d3\u05dc \u05d6\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u0947 \u092a\u0930\u093f\u0935\u093e\u0930 \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u0928\u0939\u0940\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak didukung oleh keluarga model ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non supportato dalla famiglia di questo modello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e2\u30c7\u30eb\u306e\u30d5\u30a1\u30df\u30ea\u30fc\u3067\u306f\u5bfe\u5fdc\u3057\u3066\u3044\u307e\u305b\u3093"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubaa8\ub378\uc758 \uacc4\uc5f4\uc5d0\uc11c\ub294 \uc9c0\uc6d0\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet ondersteund door de familie van dit model"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieobs\u0142ugiwane przez rodzin\u0119 tego modelu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o compat\u00edvel com a fam\u00edlia deste modelo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u0442\u0441\u044f \u0441\u0435\u043c\u0435\u0439\u0441\u0442\u0432\u043e\u043c \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "St\u00f6ds inte av den h\u00e4r modellens familj"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modelin ailesi taraf\u0131ndan desteklenmiyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454\u0442\u044c\u0441\u044f \u0441\u0456\u043c\u0435\u0439\u0441\u0442\u0432\u043e\u043c \u0446\u0456\u0454\u0457 \u043c\u043e\u0434\u0435\u043b\u0456"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ecd c\u1ee7a m\u00f4 h\u00ecnh n\u00e0y kh\u00f4ng h\u1ed7 tr\u1ee3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u6240\u5c5e\u7cfb\u5217\u4e0d\u652f\u6301"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u6240\u5c6c\u7cfb\u5217\u4e0d\u652f\u63f4"
          }
        }
      }
    },
    "Steer how the loaded model writes with a control vector you supply. TurboSpark ships no directions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0648\u062c\u0651\u0647 \u0637\u0631\u064a\u0642\u0629 \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062d\u0645\u0644 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u062a\u062c\u0647 \u062a\u062d\u0643\u0645 \u062a\u0648\u0641\u0631\u0647 \u0623\u0646\u062a. \u0644\u0627 \u064a\u0623\u062a\u064a TurboSpark \u0628\u0623\u064a \u0627\u062a\u062c\u0627\u0647\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Steuere mit einem selbst bereitgestellten Steuerungsvektor, wie das geladene Modell schreibt. TurboSpark liefert keine Richtungen mit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steer how the loaded model writes with a control vector you supply. TurboSpark ships no directions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Dirige c\u00f3mo escribe el modelo cargado con un vector de control que t\u00fa aportas. TurboSpark no incluye ninguna direcci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Orientez la fa\u00e7on dont le mod\u00e8le charg\u00e9 \u00e9crit avec un vecteur de contr\u00f4le que vous fournissez. TurboSpark ne fournit aucune direction."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05d5\u05d5\u05df \u05d0\u05ea \u05d0\u05d5\u05e4\u05df \u05d4\u05db\u05ea\u05d9\u05d1\u05d4 \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d8\u05e2\u05d5\u05df \u05d1\u05e2\u05d6\u05e8\u05ea \u05d5\u05e7\u05d8\u05d5\u05e8 \u05d1\u05e7\u05e8\u05d4 \u05e9\u05d0\u05ea\u05d4 \u05de\u05e1\u05e4\u05e7. TurboSpark \u05d0\u05d9\u05e0\u05d5 \u05de\u05d2\u05d9\u05e2 \u05e2\u05dd \u05db\u05d9\u05d5\u05d5\u05e0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0926\u093f\u090f \u0917\u090f \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0935\u0947\u0915\u094d\u091f\u0930 \u0938\u0947 \u0932\u094b\u0921 \u0915\u093f\u090f \u0917\u090f \u092e\u0949\u0921\u0932 \u0915\u0947 \u0932\u093f\u0916\u0928\u0947 \u0915\u093e \u0922\u0902\u0917 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0930\u0947\u0902\u0964 TurboSpark \u0915\u094b\u0908 \u0926\u093f\u0936\u093e \u0938\u093e\u0925 \u0928\u0939\u0940\u0902 \u0926\u0947\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arahkan cara model yang dimuat menulis dengan vektor kontrol yang Anda sediakan. TurboSpark tidak menyertakan arah apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Orienta il modo in cui scrive il modello caricato con un vettore di controllo fornito da te. TurboSpark non include direzioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aad\u307f\u8fbc\u3093\u3060\u30e2\u30c7\u30eb\u306e\u66f8\u304d\u65b9\u3092\u3001\u3042\u306a\u305f\u304c\u7528\u610f\u3057\u305f\u5236\u5fa1\u30d9\u30af\u30c8\u30eb\u3067\u8a98\u5c0e\u3057\u307e\u3059\u3002TurboSpark\u306b\u306f\u65b9\u5411\u306f\u4ed8\u5c5e\u3057\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c1\uc811 \uc81c\uacf5\ud55c \uc81c\uc5b4 \ubca1\ud130\ub85c \ub85c\ub4dc\ub41c \ubaa8\ub378\uc758 \uc791\uc131 \ubc29\uc2dd\uc744 \uc870\uc815\ud569\ub2c8\ub2e4. TurboSpark\ub294 \ubc29\ud5a5\uc744 \uae30\ubcf8 \uc81c\uacf5\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur hoe het geladen model schrijft met een besturingsvector die je zelf aanlevert. TurboSpark levert geen richtingen mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Steruj sposobem pisania za\u0142adowanego modelu za pomoc\u0105 dostarczonego przez siebie wektora kontrolnego. TurboSpark nie zawiera \u017cadnych kierunk\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Direcione como o modelo carregado escreve com um vetor de controle fornecido por voc\u00ea. O TurboSpark n\u00e3o inclui dire\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u043c\u0430\u043d\u0435\u0440\u0443 \u043f\u0438\u0441\u044c\u043c\u0430 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e \u0432\u0430\u0448\u0435\u0433\u043e \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f. TurboSpark \u043d\u0435 \u043f\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u043d\u0430\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0439."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Styr hur den inl\u00e4sta modellen skriver med en kontrollvektor som du tillhandah\u00e5ller. TurboSpark levereras utan riktningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fckl\u00fc modelin yazma bi\u00e7imini sa\u011flad\u0131\u011f\u0131n\u0131z bir kontrol vekt\u00f6r\u00fcyle y\u00f6nlendirin. TurboSpark hi\u00e7bir y\u00f6nle birlikte gelmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u0440\u044f\u043c\u043e\u0432\u0443\u0439\u0442\u0435 \u043c\u0430\u043d\u0435\u0440\u0443 \u043f\u0438\u0441\u044c\u043c\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e\u0457 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437\u0430 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u043e\u044e \u0432\u043b\u0430\u0441\u043d\u043e\u0433\u043e \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f. TurboSpark \u043d\u0435 \u043f\u043e\u0441\u0442\u0430\u0447\u0430\u0454 \u043d\u0430\u043f\u0440\u044f\u043c\u043a\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110i\u1ec1u h\u01b0\u1edbng c\u00e1ch m\u00f4 h\u00ecnh \u0111\u00e3 t\u1ea3i vi\u1ebft b\u1eb1ng m\u1ed9t vect\u01a1 \u0111i\u1ec1u khi\u1ec3n do b\u1ea1n cung c\u1ea5p. TurboSpark kh\u00f4ng k\u00e8m s\u1eb5n h\u01b0\u1edbng n\u00e0o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u4f60\u63d0\u4f9b\u7684\u63a7\u5236\u5411\u91cf\u5f15\u5bfc\u5df2\u52a0\u8f7d\u6a21\u578b\u7684\u5199\u4f5c\u65b9\u5f0f\u3002TurboSpark \u4e0d\u9644\u5e26\u4efb\u4f55\u65b9\u5411\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528\u4f60\u63d0\u4f9b\u7684\u63a7\u5236\u5411\u91cf\u5f15\u5c0e\u5df2\u8f09\u5165\u6a21\u578b\u7684\u5beb\u4f5c\u65b9\u5f0f\u3002TurboSpark \u4e0d\u9644\u5e36\u4efb\u4f55\u65b9\u5411\u3002"
          }
        }
      }
    },
    "Applied at the next model load.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0637\u0628\u064e\u0651\u0642 \u0639\u0646\u062f \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u062a\u0627\u0644\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird beim n\u00e4chsten Laden eines Modells angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applied at the next model load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica la pr\u00f3xima vez que se cargue un modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appliqu\u00e9 au prochain chargement de mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05d5\u05d7\u05dc \u05d1\u05d8\u05e2\u05d9\u05e0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d1\u05d0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0917\u0932\u0940 \u092c\u093e\u0930 \u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0939\u094b\u0928\u0947 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diterapkan saat model dimuat berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Applicato al prossimo caricamento del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b21\u306b\u30e2\u30c7\u30eb\u3092\u8aad\u307f\u8fbc\u3093\u3060\u3068\u304d\u306b\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc74c\uc5d0 \ubaa8\ub378\uc744 \ub85c\ub4dc\ud560 \ub54c \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt toegepast bij het volgende laden van een model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie zastosowane przy nast\u0119pnym \u0142adowaniu modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplicado no pr\u00f3ximo carregamento de modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0439 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till\u00e4mpas n\u00e4sta g\u00e5ng en modell l\u00e4ses in."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sonraki model y\u00fcklemesinde uygulan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u01b0\u1ee3c \u00e1p d\u1ee5ng \u1edf l\u1ea7n t\u1ea3i m\u00f4 h\u00ecnh ti\u1ebfp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u5728\u4e0b\u6b21\u52a0\u8f7d\u6a21\u578b\u65f6\u5e94\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u5728\u4e0b\u6b21\u8f09\u5165\u6a21\u578b\u6642\u5957\u7528\u3002"
          }
        }
      }
    },
    "The loaded model is not running this. Steering is applied when a model opens.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062d\u0645\u0644 \u0644\u0627 \u064a\u0633\u062a\u062e\u062f\u0645 \u0647\u0630\u0627. \u064a\u064f\u0637\u0628\u064e\u0651\u0642 \u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0639\u0646\u062f \u0641\u062a\u062d \u0627\u0644\u0646\u0645\u0648\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das geladene Modell verwendet dies nicht. Die Steuerung wird beim \u00d6ffnen eines Modells angewendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The loaded model is not running this. Steering is applied when a model opens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo cargado no est\u00e1 usando esto. El direccionamiento se aplica al abrir un modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mod\u00e8le charg\u00e9 n'utilise pas ce r\u00e9glage. Le guidage s'applique \u00e0 l'ouverture d'un mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d8\u05e2\u05d5\u05df \u05dc\u05d0 \u05de\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d6\u05d4. \u05d4\u05d4\u05d9\u05d2\u05d5\u05d9 \u05de\u05d5\u05d7\u05dc \u05db\u05e9\u05de\u05d5\u05d3\u05dc \u05e0\u05e4\u05ea\u05d7."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092e\u0949\u0921\u0932 \u0907\u0938\u0947 \u0928\u0939\u0940\u0902 \u091a\u0932\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u092e\u0949\u0921\u0932 \u0916\u0941\u0932\u0928\u0947 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yang dimuat tidak menjalankan ini. Pengarah diterapkan saat model dibuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello caricato non lo sta usando. La guida viene applicata all'apertura di un modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aad\u307f\u8fbc\u307e\u308c\u305f\u30e2\u30c7\u30eb\u306f\u3053\u306e\u8a2d\u5b9a\u3067\u52d5\u4f5c\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u306f\u30e2\u30c7\u30eb\u3092\u958b\u304f\u3068\u304d\u306b\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub85c\ub4dc\ub41c \ubaa8\ub378\uc740 \uc774 \uc124\uc815\uc73c\ub85c \uc2e4\ud589\ub418\uace0 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc2a4\ud2f0\uc5b4\ub9c1\uc740 \ubaa8\ub378\uc744 \uc5f4 \ub54c \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geladen model gebruikt dit niet. Besturing wordt toegepast wanneer een model wordt geopend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za\u0142adowany model tego nie u\u017cywa. Sterowanie jest stosowane przy otwieraniu modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo carregado n\u00e3o est\u00e1 usando isto. O direcionamento \u00e9 aplicado quando um modelo \u00e9 aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u044d\u0442\u043e \u043d\u0435 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442. \u0423\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043e\u0442\u043a\u0440\u044b\u0442\u0438\u0438 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den inl\u00e4sta modellen k\u00f6r inte detta. Styrning till\u00e4mpas n\u00e4r en modell \u00f6ppnas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fckl\u00fc model bunu \u00e7al\u0131\u015ft\u0131rm\u0131yor. Y\u00f6nlendirme, bir model a\u00e7\u0131ld\u0131\u011f\u0131nda uygulan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044c \u0446\u044c\u043e\u0433\u043e \u043d\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454. \u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0442\u044f \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 h\u00ecnh \u0111\u00e3 t\u1ea3i kh\u00f4ng ch\u1ea1y thi\u1ebft l\u1eadp n\u00e0y. \u0110i\u1ec1u h\u01b0\u1edbng \u0111\u01b0\u1ee3c \u00e1p d\u1ee5ng khi m\u1edf m\u00f4 h\u00ecnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u52a0\u8f7d\u7684\u6a21\u578b\u672a\u8fd0\u884c\u6b64\u8bbe\u7f6e\u3002\u8f6c\u5411\u5728\u6253\u5f00\u6a21\u578b\u65f6\u5e94\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8f09\u5165\u7684\u6a21\u578b\u672a\u57f7\u884c\u6b64\u8a2d\u5b9a\u3002\u5c0e\u5411\u6703\u5728\u958b\u555f\u6a21\u578b\u6642\u5957\u7528\u3002"
          }
        }
      }
    },
    "Advisory only: nothing validates against this, which is exactly why it is worth reading.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0644\u0627\u0637\u0644\u0627\u0639 \u0641\u0642\u0637: \u0644\u0627 \u0634\u064a\u0621 \u064a\u062a\u062d\u0642\u0642 \u0645\u0642\u0627\u0628\u0644 \u0647\u0630\u0627\u060c \u0648\u0644\u0647\u0630\u0627 \u0628\u0627\u0644\u062a\u062d\u062f\u064a\u062f \u062a\u0633\u062a\u062d\u0642 \u0642\u0631\u0627\u0621\u062a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ein Hinweis: Nichts wird dagegen gepr\u00fcft, und genau deshalb lohnt es sich, ihn zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Advisory only: nothing validates against this, which is exactly why it is worth reading."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo orientativo: nada se valida contra esto, y precisamente por eso vale la pena leerlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicatif uniquement : rien n'est v\u00e9rifi\u00e9 par rapport \u00e0 cela, et c'est justement pourquoi il vaut la peine de le lire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d9\u05d3\u05d9\u05e2\u05d4 \u05d1\u05dc\u05d1\u05d3: \u05e9\u05d5\u05dd \u05d3\u05d1\u05e8 \u05dc\u05d0 \u05e0\u05d1\u05d3\u05e7 \u05de\u05d5\u05dc\u05d5, \u05d5\u05d1\u05d3\u05d9\u05d5\u05e7 \u05d1\u05d2\u05dc\u05dc \u05d6\u05d4 \u05db\u05d3\u05d0\u05d9 \u05dc\u05e7\u05e8\u05d5\u05d0 \u05d0\u05d5\u05ea\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0947\u0935\u0932 \u0938\u0932\u093e\u0939 \u0915\u0947 \u0932\u093f\u090f: \u0907\u0938\u0915\u0947 \u0935\u093f\u0930\u0941\u0926\u094d\u0927 \u0915\u0941\u091b \u092d\u0940 \u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e, \u0907\u0938\u0940\u0932\u093f\u090f \u0907\u0938\u0947 \u092a\u0922\u093c\u0928\u093e \u091c\u093c\u0930\u0942\u0930\u0940 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya sebagai saran: tidak ada yang divalidasi terhadap ini, justru karena itu layak dibaca."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo indicativo: nulla viene verificato rispetto a questo, ed \u00e8 proprio per questo che vale la pena leggerlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53c2\u8003\u60c5\u5831\u306e\u307f: \u3053\u308c\u306b\u5bfe\u3059\u308b\u691c\u8a3c\u306f\u4e00\u5207\u884c\u308f\u308c\u306a\u3044\u305f\u3081\u3001\u76ee\u3092\u901a\u3057\u3066\u304a\u304f\u4fa1\u5024\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucc38\uace0\uc6a9\uc77c \ubfd0\uc785\ub2c8\ub2e4. \uc774\uc5d0 \ub300\ud574 \uc544\ubb34\uac83\ub3c4 \uac80\uc99d\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \uaf2d \uc77d\uc5b4 \ubcfc \uac00\uce58\uac00 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen ter informatie: niets wordt hiertegen gevalideerd, en juist daarom is het de moeite waard om te lezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko informacyjnie: nic nie jest z tym por\u00f3wnywane i w\u0142a\u015bnie dlatego warto to przeczyta\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas informativo: nada \u00e9 validado em rela\u00e7\u00e3o a isto, e \u00e9 exatamente por isso que vale a pena ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u043e\u043b\u044c\u043a\u043e \u0434\u043b\u044f \u0441\u043f\u0440\u0430\u0432\u043a\u0438: \u043d\u0438\u0447\u0442\u043e \u0441 \u044d\u0442\u0438\u043c \u043d\u0435 \u0441\u0432\u0435\u0440\u044f\u0435\u0442\u0441\u044f, \u0438 \u0438\u043c\u0435\u043d\u043d\u043e \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u044d\u0442\u043e \u0441\u0442\u043e\u0438\u0442 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast v\u00e4gledande: ingenting valideras mot detta, och just d\u00e4rf\u00f6r \u00e4r det v\u00e4rt att l\u00e4sa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaln\u0131zca bilgi ama\u00e7l\u0131: hi\u00e7bir \u015fey buna g\u00f6re do\u011frulanmaz, tam da bu y\u00fczden okumaya de\u011fer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u0438\u0448\u0435 \u0434\u043b\u044f \u0434\u043e\u0432\u0456\u0434\u043a\u0438: \u043d\u0456\u0449\u043e \u0437 \u0446\u0438\u043c \u043d\u0435 \u0437\u0432\u0456\u0440\u044f\u0454\u0442\u044c\u0441\u044f, \u0456 \u0441\u0430\u043c\u0435 \u0442\u043e\u043c\u0443 \u0446\u0435 \u0432\u0430\u0440\u0442\u043e \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ec9 mang t\u00ednh tham kh\u1ea3o: kh\u00f4ng c\u00f3 g\u00ec \u0111\u01b0\u1ee3c ki\u1ec3m tra theo th\u00f4ng tin n\u00e0y, v\u00e0 ch\u00ednh v\u00ec th\u1ebf n\u00ean \u0111\u1ecdc n\u00f3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ec5\u4f9b\u53c2\u8003\uff1a\u6ca1\u6709\u4efb\u4f55\u5185\u5bb9\u4f1a\u636e\u6b64\u9a8c\u8bc1\uff0c\u6b63\u56e0\u5982\u6b64\u624d\u503c\u5f97\u4e00\u8bfb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u50c5\u4f9b\u53c3\u8003\uff1a\u6c92\u6709\u4efb\u4f55\u5167\u5bb9\u6703\u64da\u6b64\u9a57\u8b49\uff0c\u6b63\u56e0\u5982\u6b64\u624d\u503c\u5f97\u4e00\u8b80\u3002"
          }
        }
      }
    },
    "Measured usable strengths on real installs ran 0.4 to 0.8, and full ablation over every layer collapsed the turn entirely. Restrict the layer band, or lower this.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0631\u0627\u0648\u062d\u062a \u0627\u0644\u0634\u062f\u0629 \u0627\u0644\u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0642\u064a\u0633\u0629 \u0639\u0644\u0649 \u0639\u0645\u0644\u064a\u0627\u062a \u062a\u062b\u0628\u064a\u062a \u062d\u0642\u064a\u0642\u064a\u0629 \u0628\u064a\u0646 0.4 \u06480.8\u060c \u0648\u0623\u062f\u0649 \u0627\u0644\u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0643\u0627\u0645\u0644 \u0639\u0644\u0649 \u0643\u0644 \u0627\u0644\u0637\u0628\u0642\u0627\u062a \u0625\u0644\u0649 \u0627\u0646\u0647\u064a\u0627\u0631 \u0627\u0644\u062f\u0648\u0631 \u062a\u0645\u0627\u0645\u064b\u0627. \u0642\u064a\u0651\u062f \u0646\u0637\u0627\u0642 \u0627\u0644\u0637\u0628\u0642\u0627\u062a \u0623\u0648 \u062e\u0641\u0651\u0636 \u0647\u0630\u0647 \u0627\u0644\u0642\u064a\u0645\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf echten Installationen lagen die gemessenen brauchbaren St\u00e4rken bei 0.4 bis 0.8, und volle Ablation \u00fcber alle Schichten lie\u00df die Antwort komplett zusammenbrechen. Schr\u00e4nke den Schichtbereich ein oder verringere diesen Wert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measured usable strengths on real installs ran 0.4 to 0.8, and full ablation over every layer collapsed the turn entirely. Restrict the layer band, or lower this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En instalaciones reales, las intensidades \u00fatiles medidas fueron de 0.4 a 0.8, y la ablaci\u00f3n completa en todas las capas hizo fallar el turno por completo. Restringe el rango de capas o baja este valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur des installations r\u00e9elles, les intensit\u00e9s utilisables mesur\u00e9es allaient de 0.4 \u00e0 0.8, et une ablation compl\u00e8te sur toutes les couches a fait \u00e9chouer enti\u00e8rement le tour. Restreignez la plage de couches ou baissez cette valeur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d4\u05ea\u05e7\u05e0\u05d5\u05ea \u05d0\u05de\u05d9\u05ea\u05d9\u05d5\u05ea \u05d4\u05e2\u05d5\u05e6\u05de\u05d5\u05ea \u05d4\u05e9\u05de\u05d9\u05e9\u05d5\u05ea \u05e9\u05e0\u05de\u05d3\u05d3\u05d5 \u05e0\u05e2\u05d5 \u05d1\u05d9\u05df 0.4 \u05dc-0.8, \u05d5\u05d4\u05e1\u05e8\u05d4 \u05de\u05dc\u05d0\u05d4 \u05d1\u05db\u05dc \u05d4\u05e9\u05db\u05d1\u05d5\u05ea \u05d2\u05e8\u05de\u05d4 \u05dc\u05ea\u05d5\u05e8 \u05dc\u05e7\u05e8\u05d5\u05e1 \u05dc\u05d2\u05de\u05e8\u05d9. \u05e6\u05de\u05e6\u05dd \u05d0\u05ea \u05d8\u05d5\u05d5\u05d7 \u05d4\u05e9\u05db\u05d1\u05d5\u05ea \u05d0\u05d5 \u05d4\u05d5\u05e8\u05d3 \u05e2\u05e8\u05da \u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u092a\u0930 \u092e\u093e\u092a\u0940 \u0917\u0908 \u0909\u092a\u092f\u094b\u0917\u0940 \u0924\u0940\u0935\u094d\u0930\u0924\u093e 0.4 \u0938\u0947 0.8 \u0930\u0939\u0940, \u0914\u0930 \u0939\u0930 \u0932\u0947\u092f\u0930 \u092a\u0930 \u092a\u0942\u0930\u094d\u0923 \u090f\u092c\u094d\u0932\u0947\u0936\u0928 \u0938\u0947 \u091f\u0930\u094d\u0928 \u092a\u0942\u0930\u0940 \u0924\u0930\u0939 \u0935\u093f\u092b\u0932 \u0939\u094b \u0917\u092f\u093e\u0964 \u0932\u0947\u092f\u0930 \u0930\u0947\u0902\u091c \u0938\u0940\u092e\u093f\u0924 \u0915\u0930\u0947\u0902 \u092f\u093e \u092f\u0939 \u092e\u093e\u0928 \u0918\u091f\u093e\u090f\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kekuatan yang dapat digunakan yang diukur pada instalasi nyata berkisar 0.4 hingga 0.8, dan ablasi penuh di setiap lapisan membuat giliran gagal total. Batasi rentang lapisan, atau turunkan nilai ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sulle installazioni reali le intensit\u00e0 utilizzabili misurate andavano da 0.4 a 0.8, e l'ablazione completa su tutti i livelli ha fatto fallire del tutto il turno. Restringi l'intervallo di livelli o abbassa questo valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9f\u969b\u306e\u74b0\u5883\u3067\u6e2c\u5b9a\u3057\u305f\u6709\u52b9\u306a\u5f37\u5ea6\u306f0.4\u304b\u30890.8\u3067\u3001\u5168\u30ec\u30a4\u30e4\u30fc\u3078\u306e\u5b8c\u5168\u306a\u30a2\u30d6\u30ec\u30fc\u30b7\u30e7\u30f3\u3067\u306f\u30bf\u30fc\u30f3\u304c\u5b8c\u5168\u306b\u7834\u7dbb\u3057\u307e\u3057\u305f\u3002\u30ec\u30a4\u30e4\u30fc\u7bc4\u56f2\u3092\u7d5e\u308b\u304b\u3001\u3053\u306e\u5024\u3092\u4e0b\u3052\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\uc81c \uc124\uce58 \ud658\uacbd\uc5d0\uc11c \uce21\uc815\ud55c \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uac15\ub3c4\ub294 0.4\uc5d0\uc11c 0.8\uc774\uc5c8\uc73c\uba70, \ubaa8\ub4e0 \ub808\uc774\uc5b4\uc5d0 \uc644\uc804 \uc81c\uac70\ub97c \uc801\uc6a9\ud558\uc790 \ud134\uc774 \uc644\uc804\ud788 \ubb34\ub108\uc84c\uc2b5\ub2c8\ub2e4. \ub808\uc774\uc5b4 \ubc94\uc704\ub97c \uc81c\ud55c\ud558\uac70\ub098 \uc774 \uac12\uc744 \ub0ae\ucd94\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op echte installaties lagen de gemeten bruikbare sterktes tussen 0.4 en 0.8, en volledige ablatie over elke laag liet de beurt volledig mislukken. Beperk het laagbereik of verlaag deze waarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na rzeczywistych instalacjach zmierzone u\u017cyteczne si\u0142y wynosi\u0142y od 0.4 do 0.8, a pe\u0142na ablacja na wszystkich warstwach ca\u0142kowicie za\u0142ama\u0142a tur\u0119. Ogranicz zakres warstw lub zmniejsz t\u0119 warto\u015b\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em instala\u00e7\u00f5es reais, as intensidades \u00fateis medidas ficaram entre 0.4 e 0.8, e a abla\u00e7\u00e3o completa em todas as camadas fez o turno falhar por completo. Restrinja o intervalo de camadas ou reduza este valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u044b\u0445 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043a\u0430\u0445 \u0438\u0437\u043c\u0435\u0440\u0435\u043d\u043d\u0430\u044f \u043f\u043e\u043b\u0435\u0437\u043d\u0430\u044f \u0441\u0438\u043b\u0430 \u0441\u043e\u0441\u0442\u0430\u0432\u043b\u044f\u043b\u0430 \u043e\u0442 0.4 \u0434\u043e 0.8, \u0430 \u043f\u043e\u043b\u043d\u0430\u044f \u0430\u0431\u043b\u044f\u0446\u0438\u044f \u043f\u043e \u0432\u0441\u0435\u043c \u0441\u043b\u043e\u044f\u043c \u043f\u043e\u043b\u043d\u043e\u0441\u0442\u044c\u044e \u043b\u043e\u043c\u0430\u043b\u0430 \u0445\u043e\u0434. \u0421\u0443\u0437\u044c\u0442\u0435 \u0434\u0438\u0430\u043f\u0430\u0437\u043e\u043d \u0441\u043b\u043e\u0451\u0432 \u0438\u043b\u0438 \u0443\u043c\u0435\u043d\u044c\u0448\u0438\u0442\u0435 \u044d\u0442\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "P\u00e5 riktiga installationer l\u00e5g de uppm\u00e4tta anv\u00e4ndbara styrkorna p\u00e5 0.4 till 0.8, och full ablation \u00f6ver alla lager fick turen att kollapsa helt. Begr\u00e4nsa lagerintervallet eller s\u00e4nk v\u00e4rdet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ger\u00e7ek kurulumlarda \u00f6l\u00e7\u00fclen kullan\u0131labilir g\u00fc\u00e7 0.4 ile 0.8 aras\u0131ndayd\u0131 ve t\u00fcm katmanlarda tam ablasyon turu tamamen \u00e7\u00f6kertti. Katman aral\u0131\u011f\u0131n\u0131 daralt\u0131n veya bu de\u011feri d\u00fc\u015f\u00fcr\u00fcn."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430 \u0440\u0435\u0430\u043b\u044c\u043d\u0438\u0445 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f\u0445 \u0432\u0438\u043c\u0456\u0440\u044f\u043d\u0430 \u043a\u043e\u0440\u0438\u0441\u043d\u0430 \u0441\u0438\u043b\u0430 \u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0430 \u0432\u0456\u0434 0.4 \u0434\u043e 0.8, \u0430 \u043f\u043e\u0432\u043d\u0430 \u0430\u0431\u043b\u044f\u0446\u0456\u044f \u043d\u0430 \u0432\u0441\u0456\u0445 \u0448\u0430\u0440\u0430\u0445 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u043b\u0430\u043c\u0430\u043b\u0430 \u0445\u0456\u0434. \u0417\u0432\u0443\u0437\u044c\u0442\u0435 \u0434\u0456\u0430\u043f\u0430\u0437\u043e\u043d \u0448\u0430\u0440\u0456\u0432 \u0430\u0431\u043e \u0437\u043c\u0435\u043d\u0448\u0442\u0435 \u0446\u0435 \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tr\u00ean c\u00e1c b\u1ea3n c\u00e0i \u0111\u1eb7t th\u1ef1c t\u1ebf, c\u01b0\u1eddng \u0111\u1ed9 d\u00f9ng \u0111\u01b0\u1ee3c \u0111o \u0111\u01b0\u1ee3c n\u1eb1m trong kho\u1ea3ng 0.4 \u0111\u1ebfn 0.8, v\u00e0 lo\u1ea1i b\u1ecf ho\u00e0n to\u00e0n tr\u00ean m\u1ecdi l\u1edbp khi\u1ebfn l\u01b0\u1ee3t tr\u1ea3 l\u1eddi s\u1ee5p \u0111\u1ed5 h\u1eb3n. H\u00e3y thu h\u1eb9p d\u1ea3i l\u1edbp ho\u1eb7c gi\u1ea3m gi\u00e1 tr\u1ecb n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5b9e\u9645\u5b89\u88c5\u4e0a\u6d4b\u5f97\u7684\u53ef\u7528\u5f3a\u5ea6\u4e3a 0.4 \u5230 0.8\uff0c\u800c\u5728\u6240\u6709\u5c42\u4e0a\u5b8c\u5168\u6d88\u878d\u4f1a\u4f7f\u6574\u4e2a\u56de\u5408\u5d29\u6e83\u3002\u8bf7\u7f29\u5c0f\u5c42\u8303\u56f4\uff0c\u6216\u964d\u4f4e\u6b64\u503c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5be6\u969b\u5b89\u88dd\u4e0a\u6e2c\u5f97\u7684\u53ef\u7528\u5f37\u5ea6\u70ba 0.4 \u5230 0.8\uff0c\u800c\u5728\u6240\u6709\u5c64\u4e0a\u5b8c\u5168\u6d88\u878d\u6703\u4f7f\u6574\u500b\u56de\u5408\u5d29\u6f70\u3002\u8acb\u7e2e\u5c0f\u5c64\u7bc4\u570d\uff0c\u6216\u964d\u4f4e\u6b64\u503c\u3002"
          }
        }
      }
    },
    "Layers, e.g. 20:45 (blank = every covered block)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0637\u0628\u0642\u0627\u062a\u060c \u0645\u062b\u0644 20:45 (\u0641\u0627\u0631\u063a = \u0643\u0644 \u0627\u0644\u0643\u062a\u0644 \u0627\u0644\u0645\u0634\u0645\u0648\u0644\u0629)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schichten, z. B. 20:45 (leer = alle abgedeckten Bl\u00f6cke)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Layers, e.g. 20:45 (blank = every covered block)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Capas, p. ej. 20:45 (vac\u00edo = todos los bloques cubiertos)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Couches, p. ex. 20:45 (vide = tous les blocs couverts)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05db\u05d1\u05d5\u05ea, \u05dc\u05de\u05e9\u05dc 20:45 (\u05e8\u05d9\u05e7 = \u05db\u05dc \u05d4\u05d1\u05dc\u05d5\u05e7\u05d9\u05dd \u05d4\u05de\u05db\u05d5\u05e1\u05d9\u05dd)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u0947\u092f\u0930, \u091c\u0948\u0938\u0947 20:45 (\u0916\u093e\u0932\u0940 = \u0938\u092d\u0940 \u0936\u093e\u092e\u093f\u0932 \u092c\u094d\u0932\u0949\u0915)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lapisan, mis. 20:45 (kosong = semua blok yang tercakup)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Livelli, ad es. 20:45 (vuoto = tutti i blocchi coperti)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ec\u30a4\u30e4\u30fc\uff08\u4f8b: 20:45\u3001\u7a7a\u6b04 = \u5bfe\u8c61\u306e\u3059\u3079\u3066\u306e\u30d6\u30ed\u30c3\u30af\uff09"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub808\uc774\uc5b4, \uc608: 20:45 (\ube44\uc6cc \ub450\uba74 \ud3ec\ud568\ub41c \ubaa8\ub4e0 \ube14\ub85d)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagen, bijv. 20:45 (leeg = alle gedekte blokken)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Warstwy, np. 20:45 (puste = wszystkie obj\u0119te bloki)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Camadas, ex.: 20:45 (vazio = todos os blocos cobertos)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043b\u043e\u0438, \u043d\u0430\u043f\u0440. 20:45 (\u043f\u0443\u0441\u0442\u043e = \u0432\u0441\u0435 \u043e\u0445\u0432\u0430\u0447\u0435\u043d\u043d\u044b\u0435 \u0431\u043b\u043e\u043a\u0438)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lager, t.ex. 20:45 (tomt = alla t\u00e4ckta block)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katmanlar, \u00f6r. 20:45 (bo\u015f = kapsanan t\u00fcm bloklar)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0430\u0440\u0438, \u043d\u0430\u043f\u0440. 20:45 (\u043f\u043e\u0440\u043e\u0436\u043d\u044c\u043e = \u0443\u0441\u0456 \u043e\u0445\u043e\u043f\u043b\u0435\u043d\u0456 \u0431\u043b\u043e\u043a\u0438)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1edbp, v\u00ed d\u1ee5 20:45 (\u0111\u1ec3 tr\u1ed1ng = m\u1ecdi kh\u1ed1i \u0111\u01b0\u1ee3c bao ph\u1ee7)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c42\uff0c\u4f8b\u5982 20:45\uff08\u7559\u7a7a = \u6240\u6709\u5df2\u8986\u76d6\u7684\u5757\uff09"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c64\uff0c\u4f8b\u5982 20:45\uff08\u7559\u7a7a = \u6240\u6709\u5df2\u6db5\u84cb\u7684\u5340\u584a\uff09"
          }
        }
      }
    },
