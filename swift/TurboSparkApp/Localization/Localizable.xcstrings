        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u0430 \u0442\u043e\u0447\u043a\u0430 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439 \u0431\u044e\u0434\u0436\u0435\u0442 \u043f\u0430\u043c\u2019\u044f\u0442\u0456 \u043c\u043e\u0434\u0435\u043b\u0456 \u0430\u0443\u0434\u0456\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110i\u1ec3m ki\u1ec3m tra n\u00e0y v\u01b0\u1ee3t qu\u00e1 ng\u00e2n s\u00e1ch b\u1ed9 nh\u1edb m\u00f4 h\u00ecnh \u00e2m thanh c\u00f3 s\u1eb5n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u68c0\u67e5\u70b9\u8d85\u51fa\u4e86\u53ef\u7528\u7684\u97f3\u9891\u6a21\u578b\u5185\u5b58\u9884\u7b97\u3002"
          }
