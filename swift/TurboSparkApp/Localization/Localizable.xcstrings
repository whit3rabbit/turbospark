            "value": "\u5f62\u72b6\u306f\u672a\u78ba\u8a8d\u3067\u3059: \u3053\u306e\u30e2\u30c7\u30eb\u306e\u30de\u30cb\u30d5\u30a7\u30b9\u30c8\u306b\u306f\u96a0\u308c\u5c64\u306e\u30b5\u30a4\u30ba\u304c\u5ba3\u8a00\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
