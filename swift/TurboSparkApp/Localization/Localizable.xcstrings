    "A git source needs an https:// or ssh:// URL.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062d\u062a\u0627\u062c \u0645\u0635\u062f\u0631 git \u0625\u0644\u0649 \u0639\u0646\u0648\u0627\u0646 https:// \u0623\u0648 ssh://."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Git-Quelle ben\u00f6tigt eine https://- oder ssh://-URL."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A git source needs an https:// or ssh:// URL."
