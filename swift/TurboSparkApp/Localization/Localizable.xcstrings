        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun hook registrato in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u306b\u767b\u9332\u3055\u308c\u3066\u3044\u308b\u30d5\u30c3\u30af\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
