        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u0942\u0930\u0947\u091f\u0947\u0921 \u0915\u0948\u091f\u0932\u0949\u0917 \u092f\u093e Hugging Face \u0938\u0947 \u092e\u0949\u0921\u0932 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0930\u0942\u092a \u0938\u0947 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
