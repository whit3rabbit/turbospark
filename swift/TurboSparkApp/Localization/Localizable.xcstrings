    "Each row is priced by the engine, not scaled from one figure.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each row is priced by the engine, not scaled from one figure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor calcula el coste de cada fila; no se escala a partir de una sola cifra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne est chiffrée par le moteur, pas extrapolée d'une seule valeur."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile wird von der Engine berechnet, nicht aus einem Wert hochgerechnet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riga è calcolata dal motore, non ricavata in scala da un solo valore."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha é calculada pelo motor, não escalada a partir de um único valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая строка рассчитана движком, а не масштабирована от одного значения."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行はエンジンが実測した値です。1つの数値から換算したものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 행은 엔진이 계산한 값이며, 하나의 수치를 비례 확대한 값이 아닙니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一行都由引擎单独计算，而非按单个数值换算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一列都由引擎個別計算，而非依單一數值換算。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل صف يحسبه المحرك على حدة، وليس مشتقًا من رقم واحد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל שורה מחושבת על ידי המנוע, ולא נגזרת מערך יחיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पंक्ति की गणना इंजन करता है, किसी एक आंकड़े से नहीं निकाली जाती।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke rij wordt door de engine berekend, niet geschaald vanuit één getal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wiersz wylicza silnik; nie jest skalowany z jednej wartości."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satır motor tarafından hesaplanır, tek bir değerden ölçeklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рядок обчислює рушій, а не масштабує з одного значення."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje rad beräknas av motorn, inte skalad från ett enda värde."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hàng do engine tính riêng, không suy ra từ một con số."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap baris dihitung oleh mesin, bukan diskalakan dari satu angka."
          }
        }
      }
    },
