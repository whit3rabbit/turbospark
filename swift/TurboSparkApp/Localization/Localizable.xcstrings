    "Glob patterns that will trigger activation when editing matching files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glob patterns that will trigger activation when editing matching files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Patrones glob que activarán la habilidad al editar archivos coincidentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Motifs glob qui déclencheront l'activation lors de la modification des fichiers correspondants."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glob-Muster, die beim Bearbeiten passender Dateien die Aktivierung auslösen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pattern glob che attiveranno l'abilità quando modifichi file corrispondenti."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Padrões glob que acionarão a ativação ao editar arquivos correspondentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблоны glob, которые запускают активацию при редактировании подходящих файлов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するファイルを編集したときにアクティベーションを発動させる glob パターンです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 파일을 편집할 때 활성화를 트리거하는 glob 패턴입니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "编辑匹配文件时将触发激活的 glob 模式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "編輯符合的檔案時將觸發啟用的 glob 模式。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنماط glob التي ستُشغّل التفعيل عند تحرير الملفات المطابقة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תבניות glob שיפעילו את ההפעלה בעת עריכת קבצים תואמים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ग्लोब पैटर्न जो मेल खाने वाली फ़ाइलें संपादित करने पर सक्रियण ट्रिगर करेंगे।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glob-patronen die activering starten bij het bewerken van overeenkomende bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wzorce glob, które wyzwolą aktywację podczas edycji pasujących plików."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eşleşen dosyalar düzenlendiğinde etkinleştirmeyi tetikleyecek glob desenleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаблони glob, які запускають активацію під час редагування відповідних файлів."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Glob-mönster som utlöser aktivering när matchande filer redigeras."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mẫu glob sẽ kích hoạt khi bạn chỉnh sửa tệp khớp."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pola glob yang akan memicu aktivasi saat mengedit berkas yang cocok."
          }
        }
      }
    },
