    "Some older tool output was shortened for this request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some older tool output was shortened for this request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de los resultados antiguos de herramientas se acort\u00f3 para esta solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie des anciens r\u00e9sultats d\u2019outils a \u00e9t\u00e9 raccourcie pour cette requ\u00eate."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4ltere Werkzeugausgaben wurden f\u00fcr diese Anfrage gek\u00fcrzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni risultati precedenti degli strumenti sono stati abbreviati per questa richiesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns resultados antigos de ferramentas foram reduzidos para esta solicita\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0430\u0441\u0442\u044c \u0441\u0442\u0430\u0440\u044b\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u043e\u0432 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0431\u044b\u043b\u0430 \u0441\u043e\u043a\u0440\u0430\u0449\u0435\u043d\u0430 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0437\u0430\u043f\u0440\u043e\u0441\u0430."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30ea\u30af\u30a8\u30b9\u30c8\u306e\u305f\u3081\u306b\u53e4\u3044\u30c4\u30fc\u30eb\u51fa\u529b\u306e\u4e00\u90e8\u3092\u77ed\u7e2e\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc694\uccad\uc744 \uc704\ud574 \uc774\uc804 \ub3c4\uad6c \ucd9c\ub825\uc758 \uc77c\ubd80\ub97c \uc904\uc600\uc2b5\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u5904\u7406\u6b64\u8bf7\u6c42\uff0c\u5df2\u7f29\u77ed\u90e8\u5206\u8f83\u65e9\u7684\u5de5\u5177\u8f93\u51fa\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u8655\u7406\u6b64\u8981\u6c42\uff0c\u5df2\u7e2e\u77ed\u90e8\u5206\u8f03\u65e9\u7684\u5de5\u5177\u8f38\u51fa\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0627\u062e\u062a\u0635\u0627\u0631 \u0628\u0639\u0636 \u0645\u062e\u0631\u062c\u0627\u062a \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0642\u062f\u064a\u0645\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u0637\u0644\u0628."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0947 \u0932\u093f\u090f \u092a\u0941\u0930\u093e\u0928\u0947 \u091f\u0942\u0932 \u0906\u0909\u091f\u092a\u0941\u091f \u0915\u093e \u0915\u0941\u091b \u0939\u093f\u0938\u094d\u0938\u093e \u091b\u094b\u091f\u093e \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een deel van oudere tooluitvoer is voor dit verzoek ingekort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cz\u0119\u015b\u0107 starszych wynik\u00f3w narz\u0119dzi skr\u00f3cono na potrzeby tego \u017c\u0105dania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istek i\u00e7in eski ara\u00e7 \u00e7\u0131kt\u0131lar\u0131n\u0131n bir k\u0131sm\u0131 k\u0131salt\u0131ld\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0430\u0441\u0442\u0438\u043d\u0443 \u0441\u0442\u0430\u0440\u0438\u0445 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0456\u0432 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 \u0441\u043a\u043e\u0440\u043e\u0447\u0435\u043d\u043e \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0437\u0430\u043f\u0438\u0442\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4ldre verktygsresultat har kortats f\u00f6r den h\u00e4r beg\u00e4ran."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed9t ph\u1ea7n k\u1ebft qu\u1ea3 c\u00f4ng c\u1ee5 c\u0169 \u0111\u00e3 \u0111\u01b0\u1ee3c r\u00fat g\u1ecdn cho y\u00eau c\u1ea7u n\u00e0y."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebagian keluaran alat lama dipersingkat untuk permintaan ini."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05dc\u05e7 \u05de\u05d4\u05e4\u05dc\u05d8\u05d9\u05dd \u05d4\u05d9\u05e9\u05e0\u05d9\u05dd \u05e9\u05dc \u05d4\u05db\u05dc\u05d9\u05dd \u05e7\u05d5\u05e6\u05e8\u05d5 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05d1\u05e7\u05e9\u05d4 \u05d4\u05d6\u05d5."
          }
        }
      }
    },
