        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u601d\u8003\u306e\u9023\u9396\u3068\u5185\u90e8\u63a8\u8ad6\u306e\u62bd\u51fa\u306b\u5bfe\u5fdc"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\uac01\uc758 \uc0ac\uc2ac\uacfc \ub0b4\ubd80 \ucd94\ub860 \ucd94\ucd9c \uc9c0\uc6d0"
          }
        },
        "nl": {
