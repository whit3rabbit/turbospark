    "This export exceeds the standard ZIP size limit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u062c\u0627\u0648\u0632 \u0647\u0630\u0627 \u0627\u0644\u062a\u0635\u062f\u064a\u0631 \u062d\u062f \u0627\u0644\u062d\u062c\u0645 \u0627\u0644\u0642\u064a\u0627\u0633\u064a \u0644\u0645\u0644\u0641\u0627\u062a ZIP."
          }
        },
        "de": {
          "stringUnit": {
