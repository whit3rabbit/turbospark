    "Software engineer optimized for codebase navigation, editing, terminal commands, and debugging.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مهندس برمجيات مهيأ للتنقل في قاعدة الشيفرة والتحرير وأوامر الطرفية وتصحيح الأخطاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Softwareentwickler, optimiert für Navigation im Code, Bearbeitung, Terminalbefehle und Fehlersuche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software engineer optimized for codebase navigation, editing, terminal commands, and debugging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingeniero de software optimizado para navegar por el código, editar, usar la terminal y depurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingénieur logiciel optimisé pour parcourir le code, l'éditer, utiliser le terminal et déboguer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מהנדס תוכנה שמותאם לניווט בקוד, עריכה, פקודות מסוף וניפוי באגים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोडबेस नेविगेशन, संपादन, टर्मिनल कमांड और डीबगिंग के लिए अनुकूलित सॉफ़्टवेयर इंजीनियर।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Insinyur perangkat lunak yang dioptimalkan untuk menjelajah kode, mengedit, perintah terminal, dan debugging."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingegnere software ottimizzato per esplorare il codice, modificarlo, usare il terminale e fare debug."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードベースの探索、編集、ターミナル操作、デバッグに最適化されたソフトウェアエンジニア。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드베이스 탐색, 편집, 터미널 명령, 디버깅에 최적화된 소프트웨어 엔지니어."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Software-engineer, geoptimaliseerd voor navigeren door code, bewerken, terminalopdrachten en debuggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inżynier oprogramowania zoptymalizowany pod nawigację po kodzie, edycję, polecenia terminala i debugowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Engenheiro de software otimizado para navegar no código, editar, usar o terminal e depurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Программист, настроенный на навигацию по коду, правки, команды терминала и отладку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjukvaruingenjör optimerad för att navigera i kod, redigera, köra terminalkommandon och felsöka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod tabanında gezinme, düzenleme, terminal komutları ve hata ayıklama için optimize edilmiş yazılım mühendisi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Програміст, налаштований на навігацію кодом, редагування, команди термінала та налагодження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kỹ sư phần mềm tối ưu cho việc duyệt mã nguồn, chỉnh sửa, lệnh terminal và gỡ lỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为代码库浏览、编辑、终端命令和调试优化的软件工程师。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為程式碼庫瀏覽、編輯、終端機指令和除錯最佳化的軟體工程師。"
          }
        }
      }
    },
    "Some attached files may not fit the free context window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قد لا تتناسب بعض الملفات المرفقة مع المساحة الحرة لنافذة السياق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige angehängte Dateien passen möglicherweise nicht in den freien Platz des Kontextfensters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some attached files may not fit the free context window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que algunos archivos adjuntos no quepan en el espacio libre de la ventana de contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers joints peuvent ne pas tenir dans l'espace libre de la fenêtre de contexte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייתכן שחלק מהקבצים המצורפים לא ייכנסו למקום הפנוי בחלון ההקשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ संलग्न फ़ाइलें संदर्भ विंडो के खाली स्थान में नहीं आ सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa file terlampir mungkin tidak muat di ruang kosong jendela konteks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni file allegati potrebbero non entrare nello spazio libero della finestra di contesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一部の添付ファイルはコンテキストウィンドウの空き容量に収まらない可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일부 첨부 파일은 컨텍스트 창의 여유 공간에 맞지 않을 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige bijgevoegde bestanden passen mogelijk niet in de vrije ruimte van het contextvenster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niektóre załączone pliki mogą nie zmieścić się w wolnym miejscu okna kontekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos anexados podem não caber no espaço livre da janela de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые прикреплённые файлы могут не поместиться в свободное место контекстного окна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa bifogade filer kanske inte får plats i det lediga utrymmet i kontextfönstret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekli dosyalardan bazıları bağlam penceresinin boş alanına sığmayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі прикріплені файли можуть не поміститися у вільному місці контекстного вікна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số tệp đính kèm có thể không vừa với dung lượng trống của cửa sổ ngữ cảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分附加的文件可能无法放入上下文窗口的剩余空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "部分附加的檔案可能無法放入上下文視窗的剩餘空間。"
          }
        }
      }
    },
    "Some models from your earlier model store could not be copied to this Mac yet. TurboSpark tries again each time it starts and when the drive connects.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر نسخ بعض النماذج من مخزن النماذج السابق إلى هذا الـ Mac حتى الآن. يعيد TurboSpark المحاولة في كل مرة يبدأ فيها التشغيل وعند توصيل محرك الأقراص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Modelle aus Ihrem früheren Modellspeicher konnten noch nicht auf diesen Mac kopiert werden. TurboSpark versucht es bei jedem Start und beim Verbinden des Laufwerks erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some models from your earlier model store could not be copied to this Mac yet. TurboSpark tries again each time it starts and when the drive connects."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos modelos de tu almacén anterior aún no se han podido copiar a este Mac. TurboSpark lo intentará de nuevo cada vez que se inicie y cuando se conecte la unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains modèles de votre ancien stockage n'ont pas encore pu être copiés sur ce Mac. TurboSpark réessaie à chaque démarrage et à la connexion du disque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להעתיק עדיין כמה מודלים ממאגר המודלים הקודם שלך אל ה-Mac הזה. TurboSpark ינסה שוב בכל הפעלה וכשהכונן יחובר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पहले के मॉडल स्टोर के कुछ मॉडल अभी इस Mac पर कॉपी नहीं हो सके। TurboSpark हर बार शुरू होने पर और ड्राइव कनेक्ट होने पर फिर कोशिश करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa model dari penyimpanan model sebelumnya belum dapat disalin ke Mac ini. TurboSpark mencoba lagi setiap kali dibuka dan saat drive terhubung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni modelli dell'archivio precedente non sono ancora stati copiati su questo Mac. TurboSpark riprova a ogni avvio e quando l'unità viene collegata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前のモデルストアの一部のモデルを、まだこのMacにコピーできていません。TurboSparkは起動のたびと、ドライブの接続時に再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 모델 저장소의 일부 모델을 아직 이 Mac으로 복사하지 못했습니다. TurboSpark는 시작할 때마다 그리고 드라이브가 연결될 때 다시 시도합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige modellen uit uw eerdere modelopslag konden nog niet naar deze Mac worden gekopieerd. TurboSpark probeert het opnieuw bij elke start en wanneer de schijf wordt aangesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się jeszcze skopiować na ten Mac niektórych modeli z wcześniejszego magazynu. TurboSpark ponawia próbę przy każdym uruchomieniu i po podłączeniu dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns modelos do armazenamento anterior ainda não puderam ser copiados para este Mac. O TurboSpark tenta novamente a cada inicialização e quando a unidade é conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Некоторые модели из прежнего хранилища пока не удалось скопировать на этот Mac. TurboSpark повторяет попытку при каждом запуске и при подключении диска."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa modeller från det tidigare modellförrådet kunde inte kopieras till den här Macen ännu. TurboSpark försöker igen vid varje start och när enheten ansluts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki model deponuzdaki bazı modeller bu Mac'e henüz kopyalanamadı. TurboSpark her başlatıldığında ve sürücü bağlandığında yeniden dener."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Деякі моделі з попереднього сховища поки не вдалося скопіювати на цей Mac. TurboSpark повторює спробу під час кожного запуску та під час підключення диска."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một số mô hình từ kho mô hình trước đây chưa thể sao chép sang máy Mac này. TurboSpark sẽ thử lại mỗi lần khởi động và khi ổ đĩa được kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之前模型存储中的部分模型暂时无法复制到这台 Mac。TurboSpark 会在每次启动以及驱动器连接时重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之前模型儲存空間中的部分模型暫時無法複製到這部 Mac。TurboSpark 會在每次啟動以及磁碟機連接時重試。"
          }
        }
      }
    },
    "Some older tool output was shortened for this request.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some older tool output was shortened for this request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Parte de los resultados antiguos de herramientas se acortó para esta solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une partie des anciens résultats d’outils a été raccourcie pour cette requête."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ältere Werkzeugausgaben wurden für diese Anfrage gekürzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni risultati precedenti degli strumenti sono stati abbreviati per questa richiesta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns resultados antigos de ferramentas foram reduzidos para esta solicitação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Часть старых результатов инструментов была сокращена для этого запроса."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このリクエストのために古いツール出力の一部を短縮しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 요청을 위해 이전 도구 출력의 일부를 줄였습니다."
          }
        },
        "zh-Hans": {
