    "Added %lld servers; %lld skipped (name already in use).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645\u062a \u0625\u0636\u0627\u0641\u0629 %lld \u062e\u0627\u062f\u0645\u064b\u0627\u061b \u062a\u0645 \u062a\u062e\u0637\u064a %lld (\u0627\u0644\u0627\u0633\u0645 \u0642\u064a\u062f \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0628\u0627\u0644\u0641\u0639\u0644)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld Server hinzugef\u00fcgt; %lld \u00fcbersprungen (Name bereits vergeben)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added %lld servers; %lld skipped (name already in use)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se a\u00f1adieron %lld servidores; %lld omitidos (nombre ya en uso)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld serveurs ajout\u00e9s ; %lld ignor\u00e9s (nom d\u00e9j\u00e0 utilis\u00e9)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d5\u05e1\u05e4\u05d5 %lld \u05e9\u05e8\u05ea\u05d9\u05dd; %lld \u05d3\u05d5\u05dc\u05d2\u05d5 (\u05d4\u05e9\u05dd \u05db\u05d1\u05e8 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld \u0938\u0930\u094d\u0935\u0930 \u091c\u094b\u0921\u093c\u0947 \u0917\u090f; %lld \u091b\u094b\u0921\u093c\u0947 \u0917\u090f (\u0928\u093e\u092e \u092a\u0939\u0932\u0947 \u0938\u0947 \u0909\u092a\u092f\u094b\u0917 \u092e\u0947\u0902 \u0939\u0948)\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld server ditambahkan; %lld dilewati (nama sudah dipakai)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld server aggiunti; %lld saltati (nome gi\u00e0 in uso)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld \u500b\u306e\u30b5\u30fc\u30d0\u30fc\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002%lld \u500b\u3092\u30b9\u30ad\u30c3\u30d7\u3057\u307e\u3057\u305f\uff08\u540d\u524d\u306f\u65e2\u306b\u4f7f\u7528\u4e2d\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc11c\ubc84 %lld\uac1c \ucd94\uac00\ub428. %lld\uac1c \uac74\ub108\ub700(\uc774\ub984\uc774 \uc774\ubbf8 \uc0ac\uc6a9 \uc911)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld servers toegevoegd; %lld overgeslagen (naam al in gebruik)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano %lld serwer\u00f3w; pomini\u0119to %lld (nazwa ju\u017c w u\u017cyciu)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld servidores adicionados; %lld ignorados (nome j\u00e1 em uso)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0431\u0430\u0432\u043b\u0435\u043d\u043e \u0441\u0435\u0440\u0432\u0435\u0440\u043e\u0432: %lld; \u043f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u043e: %lld (\u0438\u043c\u044f \u0443\u0436\u0435 \u0437\u0430\u043d\u044f\u0442\u043e)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade till %lld servrar; hoppade \u00f6ver %lld (namnet anv\u00e4nds redan)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld sunucu eklendi; %lld atland\u0131 (ad zaten kullan\u0131mda)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0434\u0430\u043d\u043e %lld \u0441\u0435\u0440\u0432\u0435\u0440\u0456\u0432; \u043f\u0440\u043e\u043f\u0443\u0449\u0435\u043d\u043e %lld (\u0456\u043c'\u044f \u0432\u0436\u0435 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 th\u00eam %lld m\u00e1y ch\u1ee7; b\u1ecf qua %lld (t\u00ean \u0111\u00e3 \u0111\u01b0\u1ee3c d\u00f9ng)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6dfb\u52a0 %lld \u4e2a\u670d\u52a1\u5668\uff1b\u8df3\u8fc7 %lld \u4e2a\uff08\u540d\u79f0\u5df2\u88ab\u5360\u7528\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u65b0\u589e %lld \u500b\u4f3a\u670d\u5668\uff1b\u7565\u904e %lld \u500b\uff08\u540d\u7a31\u5df2\u88ab\u4f7f\u7528\uff09\u3002"
