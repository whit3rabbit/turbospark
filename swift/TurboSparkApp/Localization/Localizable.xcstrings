        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\ub41c \ud1a0\ud070\uc744 \uc81c\uac70\ud588\uc9c0\ub9cc \ub2e4\ub978 \ud1a0\ud070\uc774 \uc5ec\uc804\ud788 \uc801\uc6a9 \uc911\uc785\ub2c8\ub2e4(\ud658\uacbd \ubcc0\uc218 \ub610\ub294 Hugging Face CLI \uce90\uc2dc)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen token verwijderd, maar er is nog een ander token actief (omgevingsvariabele of Hugging Face CLI-cache)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuni\u0119to zapisany token, ale nadal dzia\u0142a inny token (zmienna \u015brodowiskowa lub pami\u0119\u0107 podr\u0119czna Hugging Face CLI)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Token salvo removido, mas outro token ainda est\u00e1 em vigor (vari\u00e1vel de ambiente ou cache da CLI do Hugging Face)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u0442\u043e\u043a\u0435\u043d \u0443\u0434\u0430\u043b\u0451\u043d, \u043d\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u0435\u0442 \u0434\u0440\u0443\u0433\u043e\u0439 \u0442\u043e\u043a\u0435\u043d (\u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u0430\u044f \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u043a\u044d\u0448 Hugging Face CLI)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den sparade token togs bort, men en annan token g\u00e4ller fortfarande (milj\u00f6variabel eller Hugging Face CLI-cache)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kay\u0131tl\u0131 belirte\u00e7 kald\u0131r\u0131ld\u0131, ancak ba\u015fka bir belirte\u00e7 h\u00e2l\u00e2 ge\u00e7erli (ortam de\u011fi\u015fkeni veya Hugging Face CLI \u00f6nbelle\u011fi)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0439 \u0442\u043e\u043a\u0435\u043d \u0432\u0438\u043b\u0443\u0447\u0435\u043d\u043e, \u0430\u043b\u0435 \u0434\u0456\u0454 \u0456\u043d\u0448\u0438\u0439 \u0442\u043e\u043a\u0435\u043d (\u0437\u043c\u0456\u043d\u043d\u0430 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 \u0430\u0431\u043e \u043a\u0435\u0448 Hugging Face CLI)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 x\u00f3a m\u00e3 th\u00f4ng b\u00e1o \u0111\u00e3 l\u01b0u, nh\u01b0ng m\u1ed9t m\u00e3 kh\u00e1c v\u1eabn \u0111ang c\u00f3 hi\u1ec7u l\u1ef1c (bi\u1ebfn m\u00f4i tr\u01b0\u1eddng ho\u1eb7c b\u1ed9 nh\u1edb \u0111\u1ec7m Hugging Face CLI)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u79fb\u9664\u4fdd\u5b58\u7684\u4ee4\u724c\uff0c\u4f46\u53e6\u4e00\u4e2a\u4ee4\u724c\u4ecd\u7136\u6709\u6548\uff08\u73af\u5883\u53d8\u91cf\u6216 Hugging Face CLI \u7f13\u5b58\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u79fb\u9664\u5132\u5b58\u7684\u6b0a\u6756\uff0c\u4f46\u53e6\u4e00\u500b\u6b0a\u6756\u4ecd\u7136\u6709\u6548\uff08\u74b0\u5883\u8b8a\u6578\u6216 Hugging Face CLI \u5feb\u53d6\uff09\u3002"
          }
        }
      }
    },
