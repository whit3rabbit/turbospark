    "Install models locally from the curated catalog or Hugging Face.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062b\u0628\u0651\u062a \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0645\u062d\u0644\u064a\u0627 \u0645\u0646 \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u0645\u0646\u0633\u0642 \u0623\u0648 \u0645\u0646 Hugging Face."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie Modelle lokal aus dem kuratierten Katalog oder von Hugging Face."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install models locally from the curated catalog or Hugging Face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala modelos localmente desde el cat\u00e1logo curado o desde Hugging Face."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez des mod\u00e8les en local depuis le catalogue s\u00e9lectionn\u00e9 ou depuis Hugging Face."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05e7\u05df \u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05de\u05e7\u05d5\u05de\u05d9\u05ea \u05de\u05d4\u05e7\u05d8\u05dc\u05d5\u05d2 \u05d4\u05d0\u05e6\u05d5\u05e8 \u05d0\u05d5 \u05de-Hugging Face."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094d\u092f\u0942\u0930\u0947\u091f\u0947\u0921 \u0915\u0948\u091f\u0932\u0949\u0917 \u092f\u093e Hugging Face \u0938\u0947 \u092e\u0949\u0921\u0932 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u0930\u0942\u092a \u0938\u0947 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang model secara lokal dari katalog kurasi atau Hugging Face."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa modelli in locale dal catalogo curato o da Hugging Face."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53b3\u9078\u30ab\u30bf\u30ed\u30b0\u307e\u305f\u306f Hugging Face \u304b\u3089\u30e2\u30c7\u30eb\u3092\u30ed\u30fc\u30ab\u30eb\u306b\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ubcc4\ub41c \uce74\ud0c8\ub85c\uadf8\ub098 Hugging Face\uc5d0\uc11c \ubaa8\ub378\uc744 \ub85c\uceec\uc5d0 \uc124\uce58\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer modellen lokaal vanuit de samengestelde catalogus of vanaf Hugging Face."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluj modele lokalnie z wyselekcjonowanego katalogu lub z Hugging Face."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale modelos localmente a partir do cat\u00e1logo curado ou do Hugging Face."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0439\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e \u0438\u0437 \u043a\u0443\u0440\u0438\u0440\u0443\u0435\u043c\u043e\u0433\u043e \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0430 \u0438\u043b\u0438 \u0441 Hugging Face."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera modeller lokalt fr\u00e5n den kurerade katalogen eller fr\u00e5n Hugging Face."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelleri se\u00e7ilmi\u015f katalogdan veya Hugging Face'ten yerel olarak kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u044e\u0439\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u0456 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e \u0437 \u0434\u043e\u0431\u0456\u0440\u043d\u043e\u0433\u043e \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0443 \u0430\u0431\u043e \u0437 Hugging Face."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e0i \u0111\u1eb7t m\u00f4 h\u00ecnh c\u1ee5c b\u1ed9 t\u1eeb danh m\u1ee5c tuy\u1ec3n ch\u1ecdn ho\u1eb7c t\u1eeb Hugging Face."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u7cbe\u9009\u76ee\u5f55\u6216 Hugging Face \u5728\u672c\u5730\u5b89\u88c5\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u7cbe\u9078\u76ee\u9304\u6216 Hugging Face \u5728\u672c\u6a5f\u5b89\u88dd\u6a21\u578b\u3002"
          }
        }
      }
    },
