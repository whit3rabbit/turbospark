          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u73fe\u5728\u306e AGENTS.md\u3001CLAUDE.md\u3001CONTEXT.md\u3001SOUL.md \u3092\u78ba\u8a8d"
          }
