      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0645\u0641\u0639\u0651\u0644 (\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u062c\u0647\u062f \u0644\u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachdenken an (dieses Modell hat keine Aufwandsstufen)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thinking on (this model has no effort levels)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Razonamiento activado (este modelo no tiene niveles de esfuerzo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9flexion activ\u00e9e (ce mod\u00e8le n'a pas de niveaux d'effort)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05e9\u05d9\u05d1\u05d4 \u05e4\u05e2\u05d9\u05dc\u05d4 (\u05dc\u05de\u05d5\u05d3\u05dc \u05d6\u05d4 \u05d0\u05d9\u05df \u05e8\u05de\u05d5\u05ea \u05de\u05d0\u05de\u05e5)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094b\u091a \u091a\u093e\u0932\u0942 (\u0907\u0938 \u092e\u0949\u0921\u0932 \u092e\u0947\u0902 \u092a\u094d\u0930\u092f\u093e\u0938 \u0938\u094d\u0924\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berpikir aktif (model ini tidak memiliki tingkat upaya)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ragionamento attivo (questo modello non ha livelli di sforzo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u601d\u8003\u30aa\u30f3 (\u3053\u306e\u30e2\u30c7\u30eb\u306b\u306f\u6df1\u3055\u306e\u30ec\u30d9\u30eb\u304c\u3042\u308a\u307e\u305b\u3093)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uace0 \ucf1c\uc9d0(\uc774 \ubaa8\ub378\uc5d0\ub294 \ub178\ub825 \uc218\uc900\uc774 \uc5c6\uc74c)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadenken aan (dit model heeft geen inspanningsniveaus)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozumowanie w\u0142\u0105czone (ten model nie ma poziom\u00f3w wysi\u0142ku)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Racioc\u00ednio ativado (este modelo n\u00e3o tem n\u00edveis de esfor\u00e7o)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u044b (\u0443 \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0435\u0442 \u0443\u0440\u043e\u0432\u043d\u0435\u0439)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e4nkande p\u00e5 (den h\u00e4r modellen har inga insatsniv\u00e5er)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fc\u015f\u00fcnme a\u00e7\u0131k (bu modelin \u00e7aba seviyesi yok)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e (\u0446\u044f \u043c\u043e\u0434\u0435\u043b\u044c \u043d\u0435 \u043c\u0430\u0454 \u0440\u0456\u0432\u043d\u0456\u0432)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1eadt suy ngh\u0129 (m\u00f4 h\u00ecnh n\u00e0y kh\u00f4ng c\u00f3 m\u1ee9c n\u1ed7 l\u1ef1c)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u601d\u8003\u5df2\u5f00\u542f\uff08\u6b64\u6a21\u578b\u6ca1\u6709\u6df1\u5ea6\u7ea7\u522b\uff09"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u601d\u8003\u5df2\u958b\u555f\uff08\u6b64\u6a21\u578b\u6c92\u6709\u5f37\u5ea6\u7b49\u7d1a\uff09"
          }
        }
      }
    },
    "This checkpoint's chat template has no reasoning levels.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u062d\u062a\u0648\u064a \u0642\u0627\u0644\u0628 \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u062e\u0627\u0635 \u0628\u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0647\u0630\u0647 \u0639\u0644\u0649 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u062a\u0641\u0643\u064a\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Chat-Vorlage dieses Checkpoints hat keine Denkstufen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This checkpoint's chat template has no reasoning levels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La plantilla de chat de este checkpoint no tiene niveles de razonamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mod\u00e8le de discussion de ce checkpoint n'a aucun niveau de raisonnement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05ea\u05d1\u05e0\u05d9\u05ea \u05d4\u05e6'\u05d0\u05d8 \u05e9\u05dc \u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d4\u05d6\u05d5 \u05d0\u05d9\u05df \u05e8\u05de\u05d5\u05ea \u05d7\u05e9\u05d9\u05d1\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u0915\u0947 \u091a\u0948\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u092e\u0947\u0902 \u0915\u094b\u0908 \u0930\u0940\u091c\u093c\u0928\u093f\u0902\u0917 \u0938\u094d\u0924\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Templat obrolan checkpoint ini tidak memiliki tingkat penalaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello di chat di questo checkpoint non ha livelli di ragionamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306e\u30c1\u30e3\u30c3\u30c8\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u306b\u306f\u63a8\u8ad6\u30ec\u30d9\u30eb\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uccb4\ud06c\ud3ec\uc778\ud2b8\uc758 \ucc44\ud305 \ud15c\ud50c\ub9bf\uc5d0\ub294 \ucd94\ub860 \uc218\uc900\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De chatsjabloon van dit checkpoint heeft geen redeneerniveaus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablon czatu tego checkpointu nie ma poziom\u00f3w rozumowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O template de chat deste checkpoint n\u00e3o tem n\u00edveis de racioc\u00ednio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0447\u0430\u0442-\u0448\u0430\u0431\u043b\u043e\u043d\u0435 \u044d\u0442\u043e\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438 \u043d\u0435\u0442 \u0443\u0440\u043e\u0432\u043d\u0435\u0439 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r checkpointens chattmall har inga resonemangsniv\u00e5er."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu denetim noktas\u0131n\u0131n sohbet \u015fablonunda ak\u0131l y\u00fcr\u00fctme d\u00fczeyi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0430\u0442-\u0448\u0430\u0431\u043b\u043e\u043d \u0446\u0456\u0454\u0457 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0457 \u0442\u043e\u0447\u043a\u0438 \u043d\u0435 \u043c\u0430\u0454 \u0440\u0456\u0432\u043d\u0456\u0432 \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1eabu tr\u00f2 chuy\u1ec7n c\u1ee7a checkpoint n\u00e0y kh\u00f4ng c\u00f3 m\u1ee9c suy lu\u1eadn n\u00e0o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u68c0\u67e5\u70b9\u7684\u804a\u5929\u6a21\u677f\u6ca1\u6709\u63a8\u7406\u7ea7\u522b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6aa2\u67e5\u9ede\u7684\u804a\u5929\u7bc4\u672c\u6c92\u6709\u63a8\u7406\u7b49\u7d1a\u3002"
          }
        }
      }
    },
    "This engine's version, not an Ollama one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0635\u062f\u0627\u0631 \u0647\u0630\u0627 \u0627\u0644\u0645\u062d\u0631\u0643\u060c \u0648\u0644\u064a\u0633 \u0625\u0635\u062f\u0627\u0631 Ollama."
