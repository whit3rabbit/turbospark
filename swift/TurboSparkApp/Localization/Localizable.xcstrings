    "Sampling and prompt changes apply to the next turn. Load settings apply after model reload.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطبق تغييرات أخذ العينات والموجه في الدور التالي. تُطبق إعدادات التحميل بعد إعادة تحميل النموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampling- und Prompt-Änderungen gelten ab der nächsten Runde. Ladeeinstellungen werden nach dem Neuladen des Modells wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampling and prompt changes apply to the next turn. Load settings apply after model reload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de muestreo y prompt se aplican en el siguiente turno. Los ajustes de carga se aplican tras recargar el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications d'échantillonnage et de prompt s'appliquent au tour suivant. Les paramètres de chargement s'appliquent après le rechargement du modèle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שינויי דגימה והנחיה חלים בתור הבא. הגדרות טעינה חלות לאחר טעינה מחדש של המודל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सैंपलिंग और प्रॉम्प्ट परिवर्तन अगले मोड़ पर लागू होते हैं। लोड सेटिंग्स मॉडल पुनः लोड होने के बाद लागू होती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan pengambilan sampel dan prompt berlaku pada giliran berikutnya. Pengaturan pemuatan berlaku setelah model dimuat ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche al campionamento e ai prompt si applicano al turno successivo. Le impostazioni di caricamento si applicano dopo il ricaricamento del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サンプリングとプロンプトの変更は次のターンから適用されます。ロード設定はモデルの再ロード後に適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "샘플링 및 프롬프트 변경 사항은 다음 턴부터 적용됩니다. 로드 설정은 모델을 다시 로드한 후에 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen in sampling en prompts worden van kracht bij de volgende beurt. Laadinstellingen worden toegepast na het herladen van het model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany próbkowania i promptu obowiązują od następnej tury. Ustawienia ładowania są stosowane po ponownym załadowaniu modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As alterações de amostragem e prompt são aplicadas no próximo turno. As configurações de carregamento são aplicadas após recarregar o modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения выборки и промпта применяются со следующего хода. Настройки загрузки применяются после перезагрузки модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändringar av sampling och prompt tillämpas vid nästa tur. Laddningsinställningar tillämpas efter att modellen lästs in igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Örnekleme ve istem değişiklikleri sonraki turda geçerli olur. Yükleme ayarları model yeniden yüklendikten sonra uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зміни вибірки та промпту застосовуються з наступного ходу. Налаштування завантаження застосовуються після перезавантаження моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay đổi lấy mẫu và câu lệnh áp dụng cho lượt tiếp theo. Cài đặt tải áp dụng sau khi tải lại mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
