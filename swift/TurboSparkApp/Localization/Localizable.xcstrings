    "One passage is too long for the model. Add paragraph breaks and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One passage is too long for the model. Add paragraph breaks and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أحد المقاطع طويل جدًا على النموذج. أضف فواصل فقرات ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abschnitt ist zu lang für das Modell. Fügen Sie Absatzumbrüche ein und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fragmento es demasiado largo para el modelo. Añade saltos de párrafo e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passage est trop long pour le modèle. Ajoutez des sauts de paragraphe et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחד הקטעים ארוך מדי עבור המודל. הוסף מעברי פסקה ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अंश मॉडल के लिए बहुत लंबा है। अनुच्छेद विराम जोड़ें और फिर से प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu bagian terlalu panjang untuk model. Tambahkan jeda paragraf lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passaggio è troppo lungo per il modello. Aggiungi interruzioni di paragrafo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルには長すぎる箇所があります。段落の区切りを入れてからもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 처리하기에 너무 긴 구간이 있습니다. 문단을 나눈 뒤 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén passage is te lang voor het model. Voeg alinea-einden toe en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden fragment jest za długi dla modelu. Dodaj podziały akapitów i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um trecho é longo demais para o modelo. Adicione quebras de parágrafo e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один фрагмент слишком длинный для модели. Разбейте его на абзацы и повторите попытку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett avsnitt är för långt för modellen. Lägg till styckebrytningar och försök igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir bölüm model için çok uzun. Paragraf sonu ekleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один фрагмент задовгий для моделі. Розбийте його на абзаци й повторіть спробу."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một đoạn quá dài đối với mô hình. Hãy thêm ngắt đoạn rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一段内容对模型来说太长。请添加段落分隔后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一段內容對模型來說太長。請加入段落分隔後重試。"
          }
        }
      }
    },
    "One per line as old -> new. Applied to the rewrite after the model's own checks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One per line as old -> new. Applied to the rewrite after the model's own checks."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واحد في كل سطر بصيغة قديم -> جديد. يُطبَّق على إعادة الصياغة بعد فحوصات النموذج نفسه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine pro Zeile als alt -> neu. Wird nach den eigenen Prüfungen des Modells auf die Umschreibung angewendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una por línea como antiguo -> nuevo. Se aplica a la reescritura después de las comprobaciones del propio modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une par ligne sous la forme ancien -> nouveau. Appliqué à la réécriture après les vérifications du modèle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אחת בכל שורה בתבנית ישן -> חדש. מוחל על השכתוב אחרי הבדיקות של המודל עצמו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पंक्ति में एक, पुराना -> नया के रूप में। मॉडल की अपनी जाँच के बाद पुनर्लेखन पर लागू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu per baris sebagai lama -> baru. Diterapkan ke hasil tulis ulang setelah pemeriksaan model sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una per riga come vecchio -> nuovo. Applicate alla riscrittura dopo i controlli del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 行に 1 つずつ「旧 -> 新」の形式で記入します。モデル自身のチェックの後に書き直しへ適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 줄에 하나씩 이전 -> 새 형식으로 입력합니다. 모델 자체 검사 후 다시 쓴 글에 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén per regel als oud -> nieuw. Toegepast op de herschrijving na de eigen controles van het model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna w wierszu w formacie stare -> nowe. Stosowane do przepisanego tekstu po własnych kontrolach modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma por linha no formato antigo -> novo. Aplicada à reescrita depois das verificações do próprio modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По одной на строку в виде старое -> новое. Применяются к переписанному тексту после проверок самой модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En per rad som gammalt -> nytt. Tillämpas på omskrivningen efter modellens egna kontroller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satıra bir tane, eski -> yeni biçiminde. Modelin kendi denetimlerinden sonra yeniden yazıma uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "По одній у рядку у вигляді старе -> нове. Застосовуються до переписаного тексту після перевірок самої моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi dòng một cặp dạng cũ -> mới. Áp dụng cho bản viết lại sau khi mô hình tự kiểm tra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一条，格式为 旧 -> 新。在模型自身检查之后应用到改写结果。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每行一條，格式為 舊 -> 新。在模型自身檢查之後套用到改寫結果。"
          }
        }
      }
    },
    "Only clone your own voice or the voice of someone who agreed. Changing the reference clears this confirmation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only clone your own voice or the voice of someone who agreed. Changing the reference clears this confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona solo tu propia voz o la de alguien que haya dado su consentimiento. Cambiar la referencia borra esta confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne clonez que votre propre voix ou celle d'une personne qui a donné son accord. Changer la référence efface cette confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonen Sie nur Ihre eigene Stimme oder die Stimme einer Person, die zugestimmt hat. Wenn Sie die Referenz ändern, wird diese Bestätigung zurückgesetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona solo la tua voce o quella di una persona che ha dato il consenso. Cambiare il riferimento annulla questa conferma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone apenas a sua própria voz ou a de alguém que concordou. Alterar a referência apaga esta confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Клонируйте только свой голос или голос человека, который дал согласие. При смене эталона это подтверждение сбрасывается."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クローンするのは自分の声か、同意した人の声だけにしてください。参考音声を変更すると、この確認は解除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "본인의 음성이나 동의한 사람의 음성만 복제하세요. 참조를 변경하면 이 확인이 해제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只克隆你自己的声音，或已同意的人的声音。更换参考音频会清除此确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只複製你自己的聲音，或已同意的人的聲音。更換參考音訊會清除此確認。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تستنسخ إلا صوتك أو صوت شخص وافق على ذلك. يؤدي تغيير المرجع إلى إلغاء هذا التأكيد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שכפל רק את הקול שלך או קול של מי שהסכים לכך. שינוי ההתייחסות מבטל את האישור הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल अपनी आवाज़ या उस व्यक्ति की आवाज़ क्लोन करें जिसने सहमति दी हो। संदर्भ बदलने पर यह पुष्टि हट जाती है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloon alleen je eigen stem of de stem van iemand die toestemming gaf. Als je de referentie wijzigt, vervalt deze bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonuj tylko własny głos lub głos osoby, która wyraziła zgodę. Zmiana nagrania referencyjnego anuluje to potwierdzenie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kendi sesinizi veya izin veren birinin sesini klonlayın. Referansı değiştirmek bu onayı kaldırır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Клонуйте лише власний голос або голос людини, яка погодилася. Зміна еталона скасовує це підтвердження."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klona bara din egen röst eller rösten hos någon som har samtyckt. Om du byter referens nollställs bekräftelsen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ nhân bản giọng của chính bạn hoặc của người đã đồng ý. Đổi bản tham khảo sẽ xóa xác nhận này."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya kloning suara Anda sendiri atau suara orang yang sudah setuju. Mengganti referensi akan menghapus konfirmasi ini."
          }
        }
      }
    },
    "Only images saved by this profile can be removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن إزالة الصور المحفوظة بواسطة هذا الملف الشخصي فقط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur Bilder, die von diesem Profil gespeichert wurden, können entfernt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only images saved by this profile can be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden eliminar las imágenes guardadas por este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les images enregistrées par ce profil peuvent être supprimées."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להסיר רק תמונות שנשמרו על ידי פרופיל זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल इस प्रोफ़ाइल द्वारा सहेजी गई छवियाँ ही हटाई जा सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya gambar yang disimpan oleh profil ini yang dapat dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo le immagini salvate da questo profilo possono essere rimosse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除できるのは、このプロファイルで保存した画像のみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로필에서 저장한 이미지만 제거할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen afbeeldingen die door dit profiel zijn opgeslagen, kunnen worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Można usuwać tylko obrazy zapisane przez ten profil."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente imagens salvas por este perfil podem ser removidas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалять можно только изображения, сохраненные этим профилем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast bilder som sparats av den här profilen kan tas bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bu profil tarafından kaydedilen görüntüler kaldırılabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляти можна лише зображення, збережені цим профілем."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể xóa hình ảnh do hồ sơ này lưu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能移除由此配置档案保存的图像。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只能移除由此設定檔儲存的影像。"
          }
        }
      }
    },
    "Only record audio you have the right to use. Protected streams may record as silence.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تسجّل إلا الصوت الذي يحق لك استخدامه. قد تُسجَّل البثوث المحمية على شكل صمت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm nur Audio auf, das du verwenden darfst. Geschützte Streams werden möglicherweise als Stille aufgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only record audio you have the right to use. Protected streams may record as silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba solo audio que tengas derecho a usar. Las transmisiones protegidas pueden grabarse como silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "N'enregistrez que du son que vous avez le droit d'utiliser. Les flux protégés peuvent être enregistrés comme du silence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלט רק שמע שיש לך זכות להשתמש בו. זרמים מוגנים עשויים להיות מוקלטים כשקט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल वही ऑडियो रिकॉर्ड करें जिसका उपयोग करने का आपको अधिकार है। सुरक्षित स्ट्रीम मौन के रूप में रिकॉर्ड हो सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam hanya audio yang berhak Anda gunakan. Aliran yang dilindungi mungkin terekam sebagai keheningan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra solo audio che hai il diritto di usare. I flussi protetti potrebbero essere registrati come silenzio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用する権利のあるオーディオのみを録音してください。保護されたストリームは無音で録音される場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용할 권리가 있는 오디오만 녹음하세요. 보호된 스트림은 무음으로 녹음될 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem alleen audio op die je mag gebruiken. Beveiligde streams kunnen als stilte worden opgenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywaj tylko dźwięk, do którego masz prawa. Chronione strumienie mogą zostać nagrane jako cisza."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave apenas áudio que você tem o direito de usar. Transmissões protegidas podem ser gravadas como silêncio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Записывайте только звук, который вы вправе использовать. Защищённые потоки могут записаться как тишина."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela bara in ljud som du har rätt att använda. Skyddade strömmar kan spelas in som tystnad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca kullanma hakkınız olan sesi kaydedin. Korumalı akışlar sessizlik olarak kaydedilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записуйте лише звук, який ви маєте право використовувати. Захищені потоки можуть записатися як тиша."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ ghi âm thanh mà bạn có quyền sử dụng. Luồng được bảo vệ có thể được ghi thành khoảng lặng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅录制你有权使用的音频。受保护的音频流可能会被录制为静音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅錄製你有權使用的音訊。受保護的串流可能會被錄製為靜音。"
          }
        }
      }
    },
    "Only supported MLX image models can be installed in the app.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تثبيت سوى نماذج صور MLX المدعومة في التطبيق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der App können nur unterstützte MLX-Bildmodelle installiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only supported MLX image models can be installed in the app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se pueden instalar en la app los modelos de imagen MLX compatibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les modèles d'image MLX pris en charge peuvent être installés dans l'app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתן להתקין באפליקציה רק מודלי תמונה MLX נתמכים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऐप में केवल समर्थित MLX इमेज मॉडल ही इंस्टॉल किए जा सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya model gambar MLX yang didukung yang dapat dipasang di aplikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nell'app è possibile installare solo modelli di immagini MLX supportati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリにインストールできるのは、対応している MLX 画像モデルのみです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱에는 지원되는 MLX 이미지 모델만 설치할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen ondersteunde MLX-afbeeldingsmodellen kunnen in de app worden geïnstalleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W aplikacji można instalować tylko obsługiwane modele obrazów MLX."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Somente modelos de imagem MLX compatíveis podem ser instalados no app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В приложении можно устанавливать только поддерживаемые модели изображений MLX."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast MLX-bildmodeller som stöds kan installeras i appen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulamaya yalnızca desteklenen MLX görüntü modelleri kurulabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У застосунку можна встановлювати лише підтримувані моделі зображень MLX."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có thể cài đặt các mô hình hình ảnh MLX được hỗ trợ trong ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "应用内只能安装受支持的 MLX 图像模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "App 內只能安裝支援的 MLX 影像模型。"
          }
        }
      }
    },
    "Only the Default profile exists. Add one below to give it its own settings, chats, and skills.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد الملف الشخصي الافتراضي فقط. أضف ملفًا أدناه ليحصل على إعداداته ودردشاته ومهاراته الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt nur das Standardprofil. Füge unten eines hinzu, um ihm eigene Einstellungen, Chats und Skills zu geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the Default profile exists. Add one below to give it its own settings, chats, and skills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo existe el perfil predeterminado. Añade uno abajo para darle sus propios ajustes, chats y habilidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul le profil par défaut existe. Ajoutez-en un ci-dessous pour lui donner ses propres réglages, chats et compétences."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיים רק פרופיל ברירת המחדל. הוסיפו פרופיל למטה כדי להעניק לו הגדרות, צ'אטים ומיומנויות משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल डिफ़ॉल्ट प्रोफ़ाइल मौजूद है। उसे अपनी सेटिंग्स, चैट और स्किल देने के लिए नीचे एक जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya profil Default yang ada. Tambahkan satu di bawah untuk memberinya pengaturan, obrolan, dan skill sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste solo il profilo predefinito. Aggiungine uno qui sotto per dargli impostazioni, chat e skill propri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デフォルトのプロファイルだけがあります。下で追加すると、独自の設定、チャット、スキルを持たせられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 프로필만 있습니다. 아래에서 프로필을 추가하면 자체 설정, 채팅, 스킬을 가질 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen het standaardprofiel bestaat. Voeg hieronder een profiel toe om het eigen instellingen, chats en skills te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istnieje tylko profil domyślny. Dodaj poniżej nowy, aby miał własne ustawienia, czaty i umiejętności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só existe o perfil padrão. Adicione um abaixo para que ele tenha seus próprios ajustes, chats e habilidades."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существует только профиль по умолчанию. Добавьте профиль ниже, чтобы у него были свои настройки, чаты и навыки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara standardprofilen finns. Lägg till en nedan för att ge den egna inställningar, chattar och färdigheter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Varsayılan profil var. Kendi ayarları, sohbetleri ve becerileri olan bir profil eklemek için aşağıyı kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Існує лише типовий профіль. Додайте профіль нижче, щоб він мав власні налаштування, чати й навички."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có hồ sơ Mặc định. Thêm một hồ sơ bên dưới để nó có cài đặt, cuộc trò chuyện và kỹ năng riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有默认配置文件。在下方添加一个，即可拥有自己的设置、聊天和技能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有預設設定檔。在下方加入一個，即可擁有自己的設定、聊天和技能。"
          }
        }
      }
    },
