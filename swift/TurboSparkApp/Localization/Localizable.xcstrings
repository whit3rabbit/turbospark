    "The menu bar and system dialogs switch language after TurboSpark relaunches.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتغير لغة شريط القوائم ومربعات حوار النظام بعد إعادة تشغيل TurboSpark."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Menüleiste und Systemdialoge wechseln die Sprache nach einem Neustart von TurboSpark."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The menu bar and system dialogs switch language after TurboSpark relaunches."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra de menús y los cuadros de diálogo del sistema cambian de idioma al reiniciar TurboSpark."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La barre de menus et les boîtes de dialogue du système changent de langue au redémarrage de TurboSpark."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שורת התפריטים ותיבות הדו-שיח של המערכת יחליפו שפה לאחר הפעלה מחדש של TurboSpark."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark के दोबारा लॉन्च होने के बाद मेनू बार और सिस्टम डायलॉग की भाषा बदल जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilah menu dan dialog sistem berganti bahasa setelah TurboSpark diluncurkan ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La barra dei menu e le finestre di dialogo di sistema cambiano lingua al riavvio di TurboSpark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メニューバーとシステムダイアログの言語は、TurboSpark の再起動後に切り替わります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메뉴 막대와 시스템 대화상자의 언어는 TurboSpark가 다시 실행된 후에 바뀝니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De menubalk en systeemdialoogvensters wisselen van taal nadat TurboSpark opnieuw is gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasek menu i okna dialogowe systemu zmienią język po ponownym uruchomieniu TurboSpark."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A barra de menus e as caixas de diálogo do sistema mudam de idioma depois que o TurboSpark reabrir."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строка меню и системные диалоги сменят язык после перезапуска TurboSpark."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyraden och systemdialogerna byter språk när TurboSpark har startats om."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Menü çubuğu ve sistem iletişim kutuları, TurboSpark yeniden başlatıldıktan sonra dil değiştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Рядок меню та системні діалоги змінять мову після перезапуску TurboSpark."
