    "DFlash2 (Dynamic Sloth): proposes entire token blocks in one forward pass": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): يقترح كتل رموز كاملة في تمريرة أمامية واحدة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): schlägt ganze Tokenblöcke in einem Vorwärtsdurchlauf vor"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): proposes entire token blocks in one forward pass"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): propone bloques completos de tokens en una sola pasada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth) : propose des blocs entiers de jetons en une seule passe"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): מציע בלוקים שלמים של טוקנים במעבר קדמי אחד"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): एक फ़ॉरवर्ड पास में पूरे टोकन ब्लॉक प्रस्तावित करता है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): mengusulkan blok token utuh dalam satu forward pass"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): propone interi blocchi di token in un solo passaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2（Dynamic Sloth）: 1回のフォワードパスでトークンブロック全体を提案"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2(Dynamic Sloth): 한 번의 순방향 패스로 토큰 블록 전체를 제안"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): stelt hele tokenblokken voor in één voorwaartse pass"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): proponuje całe bloki tokenów w jednym przebiegu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): propõe blocos inteiros de tokens em uma única passagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): предлагает целые блоки токенов за один проход"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): föreslår hela tokenblock i ett framåtpass"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): tek ileri geçişte tüm token bloklarını önerir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): пропонує цілі блоки токенів за один прохід"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2 (Dynamic Sloth): đề xuất toàn bộ khối token trong một lượt truyền xuôi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2（Dynamic Sloth）：一次前向传播即可提出整块令牌"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "DFlash2（Dynamic Sloth）：一次前向傳遞即可提出整塊權杖"
          }
        }
      }
    },
