    "The restored encrypted database failed its integrity check.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشلت قاعدة البيانات المشفرة المستعادة في فحص السلامة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die wiederhergestellte verschlüsselte Datenbank hat die Integritätsprüfung nicht bestanden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restored encrypted database failed its integrity check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos cifrada restaurada no superó la comprobación de integridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de données chiffrée restaurée n'a pas réussi son contrôle d'intégrité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסד הנתונים המוצפן ששוחזר נכשל בבדיקת השלמות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्स्थापित एन्क्रिप्टेड डेटाबेस अखंडता जाँच में विफल रहा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Basis data terenkripsi yang dipulihkan gagal dalam pemeriksaan integritas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database cifrato ripristinato non ha superato il controllo di integrità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元された暗号化データベースが整合性チェックに失敗しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복원된 암호화 데이터베이스가 무결성 검사를 통과하지 못했습니다."
          }
        },
        "nl": {
