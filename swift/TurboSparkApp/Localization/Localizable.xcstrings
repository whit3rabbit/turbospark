        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0947\u0902\u091a\u092e\u093e\u0930\u094d\u0915 \u0926\u0943\u0936\u094d\u092f: \u0932\u093e\u0907\u0935 \u0917\u094d\u0930\u093e\u092b\u093c (\u0938\u0902\u0916\u094d\u092f\u093e\u0913\u0902 \u092a\u0930 \u091c\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902)"
