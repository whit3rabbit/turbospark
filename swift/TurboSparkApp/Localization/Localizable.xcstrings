          "stringUnit": {
            "state": "translated",
            "value": "T\u00ecm ki\u1ebfm m\u00e3 \u0111\u01b0\u1ee3c l\u1eadp ch\u1ec9 m\u1ee5c nhanh theo ki\u1ec3u ripgrep cho d\u1ef1 \u00e1n n\u00e0y."
          }
        },
        "zh-Hans": {
