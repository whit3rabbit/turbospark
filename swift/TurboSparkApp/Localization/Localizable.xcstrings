      }
    },
    "This removes the draft and the rewrite.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة المسودة وإعادة الصياغة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden der Entwurf und die Umschreibung entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This removes the draft and the rewrite."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto elimina el borrador y la reescritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime le brouillon et la réécriture."
          }
        },
        "he": {
