    "Hugging Face API rate limit reached. Retry in %llds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم الوصول إلى الحد الأقصى لمعدل واجهة برمجة تطبيقات Hugging Face. أعد المحاولة بعد %lld ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face-API-Ratenlimit erreicht. Wiederholen in %lld s."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API rate limit reached. Retry in %llds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se alcanzó el límite de solicitudes de la API de Hugging Face. Reintenta en %lld s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de débit de l'API Hugging Face atteinte. Réessayez dans %lld s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הושגה מגבלת הקצב של Hugging Face API. נסה שוב בעוד %lld שניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हगिंग फेस एपीआई दर सीमा समाप्त हो गई है। %lld सेकंड में पुनः प्रयास करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas kecepatan API Hugging Face tercapai. Coba lagi dalam %lld dtk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggiunto il limite di frequenza dell'API di Hugging Face. Riprova tra %lld s."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API のレート制限に達しました。%lld 秒後に再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API 속도 제한에 도달했습니다. %lld초 후에 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API-snelheidslimiet bereikt. Probeer over %lld s opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Osiągnięto limit szybkości interfejsu API Hugging Face. Ponów próbę za %lld s."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite de taxa da API do Hugging Face atingido. Tente novamente em %lld s."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Достигнут лимит запросов API Hugging Face. Повторите попытку через %lld с."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hastighetsgränsen för Hugging Face API har nåtts. Försök igen om %lld s."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face API hız sınırına ulaşıldı. %lld sn sonra tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Досягнуто ліміту запитів API Hugging Face. Повторіть спробу через %lld с."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã đạt đến giới hạn tỷ lệ API Hugging Face. Thử lại sau %lld giây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
