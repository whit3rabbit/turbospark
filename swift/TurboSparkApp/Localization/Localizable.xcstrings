        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043d\u0434\u0435\u043a\u0441\u0430\u0446\u0438\u044f \u043a\u043e\u0434\u0430 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u043e (\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 > \u041e\u0441\u043d\u043e\u0432\u043d\u044b\u0435)."
