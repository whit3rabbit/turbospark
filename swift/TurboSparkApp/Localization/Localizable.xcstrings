    "Web search enabled: tools will search the web for real-time information": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0648\u064a\u0628 \u0645\u0641\u0639\u0651\u0644: \u0633\u062a\u0628\u062d\u062b \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0641\u064a \u0627\u0644\u0648\u064a\u0628 \u0639\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0622\u0646\u064a\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Websuche aktiv: Werkzeuge durchsuchen das Web nach aktuellen Informationen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Web search enabled: tools will search the web for real-time information"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fasqueda web activada: las herramientas buscar\u00e1n informaci\u00f3n en tiempo real en la web"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche web activ\u00e9e : les outils chercheront des informations en temps r\u00e9el sur le web"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05de\u05d5\u05e4\u05e2\u05dc: \u05d4\u05db\u05dc\u05d9\u05dd \u05d9\u05d7\u05e4\u05e9\u05d5 \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8 \u05de\u05d9\u05d3\u05e2 \u05e2\u05d3\u05db\u05e0\u05d9"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947\u092c \u0916\u094b\u091c \u091a\u093e\u0932\u0942 \u0939\u0948: \u091f\u0942\u0932 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f \u0935\u0947\u092c \u092a\u0930 \u0916\u094b\u091c\u0947\u0902\u0917\u0947"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian web aktif: alat akan mencari informasi terkini di web"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca web attiva: gli strumenti cercheranno sul web informazioni aggiornate"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a6\u30a7\u30d6\u691c\u7d22\u304c\u6709\u52b9\u3067\u3059\uff1a\u30c4\u30fc\u30eb\u304c\u30a6\u30a7\u30d6\u3067\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u306e\u60c5\u5831\u3092\u691c\u7d22\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc6f9 \uac80\uc0c9 \ucf1c\uc9d0: \ub3c4\uad6c\uac00 \uc6f9\uc5d0\uc11c \uc2e4\uc2dc\uac04 \uc815\ubcf4\ub97c \uac80\uc0c9\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken op internet aan: tools zoeken op internet naar actuele informatie"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie w internecie w\u0142\u0105czone: narz\u0119dzia b\u0119d\u0105 szuka\u0107 bie\u017c\u0105cych informacji w sieci"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Busca na web ativada: as ferramentas v\u00e3o buscar informa\u00e7\u00f5es em tempo real na web"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0438\u0441\u043a \u0432 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0435 \u0432\u043a\u043b\u044e\u0447\u0451\u043d: \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0431\u0443\u0434\u0443\u0442 \u0438\u0441\u043a\u0430\u0442\u044c \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443\u044e \u0438\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0438\u044e \u0432 \u0441\u0435\u0442\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Webbs\u00f6kning p\u00e5: verktygen s\u00f6ker p\u00e5 webben efter aktuell information"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Web aramas\u0131 a\u00e7\u0131k: ara\u00e7lar g\u00fcncel bilgi i\u00e7in web'de arama yapacak"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0448\u0443\u043a \u0432 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442\u0456 \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e: \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u0448\u0443\u043a\u0430\u0442\u0438\u043c\u0443\u0442\u044c \u0430\u043a\u0442\u0443\u0430\u043b\u044c\u043d\u0443 \u0456\u043d\u0444\u043e\u0440\u043c\u0430\u0446\u0456\u044e \u0432 \u043c\u0435\u0440\u0435\u0436\u0456"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 b\u1eadt t\u00ecm ki\u1ebfm web: c\u00f4ng c\u1ee5 s\u1ebd t\u00ecm th\u00f4ng tin theo th\u1eddi gian th\u1ef1c tr\u00ean web"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u542f\u7528\u7f51\u9875\u641c\u7d22\uff1a\u5de5\u5177\u5c06\u5728\u7f51\u4e0a\u641c\u7d22\u5b9e\u65f6\u4fe1\u606f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u555f\u7528\u7db2\u9801\u641c\u5c0b\uff1a\u5de5\u5177\u5c07\u5728\u7db2\u8def\u4e0a\u641c\u5c0b\u5373\u6642\u8cc7\u8a0a"
          }
        }
      }
    },
