            "value": "Що пам'ятає цей проект"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Những gì dự án này ghi nhớ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此项目记住的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此專案記住的內容"
          }
        }
      }
    },
    "What a real call on this request would prefill. Generates nothing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما الذي سيُعبّأ مسبقًا عند استدعاء حقيقي لهذا الطلب. لا يولّد شيئًا."
          }
        },
        "de": {
