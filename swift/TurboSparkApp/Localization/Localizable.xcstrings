        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gera\u00e7\u00e3o continuada. Tentativa: %lld, tokens at\u00e9 agora: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0435\u043d\u0430. \u041f\u043e\u043f\u044b\u0442\u043a\u0430: %lld, \u0442\u043e\u043a\u0435\u043d\u043e\u0432 \u043d\u0430 \u0434\u0430\u043d\u043d\u044b\u0439 \u043c\u043e\u043c\u0435\u043d\u0442: %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u3092\u7d9a\u884c\u3057\u307e\u3057\u305f\u3002\u8a66\u884c\u56de\u6570: %lld\u3001\u3053\u308c\u307e\u3067\u306e\u30c8\u30fc\u30af\u30f3\u6570: %lld\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0dd\uc131\uc744 \uacc4\uc18d\ud588\uc2b5\ub2c8\ub2e4. \uc2dc\ub3c4: %lld, \ud604\uc7ac\uae4c\uc9c0 \ud1a0\ud070: %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u7ee7\u7eed\u751f\u6210\u3002\u5c1d\u8bd5\u6b21\u6570\uff1a%lld\uff0c\u5f53\u524d\u4ee4\u724c\u6570\uff1a%lld\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u7e7c\u7e8c\u751f\u6210\u3002\u5617\u8a66\u6b21\u6578\uff1a%lld\uff0c\u76ee\u524d\u6b0a\u6756\u6578\uff1a%lld\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645\u062a \u0645\u062a\u0627\u0628\u0639\u0629 \u0627\u0644\u062a\u0648\u0644\u064a\u062f. \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629: %lld\u060c \u0627\u0644\u0631\u0645\u0648\u0632 \u062d\u062a\u0649 \u0627\u0644\u0622\u0646: %lld."
