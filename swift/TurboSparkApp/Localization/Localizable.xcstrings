    "Total tokens generated in this turn or previous run": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u062c\u0645\u0627\u0644\u064a \u0627\u0644\u0631\u0645\u0648\u0632 \u0627\u0644\u0645\u0648\u0644\u062f\u0629 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062f\u0648\u0631 \u0623\u0648 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u0633\u0627\u0628\u0642"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Insgesamt generierte Token in dieser Runde oder im vorherigen Lauf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Total tokens generated in this turn or previous run"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Total de tokens generados en este turno o en la ejecuci\u00f3n anterior"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Total des tokens g\u00e9n\u00e9r\u00e9s pendant ce tour ou la derni\u00e8re ex\u00e9cution"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05da \u05d4\u05d8\u05d5\u05e7\u05e0\u05d9\u05dd \u05e9\u05e0\u05d5\u05e6\u05e8\u05d5 \u05d1\u05ea\u05d5\u05e8 \u05d6\u05d4 \u05d0\u05d5 \u05d1\u05d4\u05e8\u05e6\u05d4 \u05d4\u05e7\u05d5\u05d3\u05de\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u091f\u0930\u094d\u0928 \u092f\u093e \u092a\u093f\u091b\u0932\u0947 \u0930\u0928 \u092e\u0947\u0902 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0941\u0932 \u091f\u094b\u0915\u0928"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Total token yang dihasilkan pada giliran ini atau proses sebelumnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token totali generati in questo turno o nell'esecuzione precedente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30bf\u30fc\u30f3\u307e\u305f\u306f\u524d\u56de\u306e\u5b9f\u884c\u3067\u751f\u6210\u3055\u308c\u305f\u30c8\u30fc\u30af\u30f3\u306e\u5408\u8a08"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubc88 \ud134 \ub610\ub294 \uc774\uc804 \uc2e4\ud589\uc5d0\uc11c \uc0dd\uc131\ub41c \ucd1d \ud1a0\ud070 \uc218"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Totaal aantal tokens gegenereerd in deze beurt of de vorige run"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0141\u0105czna liczba token\u00f3w wygenerowanych w tej turze lub poprzednim uruchomieniu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Total de tokens gerados neste turno ou na execu\u00e7\u00e3o anterior"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0435\u0433\u043e \u0442\u043e\u043a\u0435\u043d\u043e\u0432, \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0437\u0430 \u044d\u0442\u043e\u0442 \u0445\u043e\u0434 \u0438\u043b\u0438 \u043f\u0440\u043e\u0448\u043b\u044b\u0439 \u0437\u0430\u043f\u0443\u0441\u043a"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Totalt antal tokens som genererats i den h\u00e4r turen eller f\u00f6rra k\u00f6rningen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu turda veya \u00f6nceki \u00e7al\u0131\u015ft\u0131rmada olu\u015fturulan toplam belirte\u00e7"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0441\u044c\u043e\u0433\u043e \u0442\u043e\u043a\u0435\u043d\u0456\u0432, \u0437\u0433\u0435\u043d\u0435\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u0443 \u0446\u0456\u0439 \u0440\u0435\u043f\u043b\u0456\u0446\u0456 \u0430\u0431\u043e \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u043c\u0443 \u0437\u0430\u043f\u0443\u0441\u043a\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ed5ng s\u1ed1 token \u0111\u00e3 t\u1ea1o trong l\u01b0\u1ee3t n\u00e0y ho\u1eb7c l\u1ea7n ch\u1ea1y tr\u01b0\u1edbc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u8f6e\u6216\u4e0a\u6b21\u8fd0\u884c\u4e2d\u751f\u6210\u7684 Token \u603b\u6570"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672c\u8f2a\u6216\u4e0a\u6b21\u57f7\u884c\u4e2d\u7522\u751f\u7684 Token \u7e3d\u6578"
          }
        }
      }
    },
