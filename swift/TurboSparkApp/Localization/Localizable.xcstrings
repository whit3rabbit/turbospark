    "Deep analytical agent focused on reading documents, code search, and contextual synthesis.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0648\u0643\u064a\u0644 \u062a\u062d\u0644\u064a\u0644\u064a \u0645\u0639\u0645\u0651\u0642 \u064a\u0631\u0643\u0651\u0632 \u0639\u0644\u0649 \u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0648\u0627\u0644\u0628\u062d\u062b \u0641\u064a \u0627\u0644\u0634\u064a\u0641\u0631\u0629 \u0648\u0627\u0644\u062a\u0631\u0643\u064a\u0628 \u0627\u0644\u0633\u064a\u0627\u0642\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytischer Agent mit Fokus auf Dokumentlekt\u00fcre, Codesuche und kontextbezogener Synthese."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deep analytical agent focused on reading documents, code search, and contextual synthesis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente anal\u00edtico centrado en leer documentos, buscar en el c\u00f3digo y sintetizar el contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent analytique ax\u00e9 sur la lecture de documents, la recherche dans le code et la synth\u00e8se contextuelle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05d5\u05db\u05df \u05d0\u05e0\u05dc\u05d9\u05d8\u05d9 \u05de\u05e2\u05de\u05d9\u05e7 \u05e9\u05de\u05ea\u05de\u05e7\u05d3 \u05d1\u05e7\u05e8\u05d9\u05d0\u05ea \u05de\u05e1\u05de\u05db\u05d9\u05dd, \u05d7\u05d9\u05e4\u05d5\u05e9 \u05d1\u05e7\u05d5\u05d3 \u05d5\u05e1\u05d9\u05e0\u05ea\u05d6\u05d4 \u05d1\u05d4\u05e7\u05e9\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c \u092a\u0922\u093c\u0928\u0947, \u0915\u094b\u0921 \u0916\u094b\u091c \u0914\u0930 \u0938\u0902\u0926\u0930\u094d\u092d-\u0906\u0927\u093e\u0930\u093f\u0924 \u0938\u0902\u0936\u094d\u0932\u0947\u0937\u0923 \u092a\u0930 \u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0917\u0939\u0928 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923\u093e\u0924\u094d\u092e\u0915 \u090f\u091c\u0947\u0902\u091f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agen analitis mendalam yang berfokus pada membaca dokumen, pencarian kode, dan sintesis kontekstual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente analitico approfondito focalizzato su lettura di documenti, ricerca nel codice e sintesi contestuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c9\u30ad\u30e5\u30e1\u30f3\u30c8\u306e\u8aad\u89e3\u3001\u30b3\u30fc\u30c9\u691c\u7d22\u3001\u6587\u8108\u306b\u6cbf\u3063\u305f\u7d71\u5408\u306b\u7279\u5316\u3057\u305f\u5206\u6790\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb38\uc11c \uc77d\uae30, \ucf54\ub4dc \uac80\uc0c9, \ub9e5\ub77d \uc885\ud569\uc5d0 \uc9d1\uc911\ud558\ub294 \uc2ec\uce35 \ubd84\uc11d \uc5d0\uc774\uc804\ud2b8."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytische agent gericht op het lezen van documenten, zoeken in code en contextuele synthese."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Analityczny agent skupiony na czytaniu dokument\u00f3w, wyszukiwaniu w kodzie i syntezie kontekstowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente anal\u00edtico focado em ler documentos, pesquisar c\u00f3digo e sintetizar o contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u043d\u0430\u043b\u0438\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u0439 \u0430\u0433\u0435\u043d\u0442 \u0434\u043b\u044f \u0447\u0442\u0435\u043d\u0438\u044f \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u043e\u0432, \u043f\u043e\u0438\u0441\u043a\u0430 \u043f\u043e \u043a\u043e\u0434\u0443 \u0438 \u043e\u0431\u043e\u0431\u0449\u0435\u043d\u0438\u044f \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Analytisk agent med fokus p\u00e5 dokumentl\u00e4sning, kods\u00f6kning och kontextuell sammanst\u00e4llning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belge okuma, kod arama ve ba\u011flamsal sentez odakl\u0131 derin analitik ajan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u043d\u0430\u043b\u0456\u0442\u0438\u0447\u043d\u0438\u0439 \u0430\u0433\u0435\u043d\u0442 \u0434\u043b\u044f \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u043f\u043e\u0448\u0443\u043a\u0443 \u0432 \u043a\u043e\u0434\u0456 \u0442\u0430 \u0443\u0437\u0430\u0433\u0430\u043b\u044c\u043d\u0435\u043d\u043d\u044f \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e1c t\u1eed ph\u00e2n t\u00edch chuy\u00ean s\u00e2u, t\u1eadp trung \u0111\u1ecdc t\u00e0i li\u1ec7u, t\u00ecm m\u00e3 v\u00e0 t\u1ed5ng h\u1ee3p theo ng\u1eef c\u1ea3nh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e13\u6ce8\u4e8e\u9605\u8bfb\u6587\u6863\u3001\u4ee3\u7801\u641c\u7d22\u548c\u4e0a\u4e0b\u6587\u7efc\u5408\u7684\u6df1\u5ea6\u5206\u6790\u4ee3\u7406\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c08\u6ce8\u65bc\u95b1\u8b80\u6587\u4ef6\u3001\u7a0b\u5f0f\u78bc\u641c\u5c0b\u548c\u4e0a\u4e0b\u6587\u7d9c\u5408\u7684\u6df1\u5ea6\u5206\u6790\u4ee3\u7406\u3002"
          }
        }
      }
    },
