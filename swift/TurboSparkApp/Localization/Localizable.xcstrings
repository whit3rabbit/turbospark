    "Queued behind the running turn; drains when it finishes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في قائمة الانتظار خلف الدور الجاري؛ يُرسل عند انتهائه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet hinter dem laufenden Durchlauf; wird gesendet, wenn er abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued behind the running turn; drains when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola detrás del turno en curso; se envía cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En file derrière le tour en cours ; envoyé quand il se termine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בתור מאחורי התור הפעיל; יישלח כשיסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे टर्न के पीछे कतार में; उसके पूरा होने पर भेजा जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengantre di belakang giliran yang berjalan; terkirim saat giliran selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda dietro il turno in corso; viene inviato quando termina."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のターンの後に待機中。ターン終了後に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 턴 뒤에서 대기 중이며, 턴이 끝나면 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de wachtrij achter de lopende beurt; wordt verzonden zodra die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kolejce za bieżącą turą; zostanie wysłane po jej zakończeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fila atrás do turno em andamento; será enviado quando ele terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В очереди за текущим ходом; отправится, когда он завершится."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I kö bakom det pågående varvet; skickas när det är klart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan turun arkasında sırada; tur bitince gönderilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У черзі за поточним ходом; надішлеться, коли він завершиться."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xếp sau lượt đang chạy; sẽ gửi khi lượt đó xong."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排在当前回合之后；回合结束后自动发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排在目前回合之後；回合結束後自動送出。"
          }
        }
      }
    },
    "Queued message. Click to edit it before it sends.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رسالة في قائمة الانتظار. انقر لتعديلها قبل إرسالها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartende Nachricht. Klicke, um sie vor dem Senden zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued message. Click to edit it before it sends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensaje en cola. Haz clic para editarlo antes de que se envíe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message en file d'attente. Cliquez pour le modifier avant son envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הודעה בתור. לחץ כדי לערוך אותה לפני שתישלח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कतार में संदेश। भेजे जाने से पहले संपादित करने के लिए क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan dalam antrean. Klik untuk mengeditnya sebelum dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggio in coda. Fai clic per modificarlo prima dell'invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キューに入ったメッセージです。送信前に編集するにはクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중인 메시지입니다. 보내기 전에 편집하려면 클릭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bericht in de wachtrij. Klik om het te bewerken voordat het wordt verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomość w kolejce. Kliknij, aby ją edytować przed wysłaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagem na fila. Clique para editá-la antes do envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщение в очереди. Нажмите, чтобы изменить его до отправки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Köat meddelande. Klicka för att redigera det innan det skickas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıradaki mesaj. Gönderilmeden önce düzenlemek için tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомлення в черзі. Натисніть, щоб змінити його до надсилання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nhắn đang chờ. Nhấp để sửa trước khi gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排队的消息。点按即可在发送前编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排入佇列的訊息。按一下即可在傳送前編輯。"
          }
        }
      }
    },
    "Queued: sends after the current turn. Click to edit it now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في قائمة الانتظار: تُرسل بعد الدور الحالي. انقر لتعديلها الآن."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Warteschlange: wird nach der aktuellen Runde gesendet. Klicke, um sie jetzt zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued: sends after the current turn. Click to edit it now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola: se envía después del turno actual. Haz clic para editarlo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En file d'attente : envoyé après le tour en cours. Cliquez pour le modifier maintenant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בתור: תישלח אחרי התור הנוכחי. לחץ כדי לערוך אותה עכשיו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कतार में: वर्तमान चरण के बाद भेजा जाएगा। अभी संपादित करने के लिए क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam antrean: dikirim setelah giliran saat ini. Klik untuk mengeditnya sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda: viene inviato dopo il turno corrente. Fai clic per modificarlo ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キュー待ち: 現在のターンの後に送信されます。今すぐ編集するにはクリックします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대기 중: 현재 턴이 끝난 뒤 전송됩니다. 지금 편집하려면 클릭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de wachtrij: wordt na de huidige beurt verzonden. Klik om het nu te bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kolejce: zostanie wysłana po bieżącej turze. Kliknij, aby edytować teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fila: será enviada após o turno atual. Clique para editar agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В очереди: отправится после текущего хода. Нажмите, чтобы изменить сейчас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I kö: skickas efter den aktuella turen. Klicka för att redigera nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sırada: mevcut turdan sonra gönderilir. Şimdi düzenlemek için tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У черзі: надішлеться після поточного ходу. Натисніть, щоб змінити зараз."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang chờ: sẽ gửi sau lượt hiện tại. Nhấp để sửa ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已排队：将在当前轮次后发送。点按即可立即编辑。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已排入佇列：將在目前輪次後傳送。按一下即可立即編輯。"
          }
        }
      }
    },
