    "Thermal status is Nominal: machine is operating at normal temperature and full performance.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحالة الحرارية طبيعية: يعمل الجهاز بدرجة حرارة عادية وبكامل الأداء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Thermischer Status ist nominal: Der Computer läuft mit normaler Temperatur und voller Leistung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Thermal status is Nominal: machine is operating at normal temperature and full performance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El estado térmico es nominal: el equipo funciona a temperatura normal y con rendimiento completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'état thermique est nominal : la machine fonctionne à température normale et à pleine performance."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המצב התרמי תקין: המחשב פועל בטמפרטורה רגילה ובביצועים מלאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "थर्मल स्थिति सामान्य है: मशीन सामान्य तापमान और पूरे प्रदर्शन पर चल रही है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status termal Nominal: mesin beroperasi pada suhu normal dan performa penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo stato termico è nominale: la macchina funziona a temperatura normale e con prestazioni piene."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "温度ステータスは正常です: マシンは通常の温度でフル性能で動作しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온도 상태 정상: 컴퓨터가 정상 온도에서 최대 성능으로 작동 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Thermische status is nominaal: de machine werkt op normale temperatuur en volle prestaties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stan termiczny jest nominalny: komputer pracuje w normalnej temperaturze i z pełną wydajnością."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O status térmico é nominal: a máquina está operando em temperatura normal e com desempenho total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Температурный режим в норме: компьютер работает при обычной температуре и на полной производительности."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Termisk status är nominell: datorn arbetar vid normal temperatur och full prestanda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termal durum Nominal: makine normal sıcaklıkta ve tam performansla çalışıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термічний стан номінальний: комп'ютер працює за нормальної температури та на повній продуктивності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trạng thái nhiệt ở mức định mức: máy đang chạy ở nhiệt độ bình thường và hiệu năng đầy đủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "散热状态正常：机器在正常温度下以全性能运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "散熱狀態正常：機器在正常溫度下以全效能運作。"
          }
        }
      }
    },
