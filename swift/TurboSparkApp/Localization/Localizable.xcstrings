    "Opens Terminal and launches the agent against the background server; it is started or reused as needed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0641\u062a\u062d \u0627\u0644\u0637\u0631\u0641\u064a\u0629 \u0648\u064a\u0634\u063a\u0651\u0644 \u0627\u0644\u0648\u0643\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u062e\u0627\u062f\u0645 \u0641\u064a \u0627\u0644\u062e\u0644\u0641\u064a\u0629\u061b \u064a\u064f\u0628\u062f\u0623 \u0627\u0644\u062e\u0627\u062f\u0645 \u0623\u0648 \u064a\u064f\u0639\u0627\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647 \u062d\u0633\u0628 \u0627\u0644\u062d\u0627\u062c\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ffnet Terminal und startet den Agenten gegen den Hintergrundserver; dieser wird bei Bedarf gestartet oder wiederverwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Terminal and launches the agent against the background server; it is started or reused as needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Terminal y lanza el agente contra el servidor en segundo plano; se inicia o se reutiliza seg\u00fan sea necesario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre Terminal et lance l'agent contre le serveur en arri\u00e8re-plan ; celui-ci est d\u00e9marr\u00e9 ou r\u00e9utilis\u00e9 selon les besoins."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05d5\u05ea\u05d7 \u05d0\u05ea \u05d4\u05de\u05e1\u05d5\u05e3 \u05d5\u05de\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d4\u05e1\u05d5\u05db\u05df \u05de\u05d5\u05dc \u05d4\u05e9\u05e8\u05ea \u05d1\u05e8\u05e7\u05e2; \u05d4\u05e9\u05e8\u05ea \u05de\u05d5\u05e4\u05e2\u05dc \u05d0\u05d5 \u05de\u05e0\u05d5\u05e6\u05dc \u05de\u05d7\u05d3\u05e9 \u05dc\u05e4\u05d9 \u05d4\u05e6\u05d5\u05e8\u05da."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0930\u094d\u092e\u093f\u0928\u0932 \u0916\u094b\u0932\u0924\u093e \u0939\u0948 \u0914\u0930 \u092c\u0948\u0915\u0917\u094d\u0930\u093e\u0909\u0902\u0921 \u0938\u0930\u094d\u0935\u0930 \u0915\u0947 \u0935\u093f\u0930\u0941\u0926\u094d\u0927 \u090f\u091c\u0947\u0902\u091f \u0932\u0949\u0928\u094d\u091a \u0915\u0930\u0924\u093e \u0939\u0948; \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e\u0928\u0941\u0938\u093e\u0930 \u0938\u0930\u094d\u0935\u0930 \u0936\u0941\u0930\u0942 \u092f\u093e \u092a\u0941\u0928\u0903 \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka Terminal dan meluncurkan agent ke server latar belakang; server dijalankan atau digunakan kembali sesuai kebutuhan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre Terminale e lancia l'agente contro il server in background; viene avviato o riutilizzato secondo necessit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bf\u30fc\u30df\u30ca\u30eb\u3092\u958b\u304d\u3001\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u30b5\u30fc\u30d0\u30fc\u306b\u5bfe\u3057\u3066\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3092\u8d77\u52d5\u3057\u307e\u3059\u3002\u30b5\u30fc\u30d0\u30fc\u306f\u5fc5\u8981\u306b\u5fdc\u3058\u3066\u8d77\u52d5\u307e\u305f\u306f\u518d\u5229\u7528\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud130\ubbf8\ub110\uc744 \uc5f4\uace0 \ubc31\uadf8\ub77c\uc6b4\ub4dc \uc11c\ubc84\uc5d0 \ub300\ud574 \uc5d0\uc774\uc804\ud2b8\ub97c \uc2e4\ud589\ud569\ub2c8\ub2e4. \uc11c\ubc84\ub294 \ud544\uc694\uc5d0 \ub530\ub77c \uc2dc\uc791\ub418\uac70\ub098 \uc7ac\uc0ac\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent Terminal en start de agent tegen de achtergrondserver; die wordt indien nodig gestart of hergebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera Terminal i uruchamia agenta na serwerze w tle; serwer jest w razie potrzeby uruchamiany lub ponownie wykorzystywany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o Terminal e inicia o agente no servidor em segundo plano; ele \u00e9 iniciado ou reutilizado conforme necess\u00e1rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0422\u0435\u0440\u043c\u0438\u043d\u0430\u043b \u0438 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u0430\u0433\u0435\u043d\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 \u0444\u043e\u043d\u043e\u0432\u044b\u0439 \u0441\u0435\u0440\u0432\u0435\u0440; \u043e\u043d \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u0438\u043b\u0438 \u043f\u0435\u0440\u0435\u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043d\u0435\u043e\u0431\u0445\u043e\u0434\u0438\u043c\u043e\u0441\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ppnar Terminal och startar agenten mot bakgrundsservern; den startas eller \u00e5teranv\u00e4nds vid behov."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminal'i a\u00e7ar ve arac\u0131y\u0131 arka plan sunucusuna kar\u015f\u0131 ba\u015flat\u0131r; sunucu gerekti\u011finde ba\u015flat\u0131l\u0131r veya yeniden kullan\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u0422\u0435\u0440\u043c\u0456\u043d\u0430\u043b \u0456 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454 \u0430\u0433\u0435\u043d\u0442\u0430 \u0447\u0435\u0440\u0435\u0437 \u0444\u043e\u043d\u043e\u0432\u0438\u0439 \u0441\u0435\u0440\u0432\u0435\u0440; \u0432\u0456\u043d \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u0430\u0431\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0437\u0430 \u043f\u043e\u0442\u0440\u0435\u0431\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1edf Terminal v\u00e0 kh\u1edfi ch\u1ea1y agent v\u1edbi m\u00e1y ch\u1ee7 n\u1ec1n; m\u00e1y ch\u1ee7 \u0111\u01b0\u1ee3c kh\u1edfi \u0111\u1ed9ng ho\u1eb7c t\u00e1i s\u1eed d\u1ee5ng khi c\u1ea7n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u5f00\u201c\u7ec8\u7aef\u201d\u5e76\u9488\u5bf9\u540e\u53f0\u670d\u52a1\u5668\u542f\u52a8\u8be5\u4ee3\u7406\uff1b\u670d\u52a1\u5668\u4f1a\u6309\u9700\u542f\u52a8\u6216\u590d\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u958b\u300c\u7d42\u7aef\u6a5f\u300d\u4e26\u91dd\u5c0d\u80cc\u666f\u4f3a\u670d\u5668\u555f\u52d5\u8a72\u4ee3\u7406\uff1b\u4f3a\u670d\u5668\u6703\u8996\u9700\u8981\u555f\u52d5\u6216\u91cd\u8907\u4f7f\u7528\u3002"
          }
        }
      }
    },
