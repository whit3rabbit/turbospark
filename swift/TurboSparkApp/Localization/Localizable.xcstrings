    "Invalid token. Hugging Face rejected these credentials.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0631\u0645\u0632 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d. \u0631\u0641\u0636 Hugging Face \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u0639\u062a\u0645\u0627\u062f \u0647\u0630\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ung\u00fcltiges Token. Hugging Face hat diese Zugangsdaten abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid token. Hugging Face rejected these credentials."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Token no v\u00e1lido. Hugging Face rechaz\u00f3 estas credenciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeton non valide. Hugging Face a refus\u00e9 ces identifiants."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05e1\u05d9\u05de\u05d5\u05df \u05dc\u05d0 \u05d7\u05d5\u05e7\u05d9. Hugging Face \u05d3\u05d7\u05d4 \u05d0\u05ea \u05e4\u05e8\u05d8\u05d9 \u05d4\u05db\u05e0\u05d9\u05e1\u05d4 \u05d4\u05d0\u05dc\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092e\u093e\u0928\u094d\u092f \u091f\u094b\u0915\u0928\u0964 Hugging Face \u0928\u0947 \u092f\u0947 \u0915\u094d\u0930\u0947\u0921\u0947\u0902\u0936\u093f\u092f\u0932 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Token tidak valid. Hugging Face menolak kredensial ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Token non valido. Hugging Face ha rifiutato queste credenziali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u52b9\u306a\u30c8\u30fc\u30af\u30f3\u3067\u3059\u3002Hugging Face\u304c\u3053\u306e\u8a8d\u8a3c\u60c5\u5831\u3092\u62d2\u5426\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc798\ubabb\ub41c \ud1a0\ud070\uc785\ub2c8\ub2e4. Hugging Face\uc5d0\uc11c \uc774 \uc790\uaca9 \uc99d\uba85\uc744 \uac70\ubd80\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
