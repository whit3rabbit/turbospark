    "Move the managed text, image, and audio model store to an empty folder. Files owned by Hugging Face, LM Studio, or Ollama are not changed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقل مخزن نماذج النصوص والصور والصوت المُدار إلى مجلد فارغ. لا يتم تغيير الملفات المملوكة لـ Hugging Face أو LM Studio أو Ollama."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verschieben Sie den verwalteten Modell-Speicher für Text, Bild und Audio in einen leeren Ordner. Dateien von Hugging Face, LM Studio oder Ollama werden nicht geändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move the managed text, image, and audio model store to an empty folder. Files owned by Hugging Face, LM Studio, or Ollama are not changed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mueve el almacén administrado de modelos de texto, imagen y audio a una carpeta vacía. Los archivos pertenecientes a Hugging Face, LM Studio u Ollama no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacez le magasin de modèles géré de texte, d'image et d'audio vers un dossier vide. Les fichiers appartenant à Hugging Face, LM Studio ou Ollama ne sont pas modifiés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העבר את מאגר המודלים המנוהל של טקסט, תמונה ושמע לתיקייה ריקה. קבצים בבעלות Hugging Face, LM Studio או Ollama לא ישונו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रबंधित टेक्स्ट, इमेज और ऑडियो मॉडल स्टोर को एक खाली फ़ोल्डर में ले जाएं। Hugging Face, LM Studio, या Ollama के स्वामित्व वाली फ़ाइलें नहीं बदली जाती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindahkan penyimpanan model teks, gambar, dan audio terkelola ke folder kosong. File milik Hugging Face, LM Studio, atau Ollama tidak akan diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sposta l'archivio gestito dei modelli di testo, immagini e audio in una cartella vuota. I file di proprietà di Hugging Face, LM Studio o Ollama non vengono modificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "管理されているテキスト、画像、音声のモデルストアを空のフォルダーに移動します。Hugging Face、LM Studio、Ollamaが所有するファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "관리되는 텍스트, 이미지 및 오디오 모델 저장소를 빈 폴더로 이동합니다. Hugging Face, LM Studio 또는 Ollama 소유의 파일은 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verplaats de beheerde modelopslag voor tekst, beeld en audio naar een lege map. Bestanden van Hugging Face, LM Studio of Ollama worden niet gewijzigdd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przenieś zarządzany magazyn modeli tekstu, obrazu i dźwięku do pustego folderu. Pliki należące do Hugging Face, LM Studio lub Ollama nie ulegną zmianie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mova o armazenamento gerenciado de modelos de texto, imagem e áudio para uma pasta vazia. Arquivos pertencentes ao Hugging Face, LM Studio ou Ollama não são alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Переместите управляемое хранилище текстовых, графических и аудиомоделей в пустую папку. Файлы Hugging Face, LM Studio или Ollama не изменяются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flytta den hanterade modellen för text, bild och ljud till en tom mapp. Filer som ägs av Hugging Face, LM Studio eller Ollama ändras inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yönetilen metin, görsel ve ses modeli deposunu boş bir klasöre taşıyın. Hugging Face, LM Studio veya Ollama'ya ait dosyalar değiştirilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перемістіть кероване сховище текстових, графічних та аудіомоделей у порожню папку. Файли Hugging Face, LM Studio або Ollama не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Di chuyển kho lưu trữ mô hình văn bản, hình ảnh và âm thanh được quản lý sang một thư mục trống. Các tệp thuộc sở hữu của Hugging Face, LM Studio hoặc Ollama không bị thay đổi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将受管理的文本、图像和音频模型存储移动到空文件夹中。Hugging Face、LM Studio 或 Ollama 拥有的文件不会改变。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將受管理的文字、影像和音訊模型存放區移動至空資料夾。Hugging Face、LM Studio 或 Ollama 所擁有的檔案不會變更。"
          }
        }
      }
    },
