    "GGUF format parsed and streamed directly via custom Metal kernels": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0646\u0633\u064a\u0642 GGUF \u064a\u064f\u062d\u0644\u064e\u0651\u0644 \u0648\u064a\u064f\u0628\u062b \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0628\u0631 \u0646\u0648\u0649 Metal \u0645\u062e\u0635\u0635\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF-Format, direkt \u00fcber eigene Metal-Kernel gelesen und gestreamt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF format parsed and streamed directly via custom Metal kernels"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato GGUF analizado y transmitido directamente con kernels de Metal propios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Format GGUF analys\u00e9 et diffus\u00e9 directement via des noyaux Metal personnalis\u00e9s"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05d5\u05e8\u05de\u05d8 GGUF \u05e9\u05de\u05e0\u05d5\u05ea\u05d7 \u05d5\u05de\u05d5\u05d6\u05e8\u05dd \u05d9\u05e9\u05d9\u05e8\u05d5\u05ea \u05d3\u05e8\u05da \u05e7\u05e8\u05e0\u05dc\u05d9 Metal \u05de\u05d5\u05ea\u05d0\u05de\u05d9\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0938\u094d\u091f\u092e Metal \u0915\u0930\u094d\u0928\u0947\u0932 \u0915\u0947 \u091c\u093c\u0930\u093f\u090f \u0938\u0940\u0927\u0947 \u092a\u093e\u0930\u094d\u0938 \u0914\u0930 \u0938\u094d\u091f\u094d\u0930\u0940\u092e \u0915\u093f\u092f\u093e \u0917\u092f\u093e GGUF \u092b\u093c\u0949\u0930\u094d\u092e\u0947\u091f"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Format GGUF diurai dan dialirkan langsung melalui kernel Metal khusus"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato GGUF analizzato e trasmesso direttamente tramite kernel Metal personalizzati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ab\u30b9\u30bf\u30e0Metal\u30ab\u30fc\u30cd\u30eb\u3067\u76f4\u63a5\u89e3\u6790\u30fb\u30b9\u30c8\u30ea\u30fc\u30df\u30f3\u30b0\u3059\u308bGGUF\u5f62\u5f0f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uc6a9\uc790 \uc9c0\uc815 Metal \ucee4\ub110\ub85c \uc9c1\uc811 \ud30c\uc2f1\ud558\uace0 \uc2a4\ud2b8\ub9ac\ubc0d\ud558\ub294 GGUF \ud615\uc2dd"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF-indeling, rechtstreeks gelezen en gestreamd via eigen Metal-kernels"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Format GGUF analizowany i strumieniowany bezpo\u015brednio przez w\u0142asne j\u0105dra Metal"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Formato GGUF analisado e transmitido diretamente por kernels Metal pr\u00f3prios"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u043e\u0440\u043c\u0430\u0442 GGUF, \u0440\u0430\u0437\u0431\u0438\u0440\u0430\u0435\u043c\u044b\u0439 \u0438 \u043f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u0435\u043c\u044b\u0439 \u043d\u0430\u043f\u0440\u044f\u043c\u0443\u044e \u0447\u0435\u0440\u0435\u0437 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0435 \u044f\u0434\u0440\u0430 Metal"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF-format som tolkas och str\u00f6mmas direkt via egna Metal-k\u00e4rnor"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6zel Metal \u00e7ekirdekleriyle do\u011frudan ayr\u0131\u015ft\u0131r\u0131l\u0131p aktar\u0131lan GGUF bi\u00e7imi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u043e\u0440\u043c\u0430\u0442 GGUF, \u0449\u043e \u0440\u043e\u0437\u0431\u0438\u0440\u0430\u0454\u0442\u044c\u0441\u044f \u0439 \u043f\u0435\u0440\u0435\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0431\u0435\u0437\u043f\u043e\u0441\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u0447\u0435\u0440\u0435\u0437 \u0432\u043b\u0430\u0441\u043d\u0456 \u044f\u0434\u0440\u0430 Metal"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ecbnh d\u1ea1ng GGUF \u0111\u01b0\u1ee3c ph\u00e2n t\u00edch v\u00e0 truy\u1ec1n tr\u1ef1c ti\u1ebfp qua kernel Metal t\u00f9y ch\u1ec9nh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u901a\u8fc7\u81ea\u5b9a\u4e49 Metal \u5185\u6838\u76f4\u63a5\u89e3\u6790\u548c\u6d41\u5f0f\u52a0\u8f7d\u7684 GGUF \u683c\u5f0f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u900f\u904e\u81ea\u8a02 Metal \u6838\u5fc3\u76f4\u63a5\u89e3\u6790\u8207\u4e32\u6d41\u8f09\u5165\u7684 GGUF \u683c\u5f0f"
