    "Self-contained settings, chats, skills, plugins, and MCP servers.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إعدادات ودردشات ومهارات وإضافات وخوادم MCP مستقلة."
          }
        },
        "de": {
