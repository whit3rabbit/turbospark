            "value": "\u00c5terst\u00e4ll en s\u00e4kerhetskopia"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek Geri Y\u00fckle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443 \u043a\u043e\u043f\u0456\u044e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4i ph\u1ee5c b\u1ea3n sao l\u01b0u"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6062\u590d\u5907\u4efd"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56de\u5fa9\u5099\u4efd"
          }
        }
      }
    },
    "Restore inherited source": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
