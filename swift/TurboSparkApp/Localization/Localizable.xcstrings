          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u043e\u0435\u043a\u0442, \u0447\u0442\u043e\u0431\u044b \u0441\u0441\u044b\u043b\u0430\u0442\u044c\u0441\u044f \u043d\u0430 \u0435\u0433\u043e \u0444\u0430\u0439\u043b\u044b \u0447\u0435\u0440\u0435\u0437 @."
