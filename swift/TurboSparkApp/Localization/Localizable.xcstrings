    "Recovery conflict: the saved partial response no longer matches the transcript.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery conflict: the saved partial response no longer matches the transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflicto de recuperación: la respuesta parcial guardada ya no coincide con la transcripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
