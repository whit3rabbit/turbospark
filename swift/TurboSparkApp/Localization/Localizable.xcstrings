        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00f6nergeleri ve parametreleri incelemek i\u00e7in bir beceri se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043d\u0430\u0432\u0438\u0447\u043a\u0443, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u0443\u0442\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457 \u0442\u0430 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn m\u1ed9t k\u1ef9 n\u0103ng \u0111\u1ec3 xem h\u01b0\u1edbng d\u1eabn v\u00e0 tham s\u1ed1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u6280\u80fd\u4ee5\u67e5\u770b\u5176\u8bf4\u660e\u548c\u53c2\u6570\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
