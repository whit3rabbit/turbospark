    "Base URL for Hugging Face downloads ($HF_ENDPOINT), e.g. https://hf-mirror.com for restricted regions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0646\u0648\u0627\u0646 URL \u0627\u0644\u0623\u0633\u0627\u0633\u064a \u0644\u062a\u0646\u0632\u064a\u0644\u0627\u062a Hugging Face \u200f($HF_ENDPOINT)\u060c \u0645\u062b\u0644 https://hf-mirror.com \u0644\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u0645\u0642\u064a\u0651\u062f\u0629."
