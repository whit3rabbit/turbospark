          "stringUnit": {
            "state": "translated",
            "value": "%lld messaggi precedenti compattati in un riepilogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee5\u524d\u306e\u30e1\u30c3\u30bb\u30fc\u30b8 %lld \u4ef6\u3092\u8981\u7d04\u306b\u5727\u7e2e\u3057\u307e\u3057\u305f\u3002"
