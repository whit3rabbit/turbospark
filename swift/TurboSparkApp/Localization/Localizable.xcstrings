          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u9009 Chrome \u4e2a\u4eba\u8d44\u6599\u5df2\u4e0d\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u9078 Chrome \u500b\u4eba\u6a94\u6848\u5df2\u7121\u6cd5\u4f7f\u7528\u3002"
          }
        }
      }
    },
    "Some selected bookmark items are unavailable.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u0639\u0636 \u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige ausgew\u00e4hlte Lesezeichen sind nicht verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some selected bookmark items are unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos marcadores seleccionados no est\u00e1n disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains favoris s\u00e9lectionn\u00e9s ne sont pas disponibles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05dc\u05e7 \u05de\u05d4\u05e1\u05d9\u05de\u05e0\u05d9\u05d5\u05ea \u05e9\u05e0\u05d1\u05d7\u05e8\u05d5 \u05d0\u05d9\u05e0\u05df \u05d6\u05de\u05d9\u05e0\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0941\u091b \u091a\u0941\u0928\u0947 \u0917\u090f \u092c\u0941\u0915\u092e\u093e\u0930\u094d\u0915 \u0906\u0907\u091f\u092e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa item bookmark yang dipilih tidak tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni segnalibri selezionati non sono disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u3057\u305f\u30d6\u30c3\u30af\u30de\u30fc\u30af\u9805\u76ee\u306e\u4e00\u90e8\u3092\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\ud55c \ubd81\ub9c8\ud06c \ud56d\ubaa9 \uc911 \uc77c\ubd80\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige geselecteerde bladwijzers zijn niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekt\u00f3re wybrane zak\u0142adki s\u0105 niedost\u0119pne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns favoritos selecionados est\u00e3o indispon\u00edveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u044b\u0435 \u0437\u0430\u043a\u043b\u0430\u0434\u043a\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa valda bokm\u00e4rken \u00e4r inte tillg\u00e4ngliga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00e7ilen baz\u0131 yer i\u015faretleri kullan\u0131lam\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0435\u044f\u043a\u0456 \u0432\u0438\u0431\u0440\u0430\u043d\u0456 \u0437\u0430\u043a\u043b\u0430\u0434\u043a\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed9t s\u1ed1 d\u1ea5u trang \u0111\u00e3 ch\u1ecdn kh\u00f4ng kh\u1ea3 d\u1ee5ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90e8\u5206\u6240\u9009\u4e66\u7b7e\u9879\u4e0d\u53ef\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90e8\u5206\u6240\u9078\u66f8\u7c64\u9805\u76ee\u7121\u6cd5\u4f7f\u7528\u3002"
          }
        }
      }
    },
    "Select at least one item to continue.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u062f\u062f \u0639\u0646\u0635\u0631\u064b\u0627 \u0648\u0627\u062d\u062f\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie mindestens ein Element aus, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select at least one item to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona al menos un elemento para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9lectionnez au moins un \u00e9l\u00e9ment pour continuer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05e9 \u05dc\u05d1\u05d7\u05d5\u05e8 \u05e4\u05e8\u05d9\u05d8 \u05d0\u05d7\u05d3 \u05dc\u05e4\u05d7\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05de\u05e9\u05d9\u05da."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0917\u0947 \u092c\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u092e \u0938\u0947 \u0915\u092e \u090f\u0915 \u0906\u0907\u091f\u092e \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih setidaknya satu item untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona almeno un elemento per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d9a\u884c\u3059\u308b\u306b\u306f\u9805\u76ee\u3092 1 \u3064\u4ee5\u4e0a\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacc4\uc18d\ud558\ub824\uba74 \ud56d\ubaa9\uc744 \ud558\ub098 \uc774\uc0c1 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer minstens \u00e9\u00e9n item om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz co najmniej jeden element, aby kontynuowa\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione pelo menos um item para continuar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0445\u043e\u0442\u044f \u0431\u044b \u043e\u0434\u0438\u043d \u044d\u043b\u0435\u043c\u0435\u043d\u0442, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj minst ett objekt f\u00f6r att forts\u00e4tta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek i\u00e7in en az bir \u00f6\u011fe se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0440\u0438\u043d\u0430\u0439\u043c\u043d\u0456 \u043e\u0434\u0438\u043d \u0435\u043b\u0435\u043c\u0435\u043d\u0442, \u0449\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn \u00edt nh\u1ea5t m\u1ed9t m\u1ee5c \u0111\u1ec3 ti\u1ebfp t\u1ee5c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81f3\u5c11\u9009\u62e9\u4e00\u4e2a\u9879\u76ee\u4ee5\u7ee7\u7eed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81f3\u5c11\u9078\u53d6\u4e00\u500b\u9805\u76ee\u4ee5\u7e7c\u7e8c\u3002"
          }
        }
      }
    },
    "Saved bookmarks exceed the 2 MiB settings limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u062d\u062f \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0628\u0627\u0644\u063a 2 \u0645\u064a\u0628\u064a\u0628\u0627\u064a\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Lesezeichen \u00fcberschreiten das Einstellungslimit von 2 MiB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved bookmarks exceed the 2 MiB settings limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores guardados superan el l\u00edmite de 2 MiB de los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris enregistr\u00e9s d\u00e9passent la limite de 2 Mio des r\u00e9glages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e1\u05d9\u05de\u05e0\u05d9\u05d5\u05ea \u05d4\u05e9\u05de\u05d5\u05e8\u05d5\u05ea \u05d7\u05d5\u05e8\u05d2\u05d5\u05ea \u05de\u05de\u05d2\u05d1\u05dc\u05ea \u05d4\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e9\u05dc 2 MiB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0939\u0947\u091c\u0947 \u0917\u090f \u092c\u0941\u0915\u092e\u093e\u0930\u094d\u0915 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0940 2 MiB \u0938\u0940\u092e\u093e \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark tersimpan melebihi batas pengaturan 2 MiB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segnalibri salvati superano il limite di 2 MiB delle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u5b58\u3059\u308b\u30d6\u30c3\u30af\u30de\u30fc\u30af\u304c\u8a2d\u5b9a\u306e\u4e0a\u9650 2 MiB \u3092\u8d85\u3048\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\ub41c \ubd81\ub9c8\ud06c\uac00 \uc124\uc815\uc758 2MiB \uc81c\ud55c\uc744 \ucd08\uacfc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen bladwijzers overschrijden de limiet van 2 MiB voor instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane zak\u0142adki przekraczaj\u0105 limit ustawie\u0144 wynosz\u0105cy 2 MiB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os favoritos salvos excedem o limite de 2 MiB das configura\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u044a\u0435\u043c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u043a\u043b\u0430\u0434\u043e\u043a \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u043b\u0438\u043c\u0438\u0442 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0432 2 \u041c\u0438\u0411."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade bokm\u00e4rken \u00f6verskrider inst\u00e4llningsgr\u00e4nsen p\u00e5 2 MiB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
