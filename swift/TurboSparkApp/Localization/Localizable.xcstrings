          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Infer\u00eancia no local sem c\u00f3pia"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0432\u043e\u0434 \u043d\u0430 \u043c\u0435\u0441\u0442\u0435 \u0431\u0435\u0437 \u043a\u043e\u043f\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Zero-copy-inferens p\u00e5 plats"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyas\u0131z yerinde \u00e7\u0131kar\u0131m"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0441\u043d\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043c\u0456\u0441\u0446\u0456 \u0431\u0435\u0437 \u043a\u043e\u043f\u0456\u044e\u0432\u0430\u043d\u043d\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Suy lu\u1eadn t\u1ea1i ch\u1ed7 kh\u00f4ng sao ch\u00e9p"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96f6\u62f7\u8d1d\u5c31\u5730\u63a8\u7406"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96f6\u8907\u88fd\u5c31\u5730\u63a8\u8ad6"
          }
        }
      }
    },
