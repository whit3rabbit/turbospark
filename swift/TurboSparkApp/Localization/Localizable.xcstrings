          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53b3\u9078\u30ab\u30bf\u30ed\u30b0\u307e\u305f\u306f Hugging Face \u304b\u3089\u30e2\u30c7\u30eb\u3092\u30ed\u30fc\u30ab\u30eb\u306b\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u307e\u3059\u3002"
