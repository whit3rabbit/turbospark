        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e0\u05d7\u05d9\u05d5\u05ea \u05d0\u05d9\u05e9\u05d9\u05d5\u05ea \u05d5\u05ea\u05e7\u05e9\u05d5\u05e8\u05ea \u05d2\u05dc\u05d5\u05d1\u05dc\u05d9\u05d5\u05ea \u05dc\u05e1\u05d5\u05db\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u091c\u0947\u0902\u091f \u0915\u0947 \u0932\u093f\u090f \u0935\u0948\u0936\u094d\u0935\u093f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0924\u094d\u0935 \u0914\u0930 \u0938\u0902\u091a\u093e\u0930 \u092e\u093e\u0930\u094d\u0917\u0926\u0930\u094d\u0936\u0928\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Panduan kepribadian dan komunikasi global untuk agen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalit\u00e0 globale e indicazioni sulla comunicazione per l\u2019agente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306e\u30b0\u30ed\u30fc\u30d0\u30eb\u306a\u4eba\u683c\u3068\u30b3\u30df\u30e5\u30cb\u30b1\u30fc\u30b7\u30e7\u30f3\u6307\u91dd\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5d0\uc774\uc804\ud2b8\uc758 \uc804\uc5ed \uc131\uaca9 \ubc0f \ucee4\ubba4\ub2c8\ucf00\uc774\uc158 \uc9c0\uce68\uc785\ub2c8\ub2e4."
