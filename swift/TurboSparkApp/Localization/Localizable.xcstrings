          "stringUnit": {
            "state": "translated",
            "value": "生成正在執行時無法變更取樣設定。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "生成の実行中はサンプリング設定を変更できません。"
