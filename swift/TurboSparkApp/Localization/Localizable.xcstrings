          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella cartella si sovrappone a una libreria già presente nell'elenco."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのフォルダは、すでに一覧にあるライブラリと重なっています。"
