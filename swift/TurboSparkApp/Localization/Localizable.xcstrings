        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pemeriksaan selesai. Laporan tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esame completato. Il report \u00e8 disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8abf\u67fb\u304c\u5b8c\u4e86\u3057\u307e\u3057\u305f\u3002\u30ec\u30dd\u30fc\u30c8\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac80\uc0ac\uac00 \uc644\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ubcf4\uace0\uc11c\ub97c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onderzoek voltooid. Het rapport is beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzanie zako\u0144czone. Raport jest dost\u0119pny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Exame conclu\u00eddo. O relat\u00f3rio est\u00e1 dispon\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0432\u0435\u0440\u043a\u0430 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0430. \u041e\u0442\u0447\u0451\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Unders\u00f6kningen \u00e4r klar. Rapporten finns tillg\u00e4nglig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130nceleme tamamland\u0131. Rapor haz\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u043e. \u0417\u0432\u0456\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 ki\u1ec3m tra xong. B\u00e1o c\u00e1o \u0111\u00e3 s\u1eb5n s\u00e0ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
