        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092d\u093e\u0937\u0923 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964"
