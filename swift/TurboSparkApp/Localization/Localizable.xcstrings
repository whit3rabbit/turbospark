        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Liedtext aus der Beschreibung heraus. Beschreibe dort, wie Abschnitte klingen sollen, etwa ein größerer Refrain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pongas la letra en la descripción. Describe ahí cómo debe sonar cada sección, por ejemplo un estribillo más grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les paroles hors de la description. Décrivez-y plutôt le rendu des sections, par exemple un refrain plus ample."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אל תכניס את מילות השיר לתיאור. תאר שם איך המקטעים צריכים להישמע, למשל פזמון גדול יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गीत के बोल को विवरण में न रखें। वहाँ बताएँ कि सेक्शन कैसे सुनाई दें, जैसे बड़ा कोरस।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan masukkan lirik ke deskripsi. Jelaskan di sana bagaimana bagian-bagian harus terdengar, misalnya chorus yang lebih besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il testo fuori dalla descrizione. Descrivi lì come devono suonare le sezioni, ad esempio un ritornello più grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "歌詞は説明に入れないでください。説明には、サビを大きくするなど、各セクションの聞こえ方を書きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가사는 설명에 넣지 마세요. 설명에는 코러스를 더 크게 하는 등 각 섹션이 어떻게 들려야 하는지 적으세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de songtekst uit de beschrijving. Beschrijf daar hoe secties moeten klinken, zoals een groter refrein."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie umieszczaj tekstu piosenki w opisie. Opisz tam, jak mają brzmieć sekcje, na przykład głośniejszy refren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não coloque a letra na descrição. Descreva ali como as seções devem soar, como um refrão maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не включайте текст песни в описание. Опишите там, как должны звучать разделы, например более мощный припев."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Håll låttexten utanför beskrivningen. Beskriv där hur sektionerna ska låta, till exempel en större refräng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şarkı sözlerini açıklamanın dışında tutun. Orada bölümlerin nasıl duyulacağını anlatın, örneğin daha büyük bir nakarat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не додавайте текст пісні в опис. Опишіть там, як мають звучати розділи, наприклад потужніший приспів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đừng đưa lời bài hát vào mô tả. Hãy mô tả ở đó các phần nên nghe thế nào, chẳng hạn điệp khúc lớn hơn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把歌词放进描述。在描述中说明各段落应有的听感，例如更宏大的副歌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不要把歌詞放進描述。在描述中說明各段落應有的聽感，例如更宏大的副歌。"
          }
        }
      }
    },
    "Keep models on drives connected to this Mac. Your settings and model list stay on this Mac when a drive is unplugged.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالنماذج على محركات أقراص متصلة بهذا الـ Mac. تبقى إعداداتك وقائمة نماذجك على هذا الـ Mac عند فصل أي محرك أقراص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewahren Sie Modelle auf Laufwerken auf, die mit diesem Mac verbunden sind. Ihre Einstellungen und die Modellliste bleiben auf diesem Mac, wenn ein Laufwerk getrennt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep models on drives connected to this Mac. Your settings and model list stay on this Mac when a drive is unplugged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda modelos en unidades conectadas a este Mac. Tus ajustes y la lista de modelos permanecen en este Mac cuando se desconecta una unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservez des modèles sur des disques connectés à ce Mac. Vos réglages et la liste des modèles restent sur ce Mac quand un disque est débranché."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור מודלים על כוננים המחוברים ל-Mac הזה. ההגדרות ורשימת המודלים נשארות ב-Mac הזה כשמנתקים כונן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल को इस Mac से जुड़ी ड्राइव पर रखें। ड्राइव हटाने पर भी आपकी सेटिंग और मॉडल सूची इसी Mac पर रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan model di drive yang terhubung ke Mac ini. Pengaturan dan daftar model Anda tetap ada di Mac ini saat drive dicabut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva i modelli su unità collegate a questo Mac. Le impostazioni e l'elenco dei modelli restano su questo Mac quando un'unità viene scollegata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに接続したドライブにモデルを保存できます。ドライブを取り外しても、設定とモデルの一覧はこのMacに残ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 연결된 드라이브에 모델을 보관하세요. 드라이브를 분리해도 설정과 모델 목록은 이 Mac에 남아 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar modellen op schijven die op deze Mac zijn aangesloten. Uw instellingen en modellijst blijven op deze Mac staan wanneer een schijf wordt losgekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowuj modele na dyskach podłączonych do tego Maca. Ustawienia i lista modeli pozostają na tym Macu po odłączeniu dysku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde modelos em unidades conectadas a este Mac. Suas configurações e a lista de modelos permanecem neste Mac quando uma unidade é desconectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните модели на дисках, подключённых к этому Mac. Настройки и список моделей остаются на этом Mac, когда диск отключают."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Förvara modeller på enheter som är anslutna till den här Macen. Dina inställningar och din modelllista finns kvar på den här Macen när en enhet kopplas bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelleri bu Mac'e bağlı sürücülerde saklayın. Bir sürücü çıkarıldığında ayarlarınız ve model listeniz bu Mac'te kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте моделі на дисках, підключених до цього Mac. Налаштування й список моделей залишаються на цьому Mac, коли диск відключають."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu mô hình trên các ổ đĩa kết nối với máy Mac này. Cài đặt và danh sách mô hình của bạn vẫn ở trên máy Mac này khi ổ đĩa bị rút ra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将模型保存在连接到这台 Mac 的驱动器上。拔出驱动器后，你的设置和模型列表仍保留在这台 Mac 上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將模型儲存在連接到這部 Mac 的磁碟機上。拔除磁碟機後，你的設定和模型列表仍保留在這部 Mac 上。"
          }
        }
      }
    },
