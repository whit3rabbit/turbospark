            "value": "\u66f8\u304d\u76f4\u3057\u304c\u5143\u306e\u6587\u7ae0\u306e\u9577\u3044\u30d5\u30ec\u30fc\u30ba\u3092\u305d\u306e\u307e\u307e\u4f7f\u3063\u3066\u3044\u307e\u3059\u3002"
