          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhấp vào 'Cài đặt...' trên thanh công cụ để duyệt danh mục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
