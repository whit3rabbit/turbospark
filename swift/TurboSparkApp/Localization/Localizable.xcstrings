    "Sample interface text with active styling, contrast and accent colors.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص واجهة تجريبي بالتنسيق والتباين وألوان التمييز النشطة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispieltext der Oberfläche mit aktivem Stil, Kontrast und Akzentfarben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample interface text with active styling, contrast and accent colors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de interfaz de muestra con el estilo, el contraste y los colores de acento activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple de texte d'interface avec le style, le contraste et les couleurs d'accent actifs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט ממשק לדוגמה עם הסגנון, הניגודיות וצבעי ההדגשה הפעילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय स्टाइल, कंट्रास्ट और एक्सेंट रंगों के साथ नमूना इंटरफ़ेस टेक्स्ट।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
