        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05d9\u05e6\u05d3 \u05d9\u05e9 \u05dc\u05d0\u05e9\u05e8 \u05e7\u05e8\u05d9\u05d0\u05d5\u05ea \u05dc\u05db\u05dc\u05d9\u05dd?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0942\u0932 \u0915\u0949\u0932 \u0915\u094b \u0915\u0948\u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagaimana panggilan alat harus disetujui?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come devono essere approvate le chiamate agli strumenti?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c4\u30fc\u30eb\u547c\u3073\u51fa\u3057\u306e\u627f\u8a8d\u65b9\u6cd5\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub3c4\uad6c \ud638\ucd9c\uc744 \uc5b4\ub5bb\uac8c \uc2b9\uc778\ud560\uae4c\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe moeten tool-aanroepen worden goedgekeurd?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak maj\u0105 by\u0107 zatwierdzane wywo\u0142ania narz\u0119dzi?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Como as chamadas de ferramentas devem ser aprovadas?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0430\u043a \u0441\u043b\u0435\u0434\u0443\u0435\u0442 \u043e\u0434\u043e\u0431\u0440\u044f\u0442\u044c \u0432\u044b\u0437\u043e\u0432\u044b \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hur ska verktygsanrop godk\u00e4nnas?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara\u00e7 \u00e7a\u011fr\u0131lar\u0131 nas\u0131l onaylans\u0131n?"
