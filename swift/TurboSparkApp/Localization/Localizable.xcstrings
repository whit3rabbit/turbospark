          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente configurato dall'utente con istruzioni di sistema e strumenti personalizzati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム指示とツール機能をカスタマイズした、ユーザー設定のエージェント。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 지침과 도구 기능을 사용자가 직접 구성한 에이전트."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
