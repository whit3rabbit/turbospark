    "Messages, with tools, thinking and images.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0631\u0633\u0627\u0626\u0644\u060c \u0645\u0639 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0648\u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0648\u0627\u0644\u0635\u0648\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages mit Werkzeugen, Denken und Bildern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, with tools, thinking and images."
          }
        },
        "es": {
          "stringUnit": {
