    "Summarizing older turns so the conversation keeps fitting the window": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062c\u0627\u0631\u064d \u062a\u0644\u062e\u064a\u0635 \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0623\u0642\u062f\u0645 \u0644\u062a\u0628\u0642\u0649 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0636\u0645\u0646 \u0627\u0644\u0646\u0627\u0641\u0630\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4ltere Runden werden zusammengefasst, damit das Gespr\u00e4ch weiter ins Fenster passt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Summarizing older turns so the conversation keeps fitting the window"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumiendo turnos anteriores para que la conversaci\u00f3n siga cabiendo en la ventana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9sum\u00e9 des anciens tours pour que la conversation tienne toujours dans la fen\u00eatre"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e1\u05db\u05dd \u05ea\u05d5\u05e8\u05d5\u05ea \u05d9\u05e9\u05e0\u05d9\u05dd \u05db\u05d3\u05d9 \u05e9\u05d4\u05e9\u05d9\u05d7\u05d4 \u05ea\u05de\u05e9\u05d9\u05da \u05dc\u05d4\u05ea\u05d0\u05d9\u05dd \u05dc\u05d7\u05dc\u05d5\u05df"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0930\u093e\u0928\u0947 \u091f\u0930\u094d\u0928 \u0915\u093e \u0938\u093e\u0930\u093e\u0902\u0936 \u092c\u0928\u093e\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0939\u0948 \u0924\u093e\u0915\u093f \u092c\u093e\u0924\u091a\u0940\u0924 \u0935\u093f\u0902\u0921\u094b \u092e\u0947\u0902 \u092b\u093c\u093f\u091f \u0930\u0939\u0947"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Meringkas giliran lama agar percakapan tetap muat di jendela"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riepilogo dei turni precedenti in corso perch\u00e9 la conversazione continui a rientrare nella finestra"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f1a\u8a71\u304c\u30a6\u30a3\u30f3\u30c9\u30a6\u306b\u53ce\u307e\u308b\u3088\u3046\u3001\u53e4\u3044\u30bf\u30fc\u30f3\u3092\u8981\u7d04\u3057\u3066\u3044\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub300\ud654\uac00 \ucc3d\uc5d0 \uacc4\uc18d \ub4e4\uc5b4\uac00\ub3c4\ub85d \uc774\uc804 \ud134\uc744 \uc694\uc57d\ud558\ub294 \uc911"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oudere beurten worden samengevat zodat het gesprek in het venster blijft passen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsumowywanie starszych tur, aby rozmowa nadal mie\u015bci\u0142a si\u0119 w oknie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resumindo turnos antigos para que a conversa continue cabendo na janela"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0432\u043e\u0434\u043a\u0430 \u0441\u0442\u0430\u0440\u044b\u0445 \u0440\u0435\u043f\u043b\u0438\u043a, \u0447\u0442\u043e\u0431\u044b \u0431\u0435\u0441\u0435\u0434\u0430 \u043f\u043e\u043c\u0435\u0449\u0430\u043b\u0430\u0441\u044c \u0432 \u043e\u043a\u043d\u043e"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammanfattar \u00e4ldre turer s\u00e5 att konversationen forts\u00e4tter att rymmas i f\u00f6nstret"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetin pencereye s\u0131\u011fmaya devam etmesi i\u00e7in eski turlar \u00f6zetleniyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434\u0441\u0443\u043c\u043e\u0432\u0443\u0432\u0430\u043d\u043d\u044f \u0441\u0442\u0430\u0440\u0456\u0448\u0438\u0445 \u0440\u0435\u043f\u043b\u0456\u043a, \u0449\u043e\u0431 \u0440\u043e\u0437\u043c\u043e\u0432\u0430 \u0432\u043c\u0456\u0449\u0430\u043b\u0430\u0441\u044f \u0443 \u0432\u0456\u043a\u043d\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110ang t\u00f3m t\u1eaft c\u00e1c l\u01b0\u1ee3t c\u0169 \u0111\u1ec3 cu\u1ed9c tr\u00f2 chuy\u1ec7n v\u1eabn v\u1eeba c\u1eeda s\u1ed5"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u603b\u7ed3\u8f83\u65e9\u7684\u8f6e\u6b21\uff0c\u4f7f\u5bf9\u8bdd\u4fdd\u6301\u5728\u7a97\u53e3\u8303\u56f4\u5185"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u6458\u8981\u8f03\u65e9\u7684\u8f2a\u6b21\uff0c\u4f7f\u5c0d\u8a71\u7dad\u6301\u5728\u8996\u7a97\u7bc4\u570d\u5167"
          }
        }
      }
    },
