            "value": "Nada ha leído la forma de este checkpoint, así que su huella es desconocida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'a lu la forme de ce checkpoint, son empreinte est donc inconnue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איש לא קרא את הצורה של נקודת הביקורת הזו, ולכן טביעת הרגל שלה אינה ידועה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस चेकपॉइंट का आकार किसी ने नहीं पढ़ा, इसलिए इसकी खपत अज्ञात है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang membaca bentuk checkpoint ini, jadi jejak memorinya tidak diketahui."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno ha letto la forma di questo checkpoint, quindi il suo ingombro è sconosciuto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このチェックポイントの形状はまだ読み取られていないため、占有量は不明です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 체크포인트의 형태를 읽은 적이 없어 사용량을 알 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niets heeft de vorm van dit checkpoint gelezen, dus het geheugenbeslag is onbekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie odczytał kształtu tego punktu kontrolnego, więc jego zajętość jest nieznana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada leu o formato deste checkpoint, então o consumo dele é desconhecido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Форму этой контрольной точки никто не читал, поэтому ее объем неизвестен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting har läst det här checkpointens form, så dess minnesanvändning är okänd."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu denetim noktasının şeklini hiçbir şey okumadı, bu yüzden kapladığı alan bilinmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Форму цієї контрольної точки ніхто не читав, тож її обсяг невідомий."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có gì đọc hình dạng của checkpoint này, nên mức chiếm dụng chưa xác định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无任何操作读取过该检查点的形状，因此其占用未知。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無任何操作讀取過該檢查點的形狀，因此其占用未知。"
          }
        }
      }
    },
    "Nothing is installed. Choose a curated variant above to get started.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء مثبت. اختر متغيرًا منسقًا أعلاه للبدء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts ist installiert. Wahlen Sie oben eine ausgewahlte Variante, um zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is installed. Choose a curated variant above to get started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada instalado. Elige una variante seleccionada arriba para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est installe. Choisissez une variante selectionnee ci-dessus pour commencer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שום דבר לא מותקן. בחרו גרסה נבחרת למעלה כדי להתחיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी इंस्टॉल नहीं है। शुरू करने के लिए ऊपर से चुना हुआ वैरिएंट चुनें।"
          }
        },
        "id": {
          "stringUnit": {
