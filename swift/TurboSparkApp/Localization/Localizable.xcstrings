        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` \u091f\u0942\u0932 \u0915\u0940 \u0906\u0930\u094d\u0917\u094d\u092f\u0941\u092e\u0947\u0902\u091f \u0938\u094d\u0915\u0940\u092e\u093e \u092e\u0947\u0902 %@ \u092a\u0930 \u0905\u0938\u092e\u0930\u094d\u0925\u093f\u0924 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Skema argumen alat `%@` memiliki bagian yang tidak didukung di %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo schema degli argomenti dello strumento `%@` non \u00e8 supportato in %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c4\u30fc\u30eb\u300c%@\u300d\u306e\u5f15\u6570\u30b9\u30ad\u30fc\u30de\u306f %@ \u3067\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
