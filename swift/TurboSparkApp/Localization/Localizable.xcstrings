    "Expands to reveal the model's chain-of-thought reasoning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0648\u0633\u0639 \u0644\u0639\u0631\u0636 \u0633\u0644\u0633\u0644\u0629 \u062a\u0641\u0643\u064a\u0631 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klappt den Gedankengang des Modells auf"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expands to reveal the model's chain-of-thought reasoning"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se expande para mostrar el razonamiento paso a paso del modelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se d\u00e9plie pour r\u00e9v\u00e9ler le raisonnement pas \u00e0 pas du mod\u00e8le"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05ea\u05e8\u05d7\u05d1 \u05db\u05d3\u05d9 \u05dc\u05d7\u05e9\u05d5\u05e3 \u05d0\u05ea \u05e9\u05e8\u05e9\u05e8\u05ea \u05d4\u05d7\u05e9\u05d9\u05d1\u05d4 \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05dc"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0915\u0940 \u091a\u0930\u0923-\u0926\u0930-\u091a\u0930\u0923 \u0924\u0930\u094d\u0915 \u092a\u094d\u0930\u0915\u094d\u0930\u093f\u092f\u093e \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u0941\u0932\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka rantai penalaran model"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si espande per mostrare la catena di ragionamento del modello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c55\u958b\u3059\u308b\u3068\u30e2\u30c7\u30eb\u306e\u601d\u8003\u306e\u9023\u9396\u3092\u8868\u793a\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3bc\uce58\uba74 \ubaa8\ub378\uc758 \uc5f0\uc1c4\uc801 \uc0ac\uace0 \uacfc\uc815\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klapt uit om de gedachtegang van het model te tonen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwija \u0142a\u0144cuch rozumowania modelu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expande para mostrar a cadeia de racioc\u00ednio do modelo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0446\u0435\u043f\u043e\u0447\u043a\u0443 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439 \u043c\u043e\u0434\u0435\u043b\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00e4ller ut modellens tankekedja"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelin d\u00fc\u015f\u00fcnce zincirini g\u00f6stermek i\u00e7in geni\u015fler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u0454 \u043b\u0430\u043d\u0446\u044e\u0436\u043e\u043a \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u044c \u043c\u043e\u0434\u0435\u043b\u0456"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1edf r\u1ed9ng \u0111\u1ec3 hi\u1ec7n chu\u1ed7i suy lu\u1eadn c\u1ee7a m\u00f4 h\u00ecnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c55\u5f00\u4ee5\u663e\u793a\u6a21\u578b\u7684\u601d\u7ef4\u94fe\u63a8\u7406"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c55\u958b\u4ee5\u986f\u793a\u6a21\u578b\u7684\u601d\u7dad\u93c8\u63a8\u7406"
          }
        }
      }
    },
    "Expands to show the summary the model sees instead of those messages": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0648\u0633\u0639 \u0644\u0639\u0631\u0636 \u0627\u0644\u0645\u0644\u062e\u0635 \u0627\u0644\u0630\u064a \u064a\u0631\u0627\u0647 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u062a\u0644\u0643 \u0627\u0644\u0631\u0633\u0627\u0626\u0644"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt die Zusammenfassung, die das Modell anstelle dieser Nachrichten sieht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expands to show the summary the model sees instead of those messages"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se expande para mostrar el resumen que ve el modelo en lugar de esos mensajes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se d\u00e9plie pour afficher le r\u00e9sum\u00e9 que voit le mod\u00e8le \u00e0 la place de ces messages"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05ea\u05e8\u05d7\u05d1 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e6\u05d9\u05d2 \u05d0\u05ea \u05d4\u05e1\u05d9\u05db\u05d5\u05dd \u05e9\u05d4\u05de\u05d5\u05d3\u05dc \u05e8\u05d5\u05d0\u05d4 \u05d1\u05de\u05e7\u05d5\u05dd \u05d4\u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05d4\u05d0\u05dc\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0939 \u0938\u093e\u0930\u093e\u0902\u0936 \u0926\u093f\u0916\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u0941\u0932\u0924\u093e \u0939\u0948 \u091c\u094b \u092e\u0949\u0921\u0932 \u0909\u0928 \u0938\u0902\u0926\u0947\u0936\u094b\u0902 \u0915\u0947 \u092c\u091c\u093e\u092f \u0926\u0947\u0916\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka ringkasan yang dilihat model sebagai pengganti pesan-pesan itu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si espande per mostrare il riepilogo che il modello vede al posto di quei messaggi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c55\u958b\u3059\u308b\u3068\u3001\u305d\u308c\u3089\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u306e\u4ee3\u308f\u308a\u306b\u30e2\u30c7\u30eb\u304c\u53c2\u7167\u3059\u308b\u8981\u7d04\u3092\u8868\u793a\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3bc\uce58\uba74 \ubaa8\ub378\uc774 \ud574\ub2f9 \uba54\uc2dc\uc9c0 \ub300\uc2e0 \ubcf4\ub294 \uc694\uc57d\uc774 \ud45c\uc2dc\ub429\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klapt uit om de samenvatting te tonen die het model ziet in plaats van die berichten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozwija podsumowanie, kt\u00f3re model widzi zamiast tych wiadomo\u015bci"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Expande para mostrar o resumo que o modelo v\u00ea no lugar dessas mensagens"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0432\u043e\u0440\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0441\u0432\u043e\u0434\u043a\u0443, \u043a\u043e\u0442\u043e\u0440\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c \u0432\u0438\u0434\u0438\u0442 \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u0438\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00e4ller ut sammanfattningen som modellen ser i st\u00e4llet f\u00f6r meddelandena"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelin bu mesajlar yerine g\u00f6rd\u00fc\u011f\u00fc \u00f6zeti g\u00f6stermek i\u00e7in geni\u015fler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u043e\u0437\u0433\u043e\u0440\u0442\u0430\u0454 \u043f\u0456\u0434\u0441\u0443\u043c\u043e\u043a, \u044f\u043a\u0438\u0439 \u043c\u043e\u0434\u0435\u043b\u044c \u0431\u0430\u0447\u0438\u0442\u044c \u0437\u0430\u043c\u0456\u0441\u0442\u044c \u0446\u0438\u0445 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c"
          }
        },
        "vi": {
