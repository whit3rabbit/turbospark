          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj folderu z punktem kontrolnym zamiast przypiętego pobrania. Jego pliki nie są sprawdzane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar uma pasta de checkpoint em vez do download fixado. Os arquivos dela não são verificados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
