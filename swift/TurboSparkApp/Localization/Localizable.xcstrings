    "Add files, folders, and tools (Cmd+U)": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0636\u0627\u0641\u0629 \u0645\u0644\u0641\u0627\u062a \u0648\u0645\u062c\u0644\u062f\u0627\u062a \u0648\u0623\u062f\u0648\u0627\u062a (Cmd+U)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien, Ordner und Tools hinzuf\u00fcgen (Cmd+U)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add files, folders, and tools (Cmd+U)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00f1adir archivos, carpetas y herramientas (Cmd+U)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des fichiers, des dossiers et des outils (Cmd+U)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e1\u05e3 \u05e7\u05d1\u05e6\u05d9\u05dd, \u05ea\u05d9\u05e7\u05d9\u05d5\u05ea \u05d5\u05db\u05dc\u05d9\u05dd (Cmd+U)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u093c\u093e\u0907\u0932\u0947\u0902, \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0914\u0930 \u0909\u092a\u0915\u0930\u0923 \u091c\u094b\u0921\u093c\u0947\u0902 (Cmd+U)"
          }
        },
        "id": {
          "stringUnit": {
