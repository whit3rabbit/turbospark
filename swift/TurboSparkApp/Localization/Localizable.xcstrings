    "One passage is too long for the model. Add paragraph breaks and try again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One passage is too long for the model. Add paragraph breaks and try again."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u062d\u062f \u0627\u0644\u0645\u0642\u0627\u0637\u0639 \u0637\u0648\u064a\u0644 \u062c\u062f\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0646\u0645\u0648\u0630\u062c. \u0623\u0636\u0641 \u0641\u0648\u0627\u0635\u0644 \u0641\u0642\u0631\u0627\u062a \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Abschnitt ist zu lang f\u00fcr das Modell. F\u00fcgen Sie Absatzumbr\u00fcche ein und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fragmento es demasiado largo para el modelo. A\u00f1ade saltos de p\u00e1rrafo e int\u00e9ntalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passage est trop long pour le mod\u00e8le. Ajoutez des sauts de paragraphe et r\u00e9essayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d7\u05d3 \u05d4\u05e7\u05d8\u05e2\u05d9\u05dd \u05d0\u05e8\u05d5\u05da \u05de\u05d3\u05d9 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05de\u05d5\u05d3\u05dc. \u05d4\u05d5\u05e1\u05e3 \u05de\u05e2\u05d1\u05e8\u05d9 \u05e4\u05e1\u05e7\u05d4 \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0905\u0902\u0936 \u092e\u0949\u0921\u0932 \u0915\u0947 \u0932\u093f\u090f \u092c\u0939\u0941\u0924 \u0932\u0902\u092c\u093e \u0939\u0948\u0964 \u0905\u0928\u0941\u091a\u094d\u091b\u0947\u0926 \u0935\u093f\u0930\u093e\u092e \u091c\u094b\u0921\u093c\u0947\u0902 \u0914\u0930 \u092b\u093f\u0930 \u0938\u0947 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Satu bagian terlalu panjang untuk model. Tambahkan jeda paragraf lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un passaggio \u00e8 troppo lungo per il modello. Aggiungi interruzioni di paragrafo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u306b\u306f\u9577\u3059\u304e\u308b\u7b87\u6240\u304c\u3042\u308a\u307e\u3059\u3002\u6bb5\u843d\u306e\u533a\u5207\u308a\u3092\u5165\u308c\u3066\u304b\u3089\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc774 \ucc98\ub9ac\ud558\uae30\uc5d0 \ub108\ubb34 \uae34 \uad6c\uac04\uc774 \uc788\uc2b5\ub2c8\ub2e4. \ubb38\ub2e8\uc744 \ub098\ub208 \ub4a4 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u00e9n passage is te lang voor het model. Voeg alinea-einden toe en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden fragment jest za d\u0142ugi dla modelu. Dodaj podzia\u0142y akapit\u00f3w i spr\u00f3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um trecho \u00e9 longo demais para o modelo. Adicione quebras de par\u00e1grafo e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0434\u0438\u043d \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442 \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0434\u043b\u0438\u043d\u043d\u044b\u0439 \u0434\u043b\u044f \u043c\u043e\u0434\u0435\u043b\u0438. \u0420\u0430\u0437\u0431\u0435\u0439\u0442\u0435 \u0435\u0433\u043e \u043d\u0430 \u0430\u0431\u0437\u0430\u0446\u044b \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett avsnitt \u00e4r f\u00f6r l\u00e5ngt f\u00f6r modellen. L\u00e4gg till styckebrytningar och f\u00f6rs\u00f6k igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir b\u00f6l\u00fcm model i\u00e7in \u00e7ok uzun. Paragraf sonu ekleyip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0434\u0438\u043d \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442 \u0437\u0430\u0434\u043e\u0432\u0433\u0438\u0439 \u0434\u043b\u044f \u043c\u043e\u0434\u0435\u043b\u0456. \u0420\u043e\u0437\u0431\u0438\u0439\u0442\u0435 \u0439\u043e\u0433\u043e \u043d\u0430 \u0430\u0431\u0437\u0430\u0446\u0438 \u0439 \u043f\u043e\u0432\u0442\u043e\u0440\u0456\u0442\u044c \u0441\u043f\u0440\u043e\u0431\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed9t \u0111o\u1ea1n qu\u00e1 d\u00e0i \u0111\u1ed1i v\u1edbi m\u00f4 h\u00ecnh. H\u00e3y th\u00eam ng\u1eaft \u0111o\u1ea1n r\u1ed3i th\u1eed l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u4e00\u6bb5\u5185\u5bb9\u5bf9\u6a21\u578b\u6765\u8bf4\u592a\u957f\u3002\u8bf7\u6dfb\u52a0\u6bb5\u843d\u5206\u9694\u540e\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6709\u4e00\u6bb5\u5167\u5bb9\u5c0d\u6a21\u578b\u4f86\u8aaa\u592a\u9577\u3002\u8acb\u52a0\u5165\u6bb5\u843d\u5206\u9694\u5f8c\u91cd\u8a66\u3002"
          }
        }
      }
    },
    "Stop Humanize before deleting its model.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop Humanize before deleting its model."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0648\u0642\u0641 \u00ab\u0623\u0646\u0633\u0646\u0629\u00bb \u0642\u0628\u0644 \u062d\u0630\u0641 \u0646\u0645\u0648\u0630\u062c\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beenden Sie \u201eVermenschlichen\u201c, bevor Sie das zugeh\u00f6rige Modell l\u00f6schen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Det\u00e9n \u00abHumanizar\u00bb antes de eliminar su modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eatez \u00ab Humaniser \u00bb avant de supprimer son mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05e6\u05d5\u05e8 \u05d0\u05ea \"\u05d4\u05e4\u05d5\u05da \u05dc\u05d0\u05e0\u05d5\u05e9\u05d9\" \u05dc\u05e4\u05e0\u05d9 \u05de\u05d7\u05d9\u05e7\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05e9\u05dc\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938\u0915\u093e \u092e\u0949\u0921\u0932 \u0939\u091f\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \"\u092e\u093e\u0928\u0935\u0940\u092f \u092c\u0928\u093e\u090f\u0902\" \u0930\u094b\u0915\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan \"Manusiakan\" sebelum menghapus modelnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi \"Umanizza\" prima di eliminarne il modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u3092\u524a\u9664\u3059\u308b\u524d\u306b\u300c\u4eba\u9593\u3089\u3057\u304f\u3059\u308b\u300d\u3092\u505c\u6b62\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc744 \uc0ad\uc81c\ud558\uae30 \uc804\uc5d0 '\uc0ac\ub78c\ucc98\ub7fc \ub2e4\ub4ec\uae30'\ub97c \uc911\uc9c0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop \"Humaniseren\" voordat je het model verwijdert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj \u201eUcz\u0142owiecz\u201d przed usuni\u0119ciem jego modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare o \"Humanizar\" antes de excluir o modelo dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u00ab\u041e\u0447\u0435\u043b\u043e\u0432\u0435\u0447\u0438\u0442\u044c\u00bb \u043f\u0435\u0440\u0435\u0434 \u0443\u0434\u0430\u043b\u0435\u043d\u0438\u0435\u043c \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa \"Humanisera\" innan du tar bort modellen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelini silmeden \u00f6nce \"\u0130nsanla\u015ft\u0131r\" i\u015flemini durdurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u00ab\u041e\u043b\u044e\u0434\u043d\u0438\u0442\u0438\u00bb \u043f\u0435\u0440\u0435\u0434 \u0432\u0438\u0434\u0430\u043b\u0435\u043d\u043d\u044f\u043c \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y d\u1eebng \"Nh\u00e2n h\u00f3a\" tr\u01b0\u1edbc khi x\u00f3a m\u00f4 h\u00ecnh c\u1ee7a n\u00f3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u505c\u6b62\u201c\u4eba\u6027\u5316\u6539\u5199\u201d\uff0c\u518d\u5220\u9664\u5176\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u505c\u6b62\u300c\u4eba\u6027\u5316\u6539\u5beb\u300d\uff0c\u518d\u522a\u9664\u5176\u6a21\u578b\u3002"
          }
        }
      }
    },
