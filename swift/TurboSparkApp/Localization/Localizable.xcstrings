    "The source file is no longer at its original path.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0639\u062f \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0645\u0635\u062f\u0631 \u0641\u064a \u0645\u0633\u0627\u0631\u0647 \u0627\u0644\u0623\u0635\u0644\u064a."
          }
        },
