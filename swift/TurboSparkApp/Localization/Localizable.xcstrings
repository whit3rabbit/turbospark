        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj o cokolwiek"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte qualquer coisa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u0440\u043e\u0441\u0438\u0442\u0435 \u0447\u0442\u043e \u0443\u0433\u043e\u0434\u043d\u043e"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fr\u00e5ga vad som helst"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne isterseniz sorun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0442\u0430\u0439\u0442\u0435 \u0431\u0443\u0434\u044c-\u0449\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ecfi b\u1ea5t c\u1ee9 \u0111i\u1ec1u g\u00ec"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u968f\u4fbf\u95ee\u70b9\u4ec0\u4e48"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96a8\u610f\u63d0\u554f"
          }
        }
      }
    },
    "Ask anything, or type / for templates": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u0623\u0644 \u0623\u064a \u0634\u064a\u0621\u060c \u0623\u0648 \u0627\u0643\u062a\u0628 / \u0644\u0644\u0642\u0648\u0627\u0644\u0628"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fragen Sie etwas, oder geben Sie / fuer Vorlagen ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask anything, or type / for templates"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregunta lo que quieras, o escribe / para plantillas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question, ou tapez / pour les modeles"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d0\u05dc \u05db\u05dc \u05d3\u05d1\u05e8, \u05d0\u05d5 \u05d4\u05e7\u05dc\u05d3 / \u05e2\u05d1\u05d5\u05e8 \u05ea\u05d1\u05e0\u05d9\u05d5\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0941\u091b \u092d\u0940 \u092a\u0942\u091b\u0947\u0902, \u092f\u093e \u091f\u0947\u092e\u094d\u092a\u094d\u0932\u0947\u091f \u0915\u0947 \u0932\u093f\u090f / \u091f\u093e\u0907\u092a \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanyakan apa saja, atau ketik / untuk template"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi qualunque cosa, o digita / per i modelli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cea\u554f\u3092\u5165\u529b\u3001\u307e\u305f\u306f / \u3067\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u3092\u8868\u793a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubb34\uc5c7\uc774\ub4e0 \ubb3c\uc5b4\ubcf4\uac70\ub098 / \ub97c \uc785\ub825\ud558\uc5ec \ud15c\ud50c\ub9bf\uc744 \ud655\uc778\ud558\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag alles, of typ / voor sjablonen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapytaj o cokolwiek lub wpisz / dla szablon\u00f3w"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pergunte algo, ou digite / para modelos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u0440\u043e\u0441\u0438\u0442\u0435 \u0447\u0442\u043e \u0443\u0433\u043e\u0434\u043d\u043e \u0438\u043b\u0438 \u0432\u0432\u0435\u0434\u0438\u0442\u0435 / \u0434\u043b\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u043e\u0432"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fr\u00e5ga vad som helst, eller skriv / f\u00f6r mallar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhangi bir \u015fey sorun veya \u015fablonlar i\u00e7in / yaz\u0131n"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0442\u0443\u0439\u0442\u0435 \u0431\u0443\u0434\u044c-\u0449\u043e \u0430\u0431\u043e \u0432\u0432\u0435\u0434\u0456\u0442\u044c / \u0434\u043b\u044f \u0448\u0430\u0431\u043b\u043e\u043d\u0456\u0432"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ecfi b\u1ea5t c\u1ee9 \u0111i\u1ec1u g\u00ec, ho\u1eb7c g\u00f5 / cho m\u1eabu"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f93\u5165\u4efb\u4f55\u5185\u5bb9\uff0c\u6216\u8f93\u5165 / \u67e5\u770b\u6a21\u677f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f38\u5165\u4efb\u4f55\u5167\u5bb9\uff0c\u6216\u8f38\u5165 / \u67e5\u770b\u7bc4\u672c"
          }
        }
      }
    },
    "Ask the assistant to schedule one, for example: \"every morning at 9, summarize my notes\" -- it will use CronCreate and the job appears here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0637\u0644\u0628 \u0645\u0646 \u0627\u0644\u0645\u0633\u0627\u0639\u062f \u062c\u062f\u0648\u0644\u0629 \u0645\u0647\u0645\u0629\u060c \u0645\u062b\u0644\u0627: \"\u0643\u0644 \u0635\u0628\u0627\u062d \u0641\u064a \u0627\u0644\u062a\u0627\u0633\u0639\u0629\u060c \u0644\u062e\u0635 \u0645\u0644\u0627\u062d\u0638\u0627\u062a\u064a\" -- \u0633\u064a\u0633\u062a\u062e\u062f\u0645 CronCreate \u0648\u0633\u062a\u0638\u0647\u0631 \u0627\u0644\u0645\u0647\u0645\u0629 \u0647\u0646\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitten Sie den Assistenten, eine zu planen, zum Beispiel: \"Fasse jeden Morgen um 9 Uhr meine Notizen zusammen\" -- er verwendet CronCreate und der Auftrag erscheint hier."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask the assistant to schedule one, for example: \"every morning at 9, summarize my notes\" -- it will use CronCreate and the job appears here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pide al asistente que programe una, por ejemplo: \"cada ma\u00f1ana a las 9, resume mis notas\" -- usar\u00e1 CronCreate y la tarea aparecer\u00e1 aqu\u00ed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demandez \u00e0 l'assistant d'en planifier une, par exemple : \"chaque matin \u00e0 9 h, r\u00e9sume mes notes\" -- il utilisera CronCreate et la t\u00e2che appara\u00eetra ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05e7\u05e9 \u05de\u05d4\u05e2\u05d5\u05d6\u05e8 \u05dc\u05ea\u05d6\u05de\u05df \u05de\u05e9\u05d9\u05de\u05d4, \u05dc\u05de\u05e9\u05dc: \"\u05db\u05dc \u05d1\u05d5\u05e7\u05e8 \u05d1-9, \u05e1\u05db\u05dd \u05d0\u05ea \u05d4\u05d4\u05e2\u05e8\u05d5\u05ea \u05e9\u05dc\u05d9\" -- \u05d4\u05d5\u05d0 \u05d9\u05e9\u05ea\u05de\u05e9 \u05d1-CronCreate \u05d5\u05d4\u05de\u05e9\u05d9\u05de\u05d4 \u05ea\u05d5\u05e4\u05d9\u05e2 \u05db\u05d0\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u093f\u0938\u094d\u091f\u0947\u0902\u091f \u0938\u0947 \u0936\u0947\u0921\u094d\u092f\u0942\u0932 \u0915\u0930\u0928\u0947 \u0915\u094b \u0915\u0939\u0947\u0902, \u091c\u0948\u0938\u0947: \"\u0939\u0930 \u0938\u0941\u092c\u0939 9 \u092c\u091c\u0947 \u092e\u0947\u0930\u0947 \u0928\u094b\u091f\u094d\u0938 \u0915\u093e \u0938\u093e\u0930\u093e\u0902\u0936 \u0926\u094b\" -- \u0935\u0939 CronCreate \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0917\u093e \u0914\u0930 \u091c\u0949\u092c \u092f\u0939\u093e\u0902 \u0926\u093f\u0916\u0947\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta asisten menjadwalkan satu, misalnya: \"setiap pagi pukul 9, ringkas catatan saya\" -- asisten akan memakai CronCreate dan tugasnya muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi all'assistente di pianificarne una, ad esempio: \"ogni mattina alle 9, riassumi le mie note\" -- user\u00e0 CronCreate e il processo comparir\u00e0 qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30b7\u30b9\u30bf\u30f3\u30c8\u306b\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u3092\u4f9d\u983c\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u4f8b: \u300c\u6bce\u671d 9 \u6642\u306b\u30e1\u30e2\u3092\u8981\u7d04\u3057\u3066\u300d -- CronCreate \u304c\u4f7f\u308f\u308c\u3001\u30b8\u30e7\u30d6\u304c\u3053\u3053\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5b4\uc2dc\uc2a4\ud134\ud2b8\uc5d0\uac8c \uc608\uc57d\uc744 \uc694\uccad\ud558\uc138\uc694. \uc608: \"\ub9e4\uc77c \uc544\uce68 9\uc2dc\uc5d0 \ub0b4 \uba54\ubaa8\ub97c \uc694\uc57d\ud574\uc918\" -- CronCreate\ub97c \uc0ac\uc6a9\ud558\uba70 \uc791\uc5c5\uc774 \uc5ec\uae30\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag de assistent er een te plannen, bijvoorbeeld: \"vat elke ochtend om 9 uur mijn notities samen\" -- hij gebruikt CronCreate en de taak verschijnt hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Popro\u015b asystenta o zaplanowanie zadania, na przyk\u0142ad: \"ka\u017cdego ranka o 9 podsumuj moje notatki\" -- u\u017cyje CronCreate, a zadanie pojawi si\u0119 tutaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pe\u00e7a ao assistente para agendar uma, por exemplo: \"toda manh\u00e3 \u00e0s 9, resuma minhas notas\" -- ele usar\u00e1 o CronCreate e a tarefa aparecer\u00e1 aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043f\u0440\u043e\u0441\u0438\u0442\u0435 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0430 \u0437\u0430\u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0437\u0430\u0434\u0430\u0447\u0443, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440: \"\u043a\u0430\u0436\u0434\u043e\u0435 \u0443\u0442\u0440\u043e \u0432 9 \u043f\u043e\u0434\u0432\u043e\u0434\u0438 \u0438\u0442\u043e\u0433 \u043c\u043e\u0438\u0445 \u0437\u0430\u043c\u0435\u0442\u043e\u043a\" -- \u043e\u043d \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 CronCreate, \u0438 \u0437\u0430\u0434\u0430\u0447\u0430 \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0437\u0434\u0435\u0441\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be assistenten schemal\u00e4gga en, till exempel: \"sammanfatta mina anteckningar varje morgon klockan 9\" -- den anv\u00e4nder CronCreate och jobbet visas h\u00e4r."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistandan bir tane planlamas\u0131n\u0131 isteyin, \u00f6rne\u011fin: \"her sabah 9'da notlar\u0131m\u0131 \u00f6zetle\" -- CronCreate kullan\u0131r ve i\u015f burada g\u00f6r\u00fcn\u00fcr."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043f\u0440\u043e\u0441\u0456\u0442\u044c \u0430\u0441\u0438\u0441\u0442\u0435\u043d\u0442\u0430 \u0437\u0430\u043f\u043b\u0430\u043d\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434: \"\u0449\u043e\u0440\u0430\u043d\u043a\u0443 \u043e 9 \u043f\u0456\u0434\u0441\u0443\u043c\u043e\u0432\u0443\u0439 \u043c\u043e\u0457 \u043d\u043e\u0442\u0430\u0442\u043a\u0438\" -- \u0432\u0456\u043d \u0441\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0454\u0442\u044c\u0441\u044f CronCreate, \u0456 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f \u0437'\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u0442\u0443\u0442."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00eau c\u1ea7u tr\u1ee3 l\u00fd l\u00ean l\u1ecbch m\u1ed9t t\u00e1c v\u1ee5, v\u00ed d\u1ee5: \"m\u1ed7i s\u00e1ng 9 gi\u1edd, t\u00f3m t\u1eaft ghi ch\u00fa c\u1ee7a t\u00f4i\" -- tr\u1ee3 l\u00fd s\u1ebd d\u00f9ng CronCreate v\u00e0 c\u00f4ng vi\u1ec7c s\u1ebd xu\u1ea5t hi\u1ec7n \u1edf \u0111\u00e2y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ba9\u52a9\u624b\u5b89\u6392\u4e00\u4e2a\uff0c\u4f8b\u5982: \"\u6bcf\u5929\u65e9\u4e0a 9 \u70b9\u603b\u7ed3\u6211\u7684\u7b14\u8bb0\" -- \u5b83\u4f1a\u4f7f\u7528 CronCreate\uff0c\u4efb\u52a1\u5c06\u663e\u793a\u5728\u8fd9\u91cc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b93\u52a9\u7406\u5b89\u6392\u4e00\u500b\uff0c\u4f8b\u5982: \"\u6bcf\u5929\u65e9\u4e0a 9 \u9ede\u7e3d\u7d50\u6211\u7684\u7b46\u8a18\" -- \u5b83\u6703\u4f7f\u7528 CronCreate\uff0c\u5de5\u4f5c\u5c07\u986f\u793a\u5728\u9019\u88e1\u3002"
          }
        }
      }
    },
    "Assign a Codebase Root Directory in Project Settings to enable automatic MCP file detection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u064a\u0651\u0646 \u062f\u0644\u064a\u0644\u0627 \u062c\u0630\u0631\u064a\u0627 \u0644\u0644\u0634\u0641\u0631\u0629 \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0644\u062a\u0641\u0639\u064a\u0644 \u0627\u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a \u0644\u0645\u0644\u0641\u0627\u062a MCP."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legen Sie in den Projekteinstellungen ein Code-Stammverzeichnis fest, um die automatische MCP-Dateierkennung zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assign a Codebase Root Directory in Project Settings to enable automatic MCP file detection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Asigna un directorio ra\u00edz del c\u00f3digo en los ajustes del proyecto para habilitar la detecci\u00f3n autom\u00e1tica de archivos MCP."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9finissez un r\u00e9pertoire racine du code dans les r\u00e9glages du projet pour activer la d\u00e9tection automatique des fichiers MCP."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d2\u05d3\u05e8 \u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05e9\u05d5\u05e8\u05e9 \u05dc\u05e7\u05d5\u05d3 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05d3\u05d9 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05d6\u05d9\u05d4\u05d5\u05d9 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05e9\u05dc \u05e7\u05d5\u05d1\u05e6\u05d9 MCP."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP \u092b\u093c\u093e\u0907\u0932\u094b\u0902 \u0915\u0940 \u0938\u094d\u0935\u0924\u0903 \u092a\u0939\u091a\u093e\u0928 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0915\u094b\u0921\u092c\u0947\u0938 \u0930\u0942\u091f \u0921\u093e\u092f\u0930\u0947\u0915\u094d\u091f\u0930\u0940 \u0905\u0938\u093e\u0907\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan direktori root basis kode di pengaturan proyek untuk mengaktifkan deteksi berkas MCP otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Assegna una directory radice del codice nelle impostazioni del progetto per abilitare il rilevamento automatico dei file MCP."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u8a2d\u5b9a\u3067\u30b3\u30fc\u30c9\u306e\u30eb\u30fc\u30c8\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u3092\u6307\u5b9a\u3059\u308b\u3068\u3001MCP \u30d5\u30a1\u30a4\u30eb\u306e\u81ea\u52d5\u691c\u51fa\u304c\u6709\u52b9\u306b\u306a\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8 \uc124\uc815\uc5d0\uc11c \ucf54\ub4dc\ubca0\uc774\uc2a4 \ub8e8\ud2b8 \ub514\ub809\ud130\ub9ac\ub97c \uc9c0\uc815\ud558\uba74 MCP \ud30c\uc77c \uc790\ub3d9 \uac10\uc9c0\uac00 \ud65c\uc131\ud654\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijs in de projectinstellingen een hoofdmap voor de codebase toe om automatische MCP-bestandsdetectie in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wska\u017c katalog g\u0142\u00f3wny kodu w ustawieniach projektu, aby w\u0142\u0105czy\u0107 automatyczne wykrywanie plik\u00f3w MCP."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina um diret\u00f3rio raiz do c\u00f3digo nas configura\u00e7\u00f5es do projeto para habilitar a detec\u00e7\u00e3o autom\u00e1tica de arquivos MCP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u043a\u043e\u0440\u043d\u0435\u0432\u043e\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u043a\u043e\u0434\u0430 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u043f\u0440\u043e\u0435\u043a\u0442\u0430, \u0447\u0442\u043e\u0431\u044b \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u043e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0438\u0435 \u0444\u0430\u0439\u043b\u043e\u0432 MCP."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en rotkatalog f\u00f6r kodbasen i projektinst\u00e4llningarna f\u00f6r att aktivera automatisk MCP-filidentifiering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP dosyalar\u0131n\u0131n otomatik alg\u0131lanmas\u0131n\u0131 etkinle\u015ftirmek i\u00e7in proje ayarlar\u0131nda bir kod k\u00f6k dizini atay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0456\u0442\u044c \u043a\u043e\u0440\u0435\u043d\u0435\u0432\u0438\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433 \u043a\u043e\u0434\u0443 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 \u043f\u0440\u043e\u0454\u043a\u0442\u0443, \u0449\u043e\u0431 \u0443\u0432\u0456\u043c\u043a\u043d\u0443\u0442\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u0435 \u0432\u0438\u044f\u0432\u043b\u0435\u043d\u043d\u044f \u0444\u0430\u0439\u043b\u0456\u0432 MCP."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ec9 \u0111\u1ecbnh th\u01b0 m\u1ee5c g\u1ed1c c\u1ee7a m\u00e3 ngu\u1ed3n trong c\u00e0i \u0111\u1eb7t d\u1ef1 \u00e1n \u0111\u1ec3 b\u1eadt t\u1ef1 \u0111\u1ed9ng ph\u00e1t hi\u1ec7n t\u1ec7p MCP."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u9879\u76ee\u8bbe\u7f6e\u4e2d\u6307\u5b9a\u4ee3\u7801\u6839\u76ee\u5f55\uff0c\u5373\u53ef\u542f\u7528 MCP \u6587\u4ef6\u81ea\u52a8\u68c0\u6d4b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5c08\u6848\u8a2d\u5b9a\u4e2d\u6307\u5b9a\u7a0b\u5f0f\u78bc\u6839\u76ee\u9304\uff0c\u5373\u53ef\u555f\u7528 MCP \u6a94\u6848\u81ea\u52d5\u5075\u6e2c\u3002"
          }
        }
      }
    },
