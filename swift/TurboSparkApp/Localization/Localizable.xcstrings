        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05d4\u05d2\u05d3\u05e8\u05ea \u05e1\u05d5\u05db\u05df \u05de\u05d5\u05e4\u05e2\u05dc\u05ea \u05dc\u05d4\u05e8\u05e6\u05ea \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938\u0947 \u091a\u0932\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0938\u0915\u094d\u0937\u092e \u090f\u091c\u0947\u0902\u091f \u092a\u0930\u093f\u092d\u093e\u0937\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada definisi agen aktif untuk menjalankan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna definizione di agente abilitata con cui eseguirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u308c\u3092\u5b9f\u884c\u3067\u304d\u308b\u6709\u52b9\u306a\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u5b9a\u7fa9\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc791\uc5c5\uc744 \uc2e4\ud589\ud560 \ud65c\uc131\ud654\ub41c \uc5d0\uc774\uc804\ud2b8 \uc815\uc758\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
