        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05de\u05ea\u05d9\u05df \u05dc\u05de\u05e8\u05d9\u05e5. \u05e1\u05d1\u05d1 \u05d0\u05d7\u05d3 \u05d1\u05db\u05dc \u05e4\u05e2\u05dd \u05dc\u05db\u05dc \u05de\u05d5\u05d3\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u0928\u0930 \u0915\u0940 \u092a\u094d\u0930\u0924\u0940\u0915\u094d\u0937\u093e\u0964 \u092a\u094d\u0930\u0924\u093f \u092e\u0949\u0921\u0932 \u090f\u0915 \u092c\u093e\u0930 \u092e\u0947\u0902 \u090f\u0915 \u091f\u0930\u094d\u0928\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menunggu runner. Satu giliran setiap kali per model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In attesa del runner. Un turno alla volta per modello."
