    "Ollama's blob store is not directly importable; no files will be copied.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مخزن كائنات blob الخاص بـ Ollama غير قابل للاستيراد مباشرةً؛ لن يتم نسخ أي ملفات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Blob-Speicher von Ollama kann nicht direkt importiert werden; es werden keine Dateien kopiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama's blob store is not directly importable; no files will be copied."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El almacén de blobs de Ollama no se puede importar directamente; no se copiará ningún archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le magasin de blobs d'Ollama n'est pas directement importable ; aucun fichier ne sera copié."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לייבא ישירות את מאגר ה-blob של Ollama; קבצים לא יועתקו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama का ब्लॉब स्टोर सीधे आयात करने योग्य नहीं है; कोई फ़ाइल कॉपी नहीं की जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan blob Ollama tidak dapat diimpor langsung; tidak ada file yang akan disalin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'archivio BLOB di Ollama non è direttamente importabile; nessun file verrà copiato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OllamaのBLOBストアは直接インポートできません。ファイルはコピーされません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama의 blob 저장소는 직접 가져올 수 없습니다. 파일이 복사되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De blobopslag van Ollama kan niet direct worden geïmporteerd; er worden geen bestanden gekopieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Magazyn obiektów blob Ollama nie może być importowany bezpośrednio; żadne pliki nie zostaną skopiowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O armazenamento de blobs do Ollama não é diretamente importável; nenhum arquivo será copiado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранилище BLOB-объектов Ollama нельзя импортировать напрямую; файлы копироваться не будут."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollamas bloblagring kan inte importeras direkt; inga filer kommer att kopieras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama'nın blob deposu doğrudan içe aktarılamaz; hiçbir dosya kopyalanmayacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сховище BLOB-об'єктів Ollama не можна імпортувати безпосередньо; жодні файли не будуть скопійовані."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kho lưu trữ blob của Ollama không thể nhập trực tiếp; sẽ không có tệp nào được sao chép."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 的 Blob 存储不可直接导入；不会复制任何文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama 的 Blob 存放區無法直接匯入；不會複製任何檔案。"
          }
        }
      }
    },
    "Only the Default user exists. Add one below to give it its own settings, chats, and skills.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد سوى المستخدم الافتراضي. أضف مستخدما أدناه ليحصل على إعداداته ومحادثاته ومهاراته الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es existiert nur der Standardbenutzer. Fügen Sie unten einen hinzu, um ihm eigene Einstellungen, Chats und Skills zu geben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the Default user exists. Add one below to give it its own settings, chats, and skills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo existe el usuario predeterminado. Añade uno abajo para darle sus propios ajustes, chats y habilidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l'utilisateur par défaut existe. Ajoutez-en un ci-dessous pour lui donner ses propres réglages, discussions et compétences."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיים רק משתמש ברירת המחדל. הוסף משתמש למטה כדי שיהיו לו הגדרות, שיחות ומיומנויות משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल डिफ़ॉल्ट उपयोगकर्ता मौजूद है। नीचे एक जोड़ें ताकि उसे अपनी सेटिंग्स, चैट और स्किल मिल सकें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pengguna Default yang ada. Tambahkan satu di bawah agar memiliki pengaturan, obrolan, dan keterampilan sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste solo l'utente predefinito. Aggiungine uno qui sotto per dargli impostazioni, chat e competenze proprie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定のユーザーしか存在しません。独自の設定、チャット、スキルを持たせるには、下から追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 사용자만 있습니다. 아래에서 사용자를 추가하면 자체 설정, 대화, 스킬을 갖게 됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de standaardgebruiker bestaat. Voeg er hieronder een toe om die eigen instellingen, chats en skills te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istnieje tylko użytkownik domyślny. Dodaj poniżej kolejnego, aby miał własne ustawienia, czaty i umiejętności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe apenas o usuário padrão. Adicione um abaixo para dar a ele configurações, chats e habilidades próprios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существует только пользователь по умолчанию. Добавьте пользователя ниже, чтобы у него были свои настройки, чаты и навыки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast standardanvändaren finns. Lägg till en nedan för att ge den egna inställningar, chattar och färdigheter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca varsayılan kullanıcı var. Kendi ayarları, sohbetleri ve becerileri olması için aşağıdan bir kullanıcı ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Існує лише типовий користувач. Додайте нижче ще одного, щоб він мав власні налаштування, чати й навички."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có người dùng mặc định. Thêm một người dùng bên dưới để họ có cài đặt, cuộc trò chuyện và kỹ năng riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有默认用户。在下方添加一个用户，即可让其拥有独立的设置、对话和技能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有預設使用者。在下方新增一個使用者，即可讓其擁有獨立的設定、對話與技能。"
          }
        }
      }
    },
