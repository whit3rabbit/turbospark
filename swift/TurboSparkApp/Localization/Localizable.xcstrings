          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0446\u0432\u0435\u0442\u043e\u043c \u0438\u043b\u0438 \u043c\u0430\u0440\u043a\u0435\u0440\u0430\u043c\u0438 +/-"
