    "Audio samples or their format are invalid. Choose another audio file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio samples or their format are invalid. Choose another audio file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las muestras de audio o su formato no son v\u00e1lidos. Elige otro archivo de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les \u00e9chantillons audio ou leur format sont invalides. Choisissez un autre fichier audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiosamples oder ihr Format sind ung\u00fcltig. W\u00e4hle eine andere Audiodatei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I campioni audio o il loro formato non sono validi. Scegli un altro file audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As amostras de \u00e1udio ou seu formato s\u00e3o inv\u00e1lidos. Escolha outro arquivo de \u00e1udio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audiosamples of hun formaat zijn ongeldig. Kies een ander audiobestand."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudsamplen eller deras format \u00e4r ogiltiga. V\u00e4lj en annan ljudfil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00f3bki audio lub ich format s\u0105 nieprawid\u0142owe. Wybierz inny plik audio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses \u00f6rnekleri veya bi\u00e7imleri ge\u00e7ersiz. Ba\u015fka bir ses dosyas\u0131 se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampel audio atau formatnya tidak valid. Pilih berkas audio lain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0434\u0438\u043e\u0441\u044d\u043c\u043f\u043b\u044b \u0438\u043b\u0438 \u0438\u0445 \u0444\u043e\u0440\u043c\u0430\u0442 \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0439 \u0430\u0443\u0434\u0438\u043e\u0444\u0430\u0439\u043b."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0434\u0456\u043e\u0441\u0435\u043c\u043f\u043b\u0438 \u0430\u0431\u043e \u0457\u0445\u043d\u0456\u0439 \u0444\u043e\u0440\u043c\u0430\u0442 \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u0456. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0456\u043d\u0448\u0438\u0439 \u0430\u0443\u0434\u0456\u043e\u0444\u0430\u0439\u043b."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c m\u1eabu \u00e2m thanh ho\u1eb7c \u0111\u1ecbnh d\u1ea1ng kh\u00f4ng h\u1ee3p l\u1ec7. Ch\u1ecdn t\u1ec7p \u00e2m thanh kh\u00e1c."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u58f0\u30b5\u30f3\u30d7\u30eb\u307e\u305f\u306f\u5f62\u5f0f\u304c\u7121\u52b9\u3067\u3059\u3002\u5225\u306e\u97f3\u58f0\u30d5\u30a1\u30a4\u30eb\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub514\uc624 \uc0d8\ud50c \ub610\ub294 \ud615\uc2dd\uc774 \uc62c\ubc14\ub974\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \uc624\ub514\uc624 \ud30c\uc77c\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u9891\u91c7\u6837\u6216\u683c\u5f0f\u65e0\u6548\u3002\u8bf7\u9009\u62e9\u5176\u4ed6\u97f3\u9891\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u8a0a\u53d6\u6a23\u6216\u683c\u5f0f\u7121\u6548\u3002\u8acb\u9078\u64c7\u5176\u4ed6\u97f3\u8a0a\u6a94\u6848\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u064a\u0646\u0627\u062a \u0627\u0644\u0635\u0648\u062a \u0623\u0648 \u062a\u0646\u0633\u064a\u0642\u0647\u0627 \u063a\u064a\u0631 \u0635\u0627\u0644\u062d. \u0627\u062e\u062a\u0631 \u0645\u0644\u0641\u0627\u064b \u0635\u0648\u062a\u064a\u0627\u064b \u0622\u062e\u0631."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d3\u05d2\u05d9\u05de\u05d5\u05ea \u05d4\u05e9\u05de\u05e2 \u05d0\u05d5 \u05d4\u05e4\u05d5\u05e8\u05de\u05d8 \u05e9\u05dc\u05d4\u05df \u05d0\u05d9\u05e0\u05dd \u05ea\u05e7\u05d9\u05e0\u05d9\u05dd. \u05d1\u05d7\u05e8 \u05e7\u05d5\u05d1\u05e5 \u05e9\u05de\u05e2 \u05d0\u05d7\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0911\u0921\u093f\u092f\u094b \u0938\u0948\u0902\u092a\u0932 \u092f\u093e \u0909\u0928\u0915\u093e \u092b\u093c\u0949\u0930\u094d\u092e\u0948\u091f \u0905\u092e\u093e\u0928\u094d\u092f \u0939\u0948\u0964 \u0926\u0942\u0938\u0930\u0940 \u0911\u0921\u093f\u092f\u094b \u092b\u093c\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "Choose a checkpoint folder for the selected audio model.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a checkpoint folder for the selected audio model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una carpeta de pesos para el modelo de audio seleccionado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de poids pour le mod\u00e8le audio s\u00e9lectionn\u00e9."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle einen Checkpoint-Ordner f\u00fcr das ausgew\u00e4hlte Audiomodell."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella dei pesi per il modello audio selezionato."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta de pesos para o modelo de \u00e1udio selecionado."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een checkpointmap voor het geselecteerde audiomodel."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en mapp med modellvikter f\u00f6r den valda ljudmodellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder wag dla wybranego modelu audio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00e7ilen ses modeli i\u00e7in bir model a\u011f\u0131rl\u0131klar\u0131 klas\u00f6r\u00fc se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder bobot untuk model audio yang dipilih."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0430\u043f\u043a\u0443 \u0432\u0435\u0441\u043e\u0432 \u0434\u043b\u044f \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0439 \u0430\u0443\u0434\u0438\u043e\u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0430\u043f\u043a\u0443 \u0432\u0430\u0433 \u0434\u043b\u044f \u0432\u0438\u0431\u0440\u0430\u043d\u043e\u0457 \u0430\u0443\u0434\u0456\u043e\u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn th\u01b0 m\u1ee5c tr\u1ecdng s\u1ed1 cho m\u00f4 h\u00ecnh \u00e2m thanh \u0111\u00e3 ch\u1ecdn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u3057\u305f\u97f3\u58f0\u30e2\u30c7\u30eb\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u30d5\u30a9\u30eb\u30c0\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\ud55c \uc624\ub514\uc624 \ubaa8\ub378\uc758 \uccb4\ud06c\ud3ec\uc778\ud2b8 \ud3f4\ub354\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u6240\u9009\u97f3\u9891\u6a21\u578b\u9009\u62e9\u68c0\u67e5\u70b9\u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u6240\u9078\u97f3\u8a0a\u6a21\u578b\u9078\u64c7\u6aa2\u67e5\u9ede\u8cc7\u6599\u593e\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0645\u062c\u0644\u062f \u0623\u0648\u0632\u0627\u0646 \u0644\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0635\u0648\u062a\u064a \u0627\u0644\u0645\u062d\u062f\u062f."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05de\u05e9\u05e7\u05d5\u05dc\u05d5\u05ea \u05e2\u05d1\u05d5\u05e8 \u05de\u05d5\u05d3\u05dc \u05d4\u05e9\u05de\u05e2 \u05e9\u05e0\u05d1\u05d7\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0941\u0928\u0947 \u0917\u090f \u0911\u0921\u093f\u092f\u094b \u092e\u0949\u0921\u0932 \u0915\u0947 \u0932\u093f\u090f \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "Download this model or choose its checkpoint folder.": {
