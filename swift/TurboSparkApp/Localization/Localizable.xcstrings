    "Manage Model Context Protocol servers, external tools, and integrations.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u062f\u0631 \u062e\u0648\u0627\u062f\u0645 Model Context Protocol \u0648\u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0648\u0627\u0644\u062a\u0643\u0627\u0645\u0644\u0627\u062a."
