    "This checkpoint exceeds the available audio model memory budget.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062a\u062c\u0627\u0648\u0632 \u0646\u0642\u0637\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0647\u0630\u0647 \u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0637\u0631\u0627\u0632 \u0627\u0644\u0635\u0648\u062a\u064a \u0627\u0644\u0645\u062a\u0648\u0641\u0631\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Pr\u00fcfpunkt \u00fcberschreitet das verf\u00fcgbare Speicherbudget des Audiomodells."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This checkpoint exceeds the available audio model memory budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este punto de control excede el presupuesto de memoria del modelo de audio disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce point de contr\u00f4le d\u00e9passe le budget de m\u00e9moire disponible du mod\u00e8le audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05e7\u05d5\u05d3\u05ea \u05d1\u05d9\u05e7\u05d5\u05e8\u05ea \u05d6\u05d5 \u05d7\u05d5\u05e8\u05d2\u05ea \u05de\u05ea\u05e7\u05e6\u05d9\u05d1 \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d4\u05d6\u05de\u05d9\u05df \u05e9\u05dc \u05d3\u05d2\u05dd \u05d4\u05d0\u05d5\u05d3\u05d9\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0911\u0921\u093f\u092f\u094b \u092e\u0949\u0921\u0932 \u092e\u0947\u092e\u094b\u0930\u0940 \u092c\u091c\u091f \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pos pemeriksaan ini melebihi anggaran memori model audio yang tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo checkpoint supera il budget di memoria del modello audio disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u306f\u3001\u4f7f\u7528\u53ef\u80fd\u306a\u30aa\u30fc\u30c7\u30a3\u30aa \u30e2\u30c7\u30eb\u306e\u30e1\u30e2\u30ea \u30d0\u30b8\u30a7\u30c3\u30c8\u3092\u8d85\u3048\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uccb4\ud06c\ud3ec\uc778\ud2b8\ub294 \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc624\ub514\uc624 \ubaa8\ub378 \uba54\ubaa8\ub9ac \uc608\uc0b0\uc744 \ucd08\uacfc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit controlepunt overschrijdt het beschikbare geheugenbudget voor het audiomodel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten punkt kontrolny przekracza dost\u0119pny bud\u017cet pami\u0119ci modelu audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este ponto de verifica\u00e7\u00e3o excede o or\u00e7amento de mem\u00f3ria do modelo de \u00e1udio dispon\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u0430\u044f \u0442\u043e\u0447\u043a\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0439 \u0431\u044e\u0434\u0436\u0435\u0442 \u043f\u0430\u043c\u044f\u0442\u0438 \u0430\u0443\u0434\u0438\u043e\u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Denna kontrollpunkt \u00f6verskrider den tillg\u00e4ngliga minnesbudgeten f\u00f6r ljudmodeller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
