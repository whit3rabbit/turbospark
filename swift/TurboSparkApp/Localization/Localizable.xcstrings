    "Manage codebase root, agent profile, rules, and execution permissions.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u062f\u0631 \u062c\u0630\u0631 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u0641\u0631\u0629 \u0648\u0645\u0644\u0641 \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0648\u0643\u064a\u0644 \u0648\u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0648\u0623\u0630\u0648\u0646\u0627\u062a \u0627\u0644\u062a\u0646\u0641\u064a\u0630."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie das Code-Stammverzeichnis, das Agent-Profil, Regeln und Ausf\u00fchrungsberechtigungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage codebase root, agent profile, rules, and execution permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona la ra\u00edz del c\u00f3digo, el perfil del agente, las reglas y los permisos de ejecuci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e9rez la racine du code, le profil de l'agent, les r\u00e8gles et les autorisations d'ex\u00e9cution."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d4\u05dc \u05d0\u05ea \u05e9\u05d5\u05e8\u05e9 \u05d1\u05e1\u05d9\u05e1 \u05d4\u05e7\u05d5\u05d3, \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05e1\u05d5\u05db\u05df, \u05db\u05dc\u05dc\u05d9\u05dd \u05d5\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05d4\u05e8\u05e6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0921\u092c\u0947\u0938 \u0930\u0942\u091f, \u090f\u091c\u0947\u0902\u091f \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932, \u0928\u093f\u092f\u092e \u0914\u0930 \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u0928 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0902 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola root basis kode, profil agen, aturan, dan izin eksekusi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci la radice del codice, il profilo dell'agente, le regole e i permessi di esecuzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30fc\u30c9\u30d9\u30fc\u30b9\u306e\u30eb\u30fc\u30c8\u3001\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3001\u30eb\u30fc\u30eb\u3001\u5b9f\u884c\u6a29\u9650\u3092\u7ba1\u7406\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucf54\ub4dc\ubca0\uc774\uc2a4 \ub8e8\ud2b8, \uc5d0\uc774\uc804\ud2b8 \ud504\ub85c\ud544, \uaddc\uce59, \uc2e4\ud589 \uad8c\ud55c\uc744 \uad00\ub9ac\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer de hoofdmap van de codebase, het agentprofiel, regels en uitvoeringsmachtigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarz\u0105dzaj katalogiem g\u0142\u00f3wnym kodu, profilem agenta, regu\u0142ami i uprawnieniami do wykonywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie a raiz do c\u00f3digo, o perfil do agente, as regras e as permiss\u00f5es de execu\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u043a\u043e\u0440\u043d\u0435\u043c \u043a\u043e\u0434\u0430, \u043f\u0440\u043e\u0444\u0438\u043b\u0435\u043c \u0430\u0433\u0435\u043d\u0442\u0430, \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c\u0438 \u0438 \u0440\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f\u043c\u0438 \u043d\u0430 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera kodbasens rotkatalog, agentprofil, regler och k\u00f6rningsbeh\u00f6righeter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod taban\u0131 k\u00f6k\u00fcn\u00fc, arac\u0131 profilini, kurallar\u0131 ve y\u00fcr\u00fctme izinlerini y\u00f6netin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0435\u0440\u0443\u0439\u0442\u0435 \u043a\u043e\u0440\u0435\u043d\u0435\u043c \u043a\u043e\u0434\u0443, \u043f\u0440\u043e\u0444\u0456\u043b\u0435\u043c \u0430\u0433\u0435\u043d\u0442\u0430, \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c\u0438 \u0442\u0430 \u0434\u043e\u0437\u0432\u043e\u043b\u0430\u043c\u0438 \u043d\u0430 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu\u1ea3n l\u00fd th\u01b0 m\u1ee5c g\u1ed1c m\u00e3 ngu\u1ed3n, h\u1ed3 s\u01a1 t\u00e1c nh\u00e2n, quy t\u1eafc v\u00e0 quy\u1ec1n th\u1ef1c thi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ba1\u7406\u4ee3\u7801\u5e93\u6839\u76ee\u5f55\u3001\u4ee3\u7406\u914d\u7f6e\u3001\u89c4\u5219\u548c\u6267\u884c\u6743\u9650\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ba1\u7406\u7a0b\u5f0f\u78bc\u5eab\u6839\u76ee\u9304\u3001\u4ee3\u7406\u8a2d\u5b9a\u6a94\u3001\u898f\u5247\u8207\u57f7\u884c\u6b0a\u9650\u3002"
          }
        }
      }
    },
