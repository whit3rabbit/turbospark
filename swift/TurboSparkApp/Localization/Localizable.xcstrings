        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d6\u05d4\u05e8\u05d4: \u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8 \u05d7\u05d5\u05e8\u05d2 \u05de\u05d4\u05d4\u05e7\u05e9\u05e8 \u05d4\u05de\u05d0\u05d5\u05de\u05df"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0947\u0924\u093e\u0935\u0928\u0940: \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u092a\u094d\u0930\u0936\u093f\u0915\u094d\u0937\u093f\u0924 \u0938\u0902\u0926\u0930\u094d\u092d \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan: jendela konteks melebihi konteks terlatih"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviso: la finestra di contesto supera il contesto addestrato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b66\u544a: \u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u304c\u5b66\u7fd2\u6e08\u307f\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u3092\u8d85\u3048\u3066\u3044\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacbd\uace0: \ucee8\ud14d\uc2a4\ud2b8 \uc708\ub3c4\uc6b0\uac00 \ud559\uc2b5\ub41c \ucee8\ud14d\uc2a4\ud2b8\ub97c \ucd08\uacfc\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwing: het contextvenster overschrijdt de getrainde context"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostrze\u017cenie: okno kontekstu przekracza wytrenowany kontekst"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aviso: a janela de contexto excede o contexto treinado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u0443\u043f\u0440\u0435\u0436\u0434\u0435\u043d\u0438\u0435: \u043e\u043a\u043d\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430 \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u043e\u0431\u0443\u0447\u0435\u043d\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varning: kontextf\u00f6nstret \u00f6verskrider den tr\u00e4nade kontexten"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyar\u0131: Ba\u011flam penceresi e\u011fitilmi\u015f ba\u011flam\u0131 a\u015f\u0131yor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043f\u0435\u0440\u0435\u0434\u0436\u0435\u043d\u043d\u044f: \u0432\u0456\u043a\u043d\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454 \u043d\u0430\u0442\u0440\u0435\u043d\u043e\u0432\u0430\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1ea3nh b\u00e1o: c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh v\u01b0\u1ee3t qu\u00e1 ng\u1eef c\u1ea3nh \u0111\u00e3 hu\u1ea5n luy\u1ec7n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b66\u544a: \u4e0a\u4e0b\u6587\u7a97\u53e3\u8d85\u51fa\u8bad\u7ec3\u4e0a\u4e0b\u6587"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8b66\u544a: \u4e0a\u4e0b\u6587\u8996\u7a97\u8d85\u51fa\u8a13\u7df4\u4e0a\u4e0b\u6587"
          }
        }
      }
    },
    "Welcome back! What are we working on?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0631\u062d\u0628\u064b\u0627 \u0628\u0639\u0648\u062f\u062a\u0643! \u0639\u0644\u0649 \u0645\u0627\u0630\u0627 \u0646\u0639\u0645\u0644\u061f"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Willkommen zur\u00fcck! Woran arbeiten wir?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome back! What are we working on?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00a1Bienvenido de nuevo! \u00bfEn qu\u00e9 estamos trabajando?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bon retour ! Sur quoi travaillons-nous ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05e8\u05d5\u05da \u05e9\u05d5\u05d1\u05da! \u05e2\u05dc \u05de\u05d4 \u05d0\u05e0\u05d7\u05e0\u05d5 \u05e2\u05d5\u05d1\u05d3\u05d9\u05dd?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093e\u092a\u0938\u0940 \u092a\u0930 \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948! \u0939\u092e \u0915\u093f\u0938 \u092a\u0930 \u0915\u093e\u092e \u0915\u0930 \u0930\u0939\u0947 \u0939\u0948\u0902?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selamat datang kembali! Apa yang sedang kita kerjakan?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bentornato! Su cosa stiamo lavorando?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u304a\u5e30\u308a\u306a\u3055\u3044\uff01\u4f55\u306b\u53d6\u308a\u7d44\u307f\u307e\u3057\u3087\u3046\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc2dc \uc624\uc2e0 \uac83\uc744 \ud658\uc601\ud569\ub2c8\ub2e4! \uc5b4\ub5a4 \uc791\uc5c5\uc744 \uc9c4\ud589\ud560\uae4c\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom terug! Waar werken we aan?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witaj z powrotem! Nad czym pracujemy?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bem-vindo de volta! No que estamos trabalhando?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421 \u0432\u043e\u0437\u0432\u0440\u0430\u0449\u0435\u043d\u0438\u0435\u043c! \u041d\u0430\u0434 \u0447\u0435\u043c \u043c\u044b \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u043c?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lkommen tillbaka! Vad jobbar vi p\u00e5?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar ho\u015f geldiniz! Ne \u00fczerinde \u00e7al\u0131\u015f\u0131yoruz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417 \u043f\u043e\u0432\u0435\u0440\u043d\u0435\u043d\u043d\u044f\u043c! \u041d\u0430\u0434 \u0447\u0438\u043c \u043f\u0440\u0430\u0446\u044e\u0454\u043c\u043e?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
