        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043a\u0440\u0435\u043c\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f, \u0447\u0430\u0442\u0438, \u043d\u0430\u0432\u0438\u0447\u043a\u0438, \u043f\u043b\u0430\u0433\u0456\u043d\u0438 \u0439 \u0441\u0435\u0440\u0432\u0435\u0440\u0438 MCP."
          }
        },
        "vi": {
