    "No transcript yet. The model receives the transcript, not the audio.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0646\u0635 \u0645\u0641\u0631\u0651\u063a \u0628\u0639\u062f. \u064a\u062a\u0644\u0642\u0649 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u0641\u0631\u0651\u063a \u0648\u0644\u064a\u0633 \u0627\u0644\u0635\u0648\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Transkription. Das Modell erh\u00e4lt die Transkription, nicht das Audio."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No transcript yet. The model receives the transcript, not the audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan no hay transcripci\u00f3n. El modelo recibe la transcripci\u00f3n, no el audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de transcription. Le mod\u00e8le re\u00e7oit la transcription, pas l'audio."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d9\u05d9\u05df \u05ea\u05de\u05dc\u05d9\u05dc. \u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05e7\u05d1\u05dc \u05d0\u05ea \u05d4\u05ea\u05de\u05dc\u05d9\u05dc, \u05dc\u05d0 \u05d0\u05ea \u05d4\u05e9\u05de\u05e2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0915\u094b\u0908 \u091f\u094d\u0930\u093e\u0902\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u092e\u0949\u0921\u0932 \u0915\u094b \u0911\u0921\u093f\u092f\u094b \u0928\u0939\u0940\u0902, \u091f\u094d\u0930\u093e\u0902\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u092e\u093f\u0932\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada transkrip. Model menerima transkrip, bukan audionya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna trascrizione ancora. Il modello riceve la trascrizione, non l'audio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3060\u6587\u5b57\u8d77\u3053\u3057\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u30e2\u30c7\u30eb\u304c\u53d7\u3051\u53d6\u308b\u306e\u306f\u30aa\u30fc\u30c7\u30a3\u30aa\u3067\u306f\u306a\u304f\u6587\u5b57\u8d77\u3053\u3057\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc9c1 \ud14d\uc2a4\ud2b8 \ubcc0\ud658 \uacb0\uacfc\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \ubaa8\ub378\uc740 \uc624\ub514\uc624\uac00 \uc544\ub2cc \ubcc0\ud658\ub41c \ud14d\uc2a4\ud2b8\ub97c \ubc1b\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen transcriptie. Het model ontvangt de transcriptie, niet de audio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak transkrypcji. Model otrzymuje transkrypcj\u0119, a nie d\u017awi\u0119k."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda n\u00e3o h\u00e1 transcri\u00e7\u00e3o. O modelo recebe a transcri\u00e7\u00e3o, n\u00e3o o \u00e1udio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438 \u043f\u043e\u043a\u0430 \u043d\u0435\u0442. \u041c\u043e\u0434\u0435\u043b\u044c \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443, \u0430 \u043d\u0435 \u0430\u0443\u0434\u0438\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen transkription \u00e4nnu. Modellen f\u00e5r transkriptionen, inte ljudet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hen\u00fcz d\u00f6k\u00fcm yok. Model sesi de\u011fil, d\u00f6k\u00fcm\u00fc al\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438 \u0449\u0435 \u043d\u0435\u043c\u0430\u0454. \u041c\u043e\u0434\u0435\u043b\u044c \u043e\u0442\u0440\u0438\u043c\u0443\u0454 \u0440\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443, \u0430 \u043d\u0435 \u0430\u0443\u0434\u0456\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00f3 b\u1ea3n ch\u00e9p l\u1eddi. M\u00f4 h\u00ecnh nh\u1eadn b\u1ea3n ch\u00e9p l\u1eddi, kh\u00f4ng ph\u1ea3i \u00e2m thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u65e0\u8f6c\u5199\u6587\u672c\u3002\u6a21\u578b\u63a5\u6536\u7684\u662f\u8f6c\u5199\u6587\u672c\uff0c\u800c\u4e0d\u662f\u97f3\u9891\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u7121\u8f49\u5beb\u6587\u5b57\u3002\u6a21\u578b\u63a5\u6536\u7684\u662f\u8f49\u5beb\u6587\u5b57\uff0c\u800c\u4e0d\u662f\u97f3\u8a0a\u3002"
          }
        }
      }
    },
