            "value": "Automatycznie (silnik, potem Apple na urz\u0105dzeniu)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autom\u00e1tico (mecanismo, depois Apple no dispositivo)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438 (\u0434\u0432\u0438\u0436\u043e\u043a, \u0437\u0430\u0442\u0435\u043c Apple \u043d\u0430 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0435)"
