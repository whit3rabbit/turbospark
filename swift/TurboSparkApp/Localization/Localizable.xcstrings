    "Access is optional. Without it you can still import, transcribe, and edit audio files.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access is optional. Without it you can still import, transcribe, and edit audio files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El acceso es opcional. Sin él, puedes importar, transcribir y editar archivos de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accès est facultatif. Sans lui, vous pouvez toujours importer, transcrire et modifier des fichiers audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Zugriff ist optional. Ohne ihn kannst du weiterhin Audiodateien importieren, transkribieren und bearbeiten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso è facoltativo. Senza di esso puoi comunque importare, trascrivere e modificare file audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O acesso é opcional. Sem ele, você ainda pode importar, transcrever e editar arquivos de áudio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ необязателен. Без него вы по-прежнему можете импортировать, расшифровывать и редактировать аудиофайлы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクセスは任意です。許可しなくても、音声ファイルの読み込み、文字起こし、編集はできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "접근 허용은 선택 사항입니다. 허용하지 않아도 오디오 파일을 가져오고, 텍스트로 변환하고, 편집할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "访问权限是可选的。即使不授予，您仍可导入、转录和编辑音频文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "存取權是選用的。即使不授予，您仍可匯入、轉錄和編輯音訊檔案。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الوصول اختياري. بدونه يمكنك مع ذلك استيراد الملفات الصوتية وتفريغها وتحريرها."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הגישה היא אופציונלית. גם בלעדיה ניתן לייבא, לתמלל ולערוך קובצי שמע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सेस वैकल्पिक है। इसके बिना भी आप ऑडियो फ़ाइलें इम्पोर्ट, ट्रांसक्राइब और संपादित कर सकते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toegang is optioneel. Zonder toegang kun je nog steeds audiobestanden importeren, transcriberen en bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostęp jest opcjonalny. Bez niego nadal możesz importować, transkrybować i edytować pliki audio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Erişim isteğe bağlıdır. Erişim olmadan da ses dosyalarını içe aktarabilir, yazıya dökebilir ve düzenleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ необов’язковий. Без нього ви все одно можете імпортувати, розшифровувати й редагувати аудіофайли."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Åtkomst är valfri. Utan den kan du fortfarande importera, transkribera och redigera ljudfiler."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập là tùy chọn. Không có quyền này, bạn vẫn có thể nhập, chép lời và chỉnh sửa tệp âm thanh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Akses bersifat opsional. Tanpa akses, Anda tetap dapat mengimpor, mentranskripsikan, dan mengedit file audio."
          }
        }
      }
    },
