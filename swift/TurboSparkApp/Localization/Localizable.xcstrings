    "The files stay on disk at %@. You can restore it under Settings > Models & Storage.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0628\u0642\u0649 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0635 \u0641\u064a %@. \u064a\u0645\u0643\u0646\u0643 \u0627\u0633\u062a\u0639\u0627\u062f\u062a\u0647 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a > \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0648\u0627\u0644\u062a\u062e\u0632\u064a\u0646."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien bleiben unter %@ auf der Festplatte. Du kannst das Modell unter Einstellungen > Modelle & Speicher wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files stay on disk at %@. You can restore it under Settings > Models & Storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos permanecen en el disco en %@. Puedes restaurarlo en Ajustes > Modelos y almacenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers restent sur le disque dans %@. Vous pouvez le restaurer dans R\u00e9glages > Mod\u00e8les et stockage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e7\u05d1\u05e6\u05d9\u05dd \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd \u05d1\u05d3\u05d9\u05e1\u05e7 \u05d1-%@. \u05d0\u05e4\u05e9\u05e8 \u05dc\u05e9\u05d7\u05d6\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea > \u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05d5\u05d0\u05d7\u05e1\u05d5\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0921\u093f\u0938\u094d\u0915 \u092a\u0930 %@ \u092e\u0947\u0902 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964 \u0906\u092a \u0907\u0938\u0947 \u0938\u0947\u091f\u093f\u0902\u0917 > \u092e\u0949\u0921\u0932 \u0914\u0930 \u0938\u094d\u091f\u094b\u0930\u0947\u091c \u092e\u0947\u0902 \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tetap berada di disk di %@. Anda dapat memulihkannya di Pengaturan > Model & Penyimpanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file restano sul disco in %@. Puoi ripristinarlo in Impostazioni > Modelli e archiviazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30a4\u30eb\u306f %@ \u306e\u30c7\u30a3\u30b9\u30af\u4e0a\u306b\u6b8b\u308a\u307e\u3059\u3002\u300c\u8a2d\u5b9a\u300d>\u300c\u30e2\u30c7\u30eb\u3068\u30b9\u30c8\u30ec\u30fc\u30b8\u300d\u3067\u5fa9\u5143\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud30c\uc77c\uc740 %@ \ub514\uc2a4\ud06c\uc5d0 \ub0a8\uc544 \uc788\uc2b5\ub2c8\ub2e4. \uc124\uc815 > \ubaa8\ub378 \ubc0f \uc800\uc7a5 \uacf5\uac04\uc5d0\uc11c \ubcf5\uc6d0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bestanden blijven op schijf in %@. Je kunt het herstellen via Instellingen > Modellen en opslag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki pozostaj\u0105 na dysku w %@. Mo\u017cesz go przywr\u00f3ci\u0107 w Ustawienia > Modele i pami\u0119\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos continuam no disco em %@. Voc\u00ea pode restaur\u00e1-lo em Ajustes > Modelos e armazenamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b\u044b \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u043d\u0430 \u0434\u0438\u0441\u043a\u0435 \u0432 %@. \u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c \u043c\u043e\u0436\u043d\u043e \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u00bb > \u00ab\u041c\u043e\u0434\u0435\u043b\u0438 \u0438 \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435\u00bb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filerna finns kvar p\u00e5 disken i %@. Du kan \u00e5terst\u00e4lla den under Inst\u00e4llningar > Modeller och lagring."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosyalar diskte %@ konumunda kal\u0131r. Ayarlar > Modeller ve Depolama\u2019dan geri y\u00fckleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0434\u0438\u0441\u043a\u0443 \u0432 %@. \u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u043c\u043e\u0434\u0435\u043b\u044c \u043c\u043e\u0436\u043d\u0430 \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u00bb > \u00ab\u041c\u043e\u0434\u0435\u043b\u0456 \u0442\u0430 \u0441\u0445\u043e\u0432\u0438\u0449\u0435\u00bb."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c t\u1ec7p v\u1eabn n\u1eb1m tr\u00ean \u1ed5 \u0111\u0129a t\u1ea1i %@. B\u1ea1n c\u00f3 th\u1ec3 kh\u00f4i ph\u1ee5c trong C\u00e0i \u0111\u1eb7t > M\u00f4 h\u00ecnh v\u00e0 l\u01b0u tr\u1eef."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6587\u4ef6\u4ecd\u4fdd\u7559\u5728\u78c1\u76d8\u4e0a\u7684 %@\u3002\u53ef\u5728\u201c\u8bbe\u7f6e\u201d>\u201c\u6a21\u578b\u4e0e\u5b58\u50a8\u201d\u4e2d\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6a94\u6848\u4ecd\u4fdd\u7559\u5728\u78c1\u789f\u4e0a\u7684 %@\u3002\u53ef\u5728\u300c\u8a2d\u5b9a\u300d>\u300c\u6a21\u578b\u8207\u5132\u5b58\u7a7a\u9593\u300d\u4e2d\u9084\u539f\u3002"
          }
        }
      }
    },
