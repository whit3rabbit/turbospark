        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0431\u043e\u0447\u043d\u0430\u044f \u0437\u0430\u0434\u0430\u0447\u0430 %@ \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u0430 \u0432 \u0444\u043e\u043d\u0435."
