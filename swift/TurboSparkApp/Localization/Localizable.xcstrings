          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9e7\uace0 \uc9d1\uc911\ub41c \uc0ac\uace0"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort, gericht nadenken"
          }
        },
        "pl": {
