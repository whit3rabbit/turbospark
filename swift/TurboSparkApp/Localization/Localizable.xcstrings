    "\"%@\" and its conversation history will be removed.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة \"%@\" وسجل المحادثة الخاص به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ und sein Konversationsverlauf werden entfernt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" and its conversation history will be removed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se eliminarán \"%@\" y su historial de conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » et son historique de conversation seront supprimés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" והיסטוריית השיחות שלו יוסרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" और इसका बातचीत इतिहास हटा दिया जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" dan riwayat percakapannya akan dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" e la relativa cronologia della conversazione verranno rimossi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」とその会話履歴が削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" 및 대화 기록이 삭제됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" en de bijbehorende gespreksgeschiedenis worden verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Element „%@” i jego historia konwersacji zostaną usunięte."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" e o histórico de conversas serão removidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» и история этого диалога будут удалены."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" och dess konversationshistorik tas bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" ve konuşma geçmişi kaldırılacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«%@» та історія цієї розмови будуть видалені."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" và lịch sử trò chuyện của nó sẽ bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@”及其对话历史记录将被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」及其對話歷史記錄將被刪除。"
          }
        }
      }
    },
    "\"Default\" is reserved for the built-in user.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" محجوز للمستخدم المدمج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" ist für den integrierten Benutzer reserviert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" is reserved for the built-in user."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" está reservado para el usuario integrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" est réservé à l'utilisateur intégré."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" שמור למשתמש המובנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" अंतर्निहित उपयोगकर्ता के लिए आरक्षित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" dicadangkan untuk pengguna bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" è riservato all'utente integrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\"は組み込みユーザー用に予約されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\"는 기본 제공 사용자용으로 예약되어 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" is gereserveerd voor de ingebouwde gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwa \"Default\" jest zarezerwowana dla wbudowanego użytkownika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" é reservado para o usuário integrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Имя \"Default\" зарезервировано для встроенного пользователя."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" är reserverat för den inbyggda användaren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" yerleşik kullanıcı için ayrılmıştır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Назву \"Default\" зарезервовано для вбудованого користувача."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\" được dành riêng cho người dùng tích hợp sẵn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\"为内置用户保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\"Default\"保留給內建使用者。"
          }
        }
      }
    },
