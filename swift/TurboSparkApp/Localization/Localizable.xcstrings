        }
      }
    },
    "One audio model stays loaded at a time. Loading another unloads it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى نموذج صوت واحد فقط محمَّلًا في كل مرة. تحميل نموذج آخر يلغي تحميله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es bleibt immer nur ein Audiomodell geladen. Wird ein anderes geladen, wird es entladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One audio model stays loaded at a time. Loading another unloads it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se mantiene cargado un modelo de audio a la vez. Al cargar otro, se descarga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul modèle audio reste chargé à la fois. En charger un autre le décharge."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק מודל שמע אחד נשאר טעון בכל פעם. טעינת מודל אחר פורקת אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक समय में एक ही ऑडियो मॉडल लोड रहता है। दूसरा लोड करने पर यह अनलोड हो जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya satu model audio yang tetap dimuat dalam satu waktu. Memuat yang lain akan membongkarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Resta caricato un solo modello audio alla volta. Caricarne un altro lo scarica."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み込んでおけるオーディオモデルは一度に1つです。別のモデルを読み込むと、今のモデルはアンロードされます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 모델은 한 번에 하나만 로드됩니다. 다른 모델을 로드하면 기존 모델이 언로드됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er blijft steeds één audiomodel geladen. Een ander laden ontlaadt het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naraz pozostaje wczytany tylko jeden model audio. Wczytanie innego go wyładowuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só um modelo de áudio fica carregado por vez. Carregar outro o descarrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одновременно загружена только одна аудиомодель. Загрузка другой выгружает её."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bara en ljudmodell är inläst åt gången. Att läsa in en annan laddar ur den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda yalnızca bir ses modeli yüklü kalır. Başkasını yüklemek onu boşaltır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одночасно завантажена лише одна аудіомодель. Завантаження іншої вивантажує її."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi lúc chỉ một mô hình âm thanh được tải. Tải mô hình khác sẽ dỡ bỏ mô hình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一时间只保留一个已加载的音频模型。加载另一个会卸载它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一時間只保留一個已載入的音訊模型。載入另一個會卸載它。"
          }
        }
      }
    },
