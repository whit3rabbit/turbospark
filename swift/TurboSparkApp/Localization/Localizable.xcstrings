    "Live text streams English only. Other languages show a draft every 15 seconds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل النص المباشر بالإنجليزية فقط. تعرض اللغات الأخرى مسودة كل 15 ثانية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Text gibt es nur auf Englisch. Andere Sprachen zeigen alle 15 Sekunden einen Entwurf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live text streams English only. Other languages show a draft every 15 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto en directo solo funciona en inglés. Otros idiomas muestran un borrador cada 15 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte en direct ne fonctionne qu'en anglais. Les autres langues affichent un brouillon toutes les 15 secondes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט חי זמין באנגלית בלבד. בשפות אחרות מוצגת טיוטה כל 15 שניות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइव टेक्स्ट केवल अंग्रेज़ी में चलता है। अन्य भाषाओं में हर 15 सेकंड में ड्राफ़्ट दिखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks langsung hanya untuk bahasa Inggris. Bahasa lain menampilkan draf setiap 15 detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo in diretta funziona solo in inglese. Le altre lingue mostrano una bozza ogni 15 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブテキストは英語のみ対応しています。他の言語では15秒ごとに下書きが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실시간 텍스트는 영어만 지원합니다. 다른 언어는 15초마다 초안이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live tekst werkt alleen in het Engels. Andere talen tonen elke 15 seconden een concept."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst na żywo działa tylko po angielsku. Inne języki pokazują wersję roboczą co 15 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto ao vivo funciona só em inglês. Outros idiomas mostram um rascunho a cada 15 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст в реальном времени работает только на английском. Для других языков черновик показывается каждые 15 секунд."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Livetext fungerar bara på engelska. Andra språk visar ett utkast var 15:e sekund."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canlı metin yalnızca İngilizce çalışır. Diğer diller her 15 saniyede bir taslak gösterir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Текст наживо працює лише англійською. Для інших мов чернетка з'являється кожні 15 секунд."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản trực tiếp chỉ hỗ trợ tiếng Anh. Các ngôn ngữ khác hiển thị bản nháp mỗi 15 giây."
          }
        },
        "zh-Hans": {
