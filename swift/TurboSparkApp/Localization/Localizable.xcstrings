        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini memilih suaranya sendiri. Untuk berbicara dengan suara pilihan Anda, gunakan Kloning Suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello sceglie la voce da solo. Per parlare con una voce a tua scelta, usa Clonazione vocale."
