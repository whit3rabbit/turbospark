            "state": "translated",
            "value": "\u05dc\u05d3\u05d5\u05d2\u05de\u05d4: \u05d2\u05e8\u05e3 \u05d9\u05d3\u05e2 \u05d5\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e1\u05de\u05dc\u05d9\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0926\u093e. \u0928\u0949\u0932\u0947\u091c \u0917\u094d\u0930\u093e\u092b\u093c \u0914\u0930 \u0938\u093f\u0902\u092c\u0932 \u0916\u094b\u091c"
