        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memuat instruksi langsung AGENTS.md atau CLAUDE.md dari root repositori."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica le istruzioni live di AGENTS.md o CLAUDE.md dalla radice del repository."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リポジトリのルートからライブの AGENTS.md または CLAUDE.md の指示を読み込みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소 루트에서 실시간 AGENTS.md 또는 CLAUDE.md 지침을 로드합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laadt live AGENTS.md- of CLAUDE.md-instructies vanuit de hoofdmap van de repository."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ładuje instrukcje na żywo z plików AGENTS.md lub CLAUDE.md z katalogu głównego repozytorium."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carrega instruções dinâmicas do AGENTS.md ou CLAUDE.md da raiz do repositório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загружает актуальные инструкции AGENTS.md или CLAUDE.md из корня репозитория."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Läser in aktiva AGENTS.md- eller CLAUDE.md-instruktioner från lagringsplatsens rot."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depo kök dizininden canlı AGENTS.md veya CLAUDE.md talimatlarını yükler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завантажує актуальні інструкції AGENTS.md або CLAUDE.md з кореня репозиторію."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tải hướng dẫn trực tiếp của AGENTS.md hoặc CLAUDE.md từ thư mục gốc của kho lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从仓库根目录加载实时 AGENTS.md 或 CLAUDE.md 指令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從儲存庫根目錄載入即時 AGENTS.md 或 CLAUDE.md 指示。"
          }
        }
      }
    },
    "Loads the model into memory and opens chat": {
