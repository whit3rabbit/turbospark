    "No goal set. Use /goal <condition> to set one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u062a\u0639\u064a\u064a\u0646 \u0647\u062f\u0641. \u0627\u0633\u062a\u062e\u062f\u0645 /goal <condition> \u0644\u062a\u0639\u064a\u064a\u0646 \u0647\u062f\u0641."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Ziel festgelegt. Verwenden Sie /goal <condition>, um eines festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No goal set. Use /goal <condition> to set one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ning\u00fan objetivo establecido. Usa /goal <condition> para establecer uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun objectif d\u00e9fini. Utilisez /goal <condition> pour en d\u00e9finir un."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05d4\u05d5\u05d2\u05d3\u05e8\u05d4 \u05de\u05d8\u05e8\u05d4. \u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-/goal <condition> \u05db\u05d3\u05d9 \u05dc\u05d4\u05d2\u05d3\u05d9\u05e8 \u05de\u05d8\u05e8\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0932\u0915\u094d\u0937\u094d\u092f \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0932\u0915\u094d\u0937\u094d\u092f \u0938\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f /goal <condition> \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada tujuan yang ditetapkan. Gunakan /goal <condition> untuk menetapkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun obiettivo impostato. Usa /goal <condition> per impostarne uno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b4\u30fc\u30eb\u304c\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u8a2d\u5b9a\u3059\u308b\u306b\u306f /goal <condition> \u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uc815\ub41c \ubaa9\ud45c\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. /goal <condition>\uc73c\ub85c \ubaa9\ud45c\ub97c \uc124\uc815\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen doel ingesteld. Gebruik /goal <condition> om er een in te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono celu. U\u017cyj /goal <condition>, aby go ustawi\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma meta definida. Use /goal <condition> para definir uma."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u043b\u044c \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u0430. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 /goal <condition>, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u0434\u0430\u0442\u044c \u0435\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget m\u00e5l angivet. Anv\u00e4nd /goal <condition> f\u00f6r att ange ett."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef belirlenmedi. Bir hedef belirlemek i\u00e7in /goal <condition> kullan\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u0435\u0442\u0443 \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u043e. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435 /goal <condition>, \u0449\u043e\u0431 \u0457\u0457 \u0437\u0430\u0434\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a \u0111\u1eb7t m\u1ee5c ti\u00eau. D\u00f9ng /goal <condition> \u0111\u1ec3 \u0111\u1eb7t m\u1ee5c ti\u00eau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u8bbe\u7f6e\u76ee\u6807\u3002\u4f7f\u7528 /goal <condition> \u8bbe\u7f6e\u76ee\u6807\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u8a2d\u5b9a\u76ee\u6a19\u3002\u4f7f\u7528 /goal <condition> \u8a2d\u5b9a\u76ee\u6a19\u3002"
          }
        }
      }
    },
