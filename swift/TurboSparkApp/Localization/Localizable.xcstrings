    "What is on your mind today?": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0627 \u0627\u0644\u0630\u064a \u064a\u062f\u0648\u0631 \u0641\u064a \u0630\u0647\u0646\u0643 \u0627\u0644\u064a\u0648\u0645\u061f"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was besch\u00e4ftigt Sie heute?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What is on your mind today?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00bfEn qu\u00e9 est\u00e1s pensando hoy?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c0 quoi pensez-vous aujourd'hui ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05dc \u05de\u05d4 \u05d0\u05ea\u05d4 \u05d7\u05d5\u05e9\u05d1 \u05d4\u05d9\u05d5\u05dd?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u091c \u0906\u092a\u0915\u0947 \u092e\u0928 \u092e\u0947\u0902 \u0915\u094d\u092f\u093e \u0939\u0948?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apa yang ada di pikiran Anda hari ini?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A cosa stai pensando oggi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eca\u65e5\u306e\u3054\u7528\u4ef6\u306f\u4f55\u3067\u3059\u304b\uff1f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub298 \uc5b4\ub5a4 \uc0dd\uac01\uc774 \uc788\uc73c\uc2e0\uac00\uc694?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat houdt je vandaag bezig?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "O czym my\u015blisz dzisiaj?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que est\u00e1 pensando hoje?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e \u0447\u0435\u043c \u0432\u044b \u0434\u0443\u043c\u0430\u0435\u0442\u0435 \u0441\u0435\u0433\u043e\u0434\u043d\u044f?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad har du p\u00e5 hj\u00e4rtat idag?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bug\u00fcn akl\u0131n\u0131zda ne var?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0429\u043e \u0443 \u0432\u0430\u0441 \u043d\u0430 \u0434\u0443\u043c\u0446\u0456 \u0441\u044c\u043e\u0433\u043e\u0434\u043d\u0456?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00f4m nay b\u1ea1n \u0111ang suy ngh\u0129 \u0111i\u1ec1u g\u00ec?"
