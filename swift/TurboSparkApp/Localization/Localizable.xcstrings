        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la connessione e rileva gli strumenti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a5\u7d9a\u3092\u30c6\u30b9\u30c8\u3057\u3066\u30c4\u30fc\u30eb\u3092\u691c\u51fa"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5f0\uacb0 \ud14c\uc2a4\ud2b8 \ubc0f \ub3c4\uad6c \uac80\uc0c9"
          }
