            "state": "translated",
            "value": "\u00ab%@\u00bb \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d \u0432: %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' installerades i %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@', %@ kapsam\u0131na kuruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e \u0432: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 c\u00e0i '%@' v\u00e0o %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5c06\u201c%@\u201d\u5b89\u88c5\u5230%@\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
