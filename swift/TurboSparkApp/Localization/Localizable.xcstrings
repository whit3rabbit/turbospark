    "Each line must appear in the rewrite exactly as written. Missing terms are flagged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each line must appear in the rewrite exactly as written. Missing terms are flagged."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يظهر كل سطر في إعادة الصياغة كما كُتب تمامًا. يُشار إلى المصطلحات المفقودة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile muss genau so in der Umschreibung vorkommen. Fehlende Begriffe werden markiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada línea debe aparecer en la reescritura tal como está escrita. Se señalan los términos que falten."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne doit figurer dans la réécriture exactement telle qu'elle est écrite. Les termes manquants sont signalés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל שורה חייבת להופיע בשכתוב בדיוק כפי שנכתבה. מונחים חסרים מסומנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पंक्ति पुनर्लेखन में ठीक वैसे ही दिखनी चाहिए जैसी लिखी है। गायब शब्दों को चिह्नित किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap baris harus muncul di hasil tulis ulang persis seperti yang ditulis. Istilah yang hilang ditandai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riga deve comparire nella riscrittura esattamente come è scritta. I termini mancanti vengono segnalati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行は書かれたとおりに書き直しに含まれている必要があります。欠けている語句は警告されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 줄은 작성된 그대로 다시 쓴 글에 있어야 합니다. 빠진 용어는 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke regel moet precies zo in de herschrijving voorkomen. Ontbrekende termen worden gemarkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wiersz musi pojawić się w przepisanym tekście dokładnie w tej postaci. Brakujące terminy są oznaczane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha deve aparecer na reescrita exatamente como foi escrita. Termos ausentes são sinalizados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая строка должна появиться в переписанном тексте точно в том виде, как написана. Пропавшие термины отмечаются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje rad måste finnas i omskrivningen exakt som den är skriven. Saknade termer flaggas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satır yeniden yazımda tam yazıldığı gibi yer almalıdır. Eksik terimler işaretlenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рядок має з'явитися в переписаному тексті точно так, як написано. Пропущені терміни позначаються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi dòng phải xuất hiện trong bản viết lại đúng như đã viết. Thuật ngữ bị thiếu sẽ được đánh dấu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一行都必须原样出现在改写结果中。缺失的词语会被标出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一行都必須原樣出現在改寫結果中。缺少的詞語會被標出。"
          }
        }
      }
    },
    "Each mode uses its own model for each job. A change applies to the next take.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستخدم كل وضع نموذجه الخاص لكل مهمة. يسري التغيير على التسجيل التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Modus nutzt für jede Aufgabe sein eigenes Modell. Eine Änderung gilt ab der nächsten Aufnahme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each mode uses its own model for each job. A change applies to the next take."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modo usa su propio modelo para cada tarea. Un cambio se aplica a la siguiente grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque mode utilise son propre modèle pour chaque tâche. Un changement s'applique au prochain enregistrement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מצב משתמש במודל משלו לכל משימה. שינוי חל מההקלטה הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर मोड हर काम के लिए अपना मॉडल इस्तेमाल करता है। बदलाव अगली रिकॉर्डिंग से लागू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap mode memakai modelnya sendiri untuk setiap tugas. Perubahan berlaku untuk rekaman berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modalità usa il proprio modello per ogni attività. Una modifica vale dalla prossima registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各モードはジョブごとに専用のモデルを使います。変更は次の録音から適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 모드는 작업마다 고유한 모델을 사용합니다. 변경 사항은 다음 녹음부터 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke modus gebruikt voor elke taak een eigen model. Een wijziging geldt vanaf de volgende opname."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy tryb używa własnego modelu do każdego zadania. Zmiana obowiązuje od następnego nagrania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modo usa seu próprio modelo para cada tarefa. Uma alteração vale para a próxima gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый режим использует свою модель для каждой задачи. Изменение применяется к следующей записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje läge använder sin egen modell för varje uppgift. En ändring gäller från nästa inspelning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her mod, her iş için kendi modelini kullanır. Değişiklik bir sonraki kayıtta geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен режим використовує власну модель для кожного завдання. Зміна діє з наступного запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi chế độ dùng mô hình riêng cho từng tác vụ. Thay đổi áp dụng từ lượt ghi tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个模式为每项任务使用各自的模型。更改从下一次录音开始生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個模式為每項工作使用各自的模型。變更從下一次錄音開始生效。"
          }
        }
      }
    },
    "Each model is opened separately and holds its own memory.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح كل نموذج على حدة ويحتفظ بذاكرته الخاصة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Modell wird separat geöffnet und belegt seinen eigenen Speicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each model is opened separately and holds its own memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modelo se abre por separado y ocupa su propia memoria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque modèle est ouvert séparément et occupe sa propre mémoire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל מודל נפתח בנפרד ומחזיק בזיכרון משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर मॉडल अलग से खोला जाता है और अपनी मेमोरी रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap model dibuka terpisah dan memakai memorinya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni modello viene aperto separatamente e occupa la propria memoria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各モデルは個別に開かれ、それぞれ独自のメモリを保持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 모델은 개별적으로 열리며 자체 메모리를 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk model wordt afzonderlijk geopend en gebruikt eigen geheugen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy model jest otwierany osobno i zajmuje własną pamięć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada modelo é aberto separadamente e ocupa a própria memória."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая модель открывается отдельно и занимает собственную память."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje modell öppnas separat och har eget minne."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her model ayrı açılır ve kendi belleğini tutar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна модель відкривається окремо й займає власну пам'ять."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi mô hình được mở riêng và chiếm bộ nhớ riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个模型都单独打开，并占用各自的内存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個模型都單獨開啟，並占用各自的記憶體。"
          }
        }
      }
    },
    "Each profile is a folder under Application Support. Switching saves all work and relaunches the app; the Default profile keeps using the shared ~/.turbospark folders, and every other profile is self-contained. Downloaded models are shared by all profiles.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ملف شخصي عبارة عن مجلد ضمن Application Support. يؤدي التبديل إلى حفظ كل العمل وإعادة تشغيل التطبيق؛ يستمر الملف الشخصي الافتراضي في استخدام مجلدات ~/.turbospark المشتركة، وكل ملف شخصي آخر مستقل بذاته. النماذج التي تم تنزيلها مشتركة بين جميع الملفات الشخصية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Profil ist ein Ordner unter Application Support. Das Wechseln speichert alle Arbeiten und startet die App neu; das Standardprofil verwendet weiterhin die geteilten ~/.turbospark-Ordner, und jedes andere Profil ist in sich abgeschlossen. Heruntergeladene Modelle werden von allen Profilen geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each profile is a folder under Application Support. Switching saves all work and relaunches the app; the Default profile keeps using the shared ~/.turbospark folders, and every other profile is self-contained. Downloaded models are shared by all profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil es una carpeta dentro de Application Support. Cambiar de perfil guarda todo el trabajo y reinicia la app; el perfil predeterminado sigue usando las carpetas compartidas de ~/.turbospark y los demás perfiles son independientes. Los modelos descargados se comparten entre todos los perfiles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil est un dossier dans Application Support. Changer de profil enregistre tout le travail et redémarre l'app ; le profil par défaut continue d'utiliser les dossiers partagés ~/.turbospark, et chaque autre profil est autonome. Les modèles téléchargés sont partagés par tous les profils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל פרופיל הוא תיקייה תחת Application Support. החלפה שומרת את כל העבודה ומפעילה מחדש את האפליקציה; פרופיל ברירת המחדל ממשיך להשתמש בתיקיות ~/.turbospark המשותפות, וכל פרופיל אחר עצמאי. מודלים שהורדו משותפים לכל הפרופילים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर प्रोफ़ाइल Application Support के अंदर एक फ़ोल्डर है। बदलने से सारा काम सहेजा जाता है और ऐप दोबारा लॉन्च होता है; डिफ़ॉल्ट प्रोफ़ाइल साझा ~/.turbospark फ़ोल्डरों का उपयोग करती रहती है, और हर दूसरी प्रोफ़ाइल स्वतंत्र होती है। डाउनलोड किए गए मॉडल सभी प्रोफ़ाइलों में साझा होते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap profil adalah folder di bawah Application Support. Beralih akan menyimpan semua pekerjaan dan meluncurkan ulang aplikasi; profil Default tetap memakai folder ~/.turbospark bersama, dan setiap profil lain berdiri sendiri. Model yang diunduh dibagikan ke semua profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni profilo è una cartella in Application Support. Il cambio salva tutto il lavoro e riavvia l'app; il profilo predefinito continua a usare le cartelle condivise ~/.turbospark, mentre ogni altro profilo è indipendente. I modelli scaricati sono condivisi da tutti i profili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プロファイルは Application Support 内のフォルダです。切り替えるとすべての作業を保存してアプリを再起動します。デフォルトのプロファイルは共有の ~/.turbospark フォルダを使い続け、ほかのプロファイルはそれぞれ独立しています。ダウンロードしたモデルはすべてのプロファイルで共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 프로필은 Application Support 아래의 폴더입니다. 전환하면 모든 작업을 저장하고 앱을 다시 실행합니다. 기본 프로필은 공유 ~/.turbospark 폴더를 계속 사용하며, 다른 프로필은 모두 독립적입니다. 다운로드한 모델은 모든 프로필이 공유합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk profiel is een map in Application Support. Wisselen slaat al het werk op en start de app opnieuw; het standaardprofiel blijft de gedeelde ~/.turbospark-mappen gebruiken en elk ander profiel staat op zichzelf. Gedownloade modellen worden door alle profielen gedeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy profil to folder w Application Support. Przełączenie zapisuje całą pracę i ponownie uruchamia aplikację; profil domyślny nadal korzysta ze wspólnych folderów ~/.turbospark, a każdy inny profil jest samodzielny. Pobrane modele są wspólne dla wszystkich profili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil é uma pasta em Application Support. Trocar de perfil salva todo o trabalho e reabre o app; o perfil padrão continua usando as pastas compartilhadas de ~/.turbospark, e todos os outros perfis são independentes. Os modelos baixados são compartilhados por todos os perfis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый профиль — это папка в Application Support. При переключении вся работа сохраняется и приложение перезапускается; профиль по умолчанию продолжает использовать общие папки ~/.turbospark, а все остальные профили автономны. Загруженные модели общие для всех профилей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje profil är en mapp under Application Support. Att byta sparar allt arbete och startar om appen; standardprofilen fortsätter att använda de delade ~/.turbospark-mapparna och varje annan profil är fristående. Nedladdade modeller delas av alla profiler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her profil, Application Support altında bir klasördür. Geçiş yapmak tüm çalışmaları kaydeder ve uygulamayı yeniden başlatır; Varsayılan profil paylaşılan ~/.turbospark klasörlerini kullanmaya devam eder ve diğer her profil bağımsızdır. İndirilen modeller tüm profiller tarafından paylaşılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен профіль — це тека в Application Support. Перемикання зберігає всю роботу й перезапускає застосунок; типовий профіль і далі використовує спільні теки ~/.turbospark, а кожен інший профіль автономний. Завантажені моделі спільні для всіх профілів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hồ sơ là một thư mục trong Application Support. Khi chuyển, mọi công việc được lưu và ứng dụng khởi chạy lại; hồ sơ Mặc định tiếp tục dùng các thư mục ~/.turbospark dùng chung, còn mọi hồ sơ khác đều độc lập. Mô hình đã tải xuống được dùng chung cho tất cả hồ sơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个配置文件都是 Application Support 下的一个文件夹。切换会保存所有工作并重新启动应用；默认配置文件继续使用共享的 ~/.turbospark 文件夹，其他配置文件则各自独立。已下载的模型由所有配置文件共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個設定檔都是 Application Support 下的一個檔案夾。切換會儲存所有工作並重新啟動 App；預設設定檔繼續使用共享的 ~/.turbospark 檔案夾，其他設定檔則各自獨立。已下載的模型由所有設定檔共享。"
          }
        }
      }
    },
    "Each profile is a folder under Application Support. Switching saves all work and relaunches the app; the Default user keeps using the shared ~/.turbospark folders, and every other profile is self-contained. Downloaded models are shared by all users.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ملف تعريف عبارة عن مجلد ضمن Application Support. يؤدي التبديل إلى حفظ كل العمل وإعادة تشغيل التطبيق؛ يستمر المستخدم الافتراضي في استخدام مجلدات ~/.turbospark المشتركة، وكل ملف تعريف آخر يكون مكتفيًا ذاتيًا. النماذج التي تم تنزيلها مشتركة بين جميع المستخدمين."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Profil ist ein Ordner unter Application Support. Das Wechseln speichert alle Arbeiten und startet die App neu; der Standardbenutzer verwendet weiterhin die geteilten ~/.turbospark-Ordner, und jedes andere Profil ist in sich abgeschlossen. Heruntergeladene Modelle werden von allen Benutzern geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each profile is a folder under Application Support. Switching saves all work and relaunches the app; the Default user keeps using the shared ~/.turbospark folders, and every other profile is self-contained. Downloaded models are shared by all users."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil es una carpeta dentro de Application Support. Cambiar de perfil guarda todo el trabajo y reinicia la app; el usuario por defecto sigue usando las carpetas compartidas ~/.turbospark y los demás perfiles son independientes. Los modelos descargados se comparten entre todos los usuarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque profil est un dossier sous Application Support. Changer de profil enregistre tout le travail et relance l'application ; l'utilisateur par défaut continue d'utiliser les dossiers partagés ~/.turbospark, et tous les autres profils sont autonomes. Les modèles téléchargés sont partagés par tous les utilisateurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל פרופיל הוא תיקיה תחת Application Support. המעבר שומר את כל העבודה ומפעיל מחדש את האפליקציה; משתמש ברירת המחדל ממשיך להשתמש בתיקיות ~/.turbospark המשותפות, וכל פרופיל אחר הוא עצמאי. מודלים שהורדו משותפים לכל המשתמשים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रत्येक प्रोफ़ाइल Application Support के अंतर्गत एक फ़ोल्डर है। स्विच करने से सभी कार्य सहेज जाते हैं और ऐप पुनः लॉन्च होता है; डिफ़ॉल्ट उपयोगकर्ता साझा किए गए ~/.turbospark फ़ोल्डरों का उपयोग करना जारी रखता है, और प्रत्येक अन्य प्रोफ़ाइल आत्मनिर्भर होती है। डाउनलोड किए गए मॉडल सभी उपयोगकर्ताओं द्वारा साझा किए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap profil adalah folder di bawah Application Support. Beralih akan menyimpan semua pekerjaan dan meluncurkan ulang aplikasi; pengguna Default terus menggunakan folder ~/.turbospark bersama, dan setiap profil lainnya mandiri. Model yang diunduh dibagikan oleh semua pengguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni profilo è una cartella in Application Support. Il cambio salva tutto il lavoro e riavvia l'app; l'utente predefinito continua a utilizzare le cartelle condivise ~/.turbospark e ogni altro profilo è autonomo. I modelli scaricati sono condivisi da tutti gli utenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各プロファイルは Application Support の下のフォルダです。切り替えるとすべての作業が保存されてアプリが再起動します。デフォルトユーザーは共有の ~/.turbospark フォルダを引き続き使用し、他のすべてのプロファイルは自己完結型です。ダウンロードされたモデルはすべてのユーザーで共有されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 프로필은 Application Support 아래의 폴더입니다. 전환하면 모든 작업이 저장되고 앱이 다시 실행됩니다. 기본 사용자는 공유된 ~/.turbospark 폴더를 계속 사용하며 다른 모든 프로필은 독립적입니다. 다운로드한 모델은 모든 사용자가 공유합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk profiel is een map onder Application Support. Schakelen slaat al het werk op en start de app opnieuw; de standaardgebruiker blijft de gedeelde ~/.turbospark-mappen gebruiken, en elk ander profiel is zelfstandig. Gedownloade modellen worden gedeeld door alle gebruikers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy profil to folder w Application Support. Przełączenie zapisuje całą pracę i uruchamia aplikację ponownie; użytkownik domyślny nadal korzysta ze współdzielonych folderów ~/.turbospark, a każdy inny profil jest autonomiczny. Pobrane modele są współdzielone przez wszystkich użytkowników."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada perfil é uma pasta em Application Support. A troca salva todo o trabalho e reinicia o aplicativo; o usuário padrão continua usando as pastas compartilhadas ~/.turbospark, e todos os outros perfis são independentes. Os modelos baixados são compartilhados por todos os usuários."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый профиль -- это папка в Application Support. Переключение сохраняет всю работу и перезапускает приложение; пользователь Default продолжает использовать общие папки ~/.turbospark, а все остальные профили изолированы. Загруженные модели доступны всем пользователям."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje profil är en mapp under Application Support. Växling sparar allt arbete och startar om appen; standardanvändaren fortsätter att använda de delade ~/.turbospark-mapparna, och alla andra profiler är fristående. Nedladdade modeller delas av alla användare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her profil, Application Support altındaki bir klasördür. Geçiş yapmak tüm çalışmaları kaydeder ve uygulamayı yeniden başlatır; Varsayılan kullanıcı paylaşılan ~/.turbospark klasörlerini kullanmaya devam eder ve diğer her profil bağımsızdır. İndirilen modeller tüm kullanıcılar tarafından paylaşılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен профіль -- це папка в Application Support. Перемикання зберігає всю роботу та перезапускає програму; користувач за замовчуванням продовжує використовувати спільні папки ~/.turbospark, а всі інші профілі є автономними. Завантажені моделі доступні всім користувачам."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hồ sơ là một thư mục trong Application Support. Việc chuyển đổi sẽ lưu tất cả công việc và khởi chạy lại ứng dụng; người dùng Mặc định tiếp tục sử dụng các thư mục ~/.turbospark được chia sẻ và mọi hồ sơ khác đều độc lập. Các mô hình đã tải xuống được chia sẻ bởi tất cả người dùng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个配置文件都是 Application Support 下的一个文件夹。切换会保存所有工作并重新启动应用；默认用户继续使用共享的 ~/.turbospark 文件夹，其他配置文件各自独立。下载的模型供所有用户共享。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每個設定檔都是 Application Support 下的一個資料夾。切換會儲存所有工作並重新啟動應用程式；預設使用者繼續使用共享的 ~/.turbospark 資料夾，其他設定檔各自獨立。下載的模型供所有使用者共享。"
          }
        }
      }
    },
    "Each row is priced by the engine, not scaled from one figure.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل صف يحسبه المحرك على حدة، وليس مشتقًا من رقم واحد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Zeile wird von der Engine berechnet, nicht aus einem Wert hochgerechnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each row is priced by the engine, not scaled from one figure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor calcula el coste de cada fila; no se escala a partir de una sola cifra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque ligne est chiffrée par le moteur, pas extrapolée d'une seule valeur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל שורה מחושבת על ידי המנוע, ולא נגזרת מערך יחיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर पंक्ति की गणना इंजन करता है, किसी एक आंकड़े से नहीं निकाली जाती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap baris dihitung oleh mesin, bukan diskalakan dari satu angka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni riga è calcolata dal motore, non ricavata in scala da un solo valore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各行はエンジンが実測した値です。1つの数値から換算したものではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 행은 엔진이 계산한 값이며, 하나의 수치를 비례 확대한 값이 아닙니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke rij wordt door de engine berekend, niet geschaald vanuit één getal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy wiersz wylicza silnik; nie jest skalowany z jednej wartości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada linha é calculada pelo motor, não escalada a partir de um único valor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая строка рассчитана движком, а не масштабирована от одного значения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje rad beräknas av motorn, inte skalad från ett enda värde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her satır motor tarafından hesaplanır, tek bir değerden ölçeklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен рядок обчислює рушій, а не масштабує з одного значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi hàng do engine tính riêng, không suy ra từ một con số."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一行都由引擎单独计算，而非按单个数值换算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一列都由引擎個別計算，而非依單一數值換算。"
          }
        }
      }
    },
    "Each step sees the task, a compact state and the newest tool result. Long runs stay within the context window and cost 3 to 5x fewer tokens.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترى كل خطوة المهمة وحالة مختصرة وأحدث نتيجة أداة. تبقى العمليات الطويلة ضمن نافذة السياق وتستهلك رموزًا أقل بمقدار 3 إلى 5 أضعاف."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Schritt sieht die Aufgabe, einen kompakten Zustand und das neueste Werkzeugergebnis. Lange Läufe bleiben im Kontextfenster und brauchen 3- bis 5-mal weniger Token."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each step sees the task, a compact state and the newest tool result. Long runs stay within the context window and cost 3 to 5x fewer tokens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada paso ve la tarea, un estado compacto y el resultado de herramienta más reciente. Las ejecuciones largas caben en la ventana de contexto y gastan de 3 a 5 veces menos tokens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque étape voit la tâche, un état compact et le dernier résultat d'outil. Les longues exécutions tiennent dans la fenêtre de contexte et coûtent 3 à 5 fois moins de jetons."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל צעד רואה את המשימה, מצב קומפקטי ואת תוצאת הכלי האחרונה. ריצות ארוכות נשארות בחלון ההקשר וצורכות פי 3 עד 5 פחות טוקנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चरण कार्य, संक्षिप्त स्थिति और नवीनतम टूल परिणाम देखता है। लंबे रन संदर्भ विंडो में रहते हैं और 3 से 5 गुना कम टोकन लेते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap langkah melihat tugas, status ringkas, dan hasil alat terbaru. Proses panjang tetap muat di jendela konteks dan memakai token 3 hingga 5 kali lebih sedikit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni passaggio vede l'attività, uno stato compatto e l'ultimo risultato dello strumento. Le esecuzioni lunghe restano nella finestra di contesto e costano da 3 a 5 volte meno token."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ステップはタスク、コンパクトな状態、最新のツール結果だけを参照します。長い実行もコンテキストウィンドウに収まり、トークンは 3 から 5 分の 1 で済みます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 단계는 작업, 압축된 상태, 최신 도구 결과만 봅니다. 긴 실행도 컨텍스트 창 안에 머물고 토큰을 3~5배 적게 씁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke stap ziet de taak, een compacte toestand en het nieuwste toolresultaat. Lange runs blijven binnen het contextvenster en kosten 3 tot 5 keer minder tokens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy krok widzi zadanie, zwięzły stan i najnowszy wynik narzędzia. Długie przebiegi mieszczą się w oknie kontekstu i zużywają od 3 do 5 razy mniej tokenów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada etapa vê a tarefa, um estado compacto e o resultado de ferramenta mais recente. Execuções longas cabem na janela de contexto e gastam de 3 a 5 vezes menos tokens."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый шаг видит задачу, сжатое состояние и последний результат инструмента. Длинные прогоны укладываются в окно контекста и тратят в 3-5 раз меньше токенов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje steg ser uppgiften, ett kompakt tillstånd och det senaste verktygsresultatet. Långa körningar ryms i kontextfönstret och kostar 3 till 5 gånger färre token."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her adım görevi, kompakt bir durumu ve en yeni araç sonucunu görür. Uzun çalıştırmalar bağlam penceresinde kalır ve 3 ila 5 kat daha az token harcar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен крок бачить завдання, стислий стан і найновіший результат інструмента. Довгі прогони вміщуються у вікно контексту й витрачають у 3-5 разів менше токенів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bước chỉ thấy tác vụ, trạng thái rút gọn và kết quả công cụ mới nhất. Lượt chạy dài vẫn nằm trong cửa sổ ngữ cảnh và tốn ít token hơn 3 đến 5 lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一步只看到任务、精简状态和最新的工具结果。长时间运行也能保持在上下文窗口内，token 消耗减少 3 到 5 倍。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每一步只看到任務、精簡狀態和最新的工具結果。長時間執行也能保持在上下文視窗內，token 消耗減少 3 到 5 倍。"
          }
        }
      }
    },
    "Each step sees the whole transcript. Simple and exact, but long runs grow until they hit the context window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ترى كل خطوة النص الكامل. طريقة بسيطة ودقيقة، لكن العمليات الطويلة تكبر حتى تبلغ حد نافذة السياق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Schritt sieht den ganzen Verlauf. Einfach und exakt, aber lange Läufe wachsen, bis sie das Kontextfenster füllen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each step sees the whole transcript. Simple and exact, but long runs grow until they hit the context window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada paso ve la transcripción completa. Es simple y exacto, pero las ejecuciones largas crecen hasta llenar la ventana de contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque étape voit toute la transcription. Simple et exact, mais les longues exécutions grossissent jusqu'à atteindre la fenêtre de contexte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל צעד רואה את התמליל המלא. פשוט ומדויק, אבל ריצות ארוכות גדלות עד שהן מגיעות לגבול חלון ההקשר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर चरण पूरी बातचीत देखता है। सरल और सटीक, लेकिन लंबे रन संदर्भ विंडो की सीमा तक बढ़ते जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap langkah melihat seluruh transkrip. Sederhana dan tepat, tetapi proses panjang terus membesar hingga mencapai batas jendela konteks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni passaggio vede l'intera trascrizione. Semplice ed esatto, ma le esecuzioni lunghe crescono fino a riempire la finestra di contesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各ステップが全文を参照します。シンプルで正確ですが、長い実行はコンテキストウィンドウの上限まで膨らみます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 단계가 전체 기록을 봅니다. 단순하고 정확하지만, 긴 실행은 컨텍스트 창 한도에 닿을 때까지 커집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke stap ziet het volledige transcript. Eenvoudig en exact, maar lange runs groeien tot ze het contextvenster vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy krok widzi całą transkrypcję. Proste i dokładne, ale długie przebiegi rosną, aż wypełnią okno kontekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada etapa vê a transcrição completa. Simples e exato, mas execuções longas crescem até atingir a janela de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый шаг видит всю историю. Просто и точно, но длинные прогоны растут, пока не упрутся в окно контекста."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Varje steg ser hela utskriften. Enkelt och exakt, men långa körningar växer tills de når kontextfönstret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her adım tüm dökümü görür. Basit ve kesin, ancak uzun çalıştırmalar bağlam penceresine ulaşana kadar büyür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен крок бачить усю історію. Просто й точно, але довгі прогони ростуть, доки не впруться у вікно контексту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi bước thấy toàn bộ bản ghi. Đơn giản và chính xác, nhưng lượt chạy dài sẽ phình ra cho đến khi chạm giới hạn cửa sổ ngữ cảnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一步都看到完整记录。简单而精确，但长时间运行会不断增长，直到占满上下文窗口。"
          }
        },
