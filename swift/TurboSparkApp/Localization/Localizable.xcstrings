    "Your recovery passphrase works without this Mac's Keychain. TurboSpark cannot recover it for you.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعمل عبارة مرور الاسترداد من دون سلسلة مفاتيح هذا الـ Mac. لا يستطيع TurboSpark استعادتها لك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Wiederherstellungs-Passphrase funktioniert ohne den Schlüsselbund dieses Macs. TurboSpark kann sie nicht für dich wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your recovery passphrase works without this Mac's Keychain. TurboSpark cannot recover it for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu frase de recuperación funciona sin el llavero de este Mac. TurboSpark no puede recuperarla por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre phrase secrète de récupération fonctionne sans le trousseau de ce Mac. TurboSpark ne peut pas la récupérer pour vous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטוי הסיסמה לשחזור פועל ללא צרור המפתחות של Mac זה. TurboSpark אינו יכול לשחזר אותו עבורך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका रिकवरी पासफ़्रेज़ इस Mac की कीचेन के बिना काम करता है। TurboSpark इसे आपके लिए वापस नहीं ला सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa sandi pemulihan Anda dapat digunakan tanpa Rantai Kunci Mac ini. TurboSpark tidak dapat memulihkannya untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passphrase di recupero funziona senza il Portachiavi di questo Mac. TurboSpark non può recuperarla per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復旧パスフレーズは、このMacのキーチェーンがなくても使用できます。TurboSparkでは復旧できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 암호는 이 Mac의 키체인 없이도 작동합니다. TurboSpark는 암호를 복구해 드릴 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je herstelwachtzin werkt zonder de sleutelhanger van deze Mac. TurboSpark kan deze niet voor je herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasło odzyskiwania działa bez pęku kluczy tego Maca. TurboSpark nie może go odzyskać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua frase secreta de recuperação funciona sem as Chaves deste Mac. O TurboSpark não pode recuperá-la para você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Фраза восстановления работает без Связки ключей этого Mac. TurboSpark не может восстановить её для вас."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din återställningsfras fungerar utan den här Macens nyckelring. TurboSpark kan inte återställa den åt dig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma parolanız bu Mac'in Anahtar Zinciri olmadan çalışır. TurboSpark parolanızı sizin için kurtaramaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Фраза відновлення працює без В’язки ключів цього Mac. TurboSpark не може відновити її для вас."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cụm mật khẩu khôi phục hoạt động mà không cần Chuỗi khóa của máy Mac này. TurboSpark không thể khôi phục cụm mật khẩu cho bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复口令无需此 Mac 的钥匙串即可使用。TurboSpark 无法为你恢复该口令。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "復原密語不需要此 Mac 的鑰匙圈即可使用。TurboSpark 無法替你復原該密語。"
          }
        }
      }
    },
