        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 音訊引擎"
          }
        }
      }
    },
    "TurboSpark checks known Hugging Face, LM Studio, and Ollama locations. Only supported GGUF and GTurbo artifacts can be added to the runnable model list.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق TurboSpark من مواقع Hugging Face وLM Studio وOllama المعروفة. يمكن فقط إضافة عناصر GGUF وGTurbo المدعومة إلى قائمة النماذج القابلة للتشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark überprüft bekannte Hugging Face-, LM Studio- und Ollama-Speicherorte. Nur unterstützte GGUF- und GTurbo-Artefakte können zur Liste ausführbarer Modelle hinzugefügt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark checks known Hugging Face, LM Studio, and Ollama locations. Only supported GGUF and GTurbo artifacts can be added to the runnable model list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark comprueba las ubicaciones conocidas de Hugging Face, LM Studio y Ollama. Solo los artefactos GGUF y GTurbo compatibles se pueden añadir a la lista de modelos ejecutables."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark vérifie les emplacements connus de Hugging Face, LM Studio et Ollama. Seuls les artefacts GGUF et GTurbo pris en charge peuvent être ajoutés à la liste des modèles exécutables."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark בודק מיקומים ידועים של Hugging Face, LM Studio ו-Ollama. רק רכיבי GGUF ו-GTurbo נתמכים יכולים להתווסף לרשימת המודלים הניתנים להפעלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ज्ञात Hugging Face, LM Studio और Ollama स्थानों की जांच करता है। केवल समर्थित GGUF और GTurbo कलाकृतियों को चलाने योग्य मॉडल सूची में जोड़ा जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark memeriksa lokasi umum Hugging Face, LM Studio, dan Ollama. Hanya artefak GGUF dan GTurbo yang didukung yang dapat ditambahkan ke daftar model yang dapat dijalankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark controlla le posizioni note di Hugging Face, LM Studio e Ollama. Solo gli artefatti GGUF e GTurbo supportati possono essere aggiunti all'elenco dei modelli eseguibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparkは既知のHugging Face、LM Studio、Ollamaの場所を確認します。サポートされているGGUFおよびGTurboアーティファクトのみを実行可能なモデルリストに追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark는 알려진 Hugging Face, LM Studio 및 Ollama 위치를 확인합니다. 지원되는 GGUF 및 GTurbo 아티팩트만 실행 가능한 모델 목록에 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark controleert bekende locaties van Hugging Face, LM Studio en Ollama. Alleen ondersteunde GGUF- en GTurbo-artefacten kunnen worden toegevoegd aan de lijst met uitvoerbare modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark sprawdza znane lokalizacje Hugging Face, LM Studio i Ollama. Do listy modeli gotowych do uruchomienia można dodać tylko obsługiwane artefakty GGUF i GTurbo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark verifica locais conhecidos do Hugging Face, LM Studio e Ollama. Somente artefatos GGUF e GTurbo compatíveis podem ser adicionados à lista de modelos executáveis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark проверяет известные расположения Hugging Face, LM Studio и Ollama. Только поддерживаемые артефакты GGUF и GTurbo могут быть добавлены в список запускаемых моделей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark kontrollerar kända platser för Hugging Face, LM Studio och Ollama. Endast GGUF- och GTurbo-artefakter som stöds kan läggas till i listan över körbara modeller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark bilinen Hugging Face, LM Studio ve Ollama konumlarını denetler. Yalnızca desteklenen GGUF ve GTurbo yapıları çalıştırılabilir model listesine eklenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark перевіряє відомі розташування Hugging Face, LM Studio та Ollama. До списку доступних для запуску моделей можна додати лише підтримувані артефакти GGUF та GTurbo."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark kiểm tra các vị trí Hugging Face, LM Studio và Ollama đã biết. Chỉ các tệp GGUF và GTurbo được hỗ trợ mới có thể được thêm vào danh sách mô hình có thể chạy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 会检查已知的 Hugging Face、LM Studio 和 Ollama 位置。只有受支持的 GGUF 和 GTurbo 构件才能添加到可运行模型列表中。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 會檢查已知的 Hugging Face、LM Studio 和 Ollama 位置。只有受支援的 GGUF 和 GTurbo 成品才能新增至可執行模型清單中。"
          }
        }
      }
    },
    "TurboSpark copies the model, checks the copy, and only then removes the original.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقوم TurboSpark بنسخ النموذج، ثم يتحقق من النسخة، ثم يزيل الأصل فقط بعد ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark kopiert das Modell, prüft die Kopie und entfernt erst danach das Original."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark copies the model, checks the copy, and only then removes the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark copia el modelo, comprueba la copia y solo entonces elimina el original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark copie le modèle, vérifie la copie, puis seulement ensuite supprime l'original."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark מעתיק את המודל, בודק את ההעתק, ורק לאחר מכן מסיר את המקור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark मॉडल की कॉपी बनाता है, कॉपी की जाँच करता है, और उसके बाद ही मूल को हटाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark menyalin model, memeriksa salinannya, dan baru kemudian menghapus aslinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark copia il modello, controlla la copia e solo dopo rimuove l'originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark はモデルをコピーし、コピーを確認してから、元のモデルを削除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark는 모델을 복사하고 복사본을 확인한 다음에야 원본을 삭제합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark kopieert het model, controleert de kopie en verwijdert pas daarna het origineel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark kopiuje model, sprawdza kopię i dopiero potem usuwa oryginał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark copia o modelo, verifica a cópia e só então remove o original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark копирует модель, проверяет копию и только после этого удаляет оригинал."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark kopierar modellen, kontrollerar kopian och tar först därefter bort originalet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark modeli kopyalar, kopyayı denetler ve ancak ondan sonra aslını siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark копіює модель, перевіряє копію і лише після цього видаляє оригінал."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark sao chép mô hình, kiểm tra bản sao rồi mới xóa bản gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 会先复制模型并检查副本，然后才删除原件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 會先複製模型並檢查副本，然後才刪除原件。"
          }
        }
      }
    },
    "TurboSpark could not change '%@'.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على TurboSpark تغيير '%@'."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark konnte '%@' nicht ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark could not change '%@'."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark no pudo modificar '%@'."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark n'a pas pu modifier '%@'."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark לא הצליח לשנות את '%@'."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark '%@' को बदल नहीं सका।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark tidak dapat mengubah '%@'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark non è riuscito a modificare '%@'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparkは '%@' を変更できませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark에서 '%@'을(를) 변경하지 못했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
