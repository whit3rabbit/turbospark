    "Multi-Token-Prediction Head: fast speculative drafting for up to 1.66x speedup": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0631\u0623\u0633 \u0627\u0644\u062a\u0646\u0628\u0624 \u0645\u062a\u0639\u062f\u062f \u0627\u0644\u0631\u0645\u0648\u0632: \u0635\u064a\u0627\u063a\u0629 \u062a\u062e\u0645\u064a\u0646\u064a\u0629 \u0633\u0631\u064a\u0639\u0629 \u0644\u062a\u0633\u0631\u064a\u0639 \u064a\u0635\u0644 \u0625\u0644\u0649 1.66x"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-Token-Prediction-Head: schnelles spekulatives Drafting f\u00fcr bis zu 1,66-fache Beschleunigung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-Token-Prediction Head: fast speculative drafting for up to 1.66x speedup"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabezal de predicci\u00f3n multitoken: borradores especulativos r\u00e1pidos con hasta 1,66x de aceleraci\u00f3n"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00eate de pr\u00e9diction multijeton : \u00e9bauche sp\u00e9culative rapide jusqu\u2019\u00e0 1,66x plus vite"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e8\u05d0\u05e9 \u05d7\u05d9\u05d6\u05d5\u05d9 \u05e8\u05d1-\u05d8\u05d5\u05e7\u05e0\u05d9\u05dd: \u05e0\u05d9\u05e1\u05d5\u05d7 \u05e1\u05e4\u05e7\u05d5\u05dc\u05d8\u05d9\u05d1\u05d9 \u05de\u05d4\u05d9\u05e8 \u05dc\u05d4\u05d0\u05e6\u05d4 \u05e9\u05dc \u05e2\u05d3 \u05e4\u05d9 1.66"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0932\u094d\u091f\u0940-\u091f\u094b\u0915\u0928-\u092a\u094d\u0930\u0947\u0921\u093f\u0915\u094d\u0936\u0928 \u0939\u0947\u0921: 1.66x \u0924\u0915 \u0917\u0924\u093f \u0915\u0947 \u0932\u093f\u090f \u0924\u0947\u091c\u093c \u0938\u094d\u092a\u0947\u0915\u094d\u092f\u0941\u0932\u0947\u091f\u093f\u0935 \u0921\u094d\u0930\u093e\u092b\u093c\u094d\u091f\u093f\u0902\u0917"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Head Prediksi Multi-Token: drafting spekulatif cepat hingga 1,66x lebih cepat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testa di predizione multi-token: bozze speculative rapide fino a 1,66x pi\u00f9 veloci"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30de\u30eb\u30c1\u30c8\u30fc\u30af\u30f3\u4e88\u6e2c\u30d8\u30c3\u30c9: \u6700\u59271.66\u500d\u306e\u9ad8\u901f\u5316\u3092\u5b9f\u73fe\u3059\u308b\u6295\u6a5f\u7684\u30c9\u30e9\u30d5\u30c8"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc911 \ud1a0\ud070 \uc608\uce21 \ud5e4\ub4dc: \ucd5c\ub300 1.66\ubc30 \ube60\ub978 \ucd94\uce21 \ucd08\uc548 \uc0dd\uc131"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Multi-token-predictiekop: snelle speculatieve drafting voor tot 1,66x versnelling"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u0142owica przewidywania wielu token\u00f3w: szybkie spekulatywne szkicowanie, do 1,66x przyspieszenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabe\u00e7a de previs\u00e3o multitoken: rascunho especulativo r\u00e1pido com at\u00e9 1,66x de acelera\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u043b\u043e\u0432\u0430 \u043c\u043d\u043e\u0433\u043e\u0442\u043e\u043a\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u043a\u0430\u0437\u0430\u043d\u0438\u044f: \u0431\u044b\u0441\u0442\u0440\u044b\u0435 \u0441\u043f\u0435\u043a\u0443\u043b\u044f\u0442\u0438\u0432\u043d\u044b\u0435 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a\u0438 \u0441 \u0443\u0441\u043a\u043e\u0440\u0435\u043d\u0438\u0435\u043c \u0434\u043e 1,66x"
