          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0648\u062c\u0651\u0647 \u062e\u0627\u0645\u060c \u0639\u0628\u0631 \u0642\u0627\u0644\u0628 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0646\u0641\u0633\u0647."
