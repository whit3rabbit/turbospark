    "Describe a soundtrack and keep each take for comparison.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a soundtrack and keep each take for comparison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe una banda sonora y conserva cada toma para compararlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9crivez une bande sonore et conservez chaque prise pour les comparer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe einen Soundtrack und behalte jeden Take zum Vergleich."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi una colonna sonora e conserva ogni take per confrontarle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma trilha sonora e guarde cada tomada para comparar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf een soundtrack en bewaar elke take om te vergelijken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv ett ljudsp\u00e5r och beh\u00e5ll varje tagning f\u00f6r j\u00e4mf\u00f6relse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz \u015bcie\u017ck\u0119 d\u017awi\u0119kow\u0105 i zachowaj ka\u017cd\u0105 wersj\u0119 do por\u00f3wnania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir m\u00fczik par\u00e7as\u0131n\u0131 tarif edin ve kar\u015f\u0131la\u015ft\u0131rmak i\u00e7in her \u00e7ekimi saklay\u0131n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsikan musik latar dan simpan setiap take untuk dibandingkan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0441\u0430\u0443\u043d\u0434\u0442\u0440\u0435\u043a \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0434\u0443\u0431\u043b\u044c \u0434\u043b\u044f \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0456\u0442\u044c \u0441\u0430\u0443\u043d\u0434\u0442\u0440\u0435\u043a \u0456 \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044c \u043a\u043e\u0436\u0435\u043d \u0434\u0443\u0431\u043b\u044c \u0434\u043b\u044f \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 t\u1ea3 nh\u1ea1c n\u1ec1n v\u00e0 gi\u1eef t\u1eebng l\u01b0\u1ee3t thu \u0111\u1ec3 so s\u00e1nh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b5\u30a6\u30f3\u30c9\u30c8\u30e9\u30c3\u30af\u3092\u8aac\u660e\u3057\u3001\u5404\u30c6\u30a4\u30af\u3092\u4fdd\u5b58\u3057\u3066\u6bd4\u8f03\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uc6b4\ub4dc\ud2b8\ub799\uc744 \uc124\uba85\ud558\uace0 \uac01 \ud14c\uc774\ud06c\ub97c \ubcf4\uad00\ud558\uc5ec \ube44\uad50\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63cf\u8ff0\u914d\u4e50\uff0c\u5e76\u4fdd\u7559\u6bcf\u4e2a\u7248\u672c\u4ee5\u4f9b\u6bd4\u8f83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63cf\u8ff0\u914d\u6a02\uff0c\u4e26\u4fdd\u7559\u6bcf\u500b\u7248\u672c\u4ee5\u4f9b\u6bd4\u8f03\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0635\u0650\u0641 \u0645\u0648\u0633\u064a\u0642\u0649 \u062a\u0635\u0648\u064a\u0631\u064a\u0629 \u0648\u0627\u062d\u062a\u0641\u0638 \u0628\u0643\u0644 \u0646\u0633\u062e\u0629 \u0644\u0644\u0645\u0642\u0627\u0631\u0646\u0629."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d0\u05e8 \u05e4\u05e1\u05e7\u05d5\u05dc \u05d5\u05e9\u05de\u05d5\u05e8 \u05db\u05dc \u05d8\u05d9\u05d9\u05e7 \u05dc\u05d4\u05e9\u05d5\u05d5\u05d0\u05d4."
          }
        },
        "hi": {
