            "value": "Zast\u0119puje bie\u017c\u0105cy opis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Substitui a descri\u00e7\u00e3o atual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043c\u0435\u043d\u044f\u0435\u0442 \u0442\u0435\u043a\u0443\u0449\u0435\u0435 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ers\u00e4tter den nuvarande beskrivningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut a\u00e7\u0131klaman\u0131n yerine ge\u00e7er."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043c\u0456\u043d\u044e\u0454 \u043f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 \u043e\u043f\u0438\u0441."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay th\u1ebf m\u00f4 t\u1ea3 hi\u1ec7n t\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u66ff\u6362\u5f53\u524d\u63cf\u8ff0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u53d6\u4ee3\u76ee\u524d\u7684\u63cf\u8ff0\u3002"
          }
        }
      }
    },
    "Choose options to build a description.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose options to build a description."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u062e\u064a\u0627\u0631\u0627\u062a \u0644\u0628\u0646\u0627\u0621 \u0648\u0635\u0641."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle Optionen, um eine Beschreibung zu erstellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige opciones para crear una descripci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des options pour cr\u00e9er une description."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05d0\u05e4\u05e9\u05e8\u05d5\u05d9\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d1\u05e0\u05d5\u05ea \u05ea\u05d9\u05d0\u05d5\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093f\u0935\u0930\u0923 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0935\u093f\u0915\u0932\u094d\u092a \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih opsi untuk menyusun deskripsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli le opzioni per creare una descrizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30aa\u30d7\u30b7\u30e7\u30f3\u3092\u9078\u3093\u3067\u8aac\u660e\u3092\u4f5c\u6210\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc635\uc158\uc744 \uc120\ud0dd\ud574 \uc124\uba85\uc744 \ub9cc\ub4dc\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies opties om een beschrijving samen te stellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz opcje, aby zbudowa\u0107 opis."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha op\u00e7\u00f5es para criar uma descri\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj alternativ f\u00f6r att bygga en beskrivning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00e7\u0131klama olu\u015fturmak i\u00e7in se\u00e7enekler se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438, \u0449\u043e\u0431 \u0441\u043a\u043b\u0430\u0441\u0442\u0438 \u043e\u043f\u0438\u0441."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn c\u00e1c t\u00f9y ch\u1ecdn \u0111\u1ec3 t\u1ea1o m\u00f4 t\u1ea3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u9009\u9879\u4ee5\u751f\u6210\u63cf\u8ff0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u9078\u9805\u4ee5\u7522\u751f\u63cf\u8ff0\u3002"
          }
        }
      }
    },
    "Name a voice type. Leaving it open often turns the track instrumental.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name a voice type. Leaving it open often turns the track instrumental."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u062f\u0651\u062f \u0646\u0648\u0639 \u0627\u0644\u0635\u0648\u062a. \u062a\u0631\u0643 \u0627\u0644\u062d\u0642\u0644 \u0641\u0627\u0631\u063a\u064b\u0627 \u064a\u062c\u0639\u0644 \u0627\u0644\u0645\u0642\u0637\u0648\u0639\u0629 \u063a\u0627\u0644\u0628\u064b\u0627 \u0645\u0648\u0633\u064a\u0642\u0649 \u0628\u062f\u0648\u0646 \u063a\u0646\u0627\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenne einen Stimmtyp. Bleibt das Feld leer, wird der Titel oft instrumental."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un tipo de voz. Si lo dejas abierto, la pista suele salir instrumental."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez un type de voix. Le laisser vide transforme souvent le morceau en instrumental."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e6\u05d9\u05d9\u05df \u05e1\u05d5\u05d2 \u05e7\u05d5\u05dc. \u05d4\u05e9\u05d0\u05e8\u05ea \u05d4\u05e9\u05d3\u05d4 \u05e8\u05d9\u05e7 \u05d4\u05d5\u05e4\u05db\u05ea \u05d0\u05ea \u05d4\u05e7\u05d8\u05e2 \u05dc\u05e2\u05d9\u05ea\u05d9\u05dd \u05e7\u05e8\u05d5\u05d1\u05d5\u05ea \u05dc\u05d0\u05d9\u05e0\u05e1\u05d8\u05e8\u05d5\u05de\u05e0\u05d8\u05dc\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0935\u093e\u091c\u093c \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0930 \u092c\u0924\u093e\u090f\u0901\u0964 \u0907\u0938\u0947 \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0928\u0947 \u092a\u0930 \u091f\u094d\u0930\u0948\u0915 \u0905\u0915\u094d\u0938\u0930 \u0935\u093e\u0926\u094d\u092f \u0938\u0902\u0917\u0940\u0924 \u092c\u0928 \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebutkan jenis suara. Jika dibiarkan kosong, lagu sering menjadi instrumental."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indica un tipo di voce. Se lasci il campo vuoto, il brano spesso diventa strumentale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u58f0\u306e\u7a2e\u985e\u3092\u6307\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u6307\u5b9a\u3057\u306a\u3044\u3068\u3001\u30a4\u30f3\u30b9\u30c8\u30a5\u30eb\u30e1\u30f3\u30bf\u30eb\u306b\u306a\u308b\u3053\u3068\u304c\u3088\u304f\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa9\uc18c\ub9ac \uc720\ud615\uc744 \uc785\ub825\ud558\uc138\uc694. \ube44\uc6cc \ub450\uba74 \uc5f0\uc8fc\uace1\uc774 \ub418\ub294 \uacbd\uc6b0\uac00 \ub9ce\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Noem een stemtype. Als je dit open laat, wordt het nummer vaak instrumentaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj typ g\u0142osu. Pozostawienie tego pola pustego cz\u0119sto sprawia, \u017ce utw\u00f3r jest instrumentalny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um tipo de voz. Deixar em aberto costuma tornar a faixa instrumental."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0442\u0438\u043f \u0433\u043e\u043b\u043e\u0441\u0430. \u0415\u0441\u043b\u0438 \u043e\u0441\u0442\u0430\u0432\u0438\u0442\u044c \u043f\u043e\u043b\u0435 \u043f\u0443\u0441\u0442\u044b\u043c, \u0442\u0440\u0435\u043a \u0447\u0430\u0441\u0442\u043e \u043f\u043e\u043b\u0443\u0447\u0430\u0435\u0442\u0441\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en r\u00f6sttyp. Om du l\u00e4mnar det \u00f6ppet blir sp\u00e5ret ofta instrumentalt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ses t\u00fcr\u00fc belirtin. Bo\u015f b\u0131rakmak par\u00e7ay\u0131 \u00e7o\u011funlukla enstr\u00fcmantal yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043a\u0430\u0436\u0456\u0442\u044c \u0442\u0438\u043f \u0433\u043e\u043b\u043e\u0441\u0443. \u042f\u043a\u0449\u043e \u0437\u0430\u043b\u0438\u0448\u0438\u0442\u0438 \u043f\u043e\u043b\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c, \u0442\u0440\u0435\u043a \u0447\u0430\u0441\u0442\u043e \u0432\u0438\u0445\u043e\u0434\u0438\u0442\u044c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0438\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00eau m\u1ed9t lo\u1ea1i gi\u1ecdng. N\u1ebfu \u0111\u1ec3 tr\u1ed1ng, b\u1ea3n nh\u1ea1c th\u01b0\u1eddng th\u00e0nh kh\u00f4ng l\u1eddi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u6307\u5b9a\u4e00\u79cd\u58f0\u97f3\u7c7b\u578b\u3002\u7559\u7a7a\u901a\u5e38\u4f1a\u4f7f\u6b4c\u66f2\u53d8\u6210\u7eaf\u97f3\u4e50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u6307\u5b9a\u4e00\u7a2e\u8072\u97f3\u985e\u578b\u3002\u7559\u7a7a\u901a\u5e38\u6703\u4f7f\u6b4c\u66f2\u8b8a\u6210\u7d14\u97f3\u6a02\u3002"
          }
        }
      }
    },
    "Vocals are on, but the lyrics are empty, so the track will render instrumental.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vocals are on, but the lyrics are empty, so the track will render instrumental."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u063a\u0646\u0627\u0621 \u0645\u0641\u0639\u0651\u0644\u060c \u0644\u0643\u0646 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0623\u063a\u0646\u064a\u0629 \u0641\u0627\u0631\u063a\u0629\u060c \u0644\u0630\u0627 \u0633\u062a\u064f\u0646\u0634\u0623 \u0627\u0644\u0645\u0642\u0637\u0648\u0639\u0629 \u0643\u0645\u0648\u0633\u064a\u0642\u0649 \u0628\u062f\u0648\u0646 \u063a\u0646\u0627\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gesang ist aktiviert, aber der Liedtext ist leer. Der Titel wird daher instrumental erzeugt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las voces est\u00e1n activadas, pero la letra est\u00e1 vac\u00eda, as\u00ed que la pista se generar\u00e1 instrumental."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chant est activ\u00e9, mais les paroles sont vides : le morceau sera g\u00e9n\u00e9r\u00e9 en instrumental."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05d9\u05e8\u05d4 \u05e4\u05d5\u05e2\u05dc\u05ea, \u05d0\u05da \u05de\u05d9\u05dc\u05d5\u05ea \u05d4\u05e9\u05d9\u05e8 \u05e8\u05d9\u05e7\u05d5\u05ea, \u05d5\u05dc\u05db\u05df \u05d4\u05e7\u05d8\u05e2 \u05d9\u05d9\u05d5\u05d5\u05e6\u05e8 \u05db\u05d0\u05d9\u05e0\u05e1\u05d8\u05e8\u05d5\u05de\u05e0\u05d8\u05dc\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u093e\u092f\u0928 \u091a\u093e\u0932\u0942 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0917\u0940\u0924 \u0915\u0947 \u092c\u094b\u0932 \u0916\u093e\u0932\u0940 \u0939\u0948\u0902, \u0907\u0938\u0932\u093f\u090f \u091f\u094d\u0930\u0948\u0915 \u0935\u093e\u0926\u094d\u092f \u0938\u0902\u0917\u0940\u0924 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092c\u0928\u0947\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vokal aktif, tetapi liriknya kosong, sehingga lagu akan dihasilkan sebagai instrumental."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il canto \u00e8 attivo, ma il testo \u00e8 vuoto, quindi il brano verr\u00e0 generato come strumentale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30dc\u30fc\u30ab\u30eb\u306f\u30aa\u30f3\u3067\u3059\u304c\u3001\u6b4c\u8a5e\u304c\u7a7a\u306e\u305f\u3081\u3001\u30a4\u30f3\u30b9\u30c8\u30a5\u30eb\u30e1\u30f3\u30bf\u30eb\u3068\u3057\u3066\u751f\u6210\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcf4\uceec\uc774 \ucf1c\uc838 \uc788\uc9c0\ub9cc \uac00\uc0ac\uac00 \ube44\uc5b4 \uc788\uc5b4 \uc5f0\uc8fc\uace1\uc73c\ub85c \uc0dd\uc131\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zang staat aan, maar de songtekst is leeg, dus het nummer wordt instrumentaal gegenereerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wokal jest w\u0142\u0105czony, ale tekst piosenki jest pusty, wi\u0119c utw\u00f3r zostanie wygenerowany jako instrumentalny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os vocais est\u00e3o ativados, mas a letra est\u00e1 vazia, ent\u00e3o a faixa ser\u00e1 gerada como instrumental."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u043a\u0430\u043b \u0432\u043a\u043b\u044e\u0447\u0451\u043d, \u043d\u043e \u0442\u0435\u043a\u0441\u0442 \u043f\u0435\u0441\u043d\u0438 \u043f\u0443\u0441\u0442, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0442\u0440\u0435\u043a \u0431\u0443\u0434\u0435\u0442 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u044b\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e5ng \u00e4r p\u00e5, men l\u00e5ttexten \u00e4r tom, s\u00e5 sp\u00e5ret blir instrumentalt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vokal a\u00e7\u0131k, ancak \u015fark\u0131 s\u00f6zleri bo\u015f, bu y\u00fczden par\u00e7a enstr\u00fcmantal olarak \u00fcretilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u043a\u0430\u043b \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e, \u0430\u043b\u0435 \u0442\u0435\u043a\u0441\u0442 \u043f\u0456\u0441\u043d\u0456 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u0439, \u0442\u043e\u043c\u0443 \u0442\u0440\u0435\u043a \u0431\u0443\u0434\u0435 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0438\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi\u1ecdng h\u00e1t \u0111ang b\u1eadt nh\u01b0ng l\u1eddi b\u00e0i h\u00e1t tr\u1ed1ng, n\u00ean b\u1ea3n nh\u1ea1c s\u1ebd \u0111\u01b0\u1ee3c t\u1ea1o th\u00e0nh kh\u00f4ng l\u1eddi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eba\u58f0\u5df2\u5f00\u542f\uff0c\u4f46\u6b4c\u8bcd\u4e3a\u7a7a\uff0c\u56e0\u6b64\u6b4c\u66f2\u5c06\u751f\u6210\u4e3a\u7eaf\u97f3\u4e50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4eba\u8072\u5df2\u958b\u555f\uff0c\u4f46\u6b4c\u8a5e\u70ba\u7a7a\uff0c\u56e0\u6b64\u6b4c\u66f2\u5c07\u7522\u751f\u70ba\u7d14\u97f3\u6a02\u3002"
          }
        }
      }
    },
    "Instrumental is on, but the lyrics contain words.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumental is on, but the lyrics contain words."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062e\u064a\u0627\u0631 \u0645\u0648\u0633\u064a\u0642\u0649 \u0628\u062f\u0648\u0646 \u063a\u0646\u0627\u0621 \u0645\u0641\u0639\u0651\u0644\u060c \u0644\u0643\u0646 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0623\u063a\u0646\u064a\u0629 \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0643\u0644\u0645\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumental ist aktiviert, aber der Liedtext enth\u00e4lt W\u00f6rter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumental est\u00e1 activado, pero la letra contiene palabras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumental est activ\u00e9, mais les paroles contiennent des mots."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05e0\u05e1\u05d8\u05e8\u05d5\u05de\u05e0\u05d8\u05dc\u05d9 \u05e4\u05d5\u05e2\u05dc, \u05d0\u05da \u05de\u05d9\u05dc\u05d5\u05ea \u05d4\u05e9\u05d9\u05e8 \u05de\u05db\u05d9\u05dc\u05d5\u05ea \u05de\u05d9\u05dc\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u093e\u0926\u094d\u092f \u0938\u0902\u0917\u0940\u0924 \u091a\u093e\u0932\u0942 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0917\u0940\u0924 \u0915\u0947 \u092c\u094b\u0932 \u092e\u0947\u0902 \u0936\u092c\u094d\u0926 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumental aktif, tetapi lirik berisi kata-kata."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Strumentale \u00e8 attivo, ma il testo contiene parole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30a5\u30eb\u30e1\u30f3\u30bf\u30eb\u306f\u30aa\u30f3\u3067\u3059\u304c\u3001\u6b4c\u8a5e\u306b\u8a00\u8449\u304c\u542b\u307e\u308c\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5f0\uc8fc\uace1\uc774 \ucf1c\uc838 \uc788\uc9c0\ub9cc \uac00\uc0ac\uc5d0 \ub2e8\uc5b4\uac00 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumentaal staat aan, maar de songtekst bevat woorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcja Instrumentalny jest w\u0142\u0105czona, ale tekst piosenki zawiera s\u0142owa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumental est\u00e1 ativado, mas a letra cont\u00e9m palavras."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0430\u044f \u043c\u0443\u0437\u044b\u043a\u0430 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0430, \u043d\u043e \u0442\u0435\u043a\u0441\u0442 \u043f\u0435\u0441\u043d\u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u0441\u043b\u043e\u0432\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrumental \u00e4r p\u00e5, men l\u00e5ttexten inneh\u00e5ller ord."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enstr\u00fcmantal a\u00e7\u0131k, ancak \u015fark\u0131 s\u00f6zleri kelime i\u00e7eriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043b\u044c\u043d\u0443 \u043c\u0443\u0437\u0438\u043a\u0443 \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e, \u0430\u043b\u0435 \u0442\u0435\u043a\u0441\u0442 \u043f\u0456\u0441\u043d\u0456 \u043c\u0456\u0441\u0442\u0438\u0442\u044c \u0441\u043b\u043e\u0432\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1ea1c kh\u00f4ng l\u1eddi \u0111ang b\u1eadt nh\u01b0ng l\u1eddi b\u00e0i h\u00e1t c\u00f3 ch\u1eef."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7eaf\u97f3\u4e50\u5df2\u5f00\u542f\uff0c\u4f46\u6b4c\u8bcd\u4e2d\u5305\u542b\u6587\u5b57\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d14\u97f3\u6a02\u5df2\u958b\u555f\uff0c\u4f46\u6b4c\u8a5e\u4e2d\u5305\u542b\u6587\u5b57\u3002"
          }
        }
      }
    },
    "Pick instruments below. The first one leads the track.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick instruments below. The first one leads the track."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0627\u0644\u0622\u0644\u0627\u062a \u0623\u062f\u0646\u0627\u0647. \u0627\u0644\u0622\u0644\u0629 \u0627\u0644\u0623\u0648\u0644\u0649 \u062a\u0642\u0648\u062f \u0627\u0644\u0645\u0642\u0637\u0648\u0639\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hle unten Instrumente aus. Das erste f\u00fchrt den Titel an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige abajo los instrumentos. El primero lidera la pista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez les instruments ci-dessous. Le premier m\u00e8ne le morceau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05db\u05dc\u05d9\u05dd \u05dc\u05de\u05d8\u05d4. \u05d4\u05e8\u05d0\u05e9\u05d5\u05df \u05de\u05d5\u05d1\u05d9\u05dc \u05d0\u05ea \u05d4\u05e7\u05d8\u05e2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0940\u091a\u0947 \u0935\u093e\u0926\u094d\u092f \u092f\u0902\u0924\u094d\u0930 \u091a\u0941\u0928\u0947\u0902\u0964 \u092a\u0939\u0932\u093e \u092f\u0902\u0924\u094d\u0930 \u091f\u094d\u0930\u0948\u0915 \u0915\u093e \u0928\u0947\u0924\u0943\u0924\u094d\u0935 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih instrumen di bawah. Yang pertama memimpin lagu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli gli strumenti qui sotto. Il primo guida il brano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u306e\u697d\u5668\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044\u3002\u6700\u521d\u306e\u697d\u5668\u304c\u66f2\u3092\u30ea\u30fc\u30c9\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\ub798\uc5d0\uc11c \uc545\uae30\ub97c \uace0\ub974\uc138\uc694. \uccab \ubc88\uc9f8 \uc545\uae30\uac00 \ud2b8\ub799\uc744 \uc774\ub055\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies hieronder instrumenten. De eerste leidt het nummer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz poni\u017cej instrumenty. Pierwszy z nich prowadzi utw\u00f3r."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha os instrumentos abaixo. O primeiro conduz a faixa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u043d\u0438\u0436\u0435. \u041f\u0435\u0440\u0432\u044b\u0439 \u0432\u0435\u0434\u0451\u0442 \u0442\u0440\u0435\u043a."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj instrument nedan. Det f\u00f6rsta leder sp\u00e5ret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u015fa\u011f\u0131dan enstr\u00fcmanlar\u0131 se\u00e7in. \u0130lki par\u00e7aya \u00f6nc\u00fcl\u00fck eder."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u043d\u0438\u0436\u0447\u0435. \u041f\u0435\u0440\u0448\u0438\u0439 \u0432\u0435\u0434\u0435 \u0442\u0440\u0435\u043a."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn nh\u1ea1c c\u1ee5 b\u00ean d\u01b0\u1edbi. Nh\u1ea1c c\u1ee5 \u0111\u1ea7u ti\u00ean d\u1eabn d\u1eaft b\u1ea3n nh\u1ea1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4e0b\u65b9\u9009\u62e9\u4e50\u5668\u3002\u7b2c\u4e00\u4e2a\u4e50\u5668\u5c06\u4e3b\u5bfc\u6574\u9996\u66f2\u5b50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4e0b\u65b9\u9078\u64c7\u6a02\u5668\u3002\u7b2c\u4e00\u500b\u6a02\u5668\u5c07\u4e3b\u5c0e\u6574\u9996\u66f2\u5b50\u3002"
          }
        }
      }
    },
