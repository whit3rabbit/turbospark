    "Streams weights dynamically with minimal RAM footprint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0628\u062b \u0627\u0644\u0623\u0648\u0632\u0627\u0646 \u062f\u064a\u0646\u0627\u0645\u064a\u0643\u064a\u064b\u0627 \u0628\u0623\u0642\u0644 \u0627\u0633\u062a\u0647\u0644\u0627\u0643 \u0644\u0644\u0630\u0627\u0643\u0631\u0629"
