        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f8b\u5982\uff1a\u4f7f\u7528\u5de5\u5177\u524d\u8fd0\u884c lint\u3001\u7f16\u8f91\u65f6\u81ea\u52a8\u683c\u5f0f\u5316\u2026"
