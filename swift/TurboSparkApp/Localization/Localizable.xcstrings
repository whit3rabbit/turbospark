    "Nothing to branch yet.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u0627 \u064a\u0645\u0643\u0646 \u062a\u0641\u0631\u064a\u0639\u0647 \u0628\u0639\u062f."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zum Verzweigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to branch yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan no hay nada que ramificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune branche possible pour l'instant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05d4 \u05dc\u05e4\u05e6\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0936\u093e\u0916\u093e \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang bisa dicabangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente da ramificare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3060\u5206\u5c90\u3067\u304d\u308b\u5185\u5bb9\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc9c1 \ubd84\uae30\ud560 \ub0b4\uc6a9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets om te vertakken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze z czego utworzy\u0107 ga\u0142\u0119zi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda n\u00e3o h\u00e1 nada para ramificar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430 \u043d\u0435 \u0438\u0437 \u0447\u0435\u0433\u043e \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0432\u0435\u0442\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att f\u00f6rgrena \u00e4n."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hen\u00fcz dalland\u0131r\u0131lacak bir \u015fey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0438 \u0449\u043e \u043d\u0435\u043c\u0430 \u0437 \u0447\u043e\u0433\u043e \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0433\u0456\u043b\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00f3 g\u00ec \u0111\u1ec3 ph\u00e2n nh\u00e1nh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6682\u65e0\u53ef\u5206\u652f\u7684\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u524d\u6c92\u6709\u53ef\u5206\u652f\u7684\u5167\u5bb9\u3002"
          }
        }
      }
    },
    "Nothing to compact yet: the recent conversation is the whole of it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u0627 \u064a\u064f\u0636\u063a\u0637 \u0628\u0639\u062f: \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0647\u064a \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0628\u0623\u0643\u0645\u0644\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts zu verdichten: Die Unterhaltung besteht nur aus aktuellen Nachrichten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing to compact yet: the recent conversation is the whole of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan no hay nada que compactar: la conversaci\u00f3n reciente es toda la conversaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien \u00e0 compacter pour l'instant : la conversation r\u00e9cente constitue l'ensemble."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05e2\u05d3\u05d9\u05d9\u05df \u05de\u05d4 \u05dc\u05d3\u05d7\u05d5\u05e1: \u05d4\u05e9\u05d9\u05d7\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05d4\u05d9\u05d0 \u05db\u05dc \u05d4\u05e9\u05d9\u05d7\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u0941\u091b \u0928\u0939\u0940\u0902 \u0939\u0948: \u0939\u093e\u0932 \u0915\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0939\u0940 \u092a\u0942\u0930\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada yang bisa dipadatkan: percakapan terbaru adalah seluruh percakapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente da compattare: la conversazione recente \u00e8 l'intera conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3060\u5727\u7e2e\u3059\u308b\u5185\u5bb9\u304c\u3042\u308a\u307e\u305b\u3093\u3002\u4f1a\u8a71\u5168\u4f53\u304c\u6700\u8fd1\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc9c1 \uc555\ucd95\ud560 \ub0b4\uc6a9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \ucd5c\uadfc \ub300\ud654\uac00 \uc804\uccb4 \ub300\ud654\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niets om te comprimeren: het recente gesprek is het hele gesprek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma jeszcze czego kompaktowa\u0107: ostatnia rozmowa to ca\u0142a rozmowa."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda n\u00e3o h\u00e1 nada para compactar: a conversa recente \u00e9 a conversa inteira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430 \u043d\u0435\u0447\u0435\u0433\u043e \u0441\u0436\u0438\u043c\u0430\u0442\u044c: \u0432\u0441\u044f \u0431\u0435\u0441\u0435\u0434\u0430 \u0441\u043e\u0441\u0442\u043e\u0438\u0442 \u0438\u0437 \u043d\u0435\u0434\u0430\u0432\u043d\u0438\u0445 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att komprimera \u00e4n: den senaste konversationen \u00e4r hela konversationen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hen\u00fcz s\u0131k\u0131\u015ft\u0131r\u0131lacak bir \u015fey yok: son konu\u015fma, konu\u015fman\u0131n tamam\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0438 \u0449\u043e \u043d\u0456\u0447\u043e\u0433\u043e \u0441\u0442\u0438\u0441\u043a\u0430\u0442\u0438: \u0443\u0441\u044f \u0440\u043e\u0437\u043c\u043e\u0432\u0430 \u0441\u043a\u043b\u0430\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u0437 \u043d\u0435\u0434\u0430\u0432\u043d\u0456\u0445 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a c\u00f3 g\u00ec \u0111\u1ec3 n\u00e9n: cu\u1ed9c tr\u00f2 chuy\u1ec7n g\u1ea7n \u0111\u00e2y ch\u00ednh l\u00e0 to\u00e0n b\u1ed9 cu\u1ed9c tr\u00f2 chuy\u1ec7n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6682\u65e0\u53ef\u538b\u7f29\u7684\u5185\u5bb9\uff1a\u6700\u8fd1\u7684\u5bf9\u8bdd\u5c31\u662f\u5168\u90e8\u5bf9\u8bdd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u524d\u6c92\u6709\u53ef\u58d3\u7e2e\u7684\u5167\u5bb9\uff1a\u6700\u8fd1\u7684\u5c0d\u8a71\u5c31\u662f\u5168\u90e8\u5c0d\u8a71\u3002"
          }
        }
      }
    },
