          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapami\u0119taj ten klucz w p\u0119ku kluczy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Lembrar esta chave nas Chaves"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u043e\u043c\u043d\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u043a\u043b\u044e\u0447 \u0432 \u0421\u0432\u044f\u0437\u043a\u0435 \u043a\u043b\u044e\u0447\u0435\u0439"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kom ih\u00e5g den h\u00e4r nyckeln i nyckelringen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu anahtar\u0131 Anahtar Zinciri'nde hat\u0131rla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0430\u043c'\u044f\u0442\u0430\u0442\u0438 \u0446\u0435\u0439 \u043a\u043b\u044e\u0447 \u0443 \u0417\u0432'\u044f\u0437\u0446\u0456 \u043a\u043b\u044e\u0447\u0456\u0432"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi nh\u1edb kh\u00f3a n\u00e0y trong Chu\u1ed7i kh\u00f3a"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u94a5\u5319\u4e32\u4e2d\u8bb0\u4f4f\u6b64\u5bc6\u94a5"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u9470\u5319\u5708\u4e2d\u8a18\u4f4f\u6b64\u91d1\u9470"
          }
        }
      }
    },
    "A new key is generated each time the app starts and is not saved.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0646\u0634\u0623 \u0645\u0641\u062a\u0627\u062d \u062c\u062f\u064a\u062f \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u064a\u0628\u062f\u0623 \u0641\u064a\u0647\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0648\u0644\u0627 \u064a\u064f\u062d\u0641\u0638."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei jedem Start der App wird ein neuer Schl\u00fcssel erzeugt, der nicht gespeichert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new key is generated each time the app starts and is not saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se genera una clave nueva cada vez que se inicia la app y no se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une nouvelle cl\u00e9 est g\u00e9n\u00e9r\u00e9e \u00e0 chaque d\u00e9marrage de l'app et n'est pas enregistr\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e4\u05ea\u05d7 \u05d7\u05d3\u05e9 \u05e0\u05d5\u05e6\u05e8 \u05d1\u05db\u05dc \u05d4\u05e4\u05e2\u05dc\u05d4 \u05e9\u05dc \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05d5\u05d0\u05d9\u05e0\u05d5 \u05e0\u05e9\u05de\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0910\u092a \u0939\u0930 \u092c\u093e\u0930 \u0936\u0941\u0930\u0942 \u0939\u094b\u0928\u0947 \u092a\u0930 \u090f\u0915 \u0928\u0908 \u0915\u0941\u0902\u091c\u0940 \u092c\u0928\u093e\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0947 \u0938\u0939\u0947\u091c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci baru dibuat setiap kali app dimulai dan tidak disimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A ogni avvio dell'app viene generata una nuova chiave, che non viene salvata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ad\u30fc\u306f\u30a2\u30d7\u30ea\u306e\u8d77\u52d5\u3054\u3068\u306b\u65b0\u3057\u304f\u751f\u6210\u3055\u308c\u3001\u4fdd\u5b58\u3055\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc571\uc744 \uc2dc\uc791\ud560 \ub54c\ub9c8\ub2e4 \uc0c8 \ud0a4\uac00 \uc0dd\uc131\ub418\uba70 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij elke start van de app wordt een nieuwe sleutel gemaakt, die niet wordt opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy klucz jest generowany przy ka\u017cdym uruchomieniu aplikacji i nie jest zapisywany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma nova chave \u00e9 gerada a cada abertura do app e n\u00e3o \u00e9 salva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438 \u043a\u0430\u0436\u0434\u043e\u043c \u0437\u0430\u043f\u0443\u0441\u043a\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0441\u043e\u0437\u0434\u0430\u0451\u0442\u0441\u044f \u043d\u043e\u0432\u044b\u0439 \u043a\u043b\u044e\u0447, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En ny nyckel skapas varje g\u00e5ng appen startar och sparas inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama her ba\u015flad\u0131\u011f\u0131nda yeni bir anahtar olu\u015fturulur ve kaydedilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434 \u0447\u0430\u0441 \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443 \u0441\u0442\u0432\u043e\u0440\u044e\u0454\u0442\u044c\u0441\u044f \u043d\u043e\u0432\u0438\u0439 \u043a\u043b\u044e\u0447, \u044f\u043a\u0438\u0439 \u043d\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed9t kh\u00f3a m\u1edbi \u0111\u01b0\u1ee3c t\u1ea1o m\u1ed7i khi \u1ee9ng d\u1ee5ng kh\u1edfi \u0111\u1ed9ng v\u00e0 kh\u00f4ng \u0111\u01b0\u1ee3c l\u01b0u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u542f\u52a8\u5e94\u7528\u65f6\u90fd\u4f1a\u751f\u6210\u65b0\u5bc6\u94a5\uff0c\u4e14\u4e0d\u4f1a\u4fdd\u5b58\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u6b21\u555f\u52d5 App \u6642\u90fd\u6703\u7522\u751f\u65b0\u91d1\u9470\uff0c\u4e14\u4e0d\u6703\u5132\u5b58\u3002"
          }
        }
      }
    },
