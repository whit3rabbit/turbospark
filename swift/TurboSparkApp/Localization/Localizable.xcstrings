        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bron kon niet als tekst worden gelezen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uda\u0142o si\u0119 odczyta\u0107 \u017ar\u00f3d\u0142a jako tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel ler o c\u00f3digo-fonte como texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u043a\u043e\u0434 \u043a\u0430\u043a \u0442\u0435\u043a\u0441\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00e4llan kunde inte l\u00e4sas som text."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak metin olarak okunamad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u043a\u043e\u0434 \u044f\u043a \u0442\u0435\u043a\u0441\u0442."
          }
        },
        "vi": {
