            "state": "translated",
            "value": "Limite massimo di token al secondo. 0 lascia la generazione senza limiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1秒あたりのトークン数の上限です。0 にすると上限なしで生成します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초당 토큰 상한입니다. 0이면 생성 속도를 제한하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bovengrens in tokens per seconde. 0 laat het genereren onbeperkt."
