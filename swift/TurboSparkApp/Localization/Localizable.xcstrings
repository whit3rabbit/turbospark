        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierd\u017a has\u0142o eksportu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar senha de exporta\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0434\u0442\u0432\u0435\u0440\u0434\u0438\u0442\u0435 \u043f\u0430\u0440\u043e\u043b\u044c \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekr\u00e4fta exportl\u00f6senord"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u0131\u015fa aktarma parolas\u0131n\u0131 onayla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u044c\u0442\u0435 \u043f\u0430\u0440\u043e\u043b\u044c \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "X\u00e1c nh\u1eadn m\u1eadt kh\u1ea9u xu\u1ea5t"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u786e\u8ba4\u5bfc\u51fa\u5bc6\u7801"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u78ba\u8a8d\u532f\u51fa\u5bc6\u78bc"
          }
        }
      }
    },
    "Use at least 15 characters. The backup contains an authenticated SQLCipher snapshot and encrypted managed assets. The device Keychain item is excluded.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u062e\u062f\u0645 15 \u062d\u0631\u0641\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644. \u062a\u062d\u062a\u0648\u064a \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0639\u0644\u0649 \u0644\u0642\u0637\u0629 SQLCipher \u0645\u0648\u062b\u0642\u0629 \u0648\u0623\u0635\u0648\u0644 \u0645\u064f\u062f\u0627\u0631\u0629 \u0645\u0634\u0641\u0631\u0629. \u064a\u064f\u0633\u062a\u062b\u0646\u0649 \u0639\u0646\u0635\u0631 \u0633\u0644\u0633\u0644\u0629 \u0627\u0644\u0645\u0641\u0627\u062a\u064a\u062d \u0627\u0644\u062e\u0627\u0635 \u0628\u0627\u0644\u062c\u0647\u0627\u0632."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende mindestens 15 Zeichen. Das Backup enth\u00e4lt einen authentifizierten SQLCipher-Snapshot und verschl\u00fcsselte verwaltete Assets. Der Schl\u00fcsselbundeintrag des Ger\u00e4ts ist ausgenommen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use at least 15 characters. The backup contains an authenticated SQLCipher snapshot and encrypted managed assets. The device Keychain item is excluded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa al menos 15 caracteres. La copia contiene una instant\u00e1nea autenticada de SQLCipher y recursos gestionados cifrados. El elemento del llavero del dispositivo queda excluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez au moins 15 caract\u00e8res. La sauvegarde contient un instantan\u00e9 SQLCipher authentifi\u00e9 et des ressources g\u00e9r\u00e9es chiffr\u00e9es. L'\u00e9l\u00e9ment du trousseau de l'appareil est exclu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05ea\u05de\u05e9\u05d5 \u05d1-15 \u05ea\u05d5\u05d5\u05d9\u05dd \u05dc\u05e4\u05d7\u05d5\u05ea. \u05d4\u05d2\u05d9\u05d1\u05d5\u05d9 \u05de\u05db\u05d9\u05dc \u05ea\u05de\u05d5\u05e0\u05ea \u05de\u05e6\u05d1 \u05de\u05d0\u05d5\u05de\u05ea\u05ea \u05e9\u05dc SQLCipher \u05d5\u05e0\u05db\u05e1\u05d9\u05dd \u05de\u05e0\u05d5\u05d4\u05dc\u05d9\u05dd \u05de\u05d5\u05e6\u05e4\u05e0\u05d9\u05dd. \u05e4\u05e8\u05d9\u05d8 \u05de\u05d7\u05d6\u05d9\u05e7 \u05d4\u05de\u05e4\u05ea\u05d7\u05d5\u05ea \u05e9\u05dc \u05d4\u05de\u05db\u05e9\u05d9\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05db\u05dc\u05d5\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u092e \u0938\u0947 \u0915\u092e 15 \u0905\u0915\u094d\u0937\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964 \u092c\u0948\u0915\u0905\u092a \u092e\u0947\u0902 \u092a\u094d\u0930\u092e\u093e\u0923\u093f\u0924 SQLCipher \u0938\u094d\u0928\u0948\u092a\u0936\u0949\u091f \u0914\u0930 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u090f\u0938\u0947\u091f \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u093e \u0915\u0940\u091a\u0947\u0928 \u0906\u0907\u091f\u092e \u0936\u093e\u092e\u093f\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan minimal 15 karakter. Cadangan berisi snapshot SQLCipher yang diautentikasi dan aset terkelola yang dienkripsi. Item Rantai Kunci perangkat tidak disertakan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa almeno 15 caratteri. Il backup contiene un'istantanea SQLCipher autenticata e risorse gestite cifrate. L'elemento del portachiavi del dispositivo \u00e8 escluso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15 \u6587\u5b57\u4ee5\u4e0a\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306b\u306f\u8a8d\u8a3c\u6e08\u307f\u306e SQLCipher \u30b9\u30ca\u30c3\u30d7\u30b7\u30e7\u30c3\u30c8\u3068\u6697\u53f7\u5316\u3055\u308c\u305f\u7ba1\u7406\u30a2\u30bb\u30c3\u30c8\u304c\u542b\u307e\u308c\u307e\u3059\u3002\u30c7\u30d0\u30a4\u30b9\u306e\u30ad\u30fc\u30c1\u30a7\u30fc\u30f3\u9805\u76ee\u306f\u542b\u307e\u308c\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "15\uc790 \uc774\uc0c1\uc744 \uc0ac\uc6a9\ud558\uc2ed\uc2dc\uc624. \ubc31\uc5c5\uc5d0\ub294 \uc778\uc99d\ub41c SQLCipher \uc2a4\ub0c5\uc0f7\uacfc \uc554\ud638\ud654\ub41c \uad00\ub9ac \uc790\uc0b0\uc774 \ub4e4\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uae30\uae30\uc758 \ud0a4\uccb4\uc778 \ud56d\ubaa9\uc740 \uc81c\uc678\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik minstens 15 tekens. De reservekopie bevat een geverifieerde SQLCipher-momentopname en versleutelde beheerde bestanden. Het sleutelhangeritem van het apparaat wordt niet meegenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cyj co najmniej 15 znak\u00f3w. Kopia zawiera uwierzytelnion\u0105 migawk\u0119 SQLCipher i zaszyfrowane zarz\u0105dzane zasoby. Element p\u0119ku kluczy urz\u0105dzenia jest pomini\u0119ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use pelo menos 15 caracteres. O backup cont\u00e9m um instant\u00e2neo autenticado do SQLCipher e recursos gerenciados criptografados. O item do Porta-Chaves do dispositivo fica de fora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043d\u0435 \u043c\u0435\u043d\u0435\u0435 15 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432. \u041a\u043e\u043f\u0438\u044f \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u043d\u044b\u0439 \u0441\u043d\u0438\u043c\u043e\u043a SQLCipher \u0438 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0435 \u0440\u0435\u0441\u0443\u0440\u0441\u044b. \u042d\u043b\u0435\u043c\u0435\u043d\u0442 \u0421\u0432\u044f\u0437\u043a\u0438 \u043a\u043b\u044e\u0447\u0435\u0439 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u0430 \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u0435\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nd minst 15 tecken. S\u00e4kerhetskopian inneh\u00e5ller en autentiserad SQLCipher-\u00f6gonblicksbild och krypterade hanterade resurser. Enhetens nyckelringsobjekt ing\u00e5r inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az 15 karakter kullan\u0131n. Yedek, kimli\u011fi do\u011frulanm\u0131\u015f bir SQLCipher anl\u0131k g\u00f6r\u00fcnt\u00fcs\u00fc ve \u015fifrelenmi\u015f y\u00f6netilen varl\u0131klar i\u00e7erir. Ayg\u0131t\u0131n Anahtar Zinciri \u00f6\u011fesi dahil edilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0449\u043e\u043d\u0430\u0439\u043c\u0435\u043d\u0448\u0435 15 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432. \u041a\u043e\u043f\u0456\u044f \u043c\u0456\u0441\u0442\u0438\u0442\u044c \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u0438\u0439 \u0437\u043d\u0456\u043c\u043e\u043a SQLCipher \u0456 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0456 \u043a\u0435\u0440\u043e\u0432\u0430\u043d\u0456 \u0440\u0435\u0441\u0443\u0440\u0441\u0438. \u0415\u043b\u0435\u043c\u0435\u043d\u0442 \u0412'\u044f\u0437\u043a\u0438 \u043a\u043b\u044e\u0447\u0456\u0432 \u043f\u0440\u0438\u0441\u0442\u0440\u043e\u044e \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00f9ng \u00edt nh\u1ea5t 15 k\u00fd t\u1ef1. B\u1ea3n sao l\u01b0u ch\u1ee9a \u1ea3nh ch\u1ee5p nhanh SQLCipher \u0111\u00e3 x\u00e1c th\u1ef1c v\u00e0 t\u00e0i nguy\u00ean \u0111\u01b0\u1ee3c qu\u1ea3n l\u00fd \u0111\u00e3 m\u00e3 h\u00f3a. M\u1ee5c Chu\u1ed7i kh\u00f3a c\u1ee7a thi\u1ebft b\u1ecb kh\u00f4ng \u0111\u01b0\u1ee3c bao g\u1ed3m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u81f3\u5c11\u4f7f\u7528 15 \u4e2a\u5b57\u7b26\u3002\u5907\u4efd\u5305\u542b\u7ecf\u8fc7\u8ba4\u8bc1\u7684 SQLCipher \u5feb\u7167\u548c\u52a0\u5bc6\u7684\u6258\u7ba1\u8d44\u6e90\u3002\u4e0d\u5305\u62ec\u8bbe\u5907\u7684\u94a5\u5319\u4e32\u9879\u76ee\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u81f3\u5c11\u4f7f\u7528 15 \u500b\u5b57\u5143\u3002\u5099\u4efd\u5305\u542b\u7d93\u904e\u8a8d\u8b49\u7684 SQLCipher \u5feb\u7167\u548c\u52a0\u5bc6\u7684\u53d7\u7ba1\u7406\u8cc7\u6e90\u3002\u4e0d\u5305\u62ec\u88dd\u7f6e\u7684\u9470\u5319\u5708\u9805\u76ee\u3002"
          }
        }
      }
    },
    "The restored profile remains protected by this password. Its private name and content stay encrypted.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0628\u0642\u0649 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0645\u0633\u062a\u0639\u0627\u062f \u0645\u062d\u0645\u064a\u064b\u0627 \u0628\u0643\u0644\u0645\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u0647\u0630\u0647. \u0648\u064a\u0638\u0644 \u0627\u0633\u0645\u0647 \u0627\u0644\u062e\u0627\u0635 \u0648\u0645\u062d\u062a\u0648\u0627\u0647 \u0645\u0634\u0641\u0631\u064a\u0646."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das wiederhergestellte Profil bleibt durch dieses Passwort gesch\u00fctzt. Sein privater Name und Inhalt bleiben verschl\u00fcsselt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restored profile remains protected by this password. Its private name and content stay encrypted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil restaurado sigue protegido por esta contrase\u00f1a. Su nombre privado y su contenido permanecen cifrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil restaur\u00e9 reste prot\u00e9g\u00e9 par ce mot de passe. Son nom priv\u00e9 et son contenu restent chiffr\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05e9\u05d5\u05d7\u05d6\u05e8 \u05e0\u05e9\u05d0\u05e8 \u05de\u05d5\u05d2\u05df \u05d1\u05e1\u05d9\u05e1\u05de\u05d4 \u05d6\u05d5. \u05e9\u05de\u05d5 \u05d4\u05e4\u05e8\u05d8\u05d9 \u05d5\u05ea\u05d5\u05db\u05e0\u05d5 \u05e0\u05e9\u05d0\u05e8\u05d9\u05dd \u05de\u05d5\u05e6\u05e4\u05e0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0907\u0938 \u092a\u093e\u0938\u0935\u0930\u094d\u0921 \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0939\u0924\u0940 \u0939\u0948\u0964 \u0909\u0938\u0915\u093e \u0928\u093f\u091c\u0940 \u0928\u093e\u092e \u0914\u0930 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u0930\u0939\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil yang dipulihkan tetap dilindungi kata sandi ini. Nama pribadi dan kontennya tetap terenkripsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo ripristinato resta protetto da questa password. Il suo nome privato e i contenuti restano cifrati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fa9\u5143\u3057\u305f\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306f\u5f15\u304d\u7d9a\u304d\u3053\u306e\u30d1\u30b9\u30ef\u30fc\u30c9\u3067\u4fdd\u8b77\u3055\u308c\u307e\u3059\u3002\u975e\u516c\u958b\u306e\u540d\u524d\u3068\u5185\u5bb9\u306f\u6697\u53f7\u5316\u3055\u308c\u305f\u307e\u307e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcf5\uc6d0\ub41c \ud504\ub85c\ud544\uc740 \uacc4\uc18d \uc774 \uc554\ud638\ub85c \ubcf4\ud638\ub429\ub2c8\ub2e4. \ube44\uacf5\uac1c \uc774\ub984\uacfc \ucf58\ud150\uce20\ub294 \uc554\ud638\ud654\ub41c \uc0c1\ud0dc\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het herstelde profiel blijft beveiligd met dit wachtwoord. De priv\u00e9naam en inhoud blijven versleuteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywr\u00f3cony profil pozostaje chroniony tym has\u0142em. Jego prywatna nazwa i zawarto\u015b\u0107 pozostaj\u0105 zaszyfrowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil restaurado continua protegido por esta senha. O nome privado e o conte\u00fado permanecem criptografados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u043e\u0441\u0442\u0430\u0451\u0442\u0441\u044f \u0437\u0430\u0449\u0438\u0449\u0451\u043d\u043d\u044b\u043c \u044d\u0442\u0438\u043c \u043f\u0430\u0440\u043e\u043b\u0435\u043c. \u0415\u0433\u043e \u043b\u0438\u0447\u043d\u043e\u0435 \u0438\u043c\u044f \u0438 \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0435 \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u043c\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den \u00e5terst\u00e4llda profilen f\u00f6rblir skyddad av det h\u00e4r l\u00f6senordet. Dess privata namn och inneh\u00e5ll f\u00f6rblir krypterade."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri y\u00fcklenen profil bu parolayla korunmaya devam eder. \u00d6zel ad\u0131 ve i\u00e7eri\u011fi \u015fifreli kal\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u0439 \u043f\u0440\u043e\u0444\u0456\u043b\u044c \u0456 \u0434\u0430\u043b\u0456 \u0437\u0430\u0445\u0438\u0449\u0435\u043d\u043e \u0446\u0438\u043c \u043f\u0430\u0440\u043e\u043b\u0435\u043c. \u0419\u043e\u0433\u043e \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0430 \u043d\u0430\u0437\u0432\u0430 \u0442\u0430 \u0432\u043c\u0456\u0441\u0442 \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ed3 s\u01a1 \u0111\u01b0\u1ee3c kh\u00f4i ph\u1ee5c v\u1eabn \u0111\u01b0\u1ee3c b\u1ea3o v\u1ec7 b\u1eb1ng m\u1eadt kh\u1ea9u n\u00e0y. T\u00ean ri\u00eang v\u00e0 n\u1ed9i dung c\u1ee7a n\u00f3 v\u1eabn \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6062\u590d\u7684\u914d\u7f6e\u6587\u4ef6\u4ecd\u53d7\u6b64\u5bc6\u7801\u4fdd\u62a4\u3002\u5176\u79c1\u6709\u540d\u79f0\u548c\u5185\u5bb9\u4fdd\u6301\u52a0\u5bc6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56de\u5fa9\u7684\u8a2d\u5b9a\u6a94\u4ecd\u53d7\u6b64\u5bc6\u78bc\u4fdd\u8b77\u3002\u5176\u79c1\u4eba\u540d\u7a31\u548c\u5167\u5bb9\u4fdd\u6301\u52a0\u5bc6\u3002"
          }
        }
      }
    },
