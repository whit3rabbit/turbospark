        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0406\u043c\u043f\u043e\u0440\u0442 \u0437 \u0456\u043d\u0448\u0438\u0445 \u0430\u0433\u0435\u043d\u0442\u043d\u0438\u0445 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432"
          }
        },
        "vi": {
