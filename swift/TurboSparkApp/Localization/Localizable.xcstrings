            "value": "Acesso ao navegador"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ к браузеру"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Webbläsaråtkomst"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı erişimi"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Доступ до браузера"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quyền truy cập trình duyệt"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器访问权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器存取權"
          }
        }
      }
    },
    "Browser origin unavailable. This action cannot be approved safely.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أصل المتصفح غير متاح. لا يمكن الموافقة على هذا الإجراء بأمان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserursprung nicht verfügbar. Diese Aktion kann nicht sicher genehmigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser origin unavailable. This action cannot be approved safely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El origen del navegador no está disponible. Esta acción no se puede aprobar de forma segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’origine du navigateur est indisponible. Cette action ne peut pas être approuvée en toute sécurité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקור הדפדפן אינו זמין. אי אפשר לאשר את הפעולה הזו בבטחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र origin उपलब्ध नहीं है। इस कार्रवाई को सुरक्षित रूप से मंज़ूरी नहीं दी जा सकती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Origin browser tidak tersedia. Tindakan ini tidak dapat disetujui dengan aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’origine del browser non è disponibile. Questa azione non può essere approvata in sicurezza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザのオリジンを確認できません。この操作を安全に承認できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 origin을 확인할 수 없습니다. 이 작업은 안전하게 승인할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De browserorigin is niet beschikbaar. Deze actie kan niet veilig worden goedgekeurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródło przeglądarki jest niedostępne. Tej czynności nie można bezpiecznie zatwierdzić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A origem do navegador não está disponível. Esta ação não pode ser aprovada com segurança."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источник браузера недоступен. Это действие нельзя безопасно одобрить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Webbläsarens origin är inte tillgänglig. Åtgärden kan inte godkännas på ett säkert sätt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı kaynağı kullanılamıyor. Bu işlem güvenli bir şekilde onaylanamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерело браузера недоступне. Цю дію неможливо безпечно схвалити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có origin trình duyệt. Không thể phê duyệt hành động này một cách an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器源不可用。无法安全地批准此操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器來源無法使用。無法安全地核准此操作。"
          }
        }
      }
    },
    "Browser tools can navigate, click, type, take screenshots, and read page structure. They ask before acting. A project grant matches one exact HTTP(S) origin, and each project can hold 256 grants.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لأدوات المتصفح التنقل والنقر والكتابة والتقاط لقطات شاشة وقراءة بنية الصفحة. تسأل قبل التنفيذ. ينطبق منح المشروع على أصل HTTP(S) واحد محدد، ويمكن لكل مشروع حفظ 256 منحة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserwerkzeuge können Seiten aufrufen, klicken, tippen, Screenshots aufnehmen und die Seitenstruktur lesen. Sie fragen vor Aktionen nach. Eine Projektfreigabe gilt für genau einen HTTP(S)-Ursprung; pro Projekt sind 256 Freigaben möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browser tools can navigate, click, type, take screenshots, and read page structure. They ask before acting. A project grant matches one exact HTTP(S) origin, and each project can hold 256 grants."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las herramientas del navegador pueden navegar, hacer clic, escribir, capturar pantallas y leer la estructura de la página. Preguntan antes de actuar. Una concesión del proyecto se aplica a un origen HTTP(S) exacto, y cada proyecto puede tener 256 concesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les outils du navigateur peuvent naviguer, cliquer, saisir du texte, prendre des captures d’écran et lire la structure des pages. Ils demandent avant d’agir. Une autorisation du projet correspond à une origine HTTP(S) précise, et chaque projet peut en contenir 256."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כלי הדפדפן יכולים לנווט, ללחוץ, להקליד, לצלם מסך ולקרוא את מבנה הדף. הם מבקשים אישור לפני פעולה. הרשאת פרויקט חלה על מקור HTTP(S) מדויק אחד, וכל פרויקט יכול לשמור 256 הרשאות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्राउज़र टूल पेज पर जा सकते हैं, क्लिक और टाइप कर सकते हैं, स्क्रीनशॉट ले सकते हैं और पेज की संरचना पढ़ सकते हैं। कार्रवाई से पहले वे पूछते हैं। प्रोजेक्ट की अनुमति केवल एक सटीक HTTP(S) origin पर लागू होती है और हर प्रोजेक्ट में 256 अनुमतियाँ हो सकती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat browser dapat membuka halaman, mengeklik, mengetik, mengambil tangkapan layar, dan membaca struktur halaman. Alat akan bertanya sebelum bertindak. Izin proyek berlaku untuk satu origin HTTP(S) yang tepat, dan setiap proyek dapat menyimpan 256 izin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli strumenti del browser possono navigare, fare clic, digitare, acquisire schermate e leggere la struttura delle pagine. Chiedono prima di agire. Un’autorizzazione del progetto vale per un’origine HTTP(S) esatta e ogni progetto può conservarne 256."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブラウザツールでは、ページ移動、クリック、入力、スクリーンショットの撮影、ページ構造の読み取りができます。操作前に確認します。プロジェクトの許可は正確な HTTP(S) オリジン 1 件に適用され、各プロジェクトで 256 件まで保存できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브라우저 도구는 페이지 이동, 클릭, 입력, 스크린샷 촬영, 페이지 구조 읽기를 할 수 있습니다. 동작 전에 확인합니다. 프로젝트 권한은 정확한 HTTP(S) origin 하나에 적용되며 프로젝트마다 256개까지 저장할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Browserhulpmiddelen kunnen navigeren, klikken, typen, schermafbeeldingen maken en de paginastructuur lezen. Ze vragen dit voordat ze iets doen. Een projecttoestemming geldt voor precies één HTTP(S)-origin; per project zijn 256 toestemmingen mogelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narzędzia przeglądarki mogą otwierać strony, klikać, wpisywać tekst, robić zrzuty ekranu i odczytywać strukturę strony. Pytają przed działaniem. Zgoda projektu dotyczy jednego dokładnego źródła HTTP(S), a projekt może przechowywać 256 zgód."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As ferramentas do navegador podem navegar, clicar, digitar, capturar telas e ler a estrutura da página. Elas perguntam antes de agir. Uma concessão do projeto corresponde a uma origem HTTP(S) exata, e cada projeto pode armazenar 256 concessões."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Инструменты браузера могут переходить по страницам, нажимать, вводить текст, делать снимки экрана и читать структуру страницы. Перед действием они спрашивают разрешение. Разрешение проекта действует для одного точного HTTP(S)-источника, в проекте можно хранить до 256 разрешений."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Webbläsarverktyg kan navigera, klicka, skriva, ta skärmbilder och läsa sidans struktur. De frågar innan de agerar. En projektbehörighet gäller för exakt en HTTP(S)-origin, och varje projekt kan lagra 256 behörigheter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarayıcı araçları sayfalarda gezinebilir, tıklayabilir, yazabilir, ekran görüntüsü alabilir ve sayfa yapısını okuyabilir. İşlemden önce sorarlar. Proje izni tek bir tam HTTP(S) kaynağı için geçerlidir ve her projede 256 izin saklanabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Інструменти браузера можуть переходити сторінками, натискати, вводити текст, робити знімки екрана та читати структуру сторінки. Перед дією вони запитують дозвіл. Дозвіл проєкту діє для одного точного HTTP(S)-джерела; у проєкті можна зберігати до 256 дозволів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Công cụ trình duyệt có thể điều hướng, nhấp, nhập văn bản, chụp ảnh màn hình và đọc cấu trúc trang. Công cụ sẽ hỏi trước khi thao tác. Quyền của dự án áp dụng cho đúng một origin HTTP(S), mỗi dự án có thể lưu 256 quyền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浏览器工具可以导航页面、点击、输入、截屏并读取页面结构。执行操作前会询问。项目授权仅适用于一个精确的 HTTP(S) 源，每个项目最多可保存 256 项授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "瀏覽器工具可以瀏覽頁面、點擊、輸入、擷取螢幕畫面並讀取頁面結構。執行前會先詢問。專案授權只適用於一個精確的 HTTP(S) 來源，每個專案最多可儲存 256 項授權。"
          }
        }
      }
    },
    "Built in. Shares the ~/.turbospark skills, agents, and tools with other apps.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مدمج. يشارك مهارات ~/.turbospark ووكلاءه وأدواته مع التطبيقات الأخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Integriert. Teilt die Skills, Agenten und Tools in ~/.turbospark mit anderen Apps."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built in. Shares the ~/.turbospark skills, agents, and tools with other apps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrado. Comparte las habilidades, agentes y herramientas de ~/.turbospark con otras apps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intégré. Partage les compétences, agents et outils de ~/.turbospark avec d'autres apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מובנה. משתף את המיומנויות, הסוכנים והכלים שב-~/.turbospark עם אפליקציות אחרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अंतर्निहित। ~/.turbospark की स्किल, एजेंट और टूल अन्य ऐप्स के साथ साझा करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawaan. Berbagi skill, agen, dan alat di ~/.turbospark dengan aplikasi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrato. Condivide skill, agenti e strumenti di ~/.turbospark con altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "内蔵。~/.turbospark のスキル、エージェント、ツールをほかのアプリと共有します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 제공. ~/.turbospark의 스킬, 에이전트, 도구를 다른 앱과 공유합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingebouwd. Deelt de skills, agents en tools in ~/.turbospark met andere apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wbudowany. Udostępnia umiejętności, agentów i narzędzia z ~/.turbospark innym aplikacjom."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Integrado. Compartilha as habilidades, agentes e ferramentas de ~/.turbospark com outros apps."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенный. Использует навыки, агентов и инструменты из ~/.turbospark совместно с другими приложениями."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inbyggd. Delar färdigheter, agenter och verktyg i ~/.turbospark med andra appar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik. ~/.turbospark içindeki becerileri, ajanları ve araçları diğer uygulamalarla paylaşır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудований. Спільно використовує навички, агентів та інструменти з ~/.turbospark з іншими застосунками."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tích hợp sẵn. Dùng chung kỹ năng, tác tử và công cụ trong ~/.turbospark với các ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置。与其他应用共享 ~/.turbospark 中的技能、智能体和工具。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "內建。與其他 App 共享 ~/.turbospark 中的技能、代理程式和工具。"
          }
        }
      }
    },
