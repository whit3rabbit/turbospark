        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0942\u0932\u094d\u0938 \u0915\u094b \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0915\u0930\u0947\u0902 (\u0938\u0902\u0935\u093e\u0926\u093e\u0924\u094d\u092e\u0915 \u0938\u0902\u0915\u0947\u0924 \u091b\u094b\u0921\u093c\u0947\u0902)"
