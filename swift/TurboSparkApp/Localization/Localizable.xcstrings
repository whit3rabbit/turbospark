    "Give the directive: /fork Turn the last answer into a test plan.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u062f\u062e\u0644 \u0627\u0644\u062a\u0648\u062c\u064a\u0647: /fork \u062d\u0648\u0651\u0644 \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 \u0625\u0644\u0649 \u062e\u0637\u0629 \u0627\u062e\u062a\u0628\u0627\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie die Anweisung an: /fork Mach aus der letzten Antwort einen Testplan."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give the directive: /fork Turn the last answer into a test plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe la instrucci\u00f3n: /fork Convierte la \u00faltima respuesta en un plan de pruebas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquez la consigne : /fork Transforme la derni\u00e8re r\u00e9ponse en plan de test."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05ea\u05d5\u05d1 \u05d0\u05ea \u05d4\u05d4\u05e0\u05d7\u05d9\u05d4: /fork \u05d4\u05e4\u05d5\u05da \u05d0\u05ea \u05d4\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 \u05dc\u05ea\u05d5\u05db\u05e0\u05d9\u05ea \u05d1\u05d3\u05d9\u05e7\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0932\u093f\u0916\u0947\u0902: /fork \u092a\u093f\u091b\u0932\u0947 \u0909\u0924\u094d\u0924\u0930 \u0915\u094b \u090f\u0915 \u092a\u0930\u0940\u0915\u094d\u0937\u0923 \u092f\u094b\u091c\u0928\u093e \u092e\u0947\u0902 \u092c\u0926\u0932\u094b\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis arahannya: /fork Ubah jawaban terakhir menjadi rencana pengujian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi l'istruzione: /fork Trasforma l'ultima risposta in un piano di test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6307\u793a\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044: /fork \u6700\u5f8c\u306e\u56de\u7b54\u3092\u30c6\u30b9\u30c8\u8a08\u753b\u306b\u3057\u3066\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uc2dc\ub97c \uc785\ub825\ud558\uc138\uc694: /fork \ub9c8\uc9c0\ub9c9 \ub2f5\ubcc0\uc744 \ud14c\uc2a4\ud2b8 \uacc4\ud68d\uc73c\ub85c \ubc14\uafd4 \uc918."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de opdracht op: /fork Maak van het laatste antwoord een testplan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj polecenie: /fork Zamie\u0144 ostatni\u0105 odpowied\u017a w plan test\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva a instru\u00e7\u00e3o: /fork Transforme a \u00faltima resposta em um plano de testes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0437\u0430\u0434\u0430\u043d\u0438\u0435: /fork \u041f\u0440\u0435\u0432\u0440\u0430\u0442\u0438 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0438\u0439 \u043e\u0442\u0432\u0435\u0442 \u0432 \u043f\u043b\u0430\u043d \u0442\u0435\u0441\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv instruktionen: /fork G\u00f6r om det senaste svaret till en testplan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Talimat\u0131 yaz\u0131n: /fork Son yan\u0131t\u0131 bir test plan\u0131na d\u00f6n\u00fc\u015ft\u00fcr."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043a\u0430\u0436\u0456\u0442\u044c \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f: /fork \u041f\u0435\u0440\u0435\u0442\u0432\u043e\u0440\u0438 \u043e\u0441\u0442\u0430\u043d\u043d\u044e \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u043d\u0430 \u043f\u043b\u0430\u043d \u0442\u0435\u0441\u0442\u0443\u0432\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1eadp ch\u1ec9 th\u1ecb: /fork Bi\u1ebfn c\u00e2u tr\u1ea3 l\u1eddi cu\u1ed1i th\u00e0nh k\u1ebf ho\u1ea1ch ki\u1ec3m th\u1eed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u8f93\u5165\u6307\u4ee4\uff1a/fork \u628a\u4e0a\u4e00\u6761\u56de\u7b54\u6574\u7406\u6210\u6d4b\u8bd5\u8ba1\u5212\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u8f38\u5165\u6307\u4ee4\uff1a/fork \u628a\u4e0a\u4e00\u5247\u56de\u7b54\u6574\u7406\u6210\u6e2c\u8a66\u8a08\u756b\u3002"
          }
        }
      }
    },
