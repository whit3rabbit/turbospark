    "Imported %@ SOUL.md. Enable SOUL.md to use it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0627\u0633\u062a\u064a\u0631\u0627\u062f SOUL.md \u0645\u0646 %@. \u0641\u0639\u0651\u0644 SOUL.md \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md von %@ importiert. Aktiviere SOUL.md, um es zu verwenden."
