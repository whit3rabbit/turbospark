    "Self-directed agent that iterates over multi-step tool workflows to accomplish complex objectives.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وكيل ذاتي التوجيه يكرّر سير عمل متعدد الخطوات بالأدوات لإنجاز أهداف معقدة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Selbstständiger Agent, der mehrstufige Werkzeugabläufe wiederholt, um komplexe Ziele zu erreichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Self-directed agent that iterates over multi-step tool workflows to accomplish complex objectives."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente autónomo que itera sobre flujos de herramientas de varios pasos para lograr objetivos complejos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent autonome qui enchaîne des flux d'outils en plusieurs étapes pour atteindre des objectifs complexes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוכן עצמאי שחוזר על תהליכי כלים רב-שלביים כדי להשיג מטרות מורכבות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्व-निर्देशित एजेंट जो जटिल लक्ष्यों के लिए बहु-चरणीय टूल वर्कफ़्लो दोहराता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agen mandiri yang mengulang alur kerja alat multi-langkah untuk mencapai tujuan kompleks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente autonomo che itera flussi di strumenti in più passaggi per raggiungere obiettivi complessi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "複雑な目標を達成するため、多段階のツールワークフローを繰り返す自律型エージェント。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복잡한 목표를 달성하기 위해 여러 단계의 도구 워크플로를 반복하는 자율 에이전트."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfstandige agent die meerstaps toolworkflows doorloopt om complexe doelen te bereiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samodzielny agent, który powtarza wieloetapowe przepływy narzędzi, by osiągnąć złożone cele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agente autônomo que itera fluxos de ferramentas em várias etapas para cumprir objetivos complexos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Самостоятельный агент, выполняющий многошаговые цепочки инструментов для сложных целей."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Självgående agent som itererar över verktygsflöden i flera steg för att nå komplexa mål."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karmaşık hedeflere ulaşmak için çok adımlı araç iş akışlarını yineleyen öz yönelimli ajan."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Самостійний агент, що виконує багатокрокові ланцюжки інструментів для складних цілей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tác tử tự định hướng, lặp lại quy trình công cụ nhiều bước để hoàn thành mục tiêu phức tạp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自主代理，迭代执行多步骤工具工作流以完成复杂目标。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自主代理，反覆執行多步驟工具工作流程以完成複雜目標。"
          }
        }
      }
    },
