    "No %@ number %lld: the last answer has %lld.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0648\u062c\u062f %@ \u0631\u0642\u0645 %lld: \u0639\u062f\u062f \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0641\u064a \u0627\u0644\u0625\u062c\u0627\u0628\u0629 \u0627\u0644\u0623\u062e\u064a\u0631\u0629 %lld."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ Nr. %lld gibt es nicht: Die letzte Antwort enth\u00e4lt %lld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No %@ number %lld: the last answer has %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No existe %@ n\u00famero %lld: la \u00faltima respuesta tiene %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de %@ num\u00e9ro %lld : la derni\u00e8re r\u00e9ponse en contient %lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df %@ \u05de\u05e1\u05e4\u05e8 %lld: \u05de\u05e1\u05e4\u05e8 \u05d4\u05e4\u05e8\u05d9\u05d8\u05d9\u05dd \u05d1\u05ea\u05e9\u05d5\u05d1\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4: %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u0915\u094d\u0930\u092e\u093e\u0902\u0915 %lld \u092e\u094c\u091c\u0942\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948: \u092a\u093f\u091b\u0932\u0947 \u0909\u0924\u094d\u0924\u0930 \u092e\u0947\u0902 \u0907\u0928\u0915\u0940 \u0938\u0902\u0916\u094d\u092f\u093e %lld \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada %@ nomor %lld: jawaban terakhir memiliki %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non esiste %@ numero %lld: l'ultima risposta ne contiene %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u306e %lld \u756a\u76ee\u306f\u3042\u308a\u307e\u305b\u3093\u3002\u6700\u5f8c\u306e\u56de\u7b54\u306b\u306f %lld \u500b\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %lld\ubc88\uc740 \uc5c6\uc2b5\ub2c8\ub2e4. \ub9c8\uc9c0\ub9c9 \ub2f5\ubcc0\uc5d0\ub294 %lld\uac1c\uac00 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen %@ nummer %lld: het laatste antwoord bevat er %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak elementu %@ nr %lld: liczba w ostatniej odpowiedzi: %lld."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o existe %@ n\u00famero %lld: a \u00faltima resposta tem %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u0430 %@ \u2116 %lld: \u043a\u043e\u043b\u0438\u0447\u0435\u0441\u0442\u0432\u043e \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c \u043e\u0442\u0432\u0435\u0442\u0435: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nummer %lld finns inte: det senaste svaret har %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ #%lld bulunamad\u0131: son yan\u0131tta %lld tane var."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0435\u043b\u0435\u043c\u0435\u043d\u0442\u0430 %@ \u2116 %lld: \u043a\u0456\u043b\u044c\u043a\u0456\u0441\u0442\u044c \u0432 \u043e\u0441\u0442\u0430\u043d\u043d\u0456\u0439 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0456: %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 %@ s\u1ed1 %lld: c\u00e2u tr\u1ea3 l\u1eddi g\u1ea7n nh\u1ea5t c\u00f3 %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u7f16\u53f7 %lld \u4e0d\u5b58\u5728\uff1a\u4e0a\u4e00\u6761\u56de\u7b54\u4e2d\u5171\u6709 %lld \u4e2a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u7de8\u865f %lld \u4e0d\u5b58\u5728\uff1a\u4e0a\u4e00\u5247\u56de\u7b54\u4e2d\u5171\u6709 %lld \u500b\u3002"
          }
        }
      }
    },
    "No active model session. Please load a model first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u062c\u0644\u0633\u0629 \u0646\u0645\u0648\u0630\u062c \u0646\u0634\u0637\u0629. \u064a\u064f\u0631\u062c\u0649 \u062a\u062d\u0645\u064a\u0644 \u0646\u0645\u0648\u0630\u062c \u0623\u0648\u0644\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktive Modellsitzung. Laden Sie zuerst ein Modell."
          }
