    "Pasted text exceeded the %lld-token context window; kept the first %lld characters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجاوز النص الملصق نافذة السياق البالغة %lld رمزًا؛ تم الاحتفاظ بأول %lld حرفًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingefügte Text überschritt das %lld-Token-Kontextfenster; die ersten %lld Zeichen wurden behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasted text exceeded the %lld-token context window; kept the first %lld characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto pegado superó la ventana de contexto de %lld tokens; se conservaron los primeros %lld caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte collé a dépassé la fenêtre de contexte de %lld jetons ; les %lld premiers caractères ont été conservés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הטקסט שהודבק חרג מחלון ההקשר של %lld אסימונים; נשמרו %lld התווים הראשונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पेस्ट किया गया टेक्स्ट %lld-टोकन संदर्भ विंडो से अधिक था; पहले %lld वर्ण रखे गए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang ditempel melebihi jendela konteks %lld token; %lld karakter pertama dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo incollato ha superato la finestra di contesto di %lld token; conservati i primi %lld caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "貼り付けたテキストが %lld トークンのコンテキストウィンドウを超えたため、最初の %lld 文字を保持しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "붙여넣은 텍스트가 %lld 토큰 컨텍스트 창을 초과하여 처음 %lld자를 유지했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geplakte tekst overtrad het %lld-token contextvenster; de eerste %lld tekens zijn bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklejony tekst przekroczył okno kontekstu %lld tokenów; zachowano pierwsze %lld znaków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto colado excedeu a janela de contexto de %lld tokens; os primeiros %lld caracteres foram mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставленный текст превысил контекстное окно в %lld токенов; сохранены первые %lld символов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den inklistrade texten överskred kontextfönstret på %lld token; de första %lld tecknen behölls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapıştırılan metin %lld token bağlam penceresini aştı; ilk %lld karakter korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставлений текст перевищив контекстне вікно у %lld токенів; збережено перші %lld символів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản dán đã vượt quá cửa sổ ngữ cảnh %lld token; giữ lại %lld ký tự đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴的文本超出了 %lld 个 token 的上下文窗口；已保留前 %lld 个字符。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上的文字超出了 %lld 個 token 的上下文視窗；已保留前 %lld 個字元。"
          }
        }
      }
    },
