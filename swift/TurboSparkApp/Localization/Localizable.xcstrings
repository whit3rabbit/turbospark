        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u043c\u0430\u044e \u043f\u0440\u0430\u0432\u043e \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0446\u0435\u0439 \u0433\u043e\u043b\u043e\u0441"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
