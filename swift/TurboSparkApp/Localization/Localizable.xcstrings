    "Reasoning effort: %@. Click to change (takes effect immediately without reloading model).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0633\u062a\u0648\u0649 \u0627\u0644\u062a\u0641\u0643\u064a\u0631: %@. \u0627\u0646\u0642\u0631 \u0644\u0644\u062a\u063a\u064a\u064a\u0631 (\u064a\u0633\u0631\u064a \u0641\u0648\u0631\u064b\u0627 \u062f\u0648\u0646 \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Denkaufwand: %@. Klicken zum \u00c4ndern (wirkt sofort, ohne das Modell neu zu laden)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasoning effort: %@. Click to change (takes effect immediately without reloading model)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esfuerzo de razonamiento: %@. Haz clic para cambiarlo (se aplica de inmediato sin recargar el modelo)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effort de raisonnement : %@. Cliquez pour le modifier (prend effet imm\u00e9diatement sans recharger le mod\u00e8le)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d0\u05de\u05e5 \u05d7\u05e9\u05d9\u05d1\u05d4: %@. \u05dc\u05d7\u05e5 \u05db\u05d3\u05d9 \u05dc\u05e9\u05e0\u05d5\u05ea (\u05e0\u05db\u05e0\u05e1 \u05dc\u05ea\u05d5\u05e7\u05e3 \u05de\u05d9\u05d3 \u05d1\u05dc\u05d9 \u05dc\u05d8\u05e2\u05d5\u05df \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05d7\u05d3\u05e9)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0930\u094d\u0915 \u092a\u094d\u0930\u092f\u093e\u0938: %@\u0964 \u092c\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902 (\u092e\u0949\u0921\u0932 \u0926\u094b\u092c\u093e\u0930\u093e \u0932\u094b\u0921 \u0915\u093f\u090f \u092c\u093f\u0928\u093e \u0924\u0941\u0930\u0902\u0924 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u093e \u0939\u0948)\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Upaya penalaran: %@. Klik untuk mengubah (langsung berlaku tanpa memuat ulang model)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sforzo di ragionamento: %@. Fai clic per cambiarlo (ha effetto subito senza ricaricare il modello)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a8\u8ad6\u306e\u6df1\u3055: %@\u3002\u30af\u30ea\u30c3\u30af\u3057\u3066\u5909\u66f4 (\u30e2\u30c7\u30eb\u3092\u518d\u8aad\u307f\u8fbc\u307f\u305b\u305a\u306b\u3059\u3050\u306b\u53cd\u6620\u3055\u308c\u307e\u3059)\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucd94\ub860 \ub178\ub825: %@. \ud074\ub9ad\ud558\uc5ec \ubcc0\uacbd\ud569\ub2c8\ub2e4(\ubaa8\ub378\uc744 \ub2e4\uc2dc \ub85c\ub4dc\ud558\uc9c0 \uc54a\uace0 \uc989\uc2dc \uc801\uc6a9)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Redeneerinspanning: %@. Klik om te wijzigen (werkt direct, zonder het model opnieuw te laden)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysi\u0142ek rozumowania: %@. Kliknij, aby zmieni\u0107 (dzia\u0142a od razu, bez ponownego \u0142adowania modelu)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esfor\u00e7o de racioc\u00ednio: %@. Clique para alterar (entra em vigor imediatamente sem recarregar o modelo)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043b\u0443\u0431\u0438\u043d\u0430 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439: %@. \u041d\u0430\u0436\u043c\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c (\u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u0441\u0440\u0430\u0437\u0443, \u0431\u0435\u0437 \u043f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043c\u043e\u0434\u0435\u043b\u0438)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Resonemangsinsats: %@. Klicka f\u00f6r att \u00e4ndra (g\u00e4ller direkt utan att modellen laddas om)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u0131l y\u00fcr\u00fctme \u00e7abas\u0131: %@. De\u011fi\u015ftirmek i\u00e7in t\u0131klay\u0131n (model yeniden y\u00fcklenmeden hemen ge\u00e7erli olur)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0456\u0432\u0435\u043d\u044c \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u044c: %@. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 (\u0434\u0456\u0454 \u043e\u0434\u0440\u0430\u0437\u0443, \u0431\u0435\u0437 \u043f\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043c\u043e\u0434\u0435\u043b\u0456)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u1ed7 l\u1ef1c l\u1eadp lu\u1eadn: %@. Nh\u1ea5p \u0111\u1ec3 thay \u0111\u1ed5i (c\u00f3 hi\u1ec7u l\u1ef1c ngay m\u00e0 kh\u00f4ng c\u1ea7n t\u1ea3i l\u1ea1i m\u00f4 h\u00ecnh)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u601d\u8003\u6df1\u5ea6\uff1a%@\u3002\u70b9\u6309\u4ee5\u66f4\u6539\uff08\u7acb\u5373\u751f\u6548\uff0c\u65e0\u9700\u91cd\u65b0\u52a0\u8f7d\u6a21\u578b\uff09\u3002"
          }
