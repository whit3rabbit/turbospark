          }
        }
      }
    },
    "This model's family does not dispatch the steering edit.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0637\u0628\u0651\u0642 \u0639\u0627\u0626\u0644\u0629 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u062a\u0648\u062c\u064a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Familie dieses Modells f\u00fchrt den Steuerungseingriff nicht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model's family does not dispatch the steering edit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La familia de este modelo no aplica la edici\u00f3n de direcci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La famille de ce mod\u00e8le n'applique pas la modification de guidage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e9\u05e4\u05d7\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d6\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e4\u05e2\u05d9\u05dc\u05d4 \u05d0\u05ea \u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05d4\u05d9\u05d2\u05d5\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u093e \u092a\u0930\u093f\u0935\u093e\u0930 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0938\u0902\u092a\u093e\u0926\u0928 \u0932\u093e\u0917\u0942 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarga model ini tidak menjalankan edit kemudi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La famiglia di questo modello non applica la modifica di sterzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e2\u30c7\u30eb\u306e\u30d5\u30a1\u30df\u30ea\u30fc\u306f\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u306e\u7de8\u96c6\u3092\u9069\u7528\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubaa8\ub378\uc758 \uc81c\ud488\uad70\uc740 \uc870\ud5a5 \ud3b8\uc9d1\uc744 \uc801\uc6a9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De familie van dit model voert de besturingsbewerking niet uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodzina tego modelu nie stosuje edycji sterowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fam\u00edlia deste modelo n\u00e3o aplica a edi\u00e7\u00e3o de direcionamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
