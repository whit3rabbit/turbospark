        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The restored encrypted database failed its integrity check."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos cifrada restaurada no super\u00f3 la comprobaci\u00f3n de integridad."
