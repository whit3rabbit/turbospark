    "Browse a marketplace, or add a local folder containing .claude-plugin/plugin.json.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0635\u0641\u062d \u0633\u0648\u0642\u0627 \u0623\u0648 \u0623\u0636\u0641 \u0645\u062c\u0644\u062f\u0627 \u0645\u062d\u0644\u064a\u0627 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u200e.claude-plugin/plugin.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie einen Marktplatz oder f\u00fcgen Sie einen lokalen Ordner mit .claude-plugin/plugin.json hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Browse a marketplace, or add a local folder containing .claude-plugin/plugin.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora un marketplace o a\u00f1ade una carpeta local que contenga .claude-plugin/plugin.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parcourez une place de march\u00e9 ou ajoutez un dossier local contenant .claude-plugin/plugin.json."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d9\u05d9\u05df \u05d1\u05de\u05e8\u05db\u05d6 \u05d0\u05d5 \u05d4\u05d5\u05e1\u05e3 \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05de\u05e7\u05d5\u05de\u05d9\u05ea \u05e9\u05de\u05db\u05d9\u05dc\u05d4 \u200e.claude-plugin/plugin.json."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u093e\u0930\u094d\u0915\u0947\u091f\u092a\u094d\u0932\u0947\u0938 \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0915\u0930\u0947\u0902, \u092f\u093e .claude-plugin/plugin.json \u0935\u093e\u0932\u093e \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi marketplace, atau tambahkan folder lokal yang berisi .claude-plugin/plugin.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora un marketplace o aggiungi una cartella locale che contenga .claude-plugin/plugin.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30de\u30fc\u30b1\u30c3\u30c8\u30d7\u30ec\u30a4\u30b9\u3092\u53c2\u7167\u3059\u308b\u304b\u3001.claude-plugin/plugin.json \u3092\u542b\u3080\u30ed\u30fc\u30ab\u30eb\u30d5\u30a9\u30eb\u30c0\u3092\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\ucf13\ud50c\ub808\uc774\uc2a4\ub97c \uc0b4\ud3b4\ubcf4\uac70\ub098 .claude-plugin/plugin.json\uc774 \uc788\ub294 \ub85c\uceec \ud3f4\ub354\ub97c \ucd94\uac00\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blader door een marktplaats of voeg een lokale map toe met .claude-plugin/plugin.json."
