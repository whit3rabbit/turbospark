        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Globalna osobowo\u015b\u0107 i wskaz\u00f3wki komunikacyjne dla agenta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Personalidade global e orienta\u00e7\u00e3o de comunica\u00e7\u00e3o para o agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0449\u0438\u0435 \u0443\u043a\u0430\u0437\u0430\u043d\u0438\u044f \u043f\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0443 \u0438 \u043e\u0431\u0449\u0435\u043d\u0438\u044e \u0430\u0433\u0435\u043d\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Global personlighet och kommunikationsv\u00e4gledning f\u00f6r agenten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan i\u00e7in k\u00fcresel ki\u015filik ve ileti\u015fim y\u00f6nergeleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0430\u043b\u044c\u043d\u0456 \u0432\u043a\u0430\u0437\u0456\u0432\u043a\u0438 \u0449\u043e\u0434\u043e \u0445\u0430\u0440\u0430\u043a\u0442\u0435\u0440\u0443 \u0442\u0430 \u0441\u043f\u0456\u043b\u043a\u0443\u0432\u0430\u043d\u043d\u044f \u0430\u0433\u0435\u043d\u0442\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u01b0\u1edbng d\u1eabn v\u1ec1 t\u00ednh c\u00e1ch v\u00e0 giao ti\u1ebfp to\u00e0n c\u1ee5c cho t\u00e1c nh\u00e2n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee3\u7406\u7684\u5168\u5c40\u4e2a\u6027\u548c\u6c9f\u901a\u6307\u5bfc\u3002"
