        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0443\u0442 \u0437\u2019\u044f\u0432\u043b\u044f\u044e\u0442\u044c\u0441\u044f \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f."
