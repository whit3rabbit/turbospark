        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मॉडल आवाज़ खुद चुनता है। अपनी चुनी हुई आवाज़ में बोलने के लिए आवाज क्लोनिंग का उपयोग करें।"
