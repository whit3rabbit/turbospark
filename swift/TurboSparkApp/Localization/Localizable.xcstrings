        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u601d\u8003\u5f37\u5ea6\uff1a%@\u3002\u6309\u4e00\u4e0b\u4ee5\u8b8a\u66f4\uff08\u7acb\u5373\u751f\u6548\uff0c\u7121\u9700\u91cd\u65b0\u8f09\u5165\u6a21\u578b\uff09\u3002"
