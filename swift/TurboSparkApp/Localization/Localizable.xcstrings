        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043e. \u0414\u0443\u0448\u0443 \u043d\u0435 \u0432\u0438\u0431\u0440\u0430\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 b\u1eadt. Ch\u01b0a ch\u1ecdn soul n\u00e0o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u542f\u7528\u3002\u672a\u9009\u62e9 SOUL\u3002"
          }
