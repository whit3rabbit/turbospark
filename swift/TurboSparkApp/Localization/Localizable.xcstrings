    "Press Esc again to stop": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0636\u063a\u0637 Esc \u0645\u0631\u0629 \u0623\u062e\u0631\u0649 \u0644\u0644\u0625\u064a\u0642\u0627\u0641"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dr\u00fccken Sie erneut Esc, um zu stoppen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Esc again to stop"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Esc otra vez para detener"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez de nouveau sur \u00c9chap pour arr\u00eater"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e7\u05e9 Esc \u05e9\u05d5\u05d1 \u05db\u05d3\u05d9 \u05dc\u05e2\u05e6\u05d5\u05e8"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u093f\u0930 \u0938\u0947 Esc \u0926\u092c\u093e\u090f\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekan Esc lagi untuk berhenti"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi di nuovo Esc per interrompere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u3059\u308b\u306b\u306f\u3082\u3046\u4e00\u5ea6 Esc \u3092\u62bc\u3057\u3066\u304f\u3060\u3055\u3044"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc911\uc9c0\ud558\ub824\uba74 Esc\ub97c \ud55c \ubc88 \ub354 \ub204\ub974\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk nogmaals op Esc om te stoppen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naci\u015bnij ponownie Esc, aby zatrzyma\u0107"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pressione Esc novamente para parar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 Esc \u0435\u0449\u0435 \u0440\u0430\u0437, \u0447\u0442\u043e\u0431\u044b \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck p\u00e5 Esc igen f\u00f6r att stoppa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durdurmak i\u00e7in yeniden Esc'ye bas\u0131n"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c Esc \u0449\u0435 \u0440\u0430\u0437, \u0449\u043e\u0431 \u0437\u0443\u043f\u0438\u043d\u0438\u0442\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1ea5n Esc l\u1ea7n n\u1eefa \u0111\u1ec3 d\u1eebng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
