        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d6\u05d9\u05d4\u05d5\u05d9 \u05d4\u05d3\u05d9\u05d1\u05d5\u05e8 \u05db\u05d1\u05d5\u05d9 \u05e2\u05d1\u05d5\u05e8 TurboSpark. \u05d4\u05e4\u05e2\u05dc \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u0915\u0947 \u0932\u093f\u090f \u0935\u093e\u0915\u094d \u092a\u0939\u091a\u093e\u0928 \u092c\u0902\u0926 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengenalan ucapan untuk TurboSpark nonaktif. Aktifkan di Pengaturan Sistem."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il riconoscimento vocale \u00e8 disattivato per TurboSpark. Attivalo in Impostazioni di Sistema."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u306e\u97f3\u58f0\u8a8d\u8b58\u306f\u30aa\u30d5\u3067\u3059\u3002\u30b7\u30b9\u30c6\u30e0\u8a2d\u5b9a\u3067\u30aa\u30f3\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark\uc758 \uc74c\uc131 \uc778\uc2dd\uc774 \uaebc\uc838 \uc788\uc2b5\ub2c8\ub2e4. \uc2dc\uc2a4\ud15c \uc124\uc815\uc5d0\uc11c \ucf1c\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spraakherkenning staat uit voor TurboSpark. Zet deze aan in Systeeminstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoznawanie mowy jest wy\u0142\u0105czone dla TurboSpark. W\u0142\u0105cz je w Ustawieniach systemowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O reconhecimento de fala est\u00e1 desativado para o TurboSpark. Ative-o nos Ajustes do Sistema."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0432\u0430\u043d\u0438\u0435 \u0440\u0435\u0447\u0438 \u0434\u043b\u044f TurboSpark \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e. \u0412\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e \u0432 \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Taligenk\u00e4nning \u00e4r avst\u00e4ngd f\u00f6r TurboSpark. Sl\u00e5 p\u00e5 den i Systeminst\u00e4llningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark i\u00e7in konu\u015fma tan\u0131ma kapal\u0131. Sistem Ayarlar\u0131'ndan a\u00e7\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0432\u0430\u043d\u043d\u044f \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0434\u043b\u044f TurboSpark \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u0423\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0439\u043e\u0433\u043e \u0432 \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0438\u0445 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0430\u0445."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1eadn d\u1ea1ng gi\u1ecdng n\u00f3i \u0111ang t\u1eaft \u0111\u1ed1i v\u1edbi TurboSpark. H\u00e3y b\u1eadt trong C\u00e0i \u0111\u1eb7t h\u1ec7 th\u1ed1ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u7684\u8bed\u97f3\u8bc6\u522b\u5df2\u5173\u95ed\u3002\u8bf7\u5728\u201c\u7cfb\u7edf\u8bbe\u7f6e\u201d\u4e2d\u5f00\u542f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u7684\u8a9e\u97f3\u8fa8\u8b58\u5df2\u95dc\u9589\u3002\u8acb\u5728\u300c\u7cfb\u7d71\u8a2d\u5b9a\u300d\u4e2d\u958b\u555f\u3002"
          }
        }
      }
    },
