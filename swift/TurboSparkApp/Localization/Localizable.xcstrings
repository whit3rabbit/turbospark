    "Manage codebase root, agent profile, rules, and execution permissions.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage codebase root, agent profile, rules, and execution permissions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona la raíz del código, el perfil del agente, las reglas y los permisos de ejecución."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez la racine du code, le profil de l'agent, les règles et les autorisations d'exécution."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie das Code-Stammverzeichnis, das Agent-Profil, Regeln und Ausführungsberechtigungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci la radice del codice, il profilo dell'agente, le regole e i permessi di esecuzione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie a raiz do código, o perfil do agente, as regras e as permissões de execução."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте корнем кода, профилем агента, правилами и разрешениями на выполнение."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードベースのルート、エージェントプロファイル、ルール、実行権限を管理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드베이스 루트, 에이전트 프로필, 규칙, 실행 권한을 관리합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "管理代码库根目录、代理配置、规则和执行权限。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理程式碼庫根目錄、代理設定檔、規則與執行權限。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر جذر قاعدة الشفرة وملف تعريف الوكيل والقواعد وأذونات التنفيذ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נהל את שורש בסיס הקוד, פרופיל הסוכן, כללים והרשאות הרצה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोडबेस रूट, एजेंट प्रोफ़ाइल, नियम और निष्पादन अनुमतियां प्रबंधित करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer de hoofdmap van de codebase, het agentprofiel, regels en uitvoeringsmachtigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzaj katalogiem głównym kodu, profilem agenta, regułami i uprawnieniami do wykonywania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod tabanı kökünü, aracı profilini, kuralları ve yürütme izinlerini yönetin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте коренем коду, профілем агента, правилами та дозволами на виконання."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera kodbasens rotkatalog, agentprofil, regler och körningsbehörigheter."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quản lý thư mục gốc mã nguồn, hồ sơ tác nhân, quy tắc và quyền thực thi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola root basis kode, profil agen, aturan, dan izin eksekusi."
          }
        }
      }
    },
