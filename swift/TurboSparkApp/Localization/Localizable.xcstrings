            "value": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u0443\u0439\u0442\u0435 \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0437\u0432\u0443\u043a\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u0439\u0442\u0435 \u0430\u0431\u043e \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u0437\u0432\u0443\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y nh\u1eadp ho\u1eb7c ch\u1ecdn ngu\u1ed3n \u00e2m thanh tr\u01b0\u1edbc."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5148\u306b\u97f3\u58f0\u30bd\u30fc\u30b9\u3092\u8aad\u307f\u8fbc\u3080\u304b\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uba3c\uc800 \uc624\ub514\uc624 \uc18c\uc2a4\ub97c \uac00\uc838\uc624\uac70\ub098 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u5bfc\u5165\u6216\u9009\u62e9\u97f3\u9891\u6765\u6e90\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u532f\u5165\u6216\u9078\u64c7\u97f3\u8a0a\u4f86\u6e90\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u0648\u0631\u062f \u0645\u0635\u062f\u0631 \u0635\u0648\u062a \u0623\u0648 \u062d\u062f\u062f\u0647 \u0623\u0648\u0644\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05d9\u05d1\u05d0 \u05d0\u05d5 \u05d1\u05d7\u05e8 \u05de\u05e7\u05d5\u05e8 \u05e9\u05de\u05e2 \u05ea\u05d7\u05d9\u05dc\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0939\u0932\u0947 \u0911\u0921\u093f\u092f\u094b \u0938\u094d\u0930\u094b\u0924 \u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902 \u092f\u093e \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
