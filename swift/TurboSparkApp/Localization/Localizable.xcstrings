    "Enter a GitHub repository (e.g. 'whit3rabbit/agent-skills') or direct HTTPS URL to browse and install remote skills.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مستودع GitHub (مثل 'whit3rabbit/agent-skills') أو عنوان HTTPS مباشرا لتصفح المهارات البعيدة وتثبيتها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie ein GitHub-Repository (z. B. 'whit3rabbit/agent-skills') oder eine direkte HTTPS-URL ein, um Remote-Skills zu durchsuchen und zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a GitHub repository (e.g. 'whit3rabbit/agent-skills') or direct HTTPS URL to browse and install remote skills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un repositorio de GitHub (p. ej. 'whit3rabbit/agent-skills') o una URL HTTPS directa para explorar e instalar habilidades remotas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez un dépôt GitHub (par ex. 'whit3rabbit/agent-skills') ou une URL HTTPS directe pour parcourir et installer des compétences distantes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזן מאגר GitHub (למשל 'whit3rabbit/agent-skills') או כתובת HTTPS ישירה כדי לעיין במיומנויות מרוחקות ולהתקין אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिमोट स्किल ब्राउज़ और इंस्टॉल करने के लिए GitHub रिपॉजिटरी (जैसे 'whit3rabbit/agent-skills') या सीधा HTTPS URL दर्ज करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan repositori GitHub (mis. 'whit3rabbit/agent-skills') atau URL HTTPS langsung untuk menjelajahi dan memasang keterampilan jarak jauh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un repository GitHub (ad es. 'whit3rabbit/agent-skills') o un URL HTTPS diretto per esplorare e installare competenze remote."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リモートスキルを閲覧してインストールするには、GitHub リポジトリ (例: 'whit3rabbit/agent-skills') または HTTPS URL を直接入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원격 스킬을 살펴보고 설치하려면 GitHub 리포지토리(예: 'whit3rabbit/agent-skills') 또는 직접 HTTPS URL을 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een GitHub-repository in (bijv. 'whit3rabbit/agent-skills') of een directe HTTPS-URL om externe skills te bekijken en te installeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj repozytorium GitHub (np. 'whit3rabbit/agent-skills') lub bezpośredni adres HTTPS, aby przeglądać i instalować zdalne umiejętności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe um repositório do GitHub (ex.: 'whit3rabbit/agent-skills') ou uma URL HTTPS direta para navegar e instalar habilidades remotas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите репозиторий GitHub (например, 'whit3rabbit/agent-skills') или прямой HTTPS-адрес, чтобы просматривать и устанавливать удаленные навыки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en GitHub-utvecklingskatalog (t.ex. 'whit3rabbit/agent-skills') eller en direkt HTTPS-adress för att bläddra bland och installera fjärrfärdigheter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzak becerileri incelemek ve kurmak için bir GitHub deposu (ör. 'whit3rabbit/agent-skills') veya doğrudan HTTPS adresi girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть репозиторій GitHub (наприклад, 'whit3rabbit/agent-skills') або пряму HTTPS-адресу, щоб переглядати та встановлювати віддалені навички."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập kho GitHub (ví dụ 'whit3rabbit/agent-skills') hoặc URL HTTPS trực tiếp để duyệt và cài đặt kỹ năng từ xa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 GitHub 仓库 (例如 'whit3rabbit/agent-skills') 或直接的 HTTPS 网址，以浏览和安装远程技能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 GitHub 儲存庫 (例如 'whit3rabbit/agent-skills') 或直接的 HTTPS 網址，以瀏覽並安裝遠端技能。"
          }
        }
      }
    },
