    "Stop the server to edit. Leave the port blank for automatic assignment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0648\u0642\u0641 \u0627\u0644\u062e\u0627\u062f\u0645 \u0644\u0644\u062a\u062d\u0631\u064a\u0631. \u0627\u062a\u0631\u0643 \u0627\u0644\u0645\u0646\u0641\u0630 \u0641\u0627\u0631\u063a\u064b\u0627 \u0644\u0644\u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bearbeiten den Server stoppen. F\u00fcr automatische Zuweisung den Port leer lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the server to edit. Leave the port blank for automatic assignment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Det\u00e9n el servidor para editar. Deja el puerto vac\u00edo para asignarlo autom\u00e1ticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eatez le serveur pour modifier. Laissez le port vide pour une attribution automatique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05e9 \u05dc\u05e2\u05e6\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e9\u05e8\u05ea \u05dc\u05e2\u05e8\u05d9\u05db\u05d4. \u05d9\u05e9 \u05dc\u05d4\u05e9\u05d0\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e6\u05d9\u05d0\u05d4 \u05e8\u05d9\u05e7\u05d4 \u05dc\u05d4\u05e7\u05e6\u05d0\u05d4 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u092a\u093e\u0926\u0928 \u0915\u0947 \u0932\u093f\u090f \u0938\u0930\u094d\u0935\u0930 \u0930\u094b\u0915\u0947\u0902\u0964 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0906\u0935\u0902\u091f\u0928 \u0915\u0947 \u0932\u093f\u090f \u092a\u094b\u0930\u094d\u091f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan server untuk mengedit. Kosongkan port untuk penetapan otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arresta il server per modificare. Lascia vuota la porta per assegnarla automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7de8\u96c6\u3059\u308b\u306b\u306f\u30b5\u30fc\u30d0\u30fc\u3092\u505c\u6b62\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u81ea\u52d5\u5272\u308a\u5f53\u3066\u306b\u306f\u30dd\u30fc\u30c8\u3092\u7a7a\u6b04\u306b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud3b8\uc9d1\ud558\ub824\uba74 \uc11c\ubc84\ub97c \uc911\uc9c0\ud558\uc138\uc694. \uc790\ub3d9 \ud560\ub2f9\uc740 \ud3ec\ud2b8\ub97c \ube44\uc6cc \ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop de server om te bewerken. Laat de poort leeg voor automatische toewijzing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj serwer, aby edytowa\u0107. Pozostaw port pusty, aby przypisa\u0107 go automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare o servidor para editar. Deixe a porta vazia para atribui\u00e7\u00e3o autom\u00e1tica."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0441\u0435\u0440\u0432\u0435\u0440 \u0434\u043b\u044f \u0440\u0435\u0434\u0430\u043a\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f. \u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u043e\u0440\u0442 \u043f\u0443\u0441\u0442\u044b\u043c \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u043e\u0433\u043e \u043d\u0430\u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa servern f\u00f6r att redigera. L\u00e4mna porten tom f\u00f6r automatisk tilldelning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00fczenlemek i\u00e7in sunucuyu durdurun. Otomatik atama i\u00e7in portu bo\u015f b\u0131rak\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u0441\u0435\u0440\u0432\u0435\u0440 \u0434\u043b\u044f \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f. \u0417\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u0442 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c \u0434\u043b\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u0433\u043e \u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u1eebng m\u00e1y ch\u1ee7 \u0111\u1ec3 ch\u1ec9nh s\u1eeda. \u0110\u1ec3 tr\u1ed1ng c\u1ed5ng \u0111\u1ec3 t\u1ef1 \u0111\u1ed9ng g\u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u670d\u52a1\u5668\u540e\u7f16\u8f91\u3002\u7aef\u53e3\u7559\u7a7a\u53ef\u81ea\u52a8\u5206\u914d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u4f3a\u670d\u5668\u5f8c\u7de8\u8f2f\u3002\u9023\u63a5\u57e0\u7559\u7a7a\u53ef\u81ea\u52d5\u5206\u914d\u3002"
          }
        }
      }
    },
