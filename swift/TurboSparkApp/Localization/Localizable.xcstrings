    "Saved bookmarks exceed the 2 MiB settings limit.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0625\u0634\u0627\u0631\u0627\u062a \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u062d\u062f \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0628\u0627\u0644\u063a 2 \u0645\u064a\u0628\u064a\u0628\u0627\u064a\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Lesezeichen \u00fcberschreiten das Einstellungslimit von 2 MiB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved bookmarks exceed the 2 MiB settings limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los marcadores guardados superan el l\u00edmite de 2 MiB de los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les favoris enregistr\u00e9s d\u00e9passent la limite de 2 Mio des r\u00e9glages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e1\u05d9\u05de\u05e0\u05d9\u05d5\u05ea \u05d4\u05e9\u05de\u05d5\u05e8\u05d5\u05ea \u05d7\u05d5\u05e8\u05d2\u05d5\u05ea \u05de\u05de\u05d2\u05d1\u05dc\u05ea \u05d4\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e9\u05dc 2 MiB."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0939\u0947\u091c\u0947 \u0917\u090f \u092c\u0941\u0915\u092e\u093e\u0930\u094d\u0915 \u0938\u0947\u091f\u093f\u0902\u0917 \u0915\u0940 2 MiB \u0938\u0940\u092e\u093e \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bookmark tersimpan melebihi batas pengaturan 2 MiB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I segnalibri salvati superano il limite di 2 MiB delle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u5b58\u3059\u308b\u30d6\u30c3\u30af\u30de\u30fc\u30af\u304c\u8a2d\u5b9a\u306e\u4e0a\u9650 2 MiB \u3092\u8d85\u3048\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\ub41c \ubd81\ub9c8\ud06c\uac00 \uc124\uc815\uc758 2MiB \uc81c\ud55c\uc744 \ucd08\uacfc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen bladwijzers overschrijden de limiet van 2 MiB voor instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane zak\u0142adki przekraczaj\u0105 limit ustawie\u0144 wynosz\u0105cy 2 MiB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os favoritos salvos excedem o limite de 2 MiB das configura\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u044a\u0435\u043c \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u043a\u043b\u0430\u0434\u043e\u043a \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u043b\u0438\u043c\u0438\u0442 \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043a \u0432 2 \u041c\u0438\u0411."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparade bokm\u00e4rken \u00f6verskrider inst\u00e4llningsgr\u00e4nsen p\u00e5 2 MiB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen yer i\u015faretleri 2 MiB ayar s\u0131n\u0131r\u0131n\u0131 a\u015f\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0437\u0430\u043a\u043b\u0430\u0434\u043a\u0438 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u044e\u0442\u044c \u043b\u0456\u043c\u0456\u0442 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u044c \u0443 2 \u041c\u0456\u0411."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u1ea5u trang \u0111\u00e3 l\u01b0u v\u01b0\u1ee3t qu\u00e1 gi\u1edbi h\u1ea1n c\u00e0i \u0111\u1eb7t 2 MiB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4fdd\u5b58\u7684\u4e66\u7b7e\u8d85\u8fc7 2 MiB \u8bbe\u7f6e\u4e0a\u9650\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5132\u5b58\u7684\u66f8\u7c64\u8d85\u904e 2 MiB \u8a2d\u5b9a\u4e0a\u9650\u3002"
          }
        }
      }
    },
