        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d2\u05d5\u05dc\u05de\u05d9\u05ea, \u05d3\u05e8\u05da \u05d4\u05ea\u05d1\u05e0\u05d9\u05ea \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05dc \u05e2\u05e6\u05de\u05d5."
