            "state": "translated",
            "value": "Tanpa pencegahan terhadap kelebihan beban sistem"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna precauzione contro il sovraccarico del sistema"
