    "Libraries must be on a directly connected drive, not on a network share.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون المكتبات على محرك أقراص متصل مباشرةً، وليس على مشاركة شبكة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheken müssen sich auf einem direkt verbundenen Laufwerk befinden, nicht auf einer Netzwerkfreigabe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Libraries must be on a directly connected drive, not on a network share."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las bibliotecas deben estar en una unidad conectada directamente, no en un recurso compartido de red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les bibliothèques doivent se trouver sur un disque connecté directement, pas sur un partage réseau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספריות חייבות להיות על כונן המחובר ישירות, לא על שיתוף רשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी सीधे कनेक्ट की गई ड्राइव पर होनी चाहिए, नेटवर्क शेयर पर नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka harus berada di drive yang terhubung langsung, bukan di berbagi jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le librerie devono trovarsi su un'unità collegata direttamente, non su una condivisione di rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ライブラリは、ネットワーク共有ではなく、直接接続したドライブに置く必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라이브러리는 네트워크 공유가 아닌 직접 연결된 드라이브에 있어야 합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotheken moeten op een direct aangesloten schijf staan, niet op een netwerkvolume."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteki muszą znajdować się na dysku podłączonym bezpośrednio, a nie na udziale sieciowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As bibliotecas devem ficar em uma unidade conectada diretamente, não em um compartilhamento de rede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Библиотеки должны находиться на напрямую подключённом диске, а не на сетевом ресурсе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliotek måste ligga på en direkt ansluten enhet, inte på en nätverksresurs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitaplıklar, ağ paylaşımında değil, doğrudan bağlı bir sürücüde olmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Бібліотеки мають розташовуватися на напряму підключеному диску, а не на мережевому ресурсі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện phải nằm trên ổ đĩa kết nối trực tiếp, không phải trên thư mục chia sẻ mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型库必须位于直接连接的驱动器上，而不能位于网络共享上。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型庫必須位於直接連接的磁碟機上，而不能位於網路共享上。"
          }
        }
      }
    },
