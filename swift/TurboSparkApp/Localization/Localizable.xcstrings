        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r modellfamiljen st\u00f6der inte direktstyrning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model ailesi canl\u0131 y\u00f6nlendirmeyi desteklemiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435 \u0441\u0456\u043c\u0435\u0439\u0441\u0442\u0432\u043e \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u043d\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0454 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u0447\u0430\u0441\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ecd m\u00f4 h\u00ecnh n\u00e0y kh\u00f4ng h\u1ed7 tr\u1ee3 \u0111i\u1ec1u h\u01b0\u1edbng tr\u1ef1c ti\u1ebfp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u7cfb\u5217\u4e0d\u652f\u6301\u5b9e\u65f6\u5f15\u5bfc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u7cfb\u5217\u4e0d\u652f\u63f4\u5373\u6642\u5f15\u5c0e\u3002"
          }
        }
      }
    },
    "Downloads a GGUF control vector, checks its shape, and selects it for this model": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0646\u0632\u0651\u0644 \u0645\u062a\u062c\u0647 \u062a\u062d\u0643\u0645 GGUF \u0648\u064a\u062a\u062d\u0642\u0642 \u0645\u0646 \u0634\u0643\u0644\u0647 \u0648\u064a\u062d\u062f\u062f\u0647 \u0644\u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4dt einen GGUF-Steuervektor herunter, pr\u00fcft seine Form und w\u00e4hlt ihn f\u00fcr dieses Modell aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads a GGUF control vector, checks its shape, and selects it for this model"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga un vector de control GGUF, comprueba su forma y lo selecciona para este modelo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e9l\u00e9charge un vecteur de contr\u00f4le GGUF, v\u00e9rifie sa forme et le s\u00e9lectionne pour ce mod\u00e8le"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d5\u05e8\u05d9\u05d3 \u05d5\u05e7\u05d8\u05d5\u05e8 \u05d1\u05e7\u05e8\u05d4 \u05e9\u05dc GGUF, \u05d1\u05d5\u05d3\u05e7 \u05d0\u05ea \u05d4\u05e6\u05d5\u05e8\u05d4 \u05e9\u05dc\u05d5 \u05d5\u05d1\u05d5\u05d7\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05dc\u05de\u05d5\u05d3\u05dc \u05d4\u05d6\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0935\u0947\u0915\u094d\u091f\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0924\u093e \u0939\u0948, \u0909\u0938\u0915\u093e \u0906\u0915\u093e\u0930 \u091c\u093e\u0902\u091a\u0924\u093e \u0939\u0948 \u0914\u0930 \u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u0947 \u0932\u093f\u090f \u091a\u0941\u0928\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengunduh vektor kontrol GGUF, memeriksa bentuknya, dan memilihnya untuk model ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica un vettore di controllo GGUF, ne verifica la forma e lo seleziona per questo modello"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30d9\u30af\u30c8\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3001\u5f62\u72b6\u3092\u78ba\u8a8d\u3057\u3066\u3001\u3053\u306e\u30e2\u30c7\u30eb\u7528\u306b\u9078\u629e\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GGUF \uc81c\uc5b4 \ubca1\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \ud615\ud0dc\ub97c \ud655\uc778\ud55c \ub4a4 \uc774 \ubaa8\ub378\uc5d0 \uc120\ud0dd\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloadt een GGUF-stuurvector, controleert de vorm en selecteert hem voor dit model"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera wektor steruj\u0105cy GGUF, sprawdza jego kszta\u0142t i wybiera go dla tego modelu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixa um vetor de controle GGUF, verifica sua forma e o seleciona para este modelo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043a\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0439 \u0432\u0435\u043a\u0442\u043e\u0440 GGUF, \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442 \u0435\u0433\u043e \u0444\u043e\u0440\u043c\u0443 \u0438 \u0432\u044b\u0431\u0438\u0440\u0430\u0435\u0442 \u0435\u0433\u043e \u0434\u043b\u044f \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Laddar ned en GGUF-styrvektor, kontrollerar formen och v\u00e4ljer den f\u00f6r den h\u00e4r modellen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir GGUF kontrol vekt\u00f6r\u00fc indirir, \u015feklini denetler ve bu model i\u00e7in se\u00e7er"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u043a\u0435\u0440\u0443\u0432\u0430\u043b\u044c\u043d\u0438\u0439 \u0432\u0435\u043a\u0442\u043e\u0440 GGUF, \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0454 \u0439\u043e\u0433\u043e \u0444\u043e\u0440\u043c\u0443 \u0442\u0430 \u0432\u0438\u0431\u0438\u0440\u0430\u0454 \u0434\u043b\u044f \u0446\u0456\u0454\u0457 \u043c\u043e\u0434\u0435\u043b\u0456"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i vect\u01a1 \u0111i\u1ec1u khi\u1ec3n GGUF, ki\u1ec3m tra h\u00ecnh d\u1ea1ng v\u00e0 ch\u1ecdn n\u00f3 cho m\u00f4 h\u00ecnh n\u00e0y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f7d GGUF \u63a7\u5236\u5411\u91cf\uff0c\u68c0\u67e5\u5176\u5f62\u72b6\u5e76\u4e3a\u6b64\u6a21\u578b\u9009\u62e9\u5b83"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f09 GGUF \u63a7\u5236\u5411\u91cf\uff0c\u6aa2\u67e5\u5176\u5f62\u72c0\u4e26\u70ba\u6b64\u6a21\u578b\u9078\u64c7\u5b83"
          }
        }
