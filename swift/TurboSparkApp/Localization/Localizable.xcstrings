        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Capturar pr\u00e9vias de texto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0442\u0435\u043a\u0441\u0442\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00e5nga textf\u00f6rhandsvisningar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metin \u00f6nizlemelerini yakala"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0445\u043e\u043f\u043b\u044e\u0432\u0430\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456\u0439 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434 \u0442\u0435\u043a\u0441\u0442\u0443"
          }
        },
        "vi": {
