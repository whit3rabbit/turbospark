          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1ecbch tr\u00ecnh \"%@\" s\u1ebd ng\u1eebng k\u00edch ho\u1ea1t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
