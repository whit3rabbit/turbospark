        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u043e: \u0446\u0435\u0439 \u043f\u043e\u0440\u0442 \u043f\u043e\u0432\u043d\u0456\u0441\u0442\u044e \u0432\u0438\u043a\u043e\u043d\u0430\u0432 \u0446\u0435\u0439 \u0437\u0430\u043f\u0438\u0441"
