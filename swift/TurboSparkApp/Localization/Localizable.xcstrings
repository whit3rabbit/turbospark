    "Commit your changes to view the project timeline.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0641\u0651\u0630 \u0625\u064a\u062f\u0627\u0639 \u062a\u063a\u064a\u064a\u0631\u0627\u062a\u0643 \u0644\u0639\u0631\u0636 \u0627\u0644\u0645\u062e\u0637\u0637 \u0627\u0644\u0632\u0645\u0646\u064a \u0644\u0644\u0645\u0634\u0631\u0648\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Committen Sie Ihre \u00c4nderungen, um die Projektchronik anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Commit your changes to view the project timeline."
          }
