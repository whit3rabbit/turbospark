    "Microphone timestamps are unavailable. Choose another input device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone timestamps are unavailable. Choose another input device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las marcas de tiempo del micr\u00f3fono no est\u00e1n disponibles. Elige otro dispositivo de entrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les horodatages du microphone sont indisponibles. Choisissez un autre p\u00e9riph\u00e9rique d'entr\u00e9e."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mikrofonzeitstempel sind nicht verf\u00fcgbar. W\u00e4hle ein anderes Eingabeger\u00e4t."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I timestamp del microfono non sono disponibili. Scegli un altro dispositivo di ingresso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os registros de tempo do microfone est\u00e3o indispon\u00edveis. Escolha outro dispositivo de entrada."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Microfoontijdstempels zijn niet beschikbaar. Kies een ander invoerapparaat."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonens tidsst\u00e4mplar \u00e4r inte tillg\u00e4ngliga. V\u00e4lj en annan inmatningsenhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znaczniki czasu mikrofonu s\u0105 niedost\u0119pne. Wybierz inne urz\u0105dzenie wej\u015bciowe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon zaman damgalar\u0131 kullan\u0131lam\u0131yor. Ba\u015fka bir giri\u015f ayg\u0131t\u0131 se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stempel waktu mikrofon tidak tersedia. Pilih perangkat masukan lain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u043c\u0435\u0442\u043a\u0438 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d\u0430 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0435 \u0443\u0441\u0442\u0440\u043e\u0439\u0441\u0442\u0432\u043e \u0432\u0432\u043e\u0434\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0430\u0441\u043e\u0432\u0456 \u043c\u0456\u0442\u043a\u0438 \u043c\u0456\u043a\u0440\u043e\u0444\u043e\u043d\u0430 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0456. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0456\u043d\u0448\u0438\u0439 \u043f\u0440\u0438\u0441\u0442\u0440\u0456\u0439 \u0432\u0432\u0435\u0434\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u1ea5u th\u1eddi gian micr\u00f4 kh\u00f4ng kh\u1ea3 d\u1ee5ng. Ch\u1ecdn thi\u1ebft b\u1ecb \u0111\u1ea7u v\u00e0o kh\u00e1c."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30de\u30a4\u30af\u306e\u30bf\u30a4\u30e0\u30b9\u30bf\u30f3\u30d7\u3092\u53d6\u5f97\u3067\u304d\u307e\u305b\u3093\u3002\u5225\u306e\u5165\u529b\u30c7\u30d0\u30a4\u30b9\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\uc774\ud06c \ud0c0\uc784\uc2a4\ud0ec\ud504\ub97c \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub2e4\ub978 \uc785\ub825 \uae30\uae30\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u83b7\u53d6\u9ea6\u514b\u98ce\u65f6\u95f4\u6233\u3002\u8bf7\u9009\u62e9\u5176\u4ed6\u8f93\u5165\u8bbe\u5907\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u53d6\u5f97\u9ea5\u514b\u98a8\u6642\u9593\u6233\u8a18\u3002\u8acb\u9078\u64c7\u5176\u4ed6\u8f38\u5165\u88dd\u7f6e\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0637\u0648\u0627\u0628\u0639 \u0627\u0644\u0632\u0645\u0646\u064a\u0629 \u0644\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629. \u0627\u062e\u062a\u0631 \u062c\u0647\u0627\u0632 \u0625\u062f\u062e\u0627\u0644 \u0622\u062e\u0631."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05d5\u05ea\u05de\u05d5\u05ea \u05d4\u05d6\u05de\u05df \u05e9\u05dc \u05d4\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05d0\u05d9\u05e0\u05df \u05d6\u05de\u05d9\u05e0\u05d5\u05ea. \u05d1\u05d7\u05e8 \u05d4\u05ea\u05e7\u05df \u05e7\u05dc\u05d8 \u05d0\u05d7\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0915\u0947 \u091f\u093e\u0907\u092e\u0938\u094d\u091f\u0948\u092e\u094d\u092a \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964 \u0926\u0942\u0938\u0930\u093e \u0907\u0928\u092a\u0941\u091f \u0921\u093f\u0935\u093e\u0907\u0938 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "Recording stopped because storage could not keep up. Saved chunks are safe. Free disk space or choose a faster storage volume.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording stopped because storage could not keep up. Saved chunks are safe. Free disk space or choose a faster storage volume."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La grabaci\u00f3n se detuvo porque el almacenamiento no pudo mantener el ritmo. Los fragmentos guardados est\u00e1n a salvo. Libera espacio o elige un volumen m\u00e1s r\u00e1pido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement s'est arr\u00eat\u00e9 car le stockage ne suivait pas. Les fragments enregistr\u00e9s sont pr\u00e9serv\u00e9s. Lib\u00e9rez de l'espace ou choisissez un volume plus rapide."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufnahme wurde gestoppt, weil der Speicher nicht Schritt halten konnte. Gespeicherte Abschnitte sind sicher. Gib Speicherplatz frei oder w\u00e4hle ein schnelleres Speichervolume."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La registrazione si \u00e8 interrotta perch\u00e9 l'archiviazione non riusciva a tenere il passo. I frammenti salvati sono al sicuro. Libera spazio o scegli un volume pi\u00f9 veloce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A grava\u00e7\u00e3o parou porque o armazenamento n\u00e3o conseguiu acompanhar. Os trechos salvos est\u00e3o seguros. Libere espa\u00e7o ou escolha um volume mais r\u00e1pido."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opname is gestopt omdat de opslag niet kon bijhouden. Opgeslagen fragmenten zijn veilig. Maak opslagruimte vrij of kies een sneller opslagvolume."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningen stoppades eftersom lagringen inte hann med. Sparade delar \u00e4r s\u00e4kra. Frig\u00f6r diskutrymme eller v\u00e4lj en snabbare lagringsvolym."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie zatrzymano, poniewa\u017c zapis na dysku nie nad\u0105\u017ca\u0142. Zapisane fragmenty s\u0105 bezpieczne. Zwolnij miejsce lub wybierz szybszy wolumin."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depolama yeti\u015femedi\u011fi i\u00e7in kay\u0131t durdu. Kaydedilmi\u015f par\u00e7alar g\u00fcvende. Disk alan\u0131 a\u00e7\u0131n veya daha h\u0131zl\u0131 bir depolama birimi se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perekaman berhenti karena penyimpanan tidak mampu mengimbangi. Potongan tersimpan aman. Kosongkan ruang disk atau pilih volume penyimpanan yang lebih cepat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u044c \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430, \u0442\u0430\u043a \u043a\u0430\u043a \u0445\u0440\u0430\u043d\u0438\u043b\u0438\u0449\u0435 \u043d\u0435 \u0443\u0441\u043f\u0435\u0432\u0430\u043b\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c \u0434\u0430\u043d\u043d\u044b\u0435. \u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0435 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u044b \u0432 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438. \u041e\u0441\u0432\u043e\u0431\u043e\u0434\u0438\u0442\u0435 \u043c\u0435\u0441\u0442\u043e \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u043e\u043b\u0435\u0435 \u0431\u044b\u0441\u0442\u0440\u044b\u0439 \u0442\u043e\u043c."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441 \u0437\u0443\u043f\u0438\u043d\u0435\u043d\u043e, \u043e\u0441\u043a\u0456\u043b\u044c\u043a\u0438 \u0441\u0445\u043e\u0432\u0438\u0449\u0435 \u043d\u0435 \u0432\u0441\u0442\u0438\u0433\u0430\u043b\u043e \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u0434\u0430\u043d\u0456. \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438 \u0432 \u0431\u0435\u0437\u043f\u0435\u0446\u0456. \u0417\u0432\u0456\u043b\u044c\u043d\u0456\u0442\u044c \u043c\u0456\u0441\u0446\u0435 \u0430\u0431\u043e \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0448\u0432\u0438\u0434\u0448\u0438\u0439 \u0442\u043e\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu\u00e1 tr\u00ecnh ghi \u0111\u00e3 d\u1eebng v\u00ec b\u1ed9 nh\u1edb kh\u00f4ng theo k\u1ecbp. C\u00e1c \u0111o\u1ea1n \u0111\u00e3 l\u01b0u v\u1eabn an to\u00e0n. Gi\u1ea3i ph\u00f3ng dung l\u01b0\u1ee3ng ho\u1eb7c ch\u1ecdn \u1ed5 l\u01b0u tr\u1eef nhanh h\u01a1n."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c8\u30ec\u30fc\u30b8\u306e\u66f8\u304d\u8fbc\u307f\u304c\u8ffd\u3044\u3064\u304b\u306a\u3044\u305f\u3081\u9332\u97f3\u3092\u505c\u6b62\u3057\u307e\u3057\u305f\u3002\u4fdd\u5b58\u6e08\u307f\u306e\u30c1\u30e3\u30f3\u30af\u306f\u4fdd\u6301\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u7a7a\u304d\u5bb9\u91cf\u3092\u5897\u3084\u3059\u304b\u3001\u3088\u308a\u9ad8\u901f\u306a\u30b9\u30c8\u30ec\u30fc\u30b8\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5 \uc18d\ub3c4\uac00 \ub530\ub77c\uac00\uc9c0 \ubabb\ud574 \ub179\uc74c\uc774 \uc911\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc800\uc7a5\ub41c \uccad\ud06c\ub294 \uc548\uc804\ud569\ub2c8\ub2e4. \ub514\uc2a4\ud06c \uacf5\uac04\uc744 \ud655\ubcf4\ud558\uac70\ub098 \ub354 \ube60\ub978 \uc800\uc7a5 \ubcfc\ub968\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7531\u4e8e\u5b58\u50a8\u5199\u5165\u901f\u5ea6\u4e0d\u8db3\uff0c\u5f55\u97f3\u5df2\u505c\u6b62\u3002\u5df2\u4fdd\u5b58\u7684\u7247\u6bb5\u662f\u5b89\u5168\u7684\u3002\u8bf7\u91ca\u653e\u78c1\u76d8\u7a7a\u95f4\u6216\u9009\u62e9\u66f4\u5feb\u7684\u5b58\u50a8\u5377\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7531\u65bc\u5132\u5b58\u5beb\u5165\u901f\u5ea6\u4e0d\u8db3\uff0c\u9304\u97f3\u5df2\u505c\u6b62\u3002\u5df2\u5132\u5b58\u7684\u7247\u6bb5\u662f\u5b89\u5168\u7684\u3002\u8acb\u91cb\u653e\u78c1\u789f\u7a7a\u9593\u6216\u9078\u64c7\u66f4\u5feb\u7684\u5132\u5b58\u5377\u5b97\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u0642\u0641 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0644\u0623\u0646 \u0627\u0644\u062a\u062e\u0632\u064a\u0646 \u0644\u0645 \u064a\u062a\u0645\u0643\u0646 \u0645\u0646 \u0645\u0648\u0627\u0643\u0628\u0629 \u0627\u0644\u0633\u0631\u0639\u0629. \u0627\u0644\u0645\u0642\u0627\u0637\u0639 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u0622\u0645\u0646\u0629. \u0648\u0641\u0631 \u0645\u0633\u0627\u062d\u0629 \u0639\u0644\u0649 \u0627\u0644\u0642\u0631\u0635 \u0623\u0648 \u0627\u062e\u062a\u0631 \u0648\u062d\u062f\u0629 \u062a\u062e\u0632\u064a\u0646 \u0623\u0633\u0631\u0639."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d4\u05e7\u05dc\u05d8\u05d4 \u05e0\u05e2\u05e6\u05e8\u05d4 \u05de\u05e9\u05d5\u05dd \u05e9\u05d4\u05d0\u05d7\u05e1\u05d5\u05df \u05dc\u05d0 \u05e2\u05de\u05d3 \u05d1\u05e7\u05e6\u05d1. \u05d4\u05de\u05e7\u05d8\u05e2\u05d9\u05dd \u05d4\u05e9\u05de\u05d5\u05e8\u05d9\u05dd \u05d1\u05d8\u05d5\u05d7\u05d9\u05dd. \u05e4\u05e0\u05d4 \u05de\u05e7\u05d5\u05dd \u05d1\u05d3\u05d9\u05e1\u05e7 \u05d0\u05d5 \u05d1\u05d7\u05e8 \u05d0\u05de\u05e6\u05e2\u05d9 \u05d0\u05d7\u05e1\u05d5\u05df \u05de\u05d4\u05d9\u05e8 \u05d9\u05d5\u05ea\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u091f\u094b\u0930\u0947\u091c \u0917\u0924\u093f \u0915\u092e \u092a\u0921\u093c\u0928\u0947 \u0915\u0947 \u0915\u093e\u0930\u0923 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0930\u0941\u0915 \u0917\u0908\u0964 \u0938\u0939\u0947\u091c\u0947 \u0917\u090f \u0916\u0902\u0921 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0902\u0964 \u0921\u093f\u0938\u094d\u0915 \u092e\u0947\u0902 \u091c\u0917\u0939 \u0916\u093e\u0932\u0940 \u0915\u0930\u0947\u0902 \u092f\u093e \u0924\u0947\u091c\u093c \u0938\u094d\u091f\u094b\u0930\u0947\u091c \u0935\u0949\u0932\u094d\u092f\u0942\u092e \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "System audio could not be read. Stop and select the source again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio could not be read. Stop and select the source again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el audio del sistema. Det\u00e9n la grabaci\u00f3n y vuelve a seleccionar la fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l'audio syst\u00e8me. Arr\u00eatez l'enregistrement et s\u00e9lectionnez \u00e0 nouveau la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Systemaudio konnte nicht gelesen werden. Stoppe die Aufnahme und w\u00e4hle die Quelle erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l'audio di sistema. Interrompi e seleziona nuovamente la sorgente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel ler o \u00e1udio do sistema. Pare e selecione a fonte novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeemaudio kon niet worden gelezen. Stop en selecteer de bron opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemljudet kunde inte l\u00e4sas. Stoppa och v\u00e4lj k\u00e4llan igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna odczyta\u0107 d\u017awi\u0119ku systemowego. Zatrzymaj nagrywanie i ponownie wybierz \u017ar\u00f3d\u0142o."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem sesi okunamad\u0131. Durdurun ve kayna\u011f\u0131 yeniden se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio sistem tidak dapat dibaca. Hentikan dan pilih sumber kembali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u0437\u0432\u0443\u043a. \u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u044c \u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0441\u043d\u043e\u0432\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u0438\u0439 \u0437\u0432\u0443\u043a. \u0417\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0441 \u0456 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u0437\u043d\u043e\u0432\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 \u0111\u1ecdc \u00e2m thanh h\u1ec7 th\u1ed1ng. D\u1eebng v\u00e0 ch\u1ecdn l\u1ea1i ngu\u1ed3n."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30b9\u30c6\u30e0\u97f3\u58f0\u3092\u8aad\u307f\u53d6\u308c\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u505c\u6b62\u3057\u3066\u30bd\u30fc\u30b9\u3092\u9078\u629e\u3057\u76f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uc2a4\ud15c \uc624\ub514\uc624\ub97c \uc77d\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc911\uc9c0\ud55c \ud6c4 \uc18c\uc2a4\ub97c \ub2e4\uc2dc \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u8bfb\u53d6\u7cfb\u7edf\u97f3\u9891\u3002\u8bf7\u505c\u6b62\u5e76\u91cd\u65b0\u9009\u62e9\u6765\u6e90\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u8b80\u53d6\u7cfb\u7d71\u97f3\u8a0a\u3002\u8acb\u505c\u6b62\u4e26\u91cd\u65b0\u9078\u64c7\u4f86\u6e90\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0631\u062a \u0642\u0631\u0627\u0621\u0629 \u0635\u0648\u062a \u0627\u0644\u0646\u0638\u0627\u0645. \u0623\u0648\u0642\u0641 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0648\u062d\u062f\u062f \u0627\u0644\u0645\u0635\u062f\u0631 \u0645\u062c\u062f\u062f\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e7\u05e8\u05d5\u05d0 \u05d0\u05ea \u05e9\u05de\u05e2 \u05d4\u05de\u05e2\u05e8\u05db\u05ea. \u05e2\u05e6\u05d5\u05e8 \u05d5\u05d1\u05d7\u05e8 \u05e9\u05d5\u05d1 \u05d0\u05ea \u05d4\u05de\u05e7\u05d5\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0938\u094d\u091f\u092e \u0911\u0921\u093f\u092f\u094b \u092a\u0922\u093c\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u093e\u0964 \u0930\u094b\u0915\u0947\u0902 \u0914\u0930 \u0938\u094d\u0930\u094b\u0924 \u092b\u093f\u0930 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "System audio returned an invalid buffer. Stop and select the source again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio returned an invalid buffer. Stop and select the source again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio del sistema devolvi\u00f3 un b\u00fafer no v\u00e1lido. Det\u00e9n la grabaci\u00f3n y vuelve a seleccionar la fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio syst\u00e8me a renvoy\u00e9 un tampon invalide. Arr\u00eatez l'enregistrement et s\u00e9lectionnez \u00e0 nouveau la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Systemaudio hat einen ung\u00fcltigen Puffer geliefert. Stoppe die Aufnahme und w\u00e4hle die Quelle erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio di sistema ha restituito un buffer non valido. Interrompi e seleziona nuovamente la sorgente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O \u00e1udio do sistema retornou um buffer inv\u00e1lido. Pare e selecione a fonte novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeemaudio heeft een ongeldige buffer geleverd. Stop en selecteer de bron opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemljudet returnerade en ogiltig buffert. Stoppa och v\u00e4lj k\u00e4llan igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u017awi\u0119k systemowy zwr\u00f3ci\u0142 nieprawid\u0142owy bufor. Zatrzymaj nagrywanie i ponownie wybierz \u017ar\u00f3d\u0142o."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem sesi ge\u00e7ersiz bir arabellek d\u00f6nd\u00fcrd\u00fc. Durdurun ve kayna\u011f\u0131 yeniden se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio sistem mengembalikan buffer tidak valid. Hentikan dan pilih sumber kembali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0439 \u0437\u0432\u0443\u043a \u0432\u0435\u0440\u043d\u0443\u043b \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b\u0439 \u0431\u0443\u0444\u0435\u0440. \u041e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u044c \u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0441\u043d\u043e\u0432\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0438\u0439 \u0437\u0432\u0443\u043a \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0432 \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u0438\u0439 \u0431\u0443\u0444\u0435\u0440. \u0417\u0443\u043f\u0438\u043d\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0441 \u0456 \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u0437\u043d\u043e\u0432\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c2m thanh h\u1ec7 th\u1ed1ng tr\u1ea3 v\u1ec1 b\u1ed9 \u0111\u1ec7m kh\u00f4ng h\u1ee3p l\u1ec7. D\u1eebng v\u00e0 ch\u1ecdn l\u1ea1i ngu\u1ed3n."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30b9\u30c6\u30e0\u97f3\u58f0\u304b\u3089\u7121\u52b9\u306a\u30d0\u30c3\u30d5\u30a1\u304c\u8fd4\u3055\u308c\u307e\u3057\u305f\u3002\u505c\u6b62\u3057\u3066\u30bd\u30fc\u30b9\u3092\u9078\u629e\u3057\u76f4\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\uc2a4\ud15c \uc624\ub514\uc624\uac00 \uc798\ubabb\ub41c \ubc84\ud37c\ub97c \ubc18\ud658\ud588\uc2b5\ub2c8\ub2e4. \uc911\uc9c0\ud55c \ud6c4 \uc18c\uc2a4\ub97c \ub2e4\uc2dc \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7cfb\u7edf\u97f3\u9891\u8fd4\u56de\u4e86\u65e0\u6548\u7684\u7f13\u51b2\u533a\u3002\u8bf7\u505c\u6b62\u5e76\u91cd\u65b0\u9009\u62e9\u6765\u6e90\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7cfb\u7d71\u97f3\u8a0a\u50b3\u56de\u4e86\u7121\u6548\u7684\u7de9\u885d\u5340\u3002\u8acb\u505c\u6b62\u4e26\u91cd\u65b0\u9078\u64c7\u4f86\u6e90\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0639\u0627\u062f \u0635\u0648\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0645\u062e\u0632\u0646\u0627\u064b \u0645\u0624\u0642\u062a\u0627\u064b \u063a\u064a\u0631 \u0635\u0627\u0644\u062d. \u0623\u0648\u0642\u0641 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0648\u062d\u062f\u062f \u0627\u0644\u0645\u0635\u062f\u0631 \u0645\u062c\u062f\u062f\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05de\u05e2 \u05d4\u05de\u05e2\u05e8\u05db\u05ea \u05d4\u05d7\u05d6\u05d9\u05e8 \u05de\u05d0\u05d2\u05e8 \u05dc\u05d0 \u05ea\u05e7\u05d9\u05df. \u05e2\u05e6\u05d5\u05e8 \u05d5\u05d1\u05d7\u05e8 \u05e9\u05d5\u05d1 \u05d0\u05ea \u05d4\u05de\u05e7\u05d5\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u093f\u0938\u094d\u091f\u092e \u0911\u0921\u093f\u092f\u094b \u0928\u0947 \u0905\u092e\u093e\u0928\u094d\u092f \u092c\u092b\u093c\u0930 \u0932\u094c\u091f\u093e\u092f\u093e\u0964 \u0930\u094b\u0915\u0947\u0902 \u0914\u0930 \u0938\u094d\u0930\u094b\u0924 \u092b\u093f\u0930 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
    "The microphone configuration changed. Saved audio is safe. Select the input again and start a new recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone configuration changed. Saved audio is safe. Select the input again and start a new recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuraci\u00f3n del micr\u00f3fono cambi\u00f3. El audio guardado est\u00e1 a salvo. Vuelve a seleccionar la entrada e inicia una nueva grabaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration du microphone a chang\u00e9. L'audio enregistr\u00e9 est pr\u00e9serv\u00e9. S\u00e9lectionnez \u00e0 nouveau l'entr\u00e9e et d\u00e9marrez un nouvel enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mikrofonkonfiguration wurde ge\u00e4ndert. Gespeichertes Audio ist sicher. W\u00e4hle den Eingang erneut und starte eine neue Aufnahme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione del microfono \u00e8 cambiata. L'audio salvato \u00e8 al sicuro. Seleziona nuovamente l'ingresso e avvia una nuova registrazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configura\u00e7\u00e3o do microfone mudou. O \u00e1udio salvo est\u00e1 seguro. Selecione a entrada novamente e inicie uma nova grava\u00e7\u00e3o."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De microfoonconfiguratie is gewijzigd. Opgeslagen audio is veilig. Selecteer de invoer opnieuw en start een nieuwe opname."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonens konfiguration har \u00e4ndrats. Sparat ljud \u00e4r s\u00e4kert. V\u00e4lj ing\u00e5ngen igen och starta en ny inspelning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja mikrofonu si\u0119 zmieni\u0142a. Zapisany d\u017awi\u0119k jest bezpieczny. Ponownie wybierz wej\u015bcie i rozpocznij nowe nagranie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon yap\u0131land\u0131rmas\u0131 de\u011fi\u015fti. Kaydedilmi\u015f ses g\u00fcvende. Giri\u015fi yeniden se\u00e7in ve yeni bir kay\u0131t ba\u015flat\u0131n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi mikrofon berubah. Audio tersimpan aman. Pilih masukan kembali dan mulai rekaman baru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u044f \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d\u0430 \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0430\u0441\u044c. \u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u0435 \u0430\u0443\u0434\u0438\u043e \u0432 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0432\u0445\u043e\u0434 \u0441\u043d\u043e\u0432\u0430 \u0438 \u043d\u0430\u0447\u043d\u0438\u0442\u0435 \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u044f \u043c\u0456\u043a\u0440\u043e\u0444\u043e\u043d\u0430 \u0437\u043c\u0456\u043d\u0438\u043b\u0430\u0441\u044f. \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0435 \u0430\u0443\u0434\u0456\u043e \u0432 \u0431\u0435\u0437\u043f\u0435\u0446\u0456. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0432\u0445\u0456\u0434 \u0437\u043d\u043e\u0432\u0443 \u0442\u0430 \u043f\u043e\u0447\u043d\u0456\u0442\u044c \u043d\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1ea5u h\u00ecnh micr\u00f4 \u0111\u00e3 thay \u0111\u1ed5i. \u00c2m thanh \u0111\u00e3 l\u01b0u v\u1eabn an to\u00e0n. Ch\u1ecdn l\u1ea1i \u0111\u1ea7u v\u00e0o v\u00e0 b\u1eaft \u0111\u1ea7u b\u1ea3n ghi m\u1edbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30de\u30a4\u30af\u306e\u69cb\u6210\u304c\u5909\u66f4\u3055\u308c\u307e\u3057\u305f\u3002\u4fdd\u5b58\u6e08\u307f\u306e\u97f3\u58f0\u306f\u4fdd\u6301\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u5165\u529b\u3092\u9078\u629e\u3057\u76f4\u3057\u3001\u65b0\u3057\u3044\u9332\u97f3\u3092\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\uc774\ud06c \uad6c\uc131\uc774 \ubcc0\uacbd\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc800\uc7a5\ub41c \uc624\ub514\uc624\ub294 \uc548\uc804\ud569\ub2c8\ub2e4. \uc785\ub825\uc744 \ub2e4\uc2dc \uc120\ud0dd\ud558\uace0 \uc0c8 \ub179\uc74c\uc744 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ea6\u514b\u98ce\u914d\u7f6e\u5df2\u66f4\u6539\u3002\u5df2\u4fdd\u5b58\u7684\u97f3\u9891\u662f\u5b89\u5168\u7684\u3002\u8bf7\u91cd\u65b0\u9009\u62e9\u8f93\u5165\u5e76\u5f00\u59cb\u65b0\u7684\u5f55\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ea5\u514b\u98a8\u8a2d\u5b9a\u5df2\u8b8a\u66f4\u3002\u5df2\u5132\u5b58\u7684\u97f3\u8a0a\u662f\u5b89\u5168\u7684\u3002\u8acb\u91cd\u65b0\u9078\u64c7\u8f38\u5165\u4e26\u958b\u59cb\u65b0\u7684\u9304\u97f3\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u063a\u064a\u0631 \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646. \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062d\u0641\u0648\u0638 \u0622\u0645\u0646. \u062d\u062f\u062f \u0627\u0644\u0625\u062f\u062e\u0627\u0644 \u0645\u062c\u062f\u062f\u0627\u064b \u0648\u0627\u0628\u062f\u0623 \u062a\u0633\u062c\u064a\u0644\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05e6\u05d5\u05e8\u05ea \u05d4\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05d4\u05e9\u05ea\u05e0\u05ea\u05d4. \u05d4\u05e9\u05de\u05e2 \u05d4\u05e9\u05de\u05d5\u05e8 \u05d1\u05d8\u05d5\u05d7. \u05d1\u05d7\u05e8 \u05e9\u05d5\u05d1 \u05d0\u05ea \u05d4\u05e7\u05dc\u05d8 \u05d5\u05d4\u05ea\u05d7\u05dc \u05d4\u05e7\u05dc\u05d8\u05d4 \u05d7\u05d3\u05e9\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917\u0930\u0947\u0936\u0928 \u092c\u0926\u0932 \u0917\u092f\u093e\u0964 \u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e \u0911\u0921\u093f\u092f\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964 \u0907\u0928\u092a\u0941\u091f \u092b\u093f\u0930 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0928\u0908 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
    "The recorded application closed. Saved audio is safe. Select an available source and start a new recording.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recorded application closed. Saved audio is safe. Select an available source and start a new recording."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La aplicaci\u00f3n grabada se cerr\u00f3. El audio guardado est\u00e1 a salvo. Selecciona una fuente disponible e inicia una nueva grabaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'application enregistr\u00e9e s'est ferm\u00e9e. L'audio enregistr\u00e9 est pr\u00e9serv\u00e9. S\u00e9lectionnez une source disponible et d\u00e9marrez un nouvel enregistrement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aufgezeichnete Anwendung wurde geschlossen. Gespeichertes Audio ist sicher. W\u00e4hle eine verf\u00fcgbare Quelle und starte eine neue Aufnahme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'applicazione registrata si \u00e8 chiusa. L'audio salvato \u00e8 al sicuro. Seleziona una sorgente disponibile e avvia una nuova registrazione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O aplicativo gravado foi fechado. O \u00e1udio salvo est\u00e1 seguro. Selecione uma fonte dispon\u00edvel e inicie uma nova grava\u00e7\u00e3o."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgenomen toepassing is gesloten. Opgeslagen audio is veilig. Selecteer een beschikbare bron en start een nieuwe opname."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den inspelade appen st\u00e4ngdes. Sparat ljud \u00e4r s\u00e4kert. V\u00e4lj en tillg\u00e4nglig k\u00e4lla och starta en ny inspelning."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywana aplikacja zosta\u0142a zamkni\u0119ta. Zapisany d\u017awi\u0119k jest bezpieczny. Wybierz dost\u0119pne \u017ar\u00f3d\u0142o i rozpocznij nowe nagranie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydedilen uygulama kapand\u0131. Kaydedilmi\u015f ses g\u00fcvende. Kullan\u0131labilir bir kaynak se\u00e7in ve yeni bir kay\u0131t ba\u015flat\u0131n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi yang direkam ditutup. Audio tersimpan aman. Pilih sumber yang tersedia dan mulai rekaman baru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u043c\u043e\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u0437\u0430\u043a\u0440\u044b\u043b\u043e\u0441\u044c. \u0421\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u0435 \u0430\u0443\u0434\u0438\u043e \u0432 \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u0438 \u043d\u0430\u0447\u043d\u0438\u0442\u0435 \u043d\u043e\u0432\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0430, \u044f\u043a\u0443 \u0437\u0430\u043f\u0438\u0441\u0443\u0432\u0430\u043b\u0438, \u0437\u0430\u043a\u0440\u0438\u043b\u0430\u0441\u044f. \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0435 \u0430\u0443\u0434\u0456\u043e \u0432 \u0431\u0435\u0437\u043f\u0435\u0446\u0456. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435 \u0434\u0436\u0435\u0440\u0435\u043b\u043e \u0442\u0430 \u043f\u043e\u0447\u043d\u0456\u0442\u044c \u043d\u043e\u0432\u0438\u0439 \u0437\u0430\u043f\u0438\u0441."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u1ee8ng d\u1ee5ng \u0111ang \u0111\u01b0\u1ee3c ghi \u0111\u00e3 \u0111\u00f3ng. \u00c2m thanh \u0111\u00e3 l\u01b0u v\u1eabn an to\u00e0n. Ch\u1ecdn ngu\u1ed3n kh\u1ea3 d\u1ee5ng v\u00e0 b\u1eaft \u0111\u1ea7u b\u1ea3n ghi m\u1edbi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9332\u97f3\u5bfe\u8c61\u306e\u30a2\u30d7\u30ea\u30b1\u30fc\u30b7\u30e7\u30f3\u304c\u7d42\u4e86\u3057\u307e\u3057\u305f\u3002\u4fdd\u5b58\u6e08\u307f\u306e\u97f3\u58f0\u306f\u4fdd\u6301\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u5229\u7528\u53ef\u80fd\u306a\u30bd\u30fc\u30b9\u3092\u9078\u629e\u3057\u3001\u65b0\u3057\u3044\u9332\u97f3\u3092\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub179\uc74c \uc911\uc778 \uc571\uc774 \uc885\ub8cc\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc800\uc7a5\ub41c \uc624\ub514\uc624\ub294 \uc548\uc804\ud569\ub2c8\ub2e4. \uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc18c\uc2a4\ub97c \uc120\ud0dd\ud558\uace0 \uc0c8 \ub179\uc74c\uc744 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u5f55\u5236\u7684\u5e94\u7528\u5df2\u5173\u95ed\u3002\u5df2\u4fdd\u5b58\u7684\u97f3\u9891\u662f\u5b89\u5168\u7684\u3002\u8bf7\u9009\u62e9\u53ef\u7528\u6765\u6e90\u5e76\u5f00\u59cb\u65b0\u7684\u5f55\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u9304\u88fd\u7684 App \u5df2\u95dc\u9589\u3002\u5df2\u5132\u5b58\u7684\u97f3\u8a0a\u662f\u5b89\u5168\u7684\u3002\u8acb\u9078\u64c7\u53ef\u7528\u4f86\u6e90\u4e26\u958b\u59cb\u65b0\u7684\u9304\u97f3\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u064f\u063a\u0644\u0642 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0630\u064a \u064a\u062a\u0645 \u062a\u0633\u062c\u064a\u0644\u0647. \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0645\u062d\u0641\u0648\u0638 \u0622\u0645\u0646. \u062d\u062f\u062f \u0645\u0635\u062f\u0631\u0627\u064b \u0645\u062a\u0627\u062d\u0627\u064b \u0648\u0627\u0628\u062f\u0623 \u062a\u0633\u062c\u064a\u0644\u0627\u064b \u062c\u062f\u064a\u062f\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d9\u05d9\u05e9\u05d5\u05dd \u05e9\u05d4\u05d5\u05e7\u05dc\u05d8 \u05e0\u05e1\u05d2\u05e8. \u05d4\u05e9\u05de\u05e2 \u05d4\u05e9\u05de\u05d5\u05e8 \u05d1\u05d8\u05d5\u05d7. \u05d1\u05d7\u05e8 \u05de\u05e7\u05d5\u05e8 \u05d6\u05de\u05d9\u05df \u05d5\u05d4\u05ea\u05d7\u05dc \u05d4\u05e7\u05dc\u05d8\u05d4 \u05d7\u05d3\u05e9\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u093f\u092f\u093e \u091c\u093e \u0930\u0939\u093e \u0910\u092a \u092c\u0902\u0926 \u0939\u094b \u0917\u092f\u093e\u0964 \u0938\u0939\u0947\u091c\u093e \u0917\u092f\u093e \u0911\u0921\u093f\u092f\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964 \u0909\u092a\u0932\u092c\u094d\u0927 \u0938\u094d\u0930\u094b\u0924 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u0928\u0908 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
