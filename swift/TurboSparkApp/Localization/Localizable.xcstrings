            "value": "Inga matchande godk\u00e4nda minnen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E\u015fle\u015fen onayl\u0131 bellek kayd\u0131 yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0438\u0445 \u0441\u0445\u0432\u0430\u043b\u0435\u043d\u0438\u0445 \u0437\u0430\u043f\u0438\u0441\u0456\u0432 \u043f\u0430\u043c'\u044f\u0442\u0456."
