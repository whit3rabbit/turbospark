    "Run tool calls, but ask before high-risk actions like credential access, privilege escalation, or destructive commands": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل استدعاءات الأدوات، لكن اسأل قبل الإجراءات عالية الخطورة مثل الوصول إلى بيانات الاعتماد أو رفع الصلاحيات أو الأوامر المدمّرة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool-Aufrufe ausführen, aber vor riskanten Aktionen wie Zugriff auf Zugangsdaten, Rechteausweitung oder zerstörerischen Befehlen fragen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run tool calls, but ask before high-risk actions like credential access, privilege escalation, or destructive commands"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejecutar las herramientas, pero preguntar antes de acciones de alto riesgo como acceder a credenciales, escalar privilegios o comandos destructivos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exécuter les outils, mais demander avant les actions à risque comme l'accès aux identifiants, l'élévation de privilèges ou les commandes destructrices"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל קריאות כלים, אך שאל לפני פעולות בסיכון גבוה כמו גישה לפרטי התחברות, הסלמת הרשאות או פקודות הרסניות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूल कॉल चलाएँ, लेकिन क्रेडेंशियल एक्सेस, अधिकार बढ़ाने या विनाशकारी कमांड जैसे उच्च जोखिम वाले कार्यों से पहले पूछें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan panggilan alat, tetapi tanya sebelum tindakan berisiko tinggi seperti akses kredensial, eskalasi hak, atau perintah destruktif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui gli strumenti, ma chiedi prima di azioni ad alto rischio come accesso alle credenziali, escalation dei privilegi o comandi distruttivi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツールは実行するが、認証情報へのアクセス、権限昇格、破壊的なコマンドなど高リスクな操作の前には確認する"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 호출은 실행하되, 자격 증명 접근, 권한 상승, 파괴적 명령 같은 고위험 작업 전에는 묻기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tools uitvoeren, maar vragen vóór risicovolle acties zoals toegang tot inloggegevens, rechtenuitbreiding of destructieve opdrachten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamiaj narzędzia, ale pytaj przed ryzykownymi działaniami, takimi jak dostęp do danych logowania, podnoszenie uprawnień czy destrukcyjne polecenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Executar ferramentas, mas perguntar antes de ações de alto risco como acesso a credenciais, escalonamento de privilégios ou comandos destrutivos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выполнять инструменты, но спрашивать перед рискованными действиями: доступом к учётным данным, повышением привилегий или разрушительными командами"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kör verktygsanrop, men fråga före riskfyllda åtgärder som åtkomst till inloggningsuppgifter, behörighetshöjning eller destruktiva kommandon"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç çağrılarını çalıştır, ancak kimlik bilgisi erişimi, yetki yükseltme veya yıkıcı komutlar gibi yüksek riskli işlemlerden önce sor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виконувати інструменти, але питати перед ризикованими діями: доступом до облікових даних, підвищенням привілеїв чи руйнівними командами"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạy lệnh gọi công cụ, nhưng hỏi trước các thao tác rủi ro cao như truy cập thông tin đăng nhập, leo thang đặc quyền hoặc lệnh phá hủy"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "运行工具调用，但在访问凭据、提升权限或破坏性命令等高风险操作前询问"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "執行工具呼叫，但在存取憑證、提升權限或破壞性指令等高風險操作前詢問"
          }
        }
      }
    },
