        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d5\u05d3\u05dc Humanizer \u05d0\u05d9\u05e0\u05d5 \u05de\u05d5\u05ea\u05e7\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Humanizer \u092e\u0949\u0921\u0932 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Humanizer belum terpasang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello Humanizer non \u00e8 installato."
