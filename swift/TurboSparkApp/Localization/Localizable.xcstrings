        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionar branch ou commit de compara\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0440\u0430\u0442\u044c \u0432\u0435\u0442\u043a\u0443 \u0438\u043b\u0438 \u043a\u043e\u043c\u043c\u0438\u0442 \u0434\u043b\u044f \u0441\u0440\u0430\u0432\u043d\u0435\u043d\u0438\u044f"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj j\u00e4mf\u00f6relsegren eller commit"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kar\u015f\u0131la\u015ft\u0131rma dal\u0131n\u0131 veya i\u015flemesini se\u00e7in"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0433\u0456\u043b\u043a\u0443 \u0430\u0431\u043e \u043a\u043e\u043c\u0456\u0442 \u0434\u043b\u044f \u043f\u043e\u0440\u0456\u0432\u043d\u044f\u043d\u043d\u044f"
          }
        },
