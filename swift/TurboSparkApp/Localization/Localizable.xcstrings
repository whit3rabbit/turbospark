            "value": "يتداخل هذا المجلد مع مكتبة مدرجة بالفعل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner überschneidet sich mit einer Bibliothek, die bereits aufgeführt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That folder overlaps a library that is already listed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa carpeta se solapa con una biblioteca que ya está en la lista."
