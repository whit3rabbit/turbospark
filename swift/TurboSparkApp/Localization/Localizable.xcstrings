    "No project folder attached. Set a folder in project settings to read AGENTS.md.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0645\u062c\u0644\u062f \u0645\u0634\u0631\u0648\u0639 \u0645\u0631\u0641\u0642. \u062d\u062f\u062f \u0645\u062c\u0644\u062f\u064b\u0627 \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0644\u0642\u0631\u0627\u0621\u0629 AGENTS.md."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Projektordner angeh\u00e4ngt. Legen Sie einen Ordner in den Projekteinstellungen fest, um AGENTS.md zu lesen."
          }
        },
