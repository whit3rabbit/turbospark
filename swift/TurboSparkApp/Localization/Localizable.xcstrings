    "Unrestricted: no approval prompts and the code sandbox is disabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062f\u0648\u0646 \u0642\u064a\u0648\u062f: \u0644\u0627 \u0637\u0644\u0628\u0627\u062a \u0645\u0648\u0627\u0641\u0642\u0629 \u0648\u0628\u064a\u0626\u0629 \u0639\u0632\u0644 \u0627\u0644\u0634\u064a\u0641\u0631\u0629 \u0645\u0639\u0637\u0651\u0644\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Uneingeschr\u00e4nkt: keine Genehmigungsabfragen, die Code-Sandbox ist aus"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unrestricted: no approval prompts and the code sandbox is disabled"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin restricciones: sin solicitudes de aprobaci\u00f3n y con el entorno aislado de c\u00f3digo desactivado"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans restriction : aucune demande d'approbation et le bac \u00e0 sable de code est d\u00e9sactiv\u00e9"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05dc\u05d0 \u05d4\u05d2\u05d1\u05dc\u05d5\u05ea: \u05d0\u05d9\u05df \u05d1\u05e7\u05e9\u05d5\u05ea \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d5\u05d0\u05e8\u05d2\u05d6 \u05d4\u05d7\u05d5\u05dc \u05e9\u05dc \u05d4\u05e7\u05d5\u05d3 \u05de\u05d5\u05e9\u05d1\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u093f\u0928\u093e \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927: \u0915\u094b\u0908 \u0905\u0928\u0941\u092e\u094b\u0926\u0928 \u0938\u0902\u0915\u0947\u0924 \u0928\u0939\u0940\u0902 \u0914\u0930 \u0915\u094b\u0921 \u0938\u0948\u0902\u0921\u092c\u0949\u0915\u094d\u0938 \u092c\u0902\u0926 \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa batasan: tidak ada permintaan persetujuan dan sandbox kode dinonaktifkan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza restrizioni: nessuna richiesta di approvazione e sandbox del codice disattivata"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u5236\u9650\uff1a\u627f\u8a8d\u306e\u78ba\u8a8d\u306f\u306a\u304f\u3001\u30b3\u30fc\u30c9\u306e\u30b5\u30f3\u30c9\u30dc\u30c3\u30af\u30b9\u3082\u7121\u52b9\u3067\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc81c\ud55c \uc5c6\uc74c: \uc2b9\uc778 \uc694\uccad\uc774 \uc5c6\uace0 \ucf54\ub4dc \uc0cc\ub4dc\ubc15\uc2a4\uac00 \uaebc\uc9d1\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onbeperkt: geen goedkeuringsvragen en de code-sandbox staat uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ogranicze\u0144: brak pr\u00f3\u015bb o zgod\u0119, a piaskownica kodu jest wy\u0142\u0105czona"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem restri\u00e7\u00f5es: sem pedidos de aprova\u00e7\u00e3o e com o sandbox de c\u00f3digo desativado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0435\u0437 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0439: \u043d\u0438\u043a\u0430\u043a\u0438\u0445 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u0432 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u044f, \u043f\u0435\u0441\u043e\u0447\u043d\u0438\u0446\u0430 \u043a\u043e\u0434\u0430 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Obegr\u00e4nsat: inga godk\u00e4nnandefr\u00e5gor och kodsandl\u00e5dan \u00e4r avst\u00e4ngd"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0131s\u0131tlamas\u0131z: onay istemi yok ve kod korumal\u0131 alan\u0131 kapal\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0435\u0437 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u044c: \u0436\u043e\u0434\u043d\u0438\u0445 \u0437\u0430\u043f\u0438\u0442\u0456\u0432 \u043d\u0430 \u0441\u0445\u0432\u0430\u043b\u0435\u043d\u043d\u044f, \u043f\u0456\u0441\u043e\u0447\u043d\u0438\u0446\u044e \u043a\u043e\u0434\u0443 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng gi\u1edbi h\u1ea1n: kh\u00f4ng h\u1ecfi ph\u00ea duy\u1ec7t v\u00e0 h\u1ed9p c\u00e1t m\u00e3 b\u1ecb t\u1eaft"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u53d7\u9650\u5236\uff1a\u6ca1\u6709\u6279\u51c6\u63d0\u793a\uff0c\u4ee3\u7801\u6c99\u76d2\u5df2\u505c\u7528"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u53d7\u9650\u5236\uff1a\u6c92\u6709\u6838\u51c6\u63d0\u793a\uff0c\u7a0b\u5f0f\u78bc\u6c99\u76d2\u5df2\u505c\u7528"
          }
        }
      }
    },
