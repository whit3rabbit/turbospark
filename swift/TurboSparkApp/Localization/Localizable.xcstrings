          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyja\u015bnij, jak dzia\u0142a ten projekt"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explicar como este projeto funciona"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u044a\u044f\u0441\u043d\u0438\u0442\u044c, \u043a\u0430\u043a \u0440\u0430\u0431\u043e\u0442\u0430\u0435\u0442 \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u0435\u043a\u0442"
