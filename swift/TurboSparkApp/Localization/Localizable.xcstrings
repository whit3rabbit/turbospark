        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u092c\u0948\u0915\u0905\u092a \u0915\u094b \u0932\u0949\u0915 \u0915\u0940 \u0917\u0908 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964"
