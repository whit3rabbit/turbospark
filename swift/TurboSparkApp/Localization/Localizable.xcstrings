            "value": "Penerusan lingkungan (satu NAMA variabel per baris)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passaggio dell'ambiente (un NOME di variabile per riga)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u74b0\u5883\u5909\u6570\u306e\u30d1\u30b9\u30b9\u30eb\u30fc (1 \u884c\u306b 1 \u3064\u306e\u5909\u6570\u540d)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
