        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc Chrome \u05e9\u05e0\u05d1\u05d7\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05d6\u05de\u05d9\u05df \u05e2\u05d5\u05d3."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0941\u0928\u093e \u0917\u092f\u093e Chrome \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u092c \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil Chrome yang dipilih tidak lagi tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo Chrome selezionato non \u00e8 pi\u00f9 disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u3057\u305f Chrome \u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u306f\u5229\u7528\u3067\u304d\u306a\u304f\u306a\u308a\u307e\u3057\u305f\u3002"
