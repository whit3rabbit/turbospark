    "Moderate precautions against system overload": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتياطات معتدلة ضد إرهاق النظام"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mäßige Vorkehrungen gegen Systemüberlastung"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moderate precautions against system overload"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Precauciones moderadas contra la sobrecarga del sistema"
          }
        },
        "fr": {
