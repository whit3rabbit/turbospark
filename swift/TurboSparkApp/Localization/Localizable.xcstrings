    "The rewrite stopped at the length limit and may be cut off.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u0642\u0641\u062a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0639\u0646\u062f \u062d\u062f \u0627\u0644\u0637\u0648\u0644 \u0648\u0642\u062f \u062a\u0643\u0648\u0646 \u0645\u0642\u0637\u0648\u0639\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umschreibung endete am L\u00e4ngenlimit und ist m\u00f6glicherweise abgeschnitten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rewrite stopped at the length limit and may be cut off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reescritura se detuvo en el l\u00edmite de longitud y puede estar cortada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La r\u00e9\u00e9criture s'est arr\u00eat\u00e9e \u00e0 la limite de longueur et peut \u00eatre tronqu\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05db\u05ea\u05d9\u05d1\u05d4 \u05de\u05d7\u05d3\u05e9 \u05e0\u05e2\u05e6\u05e8\u05d4 \u05d1\u05de\u05d2\u05d1\u05dc\u05ea \u05d4\u05d0\u05d5\u05e8\u05da \u05d5\u05d9\u05d9\u05ea\u05db\u05df \u05e9\u05e0\u05d7\u05ea\u05db\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b\u092c\u093e\u0930\u093e \u0932\u093f\u0916\u0928\u093e \u0932\u0902\u092c\u093e\u0908 \u0915\u0940 \u0938\u0940\u092e\u093e \u092a\u0930 \u0930\u0941\u0915 \u0917\u092f\u093e \u0914\u0930 \u0905\u0927\u0942\u0930\u093e \u0939\u094b \u0938\u0915\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penulisan ulang berhenti di batas panjang dan mungkin terpotong."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riscrittura si \u00e8 fermata al limite di lunghezza e potrebbe essere troncata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f8\u304d\u76f4\u3057\u306f\u9577\u3055\u306e\u4e0a\u9650\u3067\u6b62\u307e\u3063\u305f\u305f\u3081\u3001\u9014\u4e2d\u3067\u5207\u308c\u3066\u3044\u308b\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc2dc \uc4f0\uae30\uac00 \uae38\uc774 \uc81c\ud55c\uc5d0\uc11c \uba48\ucdb0 \ub0b4\uc6a9\uc774 \uc798\ub838\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herschrijving stopte bij de lengtelimiet en is mogelijk afgekapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisywanie zatrzyma\u0142o si\u0119 na limicie d\u0142ugo\u015bci i tekst mo\u017ce by\u0107 uci\u0119ty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reescrita parou no limite de tamanho e pode estar cortada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043d\u0438\u0435 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u043e\u0441\u044c \u043d\u0430 \u043b\u0438\u043c\u0438\u0442\u0435 \u0434\u043b\u0438\u043d\u044b, \u0442\u0435\u043a\u0441\u0442 \u043c\u043e\u0436\u0435\u0442 \u0431\u044b\u0442\u044c \u043e\u0431\u0440\u0435\u0437\u0430\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskrivningen stoppade vid l\u00e4ngdgr\u00e4nsen och kan vara avkortad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yaz\u0131m uzunluk s\u0131n\u0131r\u0131nda durdu ve kesilmi\u015f olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043f\u0438\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0443\u043f\u0438\u043d\u0438\u043b\u043e\u0441\u044f \u043d\u0430 \u043b\u0456\u043c\u0456\u0442\u0456 \u0434\u043e\u0432\u0436\u0438\u043d\u0438, \u0442\u0435\u043a\u0441\u0442 \u043c\u043e\u0436\u0435 \u0431\u0443\u0442\u0438 \u043e\u0431\u0440\u0456\u0437\u0430\u043d\u0438\u0439."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n vi\u1ebft l\u1ea1i d\u1eebng \u1edf gi\u1edbi h\u1ea1n \u0111\u1ed9 d\u00e0i v\u00e0 c\u00f3 th\u1ec3 b\u1ecb c\u1eaft c\u1ee5t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6539\u5199\u5728\u957f\u5ea6\u4e0a\u9650\u5904\u505c\u6b62\uff0c\u5185\u5bb9\u53ef\u80fd\u88ab\u622a\u65ad\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6539\u5beb\u5728\u9577\u5ea6\u4e0a\u9650\u8655\u505c\u6b62\uff0c\u5167\u5bb9\u53ef\u80fd\u88ab\u622a\u65b7\u3002"
          }
        }
      }
    },
