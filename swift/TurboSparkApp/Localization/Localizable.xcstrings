            "state": "translated",
            "value": "Devral\u0131nan kayna\u011f\u0131 geri y\u00fckle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0443\u0441\u043f\u0430\u0434\u043a\u043e\u0432\u0430\u043d\u0435 \u0434\u0436\u0435\u0440\u0435\u043b\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4i ph\u1ee5c ngu\u1ed3n k\u1ebf th\u1eeba"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
