            "value": "\u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0627\u0644\u0642\u0648\u0627\u0639\u062f \u0639\u0644\u0649 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0635\u064a\u0627\u063a\u0629 \u0627\u0644\u062a\u0627\u0644\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Regeln gelten f\u00fcr die n\u00e4chste Umschreibung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las reglas se aplican a la pr\u00f3xima reescritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les r\u00e8gles s'appliquent \u00e0 la prochaine r\u00e9\u00e9criture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05db\u05dc\u05dc\u05d9\u05dd \u05d9\u05d7\u05d5\u05dc\u05d5 \u05e2\u05dc \u05d4\u05e9\u05db\u05ea\u05d5\u05d1 \u05d4\u05d1\u05d0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u092f\u092e \u0905\u0917\u0932\u0947 \u092a\u0941\u0928\u0930\u094d\u0932\u0947\u0916\u0928 \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aturan berlaku untuk tulis ulang berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le regole si applicano alla prossima riscrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30eb\u30fc\u30eb\u306f\u6b21\u306e\u66f8\u304d\u76f4\u3057\u304b\u3089\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uaddc\uce59\uc740 \ub2e4\uc74c \ub2e4\uc2dc \uc4f0\uae30\ubd80\ud130 \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De regels gelden voor de volgende herschrijving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Regu\u0142y zostan\u0105 zastosowane przy nast\u0119pnym przepisaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As regras valem para a pr\u00f3xima reescrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043a \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u043c\u0443 \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043d\u0438\u044e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Reglerna g\u00e4ller f\u00f6r n\u00e4sta omskrivning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurallar bir sonraki yeniden yaz\u0131mda uygulan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0430\u0432\u0438\u043b\u0430 \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u043e \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0443\u0432\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quy t\u1eafc \u00e1p d\u1ee5ng cho l\u1ea7n vi\u1ebft l\u1ea1i ti\u1ebfp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u89c4\u5219\u5c06\u5728\u4e0b\u4e00\u6b21\u6539\u5199\u65f6\u751f\u6548\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u898f\u5247\u5c07\u5728\u4e0b\u4e00\u6b21\u6539\u5beb\u6642\u751f\u6548\u3002"
          }
        }
      }
    },
