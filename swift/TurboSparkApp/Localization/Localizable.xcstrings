          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b\u092c\u093e\u0930\u093e \u0932\u093f\u0916\u093e \u0917\u092f\u093e \u092a\u093e\u0920 \u092e\u0942\u0932 \u092a\u093e\u0920 \u0938\u0947 \u0932\u0902\u092c\u0947 \u0935\u093e\u0915\u094d\u092f\u093e\u0902\u0936 \u091c\u094d\u092f\u094b\u0902 \u0915\u0947 \u0924\u094d\u092f\u094b\u0902 \u0909\u0920\u093e\u0924\u093e \u0939\u0948\u0964"
