    "Gate threshold (0 always fires)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u062a\u0628\u0629 \u0627\u0644\u0628\u0648\u0627\u0628\u0629 (0 \u062a\u0639\u0645\u0644 \u062f\u0627\u0626\u0645\u064b\u0627)"
          }
        },
        "de": {
