        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05ea\u05d7 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05d3\u05d9 \u05dc\u05db\u05ea\u05d5\u05d1 \u05e1\u05d5\u05db\u05df \u05d1\u05d4\u05d9\u05e7\u05e3 \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f-\u0938\u094d\u0915\u094b\u092a \u0935\u093e\u0932\u093e \u090f\u091c\u0947\u0902\u091f \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0916\u094b\u0932\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
