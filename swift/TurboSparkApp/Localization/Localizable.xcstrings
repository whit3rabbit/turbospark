    "No agent definitions match the selected scope filter.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u062a\u0639\u0631\u064a\u0641\u0627\u062a \u0648\u0643\u0644\u0627\u0621 \u062a\u0637\u0627\u0628\u0642 \u0645\u0631\u0634\u062d \u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u062d\u062f\u062f."
