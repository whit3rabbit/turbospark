          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u062f\u0639\u0627\u0621\u0627\u062a \u0627\u0644\u0623\u062f\u0648\u0627\u062a: \u063a\u064a\u0631 \u0645\u0639\u0631\u0648\u0641\u0629"
          }
        },
        "de": {
