    "Leave empty for the default tool set.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغا لاستخدام مجموعة الأدوات الافتراضية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den Standard-Toolsatz zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty for the default tool set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar el conjunto de herramientas predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser l'ensemble d'outils par défaut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר ריק כדי להשתמש בערכת הכלים המוגדרת כברירת מחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट टूल सेट के लिए खाली छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk set alat default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per usare il set di strumenti predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定のツールセットを使用する場合は空のままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 도구 세트를 사용하려면 비워 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg voor de standaardset tools."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby użyć domyślnego zestawu narzędzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar o conjunto de ferramentas padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы использовать стандартный набор инструментов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för standarduppsättningen av verktyg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan araç kümesi için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім, щоб використати типовий набір інструментів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để dùng bộ công cụ mặc định."
          }
        },
        "zh-Hans": {
