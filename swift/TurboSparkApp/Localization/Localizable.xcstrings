    "Click 'Install...' in the toolbar to browse the catalog.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 '\u062a\u062b\u0628\u064a\u062a...' \u0641\u064a \u0634\u0631\u064a\u0637 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0644\u062a\u0635\u0641\u062d \u0627\u0644\u0643\u062a\u0627\u0644\u0648\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie in der Symbolleiste auf \u201eInstallieren...\u201c, um den Katalog zu durchsuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click 'Install...' in the toolbar to browse the catalog."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en 'Instalar...' en la barra de herramientas para explorar el cat\u00e1logo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur \u00ab Installer... \u00bb dans la barre d'outils pour parcourir le catalogue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d7\u05e5 \u05e2\u05dc '\u05d4\u05ea\u05e7\u05df...' \u05d1\u05e1\u05e8\u05d2\u05dc \u05d4\u05db\u05dc\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05e2\u05d9\u05d9\u05df \u05d1\u05e7\u05d8\u05dc\u05d5\u05d2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0948\u091f\u0932\u0949\u0917 \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091f\u0942\u0932\u092c\u093e\u0930 \u092e\u0947\u0902 '\u0907\u0902\u0938\u094d\u091f\u0949\u0932...' \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik 'Instal...' di bilah alat untuk menelusuri katalog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su 'Installa...' nella barra degli strumenti per sfogliare il catalogo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c4\u30fc\u30eb\u30d0\u30fc\u306e\u300c\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb...\u300d\u3092\u30af\u30ea\u30c3\u30af\u3057\u3066\u30ab\u30bf\u30ed\u30b0\u3092\u53c2\u7167\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uce74\ud0c8\ub85c\uadf8\ub97c \ud0d0\uc0c9\ud558\ub824\uba74 \ub3c4\uad6c \ubaa8\uc74c\uc5d0\uc11c '\uc124\uce58...'\ub97c \ud074\ub9ad\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op 'Installeren...' in de werkbalk om de catalogus te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij 'Zainstaluj...' na pasku narz\u0119dzi, aby przegl\u0105da\u0107 katalog."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em 'Instalar...' na barra de ferramentas para navegar pelo cat\u00e1logo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u00ab\u0423\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c...\u00bb \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0434\u043b\u044f \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0430 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka p\u00e5 'Installera...' i verktygsf\u00e4ltet f\u00f6r att bl\u00e4ddra i katalogen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalo\u011fa g\u00f6z atmak i\u00e7in ara\u00e7 \u00e7ubu\u011fundaki 'Y\u00fckle...' d\u00fc\u011fmesine t\u0131klay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c '\u0412\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0438...' \u043d\u0430 \u043f\u0430\u043d\u0435\u043b\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0443 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1ea5p v\u00e0o 'C\u00e0i \u0111\u1eb7t...' tr\u00ean thanh c\u00f4ng c\u1ee5 \u0111\u1ec3 duy\u1ec7t danh m\u1ee5c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5de5\u5177\u680f\u4e2d\u70b9\u51fb\u201c\u5b89\u88c5...\u201d\u4ee5\u6d4f\u89c8\u76ee\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5de5\u5177\u5217\u4e2d\u9ede\u64ca\u300c\u5b89\u88dd...\u300d\u4ee5\u700f\u89bd\u76ee\u9304\u3002"
          }
        }
      }
    },
    "Click any file to view modifications.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0646\u0642\u0631 \u0639\u0644\u0649 \u0623\u064a \u0645\u0644\u0641 \u0644\u0639\u0631\u0636 \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicken Sie auf eine Datei, um die \u00c4nderungen anzuzeigen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click any file to view modifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en cualquier archivo para ver las modificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cliquez sur un fichier pour voir les modifications."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d7\u05e5 \u05e2\u05dc \u05e7\u05d5\u05d1\u05e5 \u05db\u05dc\u05e9\u05d4\u05d5 \u05db\u05d3\u05d9 \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05ea \u05d4\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0926\u0932\u093e\u0935 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u092d\u0940 \u092b\u093c\u093e\u0907\u0932 \u092a\u0930 \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik berkas mana pun untuk melihat perubahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai clic su un file per vedere le modifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4efb\u610f\u306e\u30d5\u30a1\u30a4\u30eb\u3092\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u5909\u66f4\u5185\u5bb9\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud30c\uc77c\uc744 \ud074\ub9ad\ud558\uba74 \uc218\uc815 \ub0b4\uc6a9\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik op een bestand om de wijzigingen te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij dowolny plik, aby zobaczy\u0107 zmiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em qualquer arquivo para ver as modifica\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u043d\u0430 \u043b\u044e\u0431\u043e\u0439 \u0444\u0430\u0439\u043b, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicka p\u00e5 en fil f\u00f6r att se \u00e4ndringarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "De\u011fi\u015fiklikleri g\u00f6rmek i\u00e7in herhangi bir dosyaya t\u0131klay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u043d\u0430 \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u0444\u0430\u0439\u043b, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438 \u0437\u043c\u0456\u043d\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1ea5p v\u00e0o b\u1ea5t k\u1ef3 t\u1ec7p n\u00e0o \u0111\u1ec3 xem thay \u0111\u1ed5i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70b9\u51fb\u4efb\u610f\u6587\u4ef6\u5373\u53ef\u67e5\u770b\u4fee\u6539\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ede\u6309\u4efb\u4e00\u6a94\u6848\u5373\u53ef\u6aa2\u8996\u4fee\u6539\u3002"
          }
        }
      }
    },
