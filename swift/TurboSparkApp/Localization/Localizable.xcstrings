        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0940 \u0916\u094b\u091c \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0924\u0940 \u0915\u094b\u0908 \u0936\u0948\u0932\u0940 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
