    "Subagents the assistant can hand a task to, each with its own instructions and tool limits.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وكلاء فرعيون يمكن للمساعد تسليمهم مهمة، لكل منهم تعليماته وحدود أدواته."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Subagenten, an die der Assistent eine Aufgabe übergeben kann, jeweils mit eigenen Anweisungen und Tool-Grenzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subagents the assistant can hand a task to, each with its own instructions and tool limits."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Subagentes a los que el asistente puede encargar una tarea, cada uno con sus propias instrucciones y límites de herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sous-agents auxquels l’assistant peut confier une tâche, chacun avec ses propres instructions et limites d’outils."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סוכני משנה שהעוזר יכול להעביר אליהם משימה, לכל אחד הוראות ומגבלות כלים משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उप-एजेंट, जिन्हें सहायक कोई कार्य सौंप सकता है; हर एक के अपने निर्देश और टूल सीमाएँ होती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Subagen yang dapat diberi tugas oleh asisten, masing-masing dengan instruksi dan batas alatnya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Subagenti a cui l’assistente può affidare un compito, ognuno con istruzioni e limiti di strumenti propri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アシスタントがタスクを任せられるサブエージェントです。それぞれ独自の指示とツール制限を持ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어시스턴트가 작업을 맡길 수 있는 하위 에이전트로, 각각 고유한 지침과 도구 제한이 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Subagenten waaraan de assistent een taak kan overdragen, elk met eigen instructies en toolbeperkingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podagenci, którym asystent może przekazać zadanie, każdy z własnymi instrukcjami i limitami narzędzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Subagentes aos quais o assistente pode delegar uma tarefa, cada um com suas próprias instruções e limites de ferramentas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Субагенты, которым ассистент может передать задачу, каждый со своими инструкциями и ограничениями инструментов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Underagenter som assistenten kan lämna över en uppgift till, var och en med egna instruktioner och verktygsgränser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistanın görev devredebileceği, her birinin kendi talimatları ve araç sınırları olan alt ajanlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Субагенти, яким асистент може передати завдання, кожен зі своїми інструкціями та обмеженнями інструментів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tác tử con mà trợ lý có thể giao việc, mỗi tác tử có hướng dẫn và giới hạn công cụ riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "助手可以交付任务的子智能体，各自有自己的说明和工具限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "助理可以交付工作的子代理，各自有自己的指示與工具限制。"
          }
        }
      }
    },
