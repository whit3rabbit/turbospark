    "Only clone your own voice or the voice of someone who agreed. Changing the reference clears this confirmation.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only clone your own voice or the voice of someone who agreed. Changing the reference clears this confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona solo tu propia voz o la de alguien que haya dado su consentimiento. Cambiar la referencia borra esta confirmaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne clonez que votre propre voix ou celle d'une personne qui a donn\u00e9 son accord. Changer la r\u00e9f\u00e9rence efface cette confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonen Sie nur Ihre eigene Stimme oder die Stimme einer Person, die zugestimmt hat. Wenn Sie die Referenz \u00e4ndern, wird diese Best\u00e4tigung zur\u00fcckgesetzt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clona solo la tua voce o quella di una persona che ha dato il consenso. Cambiare il riferimento annulla questa conferma."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clone apenas a sua pr\u00f3pria voz ou a de algu\u00e9m que concordou. Alterar a refer\u00eancia apaga esta confirma\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043b\u043e\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u0442\u043e\u043b\u044c\u043a\u043e \u0441\u0432\u043e\u0439 \u0433\u043e\u043b\u043e\u0441 \u0438\u043b\u0438 \u0433\u043e\u043b\u043e\u0441 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0434\u0430\u043b \u0441\u043e\u0433\u043b\u0430\u0441\u0438\u0435. \u041f\u0440\u0438 \u0441\u043c\u0435\u043d\u0435 \u044d\u0442\u0430\u043b\u043e\u043d\u0430 \u044d\u0442\u043e \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435 \u0441\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u0435\u0442\u0441\u044f."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30af\u30ed\u30fc\u30f3\u3059\u308b\u306e\u306f\u81ea\u5206\u306e\u58f0\u304b\u3001\u540c\u610f\u3057\u305f\u4eba\u306e\u58f0\u3060\u3051\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u53c2\u8003\u97f3\u58f0\u3092\u5909\u66f4\u3059\u308b\u3068\u3001\u3053\u306e\u78ba\u8a8d\u306f\u89e3\u9664\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcf8\uc778\uc758 \uc74c\uc131\uc774\ub098 \ub3d9\uc758\ud55c \uc0ac\ub78c\uc758 \uc74c\uc131\ub9cc \ubcf5\uc81c\ud558\uc138\uc694. \ucc38\uc870\ub97c \ubcc0\uacbd\ud558\uba74 \uc774 \ud655\uc778\uc774 \ud574\uc81c\ub429\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u514b\u9686\u4f60\u81ea\u5df1\u7684\u58f0\u97f3\uff0c\u6216\u5df2\u540c\u610f\u7684\u4eba\u7684\u58f0\u97f3\u3002\u66f4\u6362\u53c2\u8003\u97f3\u9891\u4f1a\u6e05\u9664\u6b64\u786e\u8ba4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ea\u8907\u88fd\u4f60\u81ea\u5df1\u7684\u8072\u97f3\uff0c\u6216\u5df2\u540c\u610f\u7684\u4eba\u7684\u8072\u97f3\u3002\u66f4\u63db\u53c3\u8003\u97f3\u8a0a\u6703\u6e05\u9664\u6b64\u78ba\u8a8d\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0633\u062a\u0646\u0633\u062e \u0625\u0644\u0627 \u0635\u0648\u062a\u0643 \u0623\u0648 \u0635\u0648\u062a \u0634\u062e\u0635 \u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0630\u0644\u0643. \u064a\u0624\u062f\u064a \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0631\u062c\u0639 \u0625\u0644\u0649 \u0625\u0644\u063a\u0627\u0621 \u0647\u0630\u0627 \u0627\u0644\u062a\u0623\u0643\u064a\u062f."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05db\u05e4\u05dc \u05e8\u05e7 \u05d0\u05ea \u05d4\u05e7\u05d5\u05dc \u05e9\u05dc\u05da \u05d0\u05d5 \u05e7\u05d5\u05dc \u05e9\u05dc \u05de\u05d9 \u05e9\u05d4\u05e1\u05db\u05d9\u05dd \u05dc\u05db\u05da. \u05e9\u05d9\u05e0\u05d5\u05d9 \u05d4\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05de\u05d1\u05d8\u05dc \u05d0\u05ea \u05d4\u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0947\u0935\u0932 \u0905\u092a\u0928\u0940 \u0906\u0935\u093e\u091c\u093c \u092f\u093e \u0909\u0938 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0940 \u0906\u0935\u093e\u091c\u093c \u0915\u094d\u0932\u094b\u0928 \u0915\u0930\u0947\u0902 \u091c\u093f\u0938\u0928\u0947 \u0938\u0939\u092e\u0924\u093f \u0926\u0940 \u0939\u094b\u0964 \u0938\u0902\u0926\u0930\u094d\u092d \u092c\u0926\u0932\u0928\u0947 \u092a\u0930 \u092f\u0939 \u092a\u0941\u0937\u094d\u091f\u093f \u0939\u091f \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kloon alleen je eigen stem of de stem van iemand die toestemming gaf. Als je de referentie wijzigt, vervalt deze bevestiging."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klonuj tylko w\u0142asny g\u0142os lub g\u0142os osoby, kt\u00f3ra wyrazi\u0142a zgod\u0119. Zmiana nagrania referencyjnego anuluje to potwierdzenie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaln\u0131zca kendi sesinizi veya izin veren birinin sesini klonlay\u0131n. Referans\u0131 de\u011fi\u015ftirmek bu onay\u0131 kald\u0131r\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043b\u043e\u043d\u0443\u0439\u0442\u0435 \u043b\u0438\u0448\u0435 \u0432\u043b\u0430\u0441\u043d\u0438\u0439 \u0433\u043e\u043b\u043e\u0441 \u0430\u0431\u043e \u0433\u043e\u043b\u043e\u0441 \u043b\u044e\u0434\u0438\u043d\u0438, \u044f\u043a\u0430 \u043f\u043e\u0433\u043e\u0434\u0438\u043b\u0430\u0441\u044f. \u0417\u043c\u0456\u043d\u0430 \u0435\u0442\u0430\u043b\u043e\u043d\u0430 \u0441\u043a\u0430\u0441\u043e\u0432\u0443\u0454 \u0446\u0435 \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Klona bara din egen r\u00f6st eller r\u00f6sten hos n\u00e5gon som har samtyckt. Om du byter referens nollst\u00e4lls bekr\u00e4ftelsen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ec9 nh\u00e2n b\u1ea3n gi\u1ecdng c\u1ee7a ch\u00ednh b\u1ea1n ho\u1eb7c c\u1ee7a ng\u01b0\u1eddi \u0111\u00e3 \u0111\u1ed3ng \u00fd. \u0110\u1ed5i b\u1ea3n tham kh\u1ea3o s\u1ebd x\u00f3a x\u00e1c nh\u1eadn n\u00e0y."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya kloning suara Anda sendiri atau suara orang yang sudah setuju. Mengganti referensi akan menghapus konfirmasi ini."
          }
        }
      }
    },
