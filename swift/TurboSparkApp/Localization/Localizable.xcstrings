        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0454 \u043c\u043e\u0434\u0435\u043b\u044c \u0456 \u043f\u043e\u0447\u0438\u043d\u0430\u0454 \u0437 \u043d\u0435\u044e \u043d\u043e\u0432\u0438\u0439 \u0447\u0430\u0442"
