        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co prawdziwe wywołanie z tym żądaniem wypełniłoby wstępnie. Niczego nie generuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que uma chamada real com esta solicitação pré-preencheria. Não gera nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что заполнил бы реальный вызов с этим запросом. Ничего не генерирует."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vad ett verkligt anrop med den här förfrågan skulle förifylla. Genererar ingenting."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istekle gerçek bir çağrının ön dolduracağı içerik. Hiçbir şey üretmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що заповнив би реальний виклик із цим запитом. Нічого не генерує."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nội dung mà lệnh gọi thực với yêu cầu này sẽ điền trước. Không tạo gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用此请求真正调用时会预填充的内容。不生成任何内容。"
