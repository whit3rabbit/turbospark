    "Stop generation and unload the current model before moving the store.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف التوليد وقم بإلغاء تحميل النموذج الحالي قبل نقل المتجر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen Sie die Generierung und entladen Sie das aktuelle Modell, bevor Sie den Speicher verschieben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop generation and unload the current model before moving the store."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén la generación y descarga el modelo actual antes de mover el almacén."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez la génération et déchargez le modèle actuel avant de déplacer le magasin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עצור את היצירה ובטל את טעינת המודל הנוכחי לפני העברת המאגר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्टोर को स्थानांतरित करने से पहले पीढ़ी को रोकें और वर्तमान मॉडल को अनलोड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan pembuatan dan bongkar model saat ini sebelum memindahkan penyimpanan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi la generazione e scarica il modello corrente prima di spostare l'archivio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストアを移動する前に、生成を停止して現在のモデルをアンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장소를 이동하기 전에 생성을 중지하고 현재 모델을 언로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop het genereren en ontlaad het huidige model voordat u de opslag verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj generowanie i wyładuj bieżący model przed przeniesieniem magazynu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare a geração e descarregue o modelo atual antes de mover o armazenamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановите генерацию и выгрузите текущую модель перед перемещением хранилища."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa genereringen och läs ur den aktuella modellen innan du flyttar lagringen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depoyu taşımadan önce üretimi durdurun ve mevcut modeli kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніть генерацію та вивантажте поточну модель перед переміщенням сховища."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng tạo và dỡ mô hình hiện tại trước khi di chuyển kho lưu trữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动存储前请先停止生成并卸载当前模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移動存放區前請先停止生成並卸載目前的模型。"
          }
        }
      }
    },
