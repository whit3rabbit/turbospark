        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d5\u05d1\u05e5 \u05d4\u05de\u05e7\u05d5\u05e8 \u05db\u05d1\u05e8 \u05d0\u05d9\u05e0\u05d5 \u05d1\u05e0\u05ea\u05d9\u05d1 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9 \u05e9\u05dc\u05d5."
