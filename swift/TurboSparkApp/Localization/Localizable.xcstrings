        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0434\u0430\u0442\u0438 \u043d\u043e\u0432\u0438\u0439 \u0433\u043b\u043e\u0431\u0430\u043b\u044c\u043d\u0438\u0439 MCP-\u0441\u0435\u0440\u0432\u0435\u0440"
