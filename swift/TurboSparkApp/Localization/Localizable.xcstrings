    "In-app created automation and guardrail hooks": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062e\u0637\u0627\u0641\u0627\u062a \u0627\u0644\u0623\u062a\u0645\u062a\u0629 \u0648\u0627\u0644\u062d\u0648\u0627\u062c\u0632 \u0627\u0644\u0648\u0642\u0627\u0626\u064a\u0629 \u0627\u0644\u062a\u064a \u0623\u064f\u0646\u0634\u0626\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642"
          }
