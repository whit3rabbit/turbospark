          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen andere bibliotheek verbonden waarnaar dit model kan worden verplaatst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ma podłączonej innej biblioteki, do której można przenieść ten model."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há outra biblioteca conectada para onde mover este modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет другой подключённой библиотеки, в которую можно переместить эту модель."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget annat anslutet bibliotek att flytta den här modellen till."
          }
        },
        "tr": {
          "stringUnit": {
