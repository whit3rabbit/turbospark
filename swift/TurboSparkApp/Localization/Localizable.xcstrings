    "Could not transcribe, attached the recording instead: %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631 \u0627\u0644\u062a\u0641\u0631\u064a\u063a \u0627\u0644\u0646\u0635\u064a\u060c \u0641\u0623\u064f\u0631\u0641\u0642 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0628\u062f\u0644\u064b\u0627 \u0645\u0646 \u0630\u0644\u0643: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transkription nicht m\u00f6glich, stattdessen wurde die Aufnahme angeh\u00e4ngt: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not transcribe, attached the recording instead: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo transcribir; se adjunt\u00f3 la grabaci\u00f3n en su lugar: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcription impossible, l'enregistrement a \u00e9t\u00e9 joint \u00e0 la place : %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05d4\u05d9\u05d4 \u05dc\u05ea\u05de\u05dc\u05dc, \u05d4\u05d4\u05e7\u05dc\u05d8\u05d4 \u05e6\u05d5\u05e8\u05e4\u05d4 \u05d1\u05de\u05e7\u05d5\u05dd: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u094d\u0930\u093e\u0902\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e, \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0938\u0902\u0932\u0917\u094d\u0928 \u0915\u0940 \u0917\u0908: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat mentranskripsi, rekaman dilampirkan sebagai gantinya: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile trascrivere, \u00e8 stata allegata la registrazione: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6587\u5b57\u8d77\u3053\u3057\u3067\u304d\u306a\u304b\u3063\u305f\u305f\u3081\u3001\u4ee3\u308f\u308a\u306b\u9332\u97f3\u3092\u6dfb\u4ed8\u3057\u307e\u3057\u305f\uff1a%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud14d\uc2a4\ud2b8\ub85c \ubcc0\ud658\ud560 \uc218 \uc5c6\uc5b4 \ub300\uc2e0 \ub179\uc74c\uc744 \ucca8\ubd80\ud588\uc2b5\ub2c8\ub2e4: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transcriberen mislukt, de opname is in plaats daarvan bijgevoegd: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uda\u0142o si\u0119 przetranskrybowa\u0107, zamiast tego do\u0142\u0105czono nagranie: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel transcrever; a grava\u00e7\u00e3o foi anexada no lugar: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0440\u0430\u0441\u043f\u043e\u0437\u043d\u0430\u0442\u044c \u0440\u0435\u0447\u044c, \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0435\u043d\u0430 \u0437\u0430\u043f\u0438\u0441\u044c: %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte transkribera, bifogade inspelningen i st\u00e4llet: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metne d\u00f6n\u00fc\u015ft\u00fcr\u00fclemedi, bunun yerine kay\u0131t eklendi: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0440\u043e\u0437\u043f\u0456\u0437\u043d\u0430\u0442\u0438 \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f, \u043d\u0430\u0442\u043e\u043c\u0456\u0441\u0442\u044c \u043f\u0440\u0438\u043a\u0440\u0456\u043f\u043b\u0435\u043d\u043e \u0437\u0430\u043f\u0438\u0441: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 ch\u00e9p l\u1eddi, \u0111\u00e3 \u0111\u00ednh k\u00e8m b\u1ea3n ghi thay th\u1ebf: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u8f6c\u5199\uff0c\u5df2\u6539\u4e3a\u9644\u52a0\u5f55\u97f3\uff1a%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u8f49\u5beb\uff0c\u5df2\u6539\u70ba\u9644\u52a0\u9304\u97f3\uff1a%@"
          }
        }
      }
    },
