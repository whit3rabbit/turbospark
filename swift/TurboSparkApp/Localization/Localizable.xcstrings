    "This model supports its default size only.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model supports its default size only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo solo admite su tamaño predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle ne prend en charge que sa taille par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell unterstützt nur seine Standardgröße."
