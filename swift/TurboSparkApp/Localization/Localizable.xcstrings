        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Genereringen avslutades utan resultat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Olu\u015fturma sonu\u00e7 vermeden sona erdi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u044f \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u043b\u0430\u0441\u044f \u0431\u0435\u0437 \u0440\u0435\u0437\u0443\u043b\u044c\u0442\u0430\u0442\u0443."
