          "stringUnit": {
            "state": "translated",
            "value": "Välkommen tillbaka! Vad jobbar vi på?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekrar hoş geldiniz! Ne üzerinde çalışıyoruz?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "З поверненням! Над чим працюємо?"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chào mừng trở lại! Chúng ta đang làm gì nào?"
          }
