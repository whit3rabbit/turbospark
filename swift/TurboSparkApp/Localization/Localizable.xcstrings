            "value": "مصدر GitHub يكون بصيغة owner/repo، مثل anthropics/claude-plugins-official."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine GitHub-Quelle hat die Form owner/repo, z. B. anthropics/claude-plugins-official."
          }
        },
        "en": {
          "stringUnit": {
