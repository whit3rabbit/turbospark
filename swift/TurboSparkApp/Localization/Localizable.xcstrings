    "Leave empty for the default tool set.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty for the default tool set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para usar el conjunto de herramientas predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser l'ensemble d'outils par défaut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den Standard-Toolsatz zu verwenden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per usare il set di strumenti predefinito."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar o conjunto de ferramentas padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы использовать стандартный набор инструментов."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定のツールセットを使用する場合は空のままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 도구 세트를 사용하려면 비워 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空以使用默认工具集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空以使用預設工具集。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغا لاستخدام مجموعة الأدوات الافتراضية."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר ריק כדי להשתמש בערכת הכלים המוגדרת כברירת מחדל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डिफ़ॉल्ट टूल सेट के लिए खाली छोड़ें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg voor de standaardset tools."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby użyć domyślnego zestawu narzędzi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsayılan araç kümesi için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім, щоб використати типовий набір інструментів."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för standarduppsättningen av verktyg."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để dùng bộ công cụ mặc định."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk set alat default."
          }
        }
      }
    },
    "Leave empty to launch the server in the active project's root.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to launch the server in the active project's root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Déjalo vacío para iniciar el servidor en la raíz del proyecto activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour lancer le serveur à la racine du projet actif."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den Server im Stammverzeichnis des aktiven Projekts zu starten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per avviare il server nella radice del progetto attivo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para iniciar o servidor na raiz do projeto ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставьте пустым, чтобы запустить сервер в корне активного проекта."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アクティブなプロジェクトのルートでサーバーを起動する場合は空のままにします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 프로젝트의 루트에서 서버를 실행하려면 비워 두세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空以在当前项目的根目录中启动服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空以在目前專案的根目錄中啟動伺服器。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اتركه فارغا لتشغيل الخادم في جذر المشروع النشط."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר ריק כדי להפעיל את השרת בתיקיית השורש של הפרויקט הפעיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय प्रोजेक्ट की रूट में सर्वर शुरू करने के लिए खाली छोड़ें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de server te starten in de hoofdmap van het actieve project."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby uruchomić serwer w katalogu głównym aktywnego projektu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuyu etkin projenin kökünde başlatmak için boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Залиште порожнім, щоб запустити сервер у корені активного проєкту."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lämna tomt för att starta servern i det aktiva projektets rotkatalog."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Để trống để khởi chạy máy chủ tại thư mục gốc của dự án đang hoạt động."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk menjalankan server di root proyek aktif."
          }
        }
      }
    },
