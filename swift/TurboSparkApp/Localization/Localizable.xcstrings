    "Attach a project before saving project memory.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0631\u0641\u0642 \u0645\u0634\u0631\u0648\u0639\u064b\u0627 \u0642\u0628\u0644 \u062d\u0641\u0638 \u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0645\u0634\u0631\u0648\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie zuerst ein Projekt, um im Projektspeicher zu speichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach a project before saving project memory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta un proyecto antes de guardar en la memoria del proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez un projet avant d'enregistrer dans la m\u00e9moire du projet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e6\u05e8\u05e3 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05de\u05d9\u05e8\u05d4 \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u092e\u0947\u092e\u094b\u0930\u0940 \u0938\u0939\u0947\u091c\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0915\u094b\u0908 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0938\u0902\u0932\u0917\u094d\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampirkan proyek sebelum menyimpan memori proyek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega un progetto prima di salvare nella memoria del progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30e1\u30e2\u30ea\u306b\u4fdd\u5b58\u3059\u308b\u524d\u306b\u3001\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u63a5\u7d9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8 \uba54\ubaa8\ub9ac\ub97c \uc800\uc7a5\ud558\uae30 \uc804\uc5d0 \ud504\ub85c\uc81d\ud2b8\ub97c \uc5f0\uacb0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel een project voordat je iets in het projectgeheugen opslaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do\u0142\u0105cz projekt przed zapisaniem pami\u0119ci projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe um projeto antes de salvar na mem\u00f3ria do projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043f\u0440\u043e\u0435\u043a\u0442, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0442\u044c \u0432 \u043f\u0430\u043c\u044f\u0442\u044c \u043f\u0440\u043e\u0435\u043a\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut ett projekt innan du sparar i projektminnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje belle\u011fine kaydetmeden \u00f6nce bir proje ba\u011flay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434\u043a\u043b\u044e\u0447\u0456\u0442\u044c \u043f\u0440\u043e\u0454\u043a\u0442, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0442\u0438 \u0432 \u043f\u0430\u043c'\u044f\u0442\u044c \u043f\u0440\u043e\u0454\u043a\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y g\u1eafn m\u1ed9t d\u1ef1 \u00e1n tr\u01b0\u1edbc khi l\u01b0u b\u1ed9 nh\u1edb d\u1ef1 \u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u6302\u8f7d\u9879\u76ee\uff0c\u518d\u4fdd\u5b58\u9879\u76ee\u8bb0\u5fc6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u639b\u8f09\u5c08\u6848\uff0c\u518d\u5132\u5b58\u5c08\u6848\u8a18\u61b6\u3002"
          }
        }
      }
    },
    "Attach a project first: a shell command needs a working directory.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0631\u0641\u0642 \u0645\u0634\u0631\u0648\u0639\u064b\u0627 \u0623\u0648\u0644\u064b\u0627: \u064a\u062d\u062a\u0627\u062c \u0623\u0645\u0631 \u0627\u0644\u0635\u062f\u0641\u0629 \u0625\u0644\u0649 \u062f\u0644\u064a\u0644 \u0639\u0645\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinden Sie zuerst ein Projekt: Ein Shell-Befehl ben\u00f6tigt ein Arbeitsverzeichnis."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Attach a project first: a shell command needs a working directory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjunta primero un proyecto: un comando de shell necesita un directorio de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Joignez d'abord un projet : une commande shell n\u00e9cessite un r\u00e9pertoire de travail."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e6\u05e8\u05e3 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05ea\u05d7\u05d9\u05dc\u05d4: \u05e4\u05e7\u05d5\u05d3\u05ea \u05de\u05e2\u05d8\u05e4\u05ea \u05d6\u05e7\u05d5\u05e7\u05d4 \u05dc\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05e2\u05d1\u05d5\u05d3\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0939\u0932\u0947 \u090f\u0915 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0938\u0902\u0932\u0917\u094d\u0928 \u0915\u0930\u0947\u0902: \u0936\u0947\u0932 \u0915\u092e\u093e\u0902\u0921 \u0915\u094b \u0915\u093e\u0930\u094d\u092f\u0936\u0940\u0932 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e \u091a\u093e\u0939\u093f\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampirkan proyek terlebih dahulu: perintah shell memerlukan direktori kerja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Collega prima un progetto: un comando shell richiede una directory di lavoro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5148\u306b\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u63a5\u7d9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u30b7\u30a7\u30eb\u30b3\u30de\u30f3\u30c9\u306b\u306f\u4f5c\u696d\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uba3c\uc800 \ud504\ub85c\uc81d\ud2b8\ub97c \uc5f0\uacb0\ud558\uc138\uc694. \uc178 \uba85\ub839\uc5d0\ub294 \uc791\uc5c5 \ub514\ub809\ud130\ub9ac\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppel eerst een project: een shell-opdracht heeft een werkmap nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw do\u0142\u0105cz projekt: polecenie pow\u0142oki wymaga katalogu roboczego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anexe um projeto primeiro: um comando de shell precisa de um diret\u00f3rio de trabalho."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u043f\u0440\u043e\u0435\u043a\u0442: \u0434\u043b\u044f \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u043e\u0431\u043e\u043b\u043e\u0447\u043a\u0438 \u043d\u0443\u0436\u0435\u043d \u0440\u0430\u0431\u043e\u0447\u0438\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anslut ett projekt f\u00f6rst: ett skalkommando beh\u00f6ver en arbetskatalog."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6nce bir proje ba\u011flay\u0131n: kabuk komutu bir \u00e7al\u0131\u015fma dizini gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u0435\u0440\u0448\u0443 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0456\u0442\u044c \u043f\u0440\u043e\u0454\u043a\u0442: \u043a\u043e\u043c\u0430\u043d\u0434\u0456 \u043e\u0431\u043e\u043b\u043e\u043d\u043a\u0438 \u043f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u0440\u043e\u0431\u043e\u0447\u0438\u0439 \u043a\u0430\u0442\u0430\u043b\u043e\u0433."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y g\u1eafn m\u1ed9t d\u1ef1 \u00e1n tr\u01b0\u1edbc: l\u1ec7nh shell c\u1ea7n th\u01b0 m\u1ee5c l\u00e0m vi\u1ec7c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u6302\u8f7d\u9879\u76ee\uff1aShell \u547d\u4ee4\u9700\u8981\u5de5\u4f5c\u76ee\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u639b\u8f09\u5c08\u6848\uff1aShell \u547d\u4ee4\u9700\u8981\u5de5\u4f5c\u76ee\u9304\u3002"
          }
        }
      }
    },
