          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のスタイル、コントラスト、アクセントカラーを適用したインターフェイスのサンプルテキストです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 스타일, 대비, 강조색이 적용된 인터페이스 샘플 텍스트입니다."
          }
        },
        "nl": {
          "stringUnit": {
