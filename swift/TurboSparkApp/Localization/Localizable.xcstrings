        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 \uff5e 30 \u79d2\u306e\u53c2\u8003\u30b9\u30d4\u30fc\u30c1\u3092\u9078\u629e\u3057\u307e\u3059\u3002"
