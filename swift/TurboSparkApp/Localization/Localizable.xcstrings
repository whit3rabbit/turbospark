    "OpenKind runs as a separate loopback service with its own API key.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعمل OpenKind كخدمة استرجاع منفصلة بمفتاح API خاص به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind läuft als separater Loopback-Dienst mit einem eigenen API-Schlüssel."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind runs as a separate loopback service with its own API key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind se ejecuta como un servicio de bucle invertido independiente con su propia clave API."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind fonctionne comme un service de boucle locale distinct avec sa propre clé API."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind פועל כשירות לולאה חוזרת נפרד עם מפתח API משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind अपनी स्वयं की API कुंजी के साथ एक अलग लूपबैक सेवा के रूप में चलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind berjalan sebagai layanan loopback terpisah dengan kunci API-nya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind viene eseguito come servizio di loopback separato con la propria chiave API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind は独自のAPIキーを持つ独立したループバックサービスとして実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind는 자체 API 키를 가진 별도의 루프백 서비스로 실행됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind draait als een afzonderlijke loopback-service met een eigen API-sleutel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind działa jako oddzielna usługa pętli zwrotnej z własnym kluczem API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind é executado como um serviço de loopback separado com sua própria chave de API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind работает как отдельная служба замыкания на себя со своим ключом API."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind körs som en separat loopback-tjänst med en egen API-nyckel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind, kendi API anahtarına sahip ayrı bir geri döngü hizmeti olarak çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind працює як окрема служба зворотного зв'язку зі своїм ключем API."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind chạy như một dịch vụ loopback riêng biệt với khóa API riêng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind 作为具有独立 API 密钥的单独回环服务运行。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenKind 作為具有獨立 API 金鑰的單獨回環服務執行。"
          }
        }
      }
    },
