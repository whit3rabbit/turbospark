          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bronbestand staat niet meer op het oorspronkelijke pad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik \u017ar\u00f3d\u0142owy nie znajduje si\u0119 ju\u017c w pierwotnej \u015bcie\u017cce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo de origem n\u00e3o est\u00e1 mais no caminho original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u0444\u0430\u0439\u043b \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e \u0441\u0432\u043e\u0435\u043c\u0443 \u043f\u0435\u0440\u0432\u043e\u043d\u0430\u0447\u0430\u043b\u044c\u043d\u043e\u043c\u0443 \u043f\u0443\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00e4llfilen finns inte l\u00e4ngre p\u00e5 sin ursprungliga s\u00f6kv\u00e4g."
