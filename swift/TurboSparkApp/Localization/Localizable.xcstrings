          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il backup contiene una voce inattesa: %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップに予期しない項目が含まれています: %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에 예상치 못한 항목이 있습니다: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De reservekopie bevat een onverwacht item: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopia zapasowa zawiera nieoczekiwany wpis: %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O backup contém uma entrada inesperada: %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервная копия содержит неожиданную запись: %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Säkerhetskopian innehåller en oväntad post: %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek beklenmeyen bir girdi içeriyor: %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Резервна копія містить неочікуваний запис: %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản sao lưu chứa một mục không mong đợi: %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "备份包含意外的条目：%@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "備份包含非預期的項目：%@。"
          }
        }
      }
    },
    "The bundled audio tokenizer is community-licensed, not Apache-licensed: it requires attribution and caps commercial use above 100,000 annual active users.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مُرمِّز الصوت المرفق مرخّص بترخيص مجتمعي وليس ترخيص Apache: يتطلب نسب العمل ويحدّ الاستخدام التجاري فوق 100,000 مستخدم نشط سنويًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gebündelte Audio-Tokenisierer ist community-lizenziert, nicht Apache-lizenziert: Er verlangt Namensnennung und begrenzt kommerzielle Nutzung ab 100.000 jährlich aktiven Nutzern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The bundled audio tokenizer is community-licensed, not Apache-licensed: it requires attribution and caps commercial use above 100,000 annual active users."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tokenizador de audio incluido tiene licencia comunitaria, no licencia Apache: exige atribución y limita el uso comercial por encima de 100.000 usuarios activos anuales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tokeniseur audio fourni est sous licence communautaire, pas sous licence Apache : il exige une attribution et plafonne l'usage commercial au-delà de 100 000 utilisateurs actifs annuels."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקודד השמע המצורף מופץ ברישיון קהילתי ולא ברישיון Apache: נדרשת ייחוס והשימוש המסחרי מוגבל מעל 100,000 משתמשים פעילים בשנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शामिल ऑडियो टोकनाइज़र सामुदायिक लाइसेंस में है, Apache लाइसेंस में नहीं: एट्रिब्यूशन ज़रूरी है और 100,000 सालाना सक्रिय उपयोगकर्ताओं से ऊपर व्यावसायिक उपयोग सीमित है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokenisasi audio bawaan dilisensikan komunitas, bukan Apache: atribusi wajib dan penggunaan komersial dibatasi di atas 100.000 pengguna aktif tahunan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tokenizzatore audio incluso è sotto licenza community, non Apache: richiede l'attribuzione e limita l'uso commerciale oltre 100.000 utenti attivi annui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "同梱のオーディオトークナイザーはApacheではなくコミュニティライセンスです：クレジット表記が必要で、年間アクティブユーザー10万人を超える商用利用は制限されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "포함된 오디오 토크나이저는 Apache가 아닌 커뮤니티 라이선스입니다: 저작자 표시가 필요하며 연간 활성 사용자 100,000명을 넘는 상업적 사용이 제한됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De meegeleverde audio-tokenizer heeft een communitylicentie, geen Apache-licentie: naamsvermelding is verplicht en commercieel gebruik is beperkt boven 100.000 jaarlijkse actieve gebruikers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołączony tokenizator audio ma licencję społecznościową, a nie Apache: wymaga podania autorstwa i ogranicza użycie komercyjne powyżej 100 000 aktywnych użytkowników rocznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O tokenizador de áudio incluído tem licença comunitária, não Apache: exige atribuição e limita o uso comercial acima de 100.000 usuários ativos anuais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Встроенный аудиотокенизатор распространяется по community-лицензии, а не по Apache: требуется указание авторства, а коммерческое использование ограничено после 100 000 активных пользователей в год."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den medföljande ljud-tokenizern licensieras som community, inte Apache: attribution krävs och kommersiell användning begränsas över 100 000 aktiva användare per år."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dahili ses tokenleştiricisi Apache lisansı değil topluluk lisansıyla sunulur: atıf gerekir ve yıllık 100.000 aktif kullanıcının üzerindeki ticari kullanım sınırlandırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вбудований аудіотокенізатор поширюється за community-ліцензією, а не за Apache: потрібне зазначення авторства, а комерційне використання обмежено після 100 000 активних користувачів на рік."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bộ token hóa âm thanh đi kèm dùng giấy phép cộng đồng, không phải Apache: yêu cầu ghi nhận tác giả và giới hạn sử dụng thương mại trên 100.000 người dùng hoạt động hằng năm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随附的音频分词器采用社区许可而非 Apache 许可：需要署名，且年活跃用户超过 100,000 时的商业使用会受到限制。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨附的音訊標記器採用社群授權而非 Apache 授權：需要署名，且年活躍使用者超過 100,000 時的商業使用會受到限制。"
          }
        }
      }
    },
    "The catalog no longer lists this install, so no mode can use it. Remove its folder in Finder if you no longer need it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد الكتالوج يدرج هذا التثبيت، لذا لا يمكن لأي وضع استخدامه. أزل مجلده في Finder إذا لم تعد بحاجة إليه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Katalog führt diese Installation nicht mehr, daher kann kein Modus sie nutzen. Entferne ihren Ordner im Finder, wenn du sie nicht mehr brauchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The catalog no longer lists this install, so no mode can use it. Remove its folder in Finder if you no longer need it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El catálogo ya no incluye esta instalación, así que ningún modo puede usarla. Elimina su carpeta en el Finder si ya no la necesitas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le catalogue ne répertorie plus cette installation, aucun mode ne peut donc l'utiliser. Supprimez son dossier dans le Finder si vous n'en avez plus besoin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקטלוג כבר לא כולל את ההתקנה הזו, ולכן אף מצב לא יכול להשתמש בה. הסר את התיקייה שלה ב-Finder אם אינך צריך אותה עוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैटलॉग में अब यह इंस्टॉल नहीं है, इसलिए कोई मोड इसका उपयोग नहीं कर सकता। अगर ज़रूरत न हो तो Finder में इसका फ़ोल्डर हटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog tidak lagi mencantumkan instalasi ini, jadi tidak ada mode yang dapat memakainya. Hapus foldernya di Finder jika tidak diperlukan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il catalogo non elenca più questa installazione, quindi nessuna modalità può usarla. Rimuovi la sua cartella nel Finder se non ti serve più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このインストールはカタログに掲載されなくなったため、どのモードでも使えません。不要な場合はFinderでフォルダを削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카탈로그에 더 이상 이 설치가 없으므로 어떤 모드도 사용할 수 없습니다. 더 이상 필요하지 않으면 Finder에서 폴더를 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De catalogus vermeldt deze installatie niet meer, dus geen enkele modus kan haar gebruiken. Verwijder de map in de Finder als je die niet meer nodig hebt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog nie zawiera już tej instalacji, więc żaden tryb nie może jej użyć. Usuń jej folder w Finderze, jeśli nie jest już potrzebny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O catálogo não lista mais esta instalação, então nenhum modo pode usá-la. Remova a pasta dela no Finder se não precisar mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог больше не содержит эту установку, поэтому её не может использовать ни один режим. Удалите её папку в Finder, если она больше не нужна."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalogen listar inte längre den här installationen, så inget läge kan använda den. Ta bort mappen i Finder om du inte behöver den längre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katalog artık bu kurulumu listelemiyor, bu yüzden hiçbir mod onu kullanamaz. Artık gerekmiyorsa klasörünü Finder'da kaldırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Каталог більше не містить цього встановлення, тож жоден режим не може його використати. Видаліть його папку у Finder, якщо вона більше не потрібна."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục không còn liệt kê bản cài đặt này nên không chế độ nào dùng được. Hãy xóa thư mục của nó trong Finder nếu bạn không cần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目录中已不再列出此安装，因此任何模式都无法使用它。如果不再需要，请在“访达”中移除其文件夹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目錄中已不再列出此安裝，因此任何模式都無法使用它。如果不再需要，請在 Finder 中移除其資料夾。"
          }
        }
      }
    },
    "The command '%@' was not found on PATH or in any standard tool directory. Install it first, then add this server.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُعثر على الأمر «%@» في PATH أو في أي مجلد أدوات قياسي. ثبّته أولًا، ثم أضف هذا الخادم."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl „%@“ wurde weder im PATH noch in einem Standardverzeichnis für Tools gefunden. Installieren Sie ihn zuerst und fügen Sie dann diesen Server hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command '%@' was not found on PATH or in any standard tool directory. Install it first, then add this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró el comando «%@» en PATH ni en ningún directorio estándar de herramientas. Instálalo primero y luego añade este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande « %@ » est introuvable dans le PATH et dans les dossiers d'outils standard. Installez-la d'abord, puis ajoutez ce serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפקודה \"%@\" לא נמצאה ב-PATH או בתיקיית כלים סטנדרטית כלשהי. התקן אותה תחילה ואז הוסף שרת זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमांड '%@' PATH या किसी भी मानक टूल निर्देशिका में नहीं मिली। पहले इसे इंस्टॉल करें, फिर यह सर्वर जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah '%@' tidak ditemukan di PATH atau di direktori alat standar mana pun. Pasang terlebih dahulu, lalu tambahkan server ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando '%@' non è stato trovato nel PATH né in alcuna directory standard degli strumenti. Installalo prima, poi aggiungi questo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンド「%@」が PATH にも標準のツールディレクトリにも見つかりません。先にインストールしてから、このサーバーを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' 명령을 PATH나 표준 도구 디렉터리에서 찾을 수 없습니다. 먼저 설치한 다음 이 서버를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opdracht '%@' is niet gevonden in PATH of in een standaardmap voor hulpmiddelen. Installeer deze eerst en voeg daarna deze server toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono polecenia „%@” w PATH ani w żadnym standardowym katalogu narzędzi. Najpierw je zainstaluj, a potem dodaj ten serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando '%@' não foi encontrado no PATH nem em nenhum diretório padrão de ferramentas. Instale-o primeiro e depois adicione este servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда «%@» не найдена ни в PATH, ни в стандартных каталогах инструментов. Сначала установите ее, затем добавьте этот сервер."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandot '%@' hittades inte i PATH eller i någon standardkatalog för verktyg. Installera det först och lägg sedan till den här servern."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' komutu PATH içinde veya herhangi bir standart araç dizininde bulunamadı. Önce yükleyin, ardından bu sunucuyu ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команду «%@» не знайдено ні в PATH, ні в стандартних каталогах інструментів. Спочатку встановіть її, а потім додайте цей сервер."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy lệnh '%@' trong PATH hoặc bất kỳ thư mục công cụ tiêu chuẩn nào. Hãy cài đặt lệnh này trước, rồi thêm máy chủ này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 PATH 或任何标准工具目录中都找不到命令“%@”。请先安装它，然后再添加此服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 PATH 或任何標準工具目錄中都找不到指令「%@」。請先安裝它，再新增此伺服器。"
          }
        }
      }
    },
    "The continuation prompt no longer fits in the model context window.": {
