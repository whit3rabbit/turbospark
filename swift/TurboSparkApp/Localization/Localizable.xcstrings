    "Scans project root for .mcp.json, opencode.json, .cursor, .vscode, and .agents configs.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0641\u062d\u0635 \u062c\u0630\u0631 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0628\u062d\u062b\u0627 \u0639\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u200e.mcp.json \u0648opencode.json \u0648\u200e.cursor \u0648\u200e.vscode \u0648\u200e.agents."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht den Projektstamm nach den Konfigurationen .mcp.json, opencode.json, .cursor, .vscode und .agents."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scans project root for .mcp.json, opencode.json, .cursor, .vscode, and .agents configs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Analiza la ra\u00edz del proyecto en busca de configuraciones .mcp.json, opencode.json, .cursor, .vscode y .agents."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse la racine du projet \u00e0 la recherche des configurations .mcp.json, opencode.json, .cursor, .vscode et .agents."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05d5\u05e8\u05e7 \u05d0\u05ea \u05e9\u05d5\u05e8\u05e9 \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05dc\u05d0\u05d9\u05ea\u05d5\u05e8 \u05ea\u05e6\u05d5\u05e8\u05d5\u05ea \u200e.mcp.json, \u200fopencode.json, \u200f.cursor, \u200f.vscode \u05d5-\u200e.agents."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0930\u0942\u091f \u092e\u0947\u0902 .mcp.json, opencode.json, .cursor, .vscode \u0914\u0930 .agents \u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindai root proyek untuk konfigurasi .mcp.json, opencode.json, .cursor, .vscode, dan .agents."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Analizza la radice del progetto alla ricerca delle configurazioni .mcp.json, opencode.json, .cursor, .vscode e .agents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30eb\u30fc\u30c8\u304b\u3089 .mcp.json\u3001opencode.json\u3001.cursor\u3001.vscode\u3001.agents \u306e\u69cb\u6210\u3092\u30b9\u30ad\u30e3\u30f3\u3057\u307e\u3059\u3002"
