        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u062f \u0644\u0627 \u062a\u062a\u0646\u0627\u0633\u0628 \u0628\u0639\u0636 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0631\u0641\u0642\u0629 \u0645\u0639 \u0627\u0644\u0645\u0633\u0627\u062d\u0629 \u0627\u0644\u062d\u0631\u0629 \u0644\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0633\u064a\u0627\u0642."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige angeh\u00e4ngte Dateien passen m\u00f6glicherweise nicht in den freien Platz des Kontextfensters."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some attached files may not fit the free context window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es posible que algunos archivos adjuntos no quepan en el espacio libre de la ventana de contexto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certains fichiers joints peuvent ne pas tenir dans l'espace libre de la fen\u00eatre de contexte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05d9\u05ea\u05db\u05df \u05e9\u05d7\u05dc\u05e7 \u05de\u05d4\u05e7\u05d1\u05e6\u05d9\u05dd \u05d4\u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd \u05dc\u05d0 \u05d9\u05d9\u05db\u05e0\u05e1\u05d5 \u05dc\u05de\u05e7\u05d5\u05dd \u05d4\u05e4\u05e0\u05d5\u05d9 \u05d1\u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0941\u091b \u0938\u0902\u0932\u0917\u094d\u0928 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u0915\u0947 \u0916\u093e\u0932\u0940 \u0938\u094d\u0925\u093e\u0928 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0906 \u0938\u0915\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beberapa file terlampir mungkin tidak muat di ruang kosong jendela konteks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni file allegati potrebbero non entrare nello spazio libero della finestra di contesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u90e8\u306e\u6dfb\u4ed8\u30d5\u30a1\u30a4\u30eb\u306f\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u306e\u7a7a\u304d\u5bb9\u91cf\u306b\u53ce\u307e\u3089\u306a\u3044\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc77c\ubd80 \ucca8\ubd80 \ud30c\uc77c\uc740 \ucee8\ud14d\uc2a4\ud2b8 \ucc3d\uc758 \uc5ec\uc720 \uacf5\uac04\uc5d0 \ub9de\uc9c0 \uc54a\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sommige bijgevoegde bestanden passen mogelijk niet in de vrije ruimte van het contextvenster."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niekt\u00f3re za\u0142\u0105czone pliki mog\u0105 nie zmie\u015bci\u0107 si\u0119 w wolnym miejscu okna kontekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alguns arquivos anexados podem n\u00e3o caber no espa\u00e7o livre da janela de contexto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u043b\u0451\u043d\u043d\u044b\u0435 \u0444\u0430\u0439\u043b\u044b \u043c\u043e\u0433\u0443\u0442 \u043d\u0435 \u043f\u043e\u043c\u0435\u0441\u0442\u0438\u0442\u044c\u0441\u044f \u0432 \u0441\u0432\u043e\u0431\u043e\u0434\u043d\u043e\u0435 \u043c\u0435\u0441\u0442\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u0433\u043e \u043e\u043a\u043d\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vissa bifogade filer kanske inte f\u00e5r plats i det lediga utrymmet i kontextf\u00f6nstret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekli dosyalardan baz\u0131lar\u0131 ba\u011flam penceresinin bo\u015f alan\u0131na s\u0131\u011fmayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0435\u044f\u043a\u0456 \u043f\u0440\u0438\u043a\u0440\u0456\u043f\u043b\u0435\u043d\u0456 \u0444\u0430\u0439\u043b\u0438 \u043c\u043e\u0436\u0443\u0442\u044c \u043d\u0435 \u043f\u043e\u043c\u0456\u0441\u0442\u0438\u0442\u0438\u0441\u044f \u0443 \u0432\u0456\u043b\u044c\u043d\u043e\u043c\u0443 \u043c\u0456\u0441\u0446\u0456 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u0433\u043e \u0432\u0456\u043a\u043d\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed9t s\u1ed1 t\u1ec7p \u0111\u00ednh k\u00e8m c\u00f3 th\u1ec3 kh\u00f4ng v\u1eeba v\u1edbi dung l\u01b0\u1ee3ng tr\u1ed1ng c\u1ee7a c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90e8\u5206\u9644\u52a0\u7684\u6587\u4ef6\u53ef\u80fd\u65e0\u6cd5\u653e\u5165\u4e0a\u4e0b\u6587\u7a97\u53e3\u7684\u5269\u4f59\u7a7a\u95f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u90e8\u5206\u9644\u52a0\u7684\u6a94\u6848\u53ef\u80fd\u7121\u6cd5\u653e\u5165\u4e0a\u4e0b\u6587\u8996\u7a97\u7684\u5269\u9918\u7a7a\u9593\u3002"
          }
        }
      }
    },
