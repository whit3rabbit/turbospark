          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "管理來自組態與已啟用外掛的生命週期掛鉤。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدر خطافات دورة الحياة القادمة من الإعدادات والملحقات المفعّلة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
