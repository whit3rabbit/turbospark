            "value": "B\u1eaft \u0111\u1ea7u tr\u00f2 chuy\u1ec7n \u0111\u1ec3 xem l\u1ecbch s\u1eed t\u1ea1i \u0111\u00e2y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f00\u59cb\u5bf9\u8bdd\u540e\uff0c\u5386\u53f2\u8bb0\u5f55\u5c06\u663e\u793a\u5728\u6b64\u5904"
          }
        },
        "zh-Hant": {
