    "Tokens per second ceiling. 0 leaves generation uncapped.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0631\u0645\u0648\u0632 \u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a\u0629. \u0627\u0644\u0642\u064a\u0645\u0629 0 \u062a\u062a\u0631\u0643 \u0627\u0644\u062a\u0648\u0644\u064a\u062f \u0628\u0644\u0627 \u062d\u062f."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obergrenze in Token pro Sekunde. 0 l\u00e4sst die Generierung unbegrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens per second ceiling. 0 leaves generation uncapped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00edmite de tokens por segundo. 0 deja la generaci\u00f3n sin l\u00edmite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plafond en jetons par seconde. 0 laisse la g\u00e9n\u00e9ration illimit\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05e7\u05e8\u05ea \u05d0\u05e1\u05d9\u05de\u05d5\u05e0\u05d9\u05dd \u05dc\u05e9\u05e0\u05d9\u05d9\u05d4. 0 \u05de\u05e9\u05d0\u05d9\u05e8 \u05d0\u05ea \u05d4\u05d9\u05e6\u05d9\u05e8\u05d4 \u05dc\u05dc\u05d0 \u05d4\u05d2\u05d1\u05dc\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u093f \u0938\u0947\u0915\u0902\u0921 \u091f\u094b\u0915\u0928 \u0915\u0940 \u090a\u092a\u0930\u0940 \u0938\u0940\u092e\u093e\u0964 0 \u0930\u0916\u0928\u0947 \u092a\u0930 \u091c\u0928\u0930\u0947\u0936\u0928 \u0905\u0938\u0940\u092e\u093f\u0924 \u0930\u0939\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas atas token per detik. 0 membuat pembuatan tanpa batas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite massimo di token al secondo. 0 lascia la generazione senza limiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1\u79d2\u3042\u305f\u308a\u306e\u30c8\u30fc\u30af\u30f3\u6570\u306e\u4e0a\u9650\u3067\u3059\u30020 \u306b\u3059\u308b\u3068\u4e0a\u9650\u306a\u3057\u3067\u751f\u6210\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucd08\ub2f9 \ud1a0\ud070 \uc0c1\ud55c\uc785\ub2c8\ub2e4. 0\uc774\uba74 \uc0dd\uc131 \uc18d\ub3c4\ub97c \uc81c\ud55c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bovengrens in tokens per seconde. 0 laat het genereren onbeperkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00f3rny limit token\u00f3w na sekund\u0119. 0 oznacza generowanie bez limitu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Teto de tokens por segundo. 0 deixa a gera\u00e7\u00e3o sem limite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0435\u0434\u0435\u043b \u0442\u043e\u043a\u0435\u043d\u043e\u0432 \u0432 \u0441\u0435\u043a\u0443\u043d\u0434\u0443. 0 \u0441\u043d\u0438\u043c\u0430\u0435\u0442 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u0438\u0435 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tak f\u00f6r token per sekund. 0 l\u00e4mnar genereringen obegr\u00e4nsad."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saniye ba\u015f\u0131na token \u00fcst s\u0131n\u0131r\u0131. 0, \u00fcretimi s\u0131n\u0131rs\u0131z b\u0131rak\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0440\u0445\u043d\u044f \u043c\u0435\u0436\u0430 \u0442\u043e\u043a\u0435\u043d\u0456\u0432 \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443. 0 \u0437\u043d\u0456\u043c\u0430\u0454 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi\u1edbi h\u1ea1n tr\u00ean s\u1ed1 token m\u1ed7i gi\u00e2y. 0 ngh\u0129a l\u00e0 kh\u00f4ng gi\u1edbi h\u1ea1n t\u1ed1c \u0111\u1ed9 t\u1ea1o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u79d2\u4ee4\u724c\u6570\u4e0a\u9650\u3002\u8bbe\u4e3a 0 \u8868\u793a\u4e0d\u9650\u5236\u751f\u6210\u901f\u5ea6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u79d2\u6b0a\u6756\u6578\u4e0a\u9650\u3002\u8a2d\u70ba 0 \u8868\u793a\u4e0d\u9650\u5236\u751f\u6210\u901f\u5ea6\u3002"
          }
        }
      }
    },
