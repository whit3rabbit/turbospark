        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo Humanizer n\u00e3o est\u00e1 instalado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c Humanizer \u043d\u0435 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0430."
          }
        },
        "sv": {
