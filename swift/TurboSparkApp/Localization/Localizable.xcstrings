          "stringUnit": {
            "state": "translated",
            "value": "Klonlanan sesin söyleyeceklerini yazın veya yapıştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть або вставте текст для клонованого голосу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv eller klistra in det som den klonade rösten ska säga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập hoặc dán nội dung mà giọng nhân bản sẽ nói."
          }
        },
        "id": {
          "stringUnit": {
