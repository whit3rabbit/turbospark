    "Vector downloaded and selected. Reload the model to apply steering.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u062a\u0646\u0632\u064a\u0644 \u0627\u0644\u0645\u062a\u062c\u0647 \u0648\u062a\u062d\u062f\u064a\u062f\u0647. \u0623\u0639\u062f \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u062a\u0648\u062c\u064a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektor heruntergeladen und ausgew\u00e4hlt. Lade das Modell neu, um das Steering anzuwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vector downloaded and selected. Reload the model to apply steering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vector descargado y seleccionado. Vuelve a cargar el modelo para aplicar la direcci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vecteur t\u00e9l\u00e9charg\u00e9 et s\u00e9lectionn\u00e9. Rechargez le mod\u00e8le pour appliquer le pilotage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05d5\u05e7\u05d8\u05d5\u05e8 \u05d4\u05d5\u05e8\u05d3 \u05d5\u05e0\u05d1\u05d7\u05e8. \u05d8\u05e2\u05e0\u05d5 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05d7\u05d3\u05e9 \u05db\u05d3\u05d9 \u05dc\u05d4\u05d7\u05d9\u05dc \u05d0\u05ea \u05d4\u05d4\u05db\u05d5\u05d5\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947\u0915\u094d\u091f\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0914\u0930 \u091a\u0941\u0928\u093e \u0917\u092f\u093e\u0964 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0932\u093e\u0917\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092e\u0949\u0921\u0932 \u092b\u093f\u0930 \u0938\u0947 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektor diunduh dan dipilih. Muat ulang model untuk menerapkan pengarahan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vettore scaricato e selezionato. Ricarica il modello per applicare lo steering."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d9\u30af\u30c8\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u3066\u9078\u629e\u3057\u307e\u3057\u305f\u3002\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u3092\u9069\u7528\u3059\u308b\u306b\u306f\u30e2\u30c7\u30eb\u3092\u518d\u8aad\u307f\u8fbc\u307f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubca1\ud130\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uc120\ud0dd\ud588\uc2b5\ub2c8\ub2e4. \uc2a4\ud2f0\uc5b4\ub9c1\uc744 \uc801\uc6a9\ud558\ub824\uba74 \ubaa8\ub378\uc744 \ub2e4\uc2dc \ubd88\ub7ec\uc624\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vector gedownload en geselecteerd. Laad het model opnieuw om de sturing toe te passen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrano i wybrano wektor. Wczytaj model ponownie, aby zastosowa\u0107 sterowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vetor baixado e selecionado. Recarregue o modelo para aplicar o direcionamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u043a\u0442\u043e\u0440 \u0441\u043a\u0430\u0447\u0430\u043d \u0438 \u0432\u044b\u0431\u0440\u0430\u043d. \u041f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u0438\u043c\u0435\u043d\u0438\u0442\u044c \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorn har laddats ned och valts. L\u00e4s in modellen igen f\u00f6r att till\u00e4mpa styrningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekt\u00f6r indirildi ve se\u00e7ildi. Y\u00f6nlendirmeyi uygulamak i\u00e7in modeli yeniden y\u00fckleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u043a\u0442\u043e\u0440 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e \u0439 \u0432\u0438\u0431\u0440\u0430\u043d\u043e. \u041f\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c, \u0449\u043e\u0431 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u0432\u0430\u0442\u0438 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 t\u1ea3i v\u00e0 ch\u1ecdn vect\u01a1. T\u1ea3i l\u1ea1i m\u00f4 h\u00ecnh \u0111\u1ec3 \u00e1p d\u1ee5ng \u0111i\u1ec1u h\u01b0\u1edbng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4e0b\u8f7d\u5e76\u9009\u62e9\u5411\u91cf\u3002\u8bf7\u91cd\u65b0\u52a0\u8f7d\u6a21\u578b\u4ee5\u5e94\u7528\u5f15\u5bfc\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4e0b\u8f09\u4e26\u9078\u64c7\u5411\u91cf\u3002\u8acb\u91cd\u65b0\u8f09\u5165\u6a21\u578b\u4ee5\u5957\u7528\u5f15\u5c0e\u3002"
          }
        }
      }
    },
    "No supported code, text, or document files found in %@.": {
