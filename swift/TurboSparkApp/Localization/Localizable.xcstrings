    "Uninstalls the plugin from user scope and removes its install cache. Hooks it contributed stop immediately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uninstalls the plugin from user scope and removes its install cache. Hooks it contributed stop immediately."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstala el plugin del ámbito de usuario y elimina su caché de instalación. Los hooks que aportaba dejan de funcionar de inmediato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désinstalle le plugin de la portée utilisateur et supprime son cache d'installation. Les hooks qu'il fournissait s'arrêtent immédiatement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deinstalliert das Plugin aus dem Benutzerbereich und entfernt seinen Installations-Cache. Von ihm beigesteuerte Hooks werden sofort beendet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disinstalla il plugin dall'ambito utente e rimuove la sua cache di installazione. Gli hook che forniva si fermano immediatamente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desinstala o plugin do escopo do usuário e remove o cache de instalação. Os hooks que ele fornecia param imediatamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет плагин из пользовательской области и очищает его кэш установки. Предоставленные им хуки сразу перестают работать."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ユーザースコープからプラグインをアンインストールし、インストールキャッシュを削除します。提供していたフックは直ちに停止します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 범위에서 플러그인을 제거하고 설치 캐시를 삭제합니다. 이 플러그인이 제공하던 훅은 즉시 중지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从用户范围卸载该插件并删除其安装缓存。它提供的钩子会立即停止。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從使用者範圍解除安裝該外掛並刪除其安裝快取。它提供的掛鉤會立即停止。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الملحق من نطاق المستخدم ويحذف ذاكرة التثبيت المؤقتة الخاصة به. وتتوقف الخطافات التي أسهم بها فورا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר את התוסף מהיקף המשתמש ומוחק את מטמון ההתקנה שלו. הוקים שהוא תרם נעצרים מיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्लगइन को उपयोगकर्ता स्कोप से अनइंस्टॉल करता है और उसका इंस्टॉल कैश हटाता है। इसके द्वारा दिए गए हुक तुरंत रुक जाते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert de plug-in uit het gebruikersbereik en wist de installatiecache. Hooks die de plug-in leverde, stoppen onmiddellijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odinstalowuje wtyczkę z zakresu użytkownika i usuwa jej pamięć podręczną instalacji. Dostarczone przez nią hooki natychmiast przestają działać."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklentiyi kullanıcı kapsamından kaldırır ve kurulum önbelleğini siler. Sağladığı kancalar hemen durur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видаляє плагін із користувацької області та очищає його кеш встановлення. Надані ним хуки одразу припиняють роботу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avinstallerar tillägget från användaromfånget och tar bort dess installationscache. Hookar som det bidrog med stoppas omedelbart."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gỡ plugin khỏi phạm vi người dùng và xóa bộ đệm cài đặt của nó. Các hook do plugin cung cấp dừng ngay lập tức."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus plugin dari cakupan pengguna dan menghapus cache pemasangannya. Hook yang disumbangkannya langsung berhenti."
          }
        }
      }
    },
