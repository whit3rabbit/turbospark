          "stringUnit": {
            "state": "translated",
            "value": "ad es. grafo della conoscenza e ricerca di simboli"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f8b: \u30ca\u30ec\u30c3\u30b8\u30b0\u30e9\u30d5\u3068\u30b7\u30f3\u30dc\u30eb\u691c\u7d22"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc608: \uc9c0\uc2dd \uadf8\ub798\ud504 \ubc0f \uae30\ud638 \uac80\uc0c9"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. kennisgraaf en symbolen zoeken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. graf wiedzy i wyszukiwanie symboli"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: grafo de conhecimento e busca de s\u00edmbolos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, \u0433\u0440\u0430\u0444 \u0437\u043d\u0430\u043d\u0438\u0439 \u0438 \u043f\u043e\u0438\u0441\u043a \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432"
