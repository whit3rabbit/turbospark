    "Audio samples or their format are invalid. Choose another audio file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio samples or their format are invalid. Choose another audio file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las muestras de audio o su formato no son válidos. Elige otro archivo de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les échantillons audio ou leur format sont invalides. Choisissez un autre fichier audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Audiosamples oder ihr Format sind ungültig. Wähle eine andere Audiodatei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I campioni audio o il loro formato non sono validi. Scegli un altro file audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As amostras de áudio ou seu formato são inválidos. Escolha outro arquivo de áudio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audiosamples of hun formaat zijn ongeldig. Kies een ander audiobestand."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudsamplen eller deras format är ogiltiga. Välj en annan ljudfil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Próbki audio lub ich format są nieprawidłowe. Wybierz inny plik audio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses örnekleri veya biçimleri geçersiz. Başka bir ses dosyası seçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampel audio atau formatnya tidak valid. Pilih berkas audio lain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудиосэмплы или их формат недопустимы. Выберите другой аудиофайл."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудіосемпли або їхній формат недопустимі. Виберіть інший аудіофайл."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các mẫu âm thanh hoặc định dạng không hợp lệ. Chọn tệp âm thanh khác."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声サンプルまたは形式が無効です。別の音声ファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오디오 샘플 또는 형식이 올바르지 않습니다. 다른 오디오 파일을 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频采样或格式无效。请选择其他音频文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "音訊取樣或格式無效。請選擇其他音訊檔案。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عينات الصوت أو تنسيقها غير صالح. اختر ملفاً صوتياً آخر."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דגימות השמע או הפורמט שלהן אינם תקינים. בחר קובץ שמע אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑडियो सैंपल या उनका फ़ॉर्मैट अमान्य है। दूसरी ऑडियो फ़ाइल चुनें।"
          }
        }
      }
    },
