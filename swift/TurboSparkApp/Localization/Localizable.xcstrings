        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0435 \u0447\u0430\u0442\u044b \u043d\u0435\u043b\u044c\u0437\u044f \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u0442\u044c."
