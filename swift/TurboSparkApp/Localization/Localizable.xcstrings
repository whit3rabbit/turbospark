          }
        }
      }
    },
    "This port has no kernels for the type this filename names. Probe it to see what the header actually contains.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تتوفر في هذا الإصدار نوى للنوع الذي يشير إليه اسم الملف. افحصه لمعرفة ما تحتويه الترويسة فعليا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Portierung hat keine Kernel für den Typ, den dieser Dateiname nennt. Prüfen Sie die Datei, um zu sehen, was der Header tatsächlich enthält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This port has no kernels for the type this filename names. Probe it to see what the header actually contains."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta versión no tiene kernels para el tipo que indica este nombre de archivo. Sondéalo para ver qué contiene realmente la cabecera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce portage n'a pas de noyaux pour le type indiqué par ce nom de fichier. Sondez-le pour voir ce que contient réellement l'en-tête."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בגרסת ההסבה הזו אין ליבות עבור הסוג ששם הקובץ מציין. בדוק אותו כדי לראות מה הכותרת מכילה בפועל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पोर्ट में उस प्रकार के लिए कर्नेल नहीं हैं जिसे यह फ़ाइल नाम बताता है। हेडर में वास्तव में क्या है, यह देखने के लिए इसे जांचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Port ini tidak memiliki kernel untuk tipe yang disebut nama berkas ini. Periksa untuk melihat isi header sebenarnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa versione non ha kernel per il tipo indicato da questo nome di file. Sondalo per vedere cosa contiene davvero l'intestazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この移植版には、このファイル名が示す型のカーネルがありません。ヘッダーの実際の内容を確認するには調査してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 포트에는 이 파일 이름이 가리키는 유형의 커널이 없습니다. 헤더에 실제로 무엇이 있는지 확인하려면 조사하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze port heeft geen kernels voor het type dat deze bestandsnaam aanduidt. Onderzoek het om te zien wat de header werkelijk bevat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten port nie ma jąder dla typu wskazywanego przez tę nazwę pliku. Zbadaj go, aby zobaczyć, co naprawdę zawiera nagłówek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta port não tem kernels para o tipo indicado por este nome de arquivo. Sonde-o para ver o que o cabeçalho realmente contém."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этом порте нет ядер для типа, указанного в имени файла. Проверьте его, чтобы увидеть, что на самом деле содержит заголовок."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här portningen har inga kärnor för typen som filnamnet anger. Undersök den för att se vad huvudet faktiskt innehåller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uyarlamada, bu dosya adının belirttiği tür için çekirdek yok. Başlığın gerçekte ne içerdiğini görmek için inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цьому порті немає ядер для типу, указаного в імені файлу. Дослідіть його, щоб побачити, що насправді містить заголовок."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chuyển này không có nhân cho kiểu mà tên tệp nêu ra. Hãy thăm dò để xem phần đầu thực sự chứa gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此移植版没有该文件名所指类型的内核。探测它以查看文件头的实际内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此移植版沒有該檔名所指類型的核心。探測它以查看檔頭的實際內容。"
          }
        }
      }
    },
    "This preset has no control vector file, so it would steer nothing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يحتوي هذا الإعداد المسبق على ملف متجه تحكم، لذا لن يوجّه أي شيء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorgabe hat keine Steuerungsvektordatei und würde daher nichts steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset has no control vector file, so it would steer nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este preajuste no tiene archivo de vector de control, así que no dirigiría nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce préréglage n'a pas de fichier de vecteur de contrôle : il n'orienterait donc rien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להגדרה זו אין קובץ וקטור בקרה, ולכן היא לא תכוון דבר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रीसेट में कोई नियंत्रण वेक्टर फ़ाइल नहीं है, इसलिए यह कुछ भी नियंत्रित नहीं करेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset ini tidak memiliki file vektor kontrol, jadi tidak akan mengarahkan apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo preset non ha un file di vettore di controllo, quindi non orienterebbe nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このプリセットには制御ベクトルファイルがないため、何も誘導しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프리셋에는 제어 벡터 파일이 없으므로 아무것도 조정하지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze preset heeft geen besturingsvectorbestand en zou dus niets sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ustawienie nie ma pliku wektora kontrolnego, więc niczego by nie sterowało."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta predefinição não tem arquivo de vetor de controle, então não direcionaria nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "У этого набора нет файла вектора управления, поэтому он ни на что не повлияет."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här förinställningen har ingen kontrollvektorfil och skulle därför inte styra något."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ön ayarın kontrol vektörü dosyası yok, bu yüzden hiçbir şeyi yönlendirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цього набору немає файлу вектора керування, тому він ні на що не вплине."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình sẵn này không có tệp vectơ điều khiển nên sẽ không điều hướng gì."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此预设没有控制向量文件，因此不会引导任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此預設沒有控制向量檔案，因此不會引導任何內容。"
          }
