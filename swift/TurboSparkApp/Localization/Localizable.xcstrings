        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de donn\u00e9es chiffr\u00e9e restaur\u00e9e n'a pas r\u00e9ussi son contr\u00f4le d'int\u00e9grit\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e1\u05d3 \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d4\u05de\u05d5\u05e6\u05e4\u05df \u05e9\u05e9\u05d5\u05d7\u05d6\u05e8 \u05e0\u05db\u05e9\u05dc \u05d1\u05d1\u05d3\u05d9\u05e7\u05ea \u05d4\u05e9\u05dc\u05de\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0905\u0916\u0902\u0921\u0924\u093e \u091c\u093e\u0901\u091a \u092e\u0947\u0902 \u0935\u093f\u092b\u0932 \u0930\u0939\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Basis data terenkripsi yang dipulihkan gagal dalam pemeriksaan integritas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database cifrato ripristinato non ha superato il controllo di integrit\u00e0."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fa9\u5143\u3055\u308c\u305f\u6697\u53f7\u5316\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u304c\u6574\u5408\u6027\u30c1\u30a7\u30c3\u30af\u306b\u5931\u6557\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcf5\uc6d0\ub41c \uc554\ud638\ud654 \ub370\uc774\ud130\ubca0\uc774\uc2a4\uac00 \ubb34\uacb0\uc131 \uac80\uc0ac\ub97c \ud1b5\uacfc\ud558\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herstelde versleutelde database heeft de integriteitscontrole niet doorstaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywr\u00f3cona zaszyfrowana baza danych nie przesz\u0142a kontroli integralno\u015bci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O banco de dados criptografado restaurado falhou na verifica\u00e7\u00e3o de integridade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u0430\u044f \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u0430\u044f \u0431\u0430\u0437\u0430 \u0434\u0430\u043d\u043d\u044b\u0445 \u043d\u0435 \u043f\u0440\u043e\u0448\u043b\u0430 \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u0446\u0435\u043b\u043e\u0441\u0442\u043d\u043e\u0441\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den \u00e5terst\u00e4llda krypterade databasen klarade inte integritetskontrollen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri y\u00fcklenen \u015fifreli veritaban\u0131 b\u00fct\u00fcnl\u00fck denetiminden ge\u00e7emedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u0430 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0430 \u0431\u0430\u0437\u0430 \u0434\u0430\u043d\u0438\u0445 \u043d\u0435 \u043f\u0440\u043e\u0439\u0448\u043b\u0430 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u043a\u0443 \u0446\u0456\u043b\u0456\u0441\u043d\u043e\u0441\u0442\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u01a1 s\u1edf d\u1eef li\u1ec7u \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a \u0111\u00e3 kh\u00f4i ph\u1ee5c kh\u00f4ng v\u01b0\u1ee3t qua ki\u1ec3m tra t\u00ednh to\u00e0n v\u1eb9n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6062\u590d\u7684\u52a0\u5bc6\u6570\u636e\u5e93\u672a\u901a\u8fc7\u5b8c\u6574\u6027\u68c0\u67e5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9084\u539f\u7684\u52a0\u5bc6\u8cc7\u6599\u5eab\u672a\u901a\u904e\u5b8c\u6574\u6027\u6aa2\u67e5\u3002"
          }
        }
      }
    },
    "A managed file failed authentication and cannot be backed up (%@).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u0634\u0644 \u0645\u0644\u0641 \u0645\u064f\u062f\u0627\u0631 \u0641\u064a \u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u0646\u0633\u062e\u0647 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u064b\u0627 (%@)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine verwaltete Datei hat die Authentifizierung nicht bestanden und kann nicht gesichert werden (%@)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A managed file failed authentication and cannot be backed up (%@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo gestionado no super\u00f3 la autenticaci\u00f3n y no se puede incluir en la copia de seguridad (%@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier g\u00e9r\u00e9 n'a pas pass\u00e9 l'authentification et ne peut pas \u00eatre sauvegard\u00e9 (%@)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d5\u05d1\u05e5 \u05de\u05e0\u05d5\u05d4\u05dc \u05e0\u05db\u05e9\u05dc \u05d1\u05d0\u05d9\u05de\u05d5\u05ea \u05d5\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d2\u05d1\u05d5\u05ea \u05d0\u05d5\u05ea\u05d5 (%@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u092b\u093c\u093e\u0907\u0932 \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932 \u0930\u0939\u0940 \u0914\u0930 \u0909\u0938\u0915\u093e \u092c\u0948\u0915\u0905\u092a \u0928\u0939\u0940\u0902 \u0932\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e (%@)\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File terkelola gagal diautentikasi dan tidak dapat dicadangkan (%@)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file gestito non ha superato l'autenticazione e non pu\u00f2 essere incluso nel backup (%@)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ba1\u7406\u5bfe\u8c61\u30d5\u30a1\u30a4\u30eb\u304c\u8a8d\u8a3c\u306b\u5931\u6557\u3057\u305f\u305f\u3081\u3001\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u3067\u304d\u307e\u305b\u3093 (%@)\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad00\ub9ac \ud30c\uc77c\uc774 \uc778\uc99d\uc5d0 \uc2e4\ud328\ud558\uc5ec \ubc31\uc5c5\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4(%@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een beheerd bestand is niet geverifieerd en kan niet worden geback-upt (%@)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik zarz\u0105dzany nie przeszed\u0142 uwierzytelniania i nie mo\u017cna go uwzgl\u0119dni\u0107 w kopii zapasowej (%@)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um arquivo gerenciado falhou na autentica\u00e7\u00e3o e n\u00e3o pode ser inclu\u00eddo no backup (%@)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0439 \u0444\u0430\u0439\u043b \u043d\u0435 \u043f\u0440\u043e\u0448\u0435\u043b \u043f\u0440\u043e\u0432\u0435\u0440\u043a\u0443 \u043f\u043e\u0434\u043b\u0438\u043d\u043d\u043e\u0441\u0442\u0438, \u0438 \u0435\u0433\u043e \u043d\u0435\u043b\u044c\u0437\u044f \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u044c \u0432 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0443\u044e \u043a\u043e\u043f\u0438\u044e (%@)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En hanterad fil klarade inte autentiseringen och kan inte s\u00e4kerhetskopieras (%@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00f6netilen bir dosya kimlik do\u011frulamas\u0131ndan ge\u00e7emedi ve yedeklenemiyor (%@)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0435\u0440\u043e\u0432\u0430\u043d\u0438\u0439 \u0444\u0430\u0439\u043b \u043d\u0435 \u043f\u0440\u043e\u0439\u0448\u043e\u0432 \u0430\u0432\u0442\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044e, \u0456 \u0439\u043e\u0433\u043e \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0438 \u0434\u043e \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0457 \u043a\u043e\u043f\u0456\u0457 (%@)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ed9t t\u1ec7p \u0111\u01b0\u1ee3c qu\u1ea3n l\u00fd kh\u00f4ng v\u01b0\u1ee3t qua x\u00e1c th\u1ef1c v\u00e0 kh\u00f4ng th\u1ec3 sao l\u01b0u (%@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6258\u7ba1\u6587\u4ef6\u672a\u901a\u8fc7\u8ba4\u8bc1\uff0c\u65e0\u6cd5\u5907\u4efd\uff08%@\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53d7\u7ba1\u7406\u6a94\u6848\u672a\u901a\u904e\u9a57\u8b49\uff0c\u7121\u6cd5\u5099\u4efd\uff08%@\uff09\u3002"
          }
        }
      }
    },
    "The profile must be unlocked to use managed files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062c\u0628 \u0625\u0644\u063a\u0627\u0621 \u0642\u0641\u0644 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u064f\u062f\u0627\u0631\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Profil muss entsperrt sein, um verwaltete Dateien zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The profile must be unlocked to use managed files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil debe estar desbloqueado para usar archivos gestionados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil doit \u00eatre d\u00e9verrouill\u00e9 pour utiliser les fichiers g\u00e9r\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05e9 \u05dc\u05d1\u05d8\u05dc \u05d0\u05ea \u05e0\u05e2\u05d9\u05dc\u05ea \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05e0\u05d5\u05d4\u05dc\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u092b\u093c\u093e\u0907\u0932\u094b\u0902 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u0928\u0932\u0949\u0915 \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil harus dibuka kuncinya untuk menggunakan file terkelola."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo deve essere sbloccato per usare i file gestiti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ba1\u7406\u5bfe\u8c61\u30d5\u30a1\u30a4\u30eb\u3092\u4f7f\u7528\u3059\u308b\u306b\u306f\u3001\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306e\u30ed\u30c3\u30af\u3092\u89e3\u9664\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad00\ub9ac \ud30c\uc77c\uc744 \uc0ac\uc6a9\ud558\ub824\uba74 \ud504\ub85c\ud544 \uc7a0\uae08\uc744 \ud574\uc81c\ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het profiel moet ontgrendeld zijn om beheerde bestanden te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby u\u017cywa\u0107 plik\u00f3w zarz\u0105dzanych, profil musi by\u0107 odblokowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil precisa estar desbloqueado para usar arquivos gerenciados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u0438\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u0435\u043c\u044b\u0445 \u0444\u0430\u0439\u043b\u043e\u0432 \u043f\u0440\u043e\u0444\u0438\u043b\u044c \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0440\u0430\u0437\u0431\u043b\u043e\u043a\u0438\u0440\u043e\u0432\u0430\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen m\u00e5ste vara uppl\u00e5st f\u00f6r att anv\u00e4nda hanterade filer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00f6netilen dosyalar\u0131 kullanmak i\u00e7in profilin kilidi a\u00e7\u0131k olmal\u0131d\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0429\u043e\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u043a\u0435\u0440\u043e\u0432\u0430\u043d\u0456 \u0444\u0430\u0439\u043b\u0438, \u043f\u0440\u043e\u0444\u0456\u043b\u044c \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u0440\u043e\u0437\u0431\u043b\u043e\u043a\u043e\u0432\u0430\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ed3 s\u01a1 ph\u1ea3i \u0111\u01b0\u1ee3c m\u1edf kh\u00f3a \u0111\u1ec3 s\u1eed d\u1ee5ng t\u1ec7p \u0111\u01b0\u1ee3c qu\u1ea3n l\u00fd."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fc5\u987b\u89e3\u9501\u914d\u7f6e\u6863\u6848\u624d\u80fd\u4f7f\u7528\u6258\u7ba1\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fc5\u9808\u89e3\u9396\u8a2d\u5b9a\u6a94\u624d\u80fd\u4f7f\u7528\u53d7\u7ba1\u7406\u6a94\u6848\u3002"
          }
        }
      }
    },
    "The encrypted asset is malformed or was modified.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0623\u0635\u0644 \u0627\u0644\u0645\u0634\u0641\u0631 \u062a\u0627\u0644\u0641 \u0623\u0648 \u062a\u0645 \u062a\u0639\u062f\u064a\u0644\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das verschl\u00fcsselte Asset ist fehlerhaft oder wurde ver\u00e4ndert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted asset is malformed or was modified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El recurso cifrado tiene un formato incorrecto o se modific\u00f3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La ressource chiffr\u00e9e est mal form\u00e9e ou a \u00e9t\u00e9 modifi\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e0\u05db\u05e1 \u05d4\u05de\u05d5\u05e6\u05e4\u05df \u05e4\u05d2\u05d5\u05dd \u05d0\u05d5 \u05e9\u05e9\u05d5\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u090f\u0938\u0947\u091f \u0935\u093f\u0915\u0943\u0924 \u0939\u0948 \u092f\u093e \u0909\u0938\u0947 \u092c\u0926\u0932\u093e \u0917\u092f\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aset terenkripsi tidak valid atau telah diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La risorsa cifrata non \u00e8 valida o \u00e8 stata modificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6697\u53f7\u5316\u3055\u308c\u305f\u30a2\u30bb\u30c3\u30c8\u306e\u5f62\u5f0f\u304c\u6b63\u3057\u304f\u306a\u3044\u304b\u3001\u5909\u66f4\u3055\u308c\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc554\ud638\ud654\ub41c \uc790\uc0b0\uc758 \ud615\uc2dd\uc774 \uc798\ubabb\ub418\uc5c8\uac70\ub098 \uc218\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelde asset is ongeldig of is gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaszyfrowany zas\u00f3b jest uszkodzony lub zosta\u0142 zmodyfikowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O recurso criptografado est\u00e1 malformado ou foi modificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0440\u0435\u0441\u0443\u0440\u0441 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d \u0438\u043b\u0438 \u0431\u044b\u043b \u0438\u0437\u043c\u0435\u043d\u0435\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den krypterade tillg\u00e5ngen \u00e4r felaktig eller har \u00e4ndrats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eifreli varl\u0131k hatal\u0131 bi\u00e7imlendirilmi\u015f veya de\u011fi\u015ftirilmi\u015f."
