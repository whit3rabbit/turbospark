          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gesprek '%@' wordt verwijderd. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konwersacja „%@” zostanie usunięta. Tej operacji nie można cofnąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A conversa '%@' será removida. Esta ação não pode ser desfeita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Диалог «%@» будет удален. Это действие нельзя отменить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Konversationen '%@' tas bort. Detta kan inte ångras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' konuşması kaldırılacak. Bu işlem geri alınamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розмову «%@» буде видалено. Цю дію не можна скасувати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuộc trò chuyện '%@' sẽ bị xóa. Hành động này không thể hoàn tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对话“%@”将被删除。此操作无法撤销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對話「%@」將被刪除。此操作無法復原。"
