          }
        }
      }
    },
    "History is saved across launches. Retry starts interrupted downloads from the beginning.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u062d\u0641\u0638 \u0627\u0644\u0633\u062c\u0644 \u0628\u064a\u0646 \u0645\u0631\u0627\u062a \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u062a\u0628\u062f\u0623 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u062a\u0646\u0632\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0648\u0642\u0641\u0629 \u0645\u0646 \u0627\u0644\u0628\u062f\u0627\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Verlauf bleibt nach dem Neustart erhalten. Erneutes Versuchen startet unterbrochene Downloads von vorn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is saved across launches. Retry starts interrupted downloads from the beginning."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El historial se conserva al volver a abrir la aplicaci\u00f3n. Reintentar inicia las descargas interrumpidas desde el principio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u2019historique est conserv\u00e9 entre les lancements. R\u00e9essayer recommence les t\u00e9l\u00e9chargements interrompus depuis le d\u00e9but."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d4\u05d9\u05e1\u05d8\u05d5\u05e8\u05d9\u05d4 \u05e0\u05e9\u05de\u05e8\u05ea \u05d1\u05d9\u05df \u05d4\u05e4\u05e2\u05dc\u05d5\u05ea. \u05e0\u05d9\u05e1\u05d9\u05d5\u05df \u05d7\u05d5\u05d6\u05e8 \u05de\u05ea\u05d7\u05d9\u05dc \u05d4\u05d5\u05e8\u05d3\u05d5\u05ea \u05e9\u05e0\u05e7\u05d8\u05e2\u05d5 \u05de\u05d4\u05d4\u05ea\u05d7\u05dc\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0924\u093f\u0939\u093e\u0938 \u0910\u092a \u0926\u094b\u092c\u093e\u0930\u093e \u0916\u094b\u0932\u0928\u0947 \u092a\u0930 \u092d\u0940 \u0930\u0939\u0924\u093e \u0939\u0948\u0964 \u092b\u093f\u0930 \u0915\u094b\u0936\u093f\u0936 \u0915\u0930\u0928\u0947 \u092a\u0930 \u092c\u093e\u0927\u093f\u0924 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0936\u0941\u0930\u0941\u0906\u0924 \u0938\u0947 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Riwayat tetap tersimpan saat aplikasi dibuka kembali. Coba lagi memulai unduhan yang terputus dari awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cronologia viene conservata tra gli avvii. Riprova riavvia dall\u2019inizio i download interrotti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c65\u6b74\u306f\u30a2\u30d7\u30ea\u3092\u518d\u8d77\u52d5\u3057\u3066\u3082\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u518d\u8a66\u884c\u3059\u308b\u3068\u3001\u4e2d\u65ad\u3057\u305f\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3092\u6700\u521d\u304b\u3089\u958b\u59cb\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc571\uc744 \ub2e4\uc2dc \uc5f4\uc5b4\ub3c4 \uae30\ub85d\uc774 \uc720\uc9c0\ub429\ub2c8\ub2e4. \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uba74 \uc911\ub2e8\ub41c \ub2e4\uc6b4\ub85c\ub4dc\uac00 \ucc98\uc74c\ubd80\ud130 \uc2dc\uc791\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geschiedenis blijft bewaard na opnieuw openen. Opnieuw proberen start onderbroken downloads vanaf het begin."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia jest zachowywana mi\u0119dzy uruchomieniami. Ponowienie rozpoczyna przerwane pobieranie od pocz\u0105tku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O hist\u00f3rico \u00e9 mantido ao reabrir o aplicativo. Tentar novamente reinicia os downloads interrompidos do in\u00edcio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u0442\u043e\u0440\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442\u0441\u044f \u043c\u0435\u0436\u0434\u0443 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u043c\u0438. \u041f\u043e\u0432\u0442\u043e\u0440 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442 \u043f\u0440\u0435\u0440\u0432\u0430\u043d\u043d\u044b\u0435 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u0441 \u043d\u0430\u0447\u0430\u043b\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Historiken sparas mellan starter. F\u00f6rs\u00f6k igen startar avbrutna h\u00e4mtningar fr\u00e5n b\u00f6rjan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7mi\u015f, uygulama yeniden a\u00e7\u0131ld\u0131\u011f\u0131nda korunur. Yeniden dene, kesilen indirmeleri ba\u015ftan ba\u015flat\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0406\u0441\u0442\u043e\u0440\u0456\u044f \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u043c\u0456\u0436 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u043c\u0438. \u041f\u043e\u0432\u0442\u043e\u0440 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454 \u043f\u0435\u0440\u0435\u0440\u0432\u0430\u043d\u0456 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1ecbch s\u1eed \u0111\u01b0\u1ee3c gi\u1eef l\u1ea1i khi m\u1edf l\u1ea1i \u1ee9ng d\u1ee5ng. Th\u1eed l\u1ea1i b\u1eaft \u0111\u1ea7u c\u00e1c l\u01b0\u1ee3t t\u1ea3i b\u1ecb gi\u00e1n \u0111o\u1ea1n t\u1eeb \u0111\u1ea7u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u65b0\u6253\u5f00\u5e94\u7528\u540e\u4f1a\u4fdd\u7559\u5386\u53f2\u8bb0\u5f55\u3002\u91cd\u8bd5\u4f1a\u4ece\u5934\u5f00\u59cb\u5df2\u4e2d\u65ad\u7684\u4e0b\u8f7d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u65b0\u958b\u555f\u61c9\u7528\u7a0b\u5f0f\u5f8c\u6703\u4fdd\u7559\u8a18\u9304\u3002\u91cd\u8a66\u6703\u5f9e\u982d\u958b\u59cb\u5df2\u4e2d\u65b7\u7684\u4e0b\u8f09\u3002"
          }
        }
      }
    },
