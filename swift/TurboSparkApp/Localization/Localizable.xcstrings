    "Liveness, the attached model ids, and the engine version.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u062d\u0635 \u0627\u0644\u062d\u064a\u0627\u0629 \u0648\u0645\u0639\u0631\u0651\u0641\u0627\u062a \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0645\u064f\u0631\u0641\u0642\u0629 \u0648\u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0645\u062d\u0631\u0643."
