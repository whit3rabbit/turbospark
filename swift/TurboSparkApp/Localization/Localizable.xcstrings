    "Context usage: %@ of the model's context window": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0633\u064a\u0627\u0642: %@ \u0645\u0646 \u0646\u0627\u0641\u0630\u0629 \u0633\u064a\u0627\u0642 \u0627\u0644\u0646\u0645\u0648\u0630\u062c"
          }
