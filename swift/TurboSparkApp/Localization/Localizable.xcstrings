    "This model's family does not dispatch the steering edit, so a control vector here would be refused at load.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عائلة هذا النموذج لا تنفّذ تعديل التوجيه، لذا سيُرفض متجه التحكم هنا عند التحميل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Familie dieses Modells führt die Steuerungsänderung nicht aus, daher würde ein Steuerungsvektor hier beim Laden abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model's family does not dispatch the steering edit, so a control vector here would be refused at load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La familia de este modelo no aplica la edición de direccionamiento, así que un vector de control se rechazaría al cargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La famille de ce modèle n'applique pas la modification de guidage : un vecteur de contrôle serait donc refusé au chargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משפחת המודל הזה אינה מפעילה את עריכת ההיגוי, ולכן וקטור בקרה כאן יידחה בטעינה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मॉडल का परिवार स्टीयरिंग बदलाव लागू नहीं करता, इसलिए यहाँ नियंत्रण वेक्टर लोड के समय अस्वीकार हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarga model ini tidak menjalankan edit pengarah, jadi vektor kontrol di sini akan ditolak saat dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La famiglia di questo modello non applica la modifica di guida, quindi un vettore di controllo verrebbe rifiutato al caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルのファミリーはステアリングの編集を実行しないため、ここでの制御ベクトルは読み込み時に拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델의 계열은 스티어링 편집을 실행하지 않으므로 여기서 제어 벡터는 로드 시 거부됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De familie van dit model voert de besturingsaanpassing niet uit, dus een besturingsvector zou hier bij het laden worden geweigerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodzina tego modelu nie wykonuje edycji sterowania, więc wektor kontrolny zostałby tu odrzucony podczas ładowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A família deste modelo não aplica a edição de direcionamento, então um vetor de controle seria recusado no carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Семейство этой модели не применяет правку управления, поэтому вектор управления будет отклонён при загрузке."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här modellens familj utför inte styrningsändringen, så en kontrollvektor skulle avvisas vid inläsning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modelin ailesi yönlendirme düzenlemesini uygulamaz, bu nedenle buradaki bir kontrol vektörü yüklemede reddedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сімейство цієї моделі не застосовує правку керування, тому вектор керування буде відхилено під час завантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Họ của mô hình này không thực hiện chỉnh sửa điều hướng, nên vectơ điều khiển ở đây sẽ bị từ chối khi tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型系列不执行转向编辑，因此这里的控制向量会在加载时被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型系列不執行導向編輯，因此這裡的控制向量會在載入時被拒絕。"
          }
        }
      }
    },
