        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ yan g\u00f6revi arka planda ba\u015flat\u0131ld\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0431\u0456\u0447\u043d\u0435 \u0437\u0430\u0432\u0434\u0430\u043d\u043d\u044f %@ \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043e \u0443 \u0444\u043e\u043d\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 b\u1eaft \u0111\u1ea7u t\u00e1c v\u1ee5 ph\u1ee5 %@ \u1edf ch\u1ebf \u0111\u1ed9 n\u1ec1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u652f\u7ebf\u4efb\u52a1 %@ \u5df2\u5728\u540e\u53f0\u542f\u52a8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u652f\u7dda\u4efb\u52d9 %@ \u5df2\u5728\u80cc\u666f\u555f\u52d5\u3002"
