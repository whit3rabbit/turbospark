    "Ask a question, write code, analyze data, or explore new ideas.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0637\u0631\u062d \u0633\u0624\u0627\u0644\u0627\u064b\u060c \u0627\u0643\u062a\u0628 \u0643\u0648\u062f\u064b\u0627\u060c \u062d\u0644\u0644 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\u060c \u0623\u0648 \u0627\u0633\u062a\u0643\u0634\u0641 \u0623\u0641\u0643\u0627\u0631\u064b\u0627 \u062c\u062f\u064a\u062f\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie eine Frage, schreiben Sie Code, analysieren Sie Daten oder erkunden Sie neue Ideen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question, write code, analyze data, or explore new ideas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta, escribe c\u00f3digo, analiza datos o explora nuevas ideas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question, \u00e9crivez du code, analysez des donn\u00e9es ou explorez de nouvelles id\u00e9es."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d0\u05dc \u05e9\u05d0\u05dc\u05d4, \u05db\u05ea\u05d5\u05d1 \u05e7\u05d5\u05d3, \u05e0\u05ea\u05d7 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d0\u05d5 \u05d7\u05e7\u05d5\u05e8 \u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea \u05d7\u05d3\u05e9\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u092a\u094d\u0930\u0936\u094d\u0928 \u092a\u0942\u091b\u0947\u0902, \u0915\u094b\u0921 \u0932\u093f\u0916\u0947\u0902, \u0921\u0947\u091f\u093e \u0915\u093e \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 \u0915\u0930\u0947\u0902, \u092f\u093e \u0928\u090f \u0935\u093f\u091a\u093e\u0930 \u0916\u094b\u091c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajukan pertanyaan, tulis kode, analisis data, atau jelajahi ide-ide baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda, scrivi codice, analizza dati o esplora nuove idee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cea\u554f\u3059\u308b\u3001\u30b3\u30fc\u30c9\u3092\u66f8\u304f\u3001\u30c7\u30fc\u30bf\u3092\u5206\u6790\u3059\u308b\u3001\u307e\u305f\u306f\u65b0\u3057\u3044\u30a2\u30a4\u30c7\u30a2\u3092\u63a2\u7d22\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c8\ubb38\ud558\uae30, \ucf54\ub4dc \uc791\uc131, \ub370\uc774\ud130 \ubd84\uc11d \ub610\ub294 \uc0c8\ub85c\uc6b4 \uc544\uc774\ub514\uc5b4 \ud0d0\uc0c9\uc744 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een vraag, schrijf code, analyseer gegevens of verken nieuwe idee\u00ebn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj pytanie, napisz kod, przeanalizuj dane lub odkrywaj nowe pomys\u0142y."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fa\u00e7a uma pergunta, escreva c\u00f3digo, analise dados ou explore novas ideias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u0432\u043e\u043f\u0440\u043e\u0441, \u043d\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u043a\u043e\u0434, \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0438\u0437\u0438\u0440\u0443\u0439\u0442\u0435 \u0434\u0430\u043d\u043d\u044b\u0435 \u0438\u043b\u0438 \u0438\u0441\u0441\u043b\u0435\u0434\u0443\u0439\u0442\u0435 \u043d\u043e\u0432\u044b\u0435 \u0438\u0434\u0435\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "St\u00e4ll en fr\u00e5ga, skriv kod, analysera data eller utforska nya id\u00e9er."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir soru sorun, kod yaz\u0131n, verileri analiz edin veya yeni fikirler ke\u015ffedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0441\u0442\u0430\u0432\u0442\u0435 \u0437\u0430\u043f\u0438\u0442\u0430\u043d\u043d\u044f, \u043d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u043a\u043e\u0434, \u043f\u0440\u043e\u0430\u043d\u0430\u043b\u0456\u0437\u0443\u0439\u0442\u0435 \u0434\u0430\u043d\u0456 \u0430\u0431\u043e \u0434\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u0439\u0442\u0435 \u043d\u043e\u0432\u0456 \u0456\u0434\u0435\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t c\u00e2u h\u1ecfi, vi\u1ebft m\u00e3, ph\u00e2n t\u00edch d\u1eef li\u1ec7u ho\u1eb7c kh\u00e1m ph\u00e1 \u00fd t\u01b0\u1edfng m\u1edbi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u51fa\u95ee\u9898\u3001\u7f16\u5199\u4ee3\u7801\u3001\u5206\u6790\u6570\u636e\u6216\u63a2\u7d22\u65b0\u60f3\u6cd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63d0\u51fa\u554f\u984c\u3001\u7de8\u5beb\u7a0b\u5f0f\u78bc\u3001\u5206\u6790\u8cc7\u6599\u6216\u63a2\u7d22\u65b0\u60f3\u6cd5\u3002"
          }
        }
      }
    },
    "Ask anything": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u0623\u0644 \u0623\u064a \u0634\u064a\u0621"
