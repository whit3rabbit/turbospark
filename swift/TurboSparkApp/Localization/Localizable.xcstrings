          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0915\u094d\u0930\u093f\u092f\u093e \u0915\u094b \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tindakan ini memerlukan konfirmasi Anda untuk dijalankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa azione richiede la tua conferma per essere eseguita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u64cd\u4f5c\u3092\u5b9f\u884c\u3059\u308b\u306b\u306f\u78ba\u8a8d\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc791\uc5c5\uc744 \uc2e4\ud589\ud558\ub824\uba74 \ud655\uc778\uc774 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze actie vereist je bevestiging om te worden uitgevoerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta akcja wymaga Twojego potwierdzenia, aby zosta\u0142a wykonana."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta a\u00e7\u00e3o exige sua confirma\u00e7\u00e3o para ser executada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f \u044d\u0442\u043e\u0433\u043e \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u044f \u0442\u0440\u0435\u0431\u0443\u0435\u0442\u0441\u044f \u0432\u0430\u0448\u0435 \u043f\u043e\u0434\u0442\u0432\u0435\u0440\u0436\u0434\u0435\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r \u00e5tg\u00e4rden kr\u00e4ver din bekr\u00e4ftelse f\u00f6r att k\u00f6ras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu eylemin y\u00fcr\u00fct\u00fclmesi i\u00e7in onay\u0131n\u0131z gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u044f \u0434\u0456\u044f \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454 \u0432\u0430\u0448\u043e\u0433\u043e \u043f\u0456\u0434\u0442\u0432\u0435\u0440\u0434\u0436\u0435\u043d\u043d\u044f \u0434\u043b\u044f \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e0nh \u0111\u1ed9ng n\u00e0y c\u1ea7n b\u1ea1n x\u00e1c nh\u1eadn \u0111\u1ec3 th\u1ef1c thi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u64cd\u4f5c\u9700\u8981\u4f60\u786e\u8ba4\u540e\u624d\u80fd\u6267\u884c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u64cd\u4f5c\u9700\u8981\u4f60\u78ba\u8a8d\u5f8c\u624d\u80fd\u57f7\u884c\u3002"
          }
        }
      }
    },
