    "The Humanizer model is not installed.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0645\u0648\u0630\u062c Humanizer \u063a\u064a\u0631 \u0645\u062b\u0628\u0651\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Humanizer-Modell ist nicht installiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Humanizer model is not installed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo Humanizer no est\u00e1 instalado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mod\u00e8le Humanizer n'est pas install\u00e9."
