            "value": "'%@' artık model listesinde değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' більше немає в списку моделей."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' không còn trong danh sách mô hình."
