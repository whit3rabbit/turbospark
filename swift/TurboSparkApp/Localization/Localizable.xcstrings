    "Ask for approval: ask before tools edit files or use the internet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0637\u0644\u0628 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629: \u0627\u0633\u0623\u0644 \u0642\u0628\u0644 \u0623\u0646 \u062a\u0639\u062f\u0651\u0644 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0623\u0648 \u062a\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u0625\u0646\u062a\u0631\u0646\u062a"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um Genehmigung bitten: fragen, bevor Tools Dateien bearbeiten oder das Internet nutzen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask for approval: ask before tools edit files or use the internet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir aprobaci\u00f3n: preguntar antes de que las herramientas editen archivos o usen internet"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Demander l'approbation : demander avant qu'un outil modifie des fichiers ou utilise Internet"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05e7\u05e9 \u05d0\u05d9\u05e9\u05d5\u05e8: \u05e9\u05d0\u05dc \u05dc\u05e4\u05e0\u05d9 \u05e9\u05db\u05dc\u05d9\u05dd \u05e2\u05d5\u05e8\u05db\u05d9\u05dd \u05e7\u05d1\u05e6\u05d9\u05dd \u05d0\u05d5 \u05de\u05e9\u05ea\u05de\u05e9\u05d9\u05dd \u05d1\u05d0\u05d9\u05e0\u05d8\u05e8\u05e0\u05d8"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0928\u0941\u092e\u094b\u0926\u0928 \u092e\u093e\u0901\u0917\u0947\u0902: \u091f\u0942\u0932 \u0926\u094d\u0935\u093e\u0930\u093e \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0928\u0947 \u092f\u093e \u0907\u0902\u091f\u0930\u0928\u0947\u091f \u0909\u092a\u092f\u094b\u0917 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092a\u0942\u091b\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Minta persetujuan: tanya sebelum alat mengedit file atau memakai internet"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiedi approvazione: chiedi prima che gli strumenti modifichino file o usino Internet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627f\u8a8d\u3092\u6c42\u3081\u308b\uff1a\u30c4\u30fc\u30eb\u304c\u30d5\u30a1\u30a4\u30eb\u3092\u7de8\u96c6\u3057\u305f\u308a\u30a4\u30f3\u30bf\u30fc\u30cd\u30c3\u30c8\u3092\u4f7f\u3046\u524d\u306b\u78ba\u8a8d"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2b9\uc778 \uc694\uccad: \ub3c4\uad6c\uac00 \ud30c\uc77c\uc744 \ud3b8\uc9d1\ud558\uac70\ub098 \uc778\ud130\ub137\uc744 \uc4f0\uae30 \uc804\uc5d0 \ubb3b\uae30"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Om goedkeuring vragen: vragen voordat tools bestanden bewerken of internet gebruiken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pytaj o zgod\u0119: pytaj, zanim narz\u0119dzia zmieni\u0105 pliki lub u\u017cyj\u0105 internetu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pedir aprova\u00e7\u00e3o: perguntar antes que ferramentas editem arquivos ou usem a internet"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044c \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u0435: \u0441\u043f\u0440\u0430\u0448\u0438\u0432\u0430\u0442\u044c, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u044b \u0438\u0437\u043c\u0435\u043d\u044f\u0442 \u0444\u0430\u0439\u043b\u044b \u0438\u043b\u0438 \u0432\u044b\u0439\u0434\u0443\u0442 \u0432 \u0438\u043d\u0442\u0435\u0440\u043d\u0435\u0442"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Be om godk\u00e4nnande: fr\u00e5ga innan verktyg redigerar filer eller anv\u00e4nder internet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onay iste: ara\u00e7lar dosya d\u00fczenlemeden veya internete eri\u015fmeden \u00f6nce sor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0442\u0443\u0432\u0430\u0442\u0438 \u0441\u0445\u0432\u0430\u043b\u0435\u043d\u043d\u044f: \u043f\u0438\u0442\u0430\u0442\u0438, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 \u0437\u043c\u0456\u043d\u044f\u0442\u044c \u0444\u0430\u0439\u043b\u0438 \u0447\u0438 \u0432\u0438\u0439\u0434\u0443\u0442\u044c \u0432 \u0456\u043d\u0442\u0435\u0440\u043d\u0435\u0442"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ecfi ph\u00ea duy\u1ec7t: h\u1ecfi tr\u01b0\u1edbc khi c\u00f4ng c\u1ee5 s\u1eeda t\u1ec7p ho\u1eb7c d\u00f9ng internet"
          }
        },
        "zh-Hans": {
