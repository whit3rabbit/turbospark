        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba\u011flam kullan\u0131m\u0131: modelin ba\u011flam penceresinin %@ kadar\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443: %@ \u0432\u0456\u043a\u043d\u0430 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443 \u043c\u043e\u0434\u0435\u043b\u0456"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ee9c d\u00f9ng ng\u1eef c\u1ea3nh: %@ c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh c\u1ee7a m\u00f4 h\u00ecnh"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0a\u4e0b\u6587\u7528\u91cf\uff1a\u6a21\u578b\u4e0a\u4e0b\u6587\u7a97\u53e3\u7684 %@"
