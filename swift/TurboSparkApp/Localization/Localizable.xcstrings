        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0915\u0947 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u0941\u090f\u0964 \u0938\u0940\u092e\u093e: %lld \u092a\u094d\u0930\u092f\u093e\u0938\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelpogingen opgebruikt. Limiet: %lld pogingen."
          }
        },
        "pl": {
