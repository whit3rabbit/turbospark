    "Download an image model, or choose one in Image settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0632\u0651\u0644 \u0646\u0645\u0648\u0630\u062c \u0635\u0648\u0631\u060c \u0623\u0648 \u0627\u062e\u062a\u0631 \u0648\u0627\u062d\u062f\u064b\u0627 \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0635\u0648\u0631\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade ein Bildmodell herunter oder w\u00e4hle eines in den Bildeinstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download an image model, or choose one in Image settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga un modelo de imagen o elige uno en Ajustes de imagen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e9l\u00e9chargez un mod\u00e8le d\u2019image ou choisissez-en un dans les r\u00e9glages d\u2019image."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e8\u05d9\u05d3\u05d5 \u05de\u05d5\u05d3\u05dc \u05ea\u05de\u05d5\u05e0\u05d5\u05ea, \u05d0\u05d5 \u05d1\u05d7\u05e8\u05d5 \u05d0\u05d7\u05d3 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05ea\u05de\u05d5\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0907\u092e\u0947\u091c \u092e\u0949\u0921\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902, \u092f\u093e \u0907\u092e\u0947\u091c \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0902 \u0938\u0947 \u090f\u0915 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh model gambar, atau pilih salah satu di Pengaturan gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica un modello di immagini o scegline uno in Impostazioni immagine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u753b\u50cf\u30e2\u30c7\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3059\u308b\u304b\u3001\u753b\u50cf\u8a2d\u5b9a\u3067\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774\ubbf8\uc9c0 \ubaa8\ub378\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uac70\ub098 \uc774\ubbf8\uc9c0 \uc124\uc815\uc5d0\uc11c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download een beeldmodel of kies er een in Beeldinstellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz model obraz\u00f3w lub wybierz go w Ustawieniach obrazu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe um modelo de imagem ou escolha um nos Ajustes de imagem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043a\u0430\u0447\u0430\u0439\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0451 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445 \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ned en bildmodell eller v\u00e4lj en i Bildinst\u00e4llningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir g\u00f6r\u00fcnt\u00fc modeli indirin veya G\u00f6r\u00fcnt\u00fc ayarlar\u0131\u2019ndan birini se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c \u0430\u0431\u043e \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0457\u0457 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i xu\u1ed1ng m\u1ed9t m\u00f4 h\u00ecnh \u1ea3nh ho\u1eb7c ch\u1ecdn m\u1ed9t m\u00f4 h\u00ecnh trong C\u00e0i \u0111\u1eb7t \u1ea3nh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f7d\u56fe\u50cf\u6a21\u578b\uff0c\u6216\u5728\u56fe\u50cf\u8bbe\u7f6e\u4e2d\u9009\u62e9\u4e00\u4e2a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f09\u5f71\u50cf\u6a21\u578b\uff0c\u6216\u5728\u5f71\u50cf\u8a2d\u5b9a\u4e2d\u9078\u64c7\u4e00\u500b\u3002"
          }
        }
      }
    },
