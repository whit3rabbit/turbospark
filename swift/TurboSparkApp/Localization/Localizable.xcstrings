            "value": "%@\uc5d0 \ub4f1\ub85d\ub41c \ud6c5\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen hooks geregistreerd in %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zarejestrowanych hook\u00f3w w %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum hook registrado em %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 %@ \u043d\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043e \u0445\u0443\u043a\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga krokar registrerade i %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ i\u00e7inde kay\u0131tl\u0131 kanca yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 %@ \u043d\u0435 \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u043e \u0436\u043e\u0434\u043d\u0438\u0445 \u0445\u0443\u043a\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 hook n\u00e0o \u0111\u01b0\u1ee3c \u0111\u0103ng k\u00fd trong %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u4e2d\u672a\u6ce8\u518c\u4efb\u4f55\u94a9\u5b50\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u4e2d\u672a\u8a3b\u518a\u4efb\u4f55\u52fe\u9ede\u3002"
          }
        }
      }
    },
    "No in-app preview for this format.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u062a\u0648\u0641\u0631 \u0645\u0639\u0627\u064a\u0646\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0644\u0647\u0630\u0627 \u0627\u0644\u062a\u0646\u0633\u064a\u0642."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcr dieses Format ist keine In-App-Vorschau verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No in-app preview for this format."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay vista previa en la app para este formato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun aper\u00e7u int\u00e9gr\u00e9 pour ce format."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05ea\u05e6\u05d5\u05d2\u05d4 \u05de\u05e7\u05d3\u05d9\u05de\u05d4 \u05d1\u05ea\u05d5\u05da \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e2\u05d1\u05d5\u05e8 \u05d4\u05e4\u05d5\u05e8\u05de\u05d8 \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092a\u094d\u0930\u093e\u0930\u0942\u092a \u0915\u0947 \u0932\u093f\u090f \u0910\u092a \u092e\u0947\u0902 \u092a\u094d\u0930\u0940\u0935\u094d\u092f\u0942 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pratinjau dalam aplikasi untuk format ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna anteprima nell'app per questo formato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u5f62\u5f0f\u306e\u30a2\u30d7\u30ea\u5185\u30d7\u30ec\u30d3\u30e5\u30fc\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud615\uc2dd\uc740 \uc571 \ub0b4 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc9c0\uc6d0\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen voorbeeld in de app voor dit formaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak podgl\u0105du w aplikacji dla tego formatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma pr\u00e9-visualiza\u00e7\u00e3o no app para este formato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u0444\u043e\u0440\u043c\u0430\u0442\u0430 \u043f\u0440\u0435\u0434\u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440 \u0432 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen f\u00f6rhandsvisning i appen f\u00f6r det h\u00e4r formatet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bi\u00e7im i\u00e7in uygulama i\u00e7i \u00f6nizleme yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0444\u043e\u0440\u043c\u0430\u0442\u0443 \u043d\u0435\u043c\u0430\u0454 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0443 \u0432 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 b\u1ea3n xem tr\u01b0\u1edbc trong \u1ee9ng d\u1ee5ng cho \u0111\u1ecbnh d\u1ea1ng n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u683c\u5f0f\u6ca1\u6709\u5e94\u7528\u5185\u9884\u89c8\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u683c\u5f0f\u6c92\u6709 App \u5167\u9810\u89bd\u3002"
          }
        }
      }
    },
    "No key is set, so the snippets send a placeholder that is never checked.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u0636\u0628\u0637 \u0623\u064a \u0645\u0641\u062a\u0627\u062d\u060c \u0644\u0630\u0627 \u062a\u0631\u0633\u0644 \u0627\u0644\u0645\u0642\u062a\u0637\u0641\u0627\u062a \u0646\u0627\u0626\u0628\u0627 \u0644\u0627 \u064a\u064f\u062a\u062d\u0642\u0642 \u0645\u0646\u0647 \u0623\u0628\u062f\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist kein Schl\u00fcssel festgelegt, daher senden die Snippets einen Platzhalter, der nie gepr\u00fcft wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key is set, so the snippets send a placeholder that is never checked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna clave configurada, as\u00ed que los fragmentos env\u00edan un marcador de posici\u00f3n que nunca se comprueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune cl\u00e9 n'est d\u00e9finie ; les extraits envoient donc un espace r\u00e9serv\u00e9 qui n'est jamais v\u00e9rifi\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05d4\u05d5\u05d2\u05d3\u05e8 \u05de\u05e4\u05ea\u05d7, \u05d5\u05dc\u05db\u05df \u05e7\u05d8\u05e2\u05d9 \u05d4\u05e7\u05d5\u05d3 \u05e9\u05d5\u05dc\u05d7\u05d9\u05dd \u05de\u05de\u05dc\u05d0 \u05de\u05e7\u05d5\u05dd \u05e9\u05d0\u05d9\u05e0\u05d5 \u05e0\u05d1\u05d3\u05e7 \u05dc\u05e2\u05d5\u05dc\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0915\u0941\u0902\u091c\u0940 \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u0938\u094d\u0928\u093f\u092a\u0947\u091f \u0910\u0938\u093e \u092a\u094d\u0932\u0947\u0938\u0939\u094b\u0932\u094d\u0921\u0930 \u092d\u0947\u091c\u0924\u0947 \u0939\u0948\u0902 \u091c\u093f\u0938\u0915\u0940 \u0915\u092d\u0940 \u091c\u093e\u0902\u091a \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada kunci yang diatur, jadi cuplikan mengirim placeholder yang tidak pernah diperiksa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non \u00e8 impostata alcuna chiave, quindi gli snippet inviano un segnaposto che non viene mai verificato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ad\u30fc\u304c\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u306a\u3044\u305f\u3081\u3001\u30b9\u30cb\u30da\u30c3\u30c8\u306f\u691c\u8a3c\u3055\u308c\u306a\u3044\u30d7\u30ec\u30fc\u30b9\u30db\u30eb\u30c0\u30fc\u3092\u9001\u4fe1\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud0a4\uac00 \uc124\uc815\ub418\uc5b4 \uc788\uc9c0 \uc54a\uc544 \uc2a4\ub2c8\ud3ab\uc740 \uac80\uc0ac\ub418\uc9c0 \uc54a\ub294 \uc790\ub9ac\ud45c\uc2dc\uc790\ub97c \ubcf4\ub0c5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen sleutel ingesteld, dus de snippets sturen een tijdelijke aanduiding die nooit wordt gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono klucza, wi\u0119c fragmenty wysy\u0142aj\u0105 symbol zast\u0119pczy, kt\u00f3ry nigdy nie jest sprawdzany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma chave est\u00e1 definida, ent\u00e3o os trechos enviam um espa\u00e7o reservado que nunca \u00e9 verificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043b\u044e\u0447 \u043d\u0435 \u0437\u0430\u0434\u0430\u043d, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u044b \u043e\u0442\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0442 \u0437\u0430\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0435\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen nyckel \u00e4r angiven, s\u00e5 kodavsnitten skickar en platsh\u00e5llare som aldrig kontrolleras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtar ayarlanmad\u0131\u011f\u0131 i\u00e7in par\u00e7ac\u0131klar hi\u00e7 denetlenmeyen bir yer tutucu g\u00f6nderir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043b\u044e\u0447 \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u043e, \u0442\u043e\u043c\u0443 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438 \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u044e\u0442\u044c \u0437\u0430\u043f\u043e\u0432\u043d\u044e\u0432\u0430\u0447, \u044f\u043a\u0438\u0439 \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u044f\u0454\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a \u0111\u1eb7t kh\u00f3a, n\u00ean c\u00e1c \u0111o\u1ea1n m\u00e3 g\u1eedi m\u1ed9t ch\u1ed7 gi\u1eef ch\u1ed7 kh\u00f4ng bao gi\u1edd \u0111\u01b0\u1ee3c ki\u1ec3m tra."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u8bbe\u7f6e\u5bc6\u94a5\uff0c\u56e0\u6b64\u4ee3\u7801\u7247\u6bb5\u53d1\u9001\u7684\u662f\u4ece\u4e0d\u6821\u9a8c\u7684\u5360\u4f4d\u7b26\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u8a2d\u5b9a\u91d1\u9470\uff0c\u56e0\u6b64\u7a0b\u5f0f\u78bc\u7247\u6bb5\u9001\u51fa\u7684\u662f\u5f9e\u4e0d\u9a57\u8b49\u7684\u9810\u7559\u4f4d\u7f6e\u3002"
          }
        }
      }
    },
    "No known provider folders were found.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0623\u064a \u0645\u062c\u0644\u062f\u0627\u062a \u0645\u0648\u0641\u0631 \u0645\u0639\u0631\u0648\u0641\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine bekannten Anbieterordner gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No known provider folders were found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron carpetas de proveedores conocidas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun dossier de fournisseur connu n'a \u00e9t\u00e9 trouv\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d5 \u05ea\u05d9\u05e7\u05d9\u05d5\u05ea \u05e1\u05e4\u05e7\u05d9\u05dd \u05d9\u05d3\u05d5\u05e2\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u091c\u094d\u091e\u093e\u0924 \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0947\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder penyedia yang dikenal tidak ditemukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna cartella di provider nota trovata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e2\u77e5\u306e\u30d7\u30ed\u30d0\u30a4\u30c0\u30fc\u30d5\u30a9\u30eb\u30c0\u30fc\u306f\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc54c\ub824\uc9c4 \uc81c\uacf5\uc790 \ud3f4\ub354\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen bekende providermappen gevonden."
          }
        },
        "pl": {
