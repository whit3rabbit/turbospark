        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tokens per second ceiling. 0 leaves generation uncapped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de tokens por segundo. 0 deja la generación sin límite."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plafond en jetons par seconde. 0 laisse la génération illimitée."
