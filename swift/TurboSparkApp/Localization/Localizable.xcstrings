    "A temporary chat cannot be archived; end Ghost Mode instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أرشفة المحادثة المؤقتة؛ أنهِ وضع الشبح بدلاً من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein temporärer Chat kann nicht archiviert werden. Beenden Sie stattdessen den Ghost-Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary chat cannot be archived; end Ghost Mode instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat temporal no se puede archivar; sal del modo fantasma en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion temporaire ne peut pas être archivée ; quittez plutôt le mode fantôme."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן להעביר צ'אט זמני לארכיון; במקום זאת, צא ממצב רפאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अस्थायी चैट संग्रहीत नहीं की जा सकती; इसके बजाय घोस्ट मोड समाप्त करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan sementara tidak dapat diarsipkan; akhiri Mode Hantu sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chat temporanea non può essere archiviata; esci invece dalla modalità fantasma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なチャットはアーカイブできません。代わりにゴーストモードを終了してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 채팅은 보관할 수 없습니다. 대신 고스트 모드를 종료하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tijdelijke chat kan niet worden gearchiveerd; beëindig in plaats daarvan de Ghost-modus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czatu tymczasowego nie można zarchiwizować; zamiast tego wyłącz tryb widmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um chat temporário não pode ser arquivado; encerre o Modo Fantasma em vez disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временный чат нельзя архивировать; вместо этого выйдите из режима призрака."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tillfällig chatt kan inte arkiveras; avsluta spökläget i stället."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçici sohbet arşivlenemez; bunun yerine Hayalet Modunu sonlandırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тимчасовий чат не можна архівувати; натомість вийдіть із режиму привида."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu trữ cuộc trò chuyện tạm thời; thay vào đó, hãy thoát Chế độ ma."
          }
        },
        "zh-Hans": {
