        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5148\u306b\u30e2\u30c7\u30eb\u3092\u8aad\u307f\u8fbc\u3093\u3067\u304f\u3060\u3055\u3044\u3002\u307e\u3068\u3081\u306e\u4f5c\u6210\u306b\u306f\u30e2\u30c7\u30eb\u304c\u5fc5\u8981\u3067\u3059\u3002"
