    "No models are installed. Open the Model Hub to download one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0646\u0645\u0627\u0630\u062c \u0645\u062b\u0628\u062a\u0629. \u0627\u0641\u062a\u062d \u0645\u0631\u0643\u0632 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0644\u062a\u0646\u0632\u064a\u0644 \u0646\u0645\u0648\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
