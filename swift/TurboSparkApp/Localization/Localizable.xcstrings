    "Needs more memory than this Mac has, with this model loaded.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج إلى ذاكرة أكثر مما يتوفر في هذا الـ Mac مع تحميل هذا النموذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benötigt mit diesem geladenen Modell mehr Arbeitsspeicher, als dieser Mac hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs more memory than this Mac has, with this model loaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Necesita más memoria de la que tiene este Mac con este modelo cargado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nécessite plus de mémoire que ce Mac n'en dispose avec ce modèle chargé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דורש יותר זיכרון ממה שיש ב-Mac הזה כשהמודל הזה טעון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मॉडल के लोड होने पर इस Mac में उपलब्ध मेमोरी से अधिक की आवश्यकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membutuhkan lebih banyak memori daripada yang dimiliki Mac ini saat model ini dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiede più memoria di quella disponibile su questo Mac con questo modello caricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルを読み込んだ状態では、このMacのメモリが不足します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델을 로드한 상태에서는 이 Mac의 메모리보다 더 많은 메모리가 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heeft met dit model geladen meer geheugen nodig dan deze Mac heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wymaga więcej pamięci, niż ma ten Mac przy załadowanym modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Precisa de mais memória do que este Mac tem com este modelo carregado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Требуется больше памяти, чем есть на этом Mac при загруженной модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kräver mer minne än den här Mac-datorn har med den här modellen inläst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model yüklüyken bu Mac'te bulunandan daha fazla bellek gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потрібно більше пам’яті, ніж є на цьому Mac із завантаженою моделлю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần nhiều bộ nhớ hơn máy Mac này có khi đã tải mô hình này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载此模型后所需内存超出这台 Mac 的容量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入此模型後所需記憶體超出這台 Mac 的容量。"
          }
        }
      }
    },
