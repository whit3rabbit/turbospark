    "Adopting checks every file against the pinned revision before any mode can use it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحقق التبنّي من كل ملف مقابل المراجعة المثبتة قبل أن يتمكن أي وضع من استخدامه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Übernehmen wird jede Datei mit der festgelegten Revision abgeglichen, bevor ein Modus sie nutzen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adopting checks every file against the pinned revision before any mode can use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al adoptarla, cada archivo se comprueba con la revisión fijada antes de que un modo pueda usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adoption vérifie chaque fichier par rapport à la révision épinglée avant qu'un mode puisse l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימוץ בודק כל קובץ מול הגרסה המקובעת לפני שמצב כלשהו יוכל להשתמש בה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनाने पर, किसी मोड के इसे इस्तेमाल करने से पहले हर फ़ाइल को पिन किए गए संशोधन से जाँचा जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengambilalihan memeriksa setiap file terhadap revisi yang disematkan sebelum mode apa pun dapat memakainya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'adozione verifica ogni file rispetto alla revisione fissata prima che una modalità possa usarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "引き継ぐと、モードで使えるようになる前に、すべてのファイルが固定リビジョンと照合されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오면 모드에서 사용하기 전에 모든 파일을 고정된 리비전과 대조합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij overnemen wordt elk bestand gecontroleerd tegen de vastgezette revisie voordat een modus het kan gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przejęcie sprawdza każdy plik względem przypiętej rewizji, zanim dowolny tryb będzie mógł go użyć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao adotar, cada arquivo é verificado em relação à revisão fixada antes que um modo possa usá-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При принятии каждый файл сверяется с закреплённой ревизией, прежде чем режим сможет её использовать."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du tar över kontrolleras varje fil mot den fastställda revisionen innan något läge kan använda den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devralma, herhangi bir mod kullanmadan önce her dosyayı sabitlenmiş revizyona göre denetler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час прийняття кожен файл звіряється із закріпленою ревізією, перш ніж режим зможе його використати."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khi tiếp nhận, mọi tệp được đối chiếu với bản sửa đổi đã ghim trước khi chế độ nào dùng được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接管时会先将每个文件与固定修订版本核对，之后模式才能使用它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接管時會先將每個檔案與固定修訂版本核對，之後模式才能使用它。"
          }
        }
      }
    },
