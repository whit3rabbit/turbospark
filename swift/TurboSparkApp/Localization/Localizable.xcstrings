    },
    "Choose a reference voice, review its transcript, and generate new speech.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0635\u0648\u062a\u064b\u0627 \u0645\u0631\u062c\u0639\u064a\u064b\u0627\u060c \u0648\u0631\u0627\u062c\u0639 \u0646\u0635\u0647\u060c \u0648\u0623\u0646\u0634\u0626 \u062e\u0637\u0627\u0628\u064b\u0627 \u062c\u062f\u064a\u062f\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie eine Referenzstimme, \u00fcberpr\u00fcfen Sie deren Transkript und erstellen Sie eine neue Rede."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a reference voice, review its transcript, and generate new speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elija una voz de referencia, revise su transcripci\u00f3n y genere un nuevo discurso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une voix de r\u00e9f\u00e9rence, examinez sa transcription et g\u00e9n\u00e9rez un nouveau discours."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05e7\u05d5\u05dc \u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea, \u05e1\u05e7\u05d5\u05e8 \u05d0\u05ea \u05d4\u05ea\u05de\u05dc\u05d9\u05dc \u05e9\u05dc\u05d5 \u05d5\u05d4\u05e4\u05e7 \u05d3\u05d9\u05d1\u05d5\u05e8 \u05d7\u05d3\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0938\u0902\u0926\u0930\u094d\u092d \u0906\u0935\u093e\u091c\u093c \u091a\u0941\u0928\u0947\u0902, \u0909\u0938\u0915\u0940 \u092a\u094d\u0930\u0924\u093f\u0932\u0947\u0916 \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0947\u0902, \u0914\u0930 \u0928\u092f\u093e \u092d\u093e\u0937\u0923 \u0924\u0948\u092f\u093e\u0930 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih suara referensi, tinjau transkripnya, dan buat pidato baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una voce di riferimento, rivedi la sua trascrizione e genera un nuovo discorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53c2\u7167\u97f3\u58f0\u3092\u9078\u629e\u3057\u3001\u305d\u306e\u30c8\u30e9\u30f3\u30b9\u30af\u30ea\u30d7\u30c8\u3092\u78ba\u8a8d\u3057\u3066\u3001\u65b0\u3057\u3044\u97f3\u58f0\u3092\u751f\u6210\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucc38\uc870 \uc74c\uc131\uc744 \uc120\ud0dd\ud558\uace0, \ud574\ub2f9 \ub0b4\uc6a9\uc744 \uac80\ud1a0\ud558\uace0, \uc0c8 \uc74c\uc131\uc744 \uc0dd\uc131\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een referentiestem, bekijk het transcript ervan en genereer nieuwe spraak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz g\u0142os referencyjny, przejrzyj jego transkrypcj\u0119 i wygeneruj now\u0105 mow\u0119."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma voz de refer\u00eancia, revise sua transcri\u00e7\u00e3o e gere um novo discurso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u044d\u0442\u0430\u043b\u043e\u043d\u043d\u044b\u0439 \u0433\u043e\u043b\u043e\u0441, \u043f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u0435\u0433\u043e \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443 \u0438 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u043d\u043e\u0432\u0443\u044e \u0440\u0435\u0447\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en referensr\u00f6st, granska dess transkription och generera nytt tal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir referans sesi se\u00e7in, metnini inceleyin ve yeni konu\u015fma olu\u015fturun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0435\u0442\u0430\u043b\u043e\u043d\u043d\u0438\u0439 \u0433\u043e\u043b\u043e\u0441, \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u0439\u043e\u0433\u043e \u0440\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443 \u0442\u0430 \u0441\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u043d\u043e\u0432\u0443 \u043c\u043e\u0432\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn gi\u1ecdng n\u00f3i tham chi\u1ebfu, xem l\u1ea1i b\u1ea3n ghi c\u1ee7a n\u00f3 v\u00e0 t\u1ea1o gi\u1ecdng n\u00f3i m\u1edbi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u53c2\u8003\u8bed\u97f3\uff0c\u67e5\u770b\u5176\u6587\u5b57\u8bb0\u5f55\u5e76\u751f\u6210\u65b0\u7684\u8bed\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u53c3\u8003\u8a9e\u97f3\uff0c\u67e5\u770b\u5176\u6587\u5b57\u8a18\u9304\u4e26\u7522\u751f\u65b0\u7684\u8a9e\u97f3\u3002"
          }
        }
      }
    },
    "Describe age, accent, pitch, pace, and emotion.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0648\u0635\u0641 \u0627\u0644\u0639\u0645\u0631 \u0648\u0627\u0644\u0644\u0647\u062c\u0629 \u0648\u062f\u0631\u062c\u0629 \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0633\u0631\u0639\u0629 \u0648\u0627\u0644\u0639\u0627\u0637\u0641\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie Alter, Akzent, Tonh\u00f6he, Tempo und Emotionen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe age, accent, pitch, pace, and emotion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe la edad, el acento, el tono, el ritmo y las emociones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9crivez l'\u00e2ge, l'accent, la hauteur, le rythme et l'\u00e9motion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d0\u05e8 \u05d2\u05d9\u05dc, \u05de\u05d1\u05d8\u05d0, \u05d2\u05d5\u05d1\u05d4 \u05e8\u05d5\u05d7, \u05e7\u05e6\u05d1 \u05d5\u05e8\u05d2\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u092e\u094d\u0930, \u0909\u091a\u094d\u091a\u093e\u0930\u0923, \u092a\u093f\u091a, \u0917\u0924\u093f \u0914\u0930 \u092d\u093e\u0935\u0928\u093e \u0915\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan usia, aksen, nada, kecepatan, dan emosi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi et\u00e0, accento, tono, ritmo ed emozione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e74\u9f62\u3001\u30a2\u30af\u30bb\u30f3\u30c8\u3001\u30d4\u30c3\u30c1\u3001\u30da\u30fc\u30b9\u3001\u611f\u60c5\u306b\u3064\u3044\u3066\u8aac\u660e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub098\uc774, \uc5b5\uc591, \uc74c\uc870, \uc18d\ub3c4, \uac10\uc815\uc744 \uc124\uba85\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf leeftijd, accent, toonhoogte, tempo en emotie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz wiek, akcent, tonacj\u0119, tempo i emocje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva idade, sotaque, tom, ritmo e emo\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0432\u043e\u0437\u0440\u0430\u0441\u0442, \u0430\u043a\u0446\u0435\u043d\u0442, \u0432\u044b\u0441\u043e\u0442\u0443 \u0442\u043e\u043d\u0430, \u0442\u0435\u043c\u043f \u0438 \u044d\u043c\u043e\u0446\u0438\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv \u00e5lder, accent, tonh\u00f6jd, takt och k\u00e4nslor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya\u015f\u0131, aksan\u0131, perdeyi, tempoyu ve duyguyu a\u00e7\u0131klay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0456\u0442\u044c \u0432\u0456\u043a, \u0430\u043a\u0446\u0435\u043d\u0442, \u0432\u0438\u0441\u043e\u0442\u0443, \u0442\u0435\u043c\u043f \u0456 \u0435\u043c\u043e\u0446\u0456\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 t\u1ea3 tu\u1ed5i t\u00e1c, gi\u1ecdng n\u00f3i, cao \u0111\u1ed9, nh\u1ecbp \u0111\u1ed9 v\u00e0 c\u1ea3m x\u00fac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63cf\u8ff0\u5e74\u9f84\u3001\u53e3\u97f3\u3001\u97f3\u8c03\u3001\u8282\u594f\u548c\u60c5\u611f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63cf\u8ff0\u5e74\u9f61\u3001\u53e3\u97f3\u3001\u97f3\u8abf\u3001\u7bc0\u594f\u548c\u60c5\u611f\u3002"
          }
        }
      }
    },
    "Describe the voice before generating speech.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0648\u0635\u0641 \u0627\u0644\u0635\u0648\u062a \u0642\u0628\u0644 \u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0643\u0644\u0627\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie die Stimme, bevor Sie Sprache erzeugen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe the voice before generating speech."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe la voz antes de generar el habla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9crivez la voix avant de g\u00e9n\u00e9rer la parole."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d0\u05e8 \u05d0\u05ea \u05d4\u05e7\u05d5\u05dc \u05dc\u05e4\u05e0\u05d9 \u05d9\u05e6\u05d9\u05e8\u05ea \u05d3\u05d9\u05d1\u05d5\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092d\u093e\u0937\u0923 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0906\u0935\u093e\u091c \u0915\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelaskan suara sebelum menghasilkan ucapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi la voce prima di generare il discorso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u58f0\u3092\u751f\u6210\u3059\u308b\u524d\u306b\u97f3\u58f0\u3092\u8aac\u660e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc74c\uc131\uc744 \uc0dd\uc131\ud558\uae30 \uc804\uc5d0 \uc74c\uc131\uc744 \uc124\uba85\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf de stem voordat u spraak genereert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz g\u0142os przed wygenerowaniem mowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva a voz antes de gerar a fala."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0433\u043e\u043b\u043e\u0441 \u043f\u0435\u0440\u0435\u0434 \u043f\u0440\u043e\u0438\u0437\u043d\u0435\u0441\u0435\u043d\u0438\u0435\u043c \u0440\u0435\u0447\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv r\u00f6sten innan du genererar tal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konu\u015fmay\u0131 olu\u015fturmadan \u00f6nce sesi tan\u0131mlay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0456\u0442\u044c \u0433\u043e\u043b\u043e\u0441 \u043f\u0435\u0440\u0435\u0434 \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u043c \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 t\u1ea3 gi\u1ecdng n\u00f3i tr\u01b0\u1edbc khi t\u1ea1o ra l\u1eddi n\u00f3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u751f\u6210\u8bed\u97f3\u4e4b\u524d\u63cf\u8ff0\u58f0\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u751f\u6210\u8a9e\u97f3\u4e4b\u524d\u63cf\u8ff0\u8072\u97f3\u3002"
          }
        }
      }
    },
    "Enter the exact transcript of the selected reference region.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u062f\u062e\u0644 \u0627\u0644\u0646\u0635 \u0627\u0644\u062f\u0642\u064a\u0642 \u0644\u0644\u0645\u0646\u0637\u0642\u0629 \u0627\u0644\u0645\u0631\u062c\u0639\u064a\u0629 \u0627\u0644\u0645\u062d\u062f\u062f\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie das genaue Transkript der ausgew\u00e4hlten Referenzregion ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter the exact transcript of the selected reference region."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingrese la transcripci\u00f3n exacta de la regi\u00f3n de referencia seleccionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrez la transcription exacte de la r\u00e9gion de r\u00e9f\u00e9rence s\u00e9lectionn\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d6\u05df \u05d0\u05ea \u05d4\u05ea\u05de\u05dc\u05d9\u05dc \u05d4\u05de\u05d3\u05d5\u05d9\u05e7 \u05e9\u05dc \u05d0\u05d6\u05d5\u05e8 \u05d4\u05d4\u05ea\u05d9\u05d9\u05d7\u05e1\u05d5\u05ea \u05e9\u05e0\u05d1\u05d7\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u092f\u0928\u093f\u0924 \u0938\u0902\u0926\u0930\u094d\u092d \u0915\u094d\u0937\u0947\u0924\u094d\u0930 \u0915\u0940 \u0938\u091f\u0940\u0915 \u092a\u094d\u0930\u0924\u093f\u0932\u093f\u092a\u093f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan transkrip persis dari wilayah referensi yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la trascrizione esatta della regione di riferimento selezionata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u3057\u305f\u53c2\u7167\u9818\u57df\u306e\u6b63\u78ba\u306a\u8ee2\u5199\u7269\u3092\u5165\u529b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\ud55c \ucc38\uc870 \uc9c0\uc5ed\uc758 \uc815\ud655\ud55c \uc131\uc801\ud45c\ub97c \uc785\ub825\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer het exacte transcript van het geselecteerde referentiegebied in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wprowad\u017a dok\u0142adny zapis wybranego regionu referencyjnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Insira a transcri\u00e7\u00e3o exata da regi\u00e3o de refer\u00eancia selecionada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0432\u0435\u0434\u0438\u0442\u0435 \u0442\u043e\u0447\u043d\u0443\u044e \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u0439 \u044d\u0442\u0430\u043b\u043e\u043d\u043d\u043e\u0439 \u043e\u0431\u043b\u0430\u0441\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange den exakta utskriften av den valda referensregionen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00e7ilen referans b\u00f6lgesinin tam metnini girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0432\u0435\u0434\u0456\u0442\u044c \u0442\u043e\u0447\u043d\u0443 \u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0456\u044e \u0432\u0438\u0431\u0440\u0430\u043d\u043e\u0433\u043e \u0435\u0442\u0430\u043b\u043e\u043d\u043d\u043e\u0433\u043e \u0440\u0435\u0433\u0456\u043e\u043d\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nh\u1eadp b\u1ea3n ghi ch\u00ednh x\u00e1c c\u1ee7a v\u00f9ng tham chi\u1ebfu \u0111\u00e3 ch\u1ecdn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f93\u5165\u6240\u9009\u53c2\u8003\u533a\u57df\u7684\u51c6\u786e\u8f6c\u5f55\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f38\u5165\u6240\u9078\u53c3\u8003\u5340\u57df\u7684\u6e96\u78ba\u8f49\u9304\u672c\u3002"
          }
        }
      }
    },
    "Generating speech": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u0644\u064a\u062f \u0627\u0644\u0643\u0644\u0627\u0645"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprache erzeugen"
