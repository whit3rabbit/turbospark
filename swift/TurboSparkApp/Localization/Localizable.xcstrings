    "Ranked by compatibility with your %@ memory budget.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0631\u062a\u0628\u0629 \u062d\u0633\u0628 \u0627\u0644\u062a\u0648\u0627\u0641\u0642 \u0645\u0639 \u0645\u064a\u0632\u0627\u0646\u064a\u0629 \u0630\u0627\u0643\u0631\u0629 %@ \u0644\u062f\u064a\u0643."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sortiert nach Kompatibilit\u00e4t mit dem Speicherbudget deines %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ranked by compatibility with your %@ memory budget."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordenados por compatibilidad con el presupuesto de memoria de tu %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Class\u00e9s selon leur compatibilit\u00e9 avec le budget m\u00e9moire de votre %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d3\u05d5\u05e8\u05d2 \u05dc\u05e4\u05d9 \u05d4\u05ea\u05d0\u05de\u05d4 \u05dc\u05ea\u05e7\u05e6\u05d9\u05d1 \u05d4\u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05e9\u05dc %@ \u05e9\u05dc\u05da."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u092a\u0915\u0947 %@ \u0915\u0947 \u092e\u0947\u092e\u094b\u0930\u0940 \u092c\u091c\u091f \u0915\u0947 \u0938\u093e\u0925 \u0938\u0902\u0917\u0924\u0924\u093e \u0915\u0947 \u0905\u0928\u0941\u0938\u093e\u0930 \u0915\u094d\u0930\u092e\u092c\u0926\u094d\u0927\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Diurutkan berdasarkan kecocokan dengan anggaran memori %@ Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordinati per compatibilit\u00e0 con il budget di memoria del tuo %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u304a\u4f7f\u3044\u306e %@ \u306e\u30e1\u30e2\u30ea\u4e88\u7b97\u3068\u306e\u4e92\u63db\u6027\u9806\u306b\u4e26\u3079\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uc6a9 \uc911\uc778 %@\uc758 \uba54\ubaa8\ub9ac \uc608\uc0b0\uacfc\uc758 \ud638\ud658\uc131 \uc21c\uc73c\ub85c \uc815\ub82c\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerangschikt op compatibiliteit met het geheugenbudget van je %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporz\u0105dkowane wed\u0142ug zgodno\u015bci z bud\u017cetem pami\u0119ci uk\u0142adu %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Classificados pela compatibilidade com o or\u00e7amento de mem\u00f3ria do seu %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043f\u043e\u0440\u044f\u0434\u043e\u0447\u0435\u043d\u043e \u043f\u043e \u0441\u043e\u0432\u043c\u0435\u0441\u0442\u0438\u043c\u043e\u0441\u0442\u0438 \u0441 \u043e\u0431\u044a\u0451\u043c\u043e\u043c \u043f\u0430\u043c\u044f\u0442\u0438 \u0432\u0430\u0448\u0435\u0433\u043e %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangordnade efter kompatibilitet med minnesbudgeten f\u00f6r din %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bellek b\u00fct\u00e7enizle uyumlulu\u011fa g\u00f6re s\u0131ralan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043f\u043e\u0440\u044f\u0434\u043a\u043e\u0432\u0430\u043d\u043e \u0437\u0430 \u0441\u0443\u043c\u0456\u0441\u043d\u0456\u0441\u0442\u044e \u0437 \u043e\u0431\u0441\u044f\u0433\u043e\u043c \u043f\u0430\u043c\u2019\u044f\u0442\u0456 \u0432\u0430\u0448\u043e\u0433\u043e %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "X\u1ebfp h\u1ea1ng theo m\u1ee9c t\u01b0\u01a1ng th\u00edch v\u1edbi ng\u00e2n s\u00e1ch b\u1ed9 nh\u1edb c\u1ee7a %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6309\u4e0e\u4f60\u7684 %@ \u5185\u5b58\u9884\u7b97\u7684\u517c\u5bb9\u6027\u6392\u5e8f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f9d\u8207\u4f60\u7684 %@ \u8a18\u61b6\u9ad4\u9810\u7b97\u7684\u76f8\u5bb9\u6027\u6392\u5e8f\u3002"
          }
        }
      }
    },
