    "Shortcuts are fixed. There is no rebinding in this version.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a \u062b\u0627\u0628\u062a\u0629. \u0644\u0627 \u064a\u0645\u0643\u0646 \u0625\u0639\u0627\u062f\u0629 \u062a\u0639\u064a\u064a\u0646\u0647\u0627 \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0625\u0635\u062f\u0627\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurzbefehle sind fest. In dieser Version ist keine Neubelegung m\u00f6glich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts are fixed. There is no rebinding in this version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos son fijos. En esta versi\u00f3n no se pueden reasignar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis sont fixes. Aucune r\u00e9affectation n'est possible dans cette version."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d9\u05e6\u05d5\u05e8\u05d9 \u05d4\u05d3\u05e8\u05da \u05e7\u05d1\u05d5\u05e2\u05d9\u05dd. \u05d0\u05d9\u05df \u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05dc\u05e9\u05e0\u05d5\u05ea \u05d0\u05d5\u05ea\u05dd \u05d1\u05d2\u05e8\u05e1\u05d4 \u05d4\u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0949\u0930\u094d\u091f\u0915\u091f \u0928\u093f\u0936\u094d\u091a\u093f\u0924 \u0939\u0948\u0902\u0964 \u0907\u0938 \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u092e\u0947\u0902 \u0907\u0928\u094d\u0939\u0947\u0902 \u092c\u0926\u0932\u093e \u0928\u0939\u0940\u0902 \u091c\u093e \u0938\u0915\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan bersifat tetap. Tidak ada pengubahan pada versi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie sono fisse. In questa versione non \u00e8 possibile riassegnarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30e7\u30fc\u30c8\u30ab\u30c3\u30c8\u306f\u56fa\u5b9a\u3067\u3059\u3002\u3053\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3067\u306f\u518d\u5272\u308a\u5f53\u3066\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e8\ucd95\ud0a4\ub294 \uace0\uc815\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ubc84\uc804\uc5d0\uc11c\ub294 \uc7ac\uc9c0\uc815\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sneltoetsen liggen vast. In deze versie is opnieuw toewijzen niet mogelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skr\u00f3ty s\u0105 sta\u0142e. W tej wersji nie mo\u017cna ich zmienia\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos s\u00e3o fixos. N\u00e3o h\u00e1 reatribui\u00e7\u00e3o nesta vers\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0447\u0435\u0442\u0430\u043d\u0438\u044f \u043a\u043b\u0430\u0432\u0438\u0448 \u0444\u0438\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u044b. \u0412 \u044d\u0442\u043e\u0439 \u0432\u0435\u0440\u0441\u0438\u0438 \u0438\u0445 \u043d\u0435\u043b\u044c\u0437\u044f \u043f\u0435\u0440\u0435\u043d\u0430\u0437\u043d\u0430\u0447\u0438\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortkommandona \u00e4r fasta. Det g\u00e5r inte att \u00e4ndra dem i den h\u00e4r versionen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0131sayollar sabittir. Bu s\u00fcr\u00fcmde yeniden atama yap\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043c\u0431\u0456\u043d\u0430\u0446\u0456\u0457 \u043a\u043b\u0430\u0432\u0456\u0448 \u0444\u0456\u043a\u0441\u043e\u0432\u0430\u043d\u0456. \u0423 \u0446\u0456\u0439 \u0432\u0435\u0440\u0441\u0456\u0457 \u0457\u0445 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u043f\u0435\u0440\u0435\u043f\u0440\u0438\u0437\u043d\u0430\u0447\u0438\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c ph\u00edm t\u1eaft l\u00e0 c\u1ed1 \u0111\u1ecbnh. Phi\u00ean b\u1ea3n n\u00e0y kh\u00f4ng h\u1ed7 tr\u1ee3 g\u00e1n l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5feb\u6377\u952e\u662f\u56fa\u5b9a\u7684\u3002\u6b64\u7248\u672c\u4e0d\u652f\u6301\u91cd\u65b0\u7ed1\u5b9a\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5feb\u901f\u9375\u662f\u56fa\u5b9a\u7684\u3002\u6b64\u7248\u672c\u4e0d\u652f\u63f4\u91cd\u65b0\u7d81\u5b9a\u3002"
          }
        }
      }
    },
