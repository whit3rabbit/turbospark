    "Code indexing is disabled globally (Settings > General).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u0647\u0631\u0633\u0629 \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0629 \u0645\u0639\u0637\u0644\u0629 \u0628\u0634\u0643\u0644 \u0639\u0627\u0645 (\u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a > \u0639\u0627\u0645)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Codeindizierung ist global deaktiviert (Einstellungen > Allgemein)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Code indexing is disabled globally (Settings > General)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La indexaci\u00f3n de c\u00f3digo est\u00e1 desactivada globalmente (Ajustes > General)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indexation du code est d\u00e9sactiv\u00e9e globalement (R\u00e9glages > G\u00e9n\u00e9ral)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05e0\u05d3\u05d5\u05e7\u05e1 \u05d4\u05e7\u05d5\u05d3 \u05de\u05d5\u05e9\u05d1\u05ea \u05d1\u05d0\u05d5\u05e4\u05df \u05db\u05dc\u05dc\u05d9 (\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea > \u05db\u05dc\u05dc\u05d9)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0921 \u0907\u0902\u0921\u0947\u0915\u094d\u0938\u093f\u0902\u0917 \u092a\u0942\u0930\u0947 \u0910\u092a \u092e\u0947\u0902 \u092c\u0902\u0926 \u0939\u0948 (\u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u0938\u093e\u092e\u093e\u0928\u094d\u092f)\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengindeksan kode dinonaktifkan secara global (Pengaturan > Umum)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indicizzazione del codice \u00e8 disattivata globalmente (Impostazioni > Generali)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30fc\u30c9\u306e\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u4f5c\u6210\u306f\u5168\u4f53\u8a2d\u5b9a\u3067\u7121\u52b9\u3067\u3059 (\u8a2d\u5b9a > \u4e00\u822c)\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucf54\ub4dc \uc778\ub371\uc2f1\uc774 \uc804\uc5ed\uc5d0\uc11c \ube44\ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4(\uc124\uc815 > \uc77c\ubc18)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Code-indexering is algemeen uitgeschakeld (Instellingen > Algemeen)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeksowanie kodu jest globalnie wy\u0142\u0105czone (Ustawienia > Og\u00f3lne)."
