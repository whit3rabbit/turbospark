    "'%@' is not a usable agent name: it resolves outside the agents directory.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb \u0644\u064a\u0633 \u0627\u0633\u0645 \u0648\u0643\u064a\u0644 \u0635\u0627\u0644\u062d\u064b\u0627: \u0641\u0647\u0648 \u064a\u0634\u064a\u0631 \u0625\u0644\u0649 \u062e\u0627\u0631\u062c \u0645\u062c\u0644\u062f \u0627\u0644\u0648\u0643\u0644\u0627\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201e%@\u201c ist kein verwendbarer Agentenname: Er verweist auf einen Ort au\u00dferhalb des Agentenverzeichnisses."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is not a usable agent name: it resolves outside the agents directory."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb no es un nombre de agente v\u00e1lido: apunta fuera del directorio de agentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab %@ \u00bb n'est pas un nom d'agent utilisable : il pointe hors du dossier des agents."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" \u05d0\u05d9\u05e0\u05d5 \u05e9\u05dd \u05e1\u05d5\u05db\u05df \u05e9\u05de\u05d9\u05e9: \u05d4\u05d5\u05d0 \u05de\u05e4\u05e0\u05d4 \u05d0\u05dc \u05de\u05d7\u05d5\u05e5 \u05dc\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05e1\u05d5\u05db\u05e0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0909\u092a\u092f\u094b\u0917 \u092f\u094b\u0917\u094d\u092f \u090f\u091c\u0947\u0902\u091f \u0928\u093e\u092e \u0928\u0939\u0940\u0902 \u0939\u0948: \u092f\u0939 \u090f\u091c\u0947\u0902\u091f \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e \u0915\u0947 \u092c\u093e\u0939\u0930 \u0907\u0902\u0917\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' bukan nama agen yang dapat digunakan: nama ini mengarah ke luar direktori agen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' non \u00e8 un nome di agente utilizzabile: punta fuori dalla directory degli agenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u306f\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u540d\u3068\u3057\u3066\u4f7f\u7528\u3067\u304d\u307e\u305b\u3093: \u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306e\u5916\u3092\u6307\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc740(\ub294) \uc0ac\uc6a9\ud560 \uc218 \uc5c6\ub294 \uc5d0\uc774\uc804\ud2b8 \uc774\ub984\uc785\ub2c8\ub2e4: \uc5d0\uc774\uc804\ud2b8 \ub514\ub809\ud130\ub9ac \ubc16\uc744 \uac00\ub9ac\ud0b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is geen bruikbare agentnaam: deze verwijst naar een locatie buiten de agentenmap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201e%@\u201d nie jest prawid\u0142ow\u0105 nazw\u0105 agenta: wskazuje poza katalog agent\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' n\u00e3o \u00e9 um nome de agente v\u00e1lido: ele aponta para fora do diret\u00f3rio de agentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb \u043d\u0435\u043b\u044c\u0437\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u043a\u0430\u043a \u0438\u043c\u044f \u0430\u0433\u0435\u043d\u0442\u0430: \u043e\u043d\u043e \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0430 \u0430\u0433\u0435\u043d\u0442\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u00e4r inte ett anv\u00e4ndbart agentnamn: det pekar utanf\u00f6r agentkatalogen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' kullan\u0131labilir bir ajan ad\u0131 de\u011fil: ajanlar dizininin d\u0131\u015f\u0131n\u0131 g\u00f6steriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u044f\u043a \u0456\u043c'\u044f \u0430\u0433\u0435\u043d\u0442\u0430: \u0432\u043e\u043d\u043e \u0432\u043a\u0430\u0437\u0443\u0454 \u0437\u0430 \u043c\u0435\u0436\u0456 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0443 \u0430\u0433\u0435\u043d\u0442\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' kh\u00f4ng ph\u1ea3i l\u00e0 t\u00ean t\u00e1c t\u1eed h\u1ee3p l\u1ec7: t\u00ean n\u00e0y tr\u1ecf ra ngo\u00e0i th\u01b0 m\u1ee5c t\u00e1c t\u1eed."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201c%@\u201d\u4e0d\u662f\u53ef\u7528\u7684\u667a\u80fd\u4f53\u540d\u79f0\uff1a\u5b83\u6307\u5411\u667a\u80fd\u4f53\u76ee\u5f55\u4e4b\u5916\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u4e0d\u662f\u53ef\u7528\u7684\u4ee3\u7406\u540d\u7a31\uff1a\u5b83\u6307\u5411\u4ee3\u7406\u76ee\u9304\u4e4b\u5916\u3002"
          }
        }
      }
    },
    "This editor cannot write agents in the %@ scope: built-ins are code and plugin agents are owned by their plugin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u062d\u0631\u0631 \u0643\u062a\u0627\u0628\u0629 \u0648\u0643\u0644\u0627\u0621 \u0641\u064a \u0646\u0637\u0627\u0642 \u00ab%@\u00bb: \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0627\u0644\u0645\u0636\u0645\u0651\u0646\u0648\u0646 \u0639\u0628\u0627\u0631\u0629 \u0639\u0646 \u0634\u064a\u0641\u0631\u0629\u060c \u0648\u0648\u0643\u0644\u0627\u0621 \u0627\u0644\u0645\u0644\u062d\u0642\u0627\u062a \u0645\u0645\u0644\u0648\u0643\u0648\u0646 \u0644\u0645\u0644\u062d\u0642\u0627\u062a\u0647\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Editor kann keine Agenten im Bereich \u201e%@\u201c schreiben: Integrierte Agenten sind Code, und Plug-in-Agenten geh\u00f6ren zu ihrem Plug-in."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This editor cannot write agents in the %@ scope: built-ins are code and plugin agents are owned by their plugin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este editor no puede escribir agentes del \u00e1mbito \u00ab%@\u00bb: los integrados son c\u00f3digo y los agentes de complementos pertenecen a su complemento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet \u00e9diteur ne peut pas \u00e9crire d'agents de port\u00e9e \u00ab %@ \u00bb : les agents int\u00e9gr\u00e9s sont du code et les agents de plug-in appartiennent \u00e0 leur plug-in."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d5\u05e8\u05da \u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05d9\u05db\u05d5\u05dc \u05dc\u05db\u05ea\u05d5\u05d1 \u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05d1\u05d4\u05d9\u05e7\u05e3 \"%@\": \u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05de\u05d5\u05d1\u05e0\u05d9\u05dd \u05d4\u05dd \u05e7\u05d5\u05d3, \u05d5\u05e1\u05d5\u05db\u05e0\u05d9 \u05ea\u05d5\u05e1\u05e4\u05d9\u05dd \u05e9\u05d9\u05d9\u05db\u05d9\u05dd \u05dc\u05ea\u05d5\u05e1\u05e3 \u05e9\u05dc\u05d4\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0938\u0902\u092a\u093e\u0926\u0915 '%@' \u0938\u094d\u0915\u094b\u092a \u092e\u0947\u0902 \u090f\u091c\u0947\u0902\u091f \u0928\u0939\u0940\u0902 \u0932\u093f\u0916 \u0938\u0915\u0924\u093e: \u0905\u0902\u0924\u0930\u094d\u0928\u093f\u0939\u093f\u0924 \u090f\u091c\u0947\u0902\u091f \u0915\u094b\u0921 \u0939\u0948\u0902 \u0914\u0930 \u092a\u094d\u0932\u0917\u0907\u0928 \u090f\u091c\u0947\u0902\u091f \u0905\u092a\u0928\u0947 \u092a\u094d\u0932\u0917\u0907\u0928 \u0915\u0947 \u0938\u094d\u0935\u093e\u092e\u093f\u0924\u094d\u0935 \u092e\u0947\u0902 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Editor ini tidak dapat menulis agen dalam cakupan '%@': agen bawaan berupa kode dan agen plugin dimiliki oleh plugin-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo editor non pu\u00f2 scrivere agenti nell'ambito \u00ab%@\u00bb: quelli integrati sono codice e gli agenti dei plugin appartengono al rispettivo plugin."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30a8\u30c7\u30a3\u30bf\u306f\u300c%@\u300d\u30b9\u30b3\u30fc\u30d7\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3092\u66f8\u304d\u8fbc\u3081\u307e\u305b\u3093: \u7d44\u307f\u8fbc\u307f\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306f\u30b3\u30fc\u30c9\u3067\u3042\u308a\u3001\u30d7\u30e9\u30b0\u30a4\u30f3\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306f\u305d\u306e\u30d7\u30e9\u30b0\u30a4\u30f3\u304c\u6240\u6709\u3057\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud3b8\uc9d1\uae30\ub294 '%@' \ubc94\uc704\uc758 \uc5d0\uc774\uc804\ud2b8\ub97c \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4: \uae30\ubcf8 \uc81c\uacf5 \uc5d0\uc774\uc804\ud2b8\ub294 \ucf54\ub4dc\uc774\uba70 \ud50c\ub7ec\uadf8\uc778 \uc5d0\uc774\uc804\ud2b8\ub294 \ud574\ub2f9 \ud50c\ub7ec\uadf8\uc778\uc774 \uc18c\uc720\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze editor kan geen agenten in het bereik '%@' schrijven: ingebouwde agenten zijn code en plug-in-agenten zijn eigendom van hun plug-in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten edytor nie mo\u017ce zapisywa\u0107 agent\u00f3w w zakresie \u201e%@\u201d: wbudowane agenty s\u0105 kodem, a agenty wtyczek nale\u017c\u0105 do swoich wtyczek."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este editor n\u00e3o pode gravar agentes no escopo \u201c%@\u201d: os integrados s\u00e3o c\u00f3digo e os agentes de plugin pertencem ao respectivo plugin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e\u0442 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0442\u044c \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0438 \u00ab%@\u00bb: \u0432\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0435 \u0430\u0433\u0435\u043d\u0442\u044b \u044f\u0432\u043b\u044f\u044e\u0442\u0441\u044f \u043a\u043e\u0434\u043e\u043c, \u0430 \u0430\u0433\u0435\u043d\u0442\u044b \u043f\u043b\u0430\u0433\u0438\u043d\u043e\u0432 \u043f\u0440\u0438\u043d\u0430\u0434\u043b\u0435\u0436\u0430\u0442 \u0441\u0432\u043e\u0435\u043c\u0443 \u043f\u043b\u0430\u0433\u0438\u043d\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r redigeraren kan inte skriva agenter i omf\u00e5nget '%@': inbyggda agenter \u00e4r kod och till\u00e4ggsagenter \u00e4gs av sina till\u00e4gg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu d\u00fczenleyici '%@' kapsam\u0131ndaki ajanlar\u0131 yazamaz: yerle\u015fik ajanlar koddur ve eklenti ajanlar\u0131 kendi eklentilerine aittir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u0439 \u0440\u0435\u0434\u0430\u043a\u0442\u043e\u0440 \u043d\u0435 \u043c\u043e\u0436\u0435 \u0437\u0430\u043f\u0438\u0441\u0443\u0432\u0430\u0442\u0438 \u0430\u0433\u0435\u043d\u0442\u0456\u0432 \u0432 \u043e\u0431\u043b\u0430\u0441\u0442\u0456 \u00ab%@\u00bb: \u0432\u0431\u0443\u0434\u043e\u0432\u0430\u043d\u0456 \u0430\u0433\u0435\u043d\u0442\u0438 \u0454 \u043a\u043e\u0434\u043e\u043c, \u0430 \u0430\u0433\u0435\u043d\u0442\u0438 \u043f\u043b\u0430\u0433\u0456\u043d\u0456\u0432 \u043d\u0430\u043b\u0435\u0436\u0430\u0442\u044c \u0441\u0432\u043e\u0457\u043c \u043f\u043b\u0430\u0433\u0456\u043d\u0430\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tr\u00ecnh ch\u1ec9nh s\u1eeda n\u00e0y kh\u00f4ng th\u1ec3 ghi t\u00e1c t\u1eed trong ph\u1ea1m vi '%@': t\u00e1c t\u1eed t\u00edch h\u1ee3p l\u00e0 m\u00e3, c\u00f2n t\u00e1c t\u1eed c\u1ee7a plugin thu\u1ed9c v\u1ec1 plugin \u0111\u00f3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u7f16\u8f91\u5668\u65e0\u6cd5\u5199\u5165\u201c%@\u201d\u8303\u56f4\u7684\u667a\u80fd\u4f53\uff1a\u5185\u7f6e\u667a\u80fd\u4f53\u662f\u4ee3\u7801\uff0c\u63d2\u4ef6\u667a\u80fd\u4f53\u5f52\u5176\u63d2\u4ef6\u6240\u6709\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u7de8\u8f2f\u5668\u7121\u6cd5\u5beb\u5165\u300c%@\u300d\u7bc4\u570d\u7684\u4ee3\u7406\uff1a\u5167\u5efa\u4ee3\u7406\u662f\u7a0b\u5f0f\u78bc\uff0c\u5916\u639b\u4ee3\u7406\u6b78\u5176\u5916\u639b\u6240\u6709\u3002"
          }
        }
      }
    },
    "A project-scoped agent needs an open project to write into.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062d\u062a\u0627\u062c \u0627\u0644\u0648\u0643\u064a\u0644 \u0630\u0648 \u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0625\u0644\u0649 \u0645\u0634\u0631\u0648\u0639 \u0645\u0641\u062a\u0648\u062d \u0644\u0644\u0643\u062a\u0627\u0628\u0629 \u0641\u064a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein projektbezogener Agent ben\u00f6tigt ein ge\u00f6ffnetes Projekt, in das er geschrieben werden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A project-scoped agent needs an open project to write into."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente del \u00e1mbito de proyecto necesita un proyecto abierto en el que escribirse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agent de port\u00e9e projet n\u00e9cessite un projet ouvert dans lequel \u00e9crire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05d5\u05db\u05df \u05d1\u05d4\u05d9\u05e7\u05e3 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d6\u05e7\u05d5\u05e7 \u05dc\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05e4\u05ea\u05d5\u05d7 \u05e9\u05d0\u05dc\u05d9\u05d5 \u05d9\u05d9\u05db\u05ea\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e-\u0938\u094d\u0915\u094b\u092a \u0935\u093e\u0932\u0947 \u090f\u091c\u0947\u0902\u091f \u0915\u094b \u0932\u093f\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0916\u0941\u0932\u0940 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agen dengan cakupan proyek memerlukan proyek yang terbuka untuk ditulisi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente con ambito di progetto richiede un progetto aperto in cui scrivere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30b9\u30b3\u30fc\u30d7\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3092\u66f8\u304d\u8fbc\u3080\u306b\u306f\u3001\u958b\u3044\u3066\u3044\u308b\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u304c\u5fc5\u8981\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\uc81d\ud2b8 \ubc94\uc704 \uc5d0\uc774\uc804\ud2b8\ub97c \uc4f0\ub824\uba74 \uc5f4\ub9b0 \ud504\ub85c\uc81d\ud2b8\uac00 \ud544\uc694\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een agent met projectbereik heeft een geopend project nodig om in te schrijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent o zakresie projektu wymaga otwartego projektu, do kt\u00f3rego zostanie zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um agente com escopo de projeto precisa de um projeto aberto para ser gravado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0433\u0435\u043d\u0442\u0443 \u0443\u0440\u043e\u0432\u043d\u044f \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u043d\u0443\u0436\u0435\u043d \u043e\u0442\u043a\u0440\u044b\u0442\u044b\u0439 \u043f\u0440\u043e\u0435\u043a\u0442, \u0432 \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u0435\u0433\u043e \u043c\u043e\u0436\u043d\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En projektagent beh\u00f6ver ett \u00f6ppet projekt att skrivas till."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje kapsaml\u0131 bir ajan\u0131n yaz\u0131labilmesi i\u00e7in a\u00e7\u0131k bir proje gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0433\u0435\u043d\u0442\u0443 \u0440\u0456\u0432\u043d\u044f \u043f\u0440\u043e\u0454\u043a\u0442\u0443 \u043f\u043e\u0442\u0440\u0456\u0431\u0435\u043d \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438\u0439 \u043f\u0440\u043e\u0454\u043a\u0442, \u0443 \u044f\u043a\u0438\u0439 \u0439\u043e\u0433\u043e \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u043f\u0438\u0441\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e1c t\u1eed trong ph\u1ea1m vi d\u1ef1 \u00e1n c\u1ea7n m\u1ed9t d\u1ef1 \u00e1n \u0111ang m\u1edf \u0111\u1ec3 ghi v\u00e0o."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9879\u76ee\u8303\u56f4\u7684\u667a\u80fd\u4f53\u9700\u8981\u4e00\u4e2a\u5df2\u6253\u5f00\u7684\u9879\u76ee\u624d\u80fd\u5199\u5165\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c08\u6848\u7bc4\u570d\u7684\u4ee3\u7406\u9700\u8981\u5df2\u958b\u555f\u7684\u5c08\u6848\u624d\u80fd\u5beb\u5165\u3002"
          }
        }
      }
    },
    "An agent file named '%@' already exists. Rename the new agent or delete the old file first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0648\u062c\u062f \u0645\u0644\u0641 \u0648\u0643\u064a\u0644 \u0628\u0627\u0633\u0645 \u00ab%@\u00bb \u0628\u0627\u0644\u0641\u0639\u0644. \u0623\u0639\u062f \u062a\u0633\u0645\u064a\u0629 \u0627\u0644\u0648\u0643\u064a\u0644 \u0627\u0644\u062c\u062f\u064a\u062f \u0623\u0648 \u0627\u062d\u0630\u0641 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0642\u062f\u064a\u0645 \u0623\u0648\u0644\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Agentendatei mit dem Namen \u201e%@\u201c ist bereits vorhanden. Benennen Sie den neuen Agenten um oder l\u00f6schen Sie zuerst die alte Datei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An agent file named '%@' already exists. Rename the new agent or delete the old file first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un archivo de agente llamado \u00ab%@\u00bb. Cambia el nombre del nuevo agente o elimina primero el archivo antiguo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier d'agent nomm\u00e9 \u00ab %@ \u00bb existe d\u00e9j\u00e0. Renommez le nouvel agent ou supprimez d'abord l'ancien fichier."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d5\u05d1\u05e5 \u05e1\u05d5\u05db\u05df \u05d1\u05e9\u05dd \"%@\" \u05db\u05d1\u05e8 \u05e7\u05d9\u05d9\u05dd. \u05e9\u05e0\u05d4 \u05d0\u05ea \u05e9\u05dd \u05d4\u05e1\u05d5\u05db\u05df \u05d4\u05d7\u05d3\u05e9 \u05d0\u05d5 \u05de\u05d7\u05e7 \u05e7\u05d5\u05d3\u05dd \u05d0\u05ea \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05d9\u05e9\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0928\u093e\u092e \u0915\u0940 \u090f\u091c\u0947\u0902\u091f \u092b\u093c\u093e\u0907\u0932 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948\u0964 \u0928\u090f \u090f\u091c\u0947\u0902\u091f \u0915\u093e \u0928\u093e\u092e \u092c\u0926\u0932\u0947\u0902 \u092f\u093e \u092a\u0939\u0932\u0947 \u092a\u0941\u0930\u093e\u0928\u0940 \u092b\u093c\u093e\u0907\u0932 \u0939\u091f\u093e\u090f\u0901\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File agen bernama '%@' sudah ada. Ganti nama agen baru atau hapus file lama terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste gi\u00e0 un file di agente denominato '%@'. Rinomina il nuovo agente o elimina prima il vecchio file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u3068\u3044\u3046\u540d\u524d\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u30d5\u30a1\u30a4\u30eb\u306f\u3059\u3067\u306b\u5b58\u5728\u3057\u307e\u3059\u3002\u65b0\u3057\u3044\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306e\u540d\u524d\u3092\u5909\u66f4\u3059\u308b\u304b\u3001\u5148\u306b\u53e4\u3044\u30d5\u30a1\u30a4\u30eb\u3092\u524a\u9664\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc774\ub77c\ub294 \uc5d0\uc774\uc804\ud2b8 \ud30c\uc77c\uc774 \uc774\ubbf8 \uc788\uc2b5\ub2c8\ub2e4. \uc0c8 \uc5d0\uc774\uc804\ud2b8\uc758 \uc774\ub984\uc744 \ubc14\uafb8\uac70\ub098 \uba3c\uc800 \uc774\uc804 \ud30c\uc77c\uc744 \uc0ad\uc81c\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een agentbestand met de naam '%@'. Wijzig de naam van de nieuwe agent of verwijder eerst het oude bestand."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik agenta o nazwie \u201e%@\u201d ju\u017c istnieje. Zmie\u0144 nazw\u0119 nowego agenta lub najpierw usu\u0144 stary plik."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "J\u00e1 existe um arquivo de agente chamado '%@'. Renomeie o novo agente ou exclua o arquivo antigo primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b \u0430\u0433\u0435\u043d\u0442\u0430 \u0441 \u0438\u043c\u0435\u043d\u0435\u043c \u00ab%@\u00bb \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442. \u041f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u0443\u0439\u0442\u0435 \u043d\u043e\u0432\u043e\u0433\u043e \u0430\u0433\u0435\u043d\u0442\u0430 \u0438\u043b\u0438 \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u0441\u0442\u0430\u0440\u044b\u0439 \u0444\u0430\u0439\u043b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns redan en agentfil med namnet '%@'. Byt namn p\u00e5 den nya agenten eller ta bort den gamla filen f\u00f6rst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' adl\u0131 bir ajan dosyas\u0131 zaten var. Yeni ajan\u0131 yeniden adland\u0131r\u0131n veya \u00f6nce eski dosyay\u0131 silin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b \u0430\u0433\u0435\u043d\u0442\u0430 \u0437 \u043d\u0430\u0437\u0432\u043e\u044e \u00ab%@\u00bb \u0443\u0436\u0435 \u0456\u0441\u043d\u0443\u0454. \u041f\u0435\u0440\u0435\u0439\u043c\u0435\u043d\u0443\u0439\u0442\u0435 \u043d\u043e\u0432\u043e\u0433\u043e \u0430\u0433\u0435\u043d\u0442\u0430 \u0430\u0431\u043e \u0441\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0432\u0438\u0434\u0430\u043b\u0456\u0442\u044c \u0441\u0442\u0430\u0440\u0438\u0439 \u0444\u0430\u0439\u043b."
