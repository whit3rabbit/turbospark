    "That library is no longer in the list, so nothing was installed. Choose another library.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد هذه المكتبة في القائمة، لذا لم يتم تثبيت أي شيء. اختر مكتبة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bibliothek ist nicht mehr in der Liste, daher wurde nichts installiert. Wählen Sie eine andere Bibliothek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That library is no longer in the list, so nothing was installed. Choose another library."
          }
        },
        "es": {
          "stringUnit": {
