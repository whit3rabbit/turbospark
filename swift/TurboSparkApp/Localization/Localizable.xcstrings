        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インストールされたものはありません。上の候補を選んで開始してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 항목이 없습니다. 위에서 엄선한 변형을 선택해 시작하세요."
          }
        },
        "nl": {
