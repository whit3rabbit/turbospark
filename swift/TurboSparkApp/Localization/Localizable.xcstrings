    "A temporary chat cannot be archived; end Ghost Mode instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0623\u0631\u0634\u0641\u0629 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u0645\u0624\u0642\u062a\u0629\u061b \u0623\u0646\u0647\u0650 \u0648\u0636\u0639 \u0627\u0644\u0634\u0628\u062d \u0628\u062f\u0644\u0627\u064b \u0645\u0646 \u0630\u0644\u0643."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein tempor\u00e4rer Chat kann nicht archiviert werden. Beenden Sie stattdessen den Ghost-Modus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary chat cannot be archived; end Ghost Mode instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat temporal no se puede archivar; sal del modo fantasma en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une discussion temporaire ne peut pas \u00eatre archiv\u00e9e ; quittez plut\u00f4t le mode fant\u00f4me."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05e2\u05d1\u05d9\u05e8 \u05e6'\u05d0\u05d8 \u05d6\u05de\u05e0\u05d9 \u05dc\u05d0\u05e8\u05db\u05d9\u05d5\u05df; \u05d1\u05de\u05e7\u05d5\u05dd \u05d6\u05d0\u05ea, \u05e6\u05d0 \u05de\u05de\u05e6\u05d1 \u05e8\u05e4\u05d0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u091a\u0948\u091f \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e \u0938\u0915\u0924\u0940; \u0907\u0938\u0915\u0947 \u092c\u091c\u093e\u092f \u0918\u094b\u0938\u094d\u091f \u092e\u094b\u0921 \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan sementara tidak dapat diarsipkan; akhiri Mode Hantu sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chat temporanea non pu\u00f2 essere archiviata; esci invece dalla modalit\u00e0 fantasma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6642\u7684\u306a\u30c1\u30e3\u30c3\u30c8\u306f\u30a2\u30fc\u30ab\u30a4\u30d6\u3067\u304d\u307e\u305b\u3093\u3002\u4ee3\u308f\u308a\u306b\u30b4\u30fc\u30b9\u30c8\u30e2\u30fc\u30c9\u3092\u7d42\u4e86\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc784\uc2dc \ucc44\ud305\uc740 \ubcf4\uad00\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub300\uc2e0 \uace0\uc2a4\ud2b8 \ubaa8\ub4dc\ub97c \uc885\ub8cc\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tijdelijke chat kan niet worden gearchiveerd; be\u00ebindig in plaats daarvan de Ghost-modus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czatu tymczasowego nie mo\u017cna zarchiwizowa\u0107; zamiast tego wy\u0142\u0105cz tryb widmo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um chat tempor\u00e1rio n\u00e3o pode ser arquivado; encerre o Modo Fantasma em vez disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0439 \u0447\u0430\u0442 \u043d\u0435\u043b\u044c\u0437\u044f \u0430\u0440\u0445\u0438\u0432\u0438\u0440\u043e\u0432\u0430\u0442\u044c; \u0432\u043c\u0435\u0441\u0442\u043e \u044d\u0442\u043e\u0433\u043e \u0432\u044b\u0439\u0434\u0438\u0442\u0435 \u0438\u0437 \u0440\u0435\u0436\u0438\u043c\u0430 \u043f\u0440\u0438\u0437\u0440\u0430\u043a\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tillf\u00e4llig chatt kan inte arkiveras; avsluta sp\u00f6kl\u00e4get i st\u00e4llet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7ici sohbet ar\u015fivlenemez; bunun yerine Hayalet Modunu sonland\u0131r\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u0438\u0439 \u0447\u0430\u0442 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0430\u0440\u0445\u0456\u0432\u0443\u0432\u0430\u0442\u0438; \u043d\u0430\u0442\u043e\u043c\u0456\u0441\u0442\u044c \u0432\u0438\u0439\u0434\u0456\u0442\u044c \u0456\u0437 \u0440\u0435\u0436\u0438\u043c\u0443 \u043f\u0440\u0438\u0432\u0438\u0434\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 l\u01b0u tr\u1eef cu\u1ed9c tr\u00f2 chuy\u1ec7n t\u1ea1m th\u1eddi; thay v\u00e0o \u0111\u00f3, h\u00e3y tho\u00e1t Ch\u1ebf \u0111\u1ed9 ma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e34\u65f6\u804a\u5929\u65e0\u6cd5\u5f52\u6863\uff1b\u8bf7\u6539\u4e3a\u7ed3\u675f\u5e7d\u7075\u6a21\u5f0f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66ab\u5b58\u804a\u5929\u7121\u6cd5\u5c01\u5b58\uff1b\u8acb\u6539\u70ba\u7d50\u675f\u5e7d\u9748\u6a21\u5f0f\u3002"
          }
        }
      }
    },
    "A temporary chat cannot be branched.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u062a\u0641\u0631\u064a\u0639 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u0645\u0624\u0642\u062a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein tempor\u00e4rer Chat kann nicht verzweigt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A temporary chat cannot be branched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chat temporal no se puede ramificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de cr\u00e9er une branche \u00e0 partir d'une discussion temporaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05e4\u05e6\u05dc \u05e6'\u05d0\u05d8 \u05d6\u05de\u05e0\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u091a\u0948\u091f \u0915\u0940 \u0936\u093e\u0916\u093e \u0928\u0939\u0940\u0902 \u092c\u0928\u093e\u0908 \u091c\u093e \u0938\u0915\u0924\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrolan sementara tidak dapat dicabangkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una chat temporanea non pu\u00f2 essere ramificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6642\u7684\u306a\u30c1\u30e3\u30c3\u30c8\u306f\u5206\u5c90\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc784\uc2dc \ucc44\ud305\uc740 \ubd84\uae30\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een tijdelijke chat kan niet worden vertakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z czatu tymczasowego nie mo\u017cna utworzy\u0107 ga\u0142\u0119zi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um chat tempor\u00e1rio n\u00e3o pode ser ramificado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437 \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u0433\u043e \u0447\u0430\u0442\u0430 \u043d\u0435\u043b\u044c\u0437\u044f \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u0432\u0435\u0442\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tillf\u00e4llig chatt kan inte f\u00f6rgrenas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7ici sohbet dalland\u0131r\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417 \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u043e\u0433\u043e \u0447\u0430\u0442\u0443 \u043d\u0435 \u043c\u043e\u0436\u043d\u0430 \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u0433\u0456\u043b\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 ph\u00e2n nh\u00e1nh cu\u1ed9c tr\u00f2 chuy\u1ec7n t\u1ea1m th\u1eddi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e34\u65f6\u804a\u5929\u65e0\u6cd5\u5206\u652f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66ab\u5b58\u804a\u5929\u7121\u6cd5\u5206\u652f\u3002"
          }
        }
      }
    },
