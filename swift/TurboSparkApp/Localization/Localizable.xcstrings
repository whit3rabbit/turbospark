    "Authenticate to inspect and download gated or private repositories.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u062c\u0651\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0644\u0641\u062d\u0635 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639\u0627\u062a \u0627\u0644\u0645\u0642\u064a\u062f\u0629 \u0623\u0648 \u0627\u0644\u062e\u0627\u0635\u0629 \u0648\u062a\u0646\u0632\u064a\u0644\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifizieren Sie sich, um gesperrte oder private Repositorys zu pr\u00fcfen und herunterzuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Authenticate to inspect and download gated or private repositories."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Autent\u00edcate para inspeccionar y descargar repositorios restringidos o privados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Authentifiez-vous pour inspecter et t\u00e9l\u00e9charger des d\u00e9p\u00f4ts restreints ou priv\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05e6\u05e2 \u05d0\u05d9\u05de\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d5\u05dc\u05d4\u05d5\u05e8\u05d9\u05d3 \u05de\u05d0\u05d2\u05e8\u05d9\u05dd \u05de\u05d5\u05d2\u05d1\u05dc\u05d9\u05dd \u05d0\u05d5 \u05e4\u05e8\u05d8\u05d9\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u092f\u093e \u0928\u093f\u091c\u0940 \u0930\u093f\u092a\u0949\u091c\u093f\u091f\u0930\u0940 \u0926\u0947\u0916\u0928\u0947 \u0914\u0930 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u092e\u093e\u0923\u0940\u0915\u0930\u0923 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentikasi untuk memeriksa dan mengunduh repositori terbatas atau privat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Autenticati per ispezionare e scaricare repository con accesso limitato o privati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5236\u9650\u4ed8\u304d\u307e\u305f\u306f\u975e\u516c\u958b\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u3092\u691c\u67fb\u3057\u3066\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3059\u308b\u306b\u306f\u8a8d\u8a3c\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc81c\ud55c\ub418\uac70\ub098 \ube44\uacf5\uac1c\uc778 \ub9ac\ud3ec\uc9c0\ud1a0\ub9ac\ub97c \ud655\uc778\ud558\uace0 \ub2e4\uc6b4\ub85c\ub4dc\ud558\ub824\uba74 \uc778\uc99d\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifieer om afgeschermde of priv\u00e9repository's te bekijken en te downloaden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwierzytelnij si\u0119, aby przegl\u0105da\u0107 i pobiera\u0107 repozytoria z ograniczonym dost\u0119pem lub prywatne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentique-se para inspecionar e baixar reposit\u00f3rios restritos ou privados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0439\u0434\u0438\u0442\u0435 \u0430\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044e, \u0447\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0441\u043c\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044c \u0438 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0442\u044c \u0437\u0430\u043a\u0440\u044b\u0442\u044b\u0435 \u0438\u043b\u0438 \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u044b\u0435 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentisera dig f\u00f6r att granska och ladda ned begr\u00e4nsade eller privata utvecklingskataloger."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0131s\u0131tl\u0131 veya \u00f6zel depolar\u0131 incelemek ve indirmek i\u00e7in kimlik do\u011frulamas\u0131 yap\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0439\u0434\u0456\u0442\u044c \u0430\u0432\u0442\u0435\u043d\u0442\u0438\u0444\u0456\u043a\u0430\u0446\u0456\u044e, \u0449\u043e\u0431 \u043f\u0435\u0440\u0435\u0433\u043b\u044f\u0434\u0430\u0442\u0438 \u0442\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u0432\u0430\u0442\u0438 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u0456 \u0430\u0431\u043e \u043f\u0440\u0438\u0432\u0430\u0442\u043d\u0456 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0456\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "X\u00e1c th\u1ef1c \u0111\u1ec3 ki\u1ec3m tra v\u00e0 t\u1ea3i xu\u1ed1ng kho l\u01b0u tr\u1eef b\u1ecb h\u1ea1n ch\u1ebf ho\u1eb7c ri\u00eang t\u01b0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fdb\u884c\u8ba4\u8bc1\u4ee5\u68c0\u67e5\u548c\u4e0b\u8f7d\u53d7\u9650\u6216\u79c1\u6709\u4ed3\u5e93\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9032\u884c\u9a57\u8b49\u4ee5\u6aa2\u67e5\u4e26\u4e0b\u8f09\u53d7\u9650\u6216\u79c1\u6709\u5132\u5b58\u5eab\u3002"
          }
        }
      }
    },
