        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5143\u306e\u30d5\u30a1\u30a4\u30eb\u306f\u3001\u5f53\u521d\u306e\u30d1\u30b9\u306b\u306f\u3082\u3046\u5b58\u5728\u3057\u307e\u305b\u3093\u3002"
