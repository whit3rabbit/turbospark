        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05d1\u05e8 \u05e7\u05d9\u05d9\u05dd \u05e9\u05e8\u05ea \u05d1\u05e9\u05dd '%@'."
