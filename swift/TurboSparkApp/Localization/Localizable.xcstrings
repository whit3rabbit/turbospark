          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u043b\u043e\u0432\u0430 \u0431\u0430\u0433\u0430\u0442\u043e\u0442\u043e\u043a\u0435\u043d\u043d\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0435\u043d\u043d\u044f: \u0448\u0432\u0438\u0434\u043a\u0456 \u0441\u043f\u0435\u043a\u0443\u043b\u044f\u0442\u0438\u0432\u043d\u0456 \u0447\u0435\u0440\u043d\u0435\u0442\u043a\u0438 \u0437 \u043f\u0440\u0438\u0441\u043a\u043e\u0440\u0435\u043d\u043d\u044f\u043c \u0434\u043e 1,66x"
