        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kal\u0131c\u0131 bellekler ay\u0131klan\u0131yor\u2026"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043b\u0443\u0447\u0435\u043d\u043d\u044f \u0434\u043e\u0432\u0433\u043e\u0442\u0440\u0438\u0432\u0430\u043b\u0438\u0445 \u0441\u043f\u043e\u0433\u0430\u0434\u0456\u0432\u2026"
          }
        },
        "vi": {
          "stringUnit": {
