    "The system is short of memory. Generation is being paced down; closing an idle model or another app will relieve it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النظام يعاني نقصًا في الذاكرة. يجري إبطاء التوليد؛ إغلاق نموذج خامل أو تطبيق آخر سيخفف ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das System hat zu wenig Speicher. Die Generierung wird verlangsamt; das Schließen eines inaktiven Modells oder einer anderen App schafft Abhilfe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The system is short of memory. Generation is being paced down; closing an idle model or another app will relieve it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El sistema tiene poca memoria. La generación se está ralentizando; cerrar un modelo inactivo u otra app lo aliviará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le système manque de mémoire. La génération est ralentie ; fermer un modèle inactif ou une autre app la soulagera."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למערכת חסר זיכרון. קצב היצירה מואט; סגירת מודל לא פעיל או אפליקציה אחרת תקל על כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम में मेमोरी कम है। जनरेशन धीमा किया जा रहा है; किसी निष्क्रिय मॉडल या दूसरे ऐप को बंद करने से राहत मिलेगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem kekurangan memori. Pembuatan sedang diperlambat; menutup model yang tidak aktif atau aplikasi lain akan meringankannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il sistema ha poca memoria. La generazione viene rallentata; chiudere un modello inattivo o un'altra app la alleggerirà."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システムのメモリが不足しています。生成速度を抑えています。使用していないモデルや他のアプリを閉じると改善します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 메모리가 부족합니다. 생성 속도를 낮추는 중이며, 유휴 모델이나 다른 앱을 닫으면 완화됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het systeem heeft te weinig geheugen. Het genereren wordt vertraagd; een inactief model of een andere app sluiten verlicht dit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W systemie brakuje pamięci. Generowanie jest spowalniane; zamknięcie nieużywanego modelu lub innej aplikacji to złagodzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O sistema está com pouca memória. A geração está sendo desacelerada; fechar um modelo ocioso ou outro app vai aliviar isso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системе не хватает памяти. Генерация замедляется; закройте неиспользуемую модель или другое приложение, чтобы снизить нагрузку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemet har ont om minne. Genereringen saktas ned; att stänga en inaktiv modell eller en annan app hjälper."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistemin belleği yetersiz. Üretim yavaşlatılıyor; boşta olan bir modeli veya başka bir uygulamayı kapatmak durumu rahatlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системі бракує пам'яті. Генерацію сповільнено; закрийте неактивну модель або іншу програму, щоб зменшити навантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hệ thống đang thiếu bộ nhớ. Quá trình tạo đang được làm chậm lại; đóng một mô hình không dùng hoặc ứng dụng khác sẽ giúp giảm tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统内存不足。正在放慢生成速度；关闭闲置的模型或其他 App 可缓解。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統記憶體不足。正在放慢產生速度；關閉閒置的模型或其他 App 可緩解。"
          }
        }
      }
    },
