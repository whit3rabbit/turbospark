    "Profile \"%@\" created. Switch to it to start using it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \"%@\". \u0628\u062f\u0651\u0644 \u0625\u0644\u064a\u0647 \u0644\u0628\u062f\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil \"%@\" erstellt. Wechseln Sie zu diesem Profil, um es zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile \"%@\" created. Switch to it to start using it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil \"%@\" creado. Cambia a \u00e9l para empezar a usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil \"%@\" cr\u00e9\u00e9. Passez-y pour commencer \u00e0 l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \"%@\" \u05e0\u05d5\u05e6\u05e8. \u05e2\u05d1\u05d5\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \"%@\" \u092c\u0928\u093e\u0908 \u0917\u0908\u0964 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil \"%@\" dibuat. Beralihlah ke profil ini untuk mulai menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo \"%@\" creato. Passa a questo profilo per iniziare a usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\"%@\"\u3092\u4f5c\u6210\u3057\u307e\u3057\u305f\u3002\u4f7f\u7528\u3059\u308b\u306b\u306f\u3001\u3053\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u5207\u308a\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\ud544 \"%@\"\uc744(\ub97c) \ub9cc\ub4e4\uc5c8\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\ud558\ub824\uba74 \uc774 \ud504\ub85c\ud544\ub85c \uc804\ud658\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiel \"%@\" aangemaakt. Schakel ernaar over om het te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzono profil \"%@\". Prze\u0142\u0105cz si\u0119 na niego, aby zacz\u0105\u0107 z niego korzysta\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil \"%@\" criado. Mude para ele para come\u00e7ar a us\u00e1-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0444\u0438\u043b\u044c \"%@\" \u0441\u043e\u0437\u0434\u0430\u043d. \u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u0441\u044c \u043d\u0430 \u043d\u0435\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen \"%@\" har skapats. Byt till den f\u00f6r att b\u00f6rja anv\u00e4nda den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" profili olu\u015fturuldu. Kullanmaya ba\u015flamak i\u00e7in bu profile ge\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0444\u0456\u043b\u044c \"%@\" \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u043e. \u041f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u043d\u0430 \u043d\u044c\u043e\u0433\u043e, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 t\u1ea1o h\u1ed3 s\u01a1 \"%@\". H\u00e3y chuy\u1ec3n sang h\u1ed3 s\u01a1 n\u00e0y \u0111\u1ec3 b\u1eaft \u0111\u1ea7u s\u1eed d\u1ee5ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u521b\u5efa\u914d\u7f6e\u6863\u6848\"%@\"\u3002\u5207\u6362\u5230\u8be5\u914d\u7f6e\u6863\u6848\u5373\u53ef\u5f00\u59cb\u4f7f\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5efa\u7acb\u8a2d\u5b9a\u6a94\"%@\"\u3002\u5207\u63db\u81f3\u8a72\u8a2d\u5b9a\u6a94\u5373\u53ef\u958b\u59cb\u4f7f\u7528\u3002"
          }
        }
      }
    },
