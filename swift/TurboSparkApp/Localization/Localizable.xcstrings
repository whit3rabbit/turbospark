        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0432\u0441\u0435 \u0439 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0456\u0437 \u0446\u0438\u043c \u043f\u0440\u043e\u0444\u0456\u043b\u0435\u043c"
          }
