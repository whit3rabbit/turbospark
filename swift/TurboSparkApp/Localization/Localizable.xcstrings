    "Describe a soundtrack and keep each take for comparison.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a soundtrack and keep each take for comparison."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe una banda sonora y conserva cada toma para compararlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez une bande sonore et conservez chaque prise pour les comparer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe einen Soundtrack und behalte jeden Take zum Vergleich."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi una colonna sonora e conserva ogni take per confrontarle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma trilha sonora e guarde cada tomada para comparar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf een soundtrack en bewaar elke take om te vergelijken."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv ett ljudspår och behåll varje tagning för jämförelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz ścieżkę dźwiękową i zachowaj każdą wersję do porównania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir müzik parçasını tarif edin ve karşılaştırmak için her çekimi saklayın."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsikan musik latar dan simpan setiap take untuk dibandingkan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
