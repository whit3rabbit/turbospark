          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contenu importable trouv\u00e9 dans les emplacements des autres agents."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05de\u05e6\u05d0 \u05ea\u05d5\u05db\u05df \u05d4\u05e0\u05d9\u05ea\u05df \u05dc\u05d9\u05d9\u05d1\u05d5\u05d0 \u05d1\u05de\u05d9\u05e7\u05d5\u05de\u05d9 \u05db\u05dc\u05d9 \u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0928\u094d\u092f \u090f\u091c\u0947\u0902\u091f \u091f\u0942\u0932 \u0938\u094d\u0925\u093e\u0928\u094b\u0902 \u092e\u0947\u0902 \u0915\u094b\u0908 \u0906\u092f\u093e\u0924 \u092f\u094b\u0917\u094d\u092f \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada konten yang dapat diimpor ditemukan di lokasi alat agent lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun contenuto importabile trovato nelle posizioni degli altri strumenti agent."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u30c4\u30fc\u30eb\u306e\u5834\u6240\u306b\u30a4\u30f3\u30dd\u30fc\u30c8\u53ef\u80fd\u306a\u30b3\u30f3\u30c6\u30f3\u30c4\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\ub978 \uc5d0\uc774\uc804\ud2b8 \ub3c4\uad6c \uc704\uce58\uc5d0\uc11c \uac00\uc838\uc62c \uc218 \uc788\ub294 \ucf58\ud150\uce20\ub97c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen importeerbare inhoud gevonden op locaties van andere agent-tools."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono tre\u015bci mo\u017cliwych do zaimportowania w lokalizacjach innych narz\u0119dzi agent\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum conte\u00fado import\u00e1vel encontrado nos locais de outras ferramentas de agente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0440\u0430\u0441\u043f\u043e\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u0445 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u0433\u0435\u043d\u0442\u0441\u043a\u0438\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u043e \u0441\u043e\u0434\u0435\u0440\u0436\u0438\u043c\u043e\u0433\u043e \u0434\u043b\u044f \u0438\u043c\u043f\u043e\u0440\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen importerbar inneh\u00e5ll hittades p\u00e5 andra agentverktygs platser."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Di\u011fer arac\u0131 ara\u00e7lar\u0131 konumlar\u0131nda i\u00e7e aktar\u0131labilir i\u00e7erik bulunamad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0440\u043e\u0437\u0442\u0430\u0448\u0443\u0432\u0430\u043d\u043d\u044f\u0445 \u0456\u043d\u0448\u0438\u0445 \u0430\u0433\u0435\u043d\u0442\u043d\u0438\u0445 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e \u0432\u043c\u0456\u0441\u0442\u0443 \u0434\u043b\u044f \u0456\u043c\u043f\u043e\u0440\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y n\u1ed9i dung c\u00f3 th\u1ec3 nh\u1eadp t\u1ea1i c\u00e1c v\u1ecb tr\u00ed c\u1ee7a c\u00f4ng c\u1ee5 agent kh\u00e1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5176\u4ed6\u4ee3\u7406\u5de5\u5177\u7684\u4f4d\u7f6e\u4e2d\u672a\u627e\u5230\u53ef\u5bfc\u5165\u7684\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5176\u4ed6\u4ee3\u7406\u5de5\u5177\u7684\u4f4d\u7f6e\u4e2d\u672a\u627e\u5230\u53ef\u532f\u5165\u7684\u5167\u5bb9\u3002"
          }
        }
      }
    },
