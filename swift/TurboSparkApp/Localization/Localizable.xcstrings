    "Software engineer optimized for codebase navigation, editing, terminal commands, and debugging.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0647\u0646\u062f\u0633 \u0628\u0631\u0645\u062c\u064a\u0627\u062a \u0645\u0647\u064a\u0623 \u0644\u0644\u062a\u0646\u0642\u0644 \u0641\u064a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0634\u064a\u0641\u0631\u0629 \u0648\u0627\u0644\u062a\u062d\u0631\u064a\u0631 \u0648\u0623\u0648\u0627\u0645\u0631 \u0627\u0644\u0637\u0631\u0641\u064a\u0629 \u0648\u062a\u0635\u062d\u064a\u062d \u0627\u0644\u0623\u062e\u0637\u0627\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Softwareentwickler, optimiert f\u00fcr Navigation im Code, Bearbeitung, Terminalbefehle und Fehlersuche."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Software engineer optimized for codebase navigation, editing, terminal commands, and debugging."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingeniero de software optimizado para navegar por el c\u00f3digo, editar, usar la terminal y depurar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ing\u00e9nieur logiciel optimis\u00e9 pour parcourir le code, l'\u00e9diter, utiliser le terminal et d\u00e9boguer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d4\u05e0\u05d3\u05e1 \u05ea\u05d5\u05db\u05e0\u05d4 \u05e9\u05de\u05d5\u05ea\u05d0\u05dd \u05dc\u05e0\u05d9\u05d5\u05d5\u05d8 \u05d1\u05e7\u05d5\u05d3, \u05e2\u05e8\u05d9\u05db\u05d4, \u05e4\u05e7\u05d5\u05d3\u05d5\u05ea \u05de\u05e1\u05d5\u05e3 \u05d5\u05e0\u05d9\u05e4\u05d5\u05d9 \u05d1\u05d0\u05d2\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0921\u092c\u0947\u0938 \u0928\u0947\u0935\u093f\u0917\u0947\u0936\u0928, \u0938\u0902\u092a\u093e\u0926\u0928, \u091f\u0930\u094d\u092e\u093f\u0928\u0932 \u0915\u092e\u093e\u0902\u0921 \u0914\u0930 \u0921\u0940\u092c\u0917\u093f\u0902\u0917 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0941\u0915\u0942\u0932\u093f\u0924 \u0938\u0949\u092b\u093c\u094d\u091f\u0935\u0947\u092f\u0930 \u0907\u0902\u091c\u0940\u0928\u093f\u092f\u0930\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Insinyur perangkat lunak yang dioptimalkan untuk menjelajah kode, mengedit, perintah terminal, dan debugging."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingegnere software ottimizzato per esplorare il codice, modificarlo, usare il terminale e fare debug."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30fc\u30c9\u30d9\u30fc\u30b9\u306e\u63a2\u7d22\u3001\u7de8\u96c6\u3001\u30bf\u30fc\u30df\u30ca\u30eb\u64cd\u4f5c\u3001\u30c7\u30d0\u30c3\u30b0\u306b\u6700\u9069\u5316\u3055\u308c\u305f\u30bd\u30d5\u30c8\u30a6\u30a7\u30a2\u30a8\u30f3\u30b8\u30cb\u30a2\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucf54\ub4dc\ubca0\uc774\uc2a4 \ud0d0\uc0c9, \ud3b8\uc9d1, \ud130\ubbf8\ub110 \uba85\ub839, \ub514\ubc84\uae45\uc5d0 \ucd5c\uc801\ud654\ub41c \uc18c\ud504\ud2b8\uc6e8\uc5b4 \uc5d4\uc9c0\ub2c8\uc5b4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Software-engineer, geoptimaliseerd voor navigeren door code, bewerken, terminalopdrachten en debuggen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "In\u017cynier oprogramowania zoptymalizowany pod nawigacj\u0119 po kodzie, edycj\u0119, polecenia terminala i debugowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Engenheiro de software otimizado para navegar no c\u00f3digo, editar, usar o terminal e depurar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u043c\u0438\u0441\u0442, \u043d\u0430\u0441\u0442\u0440\u043e\u0435\u043d\u043d\u044b\u0439 \u043d\u0430 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044e \u043f\u043e \u043a\u043e\u0434\u0443, \u043f\u0440\u0430\u0432\u043a\u0438, \u043a\u043e\u043c\u0430\u043d\u0434\u044b \u0442\u0435\u0440\u043c\u0438\u043d\u0430\u043b\u0430 \u0438 \u043e\u0442\u043b\u0430\u0434\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Mjukvaruingenj\u00f6r optimerad f\u00f6r att navigera i kod, redigera, k\u00f6ra terminalkommandon och fels\u00f6ka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod taban\u0131nda gezinme, d\u00fczenleme, terminal komutlar\u0131 ve hata ay\u0131klama i\u00e7in optimize edilmi\u015f yaz\u0131l\u0131m m\u00fchendisi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0433\u0440\u0430\u043c\u0456\u0441\u0442, \u043d\u0430\u043b\u0430\u0448\u0442\u043e\u0432\u0430\u043d\u0438\u0439 \u043d\u0430 \u043d\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u044e \u043a\u043e\u0434\u043e\u043c, \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f, \u043a\u043e\u043c\u0430\u043d\u0434\u0438 \u0442\u0435\u0440\u043c\u0456\u043d\u0430\u043b\u0430 \u0442\u0430 \u043d\u0430\u043b\u0430\u0433\u043e\u0434\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u1ef9 s\u01b0 ph\u1ea7n m\u1ec1m t\u1ed1i \u01b0u cho vi\u1ec7c duy\u1ec7t m\u00e3 ngu\u1ed3n, ch\u1ec9nh s\u1eeda, l\u1ec7nh terminal v\u00e0 g\u1ee1 l\u1ed7i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u4ee3\u7801\u5e93\u6d4f\u89c8\u3001\u7f16\u8f91\u3001\u7ec8\u7aef\u547d\u4ee4\u548c\u8c03\u8bd5\u4f18\u5316\u7684\u8f6f\u4ef6\u5de5\u7a0b\u5e08\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u7a0b\u5f0f\u78bc\u5eab\u700f\u89bd\u3001\u7de8\u8f2f\u3001\u7d42\u7aef\u6a5f\u6307\u4ee4\u548c\u9664\u932f\u6700\u4f73\u5316\u7684\u8edf\u9ad4\u5de5\u7a0b\u5e2b\u3002"
          }
        }
      }
    },
