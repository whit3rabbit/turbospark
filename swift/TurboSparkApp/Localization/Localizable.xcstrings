    "Tell others before you record a meeting. Some places require their consent.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell others before you record a meeting. Some places require their consent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisa a los demás antes de grabar una reunión. En algunos lugares se requiere su consentimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prévenez les autres avant d'enregistrer une réunion. Certains endroits exigent leur consentement."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Informiere andere, bevor du ein Meeting aufnimmst. Mancherorts ist ihre Zustimmung erforderlich."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvisa gli altri prima di registrare una riunione. In alcuni luoghi è richiesto il loro consenso."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avise os outros antes de gravar uma reunião. Alguns lugares exigem o consentimento deles."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предупредите других, прежде чем записывать встречу. В некоторых местах требуется их согласие."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "会議を録音する前に、参加者に知らせてください。地域によっては同意が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "회의를 녹음하기 전에 다른 사람에게 알리세요. 일부 지역에서는 동의가 필요합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录制会议前请告知其他人。某些地区要求征得他们的同意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄製會議前請告知其他人。某些地區需要取得他們的同意。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبر الآخرين قبل تسجيل اجتماع. تشترط بعض الأماكن موافقتهم."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש ליידע אחרים לפני הקלטת פגישה. במקומות מסוימים נדרשת הסכמתם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मीटिंग रिकॉर्ड करने से पहले दूसरों को बताएँ। कुछ जगहों पर उनकी सहमति आवश्यक होती है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat anderen het weten voordat je een vergadering opneemt. Op sommige plaatsen is hun toestemming vereist."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poinformuj innych, zanim nagrasz spotkanie. W niektórych miejscach wymagana jest ich zgoda."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir toplantıyı kaydetmeden önce diğerlerini bilgilendirin. Bazı yerlerde onların onayı gerekir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередьте інших, перш ніж записувати зустріч. У деяких місцях потрібна їхня згода."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta för andra innan du spelar in ett möte. På vissa platser krävs deras samtycke."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy báo cho người khác trước khi ghi âm cuộc họp. Một số nơi yêu cầu họ đồng ý."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu orang lain sebelum Anda merekam rapat. Beberapa tempat mewajibkan persetujuan mereka."
          }
        }
      }
    },
    "Tell the model you are not answering these": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبر النموذج أنك لن تجيب عن هذه الأسئلة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dem Modell mitteilen, dass du diese nicht beantwortest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell the model you are not answering these"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decirle al modelo que no responderás a estas"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Indiquer au modèle que vous ne répondez pas à ces questions"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ספר למודל שאינך עונה על השאלות האלה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल को बताएँ कि आप इनका उत्तर नहीं दे रहे"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beri tahu model bahwa Anda tidak menjawab pertanyaan ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Comunica al modello che non risponderai"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらに回答しないことをモデルに伝える"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 질문에 답하지 않는다고 모델에 알리기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model laten weten dat je deze niet beantwoordt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz modelowi, że nie odpowiesz na te pytania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Avisar o modelo que você não vai responder a estas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сообщить модели, что вы не будете отвечать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Berätta för modellen att du inte svarar på dessa"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modele bunları yanıtlamayacağınızı bildirin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Повідомити модель, що ви не відповідатимете"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Báo cho mô hình biết bạn không trả lời các câu này"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "告诉模型你不回答这些问题"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "告訴模型你不回答這些問題"
          }
        }
      }
    },
