            "state": "translated",
            "value": "Biarkan pemasang memilih"
          }
        }
      }
    },
    "Let us create something great together.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let us create something great together."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creemos algo grandioso juntos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créons quelque chose de formidable ensemble."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie uns gemeinsam etwas Großartiges schaffen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creiamo qualcosa di straordinario insieme."
          }
        },
        "pt-BR": {
