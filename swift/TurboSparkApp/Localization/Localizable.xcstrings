        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0442\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0446\u0438\u044f \u0441 \u043f\u043e\u043c\u043e\u0449\u044c\u044e Touch ID \u0438\u043b\u0438 \u0432\u0445\u043e\u0434\u0430 \u0432 Mac \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430."
