        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Forma n\u00e3o verificada: o manifesto deste modelo n\u00e3o declara tamanho oculto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u043e\u0440\u043c\u0430 \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u0430: \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442 \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0435 \u0443\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442 \u0441\u043a\u0440\u044b\u0442\u044b\u0439 \u0440\u0430\u0437\u043c\u0435\u0440."
          }
