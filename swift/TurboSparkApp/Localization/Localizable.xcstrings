          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0631 \u0625\u0646\u0634\u0627\u0621 \u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0634\u0648\u0627\u0626\u064a\u0629 \u0622\u0645\u0646\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichere Zufallsdaten konnten nicht erzeugt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secure random data could not be generated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron generar datos aleatorios seguros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de g\u00e9n\u00e9rer des donn\u00e9es al\u00e9atoires s\u00e9curis\u00e9es."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d9\u05e6\u05d5\u05e8 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d0\u05e7\u05e8\u05d0\u05d9\u05d9\u05dd \u05de\u05d0\u05d5\u05d1\u05d8\u05d7\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u092f\u093e\u0926\u0943\u091a\u094d\u091b\u093f\u0915 \u0921\u0947\u091f\u093e \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data acak yang aman tidak dapat dibuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile generare dati casuali sicuri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b89\u5168\u306a\u4e71\u6570\u30c7\u30fc\u30bf\u3092\u751f\u6210\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc548\uc804\ud55c \ub09c\uc218 \ub370\uc774\ud130\ub97c \uc0dd\uc131\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan geen veilige willekeurige gegevens genereren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie mo\u017cna wygenerowa\u0107 bezpiecznych danych losowych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel gerar dados aleat\u00f3rios seguros."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u0442\u044c \u0431\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u044b\u0435 \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u044b\u0435 \u0434\u0430\u043d\u043d\u044b\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det gick inte att generera s\u00e4kra slumpdata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00fcvenli rastgele veri olu\u015fturulamad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0433\u0435\u043d\u0435\u0440\u0443\u0432\u0430\u0442\u0438 \u0431\u0435\u0437\u043f\u0435\u0447\u043d\u0456 \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u0456 \u0434\u0430\u043d\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 t\u1ea1o d\u1eef li\u1ec7u ng\u1eabu nhi\u00ean an to\u00e0n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u751f\u6210\u5b89\u5168\u968f\u673a\u6570\u636e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u7522\u751f\u5b89\u5168\u96a8\u6a5f\u8cc7\u6599\u3002"
          }
        }
      }
    },
    "The passphrase key could not be derived.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0631 \u0627\u0634\u062a\u0642\u0627\u0642 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0645\u0646 \u0639\u0628\u0627\u0631\u0629 \u0627\u0644\u0645\u0631\u0648\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Schl\u00fcssel konnte nicht aus der Passphrase abgeleitet werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passphrase key could not be derived."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo derivar la clave de la frase de contrase\u00f1a."
