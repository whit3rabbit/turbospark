        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9finissez votre propre limite de taille maximale des mod\u00e8les pouvant \u00eatre charg\u00e9s"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d2\u05d3\u05e8 \u05d1\u05e2\u05e6\u05de\u05da \u05d0\u05ea \u05d4\u05d2\u05d5\u05d3\u05dc \u05d4\u05de\u05e8\u05d1\u05d9 \u05e9\u05dc \u05de\u05d5\u05d3\u05dc \u05e9\u05e0\u05d9\u05ea\u05df \u05dc\u05d8\u05e2\u05d5\u05df"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u094b\u0921 \u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0928\u0947 \u0935\u093e\u0932\u0947 \u092e\u0949\u0921\u0932 \u0915\u0947 \u0905\u0927\u093f\u0915\u0924\u092e \u0906\u0915\u093e\u0930 \u0915\u0940 \u0905\u092a\u0928\u0940 \u0938\u0940\u092e\u093e \u0924\u092f \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetapkan sendiri batas ukuran maksimum model yang dapat dimuat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta un tuo limite alla dimensione massima dei modelli caricabili"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aad\u307f\u8fbc\u3081\u308b\u30e2\u30c7\u30eb\u306e\u6700\u5927\u30b5\u30a4\u30ba\u3092\u81ea\u5206\u3067\u8a2d\u5b9a\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub85c\ub4dc\ud560 \uc218 \uc788\ub294 \ucd5c\ub300 \ubaa8\ub378 \ud06c\uae30\ub97c \uc9c1\uc811 \uc124\uc815\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel zelf een limiet in voor de maximale modelgrootte die kan worden geladen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw w\u0142asny limit maksymalnego rozmiaru modelu, kt\u00f3ry mo\u017cna za\u0142adowa\u0107"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina seu pr\u00f3prio limite de tamanho m\u00e1ximo de modelo que pode ser carregado"
