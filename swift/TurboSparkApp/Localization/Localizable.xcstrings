    "TurboSpark will not offer this library again. You can add it later in Models & Storage settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لن يعرض TurboSpark هذه المكتبة مرة أخرى. يمكنك إضافتها لاحقًا من «النماذج والتخزين» في الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark bietet diese Bibliothek nicht mehr an. Sie können sie später in den Einstellungen unter „Modelle & Speicherplatz“ hinzufügen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark will not offer this library again. You can add it later in Models & Storage settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark no volverá a ofrecer esta biblioteca. Puedes añadirla más tarde en los ajustes de «Modelos y almacenamiento»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ne proposera plus cette bibliothèque. Vous pourrez l'ajouter plus tard dans les réglages « Modèles et stockage »."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark לא יציע את הספרייה הזו שוב. אפשר להוסיף אותה בהמשך בהגדרות \"מודלים ואחסון\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark यह लाइब्रेरी दोबारा नहीं सुझाएगा। आप इसे बाद में सेटिंग में “मॉडल और संग्रहण” से जोड़ सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark tidak akan menawarkan pustaka ini lagi. Anda dapat menambahkannya nanti di pengaturan “Model & Penyimpanan”."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark non proporrà più questa libreria. Puoi aggiungerla in seguito nelle impostazioni «Modelli e archiviazione»."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSparkはこのライブラリを再度提案しません。あとから設定の「モデルとストレージ」で追加できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark에서 이 라이브러리를 다시 제안하지 않습니다. 나중에 설정의 '모델 및 저장 공간'에서 추가할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark biedt deze bibliotheek niet opnieuw aan. Je kunt deze later toevoegen in de instellingen onder ‘Modellen en opslag’."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark nie zaproponuje ponownie tej biblioteki. Możesz ją dodać później w ustawieniach „Modele i pamięć”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O TurboSpark não oferecerá esta biblioteca novamente. Você pode adicioná-la depois nos ajustes de “Modelos e armazenamento”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark больше не будет предлагать эту библиотеку. Позже её можно добавить в настройках, в разделе «Модели и хранилище»."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark erbjuder inte det här biblioteket igen. Du kan lägga till det senare i inställningarna under ”Modeller och lagring”."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark bu kitaplığı bir daha önermeyecek. Daha sonra ayarlardaki “Modeller ve Depolama” bölümünden ekleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark більше не пропонуватиме цю бібліотеку. Пізніше її можна додати в налаштуваннях, у розділі «Моделі та сховище»."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark sẽ không đề xuất thư viện này nữa. Bạn có thể thêm sau trong phần cài đặt “Mô hình và lưu trữ”."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 不会再提供此模型库。你以后可以在设置的“模型与存储”中添加。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 不會再提供此模型庫。你之後可以在設定的「模型與儲存空間」中加入。"
          }
        }
      }
    },
    "Turn a recording into editable text and subtitles.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
