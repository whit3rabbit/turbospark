    "Toggles tool-call guardrails for this context": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0628\u062f\u0651\u0644 \u062d\u0648\u0627\u062c\u0632 \u0627\u0633\u062a\u062f\u0639\u0627\u0621 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0644\u0647\u0630\u0627 \u0627\u0644\u0633\u064a\u0627\u0642"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schaltet Guardrails f\u00fcr Tool-Aufrufe in diesem Kontext um"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Toggles tool-call guardrails for this context"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa o desactiva los guardrails de llamadas a herramientas en este contexto"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active ou d\u00e9sactive les guardrails d'appels d'outils dans ce contexte"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e4\u05e2\u05d9\u05dc \u05d0\u05d5 \u05de\u05db\u05d1\u05d4 Guardrails \u05dc\u05e7\u05e8\u05d9\u05d0\u05d5\u05ea \u05db\u05dc\u05d9\u05dd \u05d1\u05d4\u05e7\u05e9\u05e8 \u05d6\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u0902\u0926\u0930\u094d\u092d \u0915\u0947 \u0932\u093f\u090f \u091f\u0942\u0932-\u0915\u0949\u0932 \u0917\u093e\u0930\u094d\u0921\u0930\u0947\u0932 \u091a\u093e\u0932\u0942 \u092f\u093e \u092c\u0902\u0926 \u0915\u0930\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengaktifkan atau menonaktifkan guardrails panggilan alat untuk konteks ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva o disattiva i guardrails delle chiamate agli strumenti in questo contesto"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u306e\u30c4\u30fc\u30eb\u547c\u3073\u51fa\u3057\u30ac\u30fc\u30c9\u30ec\u30fc\u30eb\u3092\u5207\u308a\u66ff\u3048\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ucee8\ud14d\uc2a4\ud2b8\uc758 \ub3c4\uad6c \ud638\ucd9c \uac00\ub4dc\ub808\uc77c\uc744 \ucf1c\uac70\ub098 \ub055\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schakelt guardrails voor toolaanroepen in deze context in of uit"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prze\u0142\u0105cza guardrails wywo\u0142a\u0144 narz\u0119dzi w tym kontek\u015bcie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativa ou desativa os guardrails de chamadas de ferramentas neste contexto"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442 guardrails \u0432\u044b\u0437\u043e\u0432\u043e\u0432 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sl\u00e5r av eller p\u00e5 guardrails f\u00f6r verktygsanrop i den h\u00e4r kontexten"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ba\u011flam i\u00e7in ara\u00e7 \u00e7a\u011fr\u0131s\u0131 korumalar\u0131n\u0131 a\u00e7ar veya kapat\u0131r"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0454 guardrails \u0432\u0438\u043a\u043b\u0438\u043a\u0456\u0432 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1eadt ho\u1eb7c t\u1eaft guardrails l\u1ec7nh g\u1ecdi c\u00f4ng c\u1ee5 cho ng\u1eef c\u1ea3nh n\u00e0y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5207\u6362\u6b64\u4e0a\u4e0b\u6587\u7684\u5de5\u5177\u8c03\u7528\u62a4\u680f"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5207\u63db\u6b64\u4e0a\u4e0b\u6587\u7684\u5de5\u5177\u547c\u53eb\u8b77\u6b04"
          }
        }
      }
    },
