            "value": "\u05d4\u05e1\u05d5\u05db\u05df \"%@\" \u05e0\u05d5\u05e6\u05e8 \u05d1\u05d4\u05d9\u05e7\u05e3 %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u091c\u0947\u0902\u091f '%@' %@ \u0938\u094d\u0915\u094b\u092a \u092e\u0947\u0902 \u092c\u0928\u093e\u092f\u093e \u0917\u092f\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Agen '%@' dibuat dalam cakupan %@."
          }
        },
        "it": {
