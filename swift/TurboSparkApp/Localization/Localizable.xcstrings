    "A model with this name is already installed in another place. Move it from there instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يوجد نموذج بهذا الاسم مثبَّت بالفعل في مكان آخر. انقله من هناك بدلًا من ذلك."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Modell mit diesem Namen ist bereits an einem anderen Ort installiert. Verschieben Sie es stattdessen von dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A model with this name is already installed in another place. Move it from there instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un modelo con este nombre instalado en otro lugar. Muévelo desde allí en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle portant ce nom est déjà installé à un autre emplacement. Déplacez-le plutôt depuis cet endroit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מודל בשם הזה כבר מותקן במקום אחר. העבר אותו משם במקום זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस नाम का एक मॉडल किसी दूसरी जगह पहले से इंस्टॉल है। इसके बजाय उसे वहाँ से स्थानांतरित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model dengan nama ini sudah terpasang di tempat lain. Pindahkan dari sana saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello con questo nome è già installato in un altro posto. Spostalo da lì."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この名前のモデルはすでに別の場所にインストールされています。代わりにそこから移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 이름의 모델이 이미 다른 곳에 설치되어 있습니다. 대신 그곳에서 이동하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is al een model met deze naam op een andere plek geïnstalleerd. Verplaats het in plaats daarvan vanaf daar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model o tej nazwie jest już zainstalowany w innym miejscu. Przenieś go stamtąd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já existe um modelo com este nome instalado em outro lugar. Mova-o de lá."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель с таким именем уже установлена в другом месте. Вместо этого переместите её оттуда."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En modell med det här namnet är redan installerad på en annan plats. Flytta den därifrån i stället."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ada sahip bir model zaten başka bir yerde kurulu. Bunun yerine onu oradan taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель із цією назвою вже встановлено в іншому місці. Натомість перемістіть її звідти."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một mô hình có tên này đã được cài đặt ở nơi khác. Hãy di chuyển nó từ đó thay vì cài mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有同名模型安装在其他位置。请改为从那里移动它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
