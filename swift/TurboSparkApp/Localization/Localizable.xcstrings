        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f1a\u8a71\u3092\u307e\u305f\u3044\u3067\u30e2\u30c7\u30eb\u304c\u8a18\u61b6\u3059\u308b\u3053\u3068\u3092\u8a31\u53ef"
