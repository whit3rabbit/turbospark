    "Leave empty for the default tool set.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u0627 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0645\u062c\u0645\u0648\u0639\u0629 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den Standard-Toolsatz zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty for the default tool set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9jalo vac\u00edo para usar el conjunto de herramientas predeterminado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour utiliser l'ensemble d'outils par d\u00e9faut."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05d0\u05e8 \u05e8\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05e2\u05e8\u05db\u05ea \u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05db\u05d1\u05e8\u05d9\u05e8\u05ea \u05de\u05d7\u05d3\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u093f\u092b\u093c\u0949\u0932\u094d\u091f \u091f\u0942\u0932 \u0938\u0947\u091f \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk set alat default."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per usare il set di strumenti predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e2\u5b9a\u306e\u30c4\u30fc\u30eb\u30bb\u30c3\u30c8\u3092\u4f7f\u7528\u3059\u308b\u5834\u5408\u306f\u7a7a\u306e\u307e\u307e\u306b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae30\ubcf8 \ub3c4\uad6c \uc138\ud2b8\ub97c \uc0ac\uc6a9\ud558\ub824\uba74 \ube44\uc6cc \ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg voor de standaardset tools."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby u\u017cy\u0107 domy\u015blnego zestawu narz\u0119dzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para usar o conjunto de ferramentas padr\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c, \u0447\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0439 \u043d\u0430\u0431\u043e\u0440 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4mna tomt f\u00f6r standardupps\u00e4ttningen av verktyg."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varsay\u0131lan ara\u00e7 k\u00fcmesi i\u00e7in bo\u015f b\u0131rak\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c, \u0449\u043e\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0442\u0438 \u0442\u0438\u043f\u043e\u0432\u0438\u0439 \u043d\u0430\u0431\u0456\u0440 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ec3 tr\u1ed1ng \u0111\u1ec3 d\u00f9ng b\u1ed9 c\u00f4ng c\u1ee5 m\u1eb7c \u0111\u1ecbnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7559\u7a7a\u4ee5\u4f7f\u7528\u9ed8\u8ba4\u5de5\u5177\u96c6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7559\u7a7a\u4ee5\u4f7f\u7528\u9810\u8a2d\u5de5\u5177\u96c6\u3002"
          }
        }
      }
    },
    "Leave empty to launch the server in the active project's root.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062a\u0631\u0643\u0647 \u0641\u0627\u0631\u063a\u0627 \u0644\u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062e\u0627\u062f\u0645 \u0641\u064a \u062c\u0630\u0631 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0627\u0644\u0646\u0634\u0637."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leer lassen, um den Server im Stammverzeichnis des aktiven Projekts zu starten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave empty to launch the server in the active project's root."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9jalo vac\u00edo para iniciar el servidor en la ra\u00edz del proyecto activo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez vide pour lancer le serveur \u00e0 la racine du projet actif."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05d0\u05e8 \u05e8\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d4\u05e9\u05e8\u05ea \u05d1\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05e9\u05d5\u05e8\u05e9 \u05e9\u05dc \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05e4\u05e2\u05d9\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0915\u094d\u0930\u093f\u092f \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0940 \u0930\u0942\u091f \u092e\u0947\u0902 \u0938\u0930\u094d\u0935\u0930 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan kosong untuk menjalankan server di root proyek aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuoto per avviare il server nella radice del progetto attivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30af\u30c6\u30a3\u30d6\u306a\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u30eb\u30fc\u30c8\u3067\u30b5\u30fc\u30d0\u30fc\u3092\u8d77\u52d5\u3059\u308b\u5834\u5408\u306f\u7a7a\u306e\u307e\u307e\u306b\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud65c\uc131 \ud504\ub85c\uc81d\ud2b8\uc758 \ub8e8\ud2b8\uc5d0\uc11c \uc11c\ubc84\ub97c \uc2e4\ud589\ud558\ub824\uba74 \ube44\uc6cc \ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat leeg om de server te starten in de hoofdmap van het actieve project."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostaw puste, aby uruchomi\u0107 serwer w katalogu g\u0142\u00f3wnym aktywnego projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deixe em branco para iniciar o servidor na raiz do projeto ativo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u043f\u0443\u0441\u0442\u044b\u043c, \u0447\u0442\u043e\u0431\u044b \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c \u0441\u0435\u0440\u0432\u0435\u0440 \u0432 \u043a\u043e\u0440\u043d\u0435 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4mna tomt f\u00f6r att starta servern i det aktiva projektets rotkatalog."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuyu etkin projenin k\u00f6k\u00fcnde ba\u015flatmak i\u00e7in bo\u015f b\u0131rak\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043b\u0438\u0448\u0442\u0435 \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c, \u0449\u043e\u0431 \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 \u0441\u0435\u0440\u0432\u0435\u0440 \u0443 \u043a\u043e\u0440\u0435\u043d\u0456 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0454\u043a\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ec3 tr\u1ed1ng \u0111\u1ec3 kh\u1edfi ch\u1ea1y m\u00e1y ch\u1ee7 t\u1ea1i th\u01b0 m\u1ee5c g\u1ed1c c\u1ee7a d\u1ef1 \u00e1n \u0111ang ho\u1ea1t \u0111\u1ed9ng."
          }
        },
        "zh-Hans": {
