          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face\uac00 \uc798\ubabb\ub41c \ub2e4\uc6b4\ub85c\ub4dc \uc751\ub2f5\uc744 \ubc18\ud658\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face heeft een ongeldig downloadantwoord teruggegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face zwr\u00f3ci\u0142 nieprawid\u0142ow\u0105 odpowied\u017a pobierania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hugging Face retornou uma resposta de download inv\u00e1lida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u0432\u0435\u0440\u043d\u0443\u043b \u043d\u0435\u0434\u043e\u043f\u0443\u0441\u0442\u0438\u043c\u044b\u0439 \u043e\u0442\u0432\u0435\u0442 \u043d\u0430 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face returnerade ett ogiltigt nedladdningssvar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face ge\u00e7ersiz bir indirme yan\u0131t\u0131 d\u00f6nd\u00fcrd\u00fc."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0432 \u043d\u0435\u043f\u0440\u0438\u043f\u0443\u0441\u0442\u0438\u043c\u0443 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u043d\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u0111\u00e3 tr\u1ea3 v\u1ec1 ph\u1ea3n h\u1ed3i t\u1ea3i xu\u1ed1ng kh\u00f4ng h\u1ee3p l\u1ec7."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u8fd4\u56de\u4e86\u65e0\u6548\u7684\u4e0b\u8f7d\u54cd\u5e94\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u50b3\u56de\u4e86\u7121\u6548\u7684\u4e0b\u8f09\u56de\u61c9\u3002"
          }
        }
      }
    },
    "Hugging Face denied this file. Sign in under Settings > Models if it is gated.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0631\u0641\u0636 Hugging Face \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0645\u0642\u064a\u0651\u062f \u0627\u0644\u0648\u0635\u0648\u0644\u060c \u0641\u0633\u062c\u0651\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a > \u0627\u0644\u0646\u0645\u0627\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face hat diese Datei verweigert. Wenn sie zugangsbeschr\u00e4nkt ist, melden Sie sich unter Einstellungen > Modelle an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face denied this file. Sign in under Settings > Models if it is gated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face deneg\u00f3 este archivo. Si tiene acceso restringido, inicia sesi\u00f3n en Ajustes > Modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face a refus\u00e9 ce fichier. S'il est \u00e0 acc\u00e8s restreint, connectez-vous dans Param\u00e8tres > Mod\u00e8les."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u05d3\u05d7\u05d4 \u05d0\u05ea \u05d4\u05e7\u05d5\u05d1\u05e5 \u05d4\u05d6\u05d4. \u05d0\u05dd \u05d4\u05d2\u05d9\u05e9\u05d4 \u05d0\u05dc\u05d9\u05d5 \u05de\u05d5\u05d2\u05d1\u05dc\u05ea, \u05d4\u05ea\u05d7\u05d1\u05e8 \u05d3\u05e8\u05da \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea > \u05de\u05d5\u05d3\u05dc\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u0928\u0947 \u0907\u0938 \u092b\u093c\u093e\u0907\u0932 \u0915\u094b \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u093f\u092f\u093e\u0964 \u092f\u0926\u093f \u092f\u0939 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0939\u0948, \u0924\u094b \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u092e\u0949\u0921\u0932 \u092e\u0947\u0902 \u0938\u093e\u0907\u0928 \u0907\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face menolak file ini. Jika aksesnya dibatasi, masuk di Pengaturan > Model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face ha negato questo file. Se \u00e8 ad accesso limitato, accedi in Impostazioni > Modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u304c\u3053\u306e\u30d5\u30a1\u30a4\u30eb\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u62d2\u5426\u3057\u307e\u3057\u305f\u3002\u5236\u9650\u4ed8\u304d\u306e\u5834\u5408\u306f\u3001\u8a2d\u5b9a > \u30e2\u30c7\u30eb \u3067\u30b5\u30a4\u30f3\u30a4\u30f3\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face\uac00 \uc774 \ud30c\uc77c\uc744 \uac70\ubd80\ud588\uc2b5\ub2c8\ub2e4. \uc811\uadfc\uc774 \uc81c\ud55c\ub41c \uacbd\uc6b0 \uc124\uc815 > \ubaa8\ub378\uc5d0\uc11c \ub85c\uadf8\uc778\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face heeft dit bestand geweigerd. Als het afgeschermd is, log dan in via Instellingen > Modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face odm\u00f3wi\u0142 dost\u0119pu do tego pliku. Je\u015bli dost\u0119p jest ograniczony, zaloguj si\u0119 w Ustawienia > Modele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hugging Face negou este arquivo. Se ele for restrito, entre em Configura\u00e7\u00f5es > Modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u043e\u0442\u043a\u0430\u0437\u0430\u043b \u0432 \u0434\u043e\u0441\u0442\u0443\u043f\u0435 \u043a \u044d\u0442\u043e\u043c\u0443 \u0444\u0430\u0439\u043b\u0443. \u0415\u0441\u043b\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d, \u0432\u043e\u0439\u0434\u0438\u0442\u0435 \u0432 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 > \u041c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face nekade den h\u00e4r filen. Om den \u00e4r sp\u00e4rrad loggar du in under Inst\u00e4llningar > Modeller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face bu dosyay\u0131 reddetti. Eri\u015fimi k\u0131s\u0131tl\u0131ysa Ayarlar > Modeller b\u00f6l\u00fcm\u00fcnden oturum a\u00e7\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u0432\u0456\u0434\u043c\u043e\u0432\u0438\u0432 \u0443 \u0434\u043e\u0441\u0442\u0443\u043f\u0456 \u0434\u043e \u0446\u044c\u043e\u0433\u043e \u0444\u0430\u0439\u043b\u0443. \u042f\u043a\u0449\u043e \u0434\u043e\u0441\u0442\u0443\u043f \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043e, \u0443\u0432\u0456\u0439\u0434\u0456\u0442\u044c \u0443 \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 > \u041c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u0111\u00e3 t\u1eeb ch\u1ed1i t\u1ec7p n\u00e0y. N\u1ebfu t\u1ec7p b\u1ecb gi\u1edbi h\u1ea1n quy\u1ec1n truy c\u1eadp, h\u00e3y \u0111\u0103ng nh\u1eadp trong C\u00e0i \u0111\u1eb7t > M\u00f4 h\u00ecnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u62d2\u7edd\u4e86\u6b64\u6587\u4ef6\u3002\u5982\u679c\u5b83\u53d7\u8bbf\u95ee\u9650\u5236\uff0c\u8bf7\u5728\u201c\u8bbe\u7f6e > \u6a21\u578b\u201d\u4e2d\u767b\u5f55\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u62d2\u7d55\u4e86\u6b64\u6a94\u6848\u3002\u5982\u679c\u5b83\u53d7\u5b58\u53d6\u9650\u5236\uff0c\u8acb\u5728\u300c\u8a2d\u5b9a > \u6a21\u578b\u300d\u4e2d\u767b\u5165\u3002"
          }
        }
      }
    },
    "That repository, revision, or .gguf file was not found.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u0639\u062b\u0631 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u062a\u0648\u062f\u0639 \u0623\u0648 \u0627\u0644\u0645\u0631\u0627\u062c\u0639\u0629 \u0623\u0648 \u0645\u0644\u0641 .gguf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Repository, diese Revision oder diese .gguf-Datei wurde nicht gefunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That repository, revision, or .gguf file was not found."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontr\u00f3 ese repositorio, esa revisi\u00f3n o ese archivo .gguf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce d\u00e9p\u00f4t, cette r\u00e9vision ou ce fichier .gguf est introuvable."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d0\u05d2\u05e8, \u05d4\u05d2\u05e8\u05e1\u05d4 \u05d0\u05d5 \u05e7\u05d5\u05d1\u05e5 \u05d4-.gguf \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0939 \u0930\u093f\u092a\u0949\u091c\u093c\u093f\u091f\u0930\u0940, \u0938\u0902\u0936\u094b\u0927\u0928 \u092f\u093e .gguf \u092b\u093c\u093e\u0907\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Repositori, revisi, atau file .gguf tersebut tidak ditemukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Repository, revisione o file .gguf non trovato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u3001\u30ea\u30d3\u30b8\u30e7\u30f3\u3001\u307e\u305f\u306f .gguf \u30d5\u30a1\u30a4\u30eb\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud574\ub2f9 \uc800\uc7a5\uc18c, \ub9ac\ube44\uc804 \ub610\ub294 .gguf \ud30c\uc77c\uc744 \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die repository, revisie of dat .gguf-bestand is niet gevonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono tego repozytorium, rewizji ani pliku .gguf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse reposit\u00f3rio, revis\u00e3o ou arquivo .gguf n\u00e3o foi encontrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e\u0442 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0438\u0439, \u0440\u0435\u0432\u0438\u0437\u0438\u044f \u0438\u043b\u0438 \u0444\u0430\u0439\u043b .gguf \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u044b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00f6rr\u00e5det, revisionen eller .gguf-filen hittades inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu depo, revizyon veya .gguf dosyas\u0131 bulunamad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u0439 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0456\u0439, \u0440\u0435\u0432\u0456\u0437\u0456\u044e \u0430\u0431\u043e \u0444\u0430\u0439\u043b .gguf \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y kho l\u01b0u tr\u1eef, b\u1ea3n s\u1eeda \u0111\u1ed5i ho\u1eb7c t\u1ec7p .gguf \u0111\u00f3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u627e\u5230\u8be5\u4ed3\u5e93\u3001\u4fee\u8ba2\u7248\u672c\u6216 .gguf \u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u627e\u4e0d\u5230\u8a72\u5132\u5b58\u5eab\u3001\u4fee\u8a02\u7248\u672c\u6216 .gguf \u6a94\u6848\u3002"
          }
        }
      }
    },
