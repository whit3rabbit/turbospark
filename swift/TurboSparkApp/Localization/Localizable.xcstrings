    "Audio is no longer at its saved path": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0639\u062f \u0627\u0644\u0635\u0648\u062a \u0645\u0648\u062c\u0648\u062f\u064b\u0627 \u0641\u064a \u0645\u0633\u0627\u0631\u0647 \u0627\u0644\u0645\u062d\u0641\u0648\u0638"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Audio befindet sich nicht mehr am gespeicherten Pfad"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio is no longer at its saved path"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio ya no est\u00e1 en su ruta guardada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio n'est plus \u00e0 son emplacement enregistr\u00e9"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05de\u05e2 \u05db\u05d1\u05e8 \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0 \u05d1\u05e0\u05ea\u05d9\u05d1 \u05d4\u05e9\u05de\u05d5\u05e8 \u05e9\u05dc\u05d5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0911\u0921\u093f\u092f\u094b \u0905\u092c \u0905\u092a\u0928\u0947 \u0938\u0939\u0947\u091c\u0947 \u0917\u090f \u092a\u0925 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio tidak lagi berada di jalur tersimpannya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio non si trova pi\u00f9 nel percorso salvato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30aa\u30fc\u30c7\u30a3\u30aa\u306f\u4fdd\u5b58\u3055\u308c\u305f\u30d1\u30b9\u306b\u3082\u3046\u3042\u308a\u307e\u305b\u3093"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc624\ub514\uc624\uac00 \ub354 \uc774\uc0c1 \uc800\uc7a5\ub41c \uacbd\ub85c\uc5d0 \uc5c6\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De audio staat niet meer op het opgeslagen pad"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u017awi\u0119k nie znajduje si\u0119 ju\u017c w zapisanej \u015bcie\u017cce"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O \u00e1udio n\u00e3o est\u00e1 mais no caminho salvo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0434\u0438\u043e \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u043d\u0430\u0445\u043e\u0434\u0438\u0442\u0441\u044f \u043f\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u043c\u0443 \u043f\u0443\u0442\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljudet finns inte l\u00e4ngre p\u00e5 sin sparade s\u00f6kv\u00e4g"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses art\u0131k kay\u0131tl\u0131 yolunda de\u011fil"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0434\u0456\u043e \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435\u043c\u0430\u0454 \u0437\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u043c \u0448\u043b\u044f\u0445\u043e\u043c"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c2m thanh kh\u00f4ng c\u00f2n \u1edf \u0111\u01b0\u1eddng d\u1eabn \u0111\u00e3 l\u01b0u"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u9891\u5df2\u4e0d\u5728\u5176\u4fdd\u5b58\u7684\u8def\u5f84\u4e2d"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u8a0a\u5df2\u4e0d\u5728\u5176\u5132\u5b58\u7684\u8def\u5f91\u4e2d"
          }
        }
      }
    },
