            "state": "translated",
            "value": "Cosa vorresti costruire o esplorare?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que você gostaria de construir ou explorar?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что бы вы хотели создать или исследовать?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何を作成または探索したいですか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무엇을 만들거나 탐색하고 싶으신가요?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "您想构建或探索什么？"
          }
        },
