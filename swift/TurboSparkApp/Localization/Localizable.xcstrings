    "Apple voices are used until the TurboSpark engine has a voice model.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُستخدم أصوات Apple إلى أن يتوفر لمحرك TurboSpark نموذج صوتي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-Stimmen werden verwendet, bis die TurboSpark-Engine ein Sprachmodell hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple voices are used until the TurboSpark engine has a voice model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usan las voces de Apple hasta que el motor de TurboSpark tenga un modelo de voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les voix d'Apple sont utilisées tant que le moteur TurboSpark n'a pas de modèle vocal."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קולות של Apple משמשים עד שלמנוע TurboSpark יהיה מודל קול."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक TurboSpark इंजन के पास वॉइस मॉडल नहीं होता, तब तक Apple की आवाज़ें उपयोग की जाती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Suara Apple digunakan sampai mesin TurboSpark memiliki model suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le voci Apple vengono usate finché il motore TurboSpark non avrà un modello vocale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark エンジンに音声モデルが用意されるまでは、Apple の音声を使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark 엔진에 음성 모델이 생길 때까지 Apple 음성을 사용합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple-stemmen worden gebruikt totdat de TurboSpark-engine een stemmodel heeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Głosy Apple są używane, dopóki silnik TurboSpark nie będzie mieć modelu głosu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As vozes da Apple são usadas até que o mecanismo do TurboSpark tenha um modelo de voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Голоса Apple используются, пока у движка TurboSpark нет голосовой модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apples röster används tills TurboSpark-motorn har en röstmodell."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark motorunun bir ses modeli olana kadar Apple sesleri kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Голоси Apple використовуються, доки рушій TurboSpark не матиме голосової моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giọng Apple được dùng cho đến khi bộ máy TurboSpark có mô hình giọng nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 TurboSpark 引擎拥有语音模型之前，将使用 Apple 语音。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 TurboSpark 引擎擁有語音模型之前，將使用 Apple 語音。"
          }
        }
      }
    },
    "Applied at the next model load.": {
