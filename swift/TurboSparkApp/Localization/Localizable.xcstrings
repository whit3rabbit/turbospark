          "stringUnit": {
            "state": "translated",
            "value": "\u0631\u0627\u062c\u0639 \u0627\u0644\u0628\u0646\u064a\u0629 \u0627\u0644\u0645\u0639\u0645\u0627\u0631\u064a\u0629 \u0648\u0627\u0642\u062a\u0631\u062d \u062a\u062d\u0633\u064a\u0646\u0627\u062a"
