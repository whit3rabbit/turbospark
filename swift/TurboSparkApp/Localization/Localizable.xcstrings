        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0440\u043e\u0437\u043c\u043e\u0432\u0443, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438 \u0456\u0441\u0442\u043e\u0440\u0456\u044e \u0442\u0443\u0442"
          }
        },
        "vi": {
          "stringUnit": {
