    "Choose 1 to 30 seconds of reference speech.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0645\u0646 1 \u0625\u0644\u0649 30 \u062b\u0627\u0646\u064a\u0629 \u0645\u0646 \u0627\u0644\u0643\u0644\u0627\u0645 \u0627\u0644\u0645\u0631\u062c\u0639\u064a."
