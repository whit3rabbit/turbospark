    "Used when the tool approval mode is \"Agent (classifier)\"": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0639\u0646\u062f\u0645\u0627 \u064a\u0643\u0648\u0646 \u0648\u0636\u0639 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u062f\u0648\u0627\u062a \"\u0648\u0643\u064a\u0644 (\u0645\u0635\u0646\u0641)\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn der Tool-Genehmigungsmodus \"Agent (Klassifikator)\" ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when the tool approval mode is \"Agent (classifier)\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando el modo de aprobaci\u00f3n de herramientas es \"Agente (clasificador)\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilis\u00e9 lorsque le mode d'approbation des outils est \"Agent (classificateur)\""
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05e9\u05d9\u05de\u05d5\u05e9 \u05db\u05d0\u05e9\u05e8 \u05de\u05e6\u05d1 \u05d0\u05d9\u05e9\u05d5\u05e8 \u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05d5\u05d0 \"\u05e1\u05d5\u05db\u05df (\u05de\u05e1\u05d5\u05d5\u05d2)\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u092c \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u091c\u092c \u091f\u0942\u0932 \u0905\u0928\u0941\u092e\u094b\u0926\u0928 \u092e\u094b\u0921 \"\u090f\u091c\u0947\u0902\u091f (\u0915\u094d\u0932\u093e\u0938\u093f\u092b\u093c\u093e\u092f\u0930)\" \u0939\u094b"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan saat mode persetujuan alat adalah \"Agen (pengklasifikasi)\""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando la modalit\u00e0 di approvazione degli strumenti \u00e8 \"Agente (classificatore)\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c4\u30fc\u30eb\u627f\u8a8d\u30e2\u30fc\u30c9\u304c\u300c\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8 (\u5206\u985e\u5668)\u300d\u306e\u3068\u304d\u306b\u4f7f\u7528\u3055\u308c\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub3c4\uad6c \uc2b9\uc778 \ubaa8\ub4dc\uac00 \"\uc5d0\uc774\uc804\ud2b8(\ubd84\ub958\uae30)\"\uc77c \ub54c \uc0ac\uc6a9\ub429\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt wanneer de goedkeuringsmodus voor tools \"Agent (classificatie)\" is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cywane, gdy tryb zatwierdzania narz\u0119dzi to \"Agent (klasyfikator)\""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando o modo de aprova\u00e7\u00e3o de ferramentas \u00e9 \"Agente (classificador)\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u0440\u0435\u0436\u0438\u043c \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 - \"\u0410\u0433\u0435\u043d\u0442 (\u043a\u043b\u0430\u0441\u0441\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440)\""
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nds n\u00e4r verktygens godk\u00e4nnandel\u00e4ge \u00e4r \"Agent (klassificerare)\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ara\u00e7 onay kipi \"Arac\u0131 (s\u0131n\u0131fland\u0131r\u0131c\u0131)\" oldu\u011funda kullan\u0131l\u0131r"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u0440\u0435\u0436\u0438\u043c \u0441\u0445\u0432\u0430\u043b\u0435\u043d\u043d\u044f \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 - \"\u0410\u0433\u0435\u043d\u0442 (\u043a\u043b\u0430\u0441\u0438\u0444\u0456\u043a\u0430\u0442\u043e\u0440)\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u01b0\u1ee3c d\u00f9ng khi ch\u1ebf \u0111\u1ed9 ph\u00ea duy\u1ec7t c\u00f4ng c\u1ee5 l\u00e0 \"T\u00e1c nh\u00e2n (b\u1ed9 ph\u00e2n lo\u1ea1i)\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f53\u5de5\u5177\u6279\u51c6\u6a21\u5f0f\u4e3a\"\u4ee3\u7406 (\u5206\u7c7b\u5668)\"\u65f6\u4f7f\u7528"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7576\u5de5\u5177\u6838\u51c6\u6a21\u5f0f\u70ba\"\u4ee3\u7406 (\u5206\u985e\u5668)\"\u6642\u4f7f\u7528"
          }
        }
      }
    },
    "Useful for regions with restricted Hugging Face access, e.g. https://hf-mirror.com": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0641\u064a\u062f \u0641\u064a \u0627\u0644\u0645\u0646\u0627\u0637\u0642 \u0627\u0644\u062a\u064a \u064a\u0643\u0648\u0646 \u0641\u064a\u0647\u0627 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 Hugging Face \u0645\u0642\u064a\u062f\u0627\u060c \u0645\u062b\u0644 https://hf-mirror.com"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00fctzlich in Regionen mit eingeschr\u00e4nktem Zugriff auf Hugging Face, z. B. https://hf-mirror.com"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Useful for regions with restricted Hugging Face access, e.g. https://hf-mirror.com"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00datil en regiones con acceso restringido a Hugging Face, por ejemplo https://hf-mirror.com"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile dans les r\u00e9gions o\u00f9 l'acc\u00e8s \u00e0 Hugging Face est restreint, par ex. https://hf-mirror.com"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d9\u05de\u05d5\u05e9\u05d9 \u05d1\u05d0\u05d6\u05d5\u05e8\u05d9\u05dd \u05e9\u05d1\u05d4\u05dd \u05d4\u05d2\u05d9\u05e9\u05d4 \u05dc-Hugging Face \u05de\u05d5\u05d2\u05d1\u05dc\u05ea, \u05dc\u05de\u05e9\u05dc https://hf-mirror.com"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0928 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917\u0940 \u091c\u0939\u093e\u0902 Hugging Face \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0938\u0940\u092e\u093f\u0924 \u0939\u0948, \u091c\u0948\u0938\u0947 https://hf-mirror.com"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berguna untuk wilayah dengan akses Hugging Face yang dibatasi, mis. https://hf-mirror.com"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile nelle regioni con accesso limitato a Hugging Face, ad es. https://hf-mirror.com"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u3078\u306e\u30a2\u30af\u30bb\u30b9\u304c\u5236\u9650\u3055\u308c\u3066\u3044\u308b\u5730\u57df\u3067\u5f79\u7acb\u3061\u307e\u3059 (\u4f8b: https://hf-mirror.com)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \uc811\uadfc\uc774 \uc81c\ud55c\ub41c \uc9c0\uc5ed\uc5d0\uc11c \uc720\uc6a9\ud569\ub2c8\ub2e4. \uc608: https://hf-mirror.com"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handig in regio's met beperkte toegang tot Hugging Face, bijv. https://hf-mirror.com"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przydatne w regionach z ograniczonym dost\u0119pem do Hugging Face, np. https://hf-mirror.com"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00datil em regi\u00f5es com acesso restrito ao Hugging Face, por exemplo https://hf-mirror.com"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u0435\u0437\u043d\u043e \u0432 \u0440\u0435\u0433\u0438\u043e\u043d\u0430\u0445 \u0441 \u043e\u0433\u0440\u0430\u043d\u0438\u0447\u0435\u043d\u043d\u044b\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043e\u043c \u043a Hugging Face, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 https://hf-mirror.com"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4ndbart i regioner med begr\u00e4nsad \u00e5tkomst till Hugging Face, t.ex. https://hf-mirror.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face eri\u015fiminin k\u0131s\u0131tl\u0131 oldu\u011fu b\u00f6lgelerde yararl\u0131d\u0131r, \u00f6r. https://hf-mirror.com"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0440\u0438\u0441\u043d\u043e \u0432 \u0440\u0435\u0433\u0456\u043e\u043d\u0430\u0445 \u0437 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u0438\u043c \u0434\u043e\u0441\u0442\u0443\u043f\u043e\u043c \u0434\u043e Hugging Face, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 https://hf-mirror.com"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1eefu \u00edch \u1edf nh\u1eefng khu v\u1ef1c b\u1ecb h\u1ea1n ch\u1ebf truy c\u1eadp Hugging Face, v\u00ed d\u1ee5 https://hf-mirror.com"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9002\u7528\u4e8e Hugging Face \u8bbf\u95ee\u53d7\u9650\u7684\u5730\u533a\uff0c\u4f8b\u5982 https://hf-mirror.com"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9069\u7528\u65bc Hugging Face \u5b58\u53d6\u53d7\u9650\u7684\u5730\u5340\uff0c\u4f8b\u5982 https://hf-mirror.com"
          }
        }
      }
    },
