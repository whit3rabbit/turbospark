    "The file is no longer at its written path.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0639\u062f \u0627\u0644\u0645\u0644\u0641 \u0641\u064a \u0627\u0644\u0645\u0633\u0627\u0631 \u0627\u0644\u0630\u064a \u0643\u064f\u062a\u0628 \u0641\u064a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei liegt nicht mehr am Pfad, an den sie geschrieben wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is no longer at its written path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo ya no est\u00e1 en la ruta donde se escribi\u00f3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'est plus \u00e0 l'emplacement o\u00f9 il a \u00e9t\u00e9 \u00e9crit."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e7\u05d5\u05d1\u05e5 \u05db\u05d1\u05e8 \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0 \u05d1\u05e0\u05ea\u05d9\u05d1 \u05e9\u05d1\u05d5 \u05e0\u05db\u05ea\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092b\u093c\u093e\u0907\u0932 \u0905\u092c \u0909\u0938 \u092a\u0925 \u092a\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u091c\u0939\u093e\u0901 \u0909\u0938\u0947 \u0932\u093f\u0916\u093e \u0917\u092f\u093e \u0925\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File tidak lagi berada di jalur tempat ia ditulis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file non si trova pi\u00f9 nel percorso in cui \u00e8 stato scritto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d5\u30a1\u30a4\u30eb\u304c\u66f8\u304d\u8fbc\u307e\u308c\u305f\u5834\u6240\u306b\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud30c\uc77c\uc774 \ub354 \uc774\uc0c1 \uae30\ub85d\ub41c \uacbd\ub85c\uc5d0 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het bestand staat niet meer op het pad waar het is geschreven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliku nie ma ju\u017c w \u015bcie\u017cce, w kt\u00f3rej zosta\u0142 zapisany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo n\u00e3o est\u00e1 mais no caminho onde foi gravado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b\u0430 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0442 \u043f\u043e \u043f\u0443\u0442\u0438, \u043a\u0443\u0434\u0430 \u043e\u043d \u0431\u044b\u043b \u0437\u0430\u043f\u0438\u0441\u0430\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filen finns inte l\u00e4ngre p\u00e5 s\u00f6kv\u00e4gen d\u00e4r den skrevs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya art\u0131k yaz\u0131ld\u0131\u011f\u0131 yolda de\u011fil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b\u0443 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435\u043c\u0430\u0454 \u0437\u0430 \u0448\u043b\u044f\u0445\u043e\u043c, \u043a\u0443\u0434\u0438 \u0439\u043e\u0433\u043e \u0431\u0443\u043b\u043e \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ec7p kh\u00f4ng c\u00f2n \u1edf \u0111\u01b0\u1eddng d\u1eabn \u0111\u00e3 ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6587\u4ef6\u5df2\u4e0d\u5728\u5176\u5199\u5165\u7684\u8def\u5f84\u4e2d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
