    "The selected profile no longer has a Bookmarks file.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u0639\u062f \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0645\u062d\u062f\u062f \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0645\u0644\u0641 Bookmarks."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ausgew\u00e4hlte Profil enth\u00e4lt keine Bookmarks-Datei mehr."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selected profile no longer has a Bookmarks file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El perfil seleccionado ya no tiene un archivo Bookmarks."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le profil s\u00e9lectionn\u00e9 ne contient plus de fichier Bookmarks."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05e9\u05e0\u05d1\u05d7\u05e8 \u05d0\u05d9\u05df \u05e2\u05d5\u05d3 \u05e7\u05d5\u05d1\u05e5 Bookmarks."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0941\u0928\u0947 \u0917\u090f \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u0902 \u0905\u092c Bookmarks \u092b\u093c\u093e\u0907\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil yang dipilih tidak lagi memiliki file Bookmarks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il profilo selezionato non contiene pi\u00f9 un file Bookmarks."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u3057\u305f\u30d7\u30ed\u30d5\u30a3\u30fc\u30eb\u306b Bookmarks \u30d5\u30a1\u30a4\u30eb\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\ud55c \ud504\ub85c\ud544\uc5d0 Bookmarks \ud30c\uc77c\uc774 \ub354 \uc774\uc0c1 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geselecteerde profiel heeft geen Bookmarks-bestand meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany profil nie ma ju\u017c pliku Bookmarks."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O perfil selecionado n\u00e3o tem mais um arquivo Bookmarks."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u043c \u043f\u0440\u043e\u0444\u0438\u043b\u0435 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435\u0442 \u0444\u0430\u0439\u043b\u0430 Bookmarks."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den valda profilen har inte l\u00e4ngre n\u00e5gon Bookmarks-fil."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00e7ilen profilde art\u0131k Bookmarks dosyas\u0131 yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0432\u0438\u0431\u0440\u0430\u043d\u043e\u043c\u0443 \u043f\u0440\u043e\u0444\u0456\u043b\u0456 \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435\u043c\u0430\u0454 \u0444\u0430\u0439\u043b\u0443 Bookmarks."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ed3 s\u01a1 \u0111\u00e3 ch\u1ecdn kh\u00f4ng c\u00f2n t\u1ec7p Bookmarks."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u9009\u4e2a\u4eba\u8d44\u6599\u4e2d\u5df2\u6ca1\u6709 Bookmarks \u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6240\u9078\u500b\u4eba\u6a94\u6848\u4e2d\u5df2\u6c92\u6709 Bookmarks \u6a94\u6848\u3002"
          }
        }
