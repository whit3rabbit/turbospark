        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0935\u0947\u0915\u094d\u091f\u0930 \u0915\u0940 \u091a\u094c\u0921\u093c\u093e\u0908 %lld \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u0940 \u091a\u094c\u0921\u093c\u093e\u0908 %lld \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar vektor ini %lld, tetapi lebar model ini %lld."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo vettore ha larghezza %lld, ma questo modello ha larghezza %lld."
