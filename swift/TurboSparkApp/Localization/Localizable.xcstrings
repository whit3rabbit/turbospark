    "The selection is used when a model loads. A currently loaded session changes only after reload.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم استخدام التحديد عند تحميل النموذج. تتغير الجلسة المحملة حاليًا فقط بعد إعادة التحميل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl wird beim Laden eines Modells verwendet. Eine aktuell geladene Sitzung ändert sich erst nach dem Neuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection is used when a model loads. A currently loaded session changes only after reload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selección se usa al cargar un modelo. Una sesión cargada actualmente cambia solo después de recargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sélection est utilisée lors du chargement d'un modèle. Une session actuellement chargée ne change qu'après rechargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבחירה משמשת בעת טעינת מודל. הפעלה טעונה כעת משתנה רק לאחר טעינה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल लोड होने पर चयन का उपयोग किया जाता है। वर्तमान में लोड किया गया सत्र केवल पुनः लोड करने के बाद बदलता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan digunakan saat model dimuat. Sesi yang sedang dimuat hanya berubah setelah dimuat ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La selezione viene utilizzata quando viene caricato un modello. Una sessione attualmente caricata cambia solo dopo il ricaricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのロード時に選択が使用されます。現在ロードされているセッションは、再ロード後にのみ変更されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델이 로드될 때 선택 항목이 사용됩니다. 현재 로드된 세션은 다시 로드한 후에만 변경됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De selectie wordt gebruikt wanneer een model laadt. Een momenteel geladen sessie verandert pas na opnieuw laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybór jest używany podczas ładowania modelu. Aktualnie załadowana sesja zmienia się dopiero po ponownym załadowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A seleção é usada quando um modelo é carregado. Uma sessão carregada no momento muda apenas após o recarregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выбор применяется при загрузке модели. Текущая загруженная сессия изменится только после перезагрузки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valet används när en modell läses in. En för närvarande inläst session ändras först efter omläsning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seçim, bir model yüklendiğinde kullanılır. Şu anda yüklü olan oturum yalnızca yeniden yüklemeden sonra değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вибір використовується під час завантаження моделі. Поточний завантажений сеанс змінюється лише після перезавантаження."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lựa chọn được sử dụng khi mô hình tải. Phiên hiện đang tải chỉ thay đổi sau khi tải lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加载模型时会使用该选择。当前已加载的会话仅在重新加载后才会更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "載入模型時會使用該選擇。目前已載入的會話僅在重新載入後才會變更。"
          }
        }
      }
    },
    "The server could not release a model; it may still be serving %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر على الخادم تحرير نموذج؛ قد يظل يقدّم %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server konnte ein Modell nicht freigeben; möglicherweise stellt er %@ noch bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server could not release a model; it may still be serving %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no pudo liberar un modelo; puede que siga sirviendo %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n'a pas pu libérer un modèle ; il sert peut-être encore %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת לא הצליח לשחרר מודל; ייתכן שהוא עדיין מגיש את %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर एक मॉडल रिलीज़ नहीं कर सका; हो सकता है वह अभी भी %@ को सर्व कर रहा हो।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server tidak dapat melepaskan sebuah model; server mungkin masih menyajikan %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server non è riuscito a rilasciare un modello; potrebbe servire ancora %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サーバーがモデルを解放できませんでした。まだ %@ を提供している可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서버가 모델을 해제하지 못했습니다. 아직 %@을(를) 제공 중일 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server kon een model niet vrijgeven; mogelijk biedt hij %@ nog aan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer nie mógł zwolnić modelu; może nadal udostępniać %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor não conseguiu liberar um modelo; ele ainda pode estar servindo %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверу не удалось освободить модель; возможно, он всё ещё обслуживает %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern kunde inte frigöra en modell; den kanske fortfarande tillhandahåller %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucu bir modeli serbest bırakamadı; %@ hâlâ sunuluyor olabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Серверу не вдалося звільнити модель; можливо, він досі обслуговує %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Máy chủ không thể giải phóng một mô hình; có thể vẫn đang phục vụ %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器无法释放一个模型；它可能仍在为 %@ 提供服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "伺服器無法釋放一個模型；它可能仍在為 %@ 提供服務。"
          }
        }
      }
    },
