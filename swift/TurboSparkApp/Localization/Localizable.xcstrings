            "value": "\u05d9\u05d9\u05d1\u05d5\u05d0 \u05de\u05db\u05dc\u05d9 \u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05d0\u05d7\u05e8\u05d9\u05dd\u2026"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0928\u094d\u092f \u090f\u091c\u0947\u0902\u091f \u091f\u0942\u0932 \u0938\u0947 \u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902\u2026"
          }
