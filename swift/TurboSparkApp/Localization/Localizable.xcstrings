            "state": "translated",
            "value": "%@ може й надалі показувати цю модель у списку. Модель працює з нового місця."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ có thể vẫn liệt kê mô hình này. Mô hình hoạt động từ vị trí mới."
          }
        },
        "zh-Hans": {
