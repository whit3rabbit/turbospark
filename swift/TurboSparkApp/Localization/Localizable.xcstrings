        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ea\u30af\u30a8\u30b9\u30c8\u306b\u306f\u3053\u306e\u30ad\u30fc\u304c\u5fc5\u8981\u3067\u3059\u3002"
