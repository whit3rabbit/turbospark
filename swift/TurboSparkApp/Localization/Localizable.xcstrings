        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o h\u00e1 \u00e1udio para reproduzir ou exportar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen audio om af te spelen of te exporteren."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns inget ljud att spela upp eller exportera."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak d\u017awi\u0119ku do odtworzenia lub wyeksportowania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oynat\u0131lacak veya d\u0131\u015fa aktar\u0131lacak ses yok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada audio untuk diputar atau diekspor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u0430\u0443\u0434\u0438\u043e \u0434\u043b\u044f \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u044d\u043a\u0441\u043f\u043e\u0440\u0442\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0430\u0443\u0434\u0456\u043e \u0434\u043b\u044f \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0430\u0431\u043e \u0435\u043a\u0441\u043f\u043e\u0440\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 \u00e2m thanh \u0111\u1ec3 ph\u00e1t ho\u1eb7c xu\u1ea5t."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u518d\u751f\u307e\u305f\u306f\u66f8\u304d\u51fa\u3057\u3067\u304d\u308b\u97f3\u58f0\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc7ac\uc0dd\ud558\uac70\ub098 \ub0b4\ubcf4\ub0bc \uc624\ub514\uc624\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u53ef\u64ad\u653e\u6216\u5bfc\u51fa\u7684\u97f3\u9891\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u53ef\u64ad\u653e\u6216\u8f38\u51fa\u7684\u97f3\u8a0a\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0648\u062c\u062f \u0635\u0648\u062a \u0644\u062a\u0634\u063a\u064a\u0644\u0647 \u0623\u0648 \u062a\u0635\u062f\u064a\u0631\u0647."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05e9\u05de\u05e2 \u05dc\u05e0\u05d9\u05d2\u05d5\u05df \u05d0\u05d5 \u05dc\u05d9\u05d9\u05e6\u05d5\u05d0."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0932\u093e\u0928\u0947 \u092f\u093e \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0911\u0921\u093f\u092f\u094b \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        }
      }
    },
    "This audio window is too large. Process the recording in smaller sections.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This audio window is too large. Process the recording in smaller sections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ventana de audio es demasiado grande. Procesa la grabaci\u00f3n en secciones m\u00e1s peque\u00f1as."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette fen\u00eatre audio est trop grande. Traitez l'enregistrement par sections plus petites."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Audiofenster ist zu gro\u00df. Verarbeite die Aufnahme in kleineren Abschnitten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa finestra audio \u00e8 troppo grande. Elabora la registrazione in sezioni pi\u00f9 piccole."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta janela de \u00e1udio \u00e9 grande demais. Processe a grava\u00e7\u00e3o em se\u00e7\u00f5es menores."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit audiovenster is te groot. Verwerk de opname in kleinere secties."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det h\u00e4r ljudf\u00f6nstret \u00e4r f\u00f6r stort. Bearbeta inspelningen i mindre avsnitt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To okno audio jest zbyt du\u017ce. Przetwarzaj nagranie w mniejszych sekcjach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu ses penceresi \u00e7ok b\u00fcy\u00fck. Kayd\u0131 daha k\u00fc\u00e7\u00fck b\u00f6l\u00fcmler halinde i\u015fleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jendela audio ini terlalu besar. Proses rekaman dalam bagian yang lebih kecil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e \u0430\u0443\u0434\u0438\u043e\u043e\u043a\u043d\u043e \u0441\u043b\u0438\u0448\u043a\u043e\u043c \u0432\u0435\u043b\u0438\u043a\u043e. \u041e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u0439\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u044c \u043d\u0435\u0431\u043e\u043b\u044c\u0448\u0438\u043c\u0438 \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u043c\u0438."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435 \u0430\u0443\u0434\u0456\u043e\u0432\u0456\u043a\u043d\u043e \u0437\u0430\u0432\u0435\u043b\u0438\u043a\u0435. \u041e\u0431\u0440\u043e\u0431\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0441 \u043c\u0435\u043d\u0448\u0438\u043c\u0438 \u0440\u043e\u0437\u0434\u0456\u043b\u0430\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1eeda s\u1ed5 \u00e2m thanh n\u00e0y qu\u00e1 l\u1edbn. X\u1eed l\u00fd b\u1ea3n ghi theo c\u00e1c ph\u1ea7n nh\u1ecf h\u01a1n."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u97f3\u58f0\u30a6\u30a3\u30f3\u30c9\u30a6\u306f\u5927\u304d\u3059\u304e\u307e\u3059\u3002\u9332\u97f3\u3092\u5c0f\u3055\u306a\u30bb\u30af\u30b7\u30e7\u30f3\u306b\u5206\u3051\u3066\u51e6\u7406\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc624\ub514\uc624 \uad6c\uac04\uc774 \ub108\ubb34 \ud07d\ub2c8\ub2e4. \ub179\uc74c\uc744 \ub354 \uc791\uc740 \uc139\uc158\uc73c\ub85c \ucc98\ub9ac\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u97f3\u9891\u7a97\u53e3\u8fc7\u5927\u3002\u8bf7\u5c06\u5f55\u97f3\u5206\u6210\u8f83\u5c0f\u7684\u6bb5\u843d\u8fdb\u884c\u5904\u7406\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u97f3\u8a0a\u8996\u7a97\u904e\u5927\u3002\u8acb\u5c07\u9304\u97f3\u5206\u6210\u8f03\u5c0f\u7684\u6bb5\u843d\u8655\u7406\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0635\u0648\u062a \u0647\u0630\u0647 \u0643\u0628\u064a\u0631\u0629 \u062c\u062f\u0627\u064b. \u0639\u0627\u0644\u062c \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0641\u064a \u0623\u0642\u0633\u0627\u0645 \u0623\u0635\u063a\u0631."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05dc\u05d5\u05df \u05d4\u05e9\u05de\u05e2 \u05d4\u05d6\u05d4 \u05d2\u05d3\u05d5\u05dc \u05de\u05d3\u05d9. \u05e2\u05d1\u05d3 \u05d0\u05ea \u05d4\u05d4\u05e7\u05dc\u05d8\u05d4 \u05d1\u05de\u05e7\u05d8\u05e2\u05d9\u05dd \u05e7\u05d8\u05e0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0911\u0921\u093f\u092f\u094b \u0935\u093f\u0902\u0921\u094b \u092c\u0939\u0941\u0924 \u092c\u0921\u093c\u0940 \u0939\u0948\u0964 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0915\u094b \u091b\u094b\u091f\u0947 \u0916\u0902\u0921\u094b\u0902 \u092e\u0947\u0902 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
    "This operation cannot process the full recording. Choose a shorter source.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This operation cannot process the full recording. Choose a shorter source."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta operaci\u00f3n no puede procesar la grabaci\u00f3n completa. Elige una fuente m\u00e1s corta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette op\u00e9ration ne peut pas traiter l'enregistrement entier. Choisissez une source plus courte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Funktion kann die vollst\u00e4ndige Aufnahme nicht verarbeiten. W\u00e4hle eine k\u00fcrzere Quelle."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa operazione non pu\u00f2 elaborare l'intera registrazione. Scegli una sorgente pi\u00f9 breve."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta opera\u00e7\u00e3o n\u00e3o pode processar a grava\u00e7\u00e3o inteira. Escolha uma fonte mais curta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bewerking kan de volledige opname niet verwerken. Kies een kortere bron."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r \u00e5tg\u00e4rden kan inte bearbeta hela inspelningen. V\u00e4lj en kortare k\u00e4lla."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta operacja nie mo\u017ce przetworzy\u0107 ca\u0142ego nagrania. Wybierz kr\u00f3tsze \u017ar\u00f3d\u0142o."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu i\u015flem kayd\u0131n tamam\u0131n\u0131 i\u015fleyemiyor. Daha k\u0131sa bir kaynak se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi ini tidak dapat memproses seluruh rekaman. Pilih sumber yang lebih pendek."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u0442\u044c \u0432\u0441\u044e \u0437\u0430\u043f\u0438\u0441\u044c. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0431\u043e\u043b\u0435\u0435 \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u044f \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u044f \u043d\u0435 \u043c\u043e\u0436\u0435 \u043e\u0431\u0440\u043e\u0431\u0438\u0442\u0438 \u0432\u0435\u0441\u044c \u0437\u0430\u043f\u0438\u0441. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043a\u043e\u0440\u043e\u0442\u0448\u0435 \u0434\u0436\u0435\u0440\u0435\u043b\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao t\u00e1c n\u00e0y kh\u00f4ng th\u1ec3 x\u1eed l\u00fd to\u00e0n b\u1ed9 b\u1ea3n ghi. Ch\u1ecdn ngu\u1ed3n ng\u1eafn h\u01a1n."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u64cd\u4f5c\u3067\u306f\u9332\u97f3\u5168\u4f53\u3092\u51e6\u7406\u3067\u304d\u307e\u305b\u3093\u3002\u3088\u308a\u77ed\u3044\u30bd\u30fc\u30b9\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc791\uc5c5\uc740 \uc804\uccb4 \ub179\uc74c\uc744 \ucc98\ub9ac\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub354 \uc9e7\uc740 \uc18c\uc2a4\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u64cd\u4f5c\u65e0\u6cd5\u5904\u7406\u5b8c\u6574\u5f55\u97f3\u3002\u8bf7\u9009\u62e9\u8f83\u77ed\u7684\u6765\u6e90\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u64cd\u4f5c\u7121\u6cd5\u8655\u7406\u5b8c\u6574\u9304\u97f3\u3002\u8acb\u9078\u64c7\u8f03\u77ed\u7684\u4f86\u6e90\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0647\u0630\u0647 \u0627\u0644\u0639\u0645\u0644\u064a\u0629 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0628\u0627\u0644\u0643\u0627\u0645\u0644. \u0627\u062e\u062a\u0631 \u0645\u0635\u062f\u0631\u0627\u064b \u0623\u0642\u0635\u0631."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e2\u05d5\u05dc\u05d4 \u05d4\u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05e2\u05d1\u05d3 \u05d0\u05ea \u05d4\u05d4\u05e7\u05dc\u05d8\u05d4 \u05d4\u05de\u05dc\u05d0\u05d4. \u05d1\u05d7\u05e8 \u05de\u05e7\u05d5\u05e8 \u05e7\u05e6\u05e8 \u05d9\u05d5\u05ea\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908 \u092a\u0942\u0930\u0940 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0915\u094b \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u0940\u0964 \u091b\u094b\u091f\u093e \u0938\u094d\u0930\u094b\u0924 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
