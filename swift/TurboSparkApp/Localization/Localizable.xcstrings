        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05de\u05d5\u05d3\u05dc \u05ea\u05de\u05d5\u05e0\u05d4 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0930\u0902\u092d \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u090f\u0915 \u091b\u0935\u093f \u092e\u0949\u0921\u0932 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een afbeeldingsmodel in Instellingen om te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz model obrazu w Ustawieniach, aby rozpocz\u0105\u0107."
