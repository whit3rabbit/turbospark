    "Active servers are available to the assistant during turns in this project.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتوفر الخوادم النشطة للمساعد أثناء الأدوار في هذا المشروع."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktive Server stehen dem Assistenten während der Züge in diesem Projekt zur Verfügung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Active servers are available to the assistant during turns in this project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los servidores activos estan disponibles para el asistente durante los turnos de este proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les serveurs actifs sont disponibles pour l'assistant pendant les tours de ce projet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרתים פעילים זמינים לעוזר במהלך התורות בפרויקט הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय सर्वर इस प्रोजेक्ट के टर्न के दौरान असिस्टेंट के लिए उपलब्ध रहते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server aktif tersedia untuk asisten selama giliran dalam proyek ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I server attivi sono disponibili per l'assistente durante i turni di questo progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なサーバーは、このプロジェクトのターン中にアシスタントから利用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 서버는 이 프로젝트의 턴 동안 어시스턴트가 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Actieve servers zijn tijdens beurten in dit project beschikbaar voor de assistent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywne serwery są dostępne dla asystenta podczas tur w tym projekcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
