    "Not enough room in the %lld-token context window for pasted text.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u0633\u0627\u062d\u0629 \u0643\u0627\u0641\u064a\u0629 \u0641\u064a \u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0633\u064a\u0627\u0642 \u0627\u0644\u0628\u0627\u0644\u063a\u0629 %lld \u0631\u0645\u0632\u064b\u0627 \u0644\u0644\u0646\u0635 \u0627\u0644\u0645\u0644\u0635\u0642."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nicht genug Platz im %lld-Token-Kontextfenster f\u00fcr den eingef\u00fcgten Text."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough room in the %lld-token context window for pasted text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay suficiente espacio en la ventana de contexto de %lld tokens para el texto pegado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas assez de place dans la fen\u00eatre de contexte de %lld jetons pour le texte coll\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05de\u05e1\u05e4\u05d9\u05e7 \u05de\u05e7\u05d5\u05dd \u05d1\u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc %lld \u05d0\u05e1\u05d9\u05de\u05d5\u05e0\u05d9\u05dd \u05e2\u05d1\u05d5\u05e8 \u05d4\u05d8\u05e7\u05e1\u05d8 \u05e9\u05d4\u05d5\u05d3\u05d1\u05e7."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0947\u0938\u094d\u091f \u0915\u093f\u090f \u0917\u090f \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u0947 \u0932\u093f\u090f %lld-\u091f\u094b\u0915\u0928 \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u092e\u0947\u0902 \u092a\u0930\u094d\u092f\u093e\u092a\u094d\u0924 \u091c\u0917\u0939 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak cukup ruang di jendela konteks %lld token untuk teks yang ditempel."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spazio insufficiente nella finestra di contesto di %lld token per il testo incollato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cbc\u308a\u4ed8\u3051\u305f\u30c6\u30ad\u30b9\u30c8\u306b\u5bfe\u3057\u3066 %lld \u30c8\u30fc\u30af\u30f3\u306e\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u306b\u5341\u5206\u306a\u7a7a\u304d\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubd99\uc5ec\ub123\uc740 \ud14d\uc2a4\ud2b8\ub97c \ub2f4\uae30\uc5d0 %lld \ud1a0\ud070 \ucee8\ud14d\uc2a4\ud2b8 \ucc3d\uc5d0 \uacf5\uac04\uc774 \ubd80\uc871\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niet genoeg ruimte in het %lld-token contextvenster voor de geplakte tekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ma\u0142o miejsca w oknie kontekstu %lld token\u00f3w dla wklejonego tekstu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Espa\u00e7o insuficiente na janela de contexto de %lld tokens para o texto colado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u043e \u043c\u0435\u0441\u0442\u0430 \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u043c \u043e\u043a\u043d\u0435 \u043d\u0430 %lld \u0442\u043e\u043a\u0435\u043d\u043e\u0432 \u0434\u043b\u044f \u0432\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte tillr\u00e4ckligt med utrymme i kontextf\u00f6nstret p\u00e5 %lld token f\u00f6r den inklistrade texten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yap\u0131\u015ft\u0131r\u0131lan metin i\u00e7in %lld token ba\u011flam penceresinde yeterli alan yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0434\u043e\u0441\u0442\u0430\u0442\u043d\u044c\u043e \u043c\u0456\u0441\u0446\u044f \u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u043c\u0443 \u0432\u0456\u043a\u043d\u0456 \u043d\u0430 %lld \u0442\u043e\u043a\u0435\u043d\u0456\u0432 \u0434\u043b\u044f \u0432\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043e\u0433\u043e \u0442\u0435\u043a\u0441\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng \u0111\u1ee7 ch\u1ed7 trong c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh %lld token cho v\u0103n b\u1ea3n \u0111\u00e3 d\u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld \u4e2a token \u7684\u4e0a\u4e0b\u6587\u7a97\u53e3\u4e2d\u6ca1\u6709\u8db3\u591f\u7684\u7a7a\u95f4\u5bb9\u7eb3\u7c98\u8d34\u7684\u6587\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld \u500b token \u7684\u4e0a\u4e0b\u6587\u8996\u7a97\u4e2d\u6c92\u6709\u8db3\u5920\u7684\u7a7a\u9593\u5bb9\u7d0d\u8cbc\u4e0a\u7684\u6587\u5b57\u3002"
          }
        }
      }
    },
