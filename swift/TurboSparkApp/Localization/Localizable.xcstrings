        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc791\uc5c5\uc774 \uc2e4\ud589\ub418\ub294 \ub3d9\uc548 \uc560\ub2c8\uba54\uc774\uc158\ub429\ub2c8\ub2e4"
