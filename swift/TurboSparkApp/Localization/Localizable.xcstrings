    "Profile \"%@\" imported from backup. Switch to it to start using it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \"%@\" \u0645\u0646 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629. \u0628\u062f\u0651\u0644 \u0625\u0644\u064a\u0647 \u0644\u0628\u062f\u0621 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil \"%@\" aus Backup importiert. Wechseln Sie zu diesem Profil, um es zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile \"%@\" imported from backup. Switch to it to start using it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se import\u00f3 el perfil \"%@\" desde la copia de seguridad. Cambia a \u00e9l para empezar a usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil \"%@\" import\u00e9 depuis la sauvegarde. Basculez vers ce profil pour commencer \u00e0 l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \"%@\" \u05d9\u05d5\u05d1\u05d0 \u05de\u05d2\u05d9\u05d1\u05d5\u05d9. \u05e2\u05d1\u05d5\u05e8 \u05d0\u05dc\u05d9\u05d5 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \"%@\" \u092c\u0948\u0915\u0905\u092a \u0938\u0947 \u0906\u092f\u093e\u0924 \u0915\u0940 \u0917\u0908\u0964 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938 \u092a\u0930 \u0938\u094d\u0935\u093f\u091a \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil \"%@\" diimpor dari cadangan. Beralih ke profil ini untuk mulai menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo \"%@\" importato dal backup. Passa a questo profilo per iniziare a usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb \"%@\" \u3092\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u304b\u3089\u30a4\u30f3\u30dd\u30fc\u30c8\u3057\u307e\u3057\u305f\u3002\u4f7f\u7528\u3092\u958b\u59cb\u3059\u308b\u306b\u306f\u3001\u3053\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u5207\u308a\u66ff\u3048\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc31\uc5c5\uc5d0\uc11c \ud504\ub85c\ud544 \"%@\"\uc744(\ub97c) \uac00\uc838\uc654\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\ud558\ub824\uba74 \uc774 \ud504\ub85c\ud544\ub85c \uc804\ud658\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiel \"%@\" ge\u00efmporteerd uit back-up. Schakel ernaar over om het te gaan gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportowano profil \"%@\" z kopii zapasowej. Prze\u0142\u0105cz si\u0119 na niego, aby zacz\u0105\u0107 go u\u017cywa\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Perfil \"%@\" importado do backup. Mude para ele para come\u00e7ar a us\u00e1-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0444\u0438\u043b\u044c \"%@\" \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d \u0438\u0437 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0439 \u043a\u043e\u043f\u0438\u0438. \u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0438\u0442\u0435\u0441\u044c \u043d\u0430 \u043d\u0435\u0433\u043e, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c \u0440\u0430\u0431\u043e\u0442\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilen \"%@\" har importerats fr\u00e5n s\u00e4kerhetskopian. Byt till den f\u00f6r att b\u00f6rja anv\u00e4nda den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" profili yedekten i\u00e7e aktar\u0131ld\u0131. Kullanmaya ba\u015flamak i\u00e7in bu profile ge\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0444\u0456\u043b\u044c \"%@\" \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u043e \u0437 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0457 \u043a\u043e\u043f\u0456\u0457. \u041f\u0435\u0440\u0435\u0439\u0434\u0456\u0442\u044c \u043d\u0430 \u043d\u044c\u043e\u0433\u043e, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438 \u0440\u043e\u0431\u043e\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 nh\u1eadp h\u1ed3 s\u01a1 \"%@\" t\u1eeb b\u1ea3n sao l\u01b0u. H\u00e3y chuy\u1ec3n sang h\u1ed3 s\u01a1 n\u00e0y \u0111\u1ec3 b\u1eaft \u0111\u1ea7u s\u1eed d\u1ee5ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4ece\u5907\u4efd\u5bfc\u5165\u914d\u7f6e\u6863\u6848 \"%@\"\u3002\u5207\u6362\u5230\u8be5\u914d\u7f6e\u6863\u6848\u5373\u53ef\u5f00\u59cb\u4f7f\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5f9e\u5099\u4efd\u532f\u5165\u8a2d\u5b9a\u6a94 \"%@\"\u3002\u5207\u63db\u5230\u8a72\u8a2d\u5b9a\u6a94\u5373\u53ef\u958b\u59cb\u4f7f\u7528\u3002"
          }
        }
      }
    },
