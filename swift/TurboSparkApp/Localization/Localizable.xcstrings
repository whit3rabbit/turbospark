        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@ \u0938\u0947 \u092b\u093c\u093e\u0907\u0932\u094b\u0902 \u0915\u093e \u0938\u0902\u0926\u0930\u094d\u092d \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0916\u094b\u0932\u0947\u0902\u0964"
          }
