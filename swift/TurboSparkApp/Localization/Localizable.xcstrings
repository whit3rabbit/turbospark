    "Tool permissions allowed during execution of this skill.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0630\u0648\u0646\u0627\u062a \u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0645\u0633\u0645\u0648\u062d \u0628\u0647\u0627 \u0623\u062b\u0646\u0627\u0621 \u062a\u0646\u0641\u064a\u0630 \u0647\u0630\u0647 \u0627\u0644\u0645\u0647\u0627\u0631\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool-Berechtigungen, die w\u00e4hrend der Ausf\u00fchrung dieses Skills erlaubt sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool permissions allowed during execution of this skill."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permisos de herramientas autorizados durante la ejecuci\u00f3n de esta habilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisations d'outils accord\u00e9es pendant l'ex\u00e9cution de cette comp\u00e9tence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e8\u05e9\u05d0\u05d5\u05ea \u05d4\u05db\u05dc\u05d9\u05dd \u05d4\u05de\u05d5\u05ea\u05e8\u05d5\u05ea \u05d1\u05de\u05d4\u05dc\u05da \u05d4\u05d4\u05e8\u05e6\u05d4 \u05e9\u05dc \u05d4\u05de\u05d9\u05d5\u05de\u05e0\u05d5\u05ea \u05d4\u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u094d\u0915\u093f\u0932 \u0915\u0947 \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u0928 \u0915\u0947 \u0926\u094c\u0930\u093e\u0928 \u0905\u0928\u0941\u092e\u0924 \u091f\u0942\u0932 \u0905\u0928\u0941\u092e\u0924\u093f\u092f\u093e\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izin alat yang diperbolehkan selama eksekusi keterampilan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Permessi degli strumenti consentiti durante l'esecuzione di questa competenza."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30b9\u30ad\u30eb\u306e\u5b9f\u884c\u4e2d\u306b\u8a31\u53ef\u3055\u308c\u308b\u30c4\u30fc\u30eb\u6a29\u9650\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc2a4\ud0ac\uc744 \uc2e4\ud589\ud558\ub294 \ub3d9\uc548 \ud5c8\uc6a9\ub418\ub294 \ub3c4\uad6c \uad8c\ud55c\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toolmachtigingen die zijn toegestaan tijdens het uitvoeren van deze skill."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uprawnienia narz\u0119dzi dozwolone podczas wykonywania tej umiej\u0119tno\u015bci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permiss\u00f5es de ferramentas concedidas durante a execu\u00e7\u00e3o desta habilidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0430\u0437\u0440\u0435\u0448\u0435\u043d\u0438\u044f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432, \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044e\u0449\u0438\u0435 \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u0432\u044b\u043a\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktygsbeh\u00f6righeter som till\u00e5ts under k\u00f6rningen av den h\u00e4r f\u00e4rdigheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu becerinin y\u00fcr\u00fct\u00fclmesi s\u0131ras\u0131nda izin verilen ara\u00e7 izinleri."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0437\u0432\u043e\u043b\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u0449\u043e \u0434\u0456\u044e\u0442\u044c \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f \u0446\u0456\u0454\u0457 \u043d\u0430\u0432\u0438\u0447\u043a\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c quy\u1ec1n c\u00f4ng c\u1ee5 \u0111\u01b0\u1ee3c ph\u00e9p trong khi th\u1ef1c thi k\u1ef9 n\u0103ng n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6267\u884c\u6b64\u6280\u80fd\u671f\u95f4\u5141\u8bb8\u7684\u5de5\u5177\u6743\u9650\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u57f7\u884c\u6b64\u6280\u80fd\u671f\u9593\u5141\u8a31\u7684\u5de5\u5177\u6b0a\u9650\u3002"
          }
        }
      }
    },
