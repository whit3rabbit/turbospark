      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u0639\u0644\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u0635\u062f\u0631 \u0639\u0646 \u062e\u064a\u0627\u0631\u0627\u062a \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0636\u0628\u0637."
