    },
    "No control vector file set.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u062a\u0639\u064a\u064a\u0646 \u0645\u0644\u0641 \u0645\u062a\u062c\u0647 \u062a\u062d\u0643\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Steuerungsvektordatei festgelegt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No control vector file set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha establecido ning\u00fan archivo de vector de control."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun fichier de vecteur de contr\u00f4le d\u00e9fini."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05d4\u05d5\u05d2\u05d3\u05e8 \u05e7\u05d5\u05d1\u05e5 \u05d5\u05e7\u05d8\u05d5\u05e8 \u05d1\u05e7\u05e8\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0935\u0947\u0915\u094d\u091f\u0930 \u092b\u093c\u093e\u0907\u0932 \u0938\u0947\u091f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada file vektor kontrol."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun file di vettore di controllo impostato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5236\u5fa1\u30d9\u30af\u30c8\u30eb\u30d5\u30a1\u30a4\u30eb\u304c\u8a2d\u5b9a\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc81c\uc5b4 \ubca1\ud130 \ud30c\uc77c\uc774 \uc124\uc815\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen besturingsvectorbestand ingesteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono pliku wektora kontrolnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum arquivo de vetor de controle definido."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0435 \u0437\u0430\u0434\u0430\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kontrollvektorfil angiven."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrol vekt\u00f6r\u00fc dosyas\u0131 ayarlanmad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0424\u0430\u0439\u043b \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435 \u0437\u0430\u0434\u0430\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a \u0111\u1eb7t t\u1ec7p vect\u01a1 \u0111i\u1ec1u khi\u1ec3n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u8bbe\u7f6e\u63a7\u5236\u5411\u91cf\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u8a2d\u5b9a\u63a7\u5236\u5411\u91cf\u6a94\u6848\u3002"
          }
        }
      }
    },
    "This model's family does not dispatch the steering edit, so a control vector here would be refused at load.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0627\u0626\u0644\u0629 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0644\u0627 \u062a\u0646\u0641\u0651\u0630 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u062a\u0648\u062c\u064a\u0647\u060c \u0644\u0630\u0627 \u0633\u064a\u064f\u0631\u0641\u0636 \u0645\u062a\u062c\u0647 \u0627\u0644\u062a\u062d\u0643\u0645 \u0647\u0646\u0627 \u0639\u0646\u062f \u0627\u0644\u062a\u062d\u0645\u064a\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Familie dieses Modells f\u00fchrt die Steuerungs\u00e4nderung nicht aus, daher w\u00fcrde ein Steuerungsvektor hier beim Laden abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model's family does not dispatch the steering edit, so a control vector here would be refused at load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La familia de este modelo no aplica la edici\u00f3n de direccionamiento, as\u00ed que un vector de control se rechazar\u00eda al cargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La famille de ce mod\u00e8le n'applique pas la modification de guidage : un vecteur de contr\u00f4le serait donc refus\u00e9 au chargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e9\u05e4\u05d7\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d6\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05de\u05e4\u05e2\u05d9\u05dc\u05d4 \u05d0\u05ea \u05e2\u05e8\u05d9\u05db\u05ea \u05d4\u05d4\u05d9\u05d2\u05d5\u05d9, \u05d5\u05dc\u05db\u05df \u05d5\u05e7\u05d8\u05d5\u05e8 \u05d1\u05e7\u05e8\u05d4 \u05db\u05d0\u05df \u05d9\u05d9\u05d3\u05d7\u05d4 \u05d1\u05d8\u05e2\u05d9\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u093e \u092a\u0930\u093f\u0935\u093e\u0930 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u092c\u0926\u0932\u093e\u0935 \u0932\u093e\u0917\u0942 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u093e, \u0907\u0938\u0932\u093f\u090f \u092f\u0939\u093e\u0901 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0935\u0947\u0915\u094d\u091f\u0930 \u0932\u094b\u0921 \u0915\u0947 \u0938\u092e\u092f \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0939\u094b \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keluarga model ini tidak menjalankan edit pengarah, jadi vektor kontrol di sini akan ditolak saat dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La famiglia di questo modello non applica la modifica di guida, quindi un vettore di controllo verrebbe rifiutato al caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e2\u30c7\u30eb\u306e\u30d5\u30a1\u30df\u30ea\u30fc\u306f\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u306e\u7de8\u96c6\u3092\u5b9f\u884c\u3057\u306a\u3044\u305f\u3081\u3001\u3053\u3053\u3067\u306e\u5236\u5fa1\u30d9\u30af\u30c8\u30eb\u306f\u8aad\u307f\u8fbc\u307f\u6642\u306b\u62d2\u5426\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubaa8\ub378\uc758 \uacc4\uc5f4\uc740 \uc2a4\ud2f0\uc5b4\ub9c1 \ud3b8\uc9d1\uc744 \uc2e4\ud589\ud558\uc9c0 \uc54a\uc73c\ubbc0\ub85c \uc5ec\uae30\uc11c \uc81c\uc5b4 \ubca1\ud130\ub294 \ub85c\ub4dc \uc2dc \uac70\ubd80\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De familie van dit model voert de besturingsaanpassing niet uit, dus een besturingsvector zou hier bij het laden worden geweigerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rodzina tego modelu nie wykonuje edycji sterowania, wi\u0119c wektor kontrolny zosta\u0142by tu odrzucony podczas \u0142adowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A fam\u00edlia deste modelo n\u00e3o aplica a edi\u00e7\u00e3o de direcionamento, ent\u00e3o um vetor de controle seria recusado no carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u043c\u0435\u0439\u0441\u0442\u0432\u043e \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0435 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442 \u043f\u0440\u0430\u0432\u043a\u0443 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u0432\u0435\u043a\u0442\u043e\u0440 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0431\u0443\u0434\u0435\u0442 \u043e\u0442\u043a\u043b\u043e\u043d\u0451\u043d \u043f\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r modellens familj utf\u00f6r inte styrnings\u00e4ndringen, s\u00e5 en kontrollvektor skulle avvisas vid inl\u00e4sning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modelin ailesi y\u00f6nlendirme d\u00fczenlemesini uygulamaz, bu nedenle buradaki bir kontrol vekt\u00f6r\u00fc y\u00fcklemede reddedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0456\u043c\u0435\u0439\u0441\u0442\u0432\u043e \u0446\u0456\u0454\u0457 \u043c\u043e\u0434\u0435\u043b\u0456 \u043d\u0435 \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u0454 \u043f\u0440\u0430\u0432\u043a\u0443 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f, \u0442\u043e\u043c\u0443 \u0432\u0435\u043a\u0442\u043e\u0440 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u0431\u0443\u0434\u0435 \u0432\u0456\u0434\u0445\u0438\u043b\u0435\u043d\u043e \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ecd c\u1ee7a m\u00f4 h\u00ecnh n\u00e0y kh\u00f4ng th\u1ef1c hi\u1ec7n ch\u1ec9nh s\u1eeda \u0111i\u1ec1u h\u01b0\u1edbng, n\u00ean vect\u01a1 \u0111i\u1ec1u khi\u1ec3n \u1edf \u0111\u00e2y s\u1ebd b\u1ecb t\u1eeb ch\u1ed1i khi t\u1ea3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u7cfb\u5217\u4e0d\u6267\u884c\u8f6c\u5411\u7f16\u8f91\uff0c\u56e0\u6b64\u8fd9\u91cc\u7684\u63a7\u5236\u5411\u91cf\u4f1a\u5728\u52a0\u8f7d\u65f6\u88ab\u62d2\u7edd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u7cfb\u5217\u4e0d\u57f7\u884c\u5c0e\u5411\u7de8\u8f2f\uff0c\u56e0\u6b64\u9019\u88e1\u7684\u63a7\u5236\u5411\u91cf\u6703\u5728\u8f09\u5165\u6642\u88ab\u62d2\u7d55\u3002"
          }
        }
      }
    },
    "No steering preset selected. Add one in Settings > Safety and Steering.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u0627\u062e\u062a\u064a\u0627\u0631 \u0625\u0639\u062f\u0627\u062f \u062a\u0648\u062c\u064a\u0647 \u0645\u0633\u0628\u0642. \u0623\u0636\u0641 \u0648\u0627\u062d\u062f\u064b\u0627 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a > \u0627\u0644\u0623\u0645\u0627\u0646 \u0648\u0627\u0644\u062a\u0648\u062c\u064a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Steuerungsvorgabe ausgew\u00e4hlt. F\u00fcge eine unter Einstellungen > Sicherheit & Steuerung hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No steering preset selected. Add one in Settings > Safety and Steering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ning\u00fan preajuste de direccionamiento seleccionado. A\u00f1ade uno en Ajustes > Seguridad y direccionamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pr\u00e9r\u00e9glage de guidage s\u00e9lectionn\u00e9. Ajoutez-en un dans Param\u00e8tres > S\u00e9curit\u00e9 et guidage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d1\u05d7\u05e8\u05d4 \u05d4\u05d2\u05d3\u05e8\u05d4 \u05de\u05d5\u05d2\u05d3\u05e8\u05ea \u05de\u05e8\u05d0\u05e9 \u05dc\u05d4\u05d9\u05d2\u05d5\u05d9. \u05d4\u05d5\u05e1\u05e3 \u05d0\u05d7\u05ea \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea > \u05d1\u05d8\u05d9\u05d7\u05d5\u05ea \u05d5\u05d4\u05d9\u05d2\u05d5\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u091a\u0941\u0928\u093e \u0928\u0939\u0940\u0902 \u0917\u092f\u093e\u0964 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0914\u0930 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u092e\u0947\u0902 \u090f\u0915 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada preset pengarah yang dipilih. Tambahkan di Pengaturan > Keamanan dan Pengarah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun preset di guida selezionato. Aggiungine uno in Impostazioni > Sicurezza e guida."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u306e\u30d7\u30ea\u30bb\u30c3\u30c8\u304c\u9078\u629e\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u8a2d\u5b9a > \u5b89\u5168\u6027\u3068\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0 \u3067\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\ud55c \uc2a4\ud2f0\uc5b4\ub9c1 \ud504\ub9ac\uc14b\uc774 \uc5c6\uc2b5\ub2c8\ub2e4. \uc124\uc815 > \uc548\uc804 \ubc0f \uc2a4\ud2f0\uc5b4\ub9c1\uc5d0\uc11c \ucd94\uac00\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen besturingspreset geselecteerd. Voeg er een toe via Instellingen > Veiligheid en besturing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano ustawienia sterowania. Dodaj je w Ustawienia > Bezpiecze\u0144stwo i sterowanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma predefini\u00e7\u00e3o de direcionamento selecionada. Adicione uma em Configura\u00e7\u00f5es > Seguran\u00e7a e direcionamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0431\u043e\u0440 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u043e\u0432 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u043d\u0435 \u0432\u044b\u0431\u0440\u0430\u043d. \u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0435\u0433\u043e \u0432 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 > \u0411\u0435\u0437\u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u044c \u0438 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen f\u00f6rinst\u00e4llning f\u00f6r styrning har valts. L\u00e4gg till en under Inst\u00e4llningar > S\u00e4kerhet och styrning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00f6nlendirme \u00f6n ayar\u0131 se\u00e7ilmedi. Ayarlar > G\u00fcvenlik ve Y\u00f6nlendirme b\u00f6l\u00fcm\u00fcnden ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0431\u0456\u0440 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0456\u0432 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0435 \u0432\u0438\u0431\u0440\u0430\u043d\u043e. \u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u0439\u043e\u0433\u043e \u0432 \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 > \u0411\u0435\u0437\u043f\u0435\u043a\u0430 \u0439 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a ch\u1ecdn c\u1ea5u h\u00ecnh \u0111i\u1ec1u h\u01b0\u1edbng s\u1eb5n. H\u00e3y th\u00eam trong C\u00e0i \u0111\u1eb7t > An to\u00e0n v\u00e0 \u0111i\u1ec1u h\u01b0\u1edbng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u9009\u62e9\u8f6c\u5411\u9884\u8bbe\u3002\u8bf7\u5728 \u8bbe\u7f6e > \u5b89\u5168\u4e0e\u8f6c\u5411 \u4e2d\u6dfb\u52a0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u9078\u64c7\u5c0e\u5411\u9810\u8a2d\u3002\u8acb\u5728 \u8a2d\u5b9a > \u5b89\u5168\u8207\u5c0e\u5411 \u4e2d\u65b0\u589e\u3002"
          }
        }
      }
    },
    "This preset has no control vector file, so it would steer nothing.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u062d\u062a\u0648\u064a \u0647\u0630\u0627 \u0627\u0644\u0625\u0639\u062f\u0627\u062f \u0627\u0644\u0645\u0633\u0628\u0642 \u0639\u0644\u0649 \u0645\u0644\u0641 \u0645\u062a\u062c\u0647 \u062a\u062d\u0643\u0645\u060c \u0644\u0630\u0627 \u0644\u0646 \u064a\u0648\u062c\u0651\u0647 \u0623\u064a \u0634\u064a\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Vorgabe hat keine Steuerungsvektordatei und w\u00fcrde daher nichts steuern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preset has no control vector file, so it would steer nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este preajuste no tiene archivo de vector de control, as\u00ed que no dirigir\u00eda nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce pr\u00e9r\u00e9glage n'a pas de fichier de vecteur de contr\u00f4le : il n'orienterait donc rien."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d4\u05d2\u05d3\u05e8\u05d4 \u05d6\u05d5 \u05d0\u05d9\u05df \u05e7\u05d5\u05d1\u05e5 \u05d5\u05e7\u05d8\u05d5\u05e8 \u05d1\u05e7\u05e8\u05d4, \u05d5\u05dc\u05db\u05df \u05d4\u05d9\u05d0 \u05dc\u05d0 \u05ea\u05db\u05d5\u05d5\u05df \u05d3\u05d1\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092a\u094d\u0930\u0940\u0938\u0947\u091f \u092e\u0947\u0902 \u0915\u094b\u0908 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0935\u0947\u0915\u094d\u091f\u0930 \u092b\u093c\u093e\u0907\u0932 \u0928\u0939\u0940\u0902 \u0939\u0948, \u0907\u0938\u0932\u093f\u090f \u092f\u0939 \u0915\u0941\u091b \u092d\u0940 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0947\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Preset ini tidak memiliki file vektor kontrol, jadi tidak akan mengarahkan apa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo preset non ha un file di vettore di controllo, quindi non orienterebbe nulla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ea\u30bb\u30c3\u30c8\u306b\u306f\u5236\u5fa1\u30d9\u30af\u30c8\u30eb\u30d5\u30a1\u30a4\u30eb\u304c\u306a\u3044\u305f\u3081\u3001\u4f55\u3082\u8a98\u5c0e\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub9ac\uc14b\uc5d0\ub294 \uc81c\uc5b4 \ubca1\ud130 \ud30c\uc77c\uc774 \uc5c6\uc73c\ubbc0\ub85c \uc544\ubb34\uac83\ub3c4 \uc870\uc815\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze preset heeft geen besturingsvectorbestand en zou dus niets sturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ustawienie nie ma pliku wektora kontrolnego, wi\u0119c niczego by nie sterowa\u0142o."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta predefini\u00e7\u00e3o n\u00e3o tem arquivo de vetor de controle, ent\u00e3o n\u00e3o direcionaria nada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u044d\u0442\u043e\u0433\u043e \u043d\u0430\u0431\u043e\u0440\u0430 \u043d\u0435\u0442 \u0444\u0430\u0439\u043b\u0430 \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f, \u043f\u043e\u044d\u0442\u043e\u043c\u0443 \u043e\u043d \u043d\u0438 \u043d\u0430 \u0447\u0442\u043e \u043d\u0435 \u043f\u043e\u0432\u043b\u0438\u044f\u0435\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r f\u00f6rinst\u00e4llningen har ingen kontrollvektorfil och skulle d\u00e4rf\u00f6r inte styra n\u00e5got."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu \u00f6n ayar\u0131n kontrol vekt\u00f6r\u00fc dosyas\u0131 yok, bu y\u00fczden hi\u00e7bir \u015feyi y\u00f6nlendirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0446\u044c\u043e\u0433\u043e \u043d\u0430\u0431\u043e\u0440\u0443 \u043d\u0435\u043c\u0430\u0454 \u0444\u0430\u0439\u043b\u0443 \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u043a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f, \u0442\u043e\u043c\u0443 \u0432\u0456\u043d \u043d\u0456 \u043d\u0430 \u0449\u043e \u043d\u0435 \u0432\u043f\u043b\u0438\u043d\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1ea5u h\u00ecnh s\u1eb5n n\u00e0y kh\u00f4ng c\u00f3 t\u1ec7p vect\u01a1 \u0111i\u1ec1u khi\u1ec3n n\u00ean s\u1ebd kh\u00f4ng \u0111i\u1ec1u h\u01b0\u1edbng g\u00ec."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u9884\u8bbe\u6ca1\u6709\u63a7\u5236\u5411\u91cf\u6587\u4ef6\uff0c\u56e0\u6b64\u4e0d\u4f1a\u5f15\u5bfc\u4efb\u4f55\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u9810\u8a2d\u6c92\u6709\u63a7\u5236\u5411\u91cf\u6a94\u6848\uff0c\u56e0\u6b64\u4e0d\u6703\u5f15\u5c0e\u4efb\u4f55\u5167\u5bb9\u3002"
          }
        }
      }
    },
    "Vector is %lld wide, this model is %lld. It would be refused at load.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0631\u0636 \u0627\u0644\u0645\u062a\u062c\u0647 %lld\u060c \u0648\u0639\u0631\u0636 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c %lld. \u0633\u064a\u064f\u0631\u0641\u0636 \u0639\u0646\u062f \u0627\u0644\u062a\u062d\u0645\u064a\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vektor ist %lld breit, dieses Modell %lld. Er w\u00fcrde beim Laden abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vector is %lld wide, this model is %lld. It would be refused at load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vector tiene una anchura de %lld y este modelo de %lld. Se rechazar\u00eda al cargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vecteur a une largeur de %lld, ce mod\u00e8le de %lld. Il serait refus\u00e9 au chargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e8\u05d5\u05d7\u05d1 \u05d4\u05d5\u05d5\u05e7\u05d8\u05d5\u05e8 %lld, \u05d5\u05e8\u05d5\u05d7\u05d1 \u05de\u05d5\u05d3\u05dc \u05d6\u05d4 %lld. \u05d4\u05d5\u05d0 \u05d9\u05d9\u05d3\u05d7\u05d4 \u05d1\u05d8\u05e2\u05d9\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947\u0915\u094d\u091f\u0930 \u0915\u0940 \u091a\u094c\u0921\u093c\u093e\u0908 %lld \u0939\u0948, \u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u0940 %lld\u0964 \u0932\u094b\u0921 \u0915\u0947 \u0938\u092e\u092f \u0907\u0938\u0947 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lebar vektor %lld, lebar model ini %lld. Vektor akan ditolak saat dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vettore ha larghezza %lld, questo modello %lld. Verrebbe rifiutato al caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d9\u30af\u30c8\u30eb\u306e\u5e45\u306f%lld\u3001\u3053\u306e\u30e2\u30c7\u30eb\u306f%lld\u3067\u3059\u3002\u8aad\u307f\u8fbc\u307f\u6642\u306b\u62d2\u5426\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubca1\ud130 \ub108\ube44\ub294 %lld, \uc774 \ubaa8\ub378\uc740 %lld\uc785\ub2c8\ub2e4. \ub85c\ub4dc \uc2dc \uac70\ubd80\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vector is %lld breed, dit model %lld. Hij zou bij het laden worden geweigerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wektor ma szeroko\u015b\u0107 %lld, ten model %lld. Zosta\u0142by odrzucony podczas \u0142adowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vetor tem largura %lld e este modelo %lld. Ele seria recusado no carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0438\u0440\u0438\u043d\u0430 \u0432\u0435\u043a\u0442\u043e\u0440\u0430 %lld, \u0443 \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 %lld. \u041e\u043d \u0431\u0443\u0434\u0435\u0442 \u043e\u0442\u043a\u043b\u043e\u043d\u0451\u043d \u043f\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorn \u00e4r %lld bred, den h\u00e4r modellen %lld. Den skulle avvisas vid inl\u00e4sning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekt\u00f6r geni\u015fli\u011fi %lld, bu modelinki %lld. Y\u00fcklemede reddedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0438\u0440\u0438\u043d\u0430 \u0432\u0435\u043a\u0442\u043e\u0440\u0430 %lld, \u0443 \u0446\u0456\u0454\u0457 \u043c\u043e\u0434\u0435\u043b\u0456 %lld. \u0419\u043e\u0433\u043e \u0431\u0443\u0434\u0435 \u0432\u0456\u0434\u0445\u0438\u043b\u0435\u043d\u043e \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vect\u01a1 r\u1ed9ng %lld, m\u00f4 h\u00ecnh n\u00e0y r\u1ed9ng %lld. Vect\u01a1 s\u1ebd b\u1ecb t\u1eeb ch\u1ed1i khi t\u1ea3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5411\u91cf\u5bbd\u5ea6\u4e3a %lld\uff0c\u6b64\u6a21\u578b\u4e3a %lld\u3002\u52a0\u8f7d\u65f6\u4f1a\u88ab\u62d2\u7edd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5411\u91cf\u5bec\u5ea6\u70ba %lld\uff0c\u6b64\u6a21\u578b\u70ba %lld\u3002\u8f09\u5165\u6642\u6703\u88ab\u62d2\u7d55\u3002"
          }
        }
      }
    },
    "Vector spans %lld blocks, this model has %lld. It would be refused at load.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0645\u062a\u062f \u0627\u0644\u0645\u062a\u062c\u0647 \u0639\u0644\u0649 %lld \u0643\u062a\u0644\u0629\u060c \u0648\u0644\u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c %lld. \u0633\u064a\u064f\u0631\u0641\u0636 \u0639\u0646\u062f \u0627\u0644\u062a\u062d\u0645\u064a\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Vektor umfasst %lld Bl\u00f6cke, dieses Modell hat %lld. Er w\u00fcrde beim Laden abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Vector spans %lld blocks, this model has %lld. It would be refused at load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vector abarca %lld bloques y este modelo tiene %lld. Se rechazar\u00eda al cargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le vecteur couvre %lld blocs, ce mod\u00e8le en a %lld. Il serait refus\u00e9 au chargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05d5\u05e7\u05d8\u05d5\u05e8 \u05de\u05e9\u05ea\u05e8\u05e2 \u05e2\u05dc %lld \u05d1\u05dc\u05d5\u05e7\u05d9\u05dd, \u05d5\u05dc\u05de\u05d5\u05d3\u05dc \u05d6\u05d4 \u05d9\u05e9 %lld. \u05d4\u05d5\u05d0 \u05d9\u05d9\u05d3\u05d7\u05d4 \u05d1\u05d8\u05e2\u05d9\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0947\u0915\u094d\u091f\u0930 %lld \u092c\u094d\u0932\u0949\u0915 \u0924\u0915 \u092b\u0948\u0932\u093e \u0939\u0948, \u0907\u0938 \u092e\u0949\u0921\u0932 \u092e\u0947\u0902 %lld \u0939\u0948\u0902\u0964 \u0932\u094b\u0921 \u0915\u0947 \u0938\u092e\u092f \u0907\u0938\u0947 \u0905\u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektor mencakup %lld blok, model ini memiliki %lld. Vektor akan ditolak saat dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il vettore copre %lld blocchi, questo modello ne ha %lld. Verrebbe rifiutato al caricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d9\u30af\u30c8\u30eb\u306f%lld\u30d6\u30ed\u30c3\u30af\u306b\u308f\u305f\u308a\u307e\u3059\u304c\u3001\u3053\u306e\u30e2\u30c7\u30eb\u306f%lld\u3067\u3059\u3002\u8aad\u307f\u8fbc\u307f\u6642\u306b\u62d2\u5426\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubca1\ud130\ub294 %lld\uac1c \ube14\ub85d\uc5d0 \uac78\uccd0 \uc788\uace0 \uc774 \ubaa8\ub378\uc740 %lld\uac1c\uc785\ub2c8\ub2e4. \ub85c\ub4dc \uc2dc \uac70\ubd80\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vector beslaat %lld blokken, dit model heeft er %lld. Hij zou bij het laden worden geweigerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wektor obejmuje %lld blok\u00f3w, ten model ma %lld. Zosta\u0142by odrzucony podczas \u0142adowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O vetor abrange %lld blocos e este modelo tem %lld. Ele seria recusado no carregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u043a\u0442\u043e\u0440 \u043e\u0445\u0432\u0430\u0442\u044b\u0432\u0430\u0435\u0442 %lld \u0431\u043b\u043e\u043a\u043e\u0432, \u0443 \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 %lld. \u041e\u043d \u0431\u0443\u0434\u0435\u0442 \u043e\u0442\u043a\u043b\u043e\u043d\u0451\u043d \u043f\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vektorn sp\u00e4nner \u00f6ver %lld block, den h\u00e4r modellen har %lld. Den skulle avvisas vid inl\u00e4sning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vekt\u00f6r %lld blo\u011fu kaps\u0131yor, bu modelde %lld var. Y\u00fcklemede reddedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u043a\u0442\u043e\u0440 \u043e\u0445\u043e\u043f\u043b\u044e\u0454 %lld \u0431\u043b\u043e\u043a\u0456\u0432, \u0443 \u0446\u0456\u0454\u0457 \u043c\u043e\u0434\u0435\u043b\u0456 %lld. \u0419\u043e\u0433\u043e \u0431\u0443\u0434\u0435 \u0432\u0456\u0434\u0445\u0438\u043b\u0435\u043d\u043e \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vect\u01a1 tr\u1ea3i tr\u00ean %lld kh\u1ed1i, m\u00f4 h\u00ecnh n\u00e0y c\u00f3 %lld. Vect\u01a1 s\u1ebd b\u1ecb t\u1eeb ch\u1ed1i khi t\u1ea3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5411\u91cf\u8de8\u8d8a %lld \u4e2a\u5757\uff0c\u6b64\u6a21\u578b\u6709 %lld \u4e2a\u3002\u52a0\u8f7d\u65f6\u4f1a\u88ab\u62d2\u7edd\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5411\u91cf\u8de8\u8d8a %lld \u500b\u5340\u584a\uff0c\u6b64\u6a21\u578b\u6709 %lld \u500b\u3002\u8f09\u5165\u6642\u6703\u88ab\u62d2\u7d55\u3002"
          }
        }
      }
    },
