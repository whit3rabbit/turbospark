        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0425\u0443\u043a\u0438 \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0437\u0430\u0446\u0456\u0457 \u0442\u0430 \u043e\u0431\u043c\u0435\u0436\u0443\u0432\u0430\u0447\u0456\u0432, \u0441\u0442\u0432\u043e\u0440\u0435\u043d\u0456 \u0432 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443"
          }
        },
        "vi": {
