        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e2\u05d8\u05e4\u05ea \u05d4\u05de\u05e4\u05ea\u05d7 \u05d4\u05de\u05d5\u05e6\u05e4\u05df \u05e4\u05d2\u05d5\u05de\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u0915\u0941\u0902\u091c\u0940 \u0906\u0935\u0930\u0923 \u0935\u093f\u0915\u0943\u0924 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Amplop kunci terenkripsi tidak valid."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il contenitore della chiave cifrata non \u00e8 valido."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6697\u53f7\u5316\u3055\u308c\u305f\u9375\u306e\u30a8\u30f3\u30d9\u30ed\u30fc\u30d7\u306e\u5f62\u5f0f\u304c\u6b63\u3057\u304f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc554\ud638\ud654\ub41c \ud0a4 \ubd09\ud22c\uc758 \ud615\uc2dd\uc774 \uc798\ubabb\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De versleutelde sleutelenvelop is ongeldig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koperta zaszyfrowanego klucza jest uszkodzona."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O envelope da chave criptografada est\u00e1 malformado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043d\u0432\u0435\u0440\u0442 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043a\u043b\u044e\u0447\u0430 \u043f\u043e\u0432\u0440\u0435\u0436\u0434\u0435\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det krypterade nyckelkuvertet \u00e4r felaktigt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eifreli anahtar zarf\u0131 hatal\u0131 bi\u00e7imlendirilmi\u015f."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043d\u0432\u0435\u0440\u0442 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043e\u0433\u043e \u043a\u043b\u044e\u0447\u0430 \u043f\u043e\u0448\u043a\u043e\u0434\u0436\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
