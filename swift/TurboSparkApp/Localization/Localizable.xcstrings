    "Skill '%@' is currently disabled. Enable it in Settings > Skills to use it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0645\u0647\u0627\u0631\u0629 '%@' \u0645\u0639\u0637\u0651\u0644\u0629 \u062d\u0627\u0644\u064a\u064b\u0627. \u0641\u0639\u0651\u0644\u0647\u0627 \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a > \u0627\u0644\u0645\u0647\u0627\u0631\u0627\u062a \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00e4higkeit '%@' ist derzeit deaktiviert. Aktivieren Sie sie unter Einstellungen > F\u00e4higkeiten, um sie zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skill '%@' is currently disabled. Enable it in Settings > Skills to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La habilidad '%@' est\u00e1 desactivada. Act\u00edvala en Ajustes > Habilidades para usarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La comp\u00e9tence '%@' est actuellement d\u00e9sactiv\u00e9e. Activez-la dans Param\u00e8tres > Comp\u00e9tences pour l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05db\u05d9\u05e9\u05d5\u05e8 '%@' \u05de\u05d5\u05e9\u05d1\u05ea \u05db\u05e8\u05d2\u05e2. \u05d4\u05e4\u05e2\u05dc \u05d0\u05d5\u05ea\u05d5 \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea > \u05db\u05d9\u05e9\u05d5\u05e8\u05d9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094c\u0936\u0932 '%@' \u0905\u092d\u0940 \u0905\u0915\u094d\u0937\u092e \u0939\u0948\u0964 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0907\u0938\u0947 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u0915\u094c\u0936\u0932 \u092e\u0947\u0902 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Keterampilan '%@' sedang dinonaktifkan. Aktifkan di Pengaturan > Keterampilan untuk menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La competenza '%@' \u00e8 attualmente disattivata. Attivala in Impostazioni > Competenze per usarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30ad\u30eb'%@'\u306f\u73fe\u5728\u7121\u52b9\u3067\u3059\u3002\u4f7f\u7528\u3059\u308b\u306b\u306f\u300c\u8a2d\u5b9a > \u30b9\u30ad\u30eb\u300d\u3067\u6709\u52b9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\ud0ac '%@'\uc740(\ub294) \ud604\uc7ac \ube44\ud65c\uc131\ud654\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uc0ac\uc6a9\ud558\ub824\uba74 \uc124\uc815 > \uc2a4\ud0ac\uc5d0\uc11c \ud65c\uc131\ud654\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaardigheid '%@' is momenteel uitgeschakeld. Schakel deze in via Instellingen > Vaardigheden om haar te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umiej\u0119tno\u015b\u0107 '%@' jest obecnie wy\u0142\u0105czona. W\u0142\u0105cz j\u0105 w Ustawienia > Umiej\u0119tno\u015bci, aby z niej korzysta\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A habilidade '%@' est\u00e1 desativada no momento. Ative-a em Configura\u00e7\u00f5es > Habilidades para us\u00e1-la."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0432\u044b\u043a '%@' \u0441\u0435\u0439\u0447\u0430\u0441 \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d. \u0427\u0442\u043e\u0431\u044b \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u044c \u0435\u0433\u043e, \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435 \u0435\u0433\u043e \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 > \u041d\u0430\u0432\u044b\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00e4rdigheten '%@' \u00e4r f\u00f6r n\u00e4rvarande inaktiverad. Aktivera den i Inst\u00e4llningar > F\u00e4rdigheter f\u00f6r att anv\u00e4nda den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' becerisi \u015fu anda devre d\u0131\u015f\u0131. Kullanmak i\u00e7in Ayarlar > Beceriler b\u00f6l\u00fcm\u00fcnden etkinle\u015ftirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0432\u0438\u0447\u043a\u0443 '%@' \u0437\u0430\u0440\u0430\u0437 \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u0429\u043e\u0431 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0457\u0457, \u0443\u0432\u0456\u043c\u043a\u043d\u0456\u0442\u044c \u0457\u0457 \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 > \u041d\u0430\u0432\u0438\u0447\u043a\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u1ef9 n\u0103ng '%@' hi\u1ec7n \u0111ang b\u1ecb t\u1eaft. H\u00e3y b\u1eadt trong C\u00e0i \u0111\u1eb7t > K\u1ef9 n\u0103ng \u0111\u1ec3 s\u1eed d\u1ee5ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6280\u80fd'%@'\u5f53\u524d\u5df2\u505c\u7528\u3002\u8bf7\u5728\u201c\u8bbe\u7f6e > \u6280\u80fd\u201d\u4e2d\u542f\u7528\u540e\u518d\u4f7f\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6280\u80fd'%@'\u76ee\u524d\u5df2\u505c\u7528\u3002\u8acb\u5728\u300c\u8a2d\u5b9a > \u6280\u80fd\u300d\u4e2d\u555f\u7528\u5f8c\u518d\u4f7f\u7528\u3002"
          }
        }
      }
    },
