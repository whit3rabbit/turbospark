        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvo na mem\u00f3ria do projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043e \u0432 \u043f\u0430\u043c\u044f\u0442\u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparat i projektminnet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje belle\u011fine kaydedildi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u0432 \u043f\u0430\u043c'\u044f\u0442\u0456 \u043f\u0440\u043e\u0454\u043a\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 l\u01b0u v\u00e0o b\u1ed9 nh\u1edb d\u1ef1 \u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4fdd\u5b58\u5230\u9879\u76ee\u8bb0\u5fc6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5132\u5b58\u5230\u5c08\u6848\u8a18\u61b6\u3002"
          }
        }
      }
    },
    "Saving is unavailable in a temporary chat.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062d\u0641\u0638 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d \u0641\u064a \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0645\u0624\u0642\u062a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichern ist in einem tempor\u00e4ren Chat nicht verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving is unavailable in a temporary chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardar no est\u00e1 disponible en un chat temporal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'enregistrement n'est pas disponible dans une discussion temporaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05de\u05d9\u05e8\u05d4 \u05d0\u05d9\u05e0\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4 \u05d1\u05e6'\u05d0\u05d8 \u05d6\u05de\u05e0\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u091a\u0948\u091f \u092e\u0947\u0902 \u0938\u0939\u0947\u091c\u0928\u093e \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyimpanan tidak tersedia di obrolan sementara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il salvataggio non \u00e8 disponibile in una chat temporanea."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6642\u7684\u306a\u30c1\u30e3\u30c3\u30c8\u3067\u306f\u4fdd\u5b58\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc784\uc2dc \ucc44\ud305\uc5d0\uc11c\ub294 \uc800\uc7a5\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opslaan is niet beschikbaar in een tijdelijke chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisywanie jest niedost\u0119pne w czacie tymczasowym."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvar n\u00e3o est\u00e1 dispon\u00edvel em um chat tempor\u00e1rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0438\u0435 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u043e \u0432\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c \u0447\u0430\u0442\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det g\u00e5r inte att spara i en tillf\u00e4llig chatt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7ici sohbette kaydetme kullan\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043d\u044f \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0435 \u0432 \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u043e\u043c\u0443 \u0447\u0430\u0442\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 l\u01b0u trong cu\u1ed9c tr\u00f2 chuy\u1ec7n t\u1ea1m th\u1eddi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e34\u65f6\u804a\u5929\u4e2d\u65e0\u6cd5\u4fdd\u5b58\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66ab\u5b58\u804a\u5929\u4e2d\u7121\u6cd5\u5132\u5b58\u3002"
          }
        }
      }
    },
    "Seed must be an unsigned integer or blank for random.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062c\u0628 \u0623\u0646 \u062a\u0643\u0648\u0646 \u0627\u0644\u0628\u0630\u0631\u0629 \u0639\u062f\u062f\u064b\u0627 \u0635\u062d\u064a\u062d\u064b\u0627 \u063a\u064a\u0631 \u0633\u0627\u0644\u0628\u060c \u0623\u0648 \u062a\u064f\u062a\u0631\u0643 \u0641\u0627\u0631\u063a\u0629 \u0644\u0642\u064a\u0645\u0629 \u0639\u0634\u0648\u0627\u0626\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Seed muss eine vorzeichenlose Ganzzahl sein oder f\u00fcr Zufall leer bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed must be an unsigned integer or blank for random."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semilla debe ser un entero sin signo o quedar vac\u00eda para un valor aleatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La graine doit \u00eatre un entier non sign\u00e9, ou vide pour une valeur al\u00e9atoire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e1\u05d9\u05d3 \u05d7\u05d9\u05d9\u05d1 \u05dc\u05d4\u05d9\u05d5\u05ea \u05de\u05e1\u05e4\u05e8 \u05e9\u05dc\u05dd \u05d0\u05d9-\u05e9\u05dc\u05d9\u05dc\u05d9, \u05d0\u05d5 \u05e8\u05d9\u05e7 \u05dc\u05e2\u05e8\u05da \u05d0\u05e7\u05e8\u05d0\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0940\u0921 \u090f\u0915 \u0905\u0939\u0938\u094d\u0924\u093e\u0915\u094d\u0937\u0930\u093f\u0924 \u092a\u0942\u0930\u094d\u0923\u093e\u0902\u0915 \u0939\u094b\u0928\u093e \u091a\u093e\u0939\u093f\u090f, \u092f\u093e \u092f\u093e\u0926\u0943\u091a\u094d\u091b\u093f\u0915 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed harus berupa bilangan bulat tak bertanda atau kosong untuk acak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il seed deve essere un intero senza segno o vuoto per un valore casuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b7\u30fc\u30c9\u306b\u306f\u7b26\u53f7\u306a\u3057\u6574\u6570\u3092\u6307\u5b9a\u3059\u308b\u304b\u3001\u30e9\u30f3\u30c0\u30e0\u306b\u3059\u308b\u5834\u5408\u306f\u7a7a\u6b04\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2dc\ub4dc\ub294 \ubd80\ud638 \uc5c6\ub294 \uc815\uc218\uc5ec\uc57c \ud558\uba70, \ubb34\uc791\uc704\ub85c \ud558\ub824\uba74 \ube44\uc6cc \ub450\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed moet een geheel getal zonder teken zijn, of leeg voor willekeurig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziarno musi by\u0107 liczb\u0105 ca\u0142kowit\u0105 bez znaku lub puste dla warto\u015bci losowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seed deve ser um inteiro sem sinal ou ficar em branco para aleat\u00f3rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0438\u0434 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0446\u0435\u043b\u044b\u043c \u0447\u0438\u0441\u043b\u043e\u043c \u0431\u0435\u0437 \u0437\u043d\u0430\u043a\u0430 \u0438\u043b\u0438 \u043f\u0443\u0441\u0442\u044b\u043c \u0434\u043b\u044f \u0441\u043b\u0443\u0447\u0430\u0439\u043d\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed m\u00e5ste vara ett icke-negativt heltal eller tomt f\u00f6r slumpm\u00e4ssigt v\u00e4rde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohum i\u015faretsiz bir tam say\u0131 olmal\u0131 veya rastgele i\u00e7in bo\u015f b\u0131rak\u0131lmal\u0131d\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0456\u0434 \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u0446\u0456\u043b\u0438\u043c \u0447\u0438\u0441\u043b\u043e\u043c \u0431\u0435\u0437 \u0437\u043d\u0430\u043a\u0430 \u0430\u0431\u043e \u043f\u043e\u0440\u043e\u0436\u043d\u0456\u043c \u0434\u043b\u044f \u0432\u0438\u043f\u0430\u0434\u043a\u043e\u0432\u043e\u0433\u043e \u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u1ea1t gi\u1ed1ng ph\u1ea3i l\u00e0 s\u1ed1 nguy\u00ean kh\u00f4ng d\u1ea5u, ho\u1eb7c \u0111\u1ec3 tr\u1ed1ng \u0111\u1ec3 ch\u1ecdn ng\u1eabu nhi\u00ean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u968f\u673a\u79cd\u5b50\u5fc5\u987b\u662f\u65e0\u7b26\u53f7\u6574\u6570\uff0c\u7559\u7a7a\u5219\u968f\u673a\u751f\u6210\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u96a8\u6a5f\u7a2e\u5b50\u5fc5\u9808\u662f\u7121\u865f\u6574\u6578\uff0c\u7559\u7a7a\u5247\u96a8\u6a5f\u7522\u751f\u3002"
          }
        }
      }
    },
    "Select a folder to authorize for TurboSpark tool and project access.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u062f\u062f \u0645\u062c\u0644\u062f\u064b\u0627 \u0644\u062a\u062e\u0648\u064a\u0644 \u0623\u062f\u0648\u0627\u062a TurboSpark \u0648\u0645\u0634\u0627\u0631\u064a\u0639\u0647 \u0628\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie einen Ordner aus, auf den TurboSpark-Tools und -Projekte zugreifen d\u00fcrfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a folder to authorize for TurboSpark tool and project access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona una carpeta para autorizar el acceso de las herramientas y proyectos de TurboSpark."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9lectionnez un dossier pour autoriser l'acc\u00e8s des outils et projets de TurboSpark."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d0\u05e9\u05e8 \u05d2\u05d9\u05e9\u05d4 \u05e9\u05dc \u05d4\u05db\u05dc\u05d9\u05dd \u05d5\u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd \u05e9\u05dc TurboSpark."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u091f\u0942\u0932 \u0914\u0930 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u092a\u0939\u0941\u0901\u091a \u0915\u0947 \u0932\u093f\u090f \u0905\u0927\u093f\u0915\u0943\u0924 \u0915\u0930\u0928\u0947 \u0939\u0947\u0924\u0941 \u090f\u0915 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder yang akan diotorisasi untuk akses alat dan proyek TurboSpark."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleziona una cartella da autorizzare per l'accesso di strumenti e progetti di TurboSpark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \u306e\u30c4\u30fc\u30eb\u3068\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306b\u30a2\u30af\u30bb\u30b9\u3092\u8a31\u53ef\u3059\u308b\u30d5\u30a9\u30eb\u30c0\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark \ub3c4\uad6c \ubc0f \ud504\ub85c\uc81d\ud2b8 \uc811\uadfc\uc744 \ud5c8\uc6a9\ud560 \ud3f4\ub354\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een map om toegang voor TurboSpark-tools en -projecten toe te staan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder, do kt\u00f3rego narz\u0119dzia i projekty TurboSpark maj\u0105 mie\u0107 dost\u0119p."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecione uma pasta para autorizar o acesso de ferramentas e projetos do TurboSpark."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0430\u043f\u043a\u0443, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c \u0438 \u043f\u0440\u043e\u0435\u043a\u0442\u0430\u043c TurboSpark."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en mapp som TurboSparks verktyg och projekt ska f\u00e5 \u00e5tkomst till."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "TurboSpark ara\u00e7 ve proje eri\u015fimi i\u00e7in yetkilendirilecek bir klas\u00f6r se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0430\u043f\u043a\u0443, \u0434\u043e \u044f\u043a\u043e\u0457 \u043d\u0430\u0434\u0430\u0442\u0438 \u0434\u043e\u0441\u0442\u0443\u043f \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c \u0456 \u043f\u0440\u043e\u0454\u043a\u0442\u0430\u043c TurboSpark."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn m\u1ed9t th\u01b0 m\u1ee5c \u0111\u1ec3 c\u1ea5p quy\u1ec1n truy c\u1eadp cho c\u00f4ng c\u1ee5 v\u00e0 d\u1ef1 \u00e1n c\u1ee7a TurboSpark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u4e00\u4e2a\u6587\u4ef6\u5939\uff0c\u6388\u6743 TurboSpark \u7684\u5de5\u5177\u548c\u9879\u76ee\u8bbf\u95ee\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u4e00\u500b\u8cc7\u6599\u593e\uff0c\u6388\u6b0a TurboSpark \u7684\u5de5\u5177\u548c\u5c08\u6848\u5b58\u53d6\u3002"
          }
        }
      }
    },
    "Select a project to set a per-project plugin override.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0645\u0634\u0631\u0648\u0639\u064b\u0627 \u0644\u062a\u0639\u064a\u064a\u0646 \u062a\u062c\u0627\u0648\u0632 \u0644\u0644\u0645\u0644\u062d\u0642 \u062e\u0627\u0635 \u0628\u0627\u0644\u0645\u0634\u0631\u0648\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie ein Projekt aus, um eine projektspezifische Plugin-\u00dcberschreibung festzulegen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select a project to set a per-project plugin override."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecciona un proyecto para definir una anulaci\u00f3n de plugin por proyecto."
