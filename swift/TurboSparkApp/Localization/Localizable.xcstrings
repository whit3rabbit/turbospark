            "value": "\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 \u0639\u0645\u0644\u064a\u0629 \u0639\u0627\u0644\u064a\u0629 \u0627\u0644\u062e\u0637\u0648\u0631\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Operation mit hohem Risiko erkannt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High-Risk Operation Detected"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Operaci\u00f3n de alto riesgo detectada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Op\u00e9ration \u00e0 haut risque d\u00e9tect\u00e9e"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d6\u05d5\u05d4\u05ea\u05d4 \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d1\u05e1\u05d9\u05db\u05d5\u05df \u05d2\u05d1\u05d5\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u091a\u094d\u091a \u091c\u094b\u0916\u093f\u092e \u0935\u093e\u0932\u0947 \u0911\u092a\u0930\u0947\u0936\u0928 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Operasi Berisiko Tinggi Terdeteksi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevata operazione ad alto rischio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u30ea\u30b9\u30af\u306a\u64cd\u4f5c\u304c\u691c\u51fa\u3055\u308c\u307e\u3057\u305f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uace0\uc704\ud5d8 \uc791\uc5c5 \uac10\uc9c0\ub428"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoog-risicobewerking gedetecteerd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto operacj\u0119 wysokiego ryzyka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Opera\u00e7\u00e3o de alto risco detectada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u0430 \u043e\u043f\u0435\u0440\u0430\u0446\u0438\u044f \u0432\u044b\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0438\u0441\u043a\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00f6griskoperation uppt\u00e4ckt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fcksek Riskli \u0130\u015flem Alg\u0131land\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u044f\u0432\u043b\u0435\u043d\u043e \u043e\u043f\u0435\u0440\u0430\u0446\u0456\u044e \u0432\u0438\u0441\u043e\u043a\u043e\u0433\u043e \u0440\u0438\u0437\u0438\u043a\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ph\u00e1t hi\u1ec7n thao t\u00e1c r\u1ee7i ro cao"
