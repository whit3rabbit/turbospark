        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Breve resumen de lo que hace esta habilidad y cu\u00e1ndo activarla\u2026"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bref r\u00e9sum\u00e9 de ce que fait cette comp\u00e9tence et du moment o\u00f9 l\u2019activer\u2026"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05d9\u05db\u05d5\u05dd \u05e7\u05e6\u05e8 \u05e9\u05dc \u05de\u05d4 \u05e9\u05d4\u05db\u05d9\u05e9\u05d5\u05e8 \u05e2\u05d5\u05e9\u05d4 \u05d5\u05de\u05ea\u05d9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05d5\u05ea\u05d5\u2026"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0915\u094c\u0936\u0932 \u0915\u094d\u092f\u093e \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0915\u092c \u0938\u0915\u094d\u0930\u093f\u092f \u0915\u0930\u0928\u093e \u0939\u0948, \u0907\u0938\u0915\u093e \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0938\u093e\u0930\u093e\u0902\u0936\u2026"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ringkasan singkat tentang fungsi keterampilan ini dan kapan mengaktifkannya\u2026"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Breve descrizione di cosa fa questa competenza e quando attivarla\u2026"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30b9\u30ad\u30eb\u306e\u5f79\u5272\u3068\u4f7f\u3046\u30bf\u30a4\u30df\u30f3\u30b0\u306e\u7c21\u5358\u306a\u8aac\u660e\u2026"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc2a4\ud0ac\uc774 \ud558\ub294 \uc77c\uacfc \ud65c\uc131\ud654\ud560 \uc2dc\uc810\uc5d0 \ub300\ud55c \uac04\ub2e8\ud55c \uc694\uc57d\u2026"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korte samenvatting van wat deze vaardigheid doet en wanneer je hem activeert\u2026"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kr\u00f3tkie podsumowanie, co robi ta umiej\u0119tno\u015b\u0107 i kiedy j\u0105 aktywowa\u0107\u2026"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Breve resumo do que esta habilidade faz e quando ativ\u00e1-la\u2026"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0440\u0430\u0442\u043a\u043e \u043e\u043f\u0438\u0448\u0438\u0442\u0435, \u0447\u0442\u043e \u0434\u0435\u043b\u0430\u0435\u0442 \u044d\u0442\u043e\u0442 \u043d\u0430\u0432\u044b\u043a \u0438 \u043a\u043e\u0433\u0434\u0430 \u0435\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0430\u0442\u044c\u2026"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kort sammanfattning av vad f\u00e4rdigheten g\u00f6r och n\u00e4r den ska aktiveras\u2026"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu becerinin ne yapt\u0131\u011f\u0131n\u0131n ve ne zaman etkinle\u015ftirilece\u011finin k\u0131sa \u00f6zeti\u2026"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0440\u043e\u0442\u043a\u043e \u043e\u043f\u0438\u0448\u0456\u0442\u044c, \u0449\u043e \u0440\u043e\u0431\u0438\u0442\u044c \u0446\u044f \u043d\u0430\u0432\u0438\u0447\u043a\u0430 \u0456 \u043a\u043e\u043b\u0438 \u0457\u0457 \u0432\u043c\u0438\u043a\u0430\u0442\u0438\u2026"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f3m t\u1eaft ng\u1eafn v\u1ec1 ch\u1ee9c n\u0103ng c\u1ee7a k\u1ef9 n\u0103ng n\u00e0y v\u00e0 khi n\u00e0o k\u00edch ho\u1ea1t\u2026"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7b80\u8981\u8bf4\u660e\u6b64\u6280\u80fd\u7684\u4f5c\u7528\u4ee5\u53ca\u4f55\u65f6\u542f\u7528\u2026"
          }
        },
        "zh-Hant": {
