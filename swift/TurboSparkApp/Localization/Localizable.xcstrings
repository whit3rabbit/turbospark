          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите или остановите текущий ход перед сменой модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutför eller stoppa den pågående turen innan du byter modell."
          }
        },
        "tr": {
