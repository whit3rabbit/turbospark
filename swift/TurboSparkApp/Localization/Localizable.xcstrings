    "This model likely streams from the drive, so generation speed will be limited by the drive.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من المرجح أن يُبَث هذا النموذج من محرك الأقراص، لذا ستكون سرعة التوليد محدودة بسرعة محرك الأقراص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell wird wahrscheinlich vom Laufwerk gestreamt, daher wird die Generierungsgeschwindigkeit vom Laufwerk begrenzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model likely streams from the drive, so generation speed will be limited by the drive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es probable que este modelo se transmita desde la unidad, por lo que la velocidad de generación estará limitada por la unidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle est probablement diffusé depuis le disque, la vitesse de génération sera donc limitée par le disque."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סביר שהמודל הזה יוזרם מהכונן, ולכן מהירות היצירה תוגבל על ידי הכונן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मॉडल संभवतः ड्राइव से स्ट्रीम होगा, इसलिए जनरेशन की गति ड्राइव द्वारा सीमित होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini kemungkinan akan di-stream dari drive, sehingga kecepatan pembuatan teks dibatasi oleh drive."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello probabilmente viene trasmesso dall'unità, quindi la velocità di generazione sarà limitata dall'unità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルはドライブからストリーミングされる可能性が高く、生成速度はドライブによって制限されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 드라이브에서 스트리밍될 가능성이 높으므로 생성 속도가 드라이브에 의해 제한됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit model wordt waarschijnlijk vanaf de schijf gestreamd, dus de generatiesnelheid wordt door de schijf beperkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten model prawdopodobnie jest strumieniowany z dysku, więc szybkość generowania będzie ograniczona przez dysk."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo provavelmente é transmitido da unidade, então a velocidade de geração será limitada pela unidade."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель, скорее всего, считывается с диска потоком, поэтому скорость генерации будет ограничена диском."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här modellen strömmas sannolikt från enheten, så genereringshastigheten begränsas av enheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model büyük olasılıkla sürücüden akış olarak okunur, bu yüzden üretim hızı sürücü tarafından sınırlanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця модель, імовірно, зчитується з диска потоком, тому швидкість генерації буде обмежена диском."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình này có khả năng được truyền trực tiếp từ ổ đĩa, nên tốc độ tạo sẽ bị giới hạn bởi ổ đĩa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型很可能从驱动器流式读取，因此生成速度会受驱动器限制。"
