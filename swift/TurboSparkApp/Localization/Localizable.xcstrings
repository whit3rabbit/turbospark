          "stringUnit": {
            "state": "translated",
            "value": "Installation failed: Authentication required. Check your Hugging Face API token in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Error en la instalación: se requiere autenticación. Revisa tu token de API de Hugging Face en Ajustes."
