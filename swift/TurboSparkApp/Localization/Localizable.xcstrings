          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przekazywanie \u015brodowiska (jedna NAZWA zmiennej w wierszu)"
          }
        },
        "pt-BR": {
          "stringUnit": {
