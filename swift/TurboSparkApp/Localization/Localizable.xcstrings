          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "菜单栏和系统对话框会在 TurboSpark 重新启动后切换语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
