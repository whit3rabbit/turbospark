    "Paused downloads resume while the app stays open.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0626\u0646\u0627\u0641 \u0627\u0644\u062a\u0646\u0632\u064a\u0644\u0627\u062a \u0627\u0644\u0645\u062a\u0648\u0642\u0641\u0629 \u0645\u0624\u0642\u062a\u064b\u0627 \u0645\u0627 \u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u0641\u062a\u0648\u062d\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausierte Downloads k\u00f6nnen fortgesetzt werden, solange die App ge\u00f6ffnet bleibt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paused downloads resume while the app stays open."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas pausadas se pueden reanudar mientras la aplicaci\u00f3n permanezca abierta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les t\u00e9l\u00e9chargements suspendus peuvent reprendre tant que l\u2019application reste ouverte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d9\u05ea\u05df \u05dc\u05d4\u05de\u05e9\u05d9\u05da \u05d4\u05d5\u05e8\u05d3\u05d5\u05ea \u05e9\u05d4\u05d5\u05e9\u05d4\u05d5 \u05db\u05dc \u05e2\u05d5\u05d3 \u05d4\u05d0\u05e4\u05dc\u05d9\u05e7\u05e6\u05d9\u05d4 \u05e0\u05e9\u05d0\u05e8\u05ea \u05e4\u05ea\u05d5\u05d7\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u0941\u0915\u0947 \u0939\u0941\u090f \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0910\u092a \u0916\u0941\u0932\u093e \u0930\u0939\u0928\u0947 \u0924\u0915 \u091c\u093e\u0930\u0940 \u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan yang dijeda dapat dilanjutkan selama aplikasi tetap terbuka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download in pausa possono riprendere finch\u00e9 l\u2019app rimane aperta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30d7\u30ea\u3092\u958b\u3044\u305f\u307e\u307e\u3067\u3042\u308c\u3070\u3001\u4e00\u6642\u505c\u6b62\u3057\u305f\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3092\u518d\u958b\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc571\uc774 \uc5f4\ub824 \uc788\ub294 \ub3d9\uc548 \uc77c\uc2dc \uc815\uc9c0\ud55c \ub2e4\uc6b4\ub85c\ub4dc\ub97c \uacc4\uc18d\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gepauzeerde downloads kunnen worden hervat zolang de app open blijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wstrzymane pobieranie mo\u017cna wznowi\u0107, dop\u00f3ki aplikacja pozostaje otwarta."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads pausados podem ser retomados enquanto o aplicativo permanecer aberto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u043e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044b\u0435 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043c\u043e\u0436\u043d\u043e \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c, \u043f\u043e\u043a\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043e\u0442\u043a\u0440\u044b\u0442\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Pausade h\u00e4mtningar kan \u00e5terupptas s\u00e5 l\u00e4nge appen \u00e4r \u00f6ppen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama a\u00e7\u0131k kald\u0131\u011f\u0131 s\u00fcrece duraklat\u0131lan indirmeler s\u00fcrd\u00fcr\u00fclebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0437\u0443\u043f\u0438\u043d\u0435\u043d\u0456 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043c\u043e\u0436\u043d\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438, \u0434\u043e\u043a\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438\u0439."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00f3 th\u1ec3 ti\u1ebfp t\u1ee5c c\u00e1c l\u01b0\u1ee3t t\u1ea3i xu\u1ed1ng \u0111\u00e3 t\u1ea1m d\u1eebng khi \u1ee9ng d\u1ee5ng v\u1eabn m\u1edf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e94\u7528\u4fdd\u6301\u6253\u5f00\u65f6\uff0c\u53ef\u4ee5\u7ee7\u7eed\u5df2\u6682\u505c\u7684\u4e0b\u8f7d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u61c9\u7528\u7a0b\u5f0f\u4fdd\u6301\u958b\u555f\u6642\uff0c\u53ef\u4ee5\u7e7c\u7e8c\u5df2\u66ab\u505c\u7684\u4e0b\u8f09\u3002"
          }
        }
      }
    },
    "Payload is supplied via JSON over stdin. Exit code 2 blocks PreToolUse execution.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u064f\u0645\u0631\u064e\u0651\u0631 \u0627\u0644\u062d\u0645\u0648\u0644\u0629 \u0628\u0635\u064a\u063a\u0629 JSON \u0639\u0628\u0631 stdin. \u0648\u0631\u0645\u0632 \u0627\u0644\u062e\u0631\u0648\u062c 2 \u064a\u0645\u0646\u0639 \u062a\u0646\u0641\u064a\u0630 PreToolUse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Nutzlast wird als JSON \u00fcber stdin \u00fcbergeben. Exit-Code 2 blockiert die PreToolUse-Ausf\u00fchrung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payload is supplied via JSON over stdin. Exit code 2 blocks PreToolUse execution."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga \u00fatil se env\u00eda como JSON por stdin. El c\u00f3digo de salida 2 bloquea la ejecuci\u00f3n de PreToolUse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge utile est fournie en JSON via stdin. Le code de sortie 2 bloque l'ex\u00e9cution de PreToolUse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d8\u05e2\u05df \u05de\u05e1\u05d5\u05e4\u05e7 \u05db-JSON \u05d3\u05e8\u05da stdin. \u05e7\u05d5\u05d3 \u05d9\u05e6\u05d9\u05d0\u05d4 2 \u05d7\u05d5\u05e1\u05dd \u05d0\u05ea \u05d4\u05d4\u05e8\u05e6\u05d4 \u05e9\u05dc PreToolUse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0947\u0932\u094b\u0921 stdin \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 JSON \u092e\u0947\u0902 \u0926\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u090f\u0917\u094d\u091c\u093c\u093f\u091f \u0915\u094b\u0921 2 PreToolUse \u0928\u093f\u0937\u094d\u092a\u093e\u0926\u0928 \u0930\u094b\u0915 \u0926\u0947\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Payload disediakan sebagai JSON melalui stdin. Kode keluar 2 memblokir eksekusi PreToolUse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il payload viene fornito come JSON tramite stdin. Il codice di uscita 2 blocca l'esecuzione di PreToolUse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30da\u30a4\u30ed\u30fc\u30c9\u306f stdin \u7d4c\u7531\u306e JSON \u3067\u6e21\u3055\u308c\u307e\u3059\u3002\u7d42\u4e86\u30b3\u30fc\u30c9 2 \u306f PreToolUse \u306e\u5b9f\u884c\u3092\u30d6\u30ed\u30c3\u30af\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud398\uc774\ub85c\ub4dc\ub294 stdin\uc744 \ud1b5\ud574 JSON\uc73c\ub85c \uc804\ub2ec\ub429\ub2c8\ub2e4. \uc885\ub8cc \ucf54\ub4dc 2\ub294 PreToolUse \uc2e4\ud589\uc744 \ucc28\ub2e8\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De payload wordt als JSON via stdin aangeleverd. Afsluitcode 2 blokkeert de uitvoering van PreToolUse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0141adunek jest przekazywany jako JSON przez stdin. Kod wyj\u015bcia 2 blokuje wykonanie PreToolUse."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O payload \u00e9 fornecido como JSON via stdin. O c\u00f3digo de sa\u00edda 2 bloqueia a execu\u00e7\u00e3o de PreToolUse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043b\u0435\u0437\u043d\u0430\u044f \u043d\u0430\u0433\u0440\u0443\u0437\u043a\u0430 \u043f\u0435\u0440\u0435\u0434\u0430\u0435\u0442\u0441\u044f \u0432 \u0444\u043e\u0440\u043c\u0430\u0442\u0435 JSON \u0447\u0435\u0440\u0435\u0437 stdin. \u041a\u043e\u0434 \u0432\u044b\u0445\u043e\u0434\u0430 2 \u0431\u043b\u043e\u043a\u0438\u0440\u0443\u0435\u0442 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0435 PreToolUse."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyttolasten skickas som JSON via stdin. Slutkod 2 blockerar PreToolUse-k\u00f6rning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fck, stdin \u00fczerinden JSON olarak sa\u011flan\u0131r. \u00c7\u0131k\u0131\u015f kodu 2, PreToolUse y\u00fcr\u00fctmesini engeller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0440\u0438\u0441\u043d\u0435 \u043d\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043f\u0435\u0440\u0435\u0434\u0430\u0454\u0442\u044c\u0441\u044f \u044f\u043a JSON \u0447\u0435\u0440\u0435\u0437 stdin. \u041a\u043e\u0434 \u0432\u0438\u0445\u043e\u0434\u0443 2 \u0431\u043b\u043e\u043a\u0443\u0454 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f PreToolUse."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Payload \u0111\u01b0\u1ee3c cung c\u1ea5p d\u01b0\u1edbi d\u1ea1ng JSON qua stdin. M\u00e3 tho\u00e1t 2 ch\u1eb7n vi\u1ec7c th\u1ef1c thi PreToolUse."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8d1f\u8f7d\u901a\u8fc7 stdin \u4ee5 JSON \u63d0\u4f9b\u3002\u9000\u51fa\u7801 2 \u4f1a\u963b\u6b62 PreToolUse \u6267\u884c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8ca0\u8f09\u900f\u904e stdin \u4ee5 JSON \u63d0\u4f9b\u3002\u7d50\u675f\u78bc 2 \u6703\u963b\u64cb PreToolUse \u57f7\u884c\u3002"
          }
        }
      }
    },
