          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso exclui permanentemente os arquivos do modelo (%@) da unidade da biblioteca %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлы модели (%@) будут безвозвратно удалены с диска библиотеки %@."
