            "state": "translated",
            "value": "macOS \u807d\u5beb"
          }
        }
      }
    },
    "macOS Dictation cannot transcribe recordings. Choose Automatic in Settings > Audio & Voice.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0645\u0643\u0646 \u0644\u0625\u0645\u0644\u0627\u0621 macOS \u062a\u0641\u0631\u064a\u063a \u0627\u0644\u062a\u0633\u062c\u064a\u0644\u0627\u062a \u0646\u0635\u064a\u064b\u0627. \u0627\u062e\u062a\u0631 \u00ab\u062a\u0644\u0642\u0627\u0626\u064a\u00bb \u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a > \u0627\u0644\u0635\u0648\u062a \u0648\u0627\u0644\u0643\u0644\u0627\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das macOS-Diktat kann keine Aufnahmen transkribieren. W\u00e4hle \u201eAutomatisch\u201c unter Einstellungen > Audio & Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Dictation cannot transcribe recordings. Choose Automatic in Settings > Audio & Voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Dictado de macOS no puede transcribir grabaciones. Elige Autom\u00e1tico en Ajustes > Audio y voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La Dict\u00e9e de macOS ne peut pas transcrire d'enregistrements. Choisissez Automatique dans R\u00e9glages > Audio et voix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d4\u05db\u05ea\u05d1\u05d4 \u05e9\u05dc macOS \u05d0\u05d9\u05e0\u05d4 \u05d9\u05db\u05d5\u05dc\u05d4 \u05dc\u05ea\u05de\u05dc\u05dc \u05d4\u05e7\u05dc\u05d8\u05d5\u05ea. \u05d1\u05d7\u05e8 '\u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9' \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea > \u05e9\u05de\u05e2 \u05d5\u05e7\u05d5\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \u0921\u093f\u0915\u094d\u091f\u0947\u0936\u0928 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0915\u094b \u091f\u094d\u0930\u093e\u0902\u0938\u0915\u094d\u0930\u093e\u0907\u092c \u0928\u0939\u0940\u0902 \u0915\u0930 \u0938\u0915\u0924\u093e\u0964 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u0911\u0921\u093f\u092f\u094b \u0914\u0930 \u0935\u0949\u0907\u0938 \u092e\u0947\u0902 \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikte macOS tidak dapat mentranskripsi rekaman. Pilih Otomatis di Pengaturan > Audio & Suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La Dettatura di macOS non pu\u00f2 trascrivere registrazioni. Scegli Automatico in Impostazioni > Audio e voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \u306e\u97f3\u58f0\u5165\u529b\u3067\u306f\u9332\u97f3\u3092\u6587\u5b57\u8d77\u3053\u3057\u3067\u304d\u307e\u305b\u3093\u3002\u300c\u8a2d\u5b9a\u300d>\u300c\u30aa\u30fc\u30c7\u30a3\u30aa\u3068\u97f3\u58f0\u300d\u3067\u300c\u81ea\u52d5\u300d\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \ubc1b\uc544\uc4f0\uae30\ub294 \ub179\uc74c\uc744 \ud14d\uc2a4\ud2b8\ub85c \ubcc0\ud658\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uc124\uc815 > \uc624\ub514\uc624 \ubc0f \uc74c\uc131\uc5d0\uc11c \uc790\ub3d9\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-dicteren kan geen opnamen transcriberen. Kies Automatisch in Instellingen > Audio en stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dyktowanie macOS nie mo\u017ce transkrybowa\u0107 nagra\u0144. Wybierz Automatycznie w Ustawienia > D\u017awi\u0119k i g\u0142os."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ditado do macOS n\u00e3o transcreve grava\u00e7\u00f5es. Escolha Autom\u00e1tico em Ajustes > \u00c1udio e voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0438\u043a\u0442\u043e\u0432\u043a\u0430 macOS \u043d\u0435 \u043c\u043e\u0436\u0435\u0442 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u044b\u0432\u0430\u0442\u044c \u0437\u0430\u043f\u0438\u0441\u0438. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u00ab\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438\u00bb \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438\u00bb > \u00ab\u0417\u0432\u0443\u043a \u0438 \u0433\u043e\u043b\u043e\u0441\u00bb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS-diktering kan inte transkribera inspelningar. V\u00e4lj Automatiskt i Inst\u00e4llningar > Ljud och r\u00f6st."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS Dikte kay\u0131tlar\u0131 metne d\u00f6n\u00fc\u015ft\u00fcremez. Ayarlar > Ses ve Konu\u015fma b\u00f6l\u00fcm\u00fcnden Otomatik'i se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0438\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f macOS \u043d\u0435 \u043c\u043e\u0436\u0435 \u0440\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u0443\u0432\u0430\u0442\u0438 \u0437\u0430\u043f\u0438\u0441\u0438. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u00ab\u0410\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u043d\u043e\u00bb \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u00bb > \u00ab\u0417\u0432\u0443\u043a \u0456 \u0433\u043e\u043b\u043e\u0441\u00bb."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ecdc ch\u00ednh t\u1ea3 c\u1ee7a macOS kh\u00f4ng th\u1ec3 ch\u00e9p l\u1eddi b\u1ea3n ghi. H\u00e3y ch\u1ecdn T\u1ef1 \u0111\u1ed9ng trong C\u00e0i \u0111\u1eb7t > \u00c2m thanh v\u00e0 gi\u1ecdng n\u00f3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \u542c\u5199\u65e0\u6cd5\u8f6c\u5199\u5f55\u97f3\u3002\u8bf7\u5728\u201c\u8bbe\u7f6e\u201d>\u201c\u97f3\u9891\u4e0e\u8bed\u97f3\u201d\u4e2d\u9009\u62e9\u201c\u81ea\u52a8\u201d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \u807d\u5beb\u7121\u6cd5\u8f49\u5beb\u9304\u97f3\u3002\u8acb\u5728\u300c\u8a2d\u5b9a\u300d>\u300c\u97f3\u8a0a\u8207\u8a9e\u97f3\u300d\u4e2d\u9078\u64c7\u300c\u81ea\u52d5\u300d\u3002"
          }
        }
      }
    },
