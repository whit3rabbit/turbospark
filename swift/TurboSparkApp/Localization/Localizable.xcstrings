        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modeli indirin veya model a\u011f\u0131rl\u0131klar\u0131 klas\u00f6r\u00fcn\u00fc se\u00e7in."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh model ini atau pilih folder bobotnya."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043a\u0430\u0447\u0430\u0439\u0442\u0435 \u044d\u0442\u0443 \u043c\u043e\u0434\u0435\u043b\u044c \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0435\u0451 \u043f\u0430\u043f\u043a\u0443 \u0432\u0435\u0441\u043e\u0432."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u0446\u044e \u043c\u043e\u0434\u0435\u043b\u044c \u0430\u0431\u043e \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0457\u0457 \u043f\u0430\u043f\u043a\u0443 \u0432\u0430\u0433."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i m\u00f4 h\u00ecnh n\u00e0y ho\u1eb7c ch\u1ecdn th\u01b0 m\u1ee5c tr\u1ecdng s\u1ed1 c\u1ee7a m\u00f4 h\u00ecnh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e2\u30c7\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3059\u308b\u304b\u3001\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u30d5\u30a9\u30eb\u30c0\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubaa8\ub378\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uac70\ub098 \uccb4\ud06c\ud3ec\uc778\ud2b8 \ud3f4\ub354\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f7d\u6b64\u6a21\u578b\u6216\u9009\u62e9\u5176\u68c0\u67e5\u70b9\u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f09\u6b64\u6a21\u578b\u6216\u9078\u64c7\u5176\u6aa2\u67e5\u9ede\u8cc7\u6599\u593e\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0632\u0651\u0644 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0623\u0648 \u0627\u062e\u062a\u0631 \u0645\u062c\u0644\u062f \u0623\u0648\u0632\u0627\u0646\u0647."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e8\u05d3 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d6\u05d4 \u05d0\u05d5 \u05d1\u05d7\u05e8 \u05d0\u05ea \u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05de\u05e9\u05e7\u05d5\u05dc\u05d5\u05ea \u05e9\u05dc\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092e\u0949\u0921\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 \u092f\u093e \u0907\u0938\u0915\u093e \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        }
      }
    },
