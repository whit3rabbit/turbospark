          }
        }
      }
    },
    "This model hands no framed call over (%@), so the rescue is what makes tool calls work here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يسلّم هذا النموذج أي استدعاء مؤطّر (%@)، لذا فالإنقاذ هو ما يجعل استدعاءات الأدوات تعمل هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell liefert keinen gerahmten Aufruf (%@), daher sorgt erst die Rettung dafür, dass Tool-Aufrufe hier funktionieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model hands no framed call over (%@), so the rescue is what makes tool calls work here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo no entrega llamadas con formato (%@), así que el rescate es lo que hace funcionar aquí las llamadas a herramientas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle ne fournit aucun appel balisé (%@) : c'est la récupération qui fait fonctionner les appels d'outils ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המודל הזה לא מעביר קריאה ממוסגרת (%@), ולכן ההצלה היא מה שגורם לקריאות כלים לעבוד כאן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मॉडल कोई फ़्रेम किया हुआ कॉल नहीं देता (%@), इसलिए यहाँ टूल कॉल रेस्क्यू से ही काम करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini tidak menyerahkan panggilan berbingkai (%@), jadi penyelamatan inilah yang membuat panggilan alat berfungsi di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello non fornisce chiamate strutturate (%@), quindi è il recupero a far funzionare qui le chiamate agli strumenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルは枠付きの呼び出しを渡しません（%@）。そのため、ここでツール呼び出しを機能させているのは救済処理です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 형식을 갖춘 호출을 넘기지 않으므로(%@), 여기서는 복구 기능 덕분에 도구 호출이 동작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit model levert geen omkaderde aanroep (%@), dus het redden zorgt ervoor dat toolaanroepen hier werken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten model nie przekazuje ujętych w ramy wywołań (%@), więc to ratowanie sprawia, że wywołania narzędzi tu działają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo não entrega chamadas estruturadas (%@), então é a recuperação que faz as chamadas de ferramentas funcionarem aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель не выдаёт размеченных вызовов (%@), поэтому вызовы инструментов здесь работают только благодаря спасению."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här modellen lämnar inga inramade anrop (%@), så det är räddningen som får verktygsanrop att fungera här."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model çerçeveli bir çağrı vermiyor (%@); burada araç çağrılarını çalıştıran şey kurtarmadır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ця модель не видає розмічених викликів (%@), тому виклики інструментів тут працюють лише завдяки порятунку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình này không trả lệnh gọi có khung (%@), nên cơ chế cứu là thứ giúp lệnh gọi công cụ hoạt động ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型不会给出带格式的调用（%@），因此这里的工具调用要靠挽救机制才能工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型不會給出帶格式的呼叫（%@），因此這裡的工具呼叫要靠挽救機制才能運作。"
          }
        }
      }
    },
    "This model is attached to the server. Detach it there, then move it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا النموذج متصل بالخادم. افصله هناك ثم انقله."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Modell ist mit dem Server verbunden. Trennen Sie es dort und verschieben Sie es dann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This model is attached to the server. Detach it there, then move it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo está conectado al servidor. Sepáralo allí y luego muévelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle est rattaché au serveur. Détachez-le là-bas, puis déplacez-le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המודל הזה מחובר לשרת. נתק אותו שם ואז העבר אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मॉडल सर्वर से जुड़ा है। इसे वहाँ अलग करें, फिर स्थानांतरित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini terpasang ke server. Lepaskan di sana, lalu pindahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modello è collegato al server. Scollegalo da lì, poi spostalo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルはサーバーに接続されています。サーバー側で切り離してから移動してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 서버에 연결되어 있습니다. 서버에서 분리한 다음 이동하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit model is gekoppeld aan de server. Ontkoppel het daar en verplaats het daarna."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten model jest podłączony do serwera. Odłącz go tam, a potem przenieś."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este modelo está anexado ao servidor. Desanexe-o lá e depois mova-o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта модель подключена к серверу. Отсоедините её там, затем переместите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den här modellen är ansluten till servern. Koppla från den där och flytta den sedan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model sunucuya bağlı. Orada ayırın, sonra taşıyın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цю модель підключено до сервера. Від'єднайте її там, а потім перемістіть."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình này đang gắn với máy chủ. Hãy tách nó ở đó rồi di chuyển."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型已连接到服务器。请先在服务器中将其分离，再移动。"
          }
        },
        "zh-Hant": {
