    "Start the server and these fill in with its real address.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0634\u063a\u0651\u0644 \u0627\u0644\u062e\u0627\u062f\u0645 \u0648\u0633\u062a\u064f\u0645\u0644\u0623 \u0647\u0630\u0647 \u0628\u0639\u0646\u0648\u0627\u0646\u0647 \u0627\u0644\u062d\u0642\u064a\u0642\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten Sie den Server, dann werden diese mit seiner echten Adresse gef\u00fcllt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start the server and these fill in with its real address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el servidor y estos se rellenar\u00e1n con su direcci\u00f3n real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9marrez le serveur et ces champs se rempliront avec son adresse r\u00e9elle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e2\u05dc \u05d0\u05ea \u05d4\u05e9\u05e8\u05ea \u05d5\u05d4\u05e9\u05d3\u05d5\u05ea \u05d4\u05d0\u05dc\u05d4 \u05d9\u05ea\u05de\u05dc\u05d0\u05d5 \u05d1\u05db\u05ea\u05d5\u05d1\u05ea \u05d4\u05d0\u05de\u05d9\u05ea\u05d9\u05ea \u05e9\u05dc\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0930\u094d\u0935\u0930 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0907\u0928\u092e\u0947\u0902 \u0909\u0938\u0915\u093e \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u092a\u0924\u093e \u092d\u0930 \u091c\u093e\u090f\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jalankan server dan kolom ini akan terisi alamat aslinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia il server e questi verranno compilati con il suo indirizzo reale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b5\u30fc\u30d0\u30fc\u3092\u8d77\u52d5\u3059\u308b\u3068\u3001\u3053\u308c\u3089\u306b\u5b9f\u969b\u306e\u30a2\u30c9\u30ec\u30b9\u304c\u5165\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc11c\ubc84\ub97c \uc2dc\uc791\ud558\uba74 \uc2e4\uc81c \uc8fc\uc18c\ub85c \ucc44\uc6cc\uc9d1\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de server, dan worden deze gevuld met het echte adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchom serwer, a te pola wype\u0142ni\u0105 si\u0119 jego rzeczywistym adresem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicie o servidor e estes ser\u00e3o preenchidos com o endere\u00e7o real dele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0435 \u0441\u0435\u0440\u0432\u0435\u0440, \u0438 \u0437\u0434\u0435\u0441\u044c \u043f\u043e\u044f\u0432\u0438\u0442\u0441\u044f \u0435\u0433\u043e \u043d\u0430\u0441\u0442\u043e\u044f\u0449\u0438\u0439 \u0430\u0434\u0440\u0435\u0441."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Starta servern s\u00e5 fylls dessa i med dess riktiga adress."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunucuyu ba\u015flat\u0131n; bunlar ger\u00e7ek adresiyle dolar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0443\u0441\u0442\u0456\u0442\u044c \u0441\u0435\u0440\u0432\u0435\u0440, \u0456 \u0442\u0443\u0442 \u0437'\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u0439\u043e\u0433\u043e \u0441\u043f\u0440\u0430\u0432\u0436\u043d\u044f \u0430\u0434\u0440\u0435\u0441\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u1edfi \u0111\u1ed9ng m\u00e1y ch\u1ee7 v\u00e0 c\u00e1c m\u1ee5c n\u00e0y s\u1ebd \u0111i\u1ec1n \u0111\u1ecba ch\u1ec9 th\u1eadt c\u1ee7a n\u00f3."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u542f\u52a8\u670d\u52a1\u5668\u540e\uff0c\u8fd9\u4e9b\u4f1a\u586b\u5165\u5176\u771f\u5b9e\u5730\u5740\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u555f\u52d5\u4f3a\u670d\u5668\u5f8c\uff0c\u9019\u4e9b\u6703\u586b\u5165\u5176\u771f\u5be6\u4f4d\u5740\u3002"
          }
        }
      }
    },
