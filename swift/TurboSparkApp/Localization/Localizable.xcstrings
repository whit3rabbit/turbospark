    "Install a model or open an existing model folder to continue this chat.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062b\u0628\u0651\u062a \u0646\u0645\u0648\u0630\u062c\u064b\u0627 \u0623\u0648 \u0627\u0641\u062a\u062d \u0645\u062c\u0644\u062f \u0646\u0645\u0627\u0630\u062c \u0645\u0648\u062c\u0648\u062f\u064b\u0627 \u0644\u0645\u062a\u0627\u0628\u0639\u0629 \u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie ein Modell oder \u00f6ffnen Sie einen vorhandenen Modellordner, um diesen Chat fortzusetzen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install a model or open an existing model folder to continue this chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala un modelo o abre una carpeta de modelos existente para continuar este chat."
