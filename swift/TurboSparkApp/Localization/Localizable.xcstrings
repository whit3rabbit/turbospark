    "Download models from the Discover catalog or scan an external folder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0632\u0651\u0644 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0645\u0646 \u0643\u062a\u0627\u0644\u0648\u062c \u0627\u0644\u0627\u0633\u062a\u0643\u0634\u0627\u0641 \u0623\u0648 \u0627\u0641\u062d\u0635 \u0645\u062c\u0644\u062f\u064b\u0627 \u062e\u0627\u0631\u062c\u064a\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade Modelle aus dem Katalog unter Entdecken herunter oder durchsuche einen externen Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Download models from the Discover catalog or scan an external folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Descarga modelos del cat\u00e1logo de Descubrir o escanea una carpeta externa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00e9l\u00e9chargez des mod\u00e8les depuis le catalogue D\u00e9couvrir ou analysez un dossier externe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e8\u05d9\u05d3\u05d5 \u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05de\u05e7\u05d8\u05dc\u05d5\u05d2 \u05d4\u05d2\u05d9\u05dc\u05d5\u05d9 \u05d0\u05d5 \u05e1\u05e8\u05e7\u05d5 \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u094b\u091c\u0947\u0902 \u0915\u0948\u091f\u0932\u0949\u0917 \u0938\u0947 \u092e\u0949\u0921\u0932 \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0947\u0902 \u092f\u093e \u0915\u094b\u0908 \u092c\u093e\u0939\u0930\u0940 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduh model dari katalog Jelajahi atau pindai folder eksternal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scarica modelli dal catalogo Scopri o analizza una cartella esterna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c\u63a2\u3059\u300d\u30ab\u30bf\u30ed\u30b0\u304b\u3089\u30e2\u30c7\u30eb\u3092\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3059\u308b\u304b\u3001\u5916\u90e8\u30d5\u30a9\u30eb\u30c0\u3092\u30b9\u30ad\u30e3\u30f3\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud0d0\uc0c9 \uce74\ud0c8\ub85c\uadf8\uc5d0\uc11c \ubaa8\ub378\uc744 \ub2e4\uc6b4\ub85c\ub4dc\ud558\uac70\ub098 \uc678\ubd80 \ud3f4\ub354\ub97c \uac80\uc0c9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Download modellen uit de catalogus Ontdekken of scan een externe map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobierz modele z katalogu Odkrywaj lub przeskanuj folder zewn\u0119trzny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Baixe modelos do cat\u00e1logo Descobrir ou verifique uma pasta externa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043a\u0430\u0447\u0430\u0439\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u0438\u0437 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0430 \u00ab\u041e\u0431\u0437\u043e\u0440\u00bb \u0438\u043b\u0438 \u043f\u0440\u043e\u0441\u043a\u0430\u043d\u0438\u0440\u0443\u0439\u0442\u0435 \u0432\u043d\u0435\u0448\u043d\u044e\u044e \u043f\u0430\u043f\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ladda ned modeller fr\u00e5n katalogen Utforska eller s\u00f6k igenom en extern mapp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ke\u015ffet katalo\u011fundan model indirin veya harici bir klas\u00f6r\u00fc taray\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u0456 \u0437 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0443 \u00ab\u041e\u0433\u043b\u044f\u0434\u00bb \u0430\u0431\u043e \u043f\u0440\u043e\u0441\u043a\u0430\u043d\u0443\u0439\u0442\u0435 \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u044e \u043f\u0430\u043f\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i m\u00f4 h\u00ecnh t\u1eeb danh m\u1ee5c Kh\u00e1m ph\u00e1 ho\u1eb7c qu\u00e9t m\u1ed9t th\u01b0 m\u1ee5c ngo\u00e0i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u201c\u53d1\u73b0\u201d\u76ee\u5f55\u4e0b\u8f7d\u6a21\u578b\uff0c\u6216\u626b\u63cf\u5916\u90e8\u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u300c\u63a2\u7d22\u300d\u76ee\u9304\u4e0b\u8f09\u6a21\u578b\uff0c\u6216\u6383\u63cf\u5916\u90e8\u6a94\u6848\u593e\u3002"
          }
        }
      }
    },
