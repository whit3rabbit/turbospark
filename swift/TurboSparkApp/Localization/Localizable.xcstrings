        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043a\u0430\u0447\u0438\u0432\u0430\u0435\u0442 \u043c\u043e\u0434\u0435\u043b\u044c \u0438 \u043d\u0430\u0447\u0438\u043d\u0430\u0435\u0442 \u0441 \u043d\u0435\u0439 \u043d\u043e\u0432\u044b\u0439 \u0447\u0430\u0442"
