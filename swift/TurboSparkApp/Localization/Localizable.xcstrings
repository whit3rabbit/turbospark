            "value": "\u0424\u043e\u0440\u043c\u0430\u0442 \u0456 \u043f\u0430\u043a\u0435\u0442"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1ecbnh d\u1ea1ng v\u00e0 g\u00f3i"
          }
        },
        "zh-Hans": {
