    "Flagged and highlighted when they appear in the rewrite.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flagged and highlighted when they appear in the rewrite."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُشار إليها وتُميَّز عندما تظهر في إعادة الصياغة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden markiert und hervorgehoben, wenn sie in der Umschreibung vorkommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se señalan y resaltan cuando aparecen en la reescritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signalés et surlignés lorsqu'ils apparaissent dans la réécriture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסומנות ומודגשות כשהן מופיעות בשכתוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्लेखन में दिखने पर इन्हें चिह्नित और हाइलाइट किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditandai dan disorot saat muncul di hasil tulis ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segnalate ed evidenziate quando compaiono nella riscrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "書き直しに含まれると警告され、ハイライト表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 쓴 글에 나타나면 표시하고 강조합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemarkeerd en uitgelicht wanneer ze in de herschrijving voorkomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznaczane i wyróżniane, gdy pojawią się w przepisanym tekście."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinalizadas e destacadas quando aparecem na reescrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отмечаются и выделяются, если встречаются в переписанном тексте."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Flaggas och markeras när de förekommer i omskrivningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yazımda geçtiklerinde işaretlenir ve vurgulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Позначаються й виділяються, якщо трапляються в переписаному тексті."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được đánh dấu và tô sáng khi xuất hiện trong bản viết lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "出现在改写结果中时会被标出并高亮显示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "出現在改寫結果中時會被標出並醒目標示。"
          }
        }
      }
    },
