    "Tool `%@` was not offered for this turn.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u062a\u0648\u0641\u064a\u0631 \u0627\u0644\u0623\u062f\u0627\u0629 `%@` \u0644\u0647\u0630\u0647 \u0627\u0644\u062c\u0648\u0644\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Tool `%@` wurde f\u00fcr diesen Durchlauf nicht angeboten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool `%@` was not offered for this turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La herramienta `%@` no se ofreci\u00f3 en este turno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'outil `%@` n'a pas \u00e9t\u00e9 propos\u00e9 pour ce tour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05db\u05dc\u05d9 `%@` \u05dc\u05d0 \u05d4\u05d5\u05e6\u05e2 \u05d1\u05ea\u05d5\u05e8 \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092c\u093e\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f `%@` \u091f\u0942\u0932 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0915\u0930\u093e\u092f\u093e \u0917\u092f\u093e \u0925\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alat `%@` tidak ditawarkan untuk giliran ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo strumento `%@` non \u00e8 stato offerto per questo turno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c4\u30fc\u30eb\u300c%@\u300d\u306f\u3053\u306e\u30bf\u30fc\u30f3\u3067\u63d0\u793a\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` \ub3c4\uad6c\ub294 \uc774\ubc88 \ud134\uc5d0 \uc81c\uacf5\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tool `%@` is niet aangeboden voor deze beurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Narz\u0119dzie `%@` nie zosta\u0142o udost\u0119pnione w tej turze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ferramenta `%@` n\u00e3o foi oferecida nesta rodada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 `%@` \u043d\u0435 \u0431\u044b\u043b \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d \u0432 \u044d\u0442\u043e\u043c \u0445\u043e\u0434\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Verktyget `%@` erbj\u00f6ds inte f\u00f6r den h\u00e4r turen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "`%@` arac\u0131 bu tur i\u00e7in sunulmad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0406\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 `%@` \u043d\u0435 \u0431\u0443\u043b\u043e \u0437\u0430\u043f\u0440\u043e\u043f\u043e\u043d\u043e\u0432\u0430\u043d\u043e \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u0445\u043e\u0434\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00f4ng c\u1ee5 `%@` kh\u00f4ng \u0111\u01b0\u1ee3c cung c\u1ea5p trong l\u01b0\u1ee3t n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u8f6e\u672a\u63d0\u4f9b\u5de5\u5177\u201c%@\u201d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u56de\u5408\u672a\u63d0\u4f9b\u5de5\u5177\u300c%@\u300d\u3002"
          }
        }
      }
    },
