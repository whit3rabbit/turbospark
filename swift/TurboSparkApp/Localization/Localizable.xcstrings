    "Pick a prompt to rewind to. Everything after it is dropped from this conversation; files on disk are not touched.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر مطالبة للإرجاع إليها. يتم إسقاط كل شيء بعدها من هذه المحادثة؛ لا يتم لمس الملفات الموجودة على القرص."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie einen Prompt aus, zu dem zurückgespult werden soll. Alles danach wird aus dieser Konversation verworfen; Dateien auf der Festplatte werden nicht berührt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a prompt to rewind to. Everything after it is dropped from this conversation; files on disk are not touched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un aviso al que rebobinar. Todo lo posterior se eliminará de esta conversación; los archivos en el disco no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une invite à laquelle revenir. Tout ce qui suit est supprimé de cette conversation ; les fichiers sur le disque ne sont pas modifiés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר הנחיה לחזרה אליה. כל מה שאחריה נמחק משיחה זו; קבצים בדיסק אינם מושפעים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिवाइंड करने के लिए एक संकेत चुनें। इसके बाद की हर चीज़ इस बातचीत से हटा दी जाती है; डिस्क पर मौजूद फ़ाइलें अछूती रहती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih prompt untuk memundurkan. Semua hal setelahnya akan dihapus dari percakapan ini; file di disk tidak tersentuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un prompt a cui riavvolgere. Tutto ciò che segue viene eliminato da questa conversazione; i file su disco non vengono toccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "巻き戻すプロンプトを選択します。それ以降のすべてはこの会話から削除されます。ディスク上のファイルは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "되감기할 프롬프트를 선택하세요. 그 이후의 모든 내용은 이 대화에서 삭제됩니다. 디스크의 파일은 변경되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een prompt om naar terug te spoelen. Alles daarna wordt uit dit gesprek verwijderd; bestanden op de schijf worden niet gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz prompt, do którego chcesz cofnąć. Wszystko po nim zostanie usunięte z tej konwersacji; pliki na dysku pozostają nienaruszone."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um prompt para o qual retroceder. Tudo após ele será descartado desta conversa; os arquivos no disco não são afetados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите запрос, к которому нужно вернуться. Все, что было после него, удаляется из этого диалога; файлы на диске не затрагиваются."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en uppmaning att spola tillbaka till. Allt efter det tas bort från den här konversationen; filer på disk rörs inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geri sarmak için bir istem seçin. Ondan sonraki her şey bu sohbetten çıkarılır; diskteki dosyalara dokunulmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть запит, до якого потрібно повернутися. Все, що було після нього, видаляється з цієї розмови; файли на диску не змінюються."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một lời nhắc để tua lại. Mọi thứ sau đó sẽ bị loại bỏ khỏi cuộc trò chuyện này; các tập tin trên đĩa không bị ảnh hưởng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择要回退到的提示词。此提示词之后的所有内容都将从此对话中丢弃；磁盘上的文件不会受到影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇要倒退到的提示詞。此提示詞之後的所有內容都將從此對話中捨棄；磁碟上的檔案不會受到影響。"
          }
        }
      }
    },
    "Pick a row to see what it costs and whether it fits this machine.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر صفا لمعرفة تكلفته وما إذا كان يناسب هذا الجهاز."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie eine Zeile, um zu sehen, was sie kostet und ob sie auf diesen Rechner passt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick a row to see what it costs and whether it fits this machine."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una fila para ver cuánto cuesta y si cabe en este equipo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez une ligne pour voir son coût et si elle tient sur cette machine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר שורה כדי לראות מה היא דורשת והאם היא מתאימה למחשב הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई पंक्ति चुनें ताकि उसकी लागत और यह मशीन के लिए उपयुक्त है या नहीं, यह दिख सके।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih baris untuk melihat biayanya dan apakah muat di komputer ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una riga per vedere quanto costa e se è compatibile con questo computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "行を選ぶと、必要なリソースとこのマシンに収まるかどうかが表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "행을 선택하면 비용과 이 컴퓨터에 맞는지 확인할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een rij om te zien wat die kost en of die op deze computer past."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz wiersz, aby zobaczyć, ile kosztuje i czy zmieści się na tym komputerze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma linha para ver quanto custa e se cabe nesta máquina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите строку, чтобы увидеть ее стоимость и поместится ли она на этом компьютере."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Välj en rad för att se vad den kostar och om den får plats på den här datorn."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maliyetini ve bu makineye sığıp sığmadığını görmek için bir satır seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть рядок, щоб побачити його вартість і чи вміщується він на цьому комп'ютері."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn một hàng để xem chi phí và liệu nó có phù hợp với máy này không."
          }
        },
        "zh-Hans": {
          "stringUnit": {
