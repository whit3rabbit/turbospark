            "value": "Хід думок і міркувань моделі"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quá trình suy nghĩ và dấu vết suy luận của mô hình"
          }
        },
        "zh-Hans": {
          "stringUnit": {
