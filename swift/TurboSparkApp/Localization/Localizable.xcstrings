    "The encrypted asset inventory does not match the database.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0623\u0635\u0648\u0644 \u0627\u0644\u0645\u0634\u0641\u0631\u0629 \u0644\u0627 \u062a\u0637\u0627\u0628\u0642 \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Verzeichnis der verschl\u00fcsselten Assets stimmt nicht mit der Datenbank \u00fcberein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The encrypted asset inventory does not match the database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inventario de recursos cifrados no coincide con la base de datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inventaire des ressources chiffr\u00e9es ne correspond pas \u00e0 la base de donn\u00e9es."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05e0\u05db\u05e1\u05d9\u05dd \u05d4\u05de\u05d5\u05e6\u05e4\u05e0\u05d9\u05dd \u05d0\u05d9\u05e0\u05d4 \u05ea\u05d5\u05d0\u05de\u05ea \u05dc\u05de\u05e1\u05d3 \u05d4\u05e0\u05ea\u05d5\u05e0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u090f\u0938\u0947\u091f \u0938\u0942\u091a\u0940 \u0921\u0947\u091f\u093e\u092c\u0947\u0938 \u0938\u0947 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Inventaris aset terenkripsi tidak cocok dengan basis data."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inventario delle risorse cifrate non corrisponde al database."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6697\u53f7\u5316\u3055\u308c\u305f\u30a2\u30bb\u30c3\u30c8\u306e\u4e00\u89a7\u304c\u30c7\u30fc\u30bf\u30d9\u30fc\u30b9\u3068\u4e00\u81f4\u3057\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc554\ud638\ud654\ub41c \uc790\uc0b0 \ubaa9\ub85d\uc774 \ub370\uc774\ud130\ubca0\uc774\uc2a4\uc640 \uc77c\uce58\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De inventaris van versleutelde assets komt niet overeen met de database."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spis zaszyfrowanych zasob\u00f3w nie zgadza si\u0119 z baz\u0105 danych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O invent\u00e1rio de recursos criptografados n\u00e3o corresponde ao banco de dados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0447\u0435\u043d\u044c \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u043e\u0432 \u043d\u0435 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442 \u0441 \u0431\u0430\u0437\u043e\u0439 \u0434\u0430\u043d\u043d\u044b\u0445."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00f6rteckningen \u00f6ver krypterade tillg\u00e5ngar st\u00e4mmer inte med databasen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eifreli varl\u0131k envanteri veritaban\u0131yla e\u015fle\u015fmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043b\u0456\u043a \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u0445 \u0440\u0435\u0441\u0443\u0440\u0441\u0456\u0432 \u043d\u0435 \u0437\u0431\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0437 \u0431\u0430\u0437\u043e\u044e \u0434\u0430\u043d\u0438\u0445."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh m\u1ee5c t\u00e0i s\u1ea3n \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a kh\u00f4ng kh\u1edbp v\u1edbi c\u01a1 s\u1edf d\u1eef li\u1ec7u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u5bc6\u8d44\u6e90\u6e05\u5355\u4e0e\u6570\u636e\u5e93\u4e0d\u4e00\u81f4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u5bc6\u8cc7\u6e90\u6e05\u55ae\u8207\u8cc7\u6599\u5eab\u4e0d\u4e00\u81f4\u3002"
          }
        }
      }
    },
    "The restored encrypted database failed its integrity check.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u0634\u0644\u062a \u0642\u0627\u0639\u062f\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0645\u0634\u0641\u0631\u0629 \u0627\u0644\u0645\u0633\u062a\u0639\u0627\u062f\u0629 \u0641\u064a \u0641\u062d\u0635 \u0627\u0644\u0633\u0644\u0627\u0645\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die wiederhergestellte verschl\u00fcsselte Datenbank hat die Integrit\u00e4tspr\u00fcfung nicht bestanden."
