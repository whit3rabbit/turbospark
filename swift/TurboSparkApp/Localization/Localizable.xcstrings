    "Show this voice as another speaker. You can separate them again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعرض هذا الصوت كمتحدث آخر. يمكنك فصلهما مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeigt diese Stimme als einen anderen Sprecher. Du kannst sie wieder trennen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show this voice as another speaker. You can separate them again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Muestra esta voz como otro hablante. Puedes volver a separarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affiche cette voix comme un autre locuteur. Vous pourrez les séparer à nouveau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מציג את הקול הזה כדובר אחר. אפשר להפריד ביניהם שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस आवाज़ को किसी दूसरे वक्ता के रूप में दिखाता है। आप उन्हें फिर से अलग कर सकते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menampilkan suara ini sebagai pembicara lain. Anda bisa memisahkannya lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra questa voce come un altro parlante. Puoi separarli di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この声を別の話者として表示します。あとで分離できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 목소리를 다른 화자로 표시합니다. 다시 분리할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toont deze stem als een andere spreker. Je kunt ze weer scheiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokazuje ten głos jako innego mówcę. Możesz je ponownie rozdzielić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra esta voz como outro falante. Você pode separá-los de novo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Показывает этот голос как другого говорящего. Их можно снова разделить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visar den här rösten som en annan talare. Du kan skilja dem åt igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sesi başka bir konuşmacı olarak gösterir. Onları yeniden ayırabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Показує цей голос як іншого мовця. Їх можна знову розділити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiển thị giọng này như một người nói khác. Bạn có thể tách lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将此声音显示为另一位说话人。之后可以再分开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將此聲音顯示為另一位說話者。之後可以再分開。"
          }
        }
      }
    },
