          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encrypted backup restored as a locked profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Copia de seguridad cifrada restaurada como perfil bloqueado."
          }
        },
        "fr": {
