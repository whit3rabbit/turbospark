    "Reusable instructions and workflows the assistant can load into a conversation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0648\u0633\u064a\u0631 \u0639\u0645\u0644 \u0642\u0627\u0628\u0644\u0629 \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u064a\u0645\u0643\u0646 \u0644\u0644\u0645\u0633\u0627\u0639\u062f \u062a\u062d\u0645\u064a\u0644\u0647\u0627 \u0641\u064a \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederverwendbare Anweisungen und Abl\u00e4ufe, die der Assistent in eine Unterhaltung laden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reusable instructions and workflows the assistant can load into a conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrucciones y flujos de trabajo reutilizables que el asistente puede cargar en una conversaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Instructions et flux de travail r\u00e9utilisables que l\u2019assistant peut charger dans une conversation."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e8\u05d0\u05d5\u05ea \u05d5\u05ea\u05d4\u05dc\u05d9\u05db\u05d9 \u05e2\u05d1\u05d5\u05d3\u05d4 \u05dc\u05e9\u05d9\u05de\u05d5\u05e9 \u05d7\u05d5\u05d6\u05e8 \u05e9\u05d4\u05e2\u05d5\u05d6\u05e8 \u05d9\u05db\u05d5\u05dc \u05dc\u05d8\u05e2\u05d5\u05df \u05dc\u05e9\u05d9\u05d7\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928: \u0909\u092a\u092f\u094b\u0917 \u092f\u094b\u0917\u094d\u092f \u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0914\u0930 \u0935\u0930\u094d\u0915\u092b\u093c\u094d\u0932\u094b, \u091c\u093f\u0928\u094d\u0939\u0947\u0902 \u0938\u0939\u093e\u092f\u0915 \u0915\u093f\u0938\u0940 \u092c\u093e\u0924\u091a\u0940\u0924 \u092e\u0947\u0902 \u0932\u094b\u0921 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Instruksi dan alur kerja yang dapat dipakai ulang, yang dapat dimuat asisten ke dalam percakapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Istruzioni e flussi di lavoro riutilizzabili che l\u2019assistente pu\u00f2 caricare in una conversazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30b7\u30b9\u30bf\u30f3\u30c8\u304c\u4f1a\u8a71\u306b\u8aad\u307f\u8fbc\u3081\u308b\u3001\u518d\u5229\u7528\u53ef\u80fd\u306a\u6307\u793a\u3068\u30ef\u30fc\u30af\u30d5\u30ed\u30fc\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5b4\uc2dc\uc2a4\ud134\ud2b8\uac00 \ub300\ud654\uc5d0 \ubd88\ub7ec\uc62c \uc218 \uc788\ub294 \uc7ac\uc0ac\uc6a9 \uac00\ub2a5\ud55c \uc9c0\uce68\uacfc \uc6cc\ud06c\ud50c\ub85c\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herbruikbare instructies en werkstromen die de assistent in een gesprek kan laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instrukcje i przep\u0142ywy pracy wielokrotnego u\u017cytku, kt\u00f3re asystent mo\u017ce wczyta\u0107 do rozmowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instru\u00e7\u00f5es e fluxos de trabalho reutiliz\u00e1veis que o assistente pode carregar em uma conversa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043d\u043e\u0433\u043e\u0440\u0430\u0437\u043e\u0432\u044b\u0435 \u0438\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0438\u0438 \u0438 \u0441\u0446\u0435\u043d\u0430\u0440\u0438\u0438, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u0430\u0441\u0441\u0438\u0441\u0442\u0435\u043d\u0442 \u043c\u043e\u0436\u0435\u0442 \u0437\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c \u0432 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5teranv\u00e4ndbara instruktioner och arbetsfl\u00f6den som assistenten kan l\u00e4sa in i en konversation."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistan\u0131n bir sohbete y\u00fckleyebilece\u011fi, yeniden kullan\u0131labilir talimatlar ve i\u015f ak\u0131\u015flar\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0430\u0433\u0430\u0442\u043e\u0440\u0430\u0437\u043e\u0432\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043a\u0446\u0456\u0457 \u0442\u0430 \u0441\u0446\u0435\u043d\u0430\u0440\u0456\u0457, \u044f\u043a\u0456 \u0430\u0441\u0438\u0441\u0442\u0435\u043d\u0442 \u043c\u043e\u0436\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438 \u0432 \u0440\u043e\u0437\u043c\u043e\u0432\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u01b0\u1edbng d\u1eabn v\u00e0 quy tr\u00ecnh c\u00f3 th\u1ec3 d\u00f9ng l\u1ea1i m\u00e0 tr\u1ee3 l\u00fd c\u00f3 th\u1ec3 t\u1ea3i v\u00e0o cu\u1ed9c tr\u00f2 chuy\u1ec7n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a9\u624b\u53ef\u4ee5\u52a0\u8f7d\u5230\u5bf9\u8bdd\u4e2d\u7684\u53ef\u590d\u7528\u8bf4\u660e\u548c\u5de5\u4f5c\u6d41\u7a0b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a9\u7406\u53ef\u4ee5\u8f09\u5165\u5230\u5c0d\u8a71\u4e2d\u7684\u53ef\u91cd\u8907\u4f7f\u7528\u6307\u793a\u8207\u5de5\u4f5c\u6d41\u7a0b\u3002"
          }
        }
      }
    },
    "Reveal source file: %@": {
