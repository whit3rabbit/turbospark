    "Hugging Face denied this file. Sign in under Settings > Models if it is gated.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض Hugging Face هذا الملف. إذا كان مقيّد الوصول، فسجّل الدخول من الإعدادات > النماذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face hat diese Datei verweigert. Wenn sie zugangsbeschränkt ist, melden Sie sich unter Einstellungen > Modelle an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face denied this file. Sign in under Settings > Models if it is gated."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face denegó este archivo. Si tiene acceso restringido, inicia sesión en Ajustes > Modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face a refusé ce fichier. S'il est à accès restreint, connectez-vous dans Paramètres > Modèles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face דחה את הקובץ הזה. אם הגישה אליו מוגבלת, התחבר דרך הגדרות > מודלים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face ने इस फ़ाइल को अस्वीकार किया। यदि यह प्रतिबंधित है, तो सेटिंग्स > मॉडल में साइन इन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face menolak file ini. Jika aksesnya dibatasi, masuk di Pengaturan > Model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face ha negato questo file. Se è ad accesso limitato, accedi in Impostazioni > Modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face がこのファイルへのアクセスを拒否しました。制限付きの場合は、設定 > モデル でサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face가 이 파일을 거부했습니다. 접근이 제한된 경우 설정 > 모델에서 로그인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face heeft dit bestand geweigerd. Als het afgeschermd is, log dan in via Instellingen > Modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face odmówił dostępu do tego pliku. Jeśli dostęp jest ograniczony, zaloguj się w Ustawienia > Modele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Hugging Face negou este arquivo. Se ele for restrito, entre em Configurações > Modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face отказал в доступе к этому файлу. Если доступ ограничен, войдите в Настройки > Модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face nekade den här filen. Om den är spärrad loggar du in under Inställningar > Modeller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face bu dosyayı reddetti. Erişimi kısıtlıysa Ayarlar > Modeller bölümünden oturum açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face відмовив у доступі до цього файлу. Якщо доступ обмежено, увійдіть у Параметри > Моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face đã từ chối tệp này. Nếu tệp bị giới hạn quyền truy cập, hãy đăng nhập trong Cài đặt > Mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 拒绝了此文件。如果它受访问限制，请在“设置 > 模型”中登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 拒絕了此檔案。如果它受存取限制，請在「設定 > 模型」中登入。"
          }
        }
      }
    },
