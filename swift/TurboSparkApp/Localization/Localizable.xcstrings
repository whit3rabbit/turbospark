    "Manage Model Context Protocol servers, external tools, and integrations.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u062f\u0631 \u062e\u0648\u0627\u062f\u0645 Model Context Protocol \u0648\u0627\u0644\u0623\u062f\u0648\u0627\u062a \u0627\u0644\u062e\u0627\u0631\u062c\u064a\u0629 \u0648\u0627\u0644\u062a\u0643\u0627\u0645\u0644\u0627\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwalten Sie Model-Context-Protocol-Server, externe Tools und Integrationen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage Model Context Protocol servers, external tools, and integrations."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona servidores Model Context Protocol, herramientas externas e integraciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00e9rez les serveurs Model Context Protocol, les outils externes et les int\u00e9grations."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d4\u05dc \u05e9\u05e8\u05ea\u05d9 Model Context Protocol, \u05db\u05dc\u05d9\u05dd \u05d7\u05d9\u05e6\u05d5\u05e0\u05d9\u05d9\u05dd \u05d5\u05d0\u05d9\u05e0\u05d8\u05d2\u05e8\u05e6\u05d9\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Context Protocol \u0938\u0930\u094d\u0935\u0930, \u092c\u093e\u0939\u0930\u0940 \u091f\u0942\u0932 \u0914\u0930 \u090f\u0915\u0940\u0915\u0930\u0923 \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola server Model Context Protocol, alat eksternal, dan integrasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci server Model Context Protocol, strumenti esterni e integrazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Context Protocol \u30b5\u30fc\u30d0\u30fc\u3001\u5916\u90e8\u30c4\u30fc\u30eb\u3001\u9023\u643a\u3092\u7ba1\u7406\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Context Protocol \uc11c\ubc84, \uc678\ubd80 \ub3c4\uad6c, \ud1b5\ud569\uc744 \uad00\ub9ac\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer Model Context Protocol-servers, externe tools en integraties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarz\u0105dzaj serwerami Model Context Protocol, narz\u0119dziami zewn\u0119trznymi i integracjami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie servidores Model Context Protocol, ferramentas externas e integra\u00e7\u00f5es."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043f\u0440\u0430\u0432\u043b\u044f\u0439\u0442\u0435 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u043c\u0438 Model Context Protocol, \u0432\u043d\u0435\u0448\u043d\u0438\u043c\u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u0438 \u0438\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0438\u044f\u043c\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hantera Model Context Protocol-servrar, externa verktyg och integrationer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model Context Protocol sunucular\u0131n\u0131, harici ara\u00e7lar\u0131 ve t\u00fcmle\u015ftirmeleri y\u00f6netin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0435\u0440\u0443\u0439\u0442\u0435 \u0441\u0435\u0440\u0432\u0435\u0440\u0430\u043c\u0438 Model Context Protocol, \u0437\u043e\u0432\u043d\u0456\u0448\u043d\u0456\u043c\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430\u043c\u0438 \u0442\u0430 \u0456\u043d\u0442\u0435\u0433\u0440\u0430\u0446\u0456\u044f\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Qu\u1ea3n l\u00fd m\u00e1y ch\u1ee7 Model Context Protocol, c\u00f4ng c\u1ee5 b\u00ean ngo\u00e0i v\u00e0 t\u00edch h\u1ee3p."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7ba1\u7406 Model Context Protocol \u670d\u52a1\u5668\u3001\u5916\u90e8\u5de5\u5177\u548c\u96c6\u6210\u3002"
          }
        },
        "zh-Hant": {
