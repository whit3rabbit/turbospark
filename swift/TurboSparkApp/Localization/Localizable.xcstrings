    "Allow microphone access in the macOS prompt to continue.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone access in the macOS prompt to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite el acceso al micr\u00f3fono en el aviso de macOS para continuar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l\u2019acc\u00e8s au microphone dans la demande de macOS pour continuer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube den Mikrofonzugriff in der macOS-Abfrage, um fortzufahren."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti l\u2019accesso al microfono nella richiesta di macOS per continuare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Permita o acesso ao microfone na solicita\u00e7\u00e3o do macOS para continuar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta microfoontoegang toe in de macOS-melding om door te gaan."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till\u00e5t mikrofon\u00e5tkomst i macOS-dialogrutan f\u00f6r att forts\u00e4tta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aby kontynuowa\u0107, zezw\u00f3l na dost\u0119p do mikrofonu w oknie macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek i\u00e7in macOS isteminde mikrofon eri\u015fimine izin verin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Izinkan akses mikrofon pada permintaan macOS untuk melanjutkan."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0442\u043e\u0431\u044b \u043f\u0440\u043e\u0434\u043e\u043b\u0436\u0438\u0442\u044c, \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u043a \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d\u0443 \u0432 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 macOS."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0429\u043e\u0431 \u043f\u0440\u043e\u0434\u043e\u0432\u0436\u0438\u0442\u0438, \u0434\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 \u0434\u043e\u0441\u0442\u0443\u043f \u0434\u043e \u043c\u0456\u043a\u0440\u043e\u0444\u043e\u043d\u0430 \u0432 \u0437\u0430\u043f\u0438\u0442\u0456 macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho ph\u00e9p truy c\u1eadp micr\u00f4 trong l\u1eddi nh\u1eafc c\u1ee7a macOS \u0111\u1ec3 ti\u1ebfp t\u1ee5c."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d9a\u884c\u3059\u308b\u306b\u306f\u3001macOS\u306e\u78ba\u8a8d\u753b\u9762\u3067\u30de\u30a4\u30af\u3078\u306e\u30a2\u30af\u30bb\u30b9\u3092\u8a31\u53ef\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uacc4\uc18d\ud558\ub824\uba74 macOS \uad8c\ud55c \uc694\uccad\uc5d0\uc11c \ub9c8\uc774\ud06c \uc811\uadfc\uc744 \ud5c8\uc6a9\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5728 macOS \u63d0\u793a\u4e2d\u5141\u8bb8\u8bbf\u95ee\u9ea6\u514b\u98ce\u4ee5\u7ee7\u7eed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5728 macOS \u63d0\u793a\u4e2d\u5141\u8a31\u53d6\u7528\u9ea5\u514b\u98a8\u4ee5\u7e7c\u7e8c\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u0645\u062d \u0628\u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0641\u064a \u0645\u0637\u0627\u0644\u0628\u0629 macOS \u0644\u0644\u0645\u062a\u0627\u0628\u0639\u0629."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05d3\u05d9 \u05dc\u05d4\u05de\u05e9\u05d9\u05da, \u05d9\u05e9 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05d2\u05d9\u05e9\u05d4 \u05dc\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05d1\u05d1\u05e7\u05e9\u05d4 \u05e9\u05dc macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u093e\u0930\u0940 \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f macOS \u0915\u0947 \u0905\u0928\u0941\u092e\u0924\u093f \u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u0915\u093e \u0910\u0915\u094d\u0938\u0947\u0938 \u0926\u0947\u0902\u0964"
          }
        }
      }
    },
    "Allow screen and system audio recording in System Settings if prompted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow screen and system audio recording in System Settings if prompted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si se solicita, permite la grabaci\u00f3n de pantalla y audio del sistema en Ajustes del Sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si cela vous est demand\u00e9, autorisez l\u2019enregistrement de l\u2019\u00e9cran et du son du syst\u00e8me dans R\u00e9glages Syst\u00e8me."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube bei Aufforderung die Aufnahme von Bildschirm und Systemaudio in den Systemeinstellungen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se richiesto, consenti la registrazione dello schermo e dell\u2019audio di sistema in Impostazioni di Sistema."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Se solicitado, permita a grava\u00e7\u00e3o de tela e \u00e1udio do sistema nos Ajustes do Sistema."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sta scherm- en systeemaudio-opname toe in Systeeminstellingen als daarom wordt gevraagd."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Till\u00e5t inspelning av sk\u00e4rm och systemljud i Systeminst\u00e4llningar om du uppmanas till det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je\u015bli pojawi si\u0119 pro\u015bba, zezw\u00f3l na nagrywanie ekranu i d\u017awi\u0119ku systemowego w Ustawieniach systemowych."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130stendi\u011finde Sistem Ayarlar\u0131\u2019nda ekran ve sistem sesi kayd\u0131na izin verin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika diminta, izinkan perekaman layar dan audio sistem di Pengaturan Sistem."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438 \u0437\u0430\u043f\u0440\u043e\u0441\u0435 \u0440\u0430\u0437\u0440\u0435\u0448\u0438\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u044c \u044d\u043a\u0440\u0430\u043d\u0430 \u0438 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0430 \u0432 \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u044b\u0445 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f\u043a\u0449\u043e \u0437\u2019\u044f\u0432\u0438\u0442\u044c\u0441\u044f \u0437\u0430\u043f\u0438\u0442, \u0434\u043e\u0437\u0432\u043e\u043b\u044c\u0442\u0435 \u0437\u0430\u043f\u0438\u0441 \u0435\u043a\u0440\u0430\u043d\u0430 \u0442\u0430 \u0441\u0438\u0441\u0442\u0435\u043c\u043d\u043e\u0433\u043e \u0437\u0432\u0443\u043a\u0443 \u0432 \u0421\u0438\u0441\u0442\u0435\u043c\u043d\u0438\u0445 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0430\u0445."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u1ebfu \u0111\u01b0\u1ee3c nh\u1eafc, h\u00e3y cho ph\u00e9p ghi m\u00e0n h\u00ecnh v\u00e0 \u00e2m thanh h\u1ec7 th\u1ed1ng trong C\u00e0i \u0111\u1eb7t h\u1ec7 th\u1ed1ng."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c42\u3081\u3089\u308c\u305f\u5834\u5408\u306f\u3001\u30b7\u30b9\u30c6\u30e0\u8a2d\u5b9a\u3067\u753b\u9762\u3068\u30b7\u30b9\u30c6\u30e0\u30aa\u30fc\u30c7\u30a3\u30aa\u306e\u9332\u97f3\u3092\u8a31\u53ef\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc694\uccad\uc774 \ud45c\uc2dc\ub418\uba74 \uc2dc\uc2a4\ud15c \uc124\uc815\uc5d0\uc11c \ud654\uba74 \ubc0f \uc2dc\uc2a4\ud15c \uc624\ub514\uc624 \ub179\uc74c\uc744 \ud5c8\uc6a9\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u679c\u51fa\u73b0\u63d0\u793a\uff0c\u8bf7\u5728\u7cfb\u7edf\u8bbe\u7f6e\u4e2d\u5141\u8bb8\u5f55\u5236\u5c4f\u5e55\u548c\u7cfb\u7edf\u97f3\u9891\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5982\u51fa\u73fe\u63d0\u793a\uff0c\u8acb\u5728\u7cfb\u7d71\u8a2d\u5b9a\u4e2d\u5141\u8a31\u9304\u88fd\u87a2\u5e55\u548c\u7cfb\u7d71\u97f3\u8a0a\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u0645\u062d \u0628\u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u0634\u0627\u0634\u0629 \u0648\u0635\u0648\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0646\u0638\u0627\u0645 \u0625\u0630\u0627 \u0637\u064f\u0644\u0628 \u0645\u0646\u0643 \u0630\u0644\u0643."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05dd \u05ea\u05d5\u05e4\u05d9\u05e2 \u05d1\u05e7\u05e9\u05d4, \u05d9\u05e9 \u05dc\u05d0\u05e4\u05e9\u05e8 \u05d4\u05e7\u05dc\u05d8\u05ea \u05de\u05e1\u05da \u05d5\u05e9\u05de\u05e2 \u05de\u05e2\u05e8\u05db\u05ea \u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d4\u05de\u05e2\u05e8\u05db\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0926\u093f \u0915\u0939\u093e \u091c\u093e\u090f, \u0924\u094b \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u091c\u093c \u092e\u0947\u0902 \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u0914\u0930 \u0938\u093f\u0938\u094d\u091f\u092e \u0911\u0921\u093f\u092f\u094b \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0902\u0964"
          }
        }
      }
    },
    "Recording setup cancelled. Start again when you are ready.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording setup cancelled. Start again when you are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configuraci\u00f3n de grabaci\u00f3n cancelada. Vuelve a empezar cuando est\u00e9s listo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00e9paration de l\u2019enregistrement annul\u00e9e. Recommencez lorsque vous \u00eates pr\u00eat."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahmevorbereitung abgebrochen. Starte erneut, wenn du bereit bist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Preparazione della registrazione annullata. Ricomincia quando vuoi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepara\u00e7\u00e3o da grava\u00e7\u00e3o cancelada. Comece novamente quando estiver pronto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnamevoorbereiding geannuleerd. Begin opnieuw wanneer je klaar bent."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelningsf\u00f6rberedelsen avbr\u00f6ts. B\u00f6rja igen n\u00e4r du \u00e4r redo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anulowano przygotowanie nagrywania. Rozpocznij ponownie, gdy b\u0119dziesz gotowy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kay\u0131t haz\u0131rl\u0131\u011f\u0131 iptal edildi. Haz\u0131r oldu\u011funuzda yeniden ba\u015flay\u0131n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persiapan perekaman dibatalkan. Mulai lagi saat Anda siap."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0430 \u0437\u0430\u043f\u0438\u0441\u0438 \u043e\u0442\u043c\u0435\u043d\u0435\u043d\u0430. \u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0441\u043d\u043e\u0432\u0430, \u043a\u043e\u0433\u0434\u0430 \u0431\u0443\u0434\u0435\u0442\u0435 \u0433\u043e\u0442\u043e\u0432\u044b."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0456\u0434\u0433\u043e\u0442\u043e\u0432\u043a\u0443 \u0437\u0430\u043f\u0438\u0441\u0443 \u0441\u043a\u0430\u0441\u043e\u0432\u0430\u043d\u043e. \u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0437\u043d\u043e\u0432\u0443, \u043a\u043e\u043b\u0438 \u0431\u0443\u0434\u0435\u0442\u0435 \u0433\u043e\u0442\u043e\u0432\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 h\u1ee7y chu\u1ea9n b\u1ecb ghi \u00e2m. B\u1eaft \u0111\u1ea7u l\u1ea1i khi b\u1ea1n s\u1eb5n s\u00e0ng."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9332\u97f3\u306e\u6e96\u5099\u3092\u30ad\u30e3\u30f3\u30bb\u30eb\u3057\u307e\u3057\u305f\u3002\u6e96\u5099\u304c\u3067\u304d\u305f\u3089\u3001\u3082\u3046\u4e00\u5ea6\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub179\uc74c \uc900\ube44\uac00 \ucde8\uc18c\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc900\ube44\ub418\uba74 \ub2e4\uc2dc \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f55\u97f3\u51c6\u5907\u5df2\u53d6\u6d88\u3002\u51c6\u5907\u597d\u540e\u8bf7\u91cd\u65b0\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9304\u97f3\u6e96\u5099\u5df2\u53d6\u6d88\u3002\u6e96\u5099\u597d\u5f8c\u8acb\u91cd\u65b0\u958b\u59cb\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0625\u0644\u063a\u0627\u0621 \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u062a\u0633\u062c\u064a\u0644. \u0627\u0628\u062f\u0623 \u0645\u0646 \u062c\u062f\u064a\u062f \u0639\u0646\u062f\u0645\u0627 \u062a\u0643\u0648\u0646 \u062c\u0627\u0647\u0632\u064b\u0627."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05db\u05e0\u05ea \u05d4\u05d4\u05e7\u05dc\u05d8\u05d4 \u05d1\u05d5\u05d8\u05dc\u05d4. \u05d0\u05e4\u05e9\u05e8 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc \u05e9\u05d5\u05d1 \u05db\u05e9\u05ea\u05d4\u05d9\u05d5 \u05de\u05d5\u05db\u05e0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0915\u0940 \u0924\u0948\u092f\u093e\u0930\u0940 \u0930\u0926\u094d\u0926 \u0915\u0930 \u0926\u0940 \u0917\u0908\u0964 \u0924\u0948\u092f\u093e\u0930 \u0939\u094b\u0928\u0947 \u092a\u0930 \u092b\u093f\u0930 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
