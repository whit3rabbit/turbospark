        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e1\u05d1\u05e8 \u05db\u05d9\u05e6\u05d3 \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05d6\u05d4 \u05e2\u05d5\u05d1\u05d3"
