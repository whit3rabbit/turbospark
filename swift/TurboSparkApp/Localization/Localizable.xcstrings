    },
    "The command '%@' was not found on PATH or in any standard tool directory. Install it first, then add this server.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u0639\u062b\u0631 \u0639\u0644\u0649 \u0627\u0644\u0623\u0645\u0631 \u00ab%@\u00bb \u0641\u064a PATH \u0623\u0648 \u0641\u064a \u0623\u064a \u0645\u062c\u0644\u062f \u0623\u062f\u0648\u0627\u062a \u0642\u064a\u0627\u0633\u064a. \u062b\u0628\u0651\u062a\u0647 \u0623\u0648\u0644\u064b\u0627\u060c \u062b\u0645 \u0623\u0636\u0641 \u0647\u0630\u0627 \u0627\u0644\u062e\u0627\u062f\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Befehl \u201e%@\u201c wurde weder im PATH noch in einem Standardverzeichnis f\u00fcr Tools gefunden. Installieren Sie ihn zuerst und f\u00fcgen Sie dann diesen Server hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The command '%@' was not found on PATH or in any standard tool directory. Install it first, then add this server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontr\u00f3 el comando \u00ab%@\u00bb en PATH ni en ning\u00fan directorio est\u00e1ndar de herramientas. Inst\u00e1lalo primero y luego a\u00f1ade este servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La commande \u00ab %@ \u00bb est introuvable dans le PATH et dans les dossiers d'outils standard. Installez-la d'abord, puis ajoutez ce serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e4\u05e7\u05d5\u05d3\u05d4 \"%@\" \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d4 \u05d1-PATH \u05d0\u05d5 \u05d1\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05db\u05dc\u05d9\u05dd \u05e1\u05d8\u05e0\u05d3\u05e8\u05d8\u05d9\u05ea \u05db\u05dc\u05e9\u05d4\u05d9. \u05d4\u05ea\u05e7\u05df \u05d0\u05d5\u05ea\u05d4 \u05ea\u05d7\u05d9\u05dc\u05d4 \u05d5\u05d0\u05d6 \u05d4\u05d5\u05e1\u05e3 \u05e9\u05e8\u05ea \u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u092e\u093e\u0902\u0921 '%@' PATH \u092f\u093e \u0915\u093f\u0938\u0940 \u092d\u0940 \u092e\u093e\u0928\u0915 \u091f\u0942\u0932 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0940\u0964 \u092a\u0939\u0932\u0947 \u0907\u0938\u0947 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 \u092f\u0939 \u0938\u0930\u094d\u0935\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perintah '%@' tidak ditemukan di PATH atau di direktori alat standar mana pun. Pasang terlebih dahulu, lalu tambahkan server ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il comando '%@' non \u00e8 stato trovato nel PATH n\u00e9 in alcuna directory standard degli strumenti. Installalo prima, poi aggiungi questo server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30de\u30f3\u30c9\u300c%@\u300d\u304c PATH \u306b\u3082\u6a19\u6e96\u306e\u30c4\u30fc\u30eb\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u306b\u3082\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3002\u5148\u306b\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u304b\u3089\u3001\u3053\u306e\u30b5\u30fc\u30d0\u30fc\u3092\u8ffd\u52a0\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \uba85\ub839\uc744 PATH\ub098 \ud45c\uc900 \ub3c4\uad6c \ub514\ub809\ud130\ub9ac\uc5d0\uc11c \ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc124\uce58\ud55c \ub2e4\uc74c \uc774 \uc11c\ubc84\ub97c \ucd94\uac00\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opdracht '%@' is niet gevonden in PATH of in een standaardmap voor hulpmiddelen. Installeer deze eerst en voeg daarna deze server toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono polecenia \u201e%@\u201d w PATH ani w \u017cadnym standardowym katalogu narz\u0119dzi. Najpierw je zainstaluj, a potem dodaj ten serwer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O comando '%@' n\u00e3o foi encontrado no PATH nem em nenhum diret\u00f3rio padr\u00e3o de ferramentas. Instale-o primeiro e depois adicione este servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043c\u0430\u043d\u0434\u0430 \u00ab%@\u00bb \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u0430 \u043d\u0438 \u0432 PATH, \u043d\u0438 \u0432 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u044b\u0445 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0430\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u0435\u0435, \u0437\u0430\u0442\u0435\u043c \u0434\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u044d\u0442\u043e\u0442 \u0441\u0435\u0440\u0432\u0435\u0440."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kommandot '%@' hittades inte i PATH eller i n\u00e5gon standardkatalog f\u00f6r verktyg. Installera det f\u00f6rst och l\u00e4gg sedan till den h\u00e4r servern."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' komutu PATH i\u00e7inde veya herhangi bir standart ara\u00e7 dizininde bulunamad\u0131. \u00d6nce y\u00fckleyin, ard\u0131ndan bu sunucuyu ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043c\u0430\u043d\u0434\u0443 \u00ab%@\u00bb \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e \u043d\u0456 \u0432 PATH, \u043d\u0456 \u0432 \u0441\u0442\u0430\u043d\u0434\u0430\u0440\u0442\u043d\u0438\u0445 \u043a\u0430\u0442\u0430\u043b\u043e\u0433\u0430\u0445 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432. \u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u0457\u0457, \u0430 \u043f\u043e\u0442\u0456\u043c \u0434\u043e\u0434\u0430\u0439\u0442\u0435 \u0446\u0435\u0439 \u0441\u0435\u0440\u0432\u0435\u0440."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y l\u1ec7nh '%@' trong PATH ho\u1eb7c b\u1ea5t k\u1ef3 th\u01b0 m\u1ee5c c\u00f4ng c\u1ee5 ti\u00eau chu\u1ea9n n\u00e0o. H\u00e3y c\u00e0i \u0111\u1eb7t l\u1ec7nh n\u00e0y tr\u01b0\u1edbc, r\u1ed3i th\u00eam m\u00e1y ch\u1ee7 n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 PATH \u6216\u4efb\u4f55\u6807\u51c6\u5de5\u5177\u76ee\u5f55\u4e2d\u90fd\u627e\u4e0d\u5230\u547d\u4ee4\u201c%@\u201d\u3002\u8bf7\u5148\u5b89\u88c5\u5b83\uff0c\u7136\u540e\u518d\u6dfb\u52a0\u6b64\u670d\u52a1\u5668\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 PATH \u6216\u4efb\u4f55\u6a19\u6e96\u5de5\u5177\u76ee\u9304\u4e2d\u90fd\u627e\u4e0d\u5230\u6307\u4ee4\u300c%@\u300d\u3002\u8acb\u5148\u5b89\u88dd\u5b83\uff0c\u518d\u65b0\u589e\u6b64\u4f3a\u670d\u5668\u3002"
          }
        }
      }
    },
    "A server named '%@' already exists. Rename or remove it first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0648\u062c\u062f \u062e\u0627\u062f\u0645 \u0628\u0627\u0633\u0645 \u00ab%@\u00bb \u0628\u0627\u0644\u0641\u0639\u0644. \u0623\u0639\u062f \u062a\u0633\u0645\u064a\u062a\u0647 \u0623\u0648 \u0623\u0632\u0644\u0647 \u0623\u0648\u0644\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Server mit dem Namen \u201e%@\u201c ist bereits vorhanden. Benennen Sie ihn zuerst um oder entfernen Sie ihn."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A server named '%@' already exists. Rename or remove it first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya existe un servidor llamado \u00ab%@\u00bb. C\u00e1mbiale el nombre o qu\u00edtalo primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur nomm\u00e9 \u00ab %@ \u00bb existe d\u00e9j\u00e0. Renommez-le ou supprimez-le d'abord."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05e8\u05ea \u05d1\u05e9\u05dd \"%@\" \u05db\u05d1\u05e8 \u05e7\u05d9\u05d9\u05dd. \u05e9\u05e0\u05d4 \u05d0\u05ea \u05e9\u05de\u05d5 \u05d0\u05d5 \u05d4\u05e1\u05e8 \u05d0\u05d5\u05ea\u05d5 \u05e7\u05d5\u05d3\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0928\u093e\u092e \u0915\u093e \u0938\u0930\u094d\u0935\u0930 \u092a\u0939\u0932\u0947 \u0938\u0947 \u092e\u094c\u091c\u0942\u0926 \u0939\u0948\u0964 \u092a\u0939\u0932\u0947 \u0909\u0938\u0915\u093e \u0928\u093e\u092e \u092c\u0926\u0932\u0947\u0902 \u092f\u093e \u0909\u0938\u0947 \u0939\u091f\u093e\u090f\u0901\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server bernama '%@' sudah ada. Ganti nama atau hapus terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste gi\u00e0 un server denominato '%@'. Rinominalo o rimuovilo prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u3068\u3044\u3046\u540d\u524d\u306e\u30b5\u30fc\u30d0\u30fc\u306f\u3059\u3067\u306b\u5b58\u5728\u3057\u307e\u3059\u3002\u5148\u306b\u540d\u524d\u3092\u5909\u66f4\u3059\u308b\u304b\u524a\u9664\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc774\ub77c\ub294 \uc11c\ubc84\uac00 \uc774\ubbf8 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc774\ub984\uc744 \ubc14\uafb8\uac70\ub098 \uc81c\uac70\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een server met de naam '%@'. Wijzig eerst de naam of verwijder deze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer o nazwie \u201e%@\u201d ju\u017c istnieje. Najpierw zmie\u0144 jego nazw\u0119 lub go usu\u0144."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "J\u00e1 existe um servidor chamado '%@'. Renomeie-o ou remova-o primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0440\u0432\u0435\u0440 \u0441 \u0438\u043c\u0435\u043d\u0435\u043c \u00ab%@\u00bb \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043f\u0435\u0440\u0435\u0438\u043c\u0435\u043d\u0443\u0439\u0442\u0435 \u0438\u043b\u0438 \u0443\u0434\u0430\u043b\u0438\u0442\u0435 \u0435\u0433\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det finns redan en server med namnet '%@'. Byt namn p\u00e5 den eller ta bort den f\u00f6rst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' adl\u0131 bir sunucu zaten var. \u00d6nce yeniden adland\u0131r\u0131n veya kald\u0131r\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0440\u0432\u0435\u0440 \u0437 \u043d\u0430\u0437\u0432\u043e\u044e \u00ab%@\u00bb \u0443\u0436\u0435 \u0456\u0441\u043d\u0443\u0454. \u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u043f\u0435\u0440\u0435\u0439\u043c\u0435\u043d\u0443\u0439\u0442\u0435 \u0430\u0431\u043e \u0432\u0438\u0434\u0430\u043b\u0456\u0442\u044c \u0439\u043e\u0433\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 c\u00f3 m\u00e1y ch\u1ee7 t\u00ean '%@'. H\u00e3y \u0111\u1ed5i t\u00ean ho\u1eb7c g\u1ee1 m\u00e1y ch\u1ee7 \u0111\u00f3 tr\u01b0\u1edbc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u540d\u4e3a\u201c%@\u201d\u7684\u670d\u52a1\u5668\u5df2\u5b58\u5728\u3002\u8bf7\u5148\u91cd\u547d\u540d\u6216\u79fb\u9664\u5b83\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u540d\u70ba\u300c%@\u300d\u7684\u4f3a\u670d\u5668\u5df2\u5b58\u5728\u3002\u8acb\u5148\u91cd\u65b0\u547d\u540d\u6216\u79fb\u9664\u5b83\u3002"
          }
        }
      }
    },
