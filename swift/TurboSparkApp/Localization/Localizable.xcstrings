            "value": "T\u1ec7p ngu\u1ed3n kh\u00f4ng c\u00f2n \u1edf \u0111\u01b0\u1eddng d\u1eabn ban \u0111\u1ea7u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e90\u6587\u4ef6\u5df2\u4e0d\u5728\u5176\u539f\u59cb\u8def\u5f84\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f86\u6e90\u6a94\u6848\u5df2\u4e0d\u5728\u5176\u539f\u59cb\u8def\u5f91\u3002"
