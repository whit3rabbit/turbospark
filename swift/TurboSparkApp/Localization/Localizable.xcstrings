    "Set the host and the tool finds the models by itself.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u064a\u0651\u0646 \u0627\u0644\u0645\u0636\u064a\u0641 \u0648\u0633\u062a\u0639\u062b\u0631 \u0627\u0644\u0623\u062f\u0627\u0629 \u0639\u0644\u0649 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0628\u0646\u0641\u0633\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege den Host fest, und das Werkzeug findet die Modelle selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the host and the tool finds the models by itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define el host y la herramienta encontrar\u00e1 los modelos por s\u00ed sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9finissez l'h\u00f4te et l'outil trouve les mod\u00e8les tout seul."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea \u05d4\u05de\u05d0\u05e8\u05d7 \u05d5\u05d4\u05db\u05dc\u05d9 \u05d9\u05de\u05e6\u05d0 \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05d1\u05e2\u05e6\u05de\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u094b\u0938\u094d\u091f \u0938\u0947\u091f \u0915\u0930\u0947\u0902, \u091f\u0942\u0932 \u092e\u0949\u0921\u0932 \u0916\u0941\u0926 \u0922\u0942\u0901\u0922 \u0932\u0947\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Atur host, lalu alat akan menemukan modelnya sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta l'host e lo strumento trova i modelli da solo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30db\u30b9\u30c8\u3092\u8a2d\u5b9a\u3059\u308b\u3068\u3001\u30c4\u30fc\u30eb\u304c\u30e2\u30c7\u30eb\u3092\u81ea\u52d5\u3067\u898b\u3064\u3051\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud638\uc2a4\ud2b8\ub97c \uc124\uc815\ud558\uba74 \ub3c4\uad6c\uac00 \ubaa8\ub378\uc744 \uc790\ub3d9\uc73c\ub85c \ucc3e\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel de host in en de tool vindt de modellen zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw hosta, a narz\u0119dzie samo znajdzie modele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Defina o host e a ferramenta encontra os modelos sozinha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0445\u043e\u0441\u0442, \u0438 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0441\u0430\u043c \u043d\u0430\u0439\u0434\u0451\u0442 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange v\u00e4rden s\u00e5 hittar verktyget modellerna sj\u00e4lvt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana makineyi ayarlay\u0131n, ara\u00e7 modelleri kendisi bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423\u043a\u0430\u0436\u0456\u0442\u044c \u0445\u043e\u0441\u0442, \u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442 \u0441\u0430\u043c \u0437\u043d\u0430\u0439\u0434\u0435 \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t m\u00e1y ch\u1ee7 v\u00e0 c\u00f4ng c\u1ee5 s\u1ebd t\u1ef1 t\u00ecm c\u00e1c m\u00f4 h\u00ecnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bbe\u7f6e\u4e3b\u673a\u540e\uff0c\u5de5\u5177\u4f1a\u81ea\u52a8\u627e\u5230\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
