    "Image generation is unavailable in a temporary chat.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image generation is unavailable in a temporary chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La generaci\u00f3n de im\u00e1genes no est\u00e1 disponible en un chat temporal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La g\u00e9n\u00e9ration d'images n'est pas disponible dans une discussion temporaire."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bildgenerierung ist in einem tempor\u00e4ren Chat nicht verf\u00fcgbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La generazione di immagini non \u00e8 disponibile in una chat temporanea."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A gera\u00e7\u00e3o de imagens n\u00e3o est\u00e1 dispon\u00edvel em um chat tempor\u00e1rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u044f \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u0439 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0432\u043e \u0432\u0440\u0435\u043c\u0435\u043d\u043d\u043e\u043c \u0447\u0430\u0442\u0435."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e00\u6642\u7684\u306a\u30c1\u30e3\u30c3\u30c8\u3067\u306f\u753b\u50cf\u751f\u6210\u3092\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc784\uc2dc \ucc44\ud305\uc5d0\uc11c\ub294 \uc774\ubbf8\uc9c0 \uc0dd\uc131\uc744 \uc0ac\uc6a9\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e34\u65f6\u804a\u5929\u4e2d\u65e0\u6cd5\u751f\u6210\u56fe\u50cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66ab\u5b58\u804a\u5929\u4e2d\u7121\u6cd5\u7522\u751f\u5f71\u50cf\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0646\u0634\u0627\u0621 \u0627\u0644\u0635\u0648\u0631 \u063a\u064a\u0631 \u0645\u062a\u0627\u062d \u0641\u064a \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0645\u0624\u0642\u062a\u0629."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d9\u05e6\u05d9\u05e8\u05ea \u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d0\u05d9\u05e0\u05d4 \u05d6\u05de\u05d9\u05e0\u05d4 \u05d1\u05e6'\u05d0\u05d8 \u05d6\u05de\u05e0\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u0938\u094d\u0925\u093e\u092f\u0940 \u091a\u0948\u091f \u092e\u0947\u0902 \u091b\u0935\u093f \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingsgeneratie is niet beschikbaar in een tijdelijke chat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Generowanie obraz\u00f3w jest niedost\u0119pne w czacie tymczasowym."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ge\u00e7ici sohbette resim olu\u015fturma kullan\u0131lamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u044f \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u044c \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0430 \u0432 \u0442\u0438\u043c\u0447\u0430\u0441\u043e\u0432\u043e\u043c\u0443 \u0447\u0430\u0442\u0456."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildgenerering \u00e4r inte tillg\u00e4nglig i en tillf\u00e4llig chatt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00ednh n\u0103ng t\u1ea1o h\u00ecnh \u1ea3nh kh\u00f4ng kh\u1ea3 d\u1ee5ng trong cu\u1ed9c tr\u00f2 chuy\u1ec7n t\u1ea1m th\u1eddi."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembuatan gambar tidak tersedia di obrolan sementara."
          }
        }
      }
    },
