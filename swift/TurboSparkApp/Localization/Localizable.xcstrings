            "value": "Up/Down to navigate, Enter to open, Esc to close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba/Abajo para navegar, Intro para abrir, Esc para cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut/Bas pour naviguer, Entrée pour ouvrir, Échap pour fermer"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf/Ab zum Navigieren, Eingabetaste zum Öffnen, Esc zum Schließen"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su/Giù per spostarsi, Invio per aprire, Esc per chiudere"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cima/Baixo para navegar, Enter para abrir, Esc para fechar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вверх/Вниз — навигация, Enter — открыть, Esc — закрыть"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上下で移動、Enter で開く、Esc で閉じる"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "위/아래로 이동, Enter로 열기, Esc로 닫기"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上/下键导航，回车打开，Esc 关闭"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上/下鍵導覽，Enter 開啟，Esc 關閉"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعلى/أسفل للتنقل، Enter للفتح، Esc للإغلاق"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "למעלה/למטה לניווט, Enter לפתיחה, Esc לסגירה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेविगेट करने के लिए Up/Down, खोलने के लिए Enter, बंद करने के लिए Esc"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog/Omlaag om te navigeren, Enter om te openen, Esc om te sluiten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Góra/Dół do nawigacji, Enter aby otworzyć, Esc aby zamknąć"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezinmek için Yukarı/Aşağı, açmak için Enter, kapatmak için Esc"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вгору/Вниз — навігація, Enter — відкрити, Esc — закрити"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp/Ner för att navigera, Enter för att öppna, Esc för att stänga"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lên/Xuống để điều hướng, Enter để mở, Esc để đóng"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naik/Turun untuk navigasi, Enter untuk membuka, Esc untuk menutup"
          }
        }
      }
    },
    "Used when the tool approval mode is \"Agent (classifier)\"": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when the tool approval mode is \"Agent (classifier)\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando el modo de aprobación de herramientas es \"Agente (clasificador)\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lorsque le mode d'approbation des outils est \"Agent (classificateur)\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn der Tool-Genehmigungsmodus \"Agent (Klassifikator)\" ist"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando la modalità di approvazione degli strumenti è \"Agente (classificatore)\""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando o modo de aprovação de ferramentas é \"Agente (classificador)\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, когда режим одобрения инструментов - \"Агент (классификатор)\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール承認モードが「エージェント (分類器)」のときに使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 승인 모드가 \"에이전트(분류기)\"일 때 사용됩니다"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当工具批准模式为\"代理 (分类器)\"时使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當工具核准模式為\"代理 (分類器)\"時使用"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عندما يكون وضع الموافقة على الأدوات \"وكيل (مصنف)\""
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשימוש כאשר מצב אישור הכלים הוא \"סוכן (מסווג)\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब उपयोग किया जाता है जब टूल अनुमोदन मोड \"एजेंट (क्लासिफ़ायर)\" हो"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt wanneer de goedkeuringsmodus voor tools \"Agent (classificatie)\" is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane, gdy tryb zatwierdzania narzędzi to \"Agent (klasyfikator)\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç onay kipi \"Aracı (sınıflandırıcı)\" olduğunda kullanılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується, коли режим схвалення інструментів - \"Агент (класифікатор)\""
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används när verktygens godkännandeläge är \"Agent (klassificerare)\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được dùng khi chế độ phê duyệt công cụ là \"Tác nhân (bộ phân loại)\""
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan saat mode persetujuan alat adalah \"Agen (pengklasifikasi)\""
          }
        }
      }
    },
    "Useful for regions with restricted Hugging Face access, e.g. https://hf-mirror.com": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Useful for regions with restricted Hugging Face access, e.g. https://hf-mirror.com"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil en regiones con acceso restringido a Hugging Face, por ejemplo https://hf-mirror.com"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile dans les régions où l'accès à Hugging Face est restreint, par ex. https://hf-mirror.com"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nützlich in Regionen mit eingeschränktem Zugriff auf Hugging Face, z. B. https://hf-mirror.com"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile nelle regioni con accesso limitato a Hugging Face, ad es. https://hf-mirror.com"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil em regiões com acesso restrito ao Hugging Face, por exemplo https://hf-mirror.com"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полезно в регионах с ограниченным доступом к Hugging Face, например https://hf-mirror.com"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face へのアクセスが制限されている地域で役立ちます (例: https://hf-mirror.com)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 접근이 제한된 지역에서 유용합니다. 예: https://hf-mirror.com"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于 Hugging Face 访问受限的地区，例如 https://hf-mirror.com"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於 Hugging Face 存取受限的地區，例如 https://hf-mirror.com"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفيد في المناطق التي يكون فيها الوصول إلى Hugging Face مقيدا، مثل https://hf-mirror.com"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שימושי באזורים שבהם הגישה ל-Hugging Face מוגבלת, למשל https://hf-mirror.com"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन क्षेत्रों के लिए उपयोगी जहां Hugging Face तक पहुंच सीमित है, जैसे https://hf-mirror.com"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handig in regio's met beperkte toegang tot Hugging Face, bijv. https://hf-mirror.com"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przydatne w regionach z ograniczonym dostępem do Hugging Face, np. https://hf-mirror.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face erişiminin kısıtlı olduğu bölgelerde yararlıdır, ör. https://hf-mirror.com"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Корисно в регіонах з обмеженим доступом до Hugging Face, наприклад https://hf-mirror.com"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användbart i regioner med begränsad åtkomst till Hugging Face, t.ex. https://hf-mirror.com"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hữu ích ở những khu vực bị hạn chế truy cập Hugging Face, ví dụ https://hf-mirror.com"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berguna untuk wilayah dengan akses Hugging Face yang dibatasi, mis. https://hf-mirror.com"
          }
        }
      }
    },
