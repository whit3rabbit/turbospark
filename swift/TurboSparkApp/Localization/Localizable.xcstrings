        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d9\u05e6\u05d9\u05e8\u05d4 \u05d4\u05e1\u05ea\u05d9\u05d9\u05de\u05d4 \u05dc\u05dc\u05d0 \u05ea\u05d5\u05e6\u05d0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u0928\u0930\u0947\u0936\u0928 \u092c\u093f\u0928\u093e \u092a\u0930\u093f\u0923\u093e\u092e \u0915\u0947 \u0938\u092e\u093e\u092a\u094d\u0924 \u0939\u0941\u0906\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembuatan berakhir tanpa hasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La generazione \u00e8 terminata senza risultato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u304c\u7d50\u679c\u306a\u3057\u3067\u7d42\u4e86\u3057\u307e\u3057\u305f\u3002"
          }
