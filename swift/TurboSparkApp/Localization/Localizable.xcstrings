    "Use # or /memory text for profile memory. Use /memory project text for this project's memory. Review model suggestions below.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u062e\u062f\u0645 # \u0623\u0648 /memory \u0646\u0635 \u0644\u0630\u0627\u0643\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a. \u0627\u0633\u062a\u062e\u062f\u0645 /memory project \u0646\u0635 \u0644\u0630\u0627\u0643\u0631\u0629 \u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639. \u0631\u0627\u062c\u0639 \u0627\u0642\u062a\u0631\u0627\u062d\u0627\u062a \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0623\u062f\u0646\u0627\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie # oder /memory Text f\u00fcr den Profilspeicher. Verwenden Sie /memory project Text f\u00fcr den Speicher dieses Projekts. Pr\u00fcfen Sie unten die Modellvorschl\u00e4ge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use # or /memory text for profile memory. Use /memory project text for this project's memory. Review model suggestions below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa # o /memory texto para la memoria del perfil. Usa /memory project texto para la memoria de este proyecto. Revisa las sugerencias del modelo a continuaci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez # ou /memory texte pour la m\u00e9moire de profil. Utilisez /memory project texte pour la m\u00e9moire de ce projet. Examinez les suggestions du mod\u00e8le ci-dessous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-# \u05d0\u05d5 /memory text \u05e2\u05d1\u05d5\u05e8 \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d4\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc. \u05d4\u05e9\u05ea\u05de\u05e9 \u05d1-/memory project text \u05e2\u05d1\u05d5\u05e8 \u05d6\u05d9\u05db\u05e8\u05d5\u05df \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8. \u05e2\u05d9\u05d9\u05df \u05d1\u05d4\u05e6\u05e2\u05d5\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05dc\u05d4\u05dc\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092e\u0947\u092e\u094b\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f # \u092f\u093e /memory text \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964 \u0907\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0940 \u092e\u0947\u092e\u094b\u0930\u0940 \u0915\u0947 \u0932\u093f\u090f /memory project text \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964 \u0928\u0940\u091a\u0947 \u092e\u0949\u0921\u0932 \u0938\u0941\u091d\u093e\u0935 \u0926\u0947\u0916\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan # atau /memory teks untuk memori profil. Gunakan /memory project teks untuk memori proyek ini. Tinjau saran model di bawah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa # o /memory testo per la memoria del profilo. Usa /memory project testo per la memoria di questo progetto. Rivedi i suggerimenti del modello qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u30e1\u30e2\u30ea\u306b\u306f # \u307e\u305f\u306f /memory text \u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u3053\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u30e1\u30e2\u30ea\u306b\u306f /memory project text \u3092\u4f7f\u7528\u3057\u307e\u3059\u3002\u4ee5\u4e0b\u306e\u30e2\u30c7\u30eb\u306e\u63d0\u6848\u3092\u78ba\u8a8d\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub85c\ud544 \uba54\ubaa8\ub9ac\ub294 # \ub610\ub294 /memory text\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc774 \ud504\ub85c\uc81d\ud2b8 \uba54\ubaa8\ub9ac\ub294 /memory project text\ub97c \uc0ac\uc6a9\ud558\uc138\uc694. \uc544\ub798\uc758 \ubaa8\ub378 \uc81c\uc548\uc744 \uac80\ud1a0\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik # of /memory tekst voor profielgeheugen. Gebruik /memory project tekst voor het geheugen van dit project. Bekijk de modelsuggesties hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cyj # lub /memory tekst dla pami\u0119ci profilu. U\u017cyj /memory project tekst dla pami\u0119ci tego projektu. Przejrzyj sugestie modelu poni\u017cej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use # ou /memory texto para mem\u00f3ria de perfil. Use /memory project texto para a mem\u00f3ria deste projeto. Revise as sugest\u00f5es do modelo abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 # \u0438\u043b\u0438 /memory \u0442\u0435\u043a\u0441\u0442 \u0434\u043b\u044f \u043f\u0430\u043c\u044f\u0442\u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u044f. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 /memory project \u0442\u0435\u043a\u0441\u0442 \u0434\u043b\u044f \u043f\u0430\u043c\u044f\u0442\u0438 \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430. \u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0438\u0436\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nd # eller /memory text f\u00f6r profilminne. Anv\u00e4nd /memory project text f\u00f6r projektminne. Granska modellf\u00f6rslagen nedan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil belle\u011fi i\u00e7in # veya /memory metin kullan\u0131n. Bu projenin belle\u011fi i\u00e7in /memory project metin kullan\u0131n. A\u015fa\u011f\u0131daki model \u00f6nerilerini inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 # \u0430\u0431\u043e /memory \u0442\u0435\u043a\u0441\u0442 \u0434\u043b\u044f \u043f\u0430\u043c'\u044f\u0442\u0456 \u043f\u0440\u043e\u0444\u0456\u043b\u044e. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 /memory project \u0442\u0435\u043a\u0441\u0442 \u0434\u043b\u044f \u043f\u0430\u043c'\u044f\u0442\u0456 \u0446\u044c\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0443. \u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u043f\u0440\u043e\u043f\u043e\u0437\u0438\u0446\u0456\u0457 \u043c\u043e\u0434\u0435\u043b\u0456 \u043d\u0438\u0436\u0447\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00f9ng # ho\u1eb7c /memory v\u0103n b\u1ea3n cho b\u1ed9 nh\u1edb h\u1ed3 s\u01a1. D\u00f9ng /memory project v\u0103n b\u1ea3n cho b\u1ed9 nh\u1edb d\u1ef1 \u00e1n n\u00e0y. Xem l\u1ea1i g\u1ee3i \u00fd m\u00f4 h\u00ecnh b\u00ean d\u01b0\u1edbi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528 # \u6216 /memory \u6587\u672c\u6dfb\u52a0\u4e2a\u4eba\u8d44\u6599\u8bb0\u5fc6\u3002\u4f7f\u7528 /memory project \u6587\u672c\u6dfb\u52a0\u5f53\u524d\u9879\u76ee\u8bb0\u5fc6\u3002\u67e5\u770b\u4e0b\u65b9\u7684\u6a21\u578b\u5efa\u8bae\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f7f\u7528 # \u6216 /memory \u6587\u5b57\u65b0\u589e\u500b\u4eba\u6a94\u6848\u8a18\u61b6\u3002\u4f7f\u7528 /memory project \u6587\u5b57\u65b0\u589e\u76ee\u524d\u5c08\u6848\u8a18\u61b6\u3002\u67e5\u770b\u4e0b\u65b9\u7684\u6a21\u578b\u5efa\u8b70\u3002"
          }
        }
      }
    },
