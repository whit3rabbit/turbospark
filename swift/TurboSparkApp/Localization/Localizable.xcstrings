    "A turn is already running. Wait for it to finish first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هناك دور قيد التشغيل بالفعل. انتظر حتى ينتهي أولًا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es läuft bereits eine Runde. Warten Sie, bis sie abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A turn is already running. Wait for it to finish first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ya hay un turno en curso. Espera a que termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tour est déjà en cours. Attendez qu'il se termine."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תור כבר פועל. המתן לסיומו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक टर्न पहले से चल रहा है। पहले इसके पूरा होने की प्रतीक्षा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Giliran sedang berjalan. Tunggu hingga selesai terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un turno è già in corso. Attendi che termini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターンはすでに実行中です。完了するまでお待ちください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 턴이 실행 중입니다. 먼저 끝날 때까지 기다리세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er loopt al een beurt. Wacht tot deze klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tura jest już w toku. Najpierw poczekaj na jej zakończenie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Já há um turno em andamento. Aguarde até que ele termine."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ход уже выполняется. Сначала дождитесь его завершения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En tur körs redan. Vänta tills den är klar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaten çalışan bir tur var. Önce bitmesini bekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Хід уже виконується. Спершу дочекайтеся його завершення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang có một lượt chạy. Hãy đợi lượt đó hoàn tất trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有一个轮次正在运行。请先等待其完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有回合正在執行。請先等待其完成。"
          }
        }
      }
