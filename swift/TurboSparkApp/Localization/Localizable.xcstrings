    "Added '%@'. It is disabled until you enable it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645\u062a \u0625\u0636\u0627\u0641\u0629 '%@'. \u0633\u064a\u0628\u0642\u0649 \u0645\u0639\u0637\u0651\u0644\u064b\u0627 \u062d\u062a\u0649 \u062a\u0641\u0639\u0651\u0644\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u201e%@\u201c wurde hinzugef\u00fcgt. Der Server bleibt deaktiviert, bis Sie ihn aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Added '%@'. It is disabled until you enable it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agreg\u00f3 '%@'. Permanece desactivado hasta que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab %@ \u00bb a \u00e9t\u00e9 ajout\u00e9. Il reste d\u00e9sactiv\u00e9 jusqu\u2019\u00e0 ce que vous l\u2019activiez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u05e0\u05d5\u05e1\u05e3. \u05d4\u05d5\u05d0 \u05de\u05d5\u05e9\u05d1\u05ea \u05e2\u05d3 \u05e9\u05ea\u05e4\u05e2\u05d9\u05dc \u05d0\u05d5\u05ea\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u091c\u094b\u0921\u093c\u093e \u0917\u092f\u093e\u0964 \u091c\u092c \u0924\u0915 \u0906\u092a \u0907\u0938\u0947 \u0938\u0915\u094d\u0937\u092e \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947, \u092f\u0939 \u0905\u0915\u094d\u0937\u092e \u0930\u0939\u0947\u0917\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ditambahkan. Server tetap nonaktif sampai Anda mengaktifkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' aggiunto. Resta disattivato finch\u00e9 non lo attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u300c%@\u300d\u3092\u8ffd\u52a0\u3057\u307e\u3057\u305f\u3002\u6709\u52b9\u306b\u3059\u308b\u307e\u3067\u7121\u52b9\u306e\u307e\u307e\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc744(\ub97c) \ucd94\uac00\ud588\uc2b5\ub2c8\ub2e4. \ud65c\uc131\ud654\ud560 \ub54c\uae4c\uc9c0 \ube44\ud65c\uc131 \uc0c1\ud0dc\ub85c \uc720\uc9c0\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' toegevoegd. Deze blijft uitgeschakeld totdat je hem inschakelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano \u201e%@\u201d. Pozostaje wy\u0142\u0105czony, dop\u00f3ki go nie w\u0142\u0105czysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' adicionado. Ele fica desativado at\u00e9 voc\u00ea ativ\u00e1-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb \u0434\u043e\u0431\u0430\u0432\u043b\u0435\u043d. \u041e\u043d \u043e\u0442\u043a\u043b\u044e\u0447\u0451\u043d, \u043f\u043e\u043a\u0430 \u0432\u044b \u0435\u0433\u043e \u043d\u0435 \u0432\u043a\u043b\u044e\u0447\u0438\u0442\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' har lagts till. Den \u00e4r inaktiverad tills du aktiverar den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' eklendi. Siz etkinle\u015ftirene kadar devre d\u0131\u015f\u0131 kal\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00ab%@\u00bb \u0434\u043e\u0434\u0430\u043d\u043e. \u0412\u0456\u043d \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u0438\u0439, \u0434\u043e\u043a\u0438 \u0432\u0438 \u0439\u043e\u0433\u043e \u043d\u0435 \u0432\u0432\u0456\u043c\u043a\u043d\u0435\u0442\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 th\u00eam '%@'. M\u00e1y ch\u1ee7 s\u1ebd t\u1eaft cho \u0111\u1ebfn khi b\u1ea1n b\u1eadt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6dfb\u52a0\u201c%@\u201d\u3002\u5728\u4f60\u542f\u7528\u4e4b\u524d\u5b83\u5904\u4e8e\u505c\u7528\u72b6\u6001\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u65b0\u589e\u300c%@\u300d\u3002\u5728\u4f60\u555f\u7528\u4e4b\u524d\u5b83\u6703\u4fdd\u6301\u505c\u7528\u3002"
          }
        }
      }
    },
