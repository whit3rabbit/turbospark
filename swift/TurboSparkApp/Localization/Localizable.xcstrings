    "Temporary chat: this conversation can't be recovered.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062d\u0627\u062f\u062b\u0629 \u0645\u0624\u0642\u062a\u0629: \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempor\u00e4rer Chat: Diese Unterhaltung kann nicht wiederhergestellt werden."
          }
        },
