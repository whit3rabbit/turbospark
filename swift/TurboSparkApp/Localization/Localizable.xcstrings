    "Used for accessing attached documents, notes, and user project files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0633\u062a\u0646\u062f\u0627\u062a \u0627\u0644\u0645\u0631\u0641\u0642\u0629 \u0648\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0648\u0645\u0644\u0641\u0627\u062a \u0645\u0634\u0627\u0631\u064a\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird f\u00fcr den Zugriff auf angeh\u00e4ngte Dokumente, Notizen und Projektdateien verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for accessing attached documents, notes, and user project files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para acceder a documentos adjuntos, notas y archivos de proyectos del usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilis\u00e9 pour acc\u00e9der aux documents joints, aux notes et aux fichiers de projet de l'utilisateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e9\u05de\u05e9 \u05dc\u05d2\u05d9\u05e9\u05d4 \u05dc\u05de\u05e1\u05de\u05db\u05d9\u05dd \u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd, \u05dc\u05e4\u05ea\u05e7\u05d9\u05dd \u05d5\u05dc\u05e7\u05d5\u05d1\u05e6\u05d9 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8\u05d9\u05dd \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0932\u0917\u094d\u0928 \u0926\u0938\u094d\u0924\u093e\u0935\u0947\u091c\u093c\u094b\u0902, \u0928\u094b\u091f\u094d\u0938 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u092b\u093c\u093e\u0907\u0932\u094b\u0902 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk mengakses dokumen lampiran, catatan, dan file proyek pengguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata per accedere a documenti allegati, note e file di progetto dell'utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6dfb\u4ed8\u66f8\u985e\u3001\u30e1\u30e2\u3001\u30e6\u30fc\u30b6\u30fc\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30d5\u30a1\u30a4\u30eb\u3078\u306e\u30a2\u30af\u30bb\u30b9\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucca8\ubd80 \ubb38\uc11c, \uba54\ubaa8, \uc0ac\uc6a9\uc790 \ud504\ub85c\uc81d\ud2b8 \ud30c\uc77c\uc5d0 \uc811\uadfc\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor toegang tot bijgevoegde documenten, notities en projectbestanden van de gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cywany do dost\u0119pu do za\u0142\u0105czonych dokument\u00f3w, notatek i plik\u00f3w projekt\u00f3w u\u017cytkownika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para acessar documentos anexados, notas e arquivos de projetos do usu\u00e1rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a \u0432\u043b\u043e\u0436\u0435\u043d\u043d\u044b\u043c \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0430\u043c, \u0437\u0430\u043c\u0435\u0442\u043a\u0430\u043c \u0438 \u0444\u0430\u0439\u043b\u0430\u043c \u043f\u0440\u043e\u0435\u043a\u0442\u043e\u0432 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nds f\u00f6r att komma \u00e5t bifogade dokument, anteckningar och anv\u00e4ndarens projektfiler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekli belgelere, notlara ve kullan\u0131c\u0131 proje dosyalar\u0131na eri\u015fmek i\u00e7in kullan\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0434\u043e \u0432\u043a\u043b\u0430\u0434\u0435\u043d\u0438\u0445 \u0434\u043e\u043a\u0443\u043c\u0435\u043d\u0442\u0456\u0432, \u043d\u043e\u0442\u0430\u0442\u043e\u043a \u0456 \u0444\u0430\u0439\u043b\u0456\u0432 \u043f\u0440\u043e\u0454\u043a\u0442\u0456\u0432 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00f9ng \u0111\u1ec3 truy c\u1eadp t\u00e0i li\u1ec7u \u0111\u00ednh k\u00e8m, ghi ch\u00fa v\u00e0 t\u1ec7p d\u1ef1 \u00e1n c\u1ee7a ng\u01b0\u1eddi d\u00f9ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u4e8e\u8bbf\u95ee\u9644\u52a0\u7684\u6587\u7a3f\u3001\u7b14\u8bb0\u548c\u7528\u6237\u9879\u76ee\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u65bc\u53d6\u7528\u9644\u52a0\u7684\u6587\u4ef6\u3001\u5099\u5fd8\u9304\u548c\u4f7f\u7528\u8005\u5c08\u6848\u6a94\u6848\u3002"
          }
        }
      }
    },
    "Used for downloading model checkpoints, datasets, and reading imported files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u062a\u0646\u0632\u064a\u0644 \u0646\u0642\u0627\u0637 \u062d\u0641\u0638 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0648\u0645\u062c\u0645\u0648\u0639\u0627\u062a \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0642\u0631\u0627\u0621\u0629 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0648\u0631\u062f\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zum Herunterladen von Modell-Checkpoints und Datens\u00e4tzen sowie zum Lesen importierter Dateien verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for downloading model checkpoints, datasets, and reading imported files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para descargar checkpoints de modelos y conjuntos de datos, y para leer archivos importados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilis\u00e9 pour t\u00e9l\u00e9charger des checkpoints de mod\u00e8les et des jeux de donn\u00e9es, et pour lire les fichiers import\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e9\u05de\u05e9 \u05dc\u05d4\u05d5\u05e8\u05d3\u05ea \u05e0\u05e7\u05d5\u05d3\u05d5\u05ea \u05e9\u05de\u05d9\u05e8\u05d4 \u05e9\u05dc \u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05d5\u05de\u05e2\u05e8\u05db\u05d9 \u05e0\u05ea\u05d5\u05e0\u05d9\u05dd \u05d5\u05dc\u05e7\u05e8\u05d9\u05d0\u05ea \u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05d9\u05d5\u05d1\u05d0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u0914\u0930 \u0921\u0947\u091f\u093e\u0938\u0947\u091f \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0924\u0925\u093e \u0906\u092f\u093e\u0924 \u0915\u0940 \u0917\u0908 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u092a\u0922\u093c\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk mengunduh checkpoint model dan dataset, serta membaca file yang diimpor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata per scaricare checkpoint dei modelli e dataset e per leggere i file importati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u306e\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u3084\u30c7\u30fc\u30bf\u30bb\u30c3\u30c8\u306e\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3001\u8aad\u307f\u8fbc\u3093\u3060\u30d5\u30a1\u30a4\u30eb\u306e\u8aad\u307f\u53d6\u308a\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378 \uccb4\ud06c\ud3ec\uc778\ud2b8\uc640 \ub370\uc774\ud130 \uc138\ud2b8\ub97c \ub2e4\uc6b4\ub85c\ub4dc\ud558\uace0 \uac00\uc838\uc628 \ud30c\uc77c\uc744 \uc77d\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor het downloaden van modelcheckpoints en datasets en het lezen van ge\u00efmporteerde bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cywany do pobierania punkt\u00f3w kontrolnych modeli i zbior\u00f3w danych oraz odczytu zaimportowanych plik\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para baixar checkpoints de modelos e conjuntos de dados, e ler arquivos importados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u044b\u0445 \u0442\u043e\u0447\u0435\u043a \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0438 \u043d\u0430\u0431\u043e\u0440\u043e\u0432 \u0434\u0430\u043d\u043d\u044b\u0445, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0447\u0442\u0435\u043d\u0438\u044f \u0438\u043c\u043f\u043e\u0440\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0445 \u0444\u0430\u0439\u043b\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nds f\u00f6r att ladda ned modellcheckpoints och dataset samt l\u00e4sa importerade filer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model kontrol noktalar\u0131n\u0131 ve veri k\u00fcmelerini indirmek ve i\u00e7e aktar\u0131lan dosyalar\u0131 okumak i\u00e7in kullan\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u0438\u0445 \u0442\u043e\u0447\u043e\u043a \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0456 \u043d\u0430\u0431\u043e\u0440\u0456\u0432 \u0434\u0430\u043d\u0438\u0445 \u0442\u0430 \u0447\u0438\u0442\u0430\u043d\u043d\u044f \u0456\u043c\u043f\u043e\u0440\u0442\u043e\u0432\u0430\u043d\u0438\u0445 \u0444\u0430\u0439\u043b\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00f9ng \u0111\u1ec3 t\u1ea3i xu\u1ed1ng checkpoint m\u00f4 h\u00ecnh, b\u1ed9 d\u1eef li\u1ec7u v\u00e0 \u0111\u1ecdc c\u00e1c t\u1ec7p \u0111\u00e3 nh\u1eadp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u4e8e\u4e0b\u8f7d\u6a21\u578b\u68c0\u67e5\u70b9\u548c\u6570\u636e\u96c6\uff0c\u4ee5\u53ca\u8bfb\u53d6\u5bfc\u5165\u7684\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u65bc\u4e0b\u8f09\u6a21\u578b\u6aa2\u67e5\u9ede\u548c\u8cc7\u6599\u96c6\uff0c\u4ee5\u53ca\u8b80\u53d6\u532f\u5165\u7684\u6a94\u6848\u3002"
          }
        }
      }
    },
    "Used for accessing desktop attachments and user workspace folders.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0633\u062a\u062e\u062f\u0645 \u0644\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u0631\u0641\u0642\u0627\u062a \u0633\u0637\u062d \u0627\u0644\u0645\u0643\u062a\u0628 \u0648\u0645\u062c\u0644\u062f\u0627\u062a \u0645\u0633\u0627\u062d\u0629 \u0639\u0645\u0644 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird f\u00fcr den Zugriff auf Schreibtisch-Anh\u00e4nge und Arbeitsordner verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for accessing desktop attachments and user workspace folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para acceder a adjuntos del escritorio y carpetas de trabajo del usuario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilis\u00e9 pour acc\u00e9der aux pi\u00e8ces jointes du bureau et aux dossiers de travail de l'utilisateur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e9\u05de\u05e9 \u05dc\u05d2\u05d9\u05e9\u05d4 \u05dc\u05e7\u05d1\u05e6\u05d9\u05dd \u05d1\u05e9\u05d5\u05dc\u05d7\u05df \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05d5\u05dc\u05ea\u05d9\u05e7\u05d9\u05d5\u05ea \u05e1\u05d1\u05d9\u05d1\u05ea \u05d4\u05e2\u05d1\u05d5\u05d3\u05d4 \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u0947\u0938\u094d\u0915\u091f\u0949\u092a \u0905\u091f\u0948\u091a\u092e\u0947\u0902\u091f \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0935\u0930\u094d\u0915\u0938\u094d\u092a\u0947\u0938 \u092b\u093c\u094b\u0932\u094d\u0921\u0930\u094b\u0902 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917 \u0939\u094b\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk mengakses lampiran desktop dan folder ruang kerja pengguna."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata per accedere ad allegati sulla scrivania e cartelle di lavoro dell'utente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c7\u30b9\u30af\u30c8\u30c3\u30d7\u306e\u6dfb\u4ed8\u30d5\u30a1\u30a4\u30eb\u3068\u30e6\u30fc\u30b6\u30fc\u306e\u30ef\u30fc\u30af\u30b9\u30da\u30fc\u30b9\u30d5\u30a9\u30eb\u30c0\u3078\u306e\u30a2\u30af\u30bb\u30b9\u306b\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub370\uc2a4\ud06c\ud0d1 \ucca8\ubd80 \ud30c\uc77c\uacfc \uc0ac\uc6a9\uc790 \uc791\uc5c5 \uacf5\uac04 \ud3f4\ub354\uc5d0 \uc811\uadfc\ud558\ub294 \ub370 \uc0ac\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor toegang tot bijlagen op het bureaublad en werkruimtemappen van de gebruiker."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cywany do dost\u0119pu do za\u0142\u0105cznik\u00f3w na biurku i folder\u00f3w roboczych u\u017cytkownika."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para acessar anexos da mesa e pastas de trabalho do usu\u00e1rio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u0430 \u043a \u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f\u043c \u043d\u0430 \u0440\u0430\u0431\u043e\u0447\u0435\u043c \u0441\u0442\u043e\u043b\u0435 \u0438 \u0440\u0430\u0431\u043e\u0447\u0438\u043c \u043f\u0430\u043f\u043a\u0430\u043c \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nds f\u00f6r att komma \u00e5t bilagor p\u00e5 skrivbordet och anv\u00e4ndarens arbetsmappar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masa\u00fcst\u00fc eklerine ve kullan\u0131c\u0131 \u00e7al\u0131\u015fma alan\u0131 klas\u00f6rlerine eri\u015fmek i\u00e7in kullan\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u0434\u043b\u044f \u0434\u043e\u0441\u0442\u0443\u043f\u0443 \u0434\u043e \u0432\u043a\u043b\u0430\u0434\u0435\u043d\u044c \u043d\u0430 \u0440\u043e\u0431\u043e\u0447\u043e\u043c\u0443 \u0441\u0442\u043e\u043b\u0456 \u0442\u0430 \u0440\u043e\u0431\u043e\u0447\u0438\u0445 \u043f\u0430\u043f\u043e\u043a \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00f9ng \u0111\u1ec3 truy c\u1eadp t\u1ec7p \u0111\u00ednh k\u00e8m tr\u00ean m\u00e0n h\u00ecnh n\u1ec1n v\u00e0 th\u01b0 m\u1ee5c l\u00e0m vi\u1ec7c c\u1ee7a ng\u01b0\u1eddi d\u00f9ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u4e8e\u8bbf\u95ee\u684c\u9762\u9644\u4ef6\u548c\u7528\u6237\u5de5\u4f5c\u533a\u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u65bc\u53d6\u7528\u684c\u9762\u9644\u4ef6\u548c\u4f7f\u7528\u8005\u5de5\u4f5c\u5340\u6a94\u6848\u593e\u3002"
          }
        }
      }
    },
    "Root user folder for config files (.turbospark, .mcp, scripts).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062c\u0644\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0627\u0644\u062c\u0630\u0631 \u0644\u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0625\u0639\u062f\u0627\u062f (.turbospark \u0648.mcp \u0648\u0627\u0644\u0633\u0643\u0631\u0628\u062a\u0627\u062a)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benutzerordner f\u00fcr Konfigurationsdateien (.turbospark, .mcp, Skripte)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Root user folder for config files (.turbospark, .mcp, scripts)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carpeta ra\u00edz del usuario para archivos de configuraci\u00f3n (.turbospark, .mcp, scripts)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dossier racine de l'utilisateur pour les fichiers de configuration (.turbospark, .mcp, scripts)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05d1\u05e1\u05d9\u05e1 \u05e9\u05dc \u05d4\u05de\u05e9\u05ea\u05de\u05e9 \u05dc\u05e7\u05d5\u05d1\u05e6\u05d9 \u05ea\u05e6\u05d5\u05e8\u05d4 (.turbospark, .mcp, \u05e1\u05e7\u05e8\u05d9\u05e4\u05d8\u05d9\u05dd)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0949\u0928\u094d\u092b\u093c\u093f\u0917 \u092b\u093c\u093e\u0907\u0932\u094b\u0902 (.turbospark, .mcp, \u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f) \u0915\u0947 \u0932\u093f\u090f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u092e\u0942\u0932 \u092b\u093c\u094b\u0932\u094d\u0921\u0930\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder akar pengguna untuk file konfigurasi (.turbospark, .mcp, skrip)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cartella principale dell'utente per i file di configurazione (.turbospark, .mcp, script)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a2d\u5b9a\u30d5\u30a1\u30a4\u30eb\uff08.turbospark\u3001.mcp\u3001\u30b9\u30af\u30ea\u30d7\u30c8\uff09\u7528\u306e\u30e6\u30fc\u30b6\u30fc\u306e\u30eb\u30fc\u30c8\u30d5\u30a9\u30eb\u30c0\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uad6c\uc131 \ud30c\uc77c(.turbospark, .mcp, \uc2a4\ud06c\ub9bd\ud2b8)\uc744 \uc704\ud55c \uc0ac\uc6a9\uc790 \ub8e8\ud2b8 \ud3f4\ub354\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoofdmap van de gebruiker voor configuratiebestanden (.turbospark, .mcp, scripts)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u0142\u00f3wny folder u\u017cytkownika na pliki konfiguracyjne (.turbospark, .mcp, skrypty)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasta raiz do usu\u00e1rio para arquivos de configura\u00e7\u00e3o (.turbospark, .mcp, scripts)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0440\u043d\u0435\u0432\u0430\u044f \u043f\u0430\u043f\u043a\u0430 \u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u0442\u0435\u043b\u044f \u0434\u043b\u044f \u0444\u0430\u0439\u043b\u043e\u0432 \u043a\u043e\u043d\u0444\u0438\u0433\u0443\u0440\u0430\u0446\u0438\u0438 (.turbospark, .mcp, \u0441\u043a\u0440\u0438\u043f\u0442\u044b)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4ndarens rotmapp f\u00f6r konfigurationsfiler (.turbospark, .mcp, skript)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yap\u0131land\u0131rma dosyalar\u0131 i\u00e7in kullan\u0131c\u0131 k\u00f6k klas\u00f6r\u00fc (.turbospark, .mcp, betikler)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0440\u0435\u043d\u0435\u0432\u0430 \u043f\u0430\u043f\u043a\u0430 \u043a\u043e\u0440\u0438\u0441\u0442\u0443\u0432\u0430\u0447\u0430 \u0434\u043b\u044f \u0444\u0430\u0439\u043b\u0456\u0432 \u043a\u043e\u043d\u0444\u0456\u0433\u0443\u0440\u0430\u0446\u0456\u0457 (.turbospark, .mcp, \u0441\u043a\u0440\u0438\u043f\u0442\u0438)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Th\u01b0 m\u1ee5c g\u1ed1c c\u1ee7a ng\u01b0\u1eddi d\u00f9ng cho t\u1ec7p c\u1ea5u h\u00ecnh (.turbospark, .mcp, script)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u4e8e\u914d\u7f6e\u6587\u4ef6\uff08.turbospark\u3001.mcp\u3001\u811a\u672c\uff09\u7684\u7528\u6237\u6839\u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7528\u65bc\u8a2d\u5b9a\u6a94\uff08.turbospark\u3001.mcp\u3001\u8173\u672c\uff09\u7684\u4f7f\u7528\u8005\u6839\u6a94\u6848\u593e\u3002"
