        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아쓰기. 음성 메모와 앱 오디오는 오른쪽 클릭하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
