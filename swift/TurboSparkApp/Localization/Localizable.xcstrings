    "Use # or /memory text for profile memory. Use /memory project text for this project's memory. Review model suggestions below.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم # أو /memory نص لذاكرة الملف الشخصي. استخدم /memory project نص لذاكرة هذا المشروع. راجع اقتراحات النموذج أدناه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie # oder /memory Text für den Profilspeicher. Verwenden Sie /memory project Text für den Speicher dieses Projekts. Prüfen Sie unten die Modellvorschläge."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use # or /memory text for profile memory. Use /memory project text for this project's memory. Review model suggestions below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa # o /memory texto para la memoria del perfil. Usa /memory project texto para la memoria de este proyecto. Revisa las sugerencias del modelo a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez # ou /memory texte pour la mémoire de profil. Utilisez /memory project texte pour la mémoire de ce projet. Examinez les suggestions du modèle ci-dessous."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש ב-# או /memory text עבור זיכרון הפרופיל. השתמש ב-/memory project text עבור זיכרון הפרויקט. עיין בהצעות המודל להלן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल मेमोरी के लिए # या /memory text का उपयोग करें। इस प्रोजेक्ट की मेमोरी के लिए /memory project text का उपयोग करें। नीचे मॉडल सुझाव देखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan # atau /memory teks untuk memori profil. Gunakan /memory project teks untuk memori proyek ini. Tinjau saran model di bawah ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa # o /memory testo per la memoria del profilo. Usa /memory project testo per la memoria di questo progetto. Rivedi i suggerimenti del modello qui sotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルメモリには # または /memory text を使用します。このプロジェクトのメモリには /memory project text を使用します。以下のモデルの提案を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필 메모리는 # 또는 /memory text를 사용하세요. 이 프로젝트 메모리는 /memory project text를 사용하세요. 아래의 모델 제안을 검토하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik # of /memory tekst voor profielgeheugen. Gebruik /memory project tekst voor het geheugen van dit project. Bekijk de modelsuggesties hieronder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj # lub /memory tekst dla pamięci profilu. Użyj /memory project tekst dla pamięci tego projektu. Przejrzyj sugestie modelu poniżej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use # ou /memory texto para memória de perfil. Use /memory project texto para a memória deste projeto. Revise as sugestões do modelo abaixo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте # или /memory текст для памяти профиля. Используйте /memory project текст для памяти этого проекта. Просмотрите предложения модели ниже."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd # eller /memory text för profilminne. Använd /memory project text för projektminne. Granska modellförslagen nedan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil belleği için # veya /memory metin kullanın. Bu projenin belleği için /memory project metin kullanın. Aşağıdaki model önerilerini inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте # або /memory текст для пам'яті профілю. Використовуйте /memory project текст для пам'яті цього проекту. Перегляньте пропозиції моделі нижче."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng # hoặc /memory văn bản cho bộ nhớ hồ sơ. Dùng /memory project văn bản cho bộ nhớ dự án này. Xem lại gợi ý mô hình bên dưới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 # 或 /memory 文本添加个人资料记忆。使用 /memory project 文本添加当前项目记忆。查看下方的模型建议。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 # 或 /memory 文字新增個人檔案記憶。使用 /memory project 文字新增目前專案記憶。查看下方的模型建議。"
          }
        }
      }
    },
