            "value": "\u4efb\u4f55\u63a5\u53d7\u57fa\u790e URL \u7684\u7528\u6236\u7aef\uff1aCursor\u3001Continue\u3001LangChain\u3002"
          }
        }
      }
    },
    "Any process on this machine can reach this server. Set a key under Advanced.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0645\u0643\u0646 \u0644\u0623\u064a \u0639\u0645\u0644\u064a\u0629 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062e\u0627\u062f\u0645. \u0639\u064a\u0651\u0646 \u0645\u0641\u062a\u0627\u062d\u064b\u0627 \u0636\u0645\u0646 \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u0645\u062a\u0642\u062f\u0645\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Prozess auf diesem Mac kann diesen Server erreichen. Lege unter \u201eErweitert\u201c einen Schl\u00fcssel fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Any process on this machine can reach this server. Set a key under Advanced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier proceso de este equipo puede acceder a este servidor. Define una clave en Avanzado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout processus de cet ordinateur peut atteindre ce serveur. D\u00e9finissez une cl\u00e9 dans Avanc\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05dc \u05ea\u05d4\u05dc\u05d9\u05da \u05d1\u05de\u05d7\u05e9\u05d1 \u05d4\u05d6\u05d4 \u05d9\u05db\u05d5\u05dc \u05dc\u05d2\u05e9\u05ea \u05dc\u05e9\u05e8\u05ea. \u05d4\u05d2\u05d3\u05e8 \u05de\u05e4\u05ea\u05d7 \u05ea\u05d7\u05ea '\u05de\u05ea\u05e7\u05d3\u05dd'."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092e\u0936\u0940\u0928 \u0915\u0940 \u0915\u094b\u0908 \u092d\u0940 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0907\u0938 \u0938\u0930\u094d\u0935\u0930 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0938\u0915\u0924\u0940 \u0939\u0948\u0964 \u0909\u0928\u094d\u0928\u0924 \u092e\u0947\u0902 \u090f\u0915 \u0915\u0941\u0902\u091c\u0940 \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses apa pun di mesin ini dapat menjangkau server ini. Atur kunci di Lanjutan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualsiasi processo su questo computer pu\u00f2 raggiungere il server. Imposta una chiave in Avanzate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30de\u30b7\u30f3\u4e0a\u306e\u3069\u306e\u30d7\u30ed\u30bb\u30b9\u3082\u3053\u306e\u30b5\u30fc\u30d0\u30fc\u306b\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059\u3002\u8a73\u7d30\u8a2d\u5b9a\u3067\u30ad\u30fc\u3092\u8a2d\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ucef4\ud4e8\ud130\uc758 \ubaa8\ub4e0 \ud504\ub85c\uc138\uc2a4\uac00 \uc774 \uc11c\ubc84\uc5d0 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uace0\uae09\uc5d0\uc11c \ud0a4\ub97c \uc124\uc815\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk proces op deze computer kan deze server bereiken. Stel een sleutel in onder Geavanceerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ka\u017cdy proces na tym komputerze mo\u017ce po\u0142\u0105czy\u0107 si\u0119 z tym serwerem. Ustaw klucz w sekcji Zaawansowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Qualquer processo neste computador pode acessar este servidor. Defina uma chave em Avan\u00e7ado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u044e\u0431\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043d\u0430 \u044d\u0442\u043e\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435 \u043c\u043e\u0436\u0435\u0442 \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u043a \u0441\u0435\u0440\u0432\u0435\u0440\u0443. \u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u043a\u043b\u044e\u0447 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u0414\u043e\u043f\u043e\u043b\u043d\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u00bb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla processer p\u00e5 den h\u00e4r datorn kan n\u00e5 servern. Ange en nyckel under Avancerat."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu makinedeki her i\u015flem bu sunucuya eri\u015febilir. Geli\u015fmi\u015f b\u00f6l\u00fcm\u00fcnden bir anahtar belirleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441 \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u043a\u043e\u043c\u043f'\u044e\u0442\u0435\u0440\u0456 \u043c\u043e\u0436\u0435 \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u0434\u043e \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u043a\u043b\u044e\u0447 \u0443 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u0414\u043e\u0434\u0430\u0442\u043a\u043e\u0432\u043e\u00bb."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1ecdi ti\u1ebfn tr\u00ecnh tr\u00ean m\u00e1y n\u00e0y \u0111\u1ec1u c\u00f3 th\u1ec3 truy c\u1eadp m\u00e1y ch\u1ee7. H\u00e3y \u0111\u1eb7t kh\u00f3a trong N\u00e2ng cao."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u7535\u8111\u4e0a\u7684\u4efb\u4f55\u8fdb\u7a0b\u90fd\u80fd\u8bbf\u95ee\u6b64\u670d\u52a1\u5668\u3002\u8bf7\u5728\u201c\u9ad8\u7ea7\u201d\u4e2d\u8bbe\u7f6e\u5bc6\u94a5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u96fb\u8166\u4e0a\u7684\u4efb\u4f55\u7a0b\u5e8f\u90fd\u80fd\u5b58\u53d6\u6b64\u4f3a\u670d\u5668\u3002\u8acb\u5728\u300c\u9032\u968e\u300d\u4e2d\u8a2d\u5b9a\u91d1\u9470\u3002"
          }
        }
      }
    },
