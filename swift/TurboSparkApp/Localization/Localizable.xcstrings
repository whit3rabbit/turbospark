    "Ask a question, write code, analyze data, or explore new ideas.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ask a question, write code, analyze data, or explore new ideas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una pregunta, escribe código, analiza datos o explora nuevas ideas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posez une question, écrivez du code, analysez des données ou explorez de nouvelles idées."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellen Sie eine Frage, schreiben Sie Code, analysieren Sie Daten oder erkunden Sie neue Ideen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una domanda, scrivi codice, analizza dati o esplora nuove idee."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Faça uma pergunta, escreva código, analise dados ou explore novas ideias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задайте вопрос, напишите код, проанализируйте данные или исследуйте новые идеи."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "質問する、コードを書く、データを分析する、または新しいアイデアを探索します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "질문하기, 코드 작성, 데이터 분석 또는 새로운 아이디어 탐색을 시작하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提出问题、编写代码、分析数据或探索新想法。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "提出問題、編寫程式碼、分析資料或探索新想法。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اطرح سؤالاً، اكتب كودًا، حلل البيانات، أو استكشف أفكارًا جديدة."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई प्रश्न पूछें, कोड लिखें, डेटा का विश्लेषण करें, या नए विचार खोजें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stel een vraag, schrijf code, analyseer gegevens of verken nieuwe ideeën."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadaj pytanie, napisz kod, przeanalizuj dane lub odkrywaj nowe pomysły."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir soru sorun, kod yazın, verileri analiz edin veya yeni fikirler keşfedin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поставте запитання, напишіть код, проаналізуйте дані або досліджуйте нові ідеї."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställ en fråga, skriv kod, analysera data eller utforska nya idéer."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt câu hỏi, viết mã, phân tích dữ liệu hoặc khám phá ý tưởng mới."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajukan pertanyaan, tulis kode, analisis data, atau jelajahi ide-ide baru."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שאל שאלה, כתוב קוד, נתח נתונים או חקור רעיונות חדשים."
          }
        }
      }
    },
