    "ThermalForge is active. Fan speed can be monitored and pinned to maximum from the status bar fan readout.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "برنامج ThermalForge نشط. يمكن مراقبة سرعة المروحة وتثبيتها عند الحد الأقصى من شريط الحالة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge ist aktiv. Die Lüftergeschwindigkeit kann über die Statusleisten-Anzeige überwacht und auf das Maximum fixiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge is active. Fan speed can be monitored and pinned to maximum from the status bar fan readout."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge está activo. La velocidad del ventilador se puede supervisar y fijar al máximo desde el indicador de la barra de estado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge est actif. La vitesse du ventilateur peut être surveillée et fixée au maximum depuis l'indicateur de la barre d'état."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge פעיל. ניתן לעקוב אחר מהירות המאוורר ולקבע אותה למקסימום מקריאת המאוורר בשורת המצב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge सक्रिय है। स्टेटस बार फैन रीडआउट से पंखे की गति की निगरानी की जा सकती है और इसे अधिकतम पर पिन किया जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge aktif. Kecepatan kipas dapat dipantau dan disematkan ke maksimum dari pembacaan kipas bilah status."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge è attivo. La velocità della ventola può essere monitorata e fissata al massimo dall'indicatore nella barra di stato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge はアクティブです。ステータスバーのファン表示からファン速度を監視し、最大値に固定できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge가 활성화되어 있습니다. 상태 표시줄 팬 표시에서 팬 속도를 모니터링하고 최대로 고정할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge is actief. De ventilatorsnelheid kan worden bewaakt en op het maximum worden vastgezet via de ventilatoruitlezing in de statusbalk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge jest aktywny. Prędkość wentylatora można monitorować i przypiąć do maksimum z poziomu wskaźnika na pasku stanu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O ThermalForge está ativo. A velocidade da ventoinha pode ser monitorada e fixada no máximo a partir do indicador da barra de status."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge активен. Скорость вентилятора можно отслеживать и фиксировать на максимуме из индикатора в строке состояния."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge är aktivt. Fläkthastigheten kan övervakas och fästas vid max från statusfältets fläktvisning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge aktif. Fan hızı durum çubuğundaki fan göstergesinden izlenebilir ve maksimuma sabitlenebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge активний. Швидкість вентилятора можна відстежувати та фіксувати на максимумі з індикатора в рядку стану."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge đang hoạt động. Tốc độ quạt có thể được theo dõi và ghim ở mức tối đa từ thông số quạt trên thanh trạng thái."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge 已激活。可以从状态栏风扇读数监控风扇转速并将其固定为最大值。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "ThermalForge 已啟用。可從狀態列風扇讀數監控風扇轉速並將其固定為最大值。"
          }
        }
      }
    },
    "These take effect the next time the server starts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تسري هذه الإعدادات عند بدء تشغيل الخادم في المرة القادمة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Einstellungen werden beim nächsten Serverstart wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These take effect the next time the server starts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos cambios se aplicarán la próxima vez que se inicie el servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces réglages prendront effet au prochain démarrage du serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההגדרות האלה ייכנסו לתוקף בהפעלה הבאה של השרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये अगली बार सर्वर शुरू होने पर लागू होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini berlaku saat server dijalankan berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste impostazioni avranno effetto al prossimo avvio del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これらは次回サーバーを起動したときに反映されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정은 서버를 다음에 시작할 때 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze worden van kracht wanneer de server de volgende keer start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaczną obowiązywać przy następnym uruchomieniu serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas configurações entram em vigor no próximo início do servidor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти настройки вступят в силу при следующем запуске сервера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dessa träder i kraft nästa gång servern startar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar, sunucu bir sonraki başlatıldığında etkili olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ці налаштування наберуть чинності під час наступного запуску сервера."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thiết lập này có hiệu lực trong lần khởi động máy chủ tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些设置将在下次启动服务器时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些設定將在下次啟動伺服器時生效。"
          }
        }
      }
    },
