    "Finds who spoke when, after the take stops.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد من تحدّث ومتى بعد توقف التسجيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermittelt nach dem Ende der Aufnahme, wer wann gesprochen hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finds who spoke when, after the take stops."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detecta quién habló y cuándo, cuando termina la grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifie qui a parlé et quand, une fois l'enregistrement arrêté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מזהה מי דיבר ומתי, אחרי שההקלטה נעצרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकॉर्डिंग रुकने के बाद पता लगाता है कि कौन कब बोला।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menemukan siapa berbicara kapan, setelah rekaman berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Individua chi ha parlato e quando, al termine della registrazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "録音を止めた後に、誰がいつ話したかを判別します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "녹음이 끝나면 누가 언제 말했는지 찾습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bepaalt na afloop van de opname wie wanneer sprak."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zakończeniu nagrania ustala, kto i kiedy mówił."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Identifica quem falou e quando, depois que a gravação termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Определяет, кто и когда говорил, после остановки записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar reda på vem som talade när, efter att inspelningen stoppats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt durduktan sonra kimin ne zaman konuştuğunu bulur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Визначає, хто й коли говорив, після зупинки запису."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác định ai nói khi nào sau khi lượt ghi dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音停止后，找出谁在何时发言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錄音停止後，找出誰在何時發言。"
          }
        }
      }
    },
    "Finish or cancel the running work before switching profiles.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل العمل الجاري أو ألغه قبل تبديل الملف الشخصي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließen Sie die laufende Arbeit ab oder brechen Sie sie ab, bevor Sie das Profil wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish or cancel the running work before switching profiles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina o cancela el trabajo en curso antes de cambiar de perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez ou annulez le travail en cours avant de changer de profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סיים או בטל את העבודה הפעילה לפני החלפת הפרופיל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल बदलने से पहले चल रहा काम पूरा करें या रद्द करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan atau batalkan pekerjaan yang sedang berjalan sebelum berganti profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa o annulla il lavoro in corso prima di cambiare profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイルを切り替える前に、実行中の処理を完了するかキャンセルしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로필을 전환하기 전에 실행 중인 작업을 완료하거나 취소하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rond het lopende werk af of annuleer het voordat je van profiel wisselt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończ lub anuluj trwającą pracę przed zmianą profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua ou cancele o trabalho em andamento antes de trocar de perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершите или отмените текущую работу перед сменой профиля."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slutför eller avbryt pågående arbete innan du byter profil."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profili değiştirmeden önce çalışan işi tamamlayın veya iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Завершіть або скасуйте поточну роботу перед зміною профілю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hoàn tất hoặc hủy công việc đang chạy trước khi chuyển hồ sơ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "切换配置档案前，请先完成或取消正在进行的工作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "切換設定檔前，請先完成或取消正在進行的工作。"
          }
        }
      }
    },
    "Finish or stop the current turn before switching models.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
