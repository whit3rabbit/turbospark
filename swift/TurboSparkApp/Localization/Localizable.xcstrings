        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'\u00e8 nulla in esecuzione in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d0\u30c3\u30af\u30b0\u30e9\u30a6\u30f3\u30c9\u3067\u5b9f\u884c\u4e2d\u306e\u3082\u306e\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubc31\uadf8\ub77c\uc6b4\ub4dc\uc5d0\uc11c \uc2e4\ud589 \uc911\uc778 \ud56d\ubaa9\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
