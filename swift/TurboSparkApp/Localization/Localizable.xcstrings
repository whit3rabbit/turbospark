        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u672a\u9644\u52a0\u5c08\u6848\u8cc7\u6599\u593e\u3002\u5728\u5c08\u6848\u8a2d\u5b9a\u4e2d\u8a2d\u5b9a\u8cc7\u6599\u593e\u4ee5\u8b80\u53d6 AGENTS.md\u3002"
