          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u4f7f\u7528\u89e6\u63a7 ID \u6216 Mac \u767b\u5f55\u8ba4\u8bc1\u3002"
