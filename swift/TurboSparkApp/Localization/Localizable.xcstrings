    "Index ready for fast code search.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0641\u0647\u0631\u0633 \u062c\u0627\u0647\u0632 \u0644\u0644\u0628\u062d\u062b \u0627\u0644\u0633\u0631\u064a\u0639 \u0641\u064a \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Index ist f\u00fcr die schnelle Codesuche bereit."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Index ready for fast code search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El \u00edndice est\u00e1 listo para una b\u00fasqueda r\u00e1pida de c\u00f3digo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'index est pr\u00eat pour la recherche rapide de code."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d0\u05d9\u05e0\u05d3\u05e7\u05e1 \u05de\u05d5\u05db\u05df \u05dc\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e7\u05d5\u05d3 \u05de\u05d4\u05d9\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0924\u0947\u091c\u093c \u0915\u094b\u0921 \u0916\u094b\u091c \u0915\u0947 \u0932\u093f\u090f \u0907\u0902\u0921\u0947\u0915\u094d\u0938 \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks siap untuk pencarian kode cepat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'indice \u00e8 pronto per la ricerca rapida nel codice."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u901f\u306a\u30b3\u30fc\u30c9\u691c\u7d22\u306e\u6e96\u5099\u304c\u3067\u304d\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ube60\ub978 \ucf54\ub4dc \uac80\uc0c9\uc744 \uc704\ud55c \uc778\ub371\uc2a4\uac00 \uc900\ube44\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De index is klaar voor snel zoeken in code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Indeks jest gotowy do szybkiego wyszukiwania kodu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O \u00edndice est\u00e1 pronto para pesquisa r\u00e1pida de c\u00f3digo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043d\u0434\u0435\u043a\u0441 \u0433\u043e\u0442\u043e\u0432 \u0434\u043b\u044f \u0431\u044b\u0441\u0442\u0440\u043e\u0433\u043e \u043f\u043e\u0438\u0441\u043a\u0430 \u043f\u043e \u043a\u043e\u0434\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Indexet \u00e4r klart f\u00f6r snabb kods\u00f6kning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dizin h\u0131zl\u0131 kod aramas\u0131 i\u00e7in haz\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0406\u043d\u0434\u0435\u043a\u0441 \u0433\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e \u0448\u0432\u0438\u0434\u043a\u043e\u0433\u043e \u043f\u043e\u0448\u0443\u043a\u0443 \u0432 \u043a\u043e\u0434\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ec9 m\u1ee5c \u0111\u00e3 s\u1eb5n s\u00e0ng \u0111\u1ec3 t\u00ecm ki\u1ebfm m\u00e3 nhanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7d22\u5f15\u5df2\u5c31\u7eea\uff0c\u53ef\u5feb\u901f\u641c\u7d22\u4ee3\u7801\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
