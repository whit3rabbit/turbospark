    "Register and choose a steering direction. Click to open Settings.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل اتجاه توجيه واختره. انقر لفتح الإعدادات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Steuerungsrichtung registrieren und auswählen. Klicke, um die Einstellungen zu öffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Register and choose a steering direction. Click to open Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra y elige una dirección. Haz clic para abrir los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez et choisissez une direction d'orientation. Cliquez pour ouvrir les réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשום ובחר כיוון היגוי. לחץ לפתיחת ההגדרות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक स्टीयरिंग दिशा दर्ज करें और चुनें। सेटिंग खोलने के लिए क्लिक करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftarkan dan pilih arah pengarahan. Klik untuk membuka Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra e scegli una direzione di indirizzamento. Fai clic per aprire le impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ステアリングの方向を登録して選択します。クリックすると設定を開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "스티어링 방향을 등록하고 선택하세요. 클릭하면 설정이 열립니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Registreer en kies een sturingsrichting. Klik om Instellingen te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarejestruj i wybierz kierunek sterowania. Kliknij, aby otworzyć ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registre e escolha uma direção de direcionamento. Clique para abrir os ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарегистрируйте и выберите направление. Нажмите, чтобы открыть настройки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrera och välj en styrningsriktning. Klicka för att öppna inställningarna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir yönlendirme yönü kaydedip seçin. Ayarları açmak için tıklayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зареєструйте й виберіть напрям. Натисніть, щоб відкрити налаштування."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng ký và chọn một hướng điều hướng. Nhấp để mở Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "注册并选择引导方向。点按以打开设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "註冊並選擇引導方向。按一下以開啟設定。"
          }
        }
      }
    },
