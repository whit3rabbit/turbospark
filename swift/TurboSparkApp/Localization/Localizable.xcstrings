    "Native, so Claude Code and other Anthropic clients need no proxy in between.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوافق أصلًا، لذا لا يحتاج Claude Code وعملاء Anthropic الآخرون إلى وسيط."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativ, sodass Claude Code und andere Anthropic-Clients keinen Proxy dazwischen brauchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Native, so Claude Code and other Anthropic clients need no proxy in between."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativo, así que Claude Code y otros clientes de Anthropic no necesitan un proxy intermedio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Natif : Claude Code et les autres clients Anthropic n'ont besoin d'aucun proxy intermédiaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקורי, כך ש-Claude Code ולקוחות Anthropic אחרים אינם צריכים שרת ביניים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नेटिव, इसलिए Claude Code और अन्य Anthropic क्लाइंट को बीच में किसी प्रॉक्सी की ज़रूरत नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Native, jadi Claude Code dan klien Anthropic lain tidak memerlukan proxy di antaranya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativo, quindi Claude Code e gli altri client Anthropic non richiedono un proxy intermedio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ネイティブ対応のため、Claude Code などの Anthropic クライアントは間にプロキシを挟む必要がありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "네이티브라서 Claude Code 및 기타 Anthropic 클라이언트에 중간 프록시가 필요 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Native, dus Claude Code en andere Anthropic-clients hebben geen proxy ertussen nodig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natywnie, więc Claude Code i inni klienci Anthropic nie potrzebują pośredniczącego proxy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativo, então o Claude Code e outros clientes Anthropic não precisam de proxy intermediário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативно, поэтому Claude Code и другим клиентам Anthropic не нужен промежуточный прокси."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativt, så Claude Code och andra Anthropic-klienter behöver ingen proxy emellan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel destek; Claude Code ve diğer Anthropic istemcileri arada vekil sunucuya ihtiyaç duymaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативно, тож Claude Code та іншим клієнтам Anthropic не потрібен проміжний проксі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hỗ trợ gốc nên Claude Code và các ứng dụng khách Anthropic khác không cần proxy trung gian."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "原生支持，Claude Code 及其他 Anthropic 客户端无需中间代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "原生支援，Claude Code 及其他 Anthropic 用戶端無需中間代理。"
          }
        }
      }
    },
