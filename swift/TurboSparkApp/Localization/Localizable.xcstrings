        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ carregado. O racioc\u00ednio %@ n\u00e3o est\u00e1 dispon\u00edvel aqui; usando %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043e: %@. \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f %@ \u0437\u0434\u0435\u0441\u044c \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442\u0441\u044f %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ har l\u00e4sts in. Resonemangsniv\u00e5n %@ \u00e4r inte tillg\u00e4nglig h\u00e4r, %@ anv\u00e4nds."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y\u00fcklendi. %@ ak\u0131l y\u00fcr\u00fctme d\u00fczeyi burada kullan\u0131lam\u0131yor, %@ kullan\u0131l\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e: %@. \u0420\u0456\u0432\u0435\u043d\u044c \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u043d\u044f %@ \u0442\u0443\u0442 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 t\u1ea3i %@. M\u1ee9c suy lu\u1eadn %@ kh\u00f4ng kh\u1ea3 d\u1ee5ng \u1edf \u0111\u00e2y, \u0111ang d\u00f9ng %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u52a0\u8f7d %@\u3002\u6b64\u5904\u4e0d\u652f\u6301\u63a8\u7406\u7ea7\u522b %@\uff0c\u6539\u7528 %@\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8f09\u5165 %@\u3002\u6b64\u8655\u4e0d\u652f\u63f4\u63a8\u7406\u7b49\u7d1a %@\uff0c\u6539\u7528 %@\u3002"
          }
        }
      }
    },
    "Loaded model: %@. Give a name to switch, e.g. /model %@.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062d\u0645\u064e\u0651\u0644: %@. \u0623\u062f\u062e\u0644 \u0627\u0633\u0645\u064b\u0627 \u0644\u0644\u062a\u0628\u062f\u064a\u0644\u060c \u0645\u062b\u0644 /model %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladenes Modell: %@. Geben Sie zum Wechseln einen Namen an, z. B. /model %@."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Loaded model: %@. Give a name to switch, e.g. /model %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo cargado: %@. Indica un nombre para cambiar, p. ej. /model %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod\u00e8le charg\u00e9 : %@. Indiquez un nom pour changer, p. ex. /model %@."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d5\u05d3\u05dc \u05d4\u05d8\u05e2\u05d5\u05df: %@. \u05e6\u05d9\u05d9\u05df \u05e9\u05dd \u05db\u05d3\u05d9 \u05dc\u05d4\u05d7\u05dc\u05d9\u05e3, \u05dc\u05de\u05e9\u05dc /model %@."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092e\u0949\u0921\u0932: %@\u0964 \u092c\u0926\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u093e\u092e \u0926\u0947\u0902, \u091c\u0948\u0938\u0947 /model %@\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model dimuat: %@. Berikan nama untuk beralih, mis. /model %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello caricato: %@. Indica un nome per cambiare, ad es. /model %@."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8aad\u307f\u8fbc\u307f\u6e08\u307f\u30e2\u30c7\u30eb: %@\u3002\u5207\u308a\u66ff\u3048\u308b\u306b\u306f\u540d\u524d\u3092\u6307\u5b9a\u3057\u307e\u3059 (\u4f8b: /model %@)\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub85c\ub4dc\ub41c \ubaa8\ub378: %@. \uc804\ud658\ud558\ub824\uba74 \uc774\ub984\uc744 \uc785\ub825\ud558\uc138\uc694(\uc608: /model %@)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geladen model: %@. Geef een naam op om te wisselen, bijv. /model %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytany model: %@. Podaj nazw\u0119, aby prze\u0142\u0105czy\u0107, np. /model %@."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo carregado: %@. Informe um nome para trocar, por exemplo /model %@."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u0430\u044f \u043c\u043e\u0434\u0435\u043b\u044c: %@. \u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u0438\u043c\u044f \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u044f, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 /model %@."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inl\u00e4st modell: %@. Ange ett namn f\u00f6r att byta, t.ex. /model %@."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fckl\u00fc model: %@. Ge\u00e7i\u015f yapmak i\u00e7in bir ad girin, \u00f6r. /model %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u044c: %@. \u0412\u043a\u0430\u0436\u0456\u0442\u044c \u043d\u0430\u0437\u0432\u0443 \u0434\u043b\u044f \u043f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u043d\u043d\u044f, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 /model %@."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 h\u00ecnh \u0111\u00e3 t\u1ea3i: %@. Nh\u1eadp t\u00ean \u0111\u1ec3 chuy\u1ec3n, v\u00ed d\u1ee5 /model %@."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u52a0\u8f7d\u6a21\u578b\uff1a%@\u3002\u8f93\u5165\u540d\u79f0\u5373\u53ef\u5207\u6362\uff0c\u4f8b\u5982 /model %@\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8f09\u5165\u6a21\u578b\uff1a%@\u3002\u8f38\u5165\u540d\u7a31\u5373\u53ef\u5207\u63db\uff0c\u4f8b\u5982 /model %@\u3002"
          }
        }
      }
    },
