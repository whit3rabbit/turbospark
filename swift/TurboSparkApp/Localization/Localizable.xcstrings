    "Open a project to install into one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0641\u062a\u062d \u0645\u0634\u0631\u0648\u0639\u0627 \u0644\u0644\u062a\u062b\u0628\u064a\u062a \u0641\u064a\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ffnen Sie ein Projekt, um darin zu installieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open a project to install into one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un proyecto para instalar en \u00e9l."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez un projet pour y installer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05ea\u05d7 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05e7\u05d9\u05df \u05dc\u05ea\u05d5\u05db\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u093f\u0938\u0940 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u092e\u0947\u0902 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0938\u0947 \u0916\u094b\u0932\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka proyek untuk memasang ke dalamnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri un progetto per installarvi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u5148\u306b\u3059\u308b\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u958b\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc124\uce58\ud560 \ud504\ub85c\uc81d\ud2b8\ub97c \uc5ec\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open een project om daarin te installeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otw\u00f3rz projekt, aby w nim zainstalowa\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra um projeto para instalar nele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u043f\u0440\u043e\u0435\u043a\u0442, \u0447\u0442\u043e\u0431\u044b \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0432 \u043d\u0435\u0433\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ppna ett projekt f\u00f6r att installera i det."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130\u00e7ine kurmak i\u00e7in bir proje a\u00e7\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
