            "state": "translated",
            "value": "Salvar esta fonte como"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u044d\u0442\u043e\u0442 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a \u043a\u0430\u043a"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
