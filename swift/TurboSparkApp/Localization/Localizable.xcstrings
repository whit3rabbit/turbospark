    "Installed by Claude Code and managed read-only here. Removing it only clears TurboSpark's enable record.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّته Claude Code ويُدار هنا للقراءة فقط. إزالته تمسح فقط سجل التفعيل في TurboSpark."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von Claude Code installiert und hier schreibgeschützt verwaltet. Beim Entfernen wird nur der Aktivierungseintrag von TurboSpark gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed by Claude Code and managed read-only here. Removing it only clears TurboSpark's enable record."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado por Claude Code y gestionado aquí en solo lectura. Quitarlo solo borra el registro de activación de TurboSpark."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé par Claude Code et géré ici en lecture seule. Le supprimer efface uniquement l’enregistrement d’activation de TurboSpark."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הותקן על ידי Claude Code ומנוהל כאן לקריאה בלבד. הסרתו מוחקת רק את רשומת ההפעלה של TurboSpark."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code द्वारा इंस्टॉल किया गया और यहाँ केवल-पढ़ने के रूप में प्रबंधित। इसे हटाने से केवल TurboSpark का सक्षम रिकॉर्ड साफ़ होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipasang oleh Claude Code dan dikelola hanya-baca di sini. Menghapusnya hanya menghapus catatan aktivasi TurboSpark."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installato da Claude Code e gestito qui in sola lettura. Rimuoverlo cancella solo il record di attivazione di TurboSpark."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code によってインストールされ、ここでは読み取り専用で管理されます。削除しても TurboSpark の有効化記録が消えるだけです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code가 설치했으며 여기서는 읽기 전용으로 관리됩니다. 제거하면 TurboSpark의 활성화 기록만 지워집니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïnstalleerd door Claude Code en hier alleen-lezen beheerd. Verwijderen wist alleen de activeringsregistratie van TurboSpark."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstalowane przez Claude Code i zarządzane tutaj tylko do odczytu. Usunięcie czyści jedynie wpis włączenia w TurboSpark."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado pelo Claude Code e gerenciado aqui somente para leitura. Removê-lo apenas apaga o registro de ativação do TurboSpark."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлено Claude Code и управляется здесь только для чтения. Удаление стирает лишь запись о включении в TurboSpark."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerat av Claude Code och hanteras här som skrivskyddat. Att ta bort det rensar bara TurboSparks aktiveringspost."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude Code tarafından kuruldu ve burada salt okunur olarak yönetiliyor. Kaldırmak yalnızca TurboSpark'ın etkinleştirme kaydını siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлено Claude Code і керується тут лише для читання. Видалення стирає лише запис про ввімкнення в TurboSpark."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Do Claude Code cài đặt và chỉ được quản lý ở chế độ chỉ đọc tại đây. Gỡ bỏ chỉ xóa bản ghi bật của TurboSpark."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Claude Code 安装，此处仅以只读方式管理。移除它只会清除 TurboSpark 的启用记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 Claude Code 安裝，此處僅以唯讀方式管理。移除它只會清除 TurboSpark 的啟用記錄。"
          }
        }
      }
    },
