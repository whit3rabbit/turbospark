    "Search matches exact words. Download %@ in Settings > Memory to also search by meaning and sound.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطابق البحث الكلمات الحرفية. نزّل %@ من الإعدادات > الذاكرة للبحث أيضًا بالمعنى والصوت."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche findet exakte Wörter. Laden Sie %@ unter Einstellungen > Gedächtnis, um auch nach Bedeutung und Klang zu suchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search matches exact words. Download %@ in Settings > Memory to also search by meaning and sound."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda encuentra palabras exactas. Descarga %@ en Ajustes > Memoria para buscar también por significado y sonido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche trouve les mots exacts. Téléchargez %@ dans Réglages > Mémoire pour rechercher aussi par sens et par son."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיפוש מתאים למילים מדויקות. הורידו את %@ בהגדרות > זיכרון כדי לחפש גם לפי משמעות וצליל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज सटीक शब्दों से मेल खाती है। अर्थ और ध्वनि से भी खोजने के लिए सेटिंग्स > मेमोरी में %@ डाउनलोड करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian mencocokkan kata persis. Unduh %@ di Pengaturan > Memori untuk juga mencari berdasarkan makna dan suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca trova parole esatte. Scarica %@ in Impostazioni > Memoria per cercare anche per significato e suono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索は完全一致の単語を探します。意味やサウンドでも検索するには、設定 > メモリで%@をダウンロードしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색은 정확한 단어를 찾습니다. 의미와 소리로도 검색하려면 설정 > 메모리에서 %@을(를) 다운로드하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken vindt exacte woorden. Download %@ via Instellingen > Geheugen om ook op betekenis en geluid te zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie znajduje dokładne słowa. Pobierz %@ w Ustawienia > Pamięć, aby wyszukiwać także po znaczeniu i dźwięku."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca encontra palavras exatas. Baixe %@ em Ajustes > Memória para buscar também por significado e som."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск находит точные слова. Скачайте %@ в «Настройки > Память», чтобы искать также по смыслу и звуку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökningen hittar exakta ord. Ladda ned %@ under Inställningar > Minne för att även söka på betydelse och ljud."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama tam kelimeleri bulur. Anlam ve sese göre de aramak için %@ modelini Ayarlar > Bellek bölümünden indirin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук знаходить точні слова. Завантажте %@ у «Налаштування > Пам'ять», щоб шукати також за змістом і звуком."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm khớp từ chính xác. Tải %@ trong Cài đặt > Bộ nhớ để tìm thêm theo ý nghĩa và âm thanh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索会匹配完全相同的字词。在“设置 > 记忆”中下载 %@，即可同时按含义和声音搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋會比對完全相同的字詞。在「設定 > 記憶」中下載 %@，即可同時依含義與聲音搜尋。"
          }
        }
      }
    },
    "Search matches exact words. Meaning and sound search need an embedding model this catalog does not list.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يطابق البحث الكلمات الحرفية. يتطلب البحث بالمعنى والصوت نموذج تضمين غير مدرج في هذا الكتالوج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Suche findet exakte Wörter. Für die Suche nach Bedeutung und Klang wird ein Embedding-Modell benötigt, das dieser Katalog nicht enthält."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Search matches exact words. Meaning and sound search need an embedding model this catalog does not list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La búsqueda encuentra palabras exactas. Buscar por significado y sonido requiere un modelo de embeddings que este catálogo no incluye."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La recherche trouve les mots exacts. La recherche par sens et par son nécessite un modèle d'embeddings absent de ce catalogue."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החיפוש מתאים למילים מדויקות. חיפוש לפי משמעות וצליל דורש מודל הטמעה שאינו מופיע בקטלוג זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खोज सटीक शब्दों से मेल खाती है। अर्थ और ध्वनि से खोज के लिए एक एम्बेडिंग मॉडल चाहिए जो इस कैटलॉग में नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian mencocokkan kata persis. Pencarian makna dan suara memerlukan model embedding yang tidak tercantum di katalog ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La ricerca trova parole esatte. La ricerca per significato e suono richiede un modello di embedding che questo catalogo non elenca."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索は完全一致の単語を探します。意味やサウンドで検索するには、このカタログにない埋め込みモデルが必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검색은 정확한 단어를 찾습니다. 의미와 소리 검색에는 이 카탈로그에 없는 임베딩 모델이 필요합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zoeken vindt exacte woorden. Zoeken op betekenis en geluid vereist een embeddingmodel dat deze catalogus niet bevat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyszukiwanie znajduje dokładne słowa. Wyszukiwanie po znaczeniu i dźwięku wymaga modelu osadzeń, którego nie ma w tym katalogu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A busca encontra palavras exatas. A busca por significado e som precisa de um modelo de embeddings que este catálogo não lista."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поиск находит точные слова. Для поиска по смыслу и звуку нужна модель эмбеддингов, которой нет в этом каталоге."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sökningen hittar exakta ord. Sökning på betydelse och ljud kräver en inbäddningsmodell som inte finns i den här katalogen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arama tam kelimeleri bulur. Anlam ve ses araması, bu katalogda bulunmayan bir gömme modeli gerektirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошук знаходить точні слова. Для пошуку за змістом і звуком потрібна модель ембедингів, якої немає в цьому каталозі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tìm kiếm khớp từ chính xác. Tìm theo ý nghĩa và âm thanh cần một mô hình nhúng mà danh mục này không có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索会匹配完全相同的字词。按含义和声音搜索需要一个此目录中没有的嵌入模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "搜尋會比對完全相同的字詞。依含義與聲音搜尋需要一個此目錄中沒有的嵌入模型。"
          }
        }
      }
    },
