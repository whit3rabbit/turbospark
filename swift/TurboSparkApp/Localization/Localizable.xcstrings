        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 d\u1eabn xu\u1ea5t kh\u00f3a t\u1eeb c\u1ee5m m\u1eadt kh\u1ea9u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u4ece\u53e3\u4ee4\u6d3e\u751f\u5bc6\u94a5\u3002"
