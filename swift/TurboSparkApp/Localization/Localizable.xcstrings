    "Pick the directory this server is launched in": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0627\u0644\u0645\u062c\u0644\u062f \u0627\u0644\u0630\u064a \u064a\u064f\u0634\u063a\u064e\u0651\u0644 \u0641\u064a\u0647 \u0647\u0630\u0627 \u0627\u0644\u062e\u0627\u062f\u0645"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzeichnis w\u00e4hlen, in dem dieser Server gestartet wird"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick the directory this server is launched in"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige el directorio en el que se inicia este servidor"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir le dossier dans lequel ce serveur est lanc\u00e9"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05d0\u05ea \u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05e9\u05d1\u05d4 \u05d4\u05e9\u05e8\u05ea \u05d4\u05d6\u05d4 \u05de\u05d5\u05e4\u05e2\u05dc"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0939 \u0921\u093e\u092f\u0930\u0947\u0915\u094d\u091f\u0930\u0940 \u091a\u0941\u0928\u0947\u0902 \u091c\u093f\u0938\u092e\u0947\u0902 \u092f\u0939 \u0938\u0930\u094d\u0935\u0930 \u091a\u0932\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih direktori tempat server ini dijalankan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli la cartella in cui viene avviato questo server"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30b5\u30fc\u30d0\u30fc\u3092\u8d77\u52d5\u3059\u308b\u30c7\u30a3\u30ec\u30af\u30c8\u30ea\u3092\u9078\u629e"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc11c\ubc84\ub97c \uc2e4\ud589\ud560 \ub514\ub809\ud130\ub9ac \uc120\ud0dd"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies de map waarin deze server wordt gestart"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz katalog, w kt\u00f3rym uruchamiany jest ten serwer"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha o diret\u00f3rio em que este servidor \u00e9 iniciado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0440\u0430\u0442\u044c \u043a\u0430\u0442\u0430\u043b\u043e\u0433, \u0432 \u043a\u043e\u0442\u043e\u0440\u043e\u043c \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0435\u0442\u0441\u044f \u044d\u0442\u043e\u0442 \u0441\u0435\u0440\u0432\u0435\u0440"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj katalogen som servern startas i"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucunun ba\u015flat\u0131laca\u011f\u0131 dizini se\u00e7in"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0440\u0430\u0442\u0438 \u043a\u0430\u0442\u0430\u043b\u043e\u0433, \u0443 \u044f\u043a\u043e\u043c\u0443 \u0437\u0430\u043f\u0443\u0441\u043a\u0430\u0454\u0442\u044c\u0441\u044f \u0446\u0435\u0439 \u0441\u0435\u0440\u0432\u0435\u0440"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn th\u01b0 m\u1ee5c m\u00e0 m\u00e1y ch\u1ee7 n\u00e0y \u0111\u01b0\u1ee3c kh\u1edfi ch\u1ea1y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u542f\u52a8\u6b64\u670d\u52a1\u5668\u7684\u76ee\u5f55"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u555f\u52d5\u6b64\u4f3a\u670d\u5668\u7684\u76ee\u9304"
          }
        }
      }
