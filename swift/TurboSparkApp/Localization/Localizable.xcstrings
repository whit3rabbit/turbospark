    "Sample interface text with active styling, contrast and accent colors.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0635 \u0648\u0627\u062c\u0647\u0629 \u062a\u062c\u0631\u064a\u0628\u064a \u0628\u0627\u0644\u062a\u0646\u0633\u064a\u0642 \u0648\u0627\u0644\u062a\u0628\u0627\u064a\u0646 \u0648\u0623\u0644\u0648\u0627\u0646 \u0627\u0644\u062a\u0645\u064a\u064a\u0632 \u0627\u0644\u0646\u0634\u0637\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beispieltext der Oberfl\u00e4che mit aktivem Stil, Kontrast und Akzentfarben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sample interface text with active styling, contrast and accent colors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de interfaz de muestra con el estilo, el contraste y los colores de acento activos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exemple de texte d'interface avec le style, le contraste et les couleurs d'accent actifs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05e7\u05e1\u05d8 \u05de\u05de\u05e9\u05e7 \u05dc\u05d3\u05d5\u05d2\u05de\u05d4 \u05e2\u05dd \u05d4\u05e1\u05d2\u05e0\u05d5\u05df, \u05d4\u05e0\u05d9\u05d2\u05d5\u05d3\u05d9\u05d5\u05ea \u05d5\u05e6\u05d1\u05e2\u05d9 \u05d4\u05d4\u05d3\u05d2\u05e9\u05d4 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0915\u094d\u0930\u093f\u092f \u0938\u094d\u091f\u093e\u0907\u0932, \u0915\u0902\u091f\u094d\u0930\u093e\u0938\u094d\u091f \u0914\u0930 \u090f\u0915\u094d\u0938\u0947\u0902\u091f \u0930\u0902\u0917\u094b\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0928\u092e\u0942\u0928\u093e \u0907\u0902\u091f\u0930\u092b\u093c\u0947\u0938 \u091f\u0947\u0915\u094d\u0938\u094d\u091f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh teks antarmuka dengan gaya, kontras, dan warna aksen yang aktif."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo di esempio dell'interfaccia con stile, contrasto e colori di accento attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u306e\u30b9\u30bf\u30a4\u30eb\u3001\u30b3\u30f3\u30c8\u30e9\u30b9\u30c8\u3001\u30a2\u30af\u30bb\u30f3\u30c8\u30ab\u30e9\u30fc\u3092\u9069\u7528\u3057\u305f\u30a4\u30f3\u30bf\u30fc\u30d5\u30a7\u30a4\u30b9\u306e\u30b5\u30f3\u30d7\u30eb\u30c6\u30ad\u30b9\u30c8\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud604\uc7ac \uc2a4\ud0c0\uc77c, \ub300\ube44, \uac15\uc870\uc0c9\uc774 \uc801\uc6a9\ub41c \uc778\ud130\ud398\uc774\uc2a4 \uc0d8\ud50c \ud14d\uc2a4\ud2b8\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeldtekst van de interface met de actieve stijl, het contrast en de accentkleuren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyk\u0142adowy tekst interfejsu z aktywnym stylem, kontrastem i kolorami akcentu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto de interface de exemplo com o estilo, o contraste e as cores de destaque ativos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u0440\u0430\u0437\u0435\u0446 \u0442\u0435\u043a\u0441\u0442\u0430 \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430 \u0441 \u0430\u043a\u0442\u0438\u0432\u043d\u044b\u043c \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u0438\u0435\u043c, \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u043c \u0438 \u0430\u043a\u0446\u0435\u043d\u0442\u043d\u044b\u043c\u0438 \u0446\u0432\u0435\u0442\u0430\u043c\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Exempeltext f\u00f6r gr\u00e4nssnittet med aktiv stil, kontrast och accentf\u00e4rger."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin bi\u00e7em, kar\u015f\u0131tl\u0131k ve vurgu renkleriyle \u00f6rnek aray\u00fcz metni."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0440\u0430\u0437\u043e\u043a \u0442\u0435\u043a\u0441\u0442\u0443 \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443 \u0437 \u0430\u043a\u0442\u0438\u0432\u043d\u0438\u043c \u043e\u0444\u043e\u0440\u043c\u043b\u0435\u043d\u043d\u044f\u043c, \u043a\u043e\u043d\u0442\u0440\u0430\u0441\u0442\u043e\u043c \u0456 \u0430\u043a\u0446\u0435\u043d\u0442\u043d\u0438\u043c\u0438 \u043a\u043e\u043b\u044c\u043e\u0440\u0430\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u0103n b\u1ea3n giao di\u1ec7n m\u1eabu v\u1edbi ki\u1ec3u d\u00e1ng, \u0111\u1ed9 t\u01b0\u01a1ng ph\u1ea3n v\u00e0 m\u00e0u nh\u1ea5n \u0111ang d\u00f9ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5e94\u7528\u5f53\u524d\u6837\u5f0f\u3001\u5bf9\u6bd4\u5ea6\u548c\u5f3a\u8c03\u8272\u7684\u754c\u9762\u793a\u4f8b\u6587\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5957\u7528\u76ee\u524d\u6a23\u5f0f\u3001\u5c0d\u6bd4\u8207\u5f37\u8abf\u8272\u7684\u4ecb\u9762\u7bc4\u4f8b\u6587\u5b57\u3002"
          }
        }
      }
    },
    "Sampling and prompt changes apply to the next turn. Load settings apply after model reload.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u064f\u0637\u0628\u0642 \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0623\u062e\u0630 \u0627\u0644\u0639\u064a\u0646\u0627\u062a \u0648\u0627\u0644\u0645\u0648\u062c\u0647 \u0641\u064a \u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u062a\u0627\u0644\u064a. \u062a\u064f\u0637\u0628\u0642 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u062d\u0645\u064a\u0644 \u0628\u0639\u062f \u0625\u0639\u0627\u062f\u0629 \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampling- und Prompt-\u00c4nderungen gelten ab der n\u00e4chsten Runde. Ladeeinstellungen werden nach dem Neuladen des Modells wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sampling and prompt changes apply to the next turn. Load settings apply after model reload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios de muestreo y prompt se aplican en el siguiente turno. Los ajustes de carga se aplican tras recargar el modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications d'\u00e9chantillonnage et de prompt s'appliquent au tour suivant. Les param\u00e8tres de chargement s'appliquent apr\u00e8s le rechargement du mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05d9\u05e0\u05d5\u05d9\u05d9 \u05d3\u05d2\u05d9\u05de\u05d4 \u05d5\u05d4\u05e0\u05d7\u05d9\u05d4 \u05d7\u05dc\u05d9\u05dd \u05d1\u05ea\u05d5\u05e8 \u05d4\u05d1\u05d0. \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05d8\u05e2\u05d9\u05e0\u05d4 \u05d7\u05dc\u05d5\u05ea \u05dc\u05d0\u05d7\u05e8 \u05d8\u05e2\u05d9\u05e0\u05d4 \u05de\u05d7\u05d3\u05e9 \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0948\u0902\u092a\u0932\u093f\u0902\u0917 \u0914\u0930 \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0905\u0917\u0932\u0947 \u092e\u094b\u0921\u093c \u092a\u0930 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0932\u094b\u0921 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0949\u0921\u0932 \u092a\u0941\u0928\u0903 \u0932\u094b\u0921 \u0939\u094b\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perubahan pengambilan sampel dan prompt berlaku pada giliran berikutnya. Pengaturan pemuatan berlaku setelah model dimuat ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche al campionamento e ai prompt si applicano al turno successivo. Le impostazioni di caricamento si applicano dopo il ricaricamento del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b5\u30f3\u30d7\u30ea\u30f3\u30b0\u3068\u30d7\u30ed\u30f3\u30d7\u30c8\u306e\u5909\u66f4\u306f\u6b21\u306e\u30bf\u30fc\u30f3\u304b\u3089\u9069\u7528\u3055\u308c\u307e\u3059\u3002\u30ed\u30fc\u30c9\u8a2d\u5b9a\u306f\u30e2\u30c7\u30eb\u306e\u518d\u30ed\u30fc\u30c9\u5f8c\u306b\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0d8\ud50c\ub9c1 \ubc0f \ud504\ub86c\ud504\ud2b8 \ubcc0\uacbd \uc0ac\ud56d\uc740 \ub2e4\uc74c \ud134\ubd80\ud130 \uc801\uc6a9\ub429\ub2c8\ub2e4. \ub85c\ub4dc \uc124\uc815\uc740 \ubaa8\ub378\uc744 \ub2e4\uc2dc \ub85c\ub4dc\ud55c \ud6c4\uc5d0 \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wijzigingen in sampling en prompts worden van kracht bij de volgende beurt. Laadinstellingen worden toegepast na het herladen van het model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmiany pr\u00f3bkowania i promptu obowi\u0105zuj\u0105 od nast\u0119pnej tury. Ustawienia \u0142adowania s\u0105 stosowane po ponownym za\u0142adowaniu modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As altera\u00e7\u00f5es de amostragem e prompt s\u00e3o aplicadas no pr\u00f3ximo turno. As configura\u00e7\u00f5es de carregamento s\u00e3o aplicadas ap\u00f3s recarregar o modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u044f \u0432\u044b\u0431\u043e\u0440\u043a\u0438 \u0438 \u043f\u0440\u043e\u043c\u043f\u0442\u0430 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u0441\u043e \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0435\u0433\u043e \u0445\u043e\u0434\u0430. \u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c4ndringar av sampling och prompt till\u00e4mpas vid n\u00e4sta tur. Laddningsinst\u00e4llningar till\u00e4mpas efter att modellen l\u00e4sts in igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6rnekleme ve istem de\u011fi\u015fiklikleri sonraki turda ge\u00e7erli olur. Y\u00fckleme ayarlar\u0131 model yeniden y\u00fcklendikten sonra uygulan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u043c\u0456\u043d\u0438 \u0432\u0438\u0431\u0456\u0440\u043a\u0438 \u0442\u0430 \u043f\u0440\u043e\u043c\u043f\u0442\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0437 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u043e\u0433\u043e \u0445\u043e\u0434\u0443. \u041d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u043f\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thay \u0111\u1ed5i l\u1ea5y m\u1eabu v\u00e0 c\u00e2u l\u1ec7nh \u00e1p d\u1ee5ng cho l\u01b0\u1ee3t ti\u1ebfp theo. C\u00e0i \u0111\u1eb7t t\u1ea3i \u00e1p d\u1ee5ng sau khi t\u1ea3i l\u1ea1i m\u00f4 h\u00ecnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91c7\u6837\u548c\u63d0\u793a\u8bcd\u66f4\u6539\u5c06\u5728\u4e0b\u4e00\u8f6e\u751f\u6548\u3002\u52a0\u8f7d\u8bbe\u7f6e\u5c06\u5728\u91cd\u65b0\u52a0\u8f7d\u6a21\u578b\u540e\u751f\u6548\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53d6\u6a23\u548c\u63d0\u793a\u8a5e\u8b8a\u66f4\u5c07\u5728\u4e0b\u4e00\u8f2a\u751f\u6548\u3002\u8f09\u5165\u8a2d\u5b9a\u5c07\u5728\u91cd\u65b0\u8f09\u5165\u6a21\u578b\u5f8c\u751f\u6548\u3002"
          }
        }
      }
    },
