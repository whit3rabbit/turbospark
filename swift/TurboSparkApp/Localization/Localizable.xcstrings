    "Queued behind the running turn; drains when it finishes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued behind the running turn; drains when it finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola detrás del turno en curso; se envía cuando termine."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En file derrière le tour en cours ; envoyé quand il se termine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet hinter dem laufenden Durchlauf; wird gesendet, wenn er abgeschlossen ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda dietro il turno in corso; viene inviato quando termina."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fila atrás do turno em andamento; será enviado quando ele terminar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В очереди за текущим ходом; отправится, когда он завершится."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "実行中のターンの後に待機中。ターン終了後に送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 중인 턴 뒤에서 대기 중이며, 턴이 끝나면 전송됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排在当前回合之后；回合结束后自动发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "排在目前回合之後；回合結束後自動送出。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في قائمة الانتظار خلف الدور الجاري؛ يُرسل عند انتهائه."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בתור מאחורי התור הפעיל; יישלח כשיסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चल रहे टर्न के पीछे कतार में; उसके पूरा होने पर भेजा जाएगा।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de wachtrij achter de lopende beurt; wordt verzonden zodra die klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kolejce za bieżącą turą; zostanie wysłane po jej zakończeniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çalışan turun arkasında sırada; tur bitince gönderilecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У черзі за поточним ходом; надішлеться, коли він завершиться."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I kö bakom det pågående varvet; skickas när det är klart."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đang xếp sau lượt đang chạy; sẽ gửi khi lượt đó xong."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengantre di belakang giliran yang berjalan; terkirim saat giliran selesai."
          }
        }
      }
    },
