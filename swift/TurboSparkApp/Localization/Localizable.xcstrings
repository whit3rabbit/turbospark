          "stringUnit": {
            "state": "translated",
            "value": "Esiste gi\u00e0 un server chiamato '%@'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u3068\u3044\u3046\u540d\u524d\u306e\u30b5\u30fc\u30d0\u30fc\u306f\u3059\u3067\u306b\u5b58\u5728\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \uc774\ub984\uc758 \uc11c\ubc84\uac00 \uc774\ubbf8 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er bestaat al een server met de naam '%@'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer o nazwie '%@' ju\u017c istnieje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "J\u00e1 existe um servidor chamado '%@'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0440\u0432\u0435\u0440 \u0441 \u0438\u043c\u0435\u043d\u0435\u043c '%@' \u0443\u0436\u0435 \u0441\u0443\u0449\u0435\u0441\u0442\u0432\u0443\u0435\u0442."
