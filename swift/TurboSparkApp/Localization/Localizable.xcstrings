          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un prompt, modificalo o scrivi il tuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30f3\u30d7\u30c8\u3092\u9078\u3076\u304b\u3001\u7de8\u96c6\u3059\u308b\u304b\u3001\u81ea\u5206\u3067\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud504\ub86c\ud504\ud2b8\ub97c \uace0\ub974\uac70\ub098 \ud3b8\uc9d1\ud558\uac70\ub098 \uc9c1\uc811 \uc791\uc131\ud558\uc138\uc694."
