    "Used for downloading model checkpoints, datasets, and reading imported files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم لتنزيل نقاط حفظ النماذج ومجموعات البيانات وقراءة الملفات المستوردة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird zum Herunterladen von Modell-Checkpoints und Datensätzen sowie zum Lesen importierter Dateien verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used for downloading model checkpoints, datasets, and reading imported files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa para descargar checkpoints de modelos y conjuntos de datos, y para leer archivos importados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé pour télécharger des checkpoints de modèles et des jeux de données, et pour lire les fichiers importés."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "משמש להורדת נקודות שמירה של מודלים ומערכי נתונים ולקריאת קבצים מיובאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल चेकपॉइंट और डेटासेट डाउनलोड करने तथा आयात की गई फ़ाइलें पढ़ने के लिए उपयोग होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan untuk mengunduh checkpoint model dan dataset, serta membaca file yang diimpor."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usata per scaricare checkpoint dei modelli e dataset e per leggere i file importati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルのチェックポイントやデータセットのダウンロード、読み込んだファイルの読み取りに使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델 체크포인트와 데이터 세트를 다운로드하고 가져온 파일을 읽는 데 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruikt voor het downloaden van modelcheckpoints en datasets en het lezen van geïmporteerde bestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używany do pobierania punktów kontrolnych modeli i zbiorów danych oraz odczytu zaimportowanych plików."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado para baixar checkpoints de modelos e conjuntos de dados, e ler arquivos importados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется для загрузки контрольных точек моделей и наборов данных, а также чтения импортированных файлов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används för att ladda ned modellcheckpoints och dataset samt läsa importerade filer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model kontrol noktalarını ve veri kümelerini indirmek ve içe aktarılan dosyaları okumak için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується для завантаження контрольних точок моделей і наборів даних та читання імпортованих файлів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng để tải xuống checkpoint mô hình, bộ dữ liệu và đọc các tệp đã nhập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于下载模型检查点和数据集，以及读取导入的文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用於下載模型檢查點和資料集，以及讀取匯入的檔案。"
          }
        }
      }
    },
    "Used when the tool approval mode is \"Agent (classifier)\"": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُستخدم عندما يكون وضع الموافقة على الأدوات \"وكيل (مصنف)\""
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird verwendet, wenn der Tool-Genehmigungsmodus \"Agent (Klassifikator)\" ist"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when the tool approval mode is \"Agent (classifier)\""
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando el modo de aprobación de herramientas es \"Agente (clasificador)\""
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé lorsque le mode d'approbation des outils est \"Agent (classificateur)\""
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בשימוש כאשר מצב אישור הכלים הוא \"סוכן (מסווג)\""
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब उपयोग किया जाता है जब टूल अनुमोदन मोड \"एजेंट (क्लासिफ़ायर)\" हो"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Digunakan saat mode persetujuan alat adalah \"Agen (pengklasifikasi)\""
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando la modalità di approvazione degli strumenti è \"Agente (classificatore)\""
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール承認モードが「エージェント (分類器)」のときに使用されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 승인 모드가 \"에이전트(분류기)\"일 때 사용됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt gebruikt wanneer de goedkeuringsmodus voor tools \"Agent (classificatie)\" is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane, gdy tryb zatwierdzania narzędzi to \"Agent (klasyfikator)\""
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usado quando o modo de aprovação de ferramentas é \"Agente (classificador)\""
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используется, когда режим одобрения инструментов - \"Агент (классификатор)\""
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Används när verktygens godkännandeläge är \"Agent (klassificerare)\""
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç onay kipi \"Aracı (sınıflandırıcı)\" olduğunda kullanılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовується, коли режим схвалення інструментів - \"Агент (класифікатор)\""
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được dùng khi chế độ phê duyệt công cụ là \"Tác nhân (bộ phân loại)\""
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当工具批准模式为\"代理 (分类器)\"时使用"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當工具核准模式為\"代理 (分類器)\"時使用"
          }
        }
      }
    },
    "Useful for regions with restricted Hugging Face access, e.g. https://hf-mirror.com": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفيد في المناطق التي يكون فيها الوصول إلى Hugging Face مقيدا، مثل https://hf-mirror.com"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nützlich in Regionen mit eingeschränktem Zugriff auf Hugging Face, z. B. https://hf-mirror.com"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Useful for regions with restricted Hugging Face access, e.g. https://hf-mirror.com"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil en regiones con acceso restringido a Hugging Face, por ejemplo https://hf-mirror.com"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile dans les régions où l'accès à Hugging Face est restreint, par ex. https://hf-mirror.com"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שימושי באזורים שבהם הגישה ל-Hugging Face מוגבלת, למשל https://hf-mirror.com"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन क्षेत्रों के लिए उपयोगी जहां Hugging Face तक पहुंच सीमित है, जैसे https://hf-mirror.com"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berguna untuk wilayah dengan akses Hugging Face yang dibatasi, mis. https://hf-mirror.com"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Utile nelle regioni con accesso limitato a Hugging Face, ad es. https://hf-mirror.com"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face へのアクセスが制限されている地域で役立ちます (例: https://hf-mirror.com)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face 접근이 제한된 지역에서 유용합니다. 예: https://hf-mirror.com"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Handig in regio's met beperkte toegang tot Hugging Face, bijv. https://hf-mirror.com"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przydatne w regionach z ograniczonym dostępem do Hugging Face, np. https://hf-mirror.com"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Útil em regiões com acesso restrito ao Hugging Face, por exemplo https://hf-mirror.com"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Полезно в регионах с ограниченным доступом к Hugging Face, например https://hf-mirror.com"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Användbart i regioner med begränsad åtkomst till Hugging Face, t.ex. https://hf-mirror.com"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face erişiminin kısıtlı olduğu bölgelerde yararlıdır, ör. https://hf-mirror.com"
          }
        },
        "uk": {
          "stringUnit": {
