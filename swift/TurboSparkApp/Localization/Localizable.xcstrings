    "Add relevant context to each message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0636\u0627\u0641\u0629 \u0633\u064a\u0627\u0642 \u0630\u064a \u0635\u0644\u0629 \u0625\u0644\u0649 \u0643\u0644 \u0631\u0633\u0627\u0644\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Nachricht relevanten Kontext hinzuf\u00fcgen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add relevant context to each message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00f1adir contexto relevante a cada mensaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter un contexte pertinent \u00e0 chaque message"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e1\u05e4\u05ea \u05d4\u05e7\u05e9\u05e8 \u05e8\u05dc\u05d5\u05d5\u05e0\u05d8\u05d9 \u05dc\u05db\u05dc \u05d4\u05d5\u05d3\u05e2\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u0938\u0902\u0926\u0930\u094d\u092d \u091c\u094b\u0921\u093c\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan konteks yang relevan ke setiap pesan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi contesto pertinente a ogni messaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5404\u30e1\u30c3\u30bb\u30fc\u30b8\u306b\u95a2\u9023\u3059\u308b\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u3092\u8ffd\u52a0"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac01 \uba54\uc2dc\uc9c0\uc5d0 \uad00\ub828 \ucee8\ud14d\uc2a4\ud2b8 \ucd94\uac00"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Relevante context aan elk bericht toevoegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodawaj odpowiedni kontekst do ka\u017cdej wiadomo\u015bci"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar contexto relevante a cada mensagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0431\u0430\u0432\u043b\u044f\u0442\u044c \u0440\u0435\u043b\u0435\u0432\u0430\u043d\u0442\u043d\u044b\u0439 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u043a \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044e"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4gg till relevant kontext i varje meddelande"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her iletiye ilgili ba\u011flam\u0131 ekle"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0434\u0430\u0432\u0430\u0442\u0438 \u0434\u043e\u0440\u0435\u0447\u043d\u0438\u0439 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442 \u0434\u043e \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Th\u00eam ng\u1eef c\u1ea3nh li\u00ean quan v\u00e0o m\u1ed7i tin nh\u1eafn"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u6bcf\u6761\u6d88\u606f\u6dfb\u52a0\u76f8\u5173\u4e0a\u4e0b\u6587"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u6bcf\u5247\u8a0a\u606f\u52a0\u5165\u76f8\u95dc\u4e0a\u4e0b\u6587"
          }
        }
      }
    },
    "Retrieves passages from earlier in the conversation, and from a project's files when the project turns it on, and adds them to the message within the model's context window.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0633\u062a\u0631\u062c\u0639 \u0645\u0642\u0627\u0637\u0639 \u0645\u0646 \u0623\u062c\u0632\u0627\u0621 \u0633\u0627\u0628\u0642\u0629 \u0641\u064a \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629\u060c \u0648\u0645\u0646 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0639\u0646\u062f\u0645\u0627 \u064a\u0641\u0639\u0651\u0644\u0647 \u0627\u0644\u0645\u0634\u0631\u0648\u0639\u060c \u0648\u064a\u0636\u064a\u0641\u0647\u0627 \u0625\u0644\u0649 \u0627\u0644\u0631\u0633\u0627\u0644\u0629 \u0636\u0645\u0646 \u0646\u0627\u0641\u0630\u0629 \u0633\u064a\u0627\u0642 \u0627\u0644\u0646\u0645\u0648\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruft Passagen aus dem bisherigen Gespr\u00e4chsverlauf ab, bei Projekten, die es aktivieren, auch aus den Projektdateien, und f\u00fcgt sie der Nachricht innerhalb des Kontextfensters des Modells hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retrieves passages from earlier in the conversation, and from a project's files when the project turns it on, and adds them to the message within the model's context window."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera fragmentos de partes anteriores de la conversaci\u00f3n, y de los archivos de un proyecto cuando el proyecto lo activa, y los a\u00f1ade al mensaje dentro de la ventana de contexto del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9cup\u00e8re des passages plus anciens de la conversation, ainsi que des fichiers d'un projet lorsque le projet l'active, et les ajoute au message dans la fen\u00eatre de contexte du mod\u00e8le."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d0\u05d7\u05d6\u05e8 \u05e7\u05d8\u05e2\u05d9\u05dd \u05de\u05de\u05e7\u05d5\u05de\u05d5\u05ea \u05e7\u05d5\u05d3\u05de\u05d9\u05dd \u05d1\u05e9\u05d9\u05d7\u05d4, \u05d5\u05de\u05e7\u05d1\u05e6\u05d9 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05db\u05d0\u05e9\u05e8 \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05de\u05e4\u05e2\u05d9\u05dc \u05d6\u05d0\u05ea, \u05d5\u05de\u05d5\u05e1\u05d9\u05e3 \u05d0\u05d5\u05ea\u05dd \u05dc\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d1\u05ea\u05d5\u05da \u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc \u05d4\u05de\u05d5\u05d3\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u093e\u0924\u091a\u0940\u0924 \u0915\u0947 \u092a\u093f\u091b\u0932\u0947 \u0939\u093f\u0938\u094d\u0938\u094b\u0902 \u0938\u0947, \u0914\u0930 \u091c\u092c \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0907\u0938\u0947 \u091a\u093e\u0932\u0942 \u0915\u0930\u0947 \u0924\u094b \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0940 \u092b\u093c\u093e\u0907\u0932\u094b\u0902 \u0938\u0947, \u0905\u0902\u0936 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u092e\u0949\u0921\u0932 \u0915\u0940 \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u0902\u0926\u0947\u0936 \u092e\u0947\u0902 \u091c\u094b\u0921\u093c\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengambil cuplikan dari bagian percakapan sebelumnya, serta dari file proyek jika proyek mengaktifkannya, lalu menambahkannya ke pesan dalam jendela konteks model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera passaggi dalle parti precedenti della conversazione, e dai file di un progetto quando il progetto lo attiva, e li aggiunge al messaggio entro la finestra di contesto del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f1a\u8a71\u306e\u4ee5\u524d\u306e\u90e8\u5206\u3068\u3001\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3067\u6709\u52b9\u306b\u3057\u3066\u3044\u308b\u5834\u5408\u306f\u305d\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u30d5\u30a1\u30a4\u30eb\u304b\u3089\u8a72\u5f53\u7b87\u6240\u3092\u53d6\u5f97\u3057\u3001\u30e2\u30c7\u30eb\u306e\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u306b\u53ce\u307e\u308b\u7bc4\u56f2\u3067\u30e1\u30c3\u30bb\u30fc\u30b8\u306b\u8ffd\u52a0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub300\ud654\uc758 \uc774\uc804 \ubd80\ubd84\uacfc, \ud504\ub85c\uc81d\ud2b8\uc5d0\uc11c \ucf20 \uacbd\uc6b0 \ud504\ub85c\uc81d\ud2b8 \ud30c\uc77c\uc5d0\uc11c \uad00\ub828 \uad6c\uc808\uc744 \uac00\uc838\uc640 \ubaa8\ub378\uc758 \ucee8\ud14d\uc2a4\ud2b8 \ucc3d \uc548\uc5d0\uc11c \uba54\uc2dc\uc9c0\uc5d0 \ucd94\uac00\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt passages op uit eerdere delen van het gesprek, en uit de bestanden van een project als dat project het inschakelt, en voegt ze binnen het contextvenster van het model aan het bericht toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobiera fragmenty z wcze\u015bniejszej cz\u0119\u015bci rozmowy oraz z plik\u00f3w projektu, je\u015bli projekt to w\u0142\u0105czy, i dodaje je do wiadomo\u015bci w granicach okna kontekstu modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupera trechos de partes anteriores da conversa, e dos arquivos de um projeto quando o projeto ativa o recurso, e os adiciona \u00e0 mensagem dentro da janela de contexto do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0432\u043b\u0435\u043a\u0430\u0435\u0442 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u044b \u0438\u0437 \u0431\u043e\u043b\u0435\u0435 \u0440\u0430\u043d\u043d\u0435\u0439 \u0447\u0430\u0441\u0442\u0438 \u0440\u0430\u0437\u0433\u043e\u0432\u043e\u0440\u0430, \u0430 \u0442\u0430\u043a\u0436\u0435 \u0438\u0437 \u0444\u0430\u0439\u043b\u043e\u0432 \u043f\u0440\u043e\u0435\u043a\u0442\u0430, \u0435\u0441\u043b\u0438 \u043f\u0440\u043e\u0435\u043a\u0442 \u044d\u0442\u043e \u0432\u043a\u043b\u044e\u0447\u0438\u043b, \u0438 \u0434\u043e\u0431\u0430\u0432\u043b\u044f\u0435\u0442 \u0438\u0445 \u043a \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044e \u0432 \u043f\u0440\u0435\u0434\u0435\u043b\u0430\u0445 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u0433\u043e \u043e\u043a\u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e4mtar avsnitt fr\u00e5n tidigare i konversationen, och fr\u00e5n ett projekts filer n\u00e4r projektet sl\u00e5r p\u00e5 det, och l\u00e4gger till dem i meddelandet inom modellens kontextf\u00f6nster."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbetin \u00f6nceki b\u00f6l\u00fcmlerinden ve proje bunu a\u00e7t\u0131\u011f\u0131nda projenin dosyalar\u0131ndan pasajlar al\u0131r ve bunlar\u0131 modelin ba\u011flam penceresi i\u00e7inde iletiye ekler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u0440\u0438\u043c\u0443\u0454 \u0444\u0440\u0430\u0433\u043c\u0435\u043d\u0442\u0438 \u0437 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0457 \u0447\u0430\u0441\u0442\u0438\u043d\u0438 \u0440\u043e\u0437\u043c\u043e\u0432\u0438, \u0430 \u0442\u0430\u043a\u043e\u0436 \u0456\u0437 \u0444\u0430\u0439\u043b\u0456\u0432 \u043f\u0440\u043e\u0454\u043a\u0442\u0443, \u044f\u043a\u0449\u043e \u043f\u0440\u043e\u0454\u043a\u0442 \u0446\u0435 \u0432\u0432\u0456\u043c\u043a\u043d\u0443\u0432, \u0456 \u0434\u043e\u0434\u0430\u0454 \u0457\u0445 \u0434\u043e \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0432 \u043c\u0435\u0436\u0430\u0445 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u0433\u043e \u0432\u0456\u043a\u043d\u0430 \u043c\u043e\u0434\u0435\u043b\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Truy xu\u1ea5t c\u00e1c \u0111o\u1ea1n t\u1eeb ph\u1ea7n tr\u01b0\u1edbc c\u1ee7a cu\u1ed9c tr\u00f2 chuy\u1ec7n, v\u00e0 t\u1eeb t\u1ec7p c\u1ee7a d\u1ef1 \u00e1n khi d\u1ef1 \u00e1n b\u1eadt t\u00ednh n\u0103ng n\u00e0y, r\u1ed3i th\u00eam ch\u00fang v\u00e0o tin nh\u1eafn trong c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh c\u1ee7a m\u00f4 h\u00ecnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ece\u5bf9\u8bdd\u7684\u8f83\u65e9\u90e8\u5206\u68c0\u7d22\u76f8\u5173\u6bb5\u843d\uff0c\u5e76\u5728\u9879\u76ee\u542f\u7528\u65f6\u4ece\u9879\u76ee\u6587\u4ef6\u4e2d\u68c0\u7d22\uff0c\u7136\u540e\u5728\u6a21\u578b\u7684\u4e0a\u4e0b\u6587\u7a97\u53e3\u8303\u56f4\u5185\u5c06\u5176\u6dfb\u52a0\u5230\u6d88\u606f\u4e2d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f9e\u5c0d\u8a71\u7684\u8f03\u65e9\u90e8\u5206\u64f7\u53d6\u76f8\u95dc\u6bb5\u843d\uff0c\u4e26\u5728\u5c08\u6848\u555f\u7528\u6642\u5f9e\u5c08\u6848\u6a94\u6848\u4e2d\u64f7\u53d6\uff0c\u7136\u5f8c\u5728\u6a21\u578b\u7684\u4e0a\u4e0b\u6587\u8996\u7a97\u7bc4\u570d\u5167\u5c07\u5176\u52a0\u5165\u8a0a\u606f\u3002"
          }
        }
      }
    },
    "Recall earlier turns of each chat": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u062f\u0639\u0627\u0621 \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0641\u064a \u0643\u0644 \u0645\u062d\u0627\u062f\u062b\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fr\u00fchere Beitr\u00e4ge jedes Chats abrufen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recall earlier turns of each chat"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recordar turnos anteriores de cada chat"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rappeler les \u00e9changes pr\u00e9c\u00e9dents de chaque discussion"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d9\u05d6\u05db\u05e8\u05d5\u05ea \u05d1\u05ea\u05d5\u05e8\u05d5\u05ea \u05e7\u05d5\u05d3\u05de\u05d9\u05dd \u05d1\u05db\u05dc \u05e6'\u05d0\u05d8"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u091a\u0948\u091f \u0915\u0947 \u092a\u093f\u091b\u0932\u0947 \u091f\u0930\u094d\u0928 \u092f\u093e\u0926 \u0930\u0916\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingat giliran sebelumnya di setiap obrolan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Richiama i turni precedenti di ogni chat"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5404\u30c1\u30e3\u30c3\u30c8\u306e\u4ee5\u524d\u306e\u30bf\u30fc\u30f3\u3092\u547c\u3073\u51fa\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac01 \ucc44\ud305\uc758 \uc774\uc804 \ud134 \ud68c\uc0c1"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerdere beurten van elke chat terughalen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywo\u0142uj wcze\u015bniejsze tury ka\u017cdego czatu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperar turnos anteriores de cada chat"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u0442\u044c \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0435 \u0440\u0435\u043f\u043b\u0438\u043a\u0438 \u043a\u0430\u0436\u0434\u043e\u0433\u043e \u0447\u0430\u0442\u0430"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5terkalla tidigare turer i varje chatt"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her sohbetin \u00f6nceki turlar\u0131n\u0131 hat\u0131rla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438\u0433\u0430\u0434\u0443\u0432\u0430\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u0440\u0435\u043f\u043b\u0456\u043a\u0438 \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0447\u0430\u0442\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u1ee3i l\u1ea1i c\u00e1c l\u01b0\u1ee3t tr\u01b0\u1edbc c\u1ee7a m\u1ed7i cu\u1ed9c tr\u00f2 chuy\u1ec7n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56de\u5fc6\u6bcf\u4e2a\u804a\u5929\u4e2d\u8f83\u65e9\u7684\u8f6e\u6b21"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u56de\u60f3\u6bcf\u500b\u804a\u5929\u4e2d\u8f03\u65e9\u7684\u8f2a\u6b21"
          }
        }
      }
    },
    "Records finished turns so older ones can come back after they leave the context window. They are stored unencrypted on this Mac, outside the encrypted profile. Ghost chats are never recorded. Turning this off deletes what was recorded.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0633\u062c\u0651\u0644 \u0627\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629 \u062d\u062a\u0649 \u064a\u0645\u0643\u0646 \u0627\u0633\u062a\u0639\u0627\u062f\u0629 \u0627\u0644\u0623\u0642\u062f\u0645 \u0645\u0646\u0647\u0627 \u0628\u0639\u062f \u062e\u0631\u0648\u062c\u0647\u0627 \u0645\u0646 \u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0633\u064a\u0627\u0642. \u062a\u064f\u062e\u0632\u064e\u0651\u0646 \u062f\u0648\u0646 \u062a\u0634\u0641\u064a\u0631 \u0639\u0644\u0649 \u062c\u0647\u0627\u0632 Mac \u0647\u0630\u0627\u060c \u062e\u0627\u0631\u062c \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0627\u0644\u0645\u0634\u0641\u0651\u0631. \u0644\u0627 \u064a\u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u0634\u0628\u062d \u0623\u0628\u062f\u064b\u0627. \u064a\u0624\u062f\u064a \u0625\u064a\u0642\u0627\u0641 \u0647\u0630\u0627 \u0627\u0644\u062e\u064a\u0627\u0631 \u0625\u0644\u0649 \u062d\u0630\u0641 \u0645\u0627 \u062a\u0645 \u062a\u0633\u062c\u064a\u0644\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Speichert abgeschlossene Beitr\u00e4ge, damit \u00e4ltere zur\u00fcckkommen k\u00f6nnen, nachdem sie das Kontextfenster verlassen haben. Sie werden unverschl\u00fcsselt auf diesem Mac gespeichert, au\u00dferhalb des verschl\u00fcsselten Profils. Ghost-Chats werden nie gespeichert. Beim Ausschalten wird das Gespeicherte gel\u00f6scht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records finished turns so older ones can come back after they leave the context window. They are stored unencrypted on this Mac, outside the encrypted profile. Ghost chats are never recorded. Turning this off deletes what was recorded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra los turnos terminados para que los m\u00e1s antiguos puedan volver despu\u00e9s de salir de la ventana de contexto. Se guardan sin cifrar en este Mac, fuera del perfil cifrado. Los chats fantasma nunca se registran. Al desactivarlo se elimina lo registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les \u00e9changes termin\u00e9s pour que les plus anciens puissent revenir une fois sortis de la fen\u00eatre de contexte. Ils sont stock\u00e9s sans chiffrement sur ce Mac, en dehors du profil chiffr\u00e9. Les discussions fant\u00f4mes ne sont jamais enregistr\u00e9es. La d\u00e9sactivation supprime ce qui a \u00e9t\u00e9 enregistr\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05ea\u05e2\u05d3 \u05ea\u05d5\u05e8\u05d5\u05ea \u05e9\u05d4\u05e1\u05ea\u05d9\u05d9\u05de\u05d5 \u05db\u05d3\u05d9 \u05e9\u05ea\u05d5\u05e8\u05d5\u05ea \u05d9\u05e9\u05e0\u05d9\u05dd \u05d9\u05d5\u05ea\u05e8 \u05d9\u05d5\u05db\u05dc\u05d5 \u05dc\u05d7\u05d6\u05d5\u05e8 \u05dc\u05d0\u05d7\u05e8 \u05e9\u05d9\u05e6\u05d0\u05d5 \u05de\u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8. \u05d4\u05dd \u05e0\u05e9\u05de\u05e8\u05d9\u05dd \u05dc\u05dc\u05d0 \u05d4\u05e6\u05e4\u05e0\u05d4 \u05d1\u05de\u05d7\u05e9\u05d1 Mac \u05d6\u05d4, \u05de\u05d7\u05d5\u05e5 \u05dc\u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d4\u05de\u05d5\u05e6\u05e4\u05df. \u05e6'\u05d0\u05d8\u05d9\u05dd \u05e9\u05dc \u05e8\u05e4\u05d0\u05d9\u05dd \u05dc\u05e2\u05d5\u05dc\u05dd \u05d0\u05d9\u05e0\u05dd \u05de\u05ea\u05d5\u05e2\u05d3\u05d9\u05dd. \u05db\u05d9\u05d1\u05d5\u05d9 \u05d4\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05de\u05d5\u05d7\u05e7 \u05d0\u05ea \u05de\u05d4 \u05e9\u05ea\u05d5\u05e2\u05d3."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0942\u0930\u0947 \u0939\u094b \u091a\u0941\u0915\u0947 \u091f\u0930\u094d\u0928 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0924\u093e \u0939\u0948 \u0924\u093e\u0915\u093f \u092a\u0941\u0930\u093e\u0928\u0947 \u091f\u0930\u094d\u0928 \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u0938\u0947 \u092c\u093e\u0939\u0930 \u091c\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0940 \u0935\u093e\u092a\u0938 \u0906 \u0938\u0915\u0947\u0902\u0964 \u0935\u0947 \u0907\u0938 Mac \u092a\u0930, \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u0940 \u0917\u0908 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u092c\u093e\u0939\u0930, \u092c\u093f\u0928\u093e \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u0936\u0928 \u0915\u0947 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964 \u0918\u094b\u0938\u094d\u091f \u091a\u0948\u091f \u0915\u092d\u0940 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0928\u0939\u0940\u0902 \u0915\u0940 \u091c\u093e\u0924\u0940\u0902\u0964 \u0907\u0938\u0947 \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u092a\u0930 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0940 \u0917\u0908 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0939\u091f \u091c\u093e\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekam giliran yang selesai agar giliran lama dapat kembali setelah keluar dari jendela konteks. Data disimpan tanpa enkripsi di Mac ini, di luar profil terenkripsi. Obrolan hantu tidak pernah direkam. Menonaktifkan opsi ini menghapus apa yang telah direkam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra i turni completati in modo che quelli pi\u00f9 vecchi possano tornare dopo essere usciti dalla finestra di contesto. Vengono archiviati senza crittografia su questo Mac, fuori dal profilo crittografato. Le chat fantasma non vengono mai registrate. Disattivando l'opzione si elimina ci\u00f2 che \u00e8 stato registrato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b8c\u4e86\u3057\u305f\u30bf\u30fc\u30f3\u3092\u8a18\u9332\u3057\u3001\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u304b\u3089\u5916\u308c\u305f\u53e4\u3044\u30bf\u30fc\u30f3\u3082\u547c\u3073\u623b\u305b\u308b\u3088\u3046\u306b\u3057\u307e\u3059\u3002\u8a18\u9332\u306f\u6697\u53f7\u5316\u3055\u308c\u305f\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306e\u5916\u306b\u3001\u6697\u53f7\u5316\u3055\u308c\u305a\u306b\u3053\u306e Mac \u306b\u4fdd\u5b58\u3055\u308c\u307e\u3059\u3002\u30b4\u30fc\u30b9\u30c8\u30c1\u30e3\u30c3\u30c8\u306f\u8a18\u9332\u3055\u308c\u307e\u305b\u3093\u3002\u30aa\u30d5\u306b\u3059\u308b\u3068\u8a18\u9332\u3055\u308c\u305f\u5185\u5bb9\u306f\u524a\u9664\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc644\ub8cc\ub41c \ud134\uc744 \uae30\ub85d\ud558\uc5ec \ucee8\ud14d\uc2a4\ud2b8 \ucc3d\uc744 \ubc97\uc5b4\ub09c \uc774\uc804 \ud134\ub3c4 \ub2e4\uc2dc \ubd88\ub7ec\uc62c \uc218 \uc788\uac8c \ud569\ub2c8\ub2e4. \uae30\ub85d\uc740 \uc554\ud638\ud654\ub41c \ud504\ub85c\ud544 \ubc16, \uc774 Mac\uc5d0 \uc554\ud638\ud654\ub418\uc9c0 \uc54a\uc740 \uc0c1\ud0dc\ub85c \uc800\uc7a5\ub429\ub2c8\ub2e4. \uace0\uc2a4\ud2b8 \ucc44\ud305\uc740 \uae30\ub85d\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc774 \uc635\uc158\uc744 \ub044\uba74 \uae30\ub85d\ub41c \ub0b4\uc6a9\uc774 \uc0ad\uc81c\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt afgeronde beurten vast zodat oudere beurten terug kunnen komen nadat ze het contextvenster hebben verlaten. Ze worden onversleuteld op deze Mac bewaard, buiten het versleutelde profiel. Ghost-chats worden nooit vastgelegd. Uitschakelen verwijdert wat is vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuje zako\u0144czone tury, aby starsze mog\u0142y wr\u00f3ci\u0107 po opuszczeniu okna kontekstu. S\u0105 przechowywane bez szyfrowania na tym Macu, poza zaszyfrowanym profilem. Czaty widmo nigdy nie s\u0105 zapisywane. Wy\u0142\u0105czenie tej opcji usuwa to, co zosta\u0142o zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra os turnos conclu\u00eddos para que os mais antigos possam voltar depois de sair da janela de contexto. Eles ficam armazenados sem criptografia neste Mac, fora do perfil criptografado. Chats fantasmas nunca s\u00e3o registrados. Desativar esta op\u00e7\u00e3o apaga o que foi registrado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u0445\u0440\u0430\u043d\u044f\u0435\u0442 \u0437\u0430\u0432\u0435\u0440\u0448\u0451\u043d\u043d\u044b\u0435 \u0440\u0435\u043f\u043b\u0438\u043a\u0438, \u0447\u0442\u043e\u0431\u044b \u0431\u043e\u043b\u0435\u0435 \u0441\u0442\u0430\u0440\u044b\u0435 \u043c\u043e\u0433\u043b\u0438 \u0432\u0435\u0440\u043d\u0443\u0442\u044c\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u0432\u044b\u0439\u0434\u0443\u0442 \u0437\u0430 \u043f\u0440\u0435\u0434\u0435\u043b\u044b \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u0433\u043e \u043e\u043a\u043d\u0430. \u041e\u043d\u0438 \u0445\u0440\u0430\u043d\u044f\u0442\u0441\u044f \u043d\u0430 \u044d\u0442\u043e\u043c Mac \u0431\u0435\u0437 \u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u0432\u043d\u0435 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0438\u043b\u044f. \u041f\u0440\u0438\u0437\u0440\u0430\u0447\u043d\u044b\u0435 \u0447\u0430\u0442\u044b \u043d\u0438\u043a\u043e\u0433\u0434\u0430 \u043d\u0435 \u0441\u043e\u0445\u0440\u0430\u043d\u044f\u044e\u0442\u0441\u044f. \u041f\u0440\u0438 \u043e\u0442\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u043e\u0435 \u0443\u0434\u0430\u043b\u044f\u0435\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparar avslutade turer s\u00e5 att \u00e4ldre turer kan komma tillbaka efter att de l\u00e4mnat kontextf\u00f6nstret. De lagras okrypterade p\u00e5 den h\u00e4r Macen, utanf\u00f6r den krypterade profilen. Sp\u00f6kchattar sparas aldrig. Om du st\u00e4nger av det raderas det som sparats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlanan turlar\u0131 kaydeder; b\u00f6ylece eski turlar ba\u011flam penceresinden \u00e7\u0131kt\u0131ktan sonra geri gelebilir. Bu kay\u0131tlar bu Mac'te, \u015fifreli profilin d\u0131\u015f\u0131nda \u015fifrelenmeden saklan\u0131r. Hayalet sohbetler hi\u00e7bir zaman kaydedilmez. Bunu kapatmak kaydedilenleri siler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0454 \u0437\u0430\u0432\u0435\u0440\u0448\u0435\u043d\u0456 \u0440\u0435\u043f\u043b\u0456\u043a\u0438, \u0449\u043e\u0431 \u0441\u0442\u0430\u0440\u0456\u0448\u0456 \u043c\u043e\u0433\u043b\u0438 \u043f\u043e\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u0442\u043e\u0433\u043e, \u044f\u043a \u0432\u0438\u0439\u0434\u0443\u0442\u044c \u0437\u0430 \u043c\u0435\u0436\u0456 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u0433\u043e \u0432\u0456\u043a\u043d\u0430. \u0412\u043e\u043d\u0438 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 Mac \u0431\u0435\u0437 \u0448\u0438\u0444\u0440\u0443\u0432\u0430\u043d\u043d\u044f, \u043f\u043e\u0437\u0430 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u043c \u043f\u0440\u043e\u0444\u0456\u043b\u0435\u043c. \u0427\u0430\u0442\u0438-\u043f\u0440\u0438\u0432\u0438\u0434\u0438 \u043d\u0456\u043a\u043e\u043b\u0438 \u043d\u0435 \u0437\u0431\u0435\u0440\u0456\u0433\u0430\u044e\u0442\u044c\u0441\u044f. \u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043d\u044f \u0432\u0438\u0434\u0430\u043b\u044f\u0454 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0435."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi l\u1ea1i c\u00e1c l\u01b0\u1ee3t \u0111\u00e3 ho\u00e0n t\u1ea5t \u0111\u1ec3 c\u00e1c l\u01b0\u1ee3t c\u0169 h\u01a1n c\u00f3 th\u1ec3 quay l\u1ea1i sau khi r\u1eddi kh\u1ecfi c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh. Ch\u00fang \u0111\u01b0\u1ee3c l\u01b0u kh\u00f4ng m\u00e3 h\u00f3a tr\u00ean m\u00e1y Mac n\u00e0y, b\u00ean ngo\u00e0i h\u1ed3 s\u01a1 \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a. Cu\u1ed9c tr\u00f2 chuy\u1ec7n ma kh\u00f4ng bao gi\u1edd \u0111\u01b0\u1ee3c ghi l\u1ea1i. T\u1eaft t\u00f9y ch\u1ecdn n\u00e0y s\u1ebd x\u00f3a nh\u1eefng g\u00ec \u0111\u00e3 ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bb0\u5f55\u5df2\u5b8c\u6210\u7684\u8f6e\u6b21\uff0c\u4ee5\u4fbf\u8f83\u65e9\u7684\u8f6e\u6b21\u5728\u79bb\u5f00\u4e0a\u4e0b\u6587\u7a97\u53e3\u540e\u4ecd\u80fd\u88ab\u53ec\u56de\u3002\u8fd9\u4e9b\u8bb0\u5f55\u4ee5\u672a\u52a0\u5bc6\u5f62\u5f0f\u5b58\u50a8\u5728\u8fd9\u53f0 Mac \u4e0a\uff0c\u4f4d\u4e8e\u52a0\u5bc6\u914d\u7f6e\u6587\u4ef6\u4e4b\u5916\u3002\u5e7d\u7075\u804a\u5929\u6c38\u8fdc\u4e0d\u4f1a\u88ab\u8bb0\u5f55\u3002\u5173\u95ed\u6b64\u9009\u9879\u4f1a\u5220\u9664\u5df2\u8bb0\u5f55\u7684\u5185\u5bb9\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a18\u9304\u5df2\u5b8c\u6210\u7684\u8f2a\u6b21\uff0c\u8b93\u8f03\u65e9\u7684\u8f2a\u6b21\u5728\u96e2\u958b\u4e0a\u4e0b\u6587\u8996\u7a97\u5f8c\u4ecd\u80fd\u88ab\u53ec\u56de\u3002\u9019\u4e9b\u8a18\u9304\u4ee5\u672a\u52a0\u5bc6\u5f62\u5f0f\u5132\u5b58\u5728\u9019\u53f0 Mac \u4e0a\uff0c\u4f4d\u65bc\u52a0\u5bc6\u8a2d\u5b9a\u6a94\u4e4b\u5916\u3002\u5e7d\u9748\u804a\u5929\u6c38\u9060\u4e0d\u6703\u88ab\u8a18\u9304\u3002\u95dc\u9589\u6b64\u9078\u9805\u6703\u522a\u9664\u5df2\u8a18\u9304\u7684\u5167\u5bb9\u3002"
          }
        }
      }
    },
