    "Stop the server to edit. Leave the port blank for automatic assignment.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف الخادم للتحرير. اترك المنفذ فارغًا للتعيين التلقائي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Bearbeiten den Server stoppen. Für automatische Zuweisung den Port leer lassen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop the server to edit. Leave the port blank for automatic assignment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detén el servidor para editar. Deja el puerto vacío para asignarlo automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêtez le serveur pour modifier. Laissez le port vide pour une attribution automatique."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לעצור את השרת לעריכה. יש להשאיר את היציאה ריקה להקצאה אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संपादन के लिए सर्वर रोकें। स्वचालित आवंटन के लिए पोर्ट खाली छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan server untuk mengedit. Kosongkan port untuk penetapan otomatis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Arresta il server per modificare. Lascia vuota la porta per assegnarla automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "編集するにはサーバーを停止してください。自動割り当てにはポートを空欄にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "편집하려면 서버를 중지하세요. 자동 할당은 포트를 비워 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop de server om te bewerken. Laat de poort leeg voor automatische toewijzing."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymaj serwer, aby edytować. Pozostaw port pusty, aby przypisać go automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare o servidor para editar. Deixe a porta vazia para atribuição automática."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановите сервер для редактирования. Оставьте порт пустым для автоматического назначения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppa servern för att redigera. Lämna porten tom för automatisk tilldelning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düzenlemek için sunucuyu durdurun. Otomatik atama için portu boş bırakın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупиніть сервер для редагування. Залиште порт порожнім для автоматичного призначення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng máy chủ để chỉnh sửa. Để trống cổng để tự động gán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止服务器后编辑。端口留空可自动分配。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止伺服器後編輯。連接埠留空可自動分配。"
          }
        }
      }
    },
