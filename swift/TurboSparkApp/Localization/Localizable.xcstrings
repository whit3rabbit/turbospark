        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0433\u0435\u043d\u0435\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0445\u0432\u043e\u0441\u0442 \u043e\u0442\u0431\u0440\u043e\u0448\u0435\u043d \u043f\u043e \u043d\u0435\u0443\u043a\u0430\u0437\u0430\u043d\u043d\u043e\u0439 \u043f\u0440\u0438\u0447\u0438\u043d\u0435."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u3055\u308c\u305f\u672b\u5c3e\u306f\u3001\u7406\u7531\u304c\u6307\u5b9a\u3055\u308c\u3066\u3044\u306a\u3044\u305f\u3081\u7834\u68c4\u3055\u308c\u307e\u3057\u305f\u3002"
