            "value": "L\u01b0\u1ee3c \u0111\u1ed3 \u0111\u1ed1i s\u1ed1 c\u1ee7a c\u00f4ng c\u1ee5 `%@` c\u00f3 m\u1ee5c kh\u00f4ng \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 t\u1ea1i %@."
          }
