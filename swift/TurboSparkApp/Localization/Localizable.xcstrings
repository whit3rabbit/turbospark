    "Waiting for the runner. One turn at a time per model.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u0627\u0646\u062a\u0638\u0627\u0631 \u0627\u0644\u0645\u0634\u063a\u0651\u0644. \u062f\u0648\u0631\u0629 \u0648\u0627\u062d\u062f\u0629 \u0641\u064a \u0643\u0644 \u0645\u0631\u0629 \u0644\u0643\u0644 \u0646\u0645\u0648\u0630\u062c."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartet auf den Runner. Pro Modell jeweils ein Durchlauf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for the runner. One turn at a time per model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando al ejecutor. Un turno a la vez por modelo."
