            "value": "T\u1ea3i m\u00f4 h\u00ecnh v\u00e0 b\u1eaft \u0111\u1ea7u cu\u1ed9c tr\u00f2 chuy\u1ec7n m\u1edbi v\u1edbi n\u00f3"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f7d\u6a21\u578b\u5e76\u7528\u5b83\u5f00\u59cb\u65b0\u5bf9\u8bdd"
          }
        },
        "zh-Hant": {
          "stringUnit": {
