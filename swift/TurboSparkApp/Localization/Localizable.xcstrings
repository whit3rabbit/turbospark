        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e9rifi\u00e9 : ce portage a ex\u00e9cut\u00e9 ce mod\u00e8le de bout en bout"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d0\u05d5\u05de\u05ea: \u05d4\u05e4\u05d5\u05e8\u05d8 \u05d4\u05d6\u05d4 \u05d4\u05e8\u05d9\u05e5 \u05d0\u05ea \u05d4\u05e9\u05d5\u05e8\u05d4 \u05d4\u05d6\u05d5 \u05de\u05e7\u05e6\u05d4 \u05dc\u05e7\u05e6\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924: \u0907\u0938 \u092a\u094b\u0930\u094d\u091f \u0928\u0947 \u0907\u0938\u0947 \u0936\u0941\u0930\u0942 \u0938\u0947 \u0905\u0902\u0924 \u0924\u0915 \u091a\u0932\u093e\u092f\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terverifikasi: port ini telah menjalankan entri ini dari awal hingga akhir"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificato: questo port ha eseguito questa voce dall\u2019inizio alla fine"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u691c\u8a3c\u6e08\u307f: \u3053\u306e\u79fb\u690d\u7248\u3067\u30a8\u30f3\u30c9\u30c4\u30fc\u30a8\u30f3\u30c9\u306e\u5b9f\u884c\u3092\u78ba\u8a8d\u6e08\u307f"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac80\uc99d\ub428: \uc774 \ud3ec\ud2b8\uc5d0\uc11c \ucc98\uc74c\ubd80\ud130 \ub05d\uae4c\uc9c0 \uc2e4\ud589\ub428"
