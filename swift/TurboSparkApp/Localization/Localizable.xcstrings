        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u094d\u092f\u0942\u0928\u0924\u092e RAM \u0909\u092a\u092f\u094b\u0917 \u0915\u0947 \u0938\u093e\u0925 \u0935\u0947\u091f \u0915\u094b \u0921\u093e\u092f\u0928\u093e\u092e\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u091f\u094d\u0930\u0940\u092e \u0915\u0930\u0924\u093e \u0939\u0948"
