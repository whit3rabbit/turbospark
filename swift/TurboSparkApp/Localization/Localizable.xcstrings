        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompi il turno corrente prima di cancellare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30af\u30ea\u30a2\u3059\u308b\u524d\u306b\u73fe\u5728\u306e\u30bf\u30fc\u30f3\u3092\u505c\u6b62\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
