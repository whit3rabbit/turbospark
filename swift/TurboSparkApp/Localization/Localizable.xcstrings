        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u30d5\u30a1\u30a4\u30eb\u3092\u8aad\u307f\u8fbc\u307f\u4e2d: %lld / %lld"
