        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f1a\u8a71\u3092\u59cb\u3081\u308b\u3068\u3001\u3053\u3053\u3067\u691c\u7d22\u3067\u304d\u307e\u3059"
