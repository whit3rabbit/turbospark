    "Add a tag or a layout to the end of your lyrics.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a tag or a layout to the end of your lyrics."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0636\u0641 \u0648\u0633\u0645\u064b\u0627 \u0623\u0648 \u0647\u064a\u0643\u0644\u064b\u0627 \u0641\u064a \u0646\u0647\u0627\u064a\u0629 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0623\u063a\u0646\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcge am Ende deines Liedtexts ein Tag oder eine Vorlage hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00f1ade una etiqueta o una estructura al final de tu letra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une balise ou une structure \u00e0 la fin de vos paroles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05e1\u05e3 \u05ea\u05d2\u05d9\u05ea \u05d0\u05d5 \u05de\u05d1\u05e0\u05d4 \u05d1\u05e1\u05d5\u05e3 \u05de\u05d9\u05dc\u05d5\u05ea \u05d4\u05e9\u05d9\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092a\u0928\u0947 \u0917\u0940\u0924 \u0915\u0947 \u092c\u094b\u0932 \u0915\u0947 \u0905\u0902\u0924 \u092e\u0947\u0902 \u090f\u0915 \u091f\u0948\u0917 \u092f\u093e \u0932\u0947\u0906\u0909\u091f \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan tag atau tata letak di akhir lirik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un tag o una struttura alla fine del testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b4c\u8a5e\u306e\u672b\u5c3e\u306b\u30bf\u30b0\u307e\u305f\u306f\u30ec\u30a4\u30a2\u30a6\u30c8\u3092\u8ffd\u52a0\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac00\uc0ac \ub05d\uc5d0 \ud0dc\uadf8\ub098 \ub808\uc774\uc544\uc6c3\uc744 \ucd94\uac00\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg een tag of een indeling toe aan het einde van je songtekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj znacznik lub uk\u0142ad na ko\u0144cu tekstu piosenki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma tag ou uma estrutura ao final da letra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u0442\u0435\u0433 \u0438\u043b\u0438 \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0432 \u043a\u043e\u043d\u0435\u0446 \u0442\u0435\u043a\u0441\u0442\u0430 \u043f\u0435\u0441\u043d\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4gg till en tagg eller ett uppl\u00e4gg i slutet av l\u00e5ttexten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eark\u0131 s\u00f6zlerinizin sonuna bir etiket veya d\u00fczen ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0434\u0430\u0439\u0442\u0435 \u0442\u0435\u0433 \u0430\u0431\u043e \u0441\u0442\u0440\u0443\u043a\u0442\u0443\u0440\u0443 \u0432 \u043a\u0456\u043d\u0435\u0446\u044c \u0442\u0435\u043a\u0441\u0442\u0443 \u043f\u0456\u0441\u043d\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Th\u00eam m\u1ed9t th\u1ebb ho\u1eb7c m\u1ed9t b\u1ed1 c\u1ee5c v\u00e0o cu\u1ed1i l\u1eddi b\u00e0i h\u00e1t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b4c\u8bcd\u672b\u5c3e\u6dfb\u52a0\u6807\u7b7e\u6216\u6a21\u677f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b4c\u8a5e\u7d50\u5c3e\u52a0\u5165\u6a19\u7c64\u6216\u7bc4\u672c\u3002"
          }
        }
      }
    },
    "Put each section tag on its own line. Words on the same line as a tag are dropped.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Put each section tag on its own line. Words on the same line as a tag are dropped."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0636\u0639 \u0643\u0644 \u0648\u0633\u0645 \u0642\u0633\u0645 \u0641\u064a \u0633\u0637\u0631 \u0645\u0633\u062a\u0642\u0644. \u062a\u064f\u0647\u0645\u0644 \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0645\u0648\u062c\u0648\u062f\u0629 \u0641\u064a \u0627\u0644\u0633\u0637\u0631 \u0646\u0641\u0633\u0647 \u0645\u0639 \u0627\u0644\u0648\u0633\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setze jedes Abschnitts-Tag in eine eigene Zeile. W\u00f6rter in derselben Zeile wie ein Tag werden verworfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pon cada etiqueta de secci\u00f3n en su propia l\u00ednea. Las palabras en la misma l\u00ednea que una etiqueta se descartan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez chaque balise de section sur sa propre ligne. Les mots situ\u00e9s sur la m\u00eame ligne qu'une balise sont ignor\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e6\u05d1 \u05db\u05dc \u05ea\u05d2\u05d9\u05ea \u05de\u05e7\u05d8\u05e2 \u05d1\u05e9\u05d5\u05e8\u05d4 \u05de\u05e9\u05dc\u05d4. \u05de\u05d9\u05dc\u05d9\u05dd \u05d1\u05d0\u05d5\u05ea\u05d4 \u05e9\u05d5\u05e8\u05d4 \u05e2\u05dd \u05ea\u05d2\u05d9\u05ea \u05de\u05d5\u05e9\u05de\u05d8\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0939\u0930 \u0938\u0947\u0915\u094d\u0936\u0928 \u091f\u0948\u0917 \u0915\u094b \u0905\u0932\u0917 \u092a\u0902\u0915\u094d\u0924\u093f \u092e\u0947\u0902 \u0930\u0916\u0947\u0902\u0964 \u091f\u0948\u0917 \u0935\u093e\u0932\u0940 \u092a\u0902\u0915\u094d\u0924\u093f \u092e\u0947\u0902 \u0932\u093f\u0916\u0947 \u0936\u092c\u094d\u0926 \u091b\u094b\u0921\u093c \u0926\u093f\u090f \u091c\u093e\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Letakkan setiap tag bagian di barisnya sendiri. Kata di baris yang sama dengan tag akan dibuang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Metti ogni tag di sezione su una riga a s\u00e9. Le parole sulla stessa riga di un tag vengono scartate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bb\u30af\u30b7\u30e7\u30f3\u30bf\u30b0\u306f\u305d\u308c\u305e\u308c\u5225\u306e\u884c\u306b\u7f6e\u3044\u3066\u304f\u3060\u3055\u3044\u3002\u30bf\u30b0\u3068\u540c\u3058\u884c\u306b\u3042\u308b\u8a00\u8449\u306f\u7121\u8996\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc139\uc158 \ud0dc\uadf8\ub294 \uac01\uac01 \ubcc4\ub3c4\uc758 \uc904\uc5d0 \ub123\uc73c\uc138\uc694. \ud0dc\uadf8\uc640 \uac19\uc740 \uc904\uc5d0 \uc788\ub294 \ub2e8\uc5b4\ub294 \ubb34\uc2dc\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet elke sectietag op een eigen regel. Woorden op dezelfde regel als een tag worden genegeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Umie\u015b\u0107 ka\u017cdy znacznik sekcji w osobnej linii. S\u0142owa w tej samej linii co znacznik s\u0105 pomijane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Coloque cada tag de se\u00e7\u00e3o em sua pr\u00f3pria linha. Palavras na mesma linha de uma tag s\u00e3o descartadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u0432\u044c\u0442\u0435 \u043a\u0430\u0436\u0434\u044b\u0439 \u0442\u0435\u0433 \u0440\u0430\u0437\u0434\u0435\u043b\u0430 \u043d\u0430 \u043e\u0442\u0434\u0435\u043b\u044c\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u0435. \u0421\u043b\u043e\u0432\u0430 \u0432 \u043e\u0434\u043d\u043e\u0439 \u0441\u0442\u0440\u043e\u043a\u0435 \u0441 \u0442\u0435\u0433\u043e\u043c \u043e\u0442\u0431\u0440\u0430\u0441\u044b\u0432\u0430\u044e\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Placera varje sektionstagg p\u00e5 en egen rad. Ord p\u00e5 samma rad som en tagg tas bort."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her b\u00f6l\u00fcm etiketini kendi sat\u0131r\u0131na koyun. Etiketle ayn\u0131 sat\u0131rdaki s\u00f6zc\u00fckler yok say\u0131l\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u0432\u0442\u0435 \u043a\u043e\u0436\u0435\u043d \u0442\u0435\u0433 \u0440\u043e\u0437\u0434\u0456\u043b\u0443 \u0432 \u043e\u043a\u0440\u0435\u043c\u043e\u043c\u0443 \u0440\u044f\u0434\u043a\u0443. \u0421\u043b\u043e\u0432\u0430 \u0432 \u0442\u043e\u043c\u0443 \u0436 \u0440\u044f\u0434\u043a\u0443, \u0449\u043e \u0439 \u0442\u0435\u0433, \u0432\u0456\u0434\u043a\u0438\u0434\u0430\u044e\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eb7t m\u1ed7i th\u1ebb ph\u1ea7n tr\u00ean m\u1ed9t d\u00f2ng ri\u00eang. Ch\u1eef c\u00f9ng d\u00f2ng v\u1edbi th\u1ebb s\u1ebd b\u1ecb b\u1ecf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u4e2a\u6bb5\u843d\u6807\u7b7e\u5355\u72ec\u5360\u4e00\u884c\u3002\u4e0e\u6807\u7b7e\u5728\u540c\u4e00\u884c\u7684\u6587\u5b57\u4f1a\u88ab\u5ffd\u7565\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6bcf\u500b\u6bb5\u843d\u6a19\u7c64\u55ae\u7368\u4e00\u884c\u3002\u8207\u6a19\u7c64\u5728\u540c\u4e00\u884c\u7684\u6587\u5b57\u6703\u88ab\u5ffd\u7565\u3002"
          }
        }
      }
    },
    "Write for singing: short lines of similar length, in simple words.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write for singing: short lines of similar length, in simple words."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0643\u062a\u0628 \u0644\u0644\u063a\u0646\u0627\u0621: \u0623\u0633\u0637\u0631 \u0642\u0635\u064a\u0631\u0629 \u0645\u062a\u0642\u0627\u0631\u0628\u0629 \u0627\u0644\u0637\u0648\u0644 \u0628\u0643\u0644\u0645\u0627\u062a \u0628\u0633\u064a\u0637\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe zum Singen: kurze Zeilen \u00e4hnlicher L\u00e4nge in einfachen W\u00f6rtern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe para cantar: l\u00edneas cortas de longitud similar, con palabras sencillas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9crivez pour \u00eatre chant\u00e9 : des lignes courtes de longueur similaire, avec des mots simples."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05ea\u05d5\u05d1 \u05dc\u05e9\u05d9\u05e8\u05d4: \u05e9\u05d5\u05e8\u05d5\u05ea \u05e7\u05e6\u05e8\u05d5\u05ea \u05d1\u05d0\u05d5\u05e8\u05da \u05d3\u05d5\u05de\u05d4, \u05d1\u05de\u05d9\u05dc\u05d9\u05dd \u05e4\u05e9\u05d5\u05d8\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0932\u093f\u0916\u0947\u0902: \u0938\u092e\u093e\u0928 \u0932\u0902\u092c\u093e\u0908 \u0915\u0940 \u091b\u094b\u091f\u0940 \u092a\u0902\u0915\u094d\u0924\u093f\u092f\u093e\u0901, \u0938\u0930\u0932 \u0936\u092c\u094d\u0926\u094b\u0902 \u092e\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menulislah untuk dinyanyikan: baris pendek dengan panjang serupa, dengan kata-kata sederhana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi per cantare: righe brevi di lunghezza simile, con parole semplici."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b4c\u3046\u3053\u3068\u3092\u610f\u8b58\u3057\u3066\u66f8\u304d\u307e\u3057\u3087\u3046\u3002\u9577\u3055\u306e\u8fd1\u3044\u77ed\u3044\u884c\u3068\u3001\u3084\u3055\u3057\u3044\u8a00\u8449\u3092\u4f7f\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub178\ub798\ud558\uae30 \uc88b\uac8c \uc4f0\uc138\uc694. \uae38\uc774\uac00 \ube44\uc2b7\ud55c \uc9e7\uc740 \uc904\uacfc \uc26c\uc6b4 \ub2e8\uc5b4\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf om te zingen: korte regels van gelijke lengte, in eenvoudige woorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pisz z my\u015bl\u0105 o \u015bpiewaniu: kr\u00f3tkie wersy podobnej d\u0142ugo\u015bci, prostymi s\u0142owami."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva para cantar: linhas curtas de tamanho parecido, com palavras simples."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0438\u0448\u0438\u0442\u0435 \u0434\u043b\u044f \u043f\u0435\u043d\u0438\u044f: \u043a\u043e\u0440\u043e\u0442\u043a\u0438\u0435 \u0441\u0442\u0440\u043e\u043a\u0438 \u043f\u0440\u0438\u043c\u0435\u0440\u043d\u043e \u043e\u0434\u043d\u043e\u0439 \u0434\u043b\u0438\u043d\u044b, \u043f\u0440\u043e\u0441\u0442\u044b\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv f\u00f6r s\u00e5ng: korta rader av liknande l\u00e4ngd, med enkla ord."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00f6ylemek i\u00e7in yaz\u0131n: benzer uzunlukta k\u0131sa dizeler, basit s\u00f6zc\u00fcklerle."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0438\u0448\u0456\u0442\u044c \u0434\u043b\u044f \u0441\u043f\u0456\u0432\u0443: \u043a\u043e\u0440\u043e\u0442\u043a\u0456 \u0440\u044f\u0434\u043a\u0438 \u043f\u043e\u0434\u0456\u0431\u043d\u043e\u0457 \u0434\u043e\u0432\u0436\u0438\u043d\u0438, \u043f\u0440\u043e\u0441\u0442\u0438\u043c\u0438 \u0441\u043b\u043e\u0432\u0430\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi\u1ebft \u0111\u1ec3 h\u00e1t: c\u00e1c d\u00f2ng ng\u1eafn c\u00f3 \u0111\u1ed9 d\u00e0i g\u1ea7n nhau, d\u00f9ng t\u1eeb \u0111\u01a1n gi\u1ea3n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u6f14\u5531\u800c\u5199\uff1a\u4f7f\u7528\u957f\u5ea6\u76f8\u8fd1\u7684\u77ed\u53e5\u548c\u7b80\u5355\u7684\u8bcd\u8bed\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u6f14\u5531\u800c\u5beb\uff1a\u4f7f\u7528\u9577\u5ea6\u76f8\u8fd1\u7684\u77ed\u53e5\u548c\u7c21\u55ae\u7684\u8a5e\u8a9e\u3002"
          }
        }
      }
    },
    "Spell abbreviations and unusual names the way they should sound.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Spell abbreviations and unusual names the way they should sound."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0643\u062a\u0628 \u0627\u0644\u0627\u062e\u062a\u0635\u0627\u0631\u0627\u062a \u0648\u0627\u0644\u0623\u0633\u0645\u0627\u0621 \u063a\u064a\u0631 \u0627\u0644\u0645\u0623\u0644\u0648\u0641\u0629 \u0643\u0645\u0627 \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u062a\u064f\u0646\u0637\u0642."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreibe Abk\u00fcrzungen und ungew\u00f6hnliche Namen so, wie sie klingen sollen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe las abreviaturas y los nombres poco comunes tal como deben sonar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c9crivez les abr\u00e9viations et les noms inhabituels comme ils doivent sonner."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05ea\u05d5\u05d1 \u05e8\u05d0\u05e9\u05d9 \u05ea\u05d9\u05d1\u05d5\u05ea \u05d5\u05e9\u05de\u05d5\u05ea \u05d9\u05d5\u05e6\u05d0\u05d9 \u05d3\u05d5\u05e4\u05df \u05db\u05e4\u05d9 \u05e9\u05d4\u05dd \u05d0\u05de\u05d5\u05e8\u05d9\u05dd \u05dc\u05d4\u05d9\u05e9\u05de\u05e2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0930\u0942\u092a\u094b\u0902 \u0914\u0930 \u0905\u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0928\u093e\u092e\u094b\u0902 \u0915\u094b \u0935\u0948\u0938\u0947 \u0939\u0940 \u0932\u093f\u0916\u0947\u0902 \u091c\u0948\u0938\u0947 \u0935\u0947 \u092c\u094b\u0932\u0947 \u091c\u093e\u0928\u0947 \u091a\u093e\u0939\u093f\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Eja singkatan dan nama yang tidak biasa sesuai cara pengucapannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi le abbreviazioni e i nomi insoliti come devono suonare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7565\u8a9e\u3084\u73cd\u3057\u3044\u540d\u524d\u306f\u3001\u767a\u97f3\u3057\u3066\u307b\u3057\u3044\u901a\u308a\u306b\u8868\u8a18\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc57d\uc5b4\uc640 \ud2b9\uc774\ud55c \uc774\ub984\uc740 \uc18c\ub9ac \ub098\uc57c \ud558\ub294 \ub300\ub85c \ud45c\uae30\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf afkortingen en ongewone namen zoals ze moeten klinken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisuj skr\u00f3ty i nietypowe nazwy tak, jak maj\u0105 brzmie\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escreva siglas e nomes incomuns do jeito que devem soar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0439\u0442\u0435 \u0430\u0431\u0431\u0440\u0435\u0432\u0438\u0430\u0442\u0443\u0440\u044b \u0438 \u043d\u0435\u043e\u0431\u044b\u0447\u043d\u044b\u0435 \u0438\u043c\u0435\u043d\u0430 \u0442\u0430\u043a, \u043a\u0430\u043a \u043e\u043d\u0438 \u0434\u043e\u043b\u0436\u043d\u044b \u0437\u0432\u0443\u0447\u0430\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stava f\u00f6rkortningar och ovanliga namn s\u00e5 som de ska l\u00e5ta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u0131saltmalar\u0131 ve al\u0131\u015f\u0131lmad\u0131k adlar\u0131 nas\u0131l duyulmalar\u0131 gerekiyorsa \u00f6yle yaz\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u0443\u0439\u0442\u0435 \u0430\u0431\u0440\u0435\u0432\u0456\u0430\u0442\u0443\u0440\u0438 \u0442\u0430 \u043d\u0435\u0437\u0432\u0438\u0447\u043d\u0456 \u0456\u043c\u0435\u043d\u0430 \u0442\u0430\u043a, \u044f\u043a \u0432\u043e\u043d\u0438 \u043c\u0430\u044e\u0442\u044c \u0437\u0432\u0443\u0447\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi\u1ebft c\u00e1c t\u1eeb vi\u1ebft t\u1eaft v\u00e0 t\u00ean l\u1ea1 \u0111\u00fang nh\u01b0 c\u00e1ch ch\u00fang c\u1ea7n \u0111\u01b0\u1ee3c ph\u00e1t \u00e2m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f29\u5199\u548c\u4e0d\u5e38\u89c1\u7684\u540d\u5b57\u8bf7\u6309\u53d1\u97f3\u5199\u51fa\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7e2e\u5beb\u548c\u4e0d\u5e38\u898b\u7684\u540d\u5b57\u8acb\u4f9d\u767c\u97f3\u5beb\u51fa\u3002"
          }
        }
      }
    },
    "Lyrics set the song length. Short lyrics make a short song, and the duration is only an upper bound.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lyrics set the song length. Short lyrics make a short song, and the duration is only an upper bound."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0623\u063a\u0646\u064a\u0629 \u062a\u062d\u062f\u062f \u0637\u0648\u0644 \u0627\u0644\u0623\u063a\u0646\u064a\u0629. \u0627\u0644\u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0642\u0635\u064a\u0631\u0629 \u062a\u0639\u0637\u064a \u0623\u063a\u0646\u064a\u0629 \u0642\u0635\u064a\u0631\u0629\u060c \u0648\u0627\u0644\u0645\u062f\u0629 \u0645\u062c\u0631\u062f \u062d\u062f \u0623\u0639\u0644\u0649."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Liedtext bestimmt die Songl\u00e4nge. Ein kurzer Liedtext ergibt einen kurzen Song, und die Dauer ist nur eine Obergrenze."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La letra determina la duraci\u00f3n de la canci\u00f3n. Una letra corta da una canci\u00f3n corta, y la duraci\u00f3n es solo un l\u00edmite superior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paroles d\u00e9terminent la dur\u00e9e du morceau. Des paroles courtes donnent un morceau court, et la dur\u00e9e n'est qu'une limite sup\u00e9rieure."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d9\u05dc\u05d5\u05ea \u05d4\u05e9\u05d9\u05e8 \u05e7\u05d5\u05d1\u05e2\u05d5\u05ea \u05d0\u05ea \u05d0\u05d5\u05e8\u05da \u05d4\u05e9\u05d9\u05e8. \u05de\u05d9\u05dc\u05d9\u05dd \u05e7\u05e6\u05e8\u05d5\u05ea \u05d9\u05d5\u05e6\u05e8\u05d5\u05ea \u05e9\u05d9\u05e8 \u05e7\u05e6\u05e8, \u05d5\u05d4\u05de\u05e9\u05da \u05d4\u05d5\u05d0 \u05e8\u05e7 \u05d2\u05d1\u05d5\u05dc \u05e2\u05dc\u05d9\u05d5\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0940\u0924 \u0915\u0947 \u092c\u094b\u0932 \u0917\u093e\u0928\u0947 \u0915\u0940 \u0932\u0902\u092c\u093e\u0908 \u0924\u092f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u091b\u094b\u091f\u0947 \u092c\u094b\u0932 \u0938\u0947 \u091b\u094b\u091f\u093e \u0917\u093e\u0928\u093e \u092c\u0928\u0924\u093e \u0939\u0948, \u0914\u0930 \u0905\u0935\u0927\u093f \u0915\u0947\u0935\u0932 \u090a\u092a\u0930\u0940 \u0938\u0940\u092e\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Lirik menentukan panjang lagu. Lirik pendek menghasilkan lagu pendek, dan durasi hanya batas atas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo determina la durata della canzone. Un testo breve d\u00e0 una canzone breve, e la durata \u00e8 solo un limite massimo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b4c\u8a5e\u304c\u66f2\u306e\u9577\u3055\u3092\u6c7a\u3081\u307e\u3059\u3002\u6b4c\u8a5e\u304c\u77ed\u3051\u308c\u3070\u66f2\u3082\u77ed\u304f\u306a\u308a\u3001\u9577\u3055\u306e\u8a2d\u5b9a\u306f\u4e0a\u9650\u306b\u3059\u304e\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac00\uc0ac\uac00 \uace1\uc758 \uae38\uc774\ub97c \uc815\ud569\ub2c8\ub2e4. \uac00\uc0ac\uac00 \uc9e7\uc73c\uba74 \uace1\ub3c4 \uc9e7\uc544\uc9c0\uba70, \uae38\uc774 \uc124\uc815\uc740 \uc0c1\ud55c\uc77c \ubfd0\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De songtekst bepaalt de lengte van het nummer. Een korte tekst geeft een kort nummer, en de duur is alleen een bovengrens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tekst piosenki okre\u015bla jej d\u0142ugo\u015b\u0107. Kr\u00f3tki tekst daje kr\u00f3tk\u0105 piosenk\u0119, a czas trwania jest tylko g\u00f3rn\u0105 granic\u0105."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A letra define a dura\u00e7\u00e3o da m\u00fasica. Uma letra curta gera uma m\u00fasica curta, e a dura\u00e7\u00e3o \u00e9 apenas um limite m\u00e1ximo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043a\u0441\u0442 \u043f\u0435\u0441\u043d\u0438 \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u044f\u0435\u0442 \u0435\u0451 \u0434\u043b\u0438\u043d\u0443. \u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u0434\u0430\u0451\u0442 \u043a\u043e\u0440\u043e\u0442\u043a\u0443\u044e \u043f\u0435\u0441\u043d\u044e, \u0430 \u0434\u043b\u0438\u0442\u0435\u043b\u044c\u043d\u043e\u0441\u0442\u044c \u043b\u0438\u0448\u044c \u0432\u0435\u0440\u0445\u043d\u0438\u0439 \u043f\u0440\u0435\u0434\u0435\u043b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e5ttexten best\u00e4mmer l\u00e5tens l\u00e4ngd. En kort text ger en kort l\u00e5t, och varaktigheten \u00e4r bara en \u00f6vre gr\u00e4ns."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eark\u0131 s\u00f6zleri \u015fark\u0131n\u0131n uzunlu\u011funu belirler. K\u0131sa s\u00f6zler k\u0131sa \u015fark\u0131 yapar, s\u00fcre yaln\u0131zca bir \u00fcst s\u0131n\u0131rd\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0435\u043a\u0441\u0442 \u043f\u0456\u0441\u043d\u0456 \u0432\u0438\u0437\u043d\u0430\u0447\u0430\u0454 \u0457\u0457 \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c. \u041a\u043e\u0440\u043e\u0442\u043a\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u0434\u0430\u0454 \u043a\u043e\u0440\u043e\u0442\u043a\u0443 \u043f\u0456\u0441\u043d\u044e, \u0430 \u0442\u0440\u0438\u0432\u0430\u043b\u0456\u0441\u0442\u044c \u043b\u0438\u0448\u0435 \u0432\u0435\u0440\u0445\u043d\u044f \u043c\u0435\u0436\u0430."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1eddi b\u00e0i h\u00e1t quy\u1ebft \u0111\u1ecbnh \u0111\u1ed9 d\u00e0i b\u00e0i h\u00e1t. L\u1eddi ng\u1eafn cho b\u00e0i h\u00e1t ng\u1eafn, v\u00e0 th\u1eddi l\u01b0\u1ee3ng ch\u1ec9 l\u00e0 gi\u1edbi h\u1ea1n tr\u00ean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b4c\u8bcd\u51b3\u5b9a\u6b4c\u66f2\u957f\u5ea6\u3002\u6b4c\u8bcd\u77ed\uff0c\u6b4c\u66f2\u5c31\u77ed\uff0c\u65f6\u957f\u8bbe\u7f6e\u53ea\u662f\u4e0a\u9650\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b4c\u8a5e\u6c7a\u5b9a\u6b4c\u66f2\u9577\u5ea6\u3002\u6b4c\u8a5e\u77ed\uff0c\u6b4c\u66f2\u5c31\u77ed\uff0c\u6642\u9577\u8a2d\u5b9a\u53ea\u662f\u4e0a\u9650\u3002"
          }
        }
      }
    },
    "Keep lyrics out of the description. Describe how sections should sound there, such as a bigger chorus.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep lyrics out of the description. Describe how sections should sound there, such as a bigger chorus."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0636\u0639 \u0643\u0644\u0645\u0627\u062a \u0627\u0644\u0623\u063a\u0646\u064a\u0629 \u0641\u064a \u0627\u0644\u0648\u0635\u0641. \u0635\u0641 \u0647\u0646\u0627\u0643 \u0643\u064a\u0641 \u064a\u0646\u0628\u063a\u064a \u0623\u0646 \u062a\u0628\u062f\u0648 \u0627\u0644\u0623\u0642\u0633\u0627\u0645\u060c \u0645\u062b\u0644 \u0644\u0627\u0632\u0645\u0629 \u0623\u0643\u0628\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass den Liedtext aus der Beschreibung heraus. Beschreibe dort, wie Abschnitte klingen sollen, etwa ein gr\u00f6\u00dferer Refrain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No pongas la letra en la descripci\u00f3n. Describe ah\u00ed c\u00f3mo debe sonar cada secci\u00f3n, por ejemplo un estribillo m\u00e1s grande."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les paroles hors de la description. D\u00e9crivez-y plut\u00f4t le rendu des sections, par exemple un refrain plus ample."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05dc \u05ea\u05db\u05e0\u05d9\u05e1 \u05d0\u05ea \u05de\u05d9\u05dc\u05d5\u05ea \u05d4\u05e9\u05d9\u05e8 \u05dc\u05ea\u05d9\u05d0\u05d5\u05e8. \u05ea\u05d0\u05e8 \u05e9\u05dd \u05d0\u05d9\u05da \u05d4\u05de\u05e7\u05d8\u05e2\u05d9\u05dd \u05e6\u05e8\u05d9\u05db\u05d9\u05dd \u05dc\u05d4\u05d9\u05e9\u05de\u05e2, \u05dc\u05de\u05e9\u05dc \u05e4\u05d6\u05de\u05d5\u05df \u05d2\u05d3\u05d5\u05dc \u05d9\u05d5\u05ea\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u0940\u0924 \u0915\u0947 \u092c\u094b\u0932 \u0915\u094b \u0935\u093f\u0935\u0930\u0923 \u092e\u0947\u0902 \u0928 \u0930\u0916\u0947\u0902\u0964 \u0935\u0939\u093e\u0901 \u092c\u0924\u093e\u090f\u0901 \u0915\u093f \u0938\u0947\u0915\u094d\u0936\u0928 \u0915\u0948\u0938\u0947 \u0938\u0941\u0928\u093e\u0908 \u0926\u0947\u0902, \u091c\u0948\u0938\u0947 \u092c\u0921\u093c\u093e \u0915\u094b\u0930\u0938\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan masukkan lirik ke deskripsi. Jelaskan di sana bagaimana bagian-bagian harus terdengar, misalnya chorus yang lebih besar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni il testo fuori dalla descrizione. Descrivi l\u00ec come devono suonare le sezioni, ad esempio un ritornello pi\u00f9 grande."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b4c\u8a5e\u306f\u8aac\u660e\u306b\u5165\u308c\u306a\u3044\u3067\u304f\u3060\u3055\u3044\u3002\u8aac\u660e\u306b\u306f\u3001\u30b5\u30d3\u3092\u5927\u304d\u304f\u3059\u308b\u306a\u3069\u3001\u5404\u30bb\u30af\u30b7\u30e7\u30f3\u306e\u805e\u3053\u3048\u65b9\u3092\u66f8\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uac00\uc0ac\ub294 \uc124\uba85\uc5d0 \ub123\uc9c0 \ub9c8\uc138\uc694. \uc124\uba85\uc5d0\ub294 \ucf54\ub7ec\uc2a4\ub97c \ub354 \ud06c\uac8c \ud558\ub294 \ub4f1 \uac01 \uc139\uc158\uc774 \uc5b4\ub5bb\uac8c \ub4e4\ub824\uc57c \ud558\ub294\uc9c0 \uc801\uc73c\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd de songtekst uit de beschrijving. Beschrijf daar hoe secties moeten klinken, zoals een groter refrein."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie umieszczaj tekstu piosenki w opisie. Opisz tam, jak maj\u0105 brzmie\u0107 sekcje, na przyk\u0142ad g\u0142o\u015bniejszy refren."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o coloque a letra na descri\u00e7\u00e3o. Descreva ali como as se\u00e7\u00f5es devem soar, como um refr\u00e3o maior."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u043a\u043b\u044e\u0447\u0430\u0439\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u043f\u0435\u0441\u043d\u0438 \u0432 \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435. \u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0442\u0430\u043c, \u043a\u0430\u043a \u0434\u043e\u043b\u0436\u043d\u044b \u0437\u0432\u0443\u0447\u0430\u0442\u044c \u0440\u0430\u0437\u0434\u0435\u043b\u044b, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 \u0431\u043e\u043b\u0435\u0435 \u043c\u043e\u0449\u043d\u044b\u0439 \u043f\u0440\u0438\u043f\u0435\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e5ll l\u00e5ttexten utanf\u00f6r beskrivningen. Beskriv d\u00e4r hur sektionerna ska l\u00e5ta, till exempel en st\u00f6rre refr\u00e4ng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u015eark\u0131 s\u00f6zlerini a\u00e7\u0131klaman\u0131n d\u0131\u015f\u0131nda tutun. Orada b\u00f6l\u00fcmlerin nas\u0131l duyulaca\u011f\u0131n\u0131 anlat\u0131n, \u00f6rne\u011fin daha b\u00fcy\u00fck bir nakarat."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0434\u043e\u0434\u0430\u0432\u0430\u0439\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u043f\u0456\u0441\u043d\u0456 \u0432 \u043e\u043f\u0438\u0441. \u041e\u043f\u0438\u0448\u0456\u0442\u044c \u0442\u0430\u043c, \u044f\u043a \u043c\u0430\u044e\u0442\u044c \u0437\u0432\u0443\u0447\u0430\u0442\u0438 \u0440\u043e\u0437\u0434\u0456\u043b\u0438, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 \u043f\u043e\u0442\u0443\u0436\u043d\u0456\u0448\u0438\u0439 \u043f\u0440\u0438\u0441\u043f\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u1eebng \u0111\u01b0a l\u1eddi b\u00e0i h\u00e1t v\u00e0o m\u00f4 t\u1ea3. H\u00e3y m\u00f4 t\u1ea3 \u1edf \u0111\u00f3 c\u00e1c ph\u1ea7n n\u00ean nghe th\u1ebf n\u00e0o, ch\u1eb3ng h\u1ea1n \u0111i\u1ec7p kh\u00fac l\u1edbn h\u01a1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u628a\u6b4c\u8bcd\u653e\u8fdb\u63cf\u8ff0\u3002\u5728\u63cf\u8ff0\u4e2d\u8bf4\u660e\u5404\u6bb5\u843d\u5e94\u6709\u7684\u542c\u611f\uff0c\u4f8b\u5982\u66f4\u5b8f\u5927\u7684\u526f\u6b4c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0d\u8981\u628a\u6b4c\u8a5e\u653e\u9032\u63cf\u8ff0\u3002\u5728\u63cf\u8ff0\u4e2d\u8aaa\u660e\u5404\u6bb5\u843d\u61c9\u6709\u7684\u807d\u611f\uff0c\u4f8b\u5982\u66f4\u5b8f\u5927\u7684\u526f\u6b4c\u3002"
          }
        }
      }
    },
    "Repeat a hook or phrase across sections so the song feels connected.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat a hook or phrase across sections so the song feels connected."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0643\u0631\u0651\u0631 \u062c\u0645\u0644\u0629 \u0644\u0627\u0641\u062a\u0629 \u0623\u0648 \u0639\u0628\u0627\u0631\u0629 \u0639\u0628\u0631 \u0627\u0644\u0623\u0642\u0633\u0627\u0645 \u0644\u064a\u0628\u062f\u0648 \u0644\u0644\u0623\u063a\u0646\u064a\u0629 \u062a\u0631\u0627\u0628\u0637."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederhole einen Hook oder eine Phrase \u00fcber Abschnitte hinweg, damit der Song zusammenh\u00e4ngend wirkt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite un gancho o una frase entre secciones para que la canci\u00f3n se sienta cohesionada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9p\u00e9tez une accroche ou une phrase d'une section \u00e0 l'autre pour donner de la coh\u00e9sion au morceau."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05d6\u05d5\u05e8 \u05e2\u05dc \u05d4\u05d5\u05e7 \u05d0\u05d5 \u05d1\u05d9\u05d8\u05d5\u05d9 \u05d1\u05d9\u05df \u05d4\u05de\u05e7\u05d8\u05e2\u05d9\u05dd \u05db\u05d3\u05d9 \u05e9\u05d4\u05e9\u05d9\u05e8 \u05d9\u05e8\u05d2\u05d9\u05e9 \u05de\u05d7\u05d5\u05d1\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0917\u093e\u0928\u0947 \u092e\u0947\u0902 \u091c\u0941\u0921\u093c\u093e\u0935 \u092e\u0939\u0938\u0942\u0938 \u0939\u094b, \u0907\u0938\u0932\u093f\u090f \u0915\u093f\u0938\u0940 \u0939\u0941\u0915 \u092f\u093e \u0935\u093e\u0915\u094d\u092f\u093e\u0902\u0936 \u0915\u094b \u0905\u0932\u0917-\u0905\u0932\u0917 \u0938\u0947\u0915\u094d\u0936\u0928 \u092e\u0947\u0902 \u0926\u094b\u0939\u0930\u093e\u090f\u0901\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulangi hook atau frasa di beberapa bagian agar lagu terasa menyatu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti un hook o una frase tra le sezioni per far sembrare la canzone coerente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f2\u306b\u307e\u3068\u307e\u308a\u3092\u6301\u305f\u305b\u308b\u305f\u3081\u3001\u30d5\u30c3\u30af\u3084\u30d5\u30ec\u30fc\u30ba\u3092\u8907\u6570\u306e\u30bb\u30af\u30b7\u30e7\u30f3\u3067\u7e70\u308a\u8fd4\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uace1\uc774 \ud558\ub098\ub85c \uc774\uc5b4\uc9c0\ub3c4\ub85d \ud6c4\ud06c\ub098 \uad6c\uc808\uc744 \uc5ec\ub7ec \uc139\uc158\uc5d0 \uac78\uccd0 \ubc18\ubcf5\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herhaal een hook of zinsdeel in meerdere secties zodat het nummer samenhangend aanvoelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powt\u00f3rz chwytliwy motyw lub fraz\u0119 w kilku sekcjach, aby piosenka brzmia\u0142a sp\u00f3jnie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Repita um gancho ou uma frase entre as se\u00e7\u00f5es para que a m\u00fasica soe conectada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0442\u043e\u0440\u044f\u0439\u0442\u0435 \u0445\u0443\u043a \u0438\u043b\u0438 \u0444\u0440\u0430\u0437\u0443 \u0432 \u0440\u0430\u0437\u043d\u044b\u0445 \u0440\u0430\u0437\u0434\u0435\u043b\u0430\u0445, \u0447\u0442\u043e\u0431\u044b \u043f\u0435\u0441\u043d\u044f \u043a\u0430\u0437\u0430\u043b\u0430\u0441\u044c \u0446\u0435\u043b\u044c\u043d\u043e\u0439."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upprepa en hook eller fras mellan sektionerna s\u00e5 att l\u00e5ten k\u00e4nns sammanh\u00e4ngande."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak\u0131lda kal\u0131c\u0131 bir ifadeyi b\u00f6l\u00fcmler aras\u0131nda tekrarlay\u0131n, b\u00f6ylece \u015fark\u0131 b\u00fct\u00fcnl\u00fckl\u00fc hissettirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0442\u043e\u0440\u044e\u0439\u0442\u0435 \u0445\u0443\u043a \u0430\u0431\u043e \u0444\u0440\u0430\u0437\u0443 \u0432 \u0440\u0456\u0437\u043d\u0438\u0445 \u0440\u043e\u0437\u0434\u0456\u043b\u0430\u0445, \u0449\u043e\u0431 \u043f\u0456\u0441\u043d\u044f \u0437\u0434\u0430\u0432\u0430\u043b\u0430\u0441\u044f \u0446\u0456\u043b\u0456\u0441\u043d\u043e\u044e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1eb7p l\u1ea1i m\u1ed9t \u0111o\u1ea1n hook ho\u1eb7c c\u1ee5m t\u1eeb gi\u1eefa c\u00e1c ph\u1ea7n \u0111\u1ec3 b\u00e0i h\u00e1t c\u00f3 c\u1ea3m gi\u00e1c li\u1ec1n m\u1ea1ch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4e0d\u540c\u6bb5\u843d\u91cd\u590d\u94a9\u5b50\u6216\u77ed\u8bed\uff0c\u8ba9\u6b4c\u66f2\u542c\u8d77\u6765\u524d\u540e\u8fde\u8d2f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4e0d\u540c\u6bb5\u843d\u91cd\u8907\u9264\u5b50\u6216\u77ed\u8a9e\uff0c\u8b93\u6b4c\u66f2\u807d\u8d77\u4f86\u524d\u5f8c\u9023\u8cab\u3002"
          }
        }
      }
    },
