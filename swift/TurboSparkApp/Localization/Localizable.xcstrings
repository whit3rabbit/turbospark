    },
    "Keep working toward a condition until it is met: /goal <condition>": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "واصل العمل نحو شرط حتى يتحقق: /goal <condition>"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weiterarbeiten, bis eine Bedingung erfüllt ist: /goal <condition>"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep working toward a condition until it is met: /goal <condition>"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seguir trabajando hasta cumplir una condición: /goal <condition>"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Continuer jusqu'à ce qu'une condition soit remplie : /goal <condition>"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך לעבוד עד שתנאי יתקיים: /goal <condition>"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
