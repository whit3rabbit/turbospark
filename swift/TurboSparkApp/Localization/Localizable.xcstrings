    "Pages load only local files from the artifact's own folder.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062d\u0645\u0651\u0644 \u0627\u0644\u0635\u0641\u062d\u0627\u062a \u0645\u0644\u0641\u0627\u062a \u0645\u062d\u0644\u064a\u0629 \u0645\u0646 \u0645\u062c\u0644\u062f \u0627\u0644\u0639\u0646\u0635\u0631 \u0646\u0641\u0633\u0647 \u0641\u0642\u0637."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seiten laden ausschlie\u00dflich lokale Dateien aus dem eigenen Ordner des Artefakts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pages load only local files from the artifact's own folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las p\u00e1ginas solo cargan archivos locales de la propia carpeta del artefacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages ne chargent que des fichiers locaux issus du dossier de l'artefact."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d3\u05e4\u05d9\u05dd \u05d8\u05d5\u05e2\u05e0\u05d9\u05dd \u05e8\u05e7 \u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05e7\u05d5\u05de\u05d9\u05d9\u05dd \u05de\u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05e9\u05dc \u05d4\u05e4\u05e8\u05d9\u05d8 \u05e2\u05e6\u05de\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0947\u091c \u0915\u0947\u0935\u0932 \u0906\u0930\u094d\u091f\u093f\u092b\u093c\u0948\u0915\u094d\u091f \u0915\u0947 \u0905\u092a\u0928\u0947 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0938\u0947 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0932\u094b\u0921 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Halaman hanya memuat berkas lokal dari folder artefak itu sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pagine caricano solo file locali dalla cartella dell'artefatto stesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30da\u30fc\u30b8\u306f\u3001\u30a2\u30fc\u30c6\u30a3\u30d5\u30a1\u30af\u30c8\u81ea\u8eab\u306e\u30d5\u30a9\u30eb\u30c0\u306b\u3042\u308b\u30ed\u30fc\u30ab\u30eb\u30d5\u30a1\u30a4\u30eb\u306e\u307f\u3092\u8aad\u307f\u8fbc\u307f\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud398\uc774\uc9c0\ub294 \uc544\ud2f0\ud329\ud2b8 \uc790\uccb4 \ud3f4\ub354\uc758 \ub85c\uceec \ud30c\uc77c\ub9cc \ub85c\ub4dc\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pagina's laden alleen lokale bestanden uit de eigen map van het artefact."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strony wczytuj\u0105 wy\u0142\u0105cznie pliki lokalne z w\u0142asnego folderu artefaktu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As p\u00e1ginas carregam apenas arquivos locais da pr\u00f3pria pasta do artefato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0440\u0430\u043d\u0438\u0446\u044b \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u044e\u0442 \u0442\u043e\u043b\u044c\u043a\u043e \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u0444\u0430\u0439\u043b\u044b \u0438\u0437 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u043e\u0439 \u043f\u0430\u043f\u043a\u0438 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sidor l\u00e4ser bara in lokala filer fr\u00e5n artefaktens egen mapp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayfalar yaln\u0131zca yap\u0131t\u0131n kendi klas\u00f6r\u00fcndeki yerel dosyalar\u0131 y\u00fckler."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u043e\u0440\u0456\u043d\u043a\u0438 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0443\u044e\u0442\u044c \u043b\u0438\u0448\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0456 \u0444\u0430\u0439\u043b\u0438 \u0437 \u0432\u043b\u0430\u0441\u043d\u043e\u0457 \u043f\u0430\u043f\u043a\u0438 \u0430\u0440\u0442\u0435\u0444\u0430\u043a\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c trang ch\u1ec9 t\u1ea3i t\u1ec7p c\u1ee5c b\u1ed9 t\u1eeb th\u01b0 m\u1ee5c c\u1ee7a ch\u00ednh artifact."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9875\u9762\u53ea\u52a0\u8f7d\u5de5\u4ef6\u81ea\u8eab\u6587\u4ef6\u5939\u4e2d\u7684\u672c\u5730\u6587\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9801\u9762\u53ea\u8f09\u5165\u6210\u54c1\u81ea\u8eab\u8cc7\u6599\u593e\u4e2d\u7684\u672c\u6a5f\u6a94\u6848\u3002"
          }
        }
      }
    },
    "Pasted text exceeded the %lld-token context window; kept the first %lld characters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062c\u0627\u0648\u0632 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u0644\u0635\u0642 \u0646\u0627\u0641\u0630\u0629 \u0627\u0644\u0633\u064a\u0627\u0642 \u0627\u0644\u0628\u0627\u0644\u063a\u0629 %lld \u0631\u0645\u0632\u064b\u0627\u061b \u062a\u0645 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0623\u0648\u0644 %lld \u062d\u0631\u0641\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der eingef\u00fcgte Text \u00fcberschritt das %lld-Token-Kontextfenster; die ersten %lld Zeichen wurden behalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasted text exceeded the %lld-token context window; kept the first %lld characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El texto pegado super\u00f3 la ventana de contexto de %lld tokens; se conservaron los primeros %lld caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le texte coll\u00e9 a d\u00e9pass\u00e9 la fen\u00eatre de contexte de %lld jetons ; les %lld premiers caract\u00e8res ont \u00e9t\u00e9 conserv\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d8\u05e7\u05e1\u05d8 \u05e9\u05d4\u05d5\u05d3\u05d1\u05e7 \u05d7\u05e8\u05d2 \u05de\u05d7\u05dc\u05d5\u05df \u05d4\u05d4\u05e7\u05e9\u05e8 \u05e9\u05dc %lld \u05d0\u05e1\u05d9\u05de\u05d5\u05e0\u05d9\u05dd; \u05e0\u05e9\u05de\u05e8\u05d5 %lld \u05d4\u05ea\u05d5\u05d5\u05d9\u05dd \u05d4\u05e8\u05d0\u05e9\u05d5\u05e0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0947\u0938\u094d\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u091f\u0947\u0915\u094d\u0938\u094d\u091f %lld-\u091f\u094b\u0915\u0928 \u0938\u0902\u0926\u0930\u094d\u092d \u0935\u093f\u0902\u0921\u094b \u0938\u0947 \u0905\u0927\u093f\u0915 \u0925\u093e; \u092a\u0939\u0932\u0947 %lld \u0935\u0930\u094d\u0923 \u0930\u0916\u0947 \u0917\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks yang ditempel melebihi jendela konteks %lld token; %lld karakter pertama dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il testo incollato ha superato la finestra di contesto di %lld token; conservati i primi %lld caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cbc\u308a\u4ed8\u3051\u305f\u30c6\u30ad\u30b9\u30c8\u304c %lld \u30c8\u30fc\u30af\u30f3\u306e\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a6\u30a3\u30f3\u30c9\u30a6\u3092\u8d85\u3048\u305f\u305f\u3081\u3001\u6700\u521d\u306e %lld \u6587\u5b57\u3092\u4fdd\u6301\u3057\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubd99\uc5ec\ub123\uc740 \ud14d\uc2a4\ud2b8\uac00 %lld \ud1a0\ud070 \ucee8\ud14d\uc2a4\ud2b8 \ucc3d\uc744 \ucd08\uacfc\ud558\uc5ec \ucc98\uc74c %lld\uc790\ub97c \uc720\uc9c0\ud588\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De geplakte tekst overtrad het %lld-token contextvenster; de eerste %lld tekens zijn bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklejony tekst przekroczy\u0142 okno kontekstu %lld token\u00f3w; zachowano pierwsze %lld znak\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O texto colado excedeu a janela de contexto de %lld tokens; os primeiros %lld caracteres foram mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \u043f\u0440\u0435\u0432\u044b\u0441\u0438\u043b \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u043e\u0435 \u043e\u043a\u043d\u043e \u0432 %lld \u0442\u043e\u043a\u0435\u043d\u043e\u0432; \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u044b \u043f\u0435\u0440\u0432\u044b\u0435 %lld \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den inklistrade texten \u00f6verskred kontextf\u00f6nstret p\u00e5 %lld token; de f\u00f6rsta %lld tecknen beh\u00f6lls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yap\u0131\u015ft\u0131r\u0131lan metin %lld token ba\u011flam penceresini a\u015ft\u0131; ilk %lld karakter korundu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0438\u0432 \u043a\u043e\u043d\u0442\u0435\u043a\u0441\u0442\u043d\u0435 \u0432\u0456\u043a\u043d\u043e \u0443 %lld \u0442\u043e\u043a\u0435\u043d\u0456\u0432; \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u043f\u0435\u0440\u0448\u0456 %lld \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u0103n b\u1ea3n d\u00e1n \u0111\u00e3 v\u01b0\u1ee3t qu\u00e1 c\u1eeda s\u1ed5 ng\u1eef c\u1ea3nh %lld token; gi\u1eef l\u1ea1i %lld k\u00fd t\u1ef1 \u0111\u1ea7u ti\u00ean."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7c98\u8d34\u7684\u6587\u672c\u8d85\u51fa\u4e86 %lld \u4e2a token \u7684\u4e0a\u4e0b\u6587\u7a97\u53e3\uff1b\u5df2\u4fdd\u7559\u524d %lld \u4e2a\u5b57\u7b26\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8cbc\u4e0a\u7684\u6587\u5b57\u8d85\u51fa\u4e86 %lld \u500b token \u7684\u4e0a\u4e0b\u6587\u8996\u7a97\uff1b\u5df2\u4fdd\u7559\u524d %lld \u500b\u5b57\u5143\u3002"
          }
        }
      }
    },
