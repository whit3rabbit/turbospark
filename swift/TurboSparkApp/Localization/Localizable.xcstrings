        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0449\u0435 \u043d\u0435 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e."
          }
        },
        "vi": {
