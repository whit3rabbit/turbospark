          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model denkt na voordat het antwoordt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model rozumuje przed udzieleniem odpowiedzi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo est\u00e1 raciocinando antes de responder"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0430\u0435\u0442, \u043f\u0440\u0435\u0436\u0434\u0435 \u0447\u0435\u043c \u043e\u0442\u0432\u0435\u0442\u0438\u0442\u044c"
