        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u0441\u043e\u0431\u0441\u0442\u0432\u0435\u043d\u043d\u044b\u0439 \u043f\u0440\u0435\u0434\u0435\u043b \u0440\u0430\u0437\u043c\u0435\u0440\u0430 \u0437\u0430\u0433\u0440\u0443\u0436\u0430\u0435\u043c\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange en egen gr\u00e4ns f\u00f6r den st\u00f6rsta modellstorlek som kan l\u00e4sas in"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Y\u00fcklenebilecek en b\u00fcy\u00fck model boyutu i\u00e7in kendi s\u0131n\u0131r\u0131n\u0131z\u0131 belirleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0434\u0430\u0439\u0442\u0435 \u0432\u043b\u0430\u0441\u043d\u0443 \u043c\u0435\u0436\u0443 \u0440\u043e\u0437\u043c\u0456\u0440\u0443 \u043c\u043e\u0434\u0435\u043b\u0456, \u044f\u043a\u0443 \u043c\u043e\u0436\u043d\u0430 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ef1 \u0111\u1eb7t gi\u1edbi h\u1ea1n k\u00edch th\u01b0\u1edbc t\u1ed1i \u0111a c\u1ee7a m\u00f4 h\u00ecnh c\u00f3 th\u1ec3 t\u1ea3i"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u81ea\u884c\u8bbe\u5b9a\u53ef\u52a0\u8f7d\u6a21\u578b\u7684\u6700\u5927\u5927\u5c0f"
