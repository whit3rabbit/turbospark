    "Server stopped while %@ was loading; it was not attached.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u0642\u0641 \u0627\u0644\u062e\u0627\u062f\u0645 \u0623\u062b\u0646\u0627\u0621 \u062a\u062d\u0645\u064a\u0644 %@\u061b \u0644\u0645 \u064a\u062a\u0645 \u0625\u0631\u0641\u0627\u0642\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server wurde gestoppt, w\u00e4hrend %@ geladen wurde; es wurde nicht verbunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Server stopped while %@ was loading; it was not attached."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor se detuvo mientras se cargaba %@; no se adjunt\u00f3."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur s'est arr\u00eat\u00e9 pendant le chargement de %@ ; il n'a pas \u00e9t\u00e9 associ\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05e8\u05ea \u05e0\u05e2\u05e6\u05e8 \u05d1\u05d6\u05de\u05df \u05e9-%@ \u05e0\u05d8\u05e2\u05df; \u05d4\u05d5\u05d0 \u05dc\u05d0 \u05d7\u05d5\u05d1\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u0932\u094b\u0921 \u0939\u094b\u0924\u0947 \u0938\u092e\u092f \u0938\u0930\u094d\u0935\u0930 \u0930\u0941\u0915 \u0917\u092f\u093e; \u0907\u0938\u0947 \u0938\u0902\u0932\u0917\u094d\u0928 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server berhenti saat %@ sedang dimuat; model tidak dilampirkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il server si \u00e8 fermato durante il caricamento di %@; non \u00e8 stato collegato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u306e\u8aad\u307f\u8fbc\u307f\u4e2d\u306b\u30b5\u30fc\u30d0\u30fc\u304c\u505c\u6b62\u3057\u305f\u305f\u3081\u3001\u63a5\u7d9a\u3055\u308c\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uc744(\ub97c) \ub85c\ub4dc\ud558\ub294 \ub3d9\uc548 \uc11c\ubc84\uac00 \uc911\uc9c0\ub418\uc5b4 \uc5f0\uacb0\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De server is gestopt terwijl %@ werd geladen; het is niet gekoppeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer zatrzyma\u0142 si\u0119 podczas \u0142adowania %@; model nie zosta\u0142 do\u0142\u0105czony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O servidor parou enquanto %@ carregava; ele n\u00e3o foi anexado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0440\u0432\u0435\u0440 \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u043b\u0441\u044f \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438 %@; \u043c\u043e\u0434\u0435\u043b\u044c \u043d\u0435 \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Servern stoppades medan %@ l\u00e4stes in; den ansl\u00f6ts inte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ y\u00fcklenirken sunucu durdu; ba\u011flanmad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0435\u0440\u0432\u0435\u0440 \u0437\u0443\u043f\u0438\u043d\u0438\u0432\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f %@; \u043c\u043e\u0434\u0435\u043b\u044c \u043d\u0435 \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00e1y ch\u1ee7 \u0111\u00e3 d\u1eebng trong khi %@ \u0111ang t\u1ea3i; m\u00f4 h\u00ecnh ch\u01b0a \u0111\u01b0\u1ee3c g\u1eafn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u8f7d %@ \u65f6\u670d\u52a1\u5668\u5df2\u505c\u6b62\uff1b\u672a\u6302\u8f7d\u8be5\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f09\u5165 %@ \u6642\u4f3a\u670d\u5668\u5df2\u505c\u6b62\uff1b\u672a\u639b\u8f09\u8a72\u6a21\u578b\u3002"
          }
        }
      }
    },
