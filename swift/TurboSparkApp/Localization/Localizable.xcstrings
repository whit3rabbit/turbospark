        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0915\u094b TurboSpark \u0938\u0947 \u0939\u091f\u093e \u0926\u093f\u092f\u093e \u0917\u092f\u093e\u0964 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0921\u093f\u0938\u094d\u0915 \u092a\u0930 %@ \u092e\u0947\u0902 \u091b\u094b\u0921\u093c \u0926\u0940 \u0917\u0908 \u0939\u0948\u0902; \u0907\u0938\u0947 \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 > \u092e\u0949\u0921\u0932 \u092e\u0947\u0902 \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' dihapus dari TurboSpark. File-nya tetap ada di disk di %@; pulihkan melalui Pengaturan > Model."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u00e8 stato rimosso da TurboSpark. I file sono rimasti sul disco in %@; ripristinalo in Impostazioni > Modelli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u3092 TurboSpark \u304b\u3089\u524a\u9664\u3057\u307e\u3057\u305f\u3002\u30d5\u30a1\u30a4\u30eb\u306f\u30c7\u30a3\u30b9\u30af\u4e0a\u306e %@ \u306b\u6b8b\u3063\u3066\u3044\u307e\u3059\u3002\u300c\u8a2d\u5b9a > \u30e2\u30c7\u30eb\u300d\u3067\u5fa9\u5143\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc744(\ub97c) TurboSpark\uc5d0\uc11c \uc81c\uac70\ud588\uc2b5\ub2c8\ub2e4. \ud30c\uc77c\uc740 \ub514\uc2a4\ud06c\uc758 %@\uc5d0 \ub0a8\uc544 \uc788\uc73c\uba70, \uc124\uc815 > \ubaa8\ub378\uc5d0\uc11c \ubcf5\uc6d0\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is uit TurboSpark verwijderd. De bestanden staan nog op schijf in %@; herstel het via Instellingen > Modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuni\u0119to '%@' z TurboSpark. Pliki pozosta\u0142y na dysku w %@; przywr\u00f3\u0107 model w Ustawienia > Modele."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' foi removido do TurboSpark. Os arquivos foram mantidos no disco em %@; restaure-o em Configura\u00e7\u00f5es > Modelos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c '%@' \u0443\u0434\u0430\u043b\u0435\u043d\u0430 \u0438\u0437 TurboSpark. \u0424\u0430\u0439\u043b\u044b \u043e\u0441\u0442\u0430\u043b\u0438\u0441\u044c \u043d\u0430 \u0434\u0438\u0441\u043a\u0435 \u0432 %@; \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0435\u0451 \u043c\u043e\u0436\u043d\u043e \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u041d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 > \u041c\u043e\u0434\u0435\u043b\u0438\u00bb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' har tagits bort fr\u00e5n TurboSpark. Filerna finns kvar p\u00e5 disken i %@; \u00e5terst\u00e4ll den under Inst\u00e4llningar > Modeller."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' TurboSpark'tan kald\u0131r\u0131ld\u0131. Dosyalar diskte %@ konumunda b\u0131rak\u0131ld\u0131; Ayarlar > Modeller b\u00f6l\u00fcm\u00fcnden geri y\u00fckleyebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c '%@' \u0432\u0438\u043b\u0443\u0447\u0435\u043d\u043e \u0437 TurboSpark. \u0424\u0430\u0439\u043b\u0438 \u0437\u0430\u043b\u0438\u0448\u0438\u043b\u0438\u0441\u044f \u043d\u0430 \u0434\u0438\u0441\u043a\u0443 \u0432 %@; \u0432\u0456\u0434\u043d\u043e\u0432\u0438\u0442\u0438 \u0457\u0457 \u043c\u043e\u0436\u043d\u0430 \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u041f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u0438 > \u041c\u043e\u0434\u0435\u043b\u0456\u00bb."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 x\u00f3a '%@' kh\u1ecfi TurboSpark. C\u00e1c t\u1ec7p v\u1eabn \u0111\u01b0\u1ee3c gi\u1eef tr\u00ean \u1ed5 \u0111\u0129a t\u1ea1i %@; h\u00e3y kh\u00f4i ph\u1ee5c trong C\u00e0i \u0111\u1eb7t > M\u00f4 h\u00ecnh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u4ece TurboSpark \u4e2d\u79fb\u9664 '%@'\u3002\u6587\u4ef6\u4ecd\u4fdd\u7559\u5728\u78c1\u76d8\u4e0a\u7684 %@\uff1b\u53ef\u5728\u201c\u8bbe\u7f6e > \u6a21\u578b\u201d\u4e2d\u6062\u590d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u5f9e TurboSpark \u4e2d\u79fb\u9664 '%@'\u3002\u6a94\u6848\u4ecd\u4fdd\u7559\u5728\u78c1\u789f\u4e0a\u7684 %@\uff1b\u53ef\u5728\u300c\u8a2d\u5b9a > \u6a21\u578b\u300d\u4e2d\u9084\u539f\u3002"
          }
        }
      }
    },
