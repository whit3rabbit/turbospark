          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo instalado no coincide con esta app. Elimínalo y descárgalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
