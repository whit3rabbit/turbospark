          "stringUnit": {
            "state": "translated",
            "value": "\u30a2\u30d7\u30ea\u306e\u30aa\u30fc\u30c7\u30a3\u30aa\u3092\u9332\u97f3\u4e2d\u3067\u3059\u3002\u30af\u30ea\u30c3\u30af\u3059\u308b\u3068\u505c\u6b62\u3057\u3066\u6dfb\u4ed8\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc571 \uc624\ub514\uc624 \ub179\uc74c \uc911\uc785\ub2c8\ub2e4. \ud074\ub9ad\ud558\uba74 \uc911\uc9c0\ud558\uace0 \ucca8\ubd80\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "App-audio wordt opgenomen. Klik om te stoppen en bij te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie d\u017awi\u0119ku aplikacji. Kliknij, aby zatrzyma\u0107 i do\u0142\u0105czy\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gravando \u00e1udio de um app. Clique para parar e anexar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0434\u0451\u0442 \u0437\u0430\u043f\u0438\u0441\u044c \u0437\u0432\u0443\u043a\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f. \u041d\u0430\u0436\u043c\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u043e\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0438 \u043f\u0440\u0438\u043a\u0440\u0435\u043f\u0438\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar in appljud. Klicka f\u00f6r att stoppa och bifoga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama sesi kaydediliyor. Durdurup eklemek i\u00e7in t\u0131klay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u0440\u0438\u0432\u0430\u0454 \u0437\u0430\u043f\u0438\u0441 \u0437\u0432\u0443\u043a\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0443. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0437\u0443\u043f\u0438\u043d\u0438\u0442\u0438 \u0439 \u043f\u0440\u0438\u043a\u0440\u0456\u043f\u0438\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110ang ghi \u00e2m thanh \u1ee9ng d\u1ee5ng. Nh\u1ea5p \u0111\u1ec3 d\u1eebng v\u00e0 \u0111\u00ednh k\u00e8m."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u5f55\u5236\u5e94\u7528\u97f3\u9891\u3002\u70b9\u6309\u53ef\u505c\u6b62\u5e76\u9644\u52a0\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b63\u5728\u9304\u88fd App \u97f3\u8a0a\u3002\u6309\u4e00\u4e0b\u53ef\u505c\u6b62\u4e26\u9644\u52a0\u3002"
          }
        }
      }
    },
    "Recording, voice notes, audio attachments and app audio capture. With this off, the microphone button uses macOS Dictation.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0648\u0627\u0644\u0645\u0644\u0627\u062d\u0638\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0648\u0627\u0644\u0645\u0631\u0641\u0642\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0648\u0627\u0644\u062a\u0642\u0627\u0637 \u0635\u0648\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a. \u0639\u0646\u062f \u0625\u064a\u0642\u0627\u0641\u0647\u060c \u064a\u0633\u062a\u062e\u062f\u0645 \u0632\u0631 \u0627\u0644\u0645\u064a\u0643\u0631\u0648\u0641\u0648\u0646 \u0625\u0645\u0644\u0627\u0621 macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aufnahme, Sprachnotizen, Audioanh\u00e4nge und App-Audioaufnahme. Ist dies aus, verwendet die Mikrofontaste das macOS-Diktat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording, voice notes, audio attachments and app audio capture. With this off, the microphone button uses macOS Dictation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Grabaci\u00f3n, notas de voz, archivos de audio adjuntos y captura de audio de apps. Si est\u00e1 desactivado, el bot\u00f3n del micr\u00f3fono usa el Dictado de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrement, notes vocales, pi\u00e8ces jointes audio et capture du son des apps. Si cette option est d\u00e9sactiv\u00e9e, le bouton du microphone utilise la Dict\u00e9e de macOS."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e7\u05dc\u05d8\u05d4, \u05d4\u05e2\u05e8\u05d5\u05ea \u05e7\u05d5\u05dc\u05d9\u05d5\u05ea, \u05e7\u05d1\u05e6\u05d9 \u05e9\u05de\u05e2 \u05de\u05e6\u05d5\u05e8\u05e4\u05d9\u05dd \u05d5\u05dc\u05db\u05d9\u05d3\u05ea \u05e9\u05de\u05e2 \u05de\u05d9\u05d9\u05e9\u05d5\u05de\u05d9\u05dd. \u05db\u05e9\u05d4\u05d0\u05e4\u05e9\u05e8\u05d5\u05ea \u05db\u05d1\u05d5\u05d9\u05d4, \u05db\u05e4\u05ea\u05d5\u05e8 \u05d4\u05de\u05d9\u05e7\u05e8\u05d5\u05e4\u05d5\u05df \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05d4\u05db\u05ea\u05d1\u05d4 \u05e9\u05dc macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917, \u0935\u0949\u0907\u0938 \u0928\u094b\u091f\u094d\u0938, \u0911\u0921\u093f\u092f\u094b \u0905\u091f\u0948\u091a\u092e\u0947\u0902\u091f \u0914\u0930 \u0910\u092a \u0911\u0921\u093f\u092f\u094b \u0915\u0948\u092a\u094d\u091a\u0930\u0964 \u0907\u0938\u0947 \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u092a\u0930 \u092e\u093e\u0907\u0915\u094d\u0930\u094b\u092b\u093c\u094b\u0928 \u092c\u091f\u0928 macOS \u0921\u093f\u0915\u094d\u091f\u0947\u0936\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekaman, catatan suara, lampiran audio, dan tangkapan audio aplikasi. Jika nonaktif, tombol mikrofon menggunakan Dikte macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrazione, note vocali, allegati audio e acquisizione audio delle app. Se disattivato, il pulsante del microfono usa la Dettatura di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9332\u97f3\u3001\u30dc\u30a4\u30b9\u30e1\u30e2\u3001\u30aa\u30fc\u30c7\u30a3\u30aa\u306e\u6dfb\u4ed8\u3001\u30a2\u30d7\u30ea\u306e\u30aa\u30fc\u30c7\u30a3\u30aa\u30ad\u30e3\u30d7\u30c1\u30e3\u3002\u30aa\u30d5\u306e\u5834\u5408\u3001\u30de\u30a4\u30af\u30dc\u30bf\u30f3\u306f macOS \u306e\u97f3\u58f0\u5165\u529b\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub179\uc74c, \uc74c\uc131 \uba54\ubaa8, \uc624\ub514\uc624 \ucca8\ubd80, \uc571 \uc624\ub514\uc624 \ucea1\ucc98. \ub044\uba74 \ub9c8\uc774\ud06c \ubc84\ud2bc\uc774 macOS \ubc1b\uc544\uc4f0\uae30\ub97c \uc0ac\uc6a9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opnemen, spraaknotities, audiobijlagen en app-audio opnemen. Als dit uit staat, gebruikt de microfoonknop macOS-dicteren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywanie, notatki g\u0142osowe, za\u0142\u0105czniki audio i przechwytywanie d\u017awi\u0119ku aplikacji. Gdy to jest wy\u0142\u0105czone, przycisk mikrofonu u\u017cywa dyktowania macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava\u00e7\u00e3o, notas de voz, anexos de \u00e1udio e captura de \u00e1udio de apps. Com isto desativado, o bot\u00e3o do microfone usa o Ditado do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u044c, \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u044b\u0435 \u0437\u0430\u043c\u0435\u0442\u043a\u0438, \u0430\u0443\u0434\u0438\u043e\u0432\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438 \u0437\u0430\u0445\u0432\u0430\u0442 \u0437\u0432\u0443\u043a\u0430 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0439. \u0415\u0441\u043b\u0438 \u0432\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e, \u043a\u043d\u043e\u043f\u043a\u0430 \u043c\u0438\u043a\u0440\u043e\u0444\u043e\u043d\u0430 \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0434\u0438\u043a\u0442\u043e\u0432\u043a\u0443 macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inspelning, r\u00f6stanteckningar, ljudbilagor och inspelning av appljud. N\u00e4r detta \u00e4r avst\u00e4ngt anv\u00e4nder mikrofonknappen macOS-diktering."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kay\u0131t, sesli notlar, ses ekleri ve uygulama sesi yakalama. Bu kapal\u0131yken mikrofon d\u00fc\u011fmesi macOS Dikte'yi kullan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441, \u0433\u043e\u043b\u043e\u0441\u043e\u0432\u0456 \u043d\u043e\u0442\u0430\u0442\u043a\u0438, \u0430\u0443\u0434\u0456\u043e\u0432\u043a\u043b\u0430\u0434\u0435\u043d\u043d\u044f \u0442\u0430 \u0437\u0430\u0445\u043e\u043f\u043b\u0435\u043d\u043d\u044f \u0437\u0432\u0443\u043a\u0443 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043a\u0456\u0432. \u042f\u043a\u0449\u043e \u0432\u0438\u043c\u043a\u043d\u0435\u043d\u043e, \u043a\u043d\u043e\u043f\u043a\u0430 \u043c\u0456\u043a\u0440\u043e\u0444\u043e\u043d\u0430 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0434\u0438\u043a\u0442\u0443\u0432\u0430\u043d\u043d\u044f macOS."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi \u00e2m, ghi ch\u00fa tho\u1ea1i, t\u1ec7p \u00e2m thanh \u0111\u00ednh k\u00e8m v\u00e0 ghi \u00e2m thanh \u1ee9ng d\u1ee5ng. Khi t\u1eaft, n\u00fat micr\u00f4 s\u1ebd d\u00f9ng t\u00ednh n\u0103ng \u0110\u1ecdc ch\u00ednh t\u1ea3 c\u1ee7a macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f55\u97f3\u3001\u8bed\u97f3\u5907\u5fd8\u3001\u97f3\u9891\u9644\u4ef6\u548c\u5e94\u7528\u97f3\u9891\u6355\u83b7\u3002\u5173\u95ed\u540e\uff0c\u9ea6\u514b\u98ce\u6309\u94ae\u5c06\u4f7f\u7528 macOS \u542c\u5199\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9304\u97f3\u3001\u8a9e\u97f3\u5099\u5fd8\u3001\u97f3\u8a0a\u9644\u4ef6\u548c App \u97f3\u8a0a\u64f7\u53d6\u3002\u95dc\u9589\u5f8c\uff0c\u9ea5\u514b\u98a8\u6309\u9215\u5c07\u4f7f\u7528 macOS \u807d\u5beb\u3002"
          }
        }
      }
    },
    "Records speech and inserts the transcript into the prompt": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0633\u062c\u0651\u0644 \u0627\u0644\u0643\u0644\u0627\u0645 \u0648\u064a\u064f\u062f\u0631\u062c \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u0641\u0631\u0651\u063a \u0641\u064a \u0627\u0644\u0645\u0648\u062c\u0651\u0647"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimmt Sprache auf und f\u00fcgt die Transkription in den Prompt ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records speech and inserts the transcript into the prompt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba la voz e inserta la transcripci\u00f3n en el mensaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre la parole et ins\u00e8re la transcription dans l'invite"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e7\u05dc\u05d9\u05d8 \u05d3\u05d9\u05d1\u05d5\u05e8 \u05d5\u05de\u05d5\u05e1\u05d9\u05e3 \u05d0\u05ea \u05d4\u05ea\u05de\u05dc\u05d9\u05dc \u05dc\u05d4\u05e0\u05d7\u05d9\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092d\u093e\u0937\u0923 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u091f\u094d\u0930\u093e\u0902\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0915\u094b \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u092e\u0947\u0902 \u0921\u093e\u0932\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Merekam ucapan dan menyisipkan transkrip ke dalam prompt"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra il parlato e inserisce la trascrizione nel prompt"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u97f3\u58f0\u3092\u9332\u97f3\u3057\u3001\u6587\u5b57\u8d77\u3053\u3057\u3092\u30d7\u30ed\u30f3\u30d7\u30c8\u306b\u633f\u5165\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc74c\uc131\uc744 \ub179\uc74c\ud558\uace0 \ubcc0\ud658\ub41c \ud14d\uc2a4\ud2b8\ub97c \ud504\ub86c\ud504\ud2b8\uc5d0 \uc0bd\uc785\ud569\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt spraak op en voegt de transcriptie in de prompt in"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagrywa mow\u0119 i wstawia transkrypcj\u0119 do polecenia"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grava a fala e insere a transcri\u00e7\u00e3o no prompt"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0440\u0435\u0447\u044c \u0438 \u0432\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443 \u0432 \u0437\u0430\u043f\u0440\u043e\u0441"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spelar in tal och infogar transkriptionen i prompten"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konu\u015fmay\u0131 kaydeder ve d\u00f6k\u00fcm\u00fc isteme ekler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0441\u0443\u0454 \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0442\u0430 \u0432\u0441\u0442\u0430\u0432\u043b\u044f\u0454 \u0440\u043e\u0437\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0443 \u0432 \u0437\u0430\u043f\u0438\u0442"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi gi\u1ecdng n\u00f3i v\u00e0 ch\u00e8n b\u1ea3n ch\u00e9p l\u1eddi v\u00e0o l\u1eddi nh\u1eafc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
