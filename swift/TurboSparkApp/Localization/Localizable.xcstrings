    "Words appear as you speak, about a second behind (English).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظهر الكلمات أثناء حديثك، متأخرة بنحو ثانية (الإنجليزية)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wörter erscheinen beim Sprechen, etwa eine Sekunde verzögert (Englisch)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Words appear as you speak, about a second behind (English)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras aparecen mientras hablas, con un segundo de retraso aproximadamente (inglés)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots s'affichent pendant que vous parlez, avec environ une seconde de décalage (anglais)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המילים מופיעות בזמן שאתם מדברים, באיחור של כשנייה (אנגלית)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बोलते ही शब्द लगभग एक सेकंड की देरी से दिखते हैं (अंग्रेज़ी)।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kata-kata muncul saat Anda berbicara, sekitar satu detik di belakang (bahasa Inggris)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole appaiono mentre parli, con circa un secondo di ritardo (inglese)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話すそばから約1秒遅れで言葉が表示されます（英語）。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말하는 대로 약 1초 늦게 단어가 표시됩니다(영어)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Woorden verschijnen terwijl je spreekt, ongeveer een seconde later (Engels)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa pojawiają się w trakcie mówienia, z opóźnieniem około sekundy (angielski)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras aparecem enquanto você fala, com cerca de um segundo de atraso (inglês)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова появляются по мере речи, примерно с секундной задержкой (английский)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Orden visas medan du talar, ungefär en sekund efter (engelska)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelimeler siz konuştukça, yaklaşık bir saniye gecikmeyle görünür (İngilizce)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова з'являються під час мовлення, приблизно із секундною затримкою (англійська)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các từ xuất hiện khi bạn nói, chậm khoảng một giây (tiếng Anh)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "边说边显示文字，约延迟一秒（英语）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邊說邊顯示文字，約延遲一秒（英文）。"
          }
        }
      }
    },
