    "Split speech text longer than 6,000 characters into sections.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قسّم نص الكلام الذي يتجاوز 6000 حرف إلى أجزاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilen Sie Sprechtexte mit mehr als 6.000 Zeichen in Abschnitte auf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Split speech text longer than 6,000 characters into sections."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide el texto de voz de más de 6.000 caracteres en secciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Divisez les textes de plus de 6 000 caractères en sections."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלק טקסט להקראה שאורכו מעל 6,000 תווים למקטעים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "6,000 अक्षरों से लंबे भाषण पाठ को भागों में बाँटें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagi teks ucapan yang lebih panjang dari 6.000 karakter menjadi beberapa bagian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dividi i testi vocali di oltre 6.000 caratteri in sezioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "6,000文字を超える読み上げ文章は分割してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "6,000자가 넘는 읽기용 글은 여러 부분으로 나누세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdeel spreekteksten van meer dan 6.000 tekens in secties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podziel tekst wypowiedzi dłuższy niż 6000 znaków na części."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divida textos de fala com mais de 6.000 caracteres em seções."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделите текст речи длиннее 6000 символов на части."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dela upp taltexter med fler än 6 000 tecken i avsnitt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "6.000 karakterden uzun konuşma metinlerini bölümlere ayırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розділіть текст мовлення довший за 6000 символів на частини."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chia văn bản lời nói dài hơn 6.000 ký tự thành các phần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请将超过6,000个字符的朗读文本分段。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請將超過6,000個字元的朗讀文字分段。"
          }
        }
      }
    },
    "Splits prompt prefill projections across the Apple Neural Engine and Metal GPU for dense Qwen models on Apple Silicon M4 or newer. Auto enables the split when supported. Takes effect on the next model load.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقسم إسقاطات الملء المسبق للأوامر عبر Apple Neural Engine وMetal GPU لنماذج Qwen الكثيفة على Apple Silicon M4 أو الأحدث. يقوم الوضع التلقائي بتمكين التقسيم عند دعمه. يسري المفعول عند تحميل النموذج التالي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teilt Prompt-Prefill-Projektionen für dichte Qwen-Modelle auf Apple Silicon M4 oder neuer auf die Apple Neural Engine und die Metal-GPU auf. Automatisch aktiviert die Teilung, wenn sie unterstützt wird. Wird beim nächsten Laden des Modells wirksam."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Splits prompt prefill projections across the Apple Neural Engine and Metal GPU for dense Qwen models on Apple Silicon M4 or newer. Auto enables the split when supported. Takes effect on the next model load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide las proyecciones de prellenado del prompt entre el Apple Neural Engine y la GPU Metal para modelos Qwen densos en Apple Silicon M4 o posterior. Automático habilita la división cuando sea compatible. Se aplica en la próxima carga del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Répartit les projections de préremplissage du prompt entre l'Apple Neural Engine et le GPU Metal pour les modèles Qwen denses sur Apple Silicon M4 ou plus récent. Auto active la répartition lorsqu'elle est prise en charge. Prend effet au prochain chargement du modèle."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפצל היטלי מילוי מראש של בקשות בין ה-Apple Neural Engine ל-GPU של Metal עבור דגמי Qwen צפופים ב-Apple Silicon M4 ואילך. אוטומטי מפעיל את הפיצול כשהוא נתמך. ייכנס לתוקף בטעינת הדגם הבאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon M4 या नए पर घने Qwen मॉडल के लिए प्रॉम्प्ट प्रीफ़िल अनुमानों को Apple Neural Engine और Metal GPU में विभाजित करता है। समर्थित होने पर ऑटो विभाजन को सक्षम करता है। अगले मॉडल लोड होने पर प्रभावी होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membagi proyeksi prefill prompt antara Apple Neural Engine dan Metal GPU untuk model Qwen padat pada Apple Silicon M4 atau lebih baru. Otomatis mengaktifkan pemisahan saat didukung. Berlaku saat pemuatan model berikutnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suddivide le proiezioni di prefill del prompt tra Apple Neural Engine e GPU Metal per modelli Qwen densi su Apple Silicon M4 o successivo. Auto abilita la suddivisione quando supportata. Diventa effettivo al successivo caricamento del modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon M4以降のdense Qwenモデルにおいて、プロンプトのプレフィル射影をApple Neural EngineとMetal GPUに分散します。自動ではサポート時に分割を有効化します。次のモデル読み込み時に有効になります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon M4 이상의 dense Qwen 모델을 위해 프롬프트 프리필 프로젝션을 Apple Neural Engine과 Metal GPU에 분할합니다. 자동은 지원 시 분할을 활성화합니다. 다음 모델 로드 시 적용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Splitst prompt-prefill-projecties over de Apple Neural Engine en Metal GPU voor dichte Qwen-modellen op Apple Silicon M4 of nieuwer. Automatisch schakelt de splitsing in wanneer deze wordt ondersteund. Wordt van kracht bij het volgende laden van het model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozdziela projekcje prefillu promptu między Apple Neural Engine i Metal GPU dla gęstych modeli Qwen na Apple Silicon M4 lub nowszym. Tryb automatyczny włącza podział, gdy jest obsługiwany. Obowiązuje przy następnym załadowaniu modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Divide as projeções de pré-preenchimento de prompt entre o Apple Neural Engine e a GPU Metal para modelos Qwen densos no Apple Silicon M4 ou mais recente. Automático ativa a divisão quando compatível. Entra em vigor no próximo carregamento do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разделяет проекции префилла промпта между Apple Neural Engine и Metal GPU для плотных моделей Qwen на Apple Silicon M4 или новее. Автоматический режим включает разделение, если оно поддерживается. Вступает в силу при следующей загрузке модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Delar upp projektioner för prompt-prefill över Apple Neural Engine och Metal GPU för täta Qwen-modeller på Apple Silicon M4 eller senare. Auto aktiverar delningen när det stöds. Träder i kraft vid nästa modellinläsning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Silicon M4 veya sonraki sürümlerdeki yoğun Qwen modelleri için komut ön doldurma projeksiyonlarını Apple Neural Engine ve Metal GPU arasında böler. Otomatik desteklendiğinde bölmeyi etkinleştirir. Bir sonraki model yüklemesinde geçerli olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Розподіляє проекції префілу підказки між Apple Neural Engine та Metal GPU для щільних моделей Qwen на Apple Silicon M4 або новіших версіях. Автоматичний режим активує розподіл за підтримки. Набирає чинності під час наступного завантаження моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phân chia các phép chiếu prefill của lời nhắc giữa Apple Neural Engine và GPU Metal cho các mô hình Qwen dày đặc trên Apple Silicon M4 trở lên. Tự động bật tính năng phân chia khi được hỗ trợ. Có hiệu lực vào lần tải mô hình tiếp theo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Silicon M4 或更高版本上，将密集 Qwen 模型的提示词预填充投影切分到 Apple Neural Engine 和 Metal GPU。自动模式将在受支持时启用切分。在下次加载模型时生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Silicon M4 或更高版本上，將密集 Qwen 模型的提示詞預填充投影分割到 Apple Neural Engine 和 Metal GPU。自動模式會在受支援時啟用分割。在下次載入模型時生效。"
          }
        }
      }
    },
