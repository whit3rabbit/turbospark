    "Optional raw HTTP text. Kept in memory, truncated, cleared on restart.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u0635 HTTP \u062e\u0627\u0645 \u0627\u062e\u062a\u064a\u0627\u0631\u064a. \u064a\u064f\u062d\u0641\u0638 \u0641\u064a \u0627\u0644\u0630\u0627\u0643\u0631\u0629 \u0648\u064a\u064f\u0642\u062a\u0637\u0639 \u0648\u064a\u064f\u0645\u0633\u062d \u0639\u0646\u062f \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u0634\u063a\u064a\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionaler HTTP-Rohtext. Im Speicher gehalten, gek\u00fcrzt und beim Neustart gel\u00f6scht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional raw HTTP text. Kept in memory, truncated, cleared on restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto HTTP sin procesar opcional. Se guarda en memoria, se trunca y se borra al reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte HTTP brut facultatif. Conserv\u00e9 en m\u00e9moire, tronqu\u00e9 et effac\u00e9 au red\u00e9marrage."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05e7\u05e1\u05d8 HTTP \u05d2\u05d5\u05dc\u05de\u05d9 \u05d0\u05d5\u05e4\u05e6\u05d9\u05d5\u05e0\u05dc\u05d9. \u05e0\u05e9\u05de\u05e8 \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df, \u05e0\u05d7\u05ea\u05da \u05d5\u05e0\u05de\u05d7\u05e7 \u05d1\u05d4\u05e4\u05e2\u05dc\u05d4 \u05de\u05d7\u05d3\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0948\u0915\u0932\u094d\u092a\u093f\u0915 \u0915\u091a\u094d\u091a\u093e HTTP \u091f\u0947\u0915\u094d\u0938\u094d\u091f\u0964 \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u0947\u0902 \u0930\u0916\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u0915\u093e\u091f\u093e \u091c\u093e\u0924\u093e \u0939\u0948 \u0914\u0930 \u0930\u0940\u0938\u094d\u091f\u093e\u0930\u094d\u091f \u092a\u0930 \u092e\u093f\u091f \u091c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks HTTP mentah opsional. Disimpan di memori, dipotong, dan dihapus saat mulai ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo HTTP grezzo facoltativo. Conservato in memoria, troncato e cancellato al riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4efb\u610f\u306e\u751fHTTP\u30c6\u30ad\u30b9\u30c8\u3002\u30e1\u30e2\u30ea\u5185\u306b\u4fdd\u5b58\u3055\u308c\u3001\u5207\u308a\u8a70\u3081\u3089\u308c\u3001\u518d\u8d77\u52d5\u6642\u306b\u6d88\u53bb\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\uc801 \uc6d0\uc2dc HTTP \ud14d\uc2a4\ud2b8\uc785\ub2c8\ub2e4. \uba54\ubaa8\ub9ac\uc5d0 \ubcf4\uad00\ub418\uba70 \uc798\ub9ac\uace0 \uc7ac\uc2dc\uc791 \uc2dc \uc0ad\uc81c\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionele ruwe HTTP-tekst. In het geheugen bewaard, ingekort en gewist bij herstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalny surowy tekst HTTP. Przechowywany w pami\u0119ci, skracany i usuwany po ponownym uruchomieniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto HTTP bruto opcional. Mantido na mem\u00f3ria, truncado e apagado ao reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u0438\u0441\u0445\u043e\u0434\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 HTTP. \u0425\u0440\u0430\u043d\u0438\u0442\u0441\u044f \u0432 \u043f\u0430\u043c\u044f\u0442\u0438, \u043e\u0431\u0440\u0435\u0437\u0430\u0435\u0442\u0441\u044f \u0438 \u043e\u0447\u0438\u0449\u0430\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfri r\u00e5 HTTP-text. Sparas i minnet, kortas av och rensas vid omstart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130ste\u011fe ba\u011fl\u0131 ham HTTP metni. Bellekte tutulur, k\u0131salt\u0131l\u0131r ve yeniden ba\u015flatmada silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043e\u0431\u043e\u0432\u2019\u044f\u0437\u043a\u043e\u0432\u0438\u0439 \u0441\u0438\u0440\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 HTTP. \u0417\u0431\u0435\u0440\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0432 \u043f\u0430\u043c\u2019\u044f\u0442\u0456, \u043e\u0431\u0440\u0456\u0437\u0430\u0454\u0442\u044c\u0441\u044f \u0439 \u043e\u0447\u0438\u0449\u0430\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u043f\u0435\u0440\u0435\u0437\u0430\u043f\u0443\u0441\u043a\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u0103n b\u1ea3n HTTP th\u00f4 t\u00f9y ch\u1ecdn. L\u01b0u trong b\u1ed9 nh\u1edb, b\u1ecb c\u1eaft ng\u1eafn v\u00e0 x\u00f3a khi kh\u1edfi \u0111\u1ed9ng l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u9009\u7684\u539f\u59cb HTTP \u6587\u672c\u3002\u4fdd\u5b58\u5728\u5185\u5b58\u4e2d\uff0c\u4f1a\u88ab\u622a\u65ad\uff0c\u91cd\u542f\u540e\u6e05\u9664\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53ef\u9078\u7684\u539f\u59cb HTTP \u6587\u5b57\u3002\u4fdd\u5b58\u5728\u8a18\u61b6\u9ad4\u4e2d\uff0c\u6703\u88ab\u622a\u65b7\uff0c\u91cd\u65b0\u555f\u52d5\u5f8c\u6e05\u9664\u3002"
          }
        }
      }
    },
