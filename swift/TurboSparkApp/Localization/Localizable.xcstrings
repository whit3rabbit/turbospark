        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5217\u51fa\u6b64\u4ed3\u5e93\u53d1\u5e03\u7684 .gguf \u6587\u4ef6"
          }
        },
        "zh-Hant": {
