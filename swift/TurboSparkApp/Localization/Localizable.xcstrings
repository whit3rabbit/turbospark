    "The image is no longer at its written path.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تعد الصورة في المسار الذي كُتبت فيه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bild liegt nicht mehr am Pfad, an den es geschrieben wurde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The image is no longer at its written path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La imagen ya no está en la ruta donde se escribió."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
