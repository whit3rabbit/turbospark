    "Serve your loaded models over HTTP to any app on this machine.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قدّم نماذجك المحمّلة عبر HTTP لأي تطبيق على هذا الجهاز."
          }
        },
