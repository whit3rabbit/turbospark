    "No recorded usage yet. Tokens are counted from the model's own per-turn totals as turns complete.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد استخدام مسجل بعد. تُحسب الرموز من إجماليات النموذج لكل دور عند اكتمال الأدوار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine erfasste Nutzung. Token werden aus den eigenen Summen des Modells pro Zug gezählt, sobald Züge abgeschlossen sind."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No recorded usage yet. Tokens are counted from the model's own per-turn totals as turns complete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay uso registrado. Los tokens se cuentan a partir de los totales por turno del propio modelo a medida que los turnos terminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune utilisation enregistrée pour l'instant. Les jetons sont comptés à partir des totaux par tour du modèle lui-même, à mesure que les tours se terminent."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין עדיין שימוש מתועד. אסימונים נספרים מתוך הסכומים של המודל עצמו לכל תור, ככל שתורות מסתיימים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तक कोई उपयोग दर्ज नहीं। टर्न पूरे होने पर टोकन मॉडल के अपने प्रति-टर्न कुल से गिने जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ada penggunaan tercatat. Token dihitung dari total per giliran milik model saat giliran selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun utilizzo registrato finora. I token vengono conteggiati dai totali per turno del modello stesso, man mano che i turni si completano."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "記録された使用状況はまだありません。トークンは、ターンが完了するたびにモデル自身のターンごとの合計から集計されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 기록된 사용량이 없습니다. 토큰은 턴이 완료될 때마다 모델 자체의 턴별 합계에서 집계됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen geregistreerd gebruik. Tokens worden geteld op basis van de eigen totalen per beurt van het model, zodra beurten zijn afgerond."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak zarejestrowanego użycia. Tokeny są liczone na podstawie własnych sum modelu na turę, w miarę kończenia tur."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há uso registrado. Os tokens são contados a partir dos totais por turno do próprio modelo, conforme os turnos terminam."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использование пока не зафиксировано. Токены считаются по собственным итогам модели за ход, по мере завершения ходов."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen registrerad användning än. Token räknas utifrån modellens egna summor per tur, allteftersom turerna slutförs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz kaydedilmiş kullanım yok. Belirteçler, turlar tamamlandıkça modelin kendi tur başına toplamlarından sayılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Записаного використання поки немає. Токени рахуються за власними підсумками моделі за хід, у міру завершення ходів."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa có dữ liệu sử dụng. Token được đếm từ tổng theo lượt của chính mô hình khi mỗi lượt kết thúc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚无使用记录。令牌是在每一轮完成时，按模型自身的单轮总量统计的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚無使用記錄。權杖是在每一回合完成時，依模型自身的單回合總量統計的。"
          }
        }
      }
    },
