            "value": "Analizza la radice del progetto alla ricerca delle configurazioni .mcp.json, opencode.json, .cursor, .vscode e .agents."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica a raiz do projeto em busca das configurações .mcp.json, opencode.json, .cursor, .vscode e .agents."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканирует корень проекта на наличие конфигураций .mcp.json, opencode.json, .cursor, .vscode и .agents."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトルートから .mcp.json、opencode.json、.cursor、.vscode、.agents の構成をスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 루트에서 .mcp.json, opencode.json, .cursor, .vscode, .agents 구성을 검색합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描项目根目录中的 .mcp.json、opencode.json、.cursor、.vscode 和 .agents 配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "掃描專案根目錄中的 .mcp.json、opencode.json、.cursor、.vscode 與 .agents 組態。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفحص جذر المشروع بحثا عن إعدادات ‎.mcp.json وopencode.json و‎.cursor و‎.vscode و‎.agents."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סורק את שורש הפרויקט לאיתור תצורות ‎.mcp.json, ‏opencode.json, ‏.cursor, ‏.vscode ו-‎.agents."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट रूट में .mcp.json, opencode.json, .cursor, .vscode और .agents कॉन्फ़िग स्कैन करता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scant de projecthoofdmap op de configuraties .mcp.json, opencode.json, .cursor, .vscode en .agents."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skanuje katalog główny projektu w poszukiwaniu konfiguracji .mcp.json, opencode.json, .cursor, .vscode i .agents."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje kökünü .mcp.json, opencode.json, .cursor, .vscode ve .agents yapılandırmaları için tarar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканує корінь проєкту на наявність конфігурацій .mcp.json, opencode.json, .cursor, .vscode та .agents."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Söker igenom projektets rotkatalog efter konfigurationerna .mcp.json, opencode.json, .cursor, .vscode och .agents."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét thư mục gốc dự án để tìm cấu hình .mcp.json, opencode.json, .cursor, .vscode và .agents."
          }
        },
        "id": {
