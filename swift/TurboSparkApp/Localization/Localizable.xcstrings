    "thermalforge %@ failed. Is the ThermalForge daemon running? Install it once with: sudo thermalforge install": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل thermalforge %@. هل البرنامج الخفي ThermalForge قيد التشغيل؟ ثبّته مرة واحدة باستخدام: sudo thermalforge install"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ ist fehlgeschlagen. Läuft der ThermalForge-Daemon? Installieren Sie ihn einmalig mit: sudo thermalforge install"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ failed. Is the ThermalForge daemon running? Install it once with: sudo thermalforge install"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ falló. ¿Se está ejecutando el daemon de ThermalForge? Instálalo una vez con: sudo thermalforge install"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ a échoué. Le daemon ThermalForge est-il en cours d'exécution ? Installez-le une fois avec : sudo thermalforge install"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ נכשל. האם ה-daemon של ThermalForge פועל? התקן אותו פעם אחת באמצעות: sudo thermalforge install"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ विफल रहा। क्या ThermalForge डेमन चल रहा है? इसे एक बार इस कमांड से इंस्टॉल करें: sudo thermalforge install"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ gagal. Apakah daemon ThermalForge sedang berjalan? Instal sekali dengan: sudo thermalforge install"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ non riuscito. Il daemon ThermalForge è in esecuzione? Installalo una volta con: sudo thermalforge install"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ に失敗しました。ThermalForge デーモンは実行中ですか？ 次のコマンドで一度インストールしてください: sudo thermalforge install"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ 실패. ThermalForge 데몬이 실행 중인가요? 다음 명령으로 한 번 설치하세요: sudo thermalforge install"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ is mislukt. Draait de ThermalForge-daemon? Installeer hem eenmalig met: sudo thermalforge install"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ nie powiodło się. Czy demon ThermalForge działa? Zainstaluj go jednorazowo poleceniem: sudo thermalforge install"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ falhou. O daemon do ThermalForge está em execução? Instale-o uma vez com: sudo thermalforge install"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда thermalforge %@ завершилась с ошибкой. Запущен ли демон ThermalForge? Установите его один раз командой: sudo thermalforge install"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ misslyckades. Körs ThermalForge-daemonen? Installera den en gång med: sudo thermalforge install"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ başarısız oldu. ThermalForge arka plan hizmeti çalışıyor mu? Bir kez şu komutla kurun: sudo thermalforge install"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Команда thermalforge %@ завершилася з помилкою. Чи запущено демон ThermalForge? Встановіть його один раз командою: sudo thermalforge install"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ thất bại. Daemon ThermalForge có đang chạy không? Cài đặt một lần bằng: sudo thermalforge install"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ 失败。ThermalForge 守护进程是否在运行？请运行以下命令安装一次：sudo thermalforge install"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "thermalforge %@ 失敗。ThermalForge 常駐程式是否正在執行？請執行以下指令安裝一次：sudo thermalforge install"
          }
        }
      }
    },
