    "TurboSpark could not identify that drive. Choose a drive that is connected directly to this Mac.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على TurboSpark التعرف على محرك الأقراص هذا. اختر محرك أقراص متصلًا مباشرةً بهذا الـ Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
