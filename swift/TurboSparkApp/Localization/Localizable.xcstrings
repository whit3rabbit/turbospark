    "Keep the drives connected until the move finishes.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبقِ محركات الأقراص متصلة حتى تنتهي عملية النقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lassen Sie die Laufwerke verbunden, bis der Vorgang abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the drives connected until the move finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén las unidades conectadas hasta que termine el movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les lecteurs connectés jusqu'à la fin du déplacement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השאר את הכוננים מחוברים עד שההעברה תסתיים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्थानांतरण पूरा होने तक ड्राइव कनेक्ट रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Biarkan drive tetap terhubung hingga pemindahan selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni collegate le unità finché lo spostamento non è terminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "移動が完了するまで、ドライブを接続したままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이동이 끝날 때까지 드라이브를 연결해 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat de schijven aangesloten totdat het verplaatsen klaar is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie odłączaj dysków, dopóki przenoszenie się nie zakończy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
