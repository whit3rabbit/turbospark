    "The model reads up to 8,192 tokens at a time. Longer drafts are rewritten in parts at paragraph breaks.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model reads up to 8,192 tokens at a time. Longer drafts are rewritten in parts at paragraph breaks."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقرأ النموذج حتى 8,192 رمزًا في المرة الواحدة. تُعاد صياغة المسودات الأطول على أجزاء عند فواصل الفقرات."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell liest bis zu 8.192 Token auf einmal. Längere Entwürfe werden an Absatzgrenzen in Teilen umgeschrieben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo lee hasta 8.192 tokens a la vez. Los borradores más largos se reescriben por partes en los saltos de párrafo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modèle lit jusqu'à 8 192 jetons à la fois. Les brouillons plus longs sont réécrits par parties, aux sauts de paragraphe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המודל קורא עד 8,192 אסימונים בכל פעם. טיוטות ארוכות יותר משוכתבות בחלקים, במעברי פסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल एक बार में 8,192 टोकन तक पढ़ता है। लंबे ड्राफ़्ट अनुच्छेद विरामों पर भागों में दोबारा लिखे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model membaca hingga 8.192 token sekaligus. Draf yang lebih panjang ditulis ulang per bagian pada batas paragraf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello legge fino a 8.192 token alla volta. Le bozze più lunghe vengono riscritte in parti, alle interruzioni di paragrafo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルが一度に読めるのは最大 8,192 トークンです。長い下書きは段落の区切りで分割して書き直します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델은 한 번에 최대 8,192개의 토큰을 읽습니다. 더 긴 초안은 문단 구분에서 나누어 다시 씁니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model leest maximaal 8.192 tokens tegelijk. Langere concepten worden in delen herschreven, bij alinea-overgangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model czyta jednorazowo do 8192 tokenów. Dłuższe wersje robocze są przepisywane w częściach, na granicach akapitów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo lê até 8.192 tokens por vez. Rascunhos mais longos são reescritos em partes, nas quebras de parágrafo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель читает до 8192 токенов за раз. Более длинные черновики переписываются по частям, с разбиением по абзацам."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen läser upp till 8 192 token åt gången. Längre utkast skrivs om i delar vid styckebrytningar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model tek seferde en fazla 8.192 token okur. Daha uzun taslaklar paragraf sonlarından bölünerek parça parça yeniden yazılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель читає до 8192 токенів за раз. Довші чернетки переписуються частинами, з поділом за абзацами."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình đọc tối đa 8.192 token mỗi lần. Bản nháp dài hơn được viết lại theo từng phần tại các chỗ ngắt đoạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型一次最多读取 8,192 个 token。较长的草稿会在段落分隔处拆分后分段改写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型一次最多讀取 8,192 個 token。較長的草稿會在段落分隔處拆分後分段改寫。"
          }
        }
      }
    },
