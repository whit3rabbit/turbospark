        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 h\u1ebft s\u1ed1 l\u1ea7n th\u1eed l\u1ea1i \u0111\u1ec3 kh\u00f4i ph\u1ee5c. Gi\u1edbi h\u1ea1n: %lld l\u1ea7n."
