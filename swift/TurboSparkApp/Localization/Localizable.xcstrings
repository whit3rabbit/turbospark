        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricorda questa chiave nel Portachiavi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30ad\u30fc\u3092\u30ad\u30fc\u30c1\u30a7\u30fc\u30f3\u306b\u8a18\u61b6"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud0a4\ub97c \ud0a4\uccb4\uc778\uc5d0 \uae30\uc5b5"
          }
        },
        "nl": {
          "stringUnit": {
