    "Opens a chat with a scheduling request for you to finish and send": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0641\u062a\u062d \u0645\u062d\u0627\u062f\u062b\u0629 \u0641\u064a\u0647\u0627 \u0637\u0644\u0628 \u062c\u062f\u0648\u0644\u0629 \u0644\u062a\u0643\u0645\u0644\u0647 \u0648\u062a\u0631\u0633\u0644\u0647"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ffnet einen Chat mit einer Planungsanfrage, die Sie erg\u00e4nzen und senden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens a chat with a scheduling request for you to finish and send"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre un chat con una solicitud de programaci\u00f3n para que la completes y la env\u00edes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre une discussion avec une demande de planification \u00e0 compl\u00e9ter et envoyer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05d5\u05ea\u05d7 \u05e6'\u05d0\u05d8 \u05e2\u05dd \u05d1\u05e7\u05e9\u05ea \u05ea\u05d6\u05de\u05d5\u05df \u05e9\u05ea\u05e9\u05dc\u05d9\u05dd \u05d5\u05ea\u05e9\u05dc\u05d7"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0947\u0921\u094d\u092f\u0942\u0932 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0932\u0947\u0915\u0930 \u090f\u0915 \u091a\u0948\u091f \u0916\u094b\u0932\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0947 \u0906\u092a \u092a\u0942\u0930\u093e \u0915\u0930\u0915\u0947 \u092d\u0947\u091c\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka obrolan berisi permintaan penjadwalan untuk Anda lengkapi dan kirim"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre una chat con una richiesta di pianificazione da completare e inviare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b9\u30b1\u30b8\u30e5\u30fc\u30eb\u306e\u4f9d\u983c\u6587\u3092\u5165\u308c\u305f\u30c1\u30e3\u30c3\u30c8\u3092\u958b\u304d\u307e\u3059\u3002\u5b8c\u6210\u3055\u305b\u3066\u9001\u4fe1\u3057\u3066\u304f\u3060\u3055\u3044"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc608\uc57d \uc694\uccad\uc774 \ub2f4\uae34 \ub300\ud654\ub97c \uc5fd\ub2c8\ub2e4. \uc9c1\uc811 \uc644\uc131\ud574\uc11c \ubcf4\ub0b4\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent een chat met een planningsverzoek dat je zelf afmaakt en verstuurt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera czat z pro\u015bb\u0105 o zaplanowanie, kt\u00f3r\u0105 uzupe\u0142niasz i wysy\u0142asz"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um chat com um pedido de agendamento para voc\u00ea completar e enviar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u044b\u0432\u0430\u0435\u0442 \u0447\u0430\u0442 \u0441 \u0437\u0430\u043f\u0440\u043e\u0441\u043e\u043c \u043d\u0430 \u043f\u043b\u0430\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0443\u0436\u043d\u043e \u0434\u043e\u043f\u0438\u0441\u0430\u0442\u044c \u0438 \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ppnar en chatt med en schemal\u00e4ggningsbeg\u00e4ran som du g\u00f6r klar och skickar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tamamlay\u0131p g\u00f6ndermeniz i\u00e7in bir zamanlama iste\u011fiyle sohbet a\u00e7ar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043a\u0440\u0438\u0432\u0430\u0454 \u0447\u0430\u0442 \u0456\u0437 \u0437\u0430\u043f\u0438\u0442\u043e\u043c \u043d\u0430 \u043f\u043b\u0430\u043d\u0443\u0432\u0430\u043d\u043d\u044f, \u044f\u043a\u0438\u0439 \u0442\u0440\u0435\u0431\u0430 \u0434\u043e\u043f\u0438\u0441\u0430\u0442\u0438 \u0439 \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1edf cu\u1ed9c tr\u00f2 chuy\u1ec7n c\u00f3 s\u1eb5n y\u00eau c\u1ea7u l\u00ean l\u1ecbch \u0111\u1ec3 b\u1ea1n ho\u00e0n thi\u1ec7n v\u00e0 g\u1eedi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6253\u5f00\u4e00\u4e2a\u5e26\u6709\u6392\u7a0b\u8bf7\u6c42\u7684\u5bf9\u8bdd\uff0c\u7531\u4f60\u8865\u5168\u5e76\u53d1\u9001"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u958b\u555f\u4e00\u500b\u5e36\u6709\u6392\u7a0b\u8acb\u6c42\u7684\u5c0d\u8a71\uff0c\u7531\u4f60\u88dc\u5b8c\u4e26\u9001\u51fa"
          }
        }
      }
    },
