        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u091c\u094d\u091e\u093e\u0924 \u092a\u094d\u0930\u0926\u093e\u0924\u093e \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u0947\u0964"
