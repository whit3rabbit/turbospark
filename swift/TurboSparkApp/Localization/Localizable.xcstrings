    "Optional raw HTTP text. Kept in memory, truncated, cleared on restart.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional raw HTTP text. Kept in memory, truncated, cleared on restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto HTTP sin procesar opcional. Se guarda en memoria, se trunca y se borra al reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Texte HTTP brut facultatif. Conservé en mémoire, tronqué et effacé au redémarrage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionaler HTTP-Rohtext. Im Speicher gehalten, gekürzt und beim Neustart gelöscht."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Testo HTTP grezzo facoltativo. Conservato in memoria, troncato e cancellato al riavvio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Texto HTTP bruto opcional. Mantido na memória, truncado e apagado ao reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Необязательный исходный текст HTTP. Хранится в памяти, обрезается и очищается при перезапуске."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "任意の生HTTPテキスト。メモリ内に保存され、切り詰められ、再起動時に消去されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택적 원시 HTTP 텍스트입니다. 메모리에 보관되며 잘리고 재시작 시 삭제됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选的原始 HTTP 文本。保存在内存中，会被截断，重启后清除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可選的原始 HTTP 文字。保存在記憶體中，會被截斷，重新啟動後清除。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نص HTTP خام اختياري. يُحفظ في الذاكرة ويُقتطع ويُمسح عند إعادة التشغيل."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טקסט HTTP גולמי אופציונלי. נשמר בזיכרון, נחתך ונמחק בהפעלה מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक कच्चा HTTP टेक्स्ट। मेमोरी में रखा जाता है, काटा जाता है और रीस्टार्ट पर मिट जाता है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optionele ruwe HTTP-tekst. In het geheugen bewaard, ingekort en gewist bij herstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalny surowy tekst HTTP. Przechowywany w pamięci, skracany i usuwany po ponownym uruchomieniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı ham HTTP metni. Bellekte tutulur, kısaltılır ve yeniden başlatmada silinir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Необов’язковий сирий текст HTTP. Зберігається в пам’яті, обрізається й очищається після перезапуску."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valfri rå HTTP-text. Sparas i minnet, kortas av och rensas vid omstart."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Văn bản HTTP thô tùy chọn. Lưu trong bộ nhớ, bị cắt ngắn và xóa khi khởi động lại."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Teks HTTP mentah opsional. Disimpan di memori, dipotong, dan dihapus saat mulai ulang."
          }
        }
      }
    },
