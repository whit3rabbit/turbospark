    "Project \"%@\" declares MCP servers in its config files.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعلن المشروع \"%@\" عن خوادم MCP في ملفات التكوين الخاصة به."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt „%@“ deklariert MCP-Server in seinen Konfigurationsdateien."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project \"%@\" declares MCP servers in its config files."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El proyecto \"%@\" declara servidores MCP en sus archivos de configuración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le projet « %@ » déclare des serveurs MCP dans ses fichiers de configuration."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרויקט \"%@\" מצהיר על שרתי MCP בקובצי התצורה שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परियोजना \"%@\" अपनी कॉन्फ़िगरेशन फ़ाइलों में MCP सर्वर घोषित करती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proyek \"%@\" mendeklarasikan server MCP dalam file konfigurasinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il progetto \"%@\" dichiara server MCP nei relativi file di configurazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト「%@」は設定ファイルで MCP サーバーを宣言しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 \"%@\"이(가) 구성 파일에서 MCP 서버를 선언합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Project \"%@\" declareert MCP-servers in de configuratiebestanden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt „%@” deklaruje serwery MCP w plikach konfiguracyjnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O projeto \"%@\" declara servidores MCP em seus arquivos de configuração."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проект «%@» объявляет серверы MCP в своих файлах конфигурации."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektet \"%@\" deklarerar MCP-servrar i sina konfigurationsfiler."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" projesi, yapılandırma dosyalarında MCP sunucularını bildiriyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проект «%@» оголошує сервери MCP у своїх файлах конфігурації."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dự án \"%@\" khai báo các máy chủ MCP trong tệp cấu hình của nó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目“%@”在其配置文件中声明了 MCP 服务器。"
          }
