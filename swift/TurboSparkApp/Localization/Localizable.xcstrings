    "Automatic (engine, then Apple on device)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0644\u0642\u0627\u0626\u064a (\u0627\u0644\u0645\u062d\u0631\u0643\u060c \u062b\u0645 Apple \u0639\u0644\u0649 \u0627\u0644\u062c\u0647\u0627\u0632)"
