    "Archive this chat (or /unarchive to restore)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0631\u0634\u0641\u0629 \u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 (\u0623\u0648 /unarchive \u0644\u0644\u0627\u0633\u062a\u0639\u0627\u062f\u0629)"
          }
