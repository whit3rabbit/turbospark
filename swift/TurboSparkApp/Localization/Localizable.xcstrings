    "No Chrome profiles with bookmarks found.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0645\u0644\u0641\u0627\u062a Chrome \u062a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u0625\u0634\u0627\u0631\u0627\u062a \u0645\u0631\u062c\u0639\u064a\u0629."
