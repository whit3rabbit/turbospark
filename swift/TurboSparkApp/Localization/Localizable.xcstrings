            "value": "इस मॉडल को स्थानांतरित करने के लिए कोई दूसरी लाइब्रेरी कनेक्ट नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada pustaka lain yang terhubung untuk memindahkan model ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è nessun'altra libreria collegata in cui spostare questo modello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルの移動先にできる、接続済みの別のライブラリがありません。"
