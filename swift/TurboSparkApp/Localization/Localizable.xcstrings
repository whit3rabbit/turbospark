            "value": "\u00c2ncora de recupera\u00e7\u00e3o registrada. Mensagens mantidas: %lld, novas tentativas usadas: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u043e\u0447\u043a\u0430 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u0430. \u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043e \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0439: %lld, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u043e\u0432: %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fa9\u65e7\u30a2\u30f3\u30ab\u30fc\u3092\u8a18\u9332\u3057\u307e\u3057\u305f\u3002\u4fdd\u6301\u3057\u305f\u30e1\u30c3\u30bb\u30fc\u30b8: %lld\u3001\u4f7f\u7528\u6e08\u307f\u518d\u8a66\u884c: %lld\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcf5\uad6c \uae30\uc900\uc810\uc744 \uae30\ub85d\ud588\uc2b5\ub2c8\ub2e4. \ubcf4\uc874\ub41c \uba54\uc2dc\uc9c0: %lld, \uc0ac\uc6a9\ud55c \uc7ac\uc2dc\ub3c4: %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8bb0\u5f55\u6062\u590d\u951a\u70b9\u3002\u4fdd\u7559\u7684\u6d88\u606f\uff1a%lld\uff0c\u5df2\u7528\u91cd\u8bd5\u6b21\u6570\uff1a%lld\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u8a18\u9304\u5fa9\u539f\u9328\u9ede\u3002\u4fdd\u7559\u7684\u8a0a\u606f\uff1a%lld\uff0c\u5df2\u7528\u91cd\u8a66\u6b21\u6578\uff1a%lld\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u062a\u0633\u062c\u064a\u0644 \u0646\u0642\u0637\u0629 \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f. \u0627\u0644\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0645\u062d\u062a\u0641\u0638 \u0628\u0647\u0627: %lld\u060c \u0645\u0631\u0627\u062a \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629: %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u090f\u0902\u0915\u0930 \u0926\u0930\u094d\u091c \u0915\u093f\u092f\u093e \u0917\u092f\u093e\u0964 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0938\u0902\u0926\u0947\u0936: %lld, \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u0917\u090f \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938: %lld."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelpunt vastgelegd. Behouden berichten: %lld, gebruikte nieuwe pogingen: %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisano punkt odzyskiwania. Zachowane wiadomo\u015bci: %lld, u\u017cyte ponowienia: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma ba\u011flant\u0131 noktas\u0131 kaydedildi. Korunan iletiler: %lld, kullan\u0131lan yeniden denemeler: %lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0422\u043e\u0447\u043a\u0443 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0437\u0430\u043f\u0438\u0441\u0430\u043d\u043e. \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u043e \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u044c: %lld, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043e \u043f\u043e\u0432\u0442\u043e\u0440\u0456\u0432: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5terst\u00e4llningsankare registrerat. Bevarade meddelanden: %lld, anv\u00e4nda omf\u00f6rs\u00f6k: %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 ghi nh\u1eadn m\u1ed1c kh\u00f4i ph\u1ee5c. S\u1ed1 tin nh\u1eafn gi\u1eef l\u1ea1i: %lld, s\u1ed1 l\u1ea7n th\u1eed l\u1ea1i \u0111\u00e3 d\u00f9ng: %lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penanda pemulihan dicatat. Pesan yang dipertahankan: %lld, percobaan ulang yang digunakan: %lld."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05e7\u05d5\u05d3\u05ea \u05d4\u05e9\u05d7\u05d6\u05d5\u05e8 \u05e0\u05e8\u05e9\u05de\u05d4. \u05d4\u05d5\u05d3\u05e2\u05d5\u05ea \u05e9\u05e0\u05e9\u05de\u05e8\u05d5: %lld, \u05e0\u05d9\u05e1\u05d9\u05d5\u05e0\u05d5\u05ea \u05d7\u05d5\u05d6\u05e8\u05d9\u05dd \u05e9\u05e0\u05d5\u05e6\u05dc\u05d5: %lld."
          }
        }
      }
    },
    "Recovery conflict: the saved partial response no longer matches the transcript.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery conflict: the saved partial response no longer matches the transcript."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflicto de recuperaci\u00f3n: la respuesta parcial guardada ya no coincide con la transcripci\u00f3n."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflit de r\u00e9cup\u00e9ration : la r\u00e9ponse partielle enregistr\u00e9e ne correspond plus \u00e0 la transcription."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungskonflikt: Die gespeicherte Teilantwort stimmt nicht mehr mit dem Transkript \u00fcberein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflitto di ripristino: la risposta parziale salvata non corrisponde pi\u00f9 alla trascrizione."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conflito de recupera\u00e7\u00e3o: a resposta parcial salva n\u00e3o corresponde mais \u00e0 transcri\u00e7\u00e3o."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043d\u0444\u043b\u0438\u043a\u0442 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f: \u0441\u043e\u0445\u0440\u0430\u043d\u0451\u043d\u043d\u044b\u0439 \u0447\u0430\u0441\u0442\u0438\u0447\u043d\u044b\u0439 \u043e\u0442\u0432\u0435\u0442 \u0431\u043e\u043b\u044c\u0448\u0435 \u043d\u0435 \u0441\u043e\u0432\u043f\u0430\u0434\u0430\u0435\u0442 \u0441 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u043e\u0439."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fa9\u65e7\u306e\u7af6\u5408: \u4fdd\u5b58\u3055\u308c\u305f\u90e8\u5206\u5fdc\u7b54\u304c\u30c8\u30e9\u30f3\u30b9\u30af\u30ea\u30d7\u30c8\u3068\u4e00\u81f4\u3057\u306a\u304f\u306a\u308a\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcf5\uad6c \ucda9\ub3cc: \uc800\uc7a5\ub41c \ubd80\ubd84 \uc751\ub2f5\uc774 \ub354 \uc774\uc0c1 \ub300\ud654 \uae30\ub85d\uacfc \uc77c\uce58\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6062\u590d\u51b2\u7a81\uff1a\u5df2\u4fdd\u5b58\u7684\u90e8\u5206\u56de\u590d\u4e0e\u5bf9\u8bdd\u8bb0\u5f55\u4e0d\u518d\u5339\u914d\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fa9\u539f\u885d\u7a81\uff1a\u5df2\u5132\u5b58\u7684\u90e8\u5206\u56de\u8986\u4e0d\u518d\u7b26\u5408\u9010\u5b57\u7a3f\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0627\u0631\u0636 \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f: \u0644\u0645 \u064a\u0639\u062f \u0627\u0644\u0631\u062f \u0627\u0644\u062c\u0632\u0626\u064a \u0627\u0644\u0645\u062d\u0641\u0648\u0638 \u0645\u0637\u0627\u0628\u0642\u064b\u0627 \u0644\u0644\u0646\u0635."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0935\u093f\u0935\u093e\u0926: \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0902\u0936\u093f\u0915 \u0909\u0924\u094d\u0924\u0930 \u0905\u092c \u091f\u094d\u0930\u093e\u0902\u0938\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u0938\u0947 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u093e\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelconflict: het opgeslagen gedeeltelijke antwoord komt niet meer overeen met het transcript."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflikt odzyskiwania: zapisana cz\u0119\u015bciowa odpowied\u017a nie pasuje ju\u017c do transkrypcji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma \u00e7ak\u0131\u015fmas\u0131: kaydedilen k\u0131smi yan\u0131t art\u0131k konu\u015fma d\u00f6k\u00fcm\u00fcyle e\u015fle\u015fmiyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u043d\u0444\u043b\u0456\u043a\u0442 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f: \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0430 \u0447\u0430\u0441\u0442\u043a\u043e\u0432\u0430 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u044c \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0437\u0431\u0456\u0433\u0430\u0454\u0442\u044c\u0441\u044f \u0437 \u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0442\u043e\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5terst\u00e4llningskonflikt: det sparade delsvaret st\u00e4mmer inte l\u00e4ngre med transkriptet."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xung \u0111\u1ed9t kh\u00f4i ph\u1ee5c: c\u00e2u tr\u1ea3 l\u1eddi m\u1ed9t ph\u1ea7n \u0111\u00e3 l\u01b0u kh\u00f4ng c\u00f2n kh\u1edbp v\u1edbi b\u1ea3n ghi h\u1ed9i tho\u1ea1i."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konflik pemulihan: sebagian respons yang tersimpan tidak lagi cocok dengan transkrip."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05ea\u05d9\u05e8\u05ea \u05e9\u05d7\u05d6\u05d5\u05e8: \u05d4\u05ea\u05d2\u05d5\u05d1\u05d4 \u05d4\u05d7\u05dc\u05e7\u05d9\u05ea \u05d4\u05e9\u05de\u05d5\u05e8\u05d4 \u05db\u05d1\u05e8 \u05dc\u05d0 \u05ea\u05d5\u05d0\u05de\u05ea \u05dc\u05ea\u05de\u05dc\u05d9\u05dc."
          }
        }
      }
    },
