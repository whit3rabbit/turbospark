    "Choose a name that identifies this chat.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0627\u0633\u0645\u0627 \u064a\u0639\u0631\u0651\u0641 \u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "W\u00e4hlen Sie einen Namen, der diesen Chat kennzeichnet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a name that identifies this chat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un nombre que identifique este chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un nom qui identifie cette discussion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05e9\u05dd \u05e9\u05d9\u05d6\u05d4\u05d4 \u05d0\u05ea \u05d4\u05e9\u05d9\u05d7\u05d4 \u05d4\u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0910\u0938\u093e \u0928\u093e\u092e \u091a\u0941\u0928\u0947\u0902 \u091c\u094b \u0907\u0938 \u091a\u0948\u091f \u0915\u0940 \u092a\u0939\u091a\u093e\u0928 \u092c\u0924\u093e\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih nama yang mengidentifikasi obrolan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un nome che identifichi questa chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30c1\u30e3\u30c3\u30c8\u3092\u8b58\u5225\u3067\u304d\u308b\u540d\u524d\u3092\u9078\u3093\u3067\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ub300\ud654\ub97c \uc2dd\ubcc4\ud560 \uc774\ub984\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een naam die deze chat identificeert."
