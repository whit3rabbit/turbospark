        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lisez les en-t\u00eates pour en d\u00e9terminer la taille : turbospark-model recommend --probe"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05e8\u05d0 \u05d0\u05ea \u05d4\u05db\u05d5\u05ea\u05e8\u05d5\u05ea \u05db\u05d3\u05d9 \u05dc\u05d7\u05e9\u05d1 \u05d0\u05ea \u05d2\u05d5\u05d3\u05dc\u05d5: turbospark-model recommend --probe"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938\u0915\u093e \u0906\u0915\u093e\u0930 \u091c\u093e\u0928\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0939\u0947\u0921\u0930 \u092a\u0922\u093c\u0947\u0902: turbospark-model recommend --probe"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Baca header untuk menghitung ukurannya: turbospark-model recommend --probe"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Leggi le intestazioni per dimensionarlo: turbospark-model recommend --probe"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b5\u30a4\u30ba\u3092\u7b97\u51fa\u3059\u308b\u306b\u306f\u30d8\u30c3\u30c0\u30fc\u3092\u8aad\u307f\u53d6\u308a\u307e\u3059: turbospark-model recommend --probe"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud06c\uae30\ub97c \uc0b0\uc815\ud558\ub824\uba74 \ud5e4\ub354\ub97c \uc77d\uc73c\uc138\uc694: turbospark-model recommend --probe"
