    "The downloaded file is not a control vector this engine can read: %@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0630\u064a \u062a\u0645 \u062a\u0646\u0632\u064a\u0644\u0647 \u0644\u064a\u0633 \u0645\u062a\u062c\u0647 \u062a\u062d\u0643\u0645 \u064a\u0645\u0643\u0646 \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u062d\u0631\u0643 \u0642\u0631\u0627\u0621\u062a\u0647: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die heruntergeladene Datei ist kein Steuervektor, den diese Engine lesen kann: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The downloaded file is not a control vector this engine can read: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo descargado no es un vector de control que este motor pueda leer: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier t\u00e9l\u00e9charg\u00e9 n'est pas un vecteur de contr\u00f4le lisible par ce moteur : %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e7\u05d5\u05d1\u05e5 \u05e9\u05d4\u05d5\u05e8\u05d3 \u05d0\u05d9\u05e0\u05d5 \u05d5\u05e7\u05d8\u05d5\u05e8 \u05d1\u05e7\u05e8\u05d4 \u05e9\u05de\u05e0\u05d5\u05e2 \u05d6\u05d4 \u05d9\u05db\u05d5\u05dc \u05dc\u05e7\u05e8\u05d5\u05d0: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0940 \u0917\u0908 \u092b\u093c\u093e\u0907\u0932 \u0910\u0938\u093e \u0915\u0902\u091f\u094d\u0930\u094b\u0932 \u0935\u0947\u0915\u094d\u091f\u0930 \u0928\u0939\u0940\u0902 \u0939\u0948 \u091c\u093f\u0938\u0947 \u092f\u0939 \u0907\u0902\u091c\u0928 \u092a\u0922\u093c \u0938\u0915\u0947: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File yang diunduh bukan vektor kontrol yang dapat dibaca mesin ini: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file scaricato non \u00e8 un vettore di controllo leggibile da questo motore: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c0\u30a6\u30f3\u30ed\u30fc\u30c9\u3057\u305f\u30d5\u30a1\u30a4\u30eb\u306f\u3001\u3053\u306e\u30a8\u30f3\u30b8\u30f3\u3067\u8aad\u307f\u8fbc\u3081\u308b\u5236\u5fa1\u30d9\u30af\u30c8\u30eb\u3067\u306f\u3042\u308a\u307e\u305b\u3093: %@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc6b4\ub85c\ub4dc\ud55c \ud30c\uc77c\uc740 \uc774 \uc5d4\uc9c4\uc774 \uc77d\uc744 \uc218 \uc788\ub294 \uc81c\uc5b4 \ubca1\ud130\uac00 \uc544\ub2d9\ub2c8\ub2e4: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het gedownloade bestand is geen stuurvector die deze engine kan lezen: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pobrany plik nie jest wektorem steruj\u0105cym, kt\u00f3ry ten silnik mo\u017ce odczyta\u0107: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo baixado n\u00e3o \u00e9 um vetor de controle que este mecanismo consiga ler: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u044b\u0439 \u0444\u0430\u0439\u043b \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u043c \u0432\u0435\u043a\u0442\u043e\u0440\u043e\u043c, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u044c \u044d\u0442\u043e\u0442 \u0434\u0432\u0438\u0436\u043e\u043a: %@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nedladdade filen \u00e4r inte en styrvektor som den h\u00e4r motorn kan l\u00e4sa: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0130ndirilen dosya bu motorun okuyabilece\u011fi bir kontrol vekt\u00f6r\u00fc de\u011fil: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u0438\u0439 \u0444\u0430\u0439\u043b \u043d\u0435 \u0454 \u043a\u0435\u0440\u0443\u0432\u0430\u043b\u044c\u043d\u0438\u043c \u0432\u0435\u043a\u0442\u043e\u0440\u043e\u043c, \u044f\u043a\u0438\u0439 \u043c\u043e\u0436\u0435 \u043f\u0440\u043e\u0447\u0438\u0442\u0430\u0442\u0438 \u0446\u0435\u0439 \u0440\u0443\u0448\u0456\u0439: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ec7p \u0111\u00e3 t\u1ea3i xu\u1ed1ng kh\u00f4ng ph\u1ea3i l\u00e0 vect\u01a1 \u0111i\u1ec1u khi\u1ec3n m\u00e0 c\u00f4ng c\u1ee5 n\u00e0y c\u00f3 th\u1ec3 \u0111\u1ecdc: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f7d\u7684\u6587\u4ef6\u4e0d\u662f\u6b64\u5f15\u64ce\u53ef\u8bfb\u53d6\u7684\u63a7\u5236\u5411\u91cf\uff1a%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u8f09\u7684\u6a94\u6848\u4e0d\u662f\u6b64\u5f15\u64ce\u53ef\u8b80\u53d6\u7684\u63a7\u5236\u5411\u91cf\uff1a%@"
          }
        }
      }
    },
    "This vector is %lld wide, but this model is %lld wide.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0631\u0636 \u0647\u0630\u0627 \u0627\u0644\u0645\u062a\u062c\u0647 %lld\u060c \u0644\u0643\u0646 \u0639\u0631\u0636 \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c %lld."
