    "Detected %@. These files are applied live to every project turn.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0645 \u0627\u0643\u062a\u0634\u0627\u0641 %@. \u062a\u064f\u0637\u0628\u064e\u0651\u0642 \u0647\u0630\u0647 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0645\u0628\u0627\u0634\u0631\u0629 \u0639\u0644\u0649 \u0643\u0644 \u062f\u0648\u0631 \u0641\u064a \u0627\u0644\u0645\u0634\u0631\u0648\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gefunden. Diese Dateien gelten live f\u00fcr jede Projektrunde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detected %@. These files are applied live to every project turn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se detect\u00f3 %@. Estos archivos se aplican en directo a cada turno del proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ d\u00e9tect\u00e9. Ces fichiers s'appliquent en direct \u00e0 chaque tour du projet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d6\u05d5\u05d4\u05d5: %@. \u05d4\u05e7\u05d1\u05e6\u05d9\u05dd \u05d4\u05d0\u05dc\u05d4 \u05de\u05d5\u05d7\u05dc\u05d9\u05dd \u05d1\u05d6\u05de\u05df \u05d0\u05de\u05ea \u05e2\u05dc \u05db\u05dc \u05ea\u05d5\u05e8 \u05d1\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u092e\u093f\u0932\u093e\u0964 \u092f\u0947 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0939\u0930 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u091a\u0930\u0923 \u092a\u0930 \u0938\u0940\u0927\u0947 \u0932\u093e\u0917\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terdeteksi %@. File ini diterapkan langsung ke setiap giliran proyek."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rilevato %@. Questi file vengono applicati in tempo reale a ogni turno del progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u3092\u691c\u51fa\u3057\u307e\u3057\u305f\u3002\u3053\u308c\u3089\u306e\u30d5\u30a1\u30a4\u30eb\u306f\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u306e\u5404\u30bf\u30fc\u30f3\u306b\u968f\u6642\u9069\u7528\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uc744(\ub97c) \ucc3e\uc558\uc2b5\ub2c8\ub2e4. \uc774 \ud30c\uc77c\uc740 \ud504\ub85c\uc81d\ud2b8\uc758 \ubaa8\ub4e0 \ud134\uc5d0 \uc2e4\uc2dc\uac04\uc73c\ub85c \uc801\uc6a9\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gevonden. Deze bestanden gelden live voor elke projectbeurt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykryto %@. Te pliki s\u0105 stosowane na bie\u017c\u0105co w ka\u017cdej turze projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ detectado. Esses arquivos s\u00e3o aplicados em tempo real a cada turno do projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u043d\u0430\u0440\u0443\u0436\u0435\u043d\u043e: %@. \u042d\u0442\u0438 \u0444\u0430\u0439\u043b\u044b \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u044e\u0442\u0441\u044f \u043a \u043a\u0430\u0436\u0434\u043e\u043c\u0443 \u0445\u043e\u0434\u0443 \u043f\u0440\u043e\u0435\u043a\u0442\u0430 \u0432 \u0440\u0435\u0430\u043b\u044c\u043d\u043e\u043c \u0432\u0440\u0435\u043c\u0435\u043d\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Hittade %@. Filerna till\u00e4mpas direkt p\u00e5 varje tur i projektet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bulundu. Bu dosyalar her proje turuna canl\u0131 uygulan\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u044f\u0432\u043b\u0435\u043d\u043e: %@. \u0426\u0456 \u0444\u0430\u0439\u043b\u0438 \u0437\u0430\u0441\u0442\u043e\u0441\u043e\u0432\u0443\u044e\u0442\u044c\u0441\u044f \u0434\u043e \u043a\u043e\u0436\u043d\u043e\u0433\u043e \u0445\u043e\u0434\u0443 \u043f\u0440\u043e\u0454\u043a\u0442\u0443 \u043d\u0430\u0436\u0438\u0432\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 ph\u00e1t hi\u1ec7n %@. C\u00e1c t\u1ec7p n\u00e0y \u0111\u01b0\u1ee3c \u00e1p d\u1ee5ng tr\u1ef1c ti\u1ebfp cho m\u1ecdi l\u01b0\u1ee3t c\u1ee7a d\u1ef1 \u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u68c0\u6d4b\u5230 %@\u3002\u8fd9\u4e9b\u6587\u4ef6\u4f1a\u5b9e\u65f6\u5e94\u7528\u4e8e\u9879\u76ee\u7684\u6bcf\u4e00\u8f6e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5075\u6e2c\u5230 %@\u3002\u9019\u4e9b\u6a94\u6848\u6703\u5373\u6642\u5957\u7528\u65bc\u5c08\u6848\u7684\u6bcf\u4e00\u8f2a\u3002"
          }
        }
      }
    },
