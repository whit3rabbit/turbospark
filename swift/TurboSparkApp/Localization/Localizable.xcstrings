        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0930\u094b\u0924 \u0915\u094b \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u092a\u0922\u093c\u093e \u091c\u093e \u0938\u0915\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber tidak dapat dibaca sebagai teks."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere il sorgente come testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30bd\u30fc\u30b9\u3092\u30c6\u30ad\u30b9\u30c8\u3068\u3057\u3066\u8aad\u307f\u8fbc\u3081\u307e\u305b\u3093\u3067\u3057\u305f\u3002"
