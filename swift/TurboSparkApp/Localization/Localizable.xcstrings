    "Files are collapsed for large diffs. Select a file to expand it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُطوى الملفات عند وجود فروق كبيرة. اختر ملفا لتوسيعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei großen Diffs werden Dateien eingeklappt. Wählen Sie eine Datei aus, um sie aufzuklappen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are collapsed for large diffs. Select a file to expand it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se contraen en diferencias grandes. Selecciona un archivo para expandirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont réduits pour les grandes différences. Sélectionnez un fichier pour le développer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבצים מכווצים כאשר ההבדלים גדולים. בחר קובץ כדי להרחיב אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बड़े डिफ़ में फ़ाइलें संक्षिप्त रहती हैं। विस्तृत करने के लिए फ़ाइल चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas diciutkan untuk perbedaan besar. Pilih berkas untuk memperluasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per differenze estese i file sono compressi. Seleziona un file per espanderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差分が大きい場合、ファイルは折りたたまれます。展開するにはファイルを選択してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "차이가 큰 경우 파일이 접혀 있습니다. 펼치려면 파일을 선택하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij grote verschillen worden bestanden ingeklapt. Selecteer een bestand om het uit te klappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy dużych różnicach pliki są zwinięte. Wybierz plik, aby go rozwinąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos ficam recolhidos em diferenças grandes. Selecione um arquivo para expandi-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При больших различиях файлы свернуты. Выберите файл, чтобы развернуть его."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer fälls ihop vid stora skillnader. Välj en fil för att expandera den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Büyük farklarda dosyalar daraltılır. Genişletmek için bir dosya seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "За великих відмінностей файли згорнуто. Виберіть файл, щоб розгорнути його."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp được thu gọn khi khác biệt lớn. Chọn một tệp để mở rộng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "差异较大时文件会折叠。选择文件即可展开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "差異較大時檔案會折疊。選取檔案即可展開。"
          }
        }
      }
    },
