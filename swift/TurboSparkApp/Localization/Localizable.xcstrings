    "Fast ripgrep-style indexed code search for this project.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u062d\u062b \u0633\u0631\u064a\u0639 \u0648\u0645\u0641\u0647\u0631\u0633 \u0641\u064a \u0627\u0644\u062a\u0639\u0644\u064a\u0645\u0627\u062a \u0627\u0644\u0628\u0631\u0645\u062c\u064a\u0629 \u0628\u0623\u0633\u0644\u0648\u0628 ripgrep \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schnelle indexierte Codesuche im ripgrep-Stil f\u00fcr dieses Projekt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fast ripgrep-style indexed code search for this project."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fasqueda r\u00e1pida de c\u00f3digo indexado al estilo ripgrep para este proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche rapide de code index\u00e9 de type ripgrep pour ce projet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d7\u05d9\u05e4\u05d5\u05e9 \u05e7\u05d5\u05d3 \u05de\u05d4\u05d9\u05e8 \u05d5\u05de\u05d0\u05d5\u05e0\u05d3\u05e7\u05e1 \u05d1\u05e1\u05d2\u05e0\u05d5\u05df ripgrep \u05e2\u05d1\u05d5\u05e8 \u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0947 \u0932\u093f\u090f ripgrep \u0936\u0948\u0932\u0940 \u0915\u0940 \u0924\u0947\u091c\u093c \u0907\u0902\u0921\u0947\u0915\u094d\u0938 \u0915\u0940 \u0917\u0908 \u0915\u094b\u0921 \u0916\u094b\u091c\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pencarian kode terindeks cepat bergaya ripgrep untuk proyek ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricerca rapida nel codice indicizzato in stile ripgrep per questo progetto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3067 ripgrep \u5f62\u5f0f\u306e\u9ad8\u901f\u306a\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u4ed8\u304d\u30b3\u30fc\u30c9\u691c\u7d22\u3092\u4f7f\u7528\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub85c\uc81d\ud2b8\uc5d0\uc11c ripgrep \uc2a4\ud0c0\uc77c\uc758 \ube60\ub978 \uc778\ub371\uc2a4 \ucf54\ub4dc \uac80\uc0c9\uc744 \uc0ac\uc6a9\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Snelle ge\u00efndexeerde codezoekopdracht in ripgrep-stijl voor dit project."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szybkie indeksowane wyszukiwanie kodu w stylu ripgrep dla tego projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesquisa r\u00e1pida de c\u00f3digo indexado no estilo ripgrep para este projeto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0411\u044b\u0441\u0442\u0440\u044b\u0439 \u0438\u043d\u0434\u0435\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043f\u043e\u0438\u0441\u043a \u043f\u043e \u043a\u043e\u0434\u0443 \u0432 \u0441\u0442\u0438\u043b\u0435 ripgrep \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u043e\u0435\u043a\u0442\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Snabb indexerad kods\u00f6kning i ripgrep-stil f\u00f6r det h\u00e4r projektet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu proje i\u00e7in ripgrep tarz\u0131 h\u0131zl\u0131 dizinlenmi\u015f kod aramas\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0432\u0438\u0434\u043a\u0438\u0439 \u0456\u043d\u0434\u0435\u043a\u0441\u043e\u0432\u0430\u043d\u0438\u0439 \u043f\u043e\u0448\u0443\u043a \u0443 \u043a\u043e\u0434\u0456 \u0432 \u0441\u0442\u0438\u043b\u0456 ripgrep \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043f\u0440\u043e\u0454\u043a\u0442\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00ecm ki\u1ebfm m\u00e3 \u0111\u01b0\u1ee3c l\u1eadp ch\u1ec9 m\u1ee5c nhanh theo ki\u1ec3u ripgrep cho d\u1ef1 \u00e1n n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e3a\u6b64\u9879\u76ee\u63d0\u4f9b ripgrep \u98ce\u683c\u7684\u5feb\u901f\u7d22\u5f15\u4ee3\u7801\u641c\u7d22\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u70ba\u6b64\u5c08\u6848\u63d0\u4f9b ripgrep \u98a8\u683c\u7684\u5feb\u901f\u7d22\u5f15\u7a0b\u5f0f\u78bc\u641c\u5c0b\u3002"
          }
        }
      }
    },
