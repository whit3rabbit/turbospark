    "Add folders on external drives or secondary locations to scan for .gturbo bundles and .gguf models.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add folders on external drives or secondary locations to scan for .gturbo bundles and .gguf models."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade carpetas en unidades externas u otras ubicaciones para buscar paquetes .gturbo y modelos .gguf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des dossiers situés sur des disques externes ou d'autres emplacements pour y rechercher des bundles .gturbo et des modèles .gguf."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie Ordner auf externen Laufwerken oder anderen Speicherorten hinzu, um dort nach .gturbo-Bundles und .gguf-Modellen zu suchen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi cartelle su unità esterne o posizioni secondarie in cui cercare bundle .gturbo e modelli .gguf."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione pastas em unidades externas ou outros locais para procurar pacotes .gturbo e modelos .gguf."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте папки на внешних дисках или в других расположениях для поиска пакетов .gturbo и моделей .gguf."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外付けドライブや別の場所にあるフォルダを追加して、.gturbo バンドルと .gguf モデルをスキャンします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외장 드라이브나 다른 위치의 폴더를 추가해 .gturbo 번들과 .gguf 모델을 검색합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加外部驱动器或其他位置的文件夹，以扫描 .gturbo 包和 .gguf 模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增外接磁碟或其他位置的資料夾，以掃描 .gturbo 套件與 .gguf 模型。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مجلدات على أقراص خارجية أو مواقع أخرى للبحث فيها عن حزم .gturbo ونماذج .gguf."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף תיקיות בכוננים חיצוניים או במיקומים אחרים לסריקת חבילות ‎.gturbo ומודלים ‎.gguf."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाहरी ड्राइव या अन्य स्थानों के फ़ोल्डर जोड़ें ताकि .gturbo बंडल और .gguf मॉडल स्कैन किए जा सकें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg mappen op externe schijven of andere locaties toe om te scannen op .gturbo-bundels en .gguf-modellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj foldery na dyskach zewnętrznych lub w innych lokalizacjach, aby wyszukiwać w nich pakiety .gturbo i modele .gguf."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": ".gturbo paketlerini ve .gguf modellerini taramak için harici sürücülerdeki veya diğer konumlardaki klasörleri ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте папки на зовнішніх дисках або в інших розташуваннях для пошуку пакетів .gturbo та моделей .gguf."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till mappar på externa enheter eller andra platser för att söka efter .gturbo-paket och .gguf-modeller."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thư mục trên ổ đĩa ngoài hoặc vị trí khác để quét gói .gturbo và mô hình .gguf."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan folder di drive eksternal atau lokasi lain untuk memindai bundel .gturbo dan model .gguf."
          }
        }
      }
    },
