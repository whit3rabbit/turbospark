    "Load the model to see which thinking levels it accepts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u0645\u0651\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0644\u0639\u0631\u0636 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0627\u0644\u062a\u064a \u064a\u0642\u0628\u0644\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie das Modell, um zu sehen, welche Denkstufen es akzeptiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load the model to see which thinking levels it accepts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga el modelo para ver qu\u00e9 niveles de razonamiento acepta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez le mod\u00e8le pour voir les niveaux de r\u00e9flexion qu'il accepte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05e2\u05df \u05d0\u05ea \u05d4\u05de\u05d5\u05d3\u05dc \u05db\u05d3\u05d9 \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05d9\u05dc\u05d5 \u05e8\u05de\u05d5\u05ea \u05d7\u05e9\u05d9\u05d1\u05d4 \u05d4\u05d5\u05d0 \u05de\u05e7\u05d1\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u092a\u0924\u093e \u091a\u0932\u0947 \u0915\u093f \u0935\u0939 \u0915\u094c\u0928 \u0938\u0947 \u0938\u094b\u091a\u0928\u0947 \u0915\u0947 \u0938\u094d\u0924\u0930 \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat model untuk melihat tingkat penalaran yang diterimanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica il modello per vedere quali livelli di ragionamento accetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u3092\u8aad\u307f\u8fbc\u3080\u3068\u3001\u53d7\u3051\u4ed8\u3051\u308b\u601d\u8003\u30ec\u30d9\u30eb\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc744 \ub85c\ub4dc\ud558\uba74 \ud5c8\uc6a9\ub418\ub294 \uc0ac\uace0 \uc218\uc900\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad het model om te zien welke denkniveaus het accepteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytaj model, aby zobaczy\u0107, jakie poziomy rozumowania akceptuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue o modelo para ver quais n\u00edveis de racioc\u00ednio ele aceita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c, \u043a\u0430\u043a\u0438\u0435 \u0443\u0440\u043e\u0432\u043d\u0438 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439 \u043e\u043d\u0430 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4s in modellen f\u00f6r att se vilka tankeniv\u00e5er den accepterar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul etti\u011fi d\u00fc\u015f\u00fcnme d\u00fczeylerini g\u00f6rmek i\u00e7in modeli y\u00fckleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438, \u044f\u043a\u0456 \u0440\u0456\u0432\u043d\u0456 \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u044c \u0432\u043e\u043d\u0430 \u043f\u0440\u0438\u0439\u043c\u0430\u0454."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i m\u00f4 h\u00ecnh \u0111\u1ec3 xem c\u00e1c m\u1ee9c suy lu\u1eadn m\u00e0 n\u00f3 ch\u1ea5p nh\u1eadn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u8f7d\u6a21\u578b\u5373\u53ef\u67e5\u770b\u5b83\u63a5\u53d7\u7684\u601d\u8003\u7ea7\u522b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f09\u5165\u6a21\u578b\u5373\u53ef\u6aa2\u8996\u5b83\u63a5\u53d7\u7684\u601d\u8003\u7b49\u7d1a\u3002"
          }
        }
      }
    },
