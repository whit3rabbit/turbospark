        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0930\u093f\u092a\u0949\u091c\u093f\u091f\u0930\u0940 \u092e\u0947\u0902 \u0915\u0947\u0935\u0932 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915 \u0915\u093e\u0930\u094d\u092f\u0936\u0940\u0932 \u0921\u093e\u092f\u0930\u0947\u0915\u094d\u091f\u0930\u0940 \u0939\u0948\u0964"
          }
        },
        "id": {
