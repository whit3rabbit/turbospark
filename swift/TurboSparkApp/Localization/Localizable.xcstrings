    "Steps between the earlier and later versions of this message": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0646\u0642\u0644 \u0628\u064a\u0646 \u0627\u0644\u0625\u0635\u062f\u0627\u0631\u0627\u062a \u0627\u0644\u0633\u0627\u0628\u0642\u0629 \u0648\u0627\u0644\u0644\u0627\u062d\u0642\u0629 \u0644\u0647\u0630\u0647 \u0627\u0644\u0631\u0633\u0627\u0644\u0629"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechselt zwischen fr\u00fcheren und sp\u00e4teren Versionen dieser Nachricht"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steps between the earlier and later versions of this message"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recorre las versiones anteriores y posteriores de este mensaje"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passe d'une version ant\u00e9rieure \u00e0 une version ult\u00e9rieure de ce message"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e2\u05d1\u05e8 \u05d1\u05d9\u05df \u05d4\u05d2\u05e8\u05e1\u05d0\u05d5\u05ea \u05d4\u05e7\u05d5\u05d3\u05de\u05d5\u05ea \u05d5\u05d4\u05de\u05d0\u05d5\u05d7\u05e8\u05d5\u05ea \u05e9\u05dc \u05d4\u05d5\u05d3\u05e2\u05d4 \u05d6\u05d5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u0902\u0926\u0947\u0936 \u0915\u0947 \u092a\u093f\u091b\u0932\u0947 \u0914\u0930 \u092c\u093e\u0926 \u0915\u0947 \u0938\u0902\u0938\u094d\u0915\u0930\u0923\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u091c\u093e\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Beralih antara versi sebelumnya dan berikutnya dari pesan ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa tra le versioni precedenti e successive di questo messaggio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e1\u30c3\u30bb\u30fc\u30b8\u306e\u524d\u5f8c\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3092\u5207\u308a\u66ff\u3048\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uba54\uc2dc\uc9c0\uc758 \uc774\uc804 \ubc84\uc804\uacfc \uc774\ud6c4 \ubc84\uc804\uc744 \uc624\uac11\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisselt tussen eerdere en latere versies van dit bericht"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prze\u0142\u0105cza mi\u0119dzy wcze\u015bniejszymi i p\u00f3\u017aniejszymi wersjami tej wiadomo\u015bci"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alterna entre as vers\u00f5es anteriores e posteriores desta mensagem"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043a\u043b\u044e\u0447\u0430\u0435\u0442 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0438\u0435 \u0438 \u0441\u043b\u0435\u0434\u0443\u044e\u0449\u0438\u0435 \u0432\u0435\u0440\u0441\u0438\u0438 \u0441\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u044f"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4xlar mellan tidigare och senare versioner av meddelandet"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu mesaj\u0131n \u00f6nceki ve sonraki s\u00fcr\u00fcmleri aras\u0131nda ge\u00e7i\u015f yapar"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043c\u0438\u043a\u0430\u0454 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u0456 \u0439 \u043d\u0430\u0441\u0442\u0443\u043f\u043d\u0456 \u0432\u0435\u0440\u0441\u0456\u0457 \u043f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chuy\u1ec3n gi\u1eefa c\u00e1c phi\u00ean b\u1ea3n tr\u01b0\u1edbc v\u00e0 sau c\u1ee7a tin nh\u1eafn n\u00e0y"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64\u6d88\u606f\u7684\u8f83\u65e9\u548c\u8f83\u65b0\u7248\u672c\u4e4b\u95f4\u5207\u6362"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u6b64\u8a0a\u606f\u7684\u8f03\u65e9\u548c\u8f03\u65b0\u7248\u672c\u4e4b\u9593\u5207\u63db"
          }
        }
      }
    },
