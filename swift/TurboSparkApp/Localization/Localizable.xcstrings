        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05e1\u05d5 \u05dc\u05e0\u05e7\u05d5\u05ea \u05d0\u05ea \u05d4\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d0\u05d5 \u05d4\u05de\u05e1\u05e0\u05e0\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0916\u094b\u091c \u092f\u093e \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0936\u092c\u094d\u0926 \u0938\u093e\u092b\u093c \u0915\u0930\u0915\u0947 \u0926\u0947\u0916\u0947\u0902\u0964"
