        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקלד או הדבק את מה שהקול המשובט צריך לומר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लोन की गई आवाज़ को जो कहना है, उसे लिखें या चिपकाएँ।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Typ of plak wat de gekloonde stem moet zeggen."
          }
        },
