    "Browse a marketplace, or add a local folder containing .claude-plugin/plugin.json.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0635\u0641\u062d \u0633\u0648\u0642\u0627 \u0623\u0648 \u0623\u0636\u0641 \u0645\u062c\u0644\u062f\u0627 \u0645\u062d\u0644\u064a\u0627 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 \u200e.claude-plugin/plugin.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsuchen Sie einen Marktplatz oder f\u00fcgen Sie einen lokalen Ordner mit .claude-plugin/plugin.json hinzu."
