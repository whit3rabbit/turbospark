        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hugging Face \u0921\u093e\u0909\u0928\u0932\u094b\u0921 \u0915\u0947 \u0932\u093f\u090f \u092c\u0947\u0938 URL ($HF_ENDPOINT), \u091c\u0948\u0938\u0947 \u092a\u094d\u0930\u0924\u093f\u092c\u0902\u0927\u093f\u0924 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f https://hf-mirror.com\u0964"
