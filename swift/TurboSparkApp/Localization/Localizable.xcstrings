          "stringUnit": {
            "state": "translated",
            "value": "\ub9c8\ucf13\ud50c\ub808\uc774\uc2a4\ub97c \uc0b4\ud3b4\ubcf4\uac70\ub098 .claude-plugin/plugin.json\uc774 \uc788\ub294 \ub85c\uceec \ud3f4\ub354\ub97c \ucd94\uac00\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blader door een marktplaats of voeg een lokale map toe met .claude-plugin/plugin.json."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przegl\u0105daj marketplace lub dodaj folder lokalny zawieraj\u0105cy .claude-plugin/plugin.json."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Navegue por um marketplace ou adicione uma pasta local que contenha .claude-plugin/plugin.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u043e\u0441\u043c\u043e\u0442\u0440\u0438\u0442\u0435 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441 \u0438\u043b\u0438 \u0434\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0443\u044e \u043f\u0430\u043f\u043a\u0443 \u0441 \u0444\u0430\u0439\u043b\u043e\u043c .claude-plugin/plugin.json."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bl\u00e4ddra i en marknadsplats eller l\u00e4gg till en lokal mapp som inneh\u00e5ller .claude-plugin/plugin.json."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir pazar\u0131 inceleyin veya .claude-plugin/plugin.json i\u00e7eren yerel bir klas\u00f6r ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0433\u043b\u044f\u043d\u044c\u0442\u0435 \u043c\u0430\u0440\u043a\u0435\u0442\u043f\u043b\u0435\u0439\u0441 \u0430\u0431\u043e \u0434\u043e\u0434\u0430\u0439\u0442\u0435 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0443 \u043f\u0430\u043f\u043a\u0443 \u0437 \u0444\u0430\u0439\u043b\u043e\u043c .claude-plugin/plugin.json."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Duy\u1ec7t ch\u1ee3, ho\u1eb7c th\u00eam th\u01b0 m\u1ee5c c\u1ee5c b\u1ed9 ch\u1ee9a .claude-plugin/plugin.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6d4f\u89c8\u5e02\u573a\uff0c\u6216\u6dfb\u52a0\u5305\u542b .claude-plugin/plugin.json \u7684\u672c\u5730\u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u700f\u89bd\u5e02\u96c6\uff0c\u6216\u65b0\u589e\u5305\u542b .claude-plugin/plugin.json \u7684\u672c\u6a5f\u8cc7\u6599\u593e\u3002"
          }
        }
      }
    },
