            "value": "\u0414\u043e\u0437\u0432\u043e\u043b\u0435\u043d\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438:"
          }
        },
        "vi": {
