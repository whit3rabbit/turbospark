        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0431\u043e\u0440\u043e\u043d\u0435\u043d\u0456 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0438 (\u0447\u0435\u0440\u0435\u0437 \u043a\u043e\u043c\u0443)"
