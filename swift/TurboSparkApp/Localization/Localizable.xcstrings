        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092a\u0930\u093f\u092f\u094b\u091c\u0928\u093e \u0915\u094d\u092f\u093e \u092f\u093e\u0926 \u0930\u0916\u0924\u0940 \u0939\u0948"
