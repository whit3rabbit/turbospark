    "The API server cannot run this model. It runs only in this app.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API server cannot run this model. It runs only in this app."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de la API no puede ejecutar este modelo. Solo se ejecuta en esta app."
          }
        },
        "fr": {
          "stringUnit": {
