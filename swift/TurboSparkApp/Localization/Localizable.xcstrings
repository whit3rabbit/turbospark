            "state": "translated",
            "value": "C\u1ea7n c\u00f3 kh\u00f3a API TypeSafe \u0111\u1ec3 kh\u1edfi \u0111\u1ed9ng daemon."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u542f\u52a8\u5b88\u62a4\u8fdb\u7a0b\u9700\u8981 TypeSafe API \u5bc6\u94a5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u555f\u52d5\u5e38\u99d0\u7a0b\u5f0f\u9700\u8981 TypeSafe API \u91d1\u9470\u3002"
          }
        }
      }
    },
    "UI language is %@. Give a code, e.g. /language de or /language zh-Hans.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u063a\u0629 \u0627\u0644\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u062d\u0627\u0644\u064a\u0629: %@. \u0623\u062f\u062e\u0644 \u0631\u0645\u0632\u064b\u0627\u060c \u0645\u062b\u0644 /language de \u0623\u0648 /language zh-Hans."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Oberfl\u00e4chensprache ist %@. Geben Sie einen Code an, z. B. /language de oder /language zh-Hans."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "UI language is %@. Give a code, e.g. /language de or /language zh-Hans."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de la interfaz es %@. Indica un c\u00f3digo, p. ej. /language de o /language zh-Hans."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de l'interface est %@. Indiquez un code, p. ex. /language de ou /language zh-Hans."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05e4\u05ea \u05d4\u05de\u05de\u05e9\u05e7 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9\u05ea: %@. \u05e6\u05d9\u05d9\u05df \u05e7\u05d5\u05d3, \u05dc\u05de\u05e9\u05dc /language de \u05d0\u05d5 /language zh-Hans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0902\u091f\u0930\u092b\u093c\u0947\u0938 \u092d\u093e\u0937\u093e %@ \u0939\u0948\u0964 \u0915\u094b\u0908 \u0915\u094b\u0921 \u0926\u0947\u0902, \u091c\u0948\u0938\u0947 /language de \u092f\u093e /language zh-Hans\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bahasa antarmuka: %@. Berikan kode, mis. /language de atau /language zh-Hans."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua dell'interfaccia \u00e8 %@. Indica un codice, ad es. /language de o /language zh-Hans."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73fe\u5728\u306e\u8868\u793a\u8a00\u8a9e: %@\u3002\u30b3\u30fc\u30c9\u3092\u6307\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044 (\u4f8b: /language de\u3001/language zh-Hans)\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud604\uc7ac \uc778\ud130\ud398\uc774\uc2a4 \uc5b8\uc5b4: %@. \ucf54\ub4dc\ub97c \uc785\ub825\ud558\uc138\uc694(\uc608: /language de \ub610\ub294 /language zh-Hans)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Interfacetaal is %@. Geef een code op, bijv. /language de of /language zh-Hans."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "J\u0119zyk interfejsu: %@. Podaj kod, np. /language de lub /language zh-Hans."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma da interface \u00e9 %@. Informe um c\u00f3digo, por exemplo /language de ou /language zh-Hans."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f\u0437\u044b\u043a \u0438\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0430: %@. \u0423\u043a\u0430\u0436\u0438\u0442\u0435 \u043a\u043e\u0434, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 /language de \u0438\u043b\u0438 /language zh-Hans."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gr\u00e4nssnittsspr\u00e5ket \u00e4r %@. Ange en kod, t.ex. /language de eller /language zh-Hans."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aray\u00fcz dili: %@. Bir kod girin, \u00f6r. /language de veya /language zh-Hans."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0432\u0430 \u0456\u043d\u0442\u0435\u0440\u0444\u0435\u0439\u0441\u0443: %@. \u0412\u043a\u0430\u0436\u0456\u0442\u044c \u043a\u043e\u0434, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 /language de \u0430\u0431\u043e /language zh-Hans."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ng\u00f4n ng\u1eef giao di\u1ec7n hi\u1ec7n t\u1ea1i: %@. Nh\u1eadp m\u00e3, v\u00ed d\u1ee5 /language de ho\u1eb7c /language zh-Hans."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f53\u524d\u754c\u9762\u8bed\u8a00\uff1a%@\u3002\u8bf7\u8f93\u5165\u4ee3\u7801\uff0c\u4f8b\u5982 /language de \u6216 /language zh-Hans\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u76ee\u524d\u4ecb\u9762\u8a9e\u8a00\uff1a%@\u3002\u8acb\u8f38\u5165\u4ee3\u78bc\uff0c\u4f8b\u5982 /language de \u6216 /language zh-Hans\u3002"
