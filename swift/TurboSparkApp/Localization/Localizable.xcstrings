    "@diff: no unstaged changes to attach.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: لا توجد تغييرات غير مرحلية لإرفاقها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: keine nicht bereitgestellten Änderungen zum Anhängen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: no unstaged changes to attach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: no hay cambios sin preparar para adjuntar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff : aucune modification non indexée à joindre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: אין שינויים שלא הוכנו לצירוף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: संलग्न करने के लिए कोई अनस्टेज्ड बदलाव नहीं हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: tidak ada perubahan yang belum di-stage untuk dilampirkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: nessuna modifica non preparata da allegare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: 添付するステージされていない変更はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: 첨부할 스테이징되지 않은 변경 사항이 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: geen niet-gestagede wijzigingen om bij te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: brak niezatwierdzonych zmian do załączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: não há alterações fora do stage para anexar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: нет неиндексированных изменений для прикрепления."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: inga ej köade ändringar att bifoga."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: eklenecek hazırlanmamış değişiklik yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: немає неіндексованих змін для додавання."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff: không có thay đổi chưa stage nào để đính kèm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff：没有可附加的未暂存更改。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "@diff：沒有可附加的未暫存變更。"
          }
        }
      }
    },
    "@file: %@ looks like a credential file; it was not read.": {
      "extractionState": "manual",
