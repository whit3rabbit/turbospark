        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u043b\u043e\u0441\u043e\u0432\u0438\u0439 \u043e\u043f\u0438\u0441 \u0430\u0431\u043e \u0441\u0442\u0438\u043b\u044c"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 t\u1ea3 ho\u1eb7c phong c\u00e1ch gi\u1ecdng n\u00f3i"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bed\u97f3\u63cf\u8ff0\u6216\u98ce\u683c"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a9e\u97f3\u63cf\u8ff0\u6216\u98a8\u683c"
          }
        }
      }
    },
    "Generated audio that reaches the token limit is refused. Increase the limit or shorten the speech text.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u064f\u0631\u0641\u0636 \u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0630\u064a \u064a\u0635\u0644 \u0625\u0644\u0649 \u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0642\u0635\u0649 \u0644\u0644\u0631\u0645\u0648\u0632. \u0632\u062f \u0627\u0644\u062d\u062f \u0623\u0648 \u0627\u062e\u062a\u0635\u0631 \u0646\u0635 \u0627\u0644\u0643\u0644\u0627\u0645."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio, das das Token-Limit erreicht, wird verworfen. Erh\u00f6hen Sie das Limit oder k\u00fcrzen Sie den Sprechtext."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Generated audio that reaches the token limit is refused. Increase the limit or shorten the speech text."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechaza el audio que alcanza el l\u00edmite de tokens. Aumenta el l\u00edmite o acorta el texto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un audio qui atteint la limite de jetons est refus\u00e9. Augmentez la limite ou raccourcissez le texte."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e9\u05de\u05e2 \u05e9\u05de\u05d2\u05d9\u05e2 \u05dc\u05de\u05d2\u05d1\u05dc\u05ea \u05d4\u05d8\u05d5\u05e7\u05e0\u05d9\u05dd \u05e0\u05d3\u05d7\u05d4. \u05d4\u05d2\u05d3\u05dc \u05d0\u05ea \u05d4\u05de\u05d2\u05d1\u05dc\u05d4 \u05d0\u05d5 \u05e7\u05e6\u05e8 \u05d0\u05ea \u05d4\u05d8\u05e7\u05e1\u05d8 \u05dc\u05d4\u05e7\u05e8\u05d0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u094b\u0915\u0928 \u0938\u0940\u092e\u093e \u0924\u0915 \u092a\u0939\u0941\u0901\u091a\u0928\u0947 \u0935\u093e\u0932\u093e \u0911\u0921\u093f\u092f\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e\u0964 \u0938\u0940\u092e\u093e \u092c\u0922\u093c\u093e\u090f\u0901 \u092f\u093e \u092c\u094b\u0932\u0928\u0947 \u0915\u093e \u092a\u093e\u0920 \u091b\u094b\u091f\u093e \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio yang mencapai batas token ditolak. Naikkan batas atau perpendek teks ucapan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio che raggiunge il limite di token viene rifiutato. Aumenta il limite o accorcia il testo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c8\u30fc\u30af\u30f3\u4e0a\u9650\u306b\u9054\u3057\u305f\u97f3\u58f0\u306f\u4fdd\u5b58\u3055\u308c\u307e\u305b\u3093\u3002\u4e0a\u9650\u3092\u5897\u3084\u3059\u304b\u3001\u8aad\u307f\u4e0a\u3052\u308b\u6587\u7ae0\u3092\u77ed\u304f\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud1a0\ud070 \ud55c\ub3c4\uc5d0 \ub3c4\ub2ec\ud55c \uc74c\uc131\uc740 \uc800\uc7a5\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud55c\ub3c4\ub97c \ub298\ub9ac\uac70\ub098 \uc77d\uc744 \uae00\uc744 \uc904\uc774\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio die de tokenlimiet bereikt, wordt geweigerd. Verhoog de limiet of verkort de spreektekst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u017awi\u0119k osi\u0105gaj\u0105cy limit token\u00f3w zostanie odrzucony. Zwi\u0119ksz limit lub skr\u00f3\u0107 tekst wypowiedzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O \u00e1udio que atingir o limite de tokens ser\u00e1 recusado. Aumente o limite ou encurte o texto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0434\u0438\u043e, \u0434\u043e\u0441\u0442\u0438\u0433\u0448\u0435\u0435 \u043b\u0438\u043c\u0438\u0442\u0430 \u0442\u043e\u043a\u0435\u043d\u043e\u0432, \u043e\u0442\u043a\u043b\u043e\u043d\u044f\u0435\u0442\u0441\u044f. \u0423\u0432\u0435\u043b\u0438\u0447\u044c\u0442\u0435 \u043b\u0438\u043c\u0438\u0442 \u0438\u043b\u0438 \u0441\u043e\u043a\u0440\u0430\u0442\u0438\u0442\u0435 \u0442\u0435\u043a\u0441\u0442 \u0440\u0435\u0447\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljud som n\u00e5r tokengr\u00e4nsen avvisas. H\u00f6j gr\u00e4nsen eller f\u00f6rkorta taltexten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Token s\u0131n\u0131r\u0131na ula\u015fan ses reddedilir. S\u0131n\u0131r\u0131 art\u0131r\u0131n veya konu\u015fma metnini k\u0131salt\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0410\u0443\u0434\u0456\u043e, \u0449\u043e \u0434\u043e\u0441\u044f\u0433\u0430\u0454 \u043b\u0456\u043c\u0456\u0442\u0443 \u0442\u043e\u043a\u0435\u043d\u0456\u0432, \u0432\u0456\u0434\u0445\u0438\u043b\u044f\u0454\u0442\u044c\u0441\u044f. \u0417\u0431\u0456\u043b\u044c\u0448\u0442\u0435 \u043b\u0456\u043c\u0456\u0442 \u0430\u0431\u043e \u0441\u043a\u043e\u0440\u043e\u0442\u0456\u0442\u044c \u0442\u0435\u043a\u0441\u0442 \u043c\u043e\u0432\u043b\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c2m thanh \u0111\u1ea1t gi\u1edbi h\u1ea1n token s\u1ebd b\u1ecb t\u1eeb ch\u1ed1i. T\u0103ng gi\u1edbi h\u1ea1n ho\u1eb7c r\u00fat ng\u1eafn v\u0103n b\u1ea3n l\u1eddi n\u00f3i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8fbe\u5230\u4ee4\u724c\u4e0a\u9650\u7684\u97f3\u9891\u5c06\u88ab\u62d2\u7edd\u3002\u8bf7\u63d0\u9ad8\u4e0a\u9650\u6216\u7f29\u77ed\u6717\u8bfb\u6587\u672c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9054\u5230\u6b0a\u6756\u4e0a\u9650\u7684\u97f3\u8a0a\u5c07\u88ab\u62d2\u7d55\u3002\u8acb\u63d0\u9ad8\u4e0a\u9650\u6216\u7e2e\u77ed\u6717\u8b80\u6587\u5b57\u3002"
          }
        }
      }
    },
    "Describe a voice and generate an audio clip. Reuse the clip as a cloning reference for a consistent voice.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0635\u0641 \u0635\u0648\u062a\u064b\u0627 \u0648\u0623\u0646\u0634\u0626 \u0645\u0642\u0637\u0639\u064b\u0627 \u0635\u0648\u062a\u064a\u064b\u0627. \u0623\u0639\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0642\u0637\u0639 \u0643\u0645\u0631\u062c\u0639 \u0644\u0644\u0627\u0633\u062a\u0646\u0633\u0627\u062e \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0627\u0644\u0635\u0648\u062a \u0646\u0641\u0633\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreiben Sie eine Stimme und erzeugen Sie einen Audioclip. Verwenden Sie ihn als Klonreferenz f\u00fcr eine gleichbleibende Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a voice and generate an audio clip. Reuse the clip as a cloning reference for a consistent voice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe una voz y genera un clip de audio. Reutiliza el clip como referencia de clonaci\u00f3n para mantener la misma voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9crivez une voix et g\u00e9n\u00e9rez un extrait audio. R\u00e9utilisez cet extrait comme r\u00e9f\u00e9rence de clonage pour conserver la m\u00eame voix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05d0\u05e8 \u05e7\u05d5\u05dc \u05d5\u05e6\u05d5\u05e8 \u05e7\u05d8\u05e2 \u05e9\u05de\u05e2. \u05d4\u05e9\u05ea\u05de\u05e9 \u05e9\u05d5\u05d1 \u05d1\u05e7\u05d8\u05e2 \u05db\u05d9\u05d9\u05d7\u05d5\u05e1 \u05dc\u05e9\u05db\u05e4\u05d5\u05dc \u05db\u05d3\u05d9 \u05dc\u05e9\u05de\u05d5\u05e8 \u05e2\u05dc \u05d0\u05d5\u05ea\u05d5 \u05e7\u05d5\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0906\u0935\u093e\u091c\u093c \u0915\u093e \u0935\u0930\u094d\u0923\u0928 \u0915\u0930\u0947\u0902 \u0914\u0930 \u0911\u0921\u093f\u092f\u094b \u0915\u094d\u0932\u093f\u092a \u092c\u0928\u093e\u090f\u0901\u0964 \u090f\u0915 \u091c\u0948\u0938\u0940 \u0906\u0935\u093e\u091c\u093c \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u092a \u0915\u094b \u0915\u094d\u0932\u094b\u0928\u093f\u0902\u0917 \u0915\u0947 \u0938\u0902\u0926\u0930\u094d\u092d \u0915\u0947 \u0930\u0942\u092a \u092e\u0947\u0902 \u092b\u093f\u0930 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Deskripsikan suara dan buat klip audio. Gunakan kembali klip sebagai referensi kloning untuk mempertahankan suara yang sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi una voce e genera un clip audio. Riutilizzalo come riferimento per la clonazione per mantenere la stessa voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u58f0\u3092\u8aac\u660e\u3057\u3066\u97f3\u58f0\u30af\u30ea\u30c3\u30d7\u3092\u751f\u6210\u3057\u307e\u3059\u3002\u305d\u306e\u30af\u30ea\u30c3\u30d7\u3092\u58f0\u306e\u30af\u30ed\u30fc\u30f3\u7528\u306e\u53c2\u7167\u3068\u3057\u3066\u518d\u5229\u7528\u3059\u308b\u3068\u3001\u540c\u3058\u58f0\u3092\u7dad\u6301\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa9\uc18c\ub9ac\ub97c \uc124\uba85\ud558\uace0 \uc624\ub514\uc624 \ud074\ub9bd\uc744 \uc0dd\uc131\ud558\uc138\uc694. \uac19\uc740 \ubaa9\uc18c\ub9ac\ub97c \uc720\uc9c0\ud558\ub824\uba74 \ud074\ub9bd\uc744 \ubcf5\uc81c\uc6a9 \ucc38\uc870\ub85c \uc7ac\uc0ac\uc6a9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschrijf een stem en genereer een audiofragment. Gebruik het fragment als kloonreferentie voor een consistente stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opisz g\u0142os i wygeneruj klip audio. U\u017cyj klipu jako wzorca klonowania, aby zachowa\u0107 ten sam g\u0142os."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Descreva uma voz e gere um clipe de \u00e1udio. Reutilize o clipe como refer\u00eancia de clonagem para manter a mesma voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0438\u0442\u0435 \u0433\u043e\u043b\u043e\u0441 \u0438 \u0441\u043e\u0437\u0434\u0430\u0439\u0442\u0435 \u0430\u0443\u0434\u0438\u043e\u043a\u043b\u0438\u043f. \u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u043a\u043b\u0438\u043f \u043a\u0430\u043a \u043e\u0431\u0440\u0430\u0437\u0435\u0446 \u0434\u043b\u044f \u043a\u043b\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f, \u0447\u0442\u043e\u0431\u044b \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u044c \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u0439 \u0433\u043e\u043b\u043e\u0441."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Beskriv en r\u00f6st och generera ett ljudklipp. \u00c5teranv\u00e4nd klippet som kloningsreferens f\u00f6r en konsekvent r\u00f6st."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir sesi tan\u0131mlay\u0131n ve bir ses klibi olu\u015fturun. Ayn\u0131 sesi korumak i\u00e7in klibi klonlama referans\u0131 olarak yeniden kullan\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u043f\u0438\u0448\u0456\u0442\u044c \u0433\u043e\u043b\u043e\u0441 \u0456 \u0441\u0442\u0432\u043e\u0440\u0456\u0442\u044c \u0430\u0443\u0434\u0456\u043e\u043a\u043b\u0456\u043f. \u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435 \u043a\u043b\u0456\u043f \u044f\u043a \u0437\u0440\u0430\u0437\u043e\u043a \u0434\u043b\u044f \u043a\u043b\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f, \u0449\u043e\u0431 \u0437\u0431\u0435\u0440\u0435\u0433\u0442\u0438 \u043e\u0434\u043d\u0430\u043a\u043e\u0432\u0438\u0439 \u0433\u043e\u043b\u043e\u0441."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 t\u1ea3 m\u1ed9t gi\u1ecdng n\u00f3i v\u00e0 t\u1ea1o \u0111o\u1ea1n \u00e2m thanh. D\u00f9ng l\u1ea1i \u0111o\u1ea1n \u00e2m thanh l\u00e0m m\u1eabu nh\u00e2n b\u1ea3n \u0111\u1ec3 gi\u1eef gi\u1ecdng n\u00f3i nh\u1ea5t qu\u00e1n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63cf\u8ff0\u58f0\u97f3\u5e76\u751f\u6210\u97f3\u9891\u7247\u6bb5\u3002\u5c06\u8be5\u7247\u6bb5\u7528\u4f5c\u514b\u9686\u53c2\u8003\uff0c\u4ee5\u4fdd\u6301\u4e00\u81f4\u7684\u58f0\u97f3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63cf\u8ff0\u8072\u97f3\u4e26\u7522\u751f\u97f3\u8a0a\u7247\u6bb5\u3002\u5c07\u8a72\u7247\u6bb5\u7528\u4f5c\u8907\u88fd\u53c3\u8003\uff0c\u4ee5\u7dad\u6301\u4e00\u81f4\u7684\u8072\u97f3\u3002"
          }
        }
      }
    },
    "Voice embedding mode does not require a transcript. A matching transcript usually improves voice similarity.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u062a\u0637\u0644\u0628 \u0648\u0636\u0639 \u0627\u0644\u062a\u0645\u062b\u064a\u0644 \u0627\u0644\u0645\u062a\u062c\u0647\u064a \u0644\u0644\u0635\u0648\u062a \u0646\u0635\u064b\u0627 \u0645\u0643\u062a\u0648\u0628\u064b\u0627. \u0639\u0627\u062f\u0629\u064b \u0645\u0627 \u064a\u062d\u0633\u0646 \u0627\u0644\u0646\u0635 \u0627\u0644\u0645\u0637\u0627\u0628\u0642 \u062a\u0634\u0627\u0628\u0647 \u0627\u0644\u0635\u0648\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Modus f\u00fcr Stimmeinbettungen ben\u00f6tigt kein Transkript. Ein passendes Transkript verbessert normalerweise die \u00c4hnlichkeit der Stimme."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice embedding mode does not require a transcript. A matching transcript usually improves voice similarity."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modo de representaci\u00f3n de voz no requiere una transcripci\u00f3n. Una transcripci\u00f3n coincidente suele mejorar la similitud de la voz."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mode de repr\u00e9sentation vocale ne n\u00e9cessite pas de transcription. Une transcription correspondante am\u00e9liore g\u00e9n\u00e9ralement la ressemblance de la voix."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e6\u05d1 \u05d9\u05d9\u05e6\u05d5\u05d2 \u05e7\u05d5\u05dc\u05d9 \u05d0\u05d9\u05e0\u05d5 \u05d3\u05d5\u05e8\u05e9 \u05ea\u05de\u05dc\u05d9\u05dc. \u05ea\u05de\u05dc\u05d9\u05dc \u05ea\u05d5\u05d0\u05dd \u05d1\u05d3\u05e8\u05da \u05db\u05dc\u05dc \u05de\u05e9\u05e4\u05e8 \u05d0\u05ea \u05d4\u05d3\u05de\u05d9\u05d5\u05df \u05d1\u05e7\u05d5\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0949\u0907\u0938 \u090f\u092e\u094d\u092c\u0947\u0921\u093f\u0902\u0917 \u092e\u094b\u0921 \u092e\u0947\u0902 \u092a\u094d\u0930\u0924\u093f\u0932\u0947\u0916 \u0915\u0940 \u091c\u093c\u0930\u0942\u0930\u0924 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u0940\u0964 \u0911\u0921\u093f\u092f\u094b \u0938\u0947 \u092e\u0947\u0932 \u0916\u093e\u0924\u093e \u092a\u094d\u0930\u0924\u093f\u0932\u0947\u0916 \u0906\u092e \u0924\u094c\u0930 \u092a\u0930 \u0906\u0935\u093e\u091c\u093c \u0915\u0940 \u0938\u092e\u093e\u0928\u0924\u093e \u092c\u0922\u093c\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mode representasi suara tidak memerlukan transkrip. Transkrip yang sesuai biasanya meningkatkan kemiripan suara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La modalit\u00e0 di rappresentazione vocale non richiede una trascrizione. Una trascrizione corrispondente di solito migliora la somiglianza della voce."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u58f0\u306e\u57cb\u3081\u8fbc\u307f\u30e2\u30fc\u30c9\u3067\u306f\u66f8\u304d\u8d77\u3053\u3057\u306f\u4e0d\u8981\u3067\u3059\u3002\u97f3\u58f0\u306b\u4e00\u81f4\u3059\u308b\u66f8\u304d\u8d77\u3053\u3057\u3092\u4f7f\u3046\u3068\u3001\u901a\u5e38\u306f\u58f0\u306e\u985e\u4f3c\u5ea6\u304c\u5411\u4e0a\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc74c\uc131 \uc784\ubca0\ub529 \ubaa8\ub4dc\ub294 \uc804\uc0ac\ubb38\uc774 \ud544\uc694\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc74c\uc131\uacfc \uc77c\uce58\ud558\ub294 \uc804\uc0ac\ubb38\uc740 \ubcf4\ud1b5 \ubaa9\uc18c\ub9ac \uc720\uc0ac\ub3c4\ub97c \ub192\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De modus voor stemembeddings vereist geen transcript. Een passend transcript verbetert meestal de gelijkenis van de stem."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryb reprezentacji g\u0142osu nie wymaga transkrypcji. Zgodna transkrypcja zwykle poprawia podobie\u0144stwo g\u0142osu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modo de representa\u00e7\u00e3o de voz n\u00e3o exige uma transcri\u00e7\u00e3o. Uma transcri\u00e7\u00e3o correspondente geralmente melhora a semelhan\u00e7a da voz."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0436\u0438\u043c \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u0438\u044f \u0433\u043e\u043b\u043e\u0441\u0430 \u043d\u0435 \u0442\u0440\u0435\u0431\u0443\u0435\u0442 \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0438. \u0421\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0430\u044f \u0440\u0430\u0441\u0448\u0438\u0444\u0440\u043e\u0432\u043a\u0430 \u043e\u0431\u044b\u0447\u043d\u043e \u0443\u043b\u0443\u0447\u0448\u0430\u0435\u0442 \u0441\u0445\u043e\u0434\u0441\u0442\u0432\u043e \u0433\u043e\u043b\u043e\u0441\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4get f\u00f6r r\u00f6stinb\u00e4ddning kr\u00e4ver ingen transkription. En matchande transkription f\u00f6rb\u00e4ttrar vanligtvis r\u00f6stlikheten."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses g\u00f6mme modu transkript gerektirmez. E\u015fle\u015fen bir transkript genellikle ses benzerli\u011fini art\u0131r\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0420\u0435\u0436\u0438\u043c \u0432\u0435\u043a\u0442\u043e\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u0441\u0442\u0430\u0432\u043b\u0435\u043d\u043d\u044f \u0433\u043e\u043b\u043e\u0441\u0443 \u043d\u0435 \u043f\u043e\u0442\u0440\u0435\u0431\u0443\u0454 \u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0456\u0457. \u0412\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u043d\u0430 \u0442\u0440\u0430\u043d\u0441\u043a\u0440\u0438\u043f\u0446\u0456\u044f \u0437\u0430\u0437\u0432\u0438\u0447\u0430\u0439 \u043f\u043e\u043a\u0440\u0430\u0449\u0443\u0454 \u043f\u043e\u0434\u0456\u0431\u043d\u0456\u0441\u0442\u044c \u0433\u043e\u043b\u043e\u0441\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ebf \u0111\u1ed9 bi\u1ec3u di\u1ec5n gi\u1ecdng n\u00f3i kh\u00f4ng c\u1ea7n b\u1ea3n ch\u00e9p l\u1eddi. B\u1ea3n ch\u00e9p l\u1eddi kh\u1edbp v\u1edbi \u00e2m thanh th\u01b0\u1eddng c\u1ea3i thi\u1ec7n \u0111\u1ed9 gi\u1ed1ng gi\u1ecdng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u58f0\u97f3\u5d4c\u5165\u6a21\u5f0f\u65e0\u9700\u8f6c\u5199\u6587\u672c\u3002\u4e0e\u97f3\u9891\u5339\u914d\u7684\u8f6c\u5199\u6587\u672c\u901a\u5e38\u53ef\u4ee5\u63d0\u9ad8\u58f0\u97f3\u76f8\u4f3c\u5ea6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8072\u97f3\u5d4c\u5165\u6a21\u5f0f\u7121\u9700\u8f49\u5beb\u6587\u5b57\u3002\u8207\u97f3\u8a0a\u76f8\u7b26\u7684\u8f49\u5beb\u6587\u5b57\u901a\u5e38\u53ef\u4ee5\u63d0\u9ad8\u8072\u97f3\u76f8\u4f3c\u5ea6\u3002"
          }
        }
      }
    },
    "Use a clear recording of one person speaking for 1 to 30 seconds.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u062e\u062f\u0645 \u062a\u0633\u062c\u064a\u0644\u064b\u0627 \u0648\u0627\u0636\u062d\u064b\u0627 \u0644\u0634\u062e\u0635 \u0648\u0627\u062d\u062f \u064a\u062a\u062d\u062f\u062b \u0644\u0645\u062f\u0629 \u062a\u062a\u0631\u0627\u0648\u062d \u0628\u064a\u0646 \u062b\u0627\u0646\u064a\u0629 \u064830 \u062b\u0627\u0646\u064a\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine klare Aufnahme einer einzelnen sprechenden Person mit einer L\u00e4nge von 1 bis 30 Sekunden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a clear recording of one person speaking for 1 to 30 seconds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una grabaci\u00f3n clara de una sola persona hablando entre 1 y 30 segundos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un enregistrement clair d'une seule personne parlant pendant 1 \u00e0 30 secondes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d4\u05e7\u05dc\u05d8\u05d4 \u05d1\u05e8\u05d5\u05e8\u05d4 \u05e9\u05dc \u05d0\u05d3\u05dd \u05d0\u05d7\u05d3 \u05e9\u05de\u05d3\u05d1\u05e8 \u05d1\u05de\u05e9\u05da 1 \u05e2\u05d3 30 \u05e9\u05e0\u05d9\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0915\u0947 1 \u0938\u0947 30 \u0938\u0947\u0915\u0902\u0921 \u0924\u0915 \u092c\u094b\u0932\u0928\u0947 \u0915\u0940 \u0938\u093e\u092b\u093c \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0907\u0938\u094d\u0924\u0947\u092e\u093e\u0932 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan rekaman jelas dari satu orang yang berbicara selama 1 hingga 30 detik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una registrazione chiara di una sola persona che parla per 1-30 secondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1\u4eba\u304c1\u301c30\u79d2\u8a71\u3059\u660e\u77ad\u306a\u9332\u97f3\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud55c \uc0ac\ub78c\uc774 1~30\ucd08 \ub3d9\uc548 \ub9d0\ud558\ub294 \uc120\uba85\ud55c \ub179\uc74c\uc744 \uc0ac\uc6a9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een duidelijke opname van \u00e9\u00e9n persoon die 1 tot 30 seconden spreekt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cyj wyra\u017anego nagrania jednej osoby m\u00f3wi\u0105cej przez 1 do 30 sekund."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma grava\u00e7\u00e3o clara de uma \u00fanica pessoa falando por 1 a 30 segundos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0447\u0451\u0442\u043a\u0443\u044e \u0437\u0430\u043f\u0438\u0441\u044c \u043e\u0434\u043d\u043e\u0433\u043e \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u0430, \u0433\u043e\u0432\u043e\u0440\u044f\u0449\u0435\u0433\u043e \u043e\u0442 1 \u0434\u043e 30 \u0441\u0435\u043a\u0443\u043d\u0434."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nd en tydlig inspelning av en person som talar i 1 till 30 sekunder."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir ki\u015finin 1 ila 30 saniye konu\u015ftu\u011fu net bir kay\u0131t kullan\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u0439\u0442\u0435 \u0447\u0456\u0442\u043a\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u043e\u0434\u043d\u0456\u0454\u0457 \u043b\u044e\u0434\u0438\u043d\u0438, \u044f\u043a\u0430 \u0433\u043e\u0432\u043e\u0440\u0438\u0442\u044c \u0432\u0456\u0434 1 \u0434\u043e 30 \u0441\u0435\u043a\u0443\u043d\u0434."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00f9ng b\u1ea3n ghi r\u00f5 r\u00e0ng c\u1ee7a m\u1ed9t ng\u01b0\u1eddi n\u00f3i trong 1 \u0111\u1ebfn 30 gi\u00e2y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u4f7f\u7528\u4ec5\u6709\u4e00\u4eba\u8bf4\u8bdd\u7684\u6e05\u6670\u5f55\u97f3\uff0c\u65f6\u957f\u4e3a1\u523030\u79d2\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u4f7f\u7528\u53ea\u6709\u4e00\u4eba\u8aaa\u8a71\u7684\u6e05\u6670\u9304\u97f3\uff0c\u9577\u5ea6\u70ba1\u523030\u79d2\u3002"
          }
        }
      }
    },
