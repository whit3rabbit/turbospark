          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u091a\u094d\u091a \u091c\u094b\u0916\u093f\u092e \u0935\u093e\u0932\u0947 \u0911\u092a\u0930\u0947\u0936\u0928 \u0915\u093e \u092a\u0924\u093e \u091a\u0932\u093e"
