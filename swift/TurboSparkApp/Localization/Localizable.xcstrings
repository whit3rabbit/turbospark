        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova tentativa de recupera\u00e7\u00e3o foi conclu\u00edda. Tentativa: %lld."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0430\u044f \u043f\u043e\u043f\u044b\u0442\u043a\u0430 \u0432\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u0438\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0430 \u0443\u0441\u043f\u0435\u0448\u043d\u043e. \u041f\u043e\u043f\u044b\u0442\u043a\u0430: %lld."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fa9\u65e7\u306e\u518d\u8a66\u884c\u306b\u6210\u529f\u3057\u307e\u3057\u305f\u3002\u8a66\u884c\u56de\u6570: %lld\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubcf5\uad6c \uc7ac\uc2dc\ub3c4\uc5d0 \uc131\uacf5\ud588\uc2b5\ub2c8\ub2e4. \uc2dc\ub3c4: %lld."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6062\u590d\u91cd\u8bd5\u6210\u529f\u3002\u5c1d\u8bd5\u6b21\u6570\uff1a%lld\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fa9\u539f\u91cd\u8a66\u6210\u529f\u3002\u5617\u8a66\u6b21\u6578\uff1a%lld\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0646\u062c\u062d\u062a \u0645\u062d\u0627\u0648\u0644\u0629 \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f. \u0627\u0644\u0645\u062d\u0627\u0648\u0644\u0629: %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0941\u0928\u0930\u094d\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u093f \u0915\u093e \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0938\u092b\u0932 \u0939\u0941\u0906\u0964 \u092a\u094d\u0930\u092f\u093e\u0938: %lld\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herstelpoging is geslaagd. Poging: %lld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponowna pr\u00f3ba odzyskiwania zako\u0144czy\u0142a si\u0119 powodzeniem. Pr\u00f3ba: %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma yeniden denemesi ba\u015far\u0131l\u0131 oldu. Deneme: %lld."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0442\u043e\u0440\u043d\u0430 \u0441\u043f\u0440\u043e\u0431\u0430 \u0432\u0456\u0434\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u044f \u0443\u0441\u043f\u0456\u0448\u043d\u0430. \u0421\u043f\u0440\u043e\u0431\u0430: %lld."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5terst\u00e4llningsf\u00f6rs\u00f6ket lyckades. F\u00f6rs\u00f6k: %lld."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1ea7n th\u1eed kh\u00f4i ph\u1ee5c \u0111\u00e3 th\u00e0nh c\u00f4ng. L\u1ea7n th\u1eed: %lld."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Percobaan pemulihan berhasil. Percobaan: %lld."
          }
        },
        "he": {
