        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyodr\u0119bnianie trwa\u0142ych wspomnie\u0144\u2026"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraindo mem\u00f3rias duradouras\u2026"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0432\u043b\u0435\u0447\u0435\u043d\u0438\u0435 \u0434\u043e\u043b\u0433\u043e\u0432\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u0432\u043e\u0441\u043f\u043e\u043c\u0438\u043d\u0430\u043d\u0438\u0439\u2026"
