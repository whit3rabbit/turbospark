            "state": "translated",
            "value": "\u0645\u0639\u0637\u0651\u0644. \u0644\u0627 \u064a\u064f\u0637\u0628\u064e\u0651\u0642 \u0623\u064a \u062a\u0639\u062f\u064a\u0644 \u0639\u0644\u0649 \u0627\u0644\u062a\u062f\u0641\u0642 \u0627\u0644\u0645\u062a\u0628\u0642\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus. Am Residualstrom wird nichts ver\u00e4ndert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off. No edit is applied to the residual stream."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado. No se aplica ninguna edici\u00f3n al flujo residual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9sactiv\u00e9. Aucune modification n'est appliqu\u00e9e au flux r\u00e9siduel."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05db\u05d1\u05d5\u05d9. \u05dc\u05d0 \u05de\u05d5\u05d7\u05dc \u05e9\u05d5\u05dd \u05e9\u05d9\u05e0\u05d5\u05d9 \u05e2\u05dc \u05d4\u05d6\u05e8\u05dd \u05d4\u05e9\u05d9\u05d5\u05e8\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0902\u0926\u0964 \u0930\u0947\u091c\u093c\u093f\u0921\u0941\u0905\u0932 \u0938\u094d\u091f\u094d\u0930\u0940\u092e \u092e\u0947\u0902 \u0915\u094b\u0908 \u092c\u0926\u0932\u093e\u0935 \u0932\u093e\u0917\u0942 \u0928\u0939\u0940\u0902 \u0939\u094b\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nonaktif. Tidak ada perubahan yang diterapkan ke aliran residual."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivo. Nessuna modifica viene applicata al flusso residuo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30aa\u30d5\u3002\u6b8b\u5dee\u30b9\u30c8\u30ea\u30fc\u30e0\u306b\u306f\u4f55\u3082\u5909\u66f4\u3092\u52a0\u3048\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uaebc\uc9d0. \uc794\ucc28 \uc2a4\ud2b8\ub9bc\uc5d0 \uc544\ubb34 \ubcc0\uacbd\ub3c4 \uc801\uc6a9\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit. Er wordt niets aan de residuele stroom gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wy\u0142\u0105czone. Strumie\u0144 rezydualny nie jest modyfikowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativado. Nenhuma edi\u00e7\u00e3o \u00e9 aplicada ao fluxo residual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u043a\u043b\u044e\u0447\u0435\u043d\u043e. \u041e\u0441\u0442\u0430\u0442\u043e\u0447\u043d\u044b\u0439 \u043f\u043e\u0442\u043e\u043a \u043d\u0435 \u0438\u0437\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Av. Ingen \u00e4ndring till\u00e4mpas p\u00e5 residualstr\u00f6mmen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapal\u0131. Art\u0131k ak\u0131\u015fa hi\u00e7bir d\u00fczenleme uygulanmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043c\u043a\u043d\u0435\u043d\u043e. \u0417\u0430\u043b\u0438\u0448\u043a\u043e\u0432\u0438\u0439 \u043f\u043e\u0442\u0456\u043a \u043d\u0435 \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1eaft. Kh\u00f4ng c\u00f3 ch\u1ec9nh s\u1eeda n\u00e0o \u0111\u01b0\u1ee3c \u00e1p d\u1ee5ng l\u00ean lu\u1ed3ng d\u01b0."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5173\u95ed\u3002\u4e0d\u4f1a\u5bf9\u6b8b\u5dee\u6d41\u505a\u4efb\u4f55\u4fee\u6539\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u95dc\u9589\u3002\u4e0d\u6703\u5c0d\u6b98\u5dee\u6d41\u505a\u4efb\u4f55\u4fee\u6539\u3002"
          }
        }
      }
    },
