    "No local model status available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u062a\u0648\u0641\u0631 \u062d\u0627\u0644\u0629 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0627\u0644\u0645\u062d\u0644\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein lokaler Modellstatus verf\u00fcgbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local model status available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay estado del modelo local disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun \u00e9tat du mod\u00e8le local disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05de\u05e6\u05d1 \u05de\u05d5\u05d3\u05dc \u05de\u05e7\u05d5\u05de\u05d9 \u05d6\u05de\u05d9\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092e\u0949\u0921\u0932 \u0938\u094d\u0925\u093f\u0924\u093f \u0909\u092a\u0932\u092c\u094d\u0927 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada status model lokal yang tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno stato del modello locale disponibile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ed\u30fc\u30ab\u30eb\u30e2\u30c7\u30eb\u306e\u30b9\u30c6\u30fc\u30bf\u30b9\u306f\u5229\u7528\u3067\u304d\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc0ac\uc6a9 \uac00\ub2a5\ud55c \ub85c\uceec \ubaa8\ub378 \uc0c1\ud0dc\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen lokale modelstatus beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dost\u0119pnego stanu modelu lokalnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum status de modelo local dispon\u00edvel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u0442\u0443\u0441 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u0435\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen lokal modellstatus tillg\u00e4nglig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerel model durumu mevcut de\u011fil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u0442\u0430\u043d \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u043e\u0457 \u043c\u043e\u0434\u0435\u043b\u0456 \u043d\u0435\u0434\u043e\u0441\u0442\u0443\u043f\u043d\u0438\u0439."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 tr\u1ea1ng th\u00e1i m\u00f4 h\u00ecnh c\u1ee5c b\u1ed9."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u53ef\u7528\u7684\u672c\u5730\u6a21\u578b\u72b6\u6001\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u53ef\u7528\u7684\u672c\u6a5f\u6a21\u578b\u72c0\u614b\u3002"
          }
        }
      }
    },
    "Install this model first. Then this card can check the vector's shape against its manifest before enabling it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u0645 \u0628\u062a\u062b\u0628\u064a\u062a \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0623\u0648\u0644\u0627\u064b. \u0628\u0639\u062f \u0630\u0644\u0643\u060c \u064a\u0645\u0643\u0646 \u0644\u0647\u0630\u0647 \u0627\u0644\u0628\u0637\u0627\u0642\u0629 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0634\u0643\u0644 \u0627\u0644\u0645\u062a\u062c\u0647 \u0645\u0642\u0627\u0628\u0644 \u0628\u064a\u0627\u0646\u0647 \u0642\u0628\u0644 \u062a\u0645\u0643\u064a\u0646\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie dieses Modell zuerst. Anschlie\u00dfend kann diese Karte die Vektorform anhand des Manifests pr\u00fcfen, bevor sie aktiviert wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install this model first. Then this card can check the vector's shape against its manifest before enabling it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala este modelo primero. Luego, esta tarjeta puede verificar la forma del vector con su manifiesto antes de habilitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez d'abord ce mod\u00e8le. Cette carte pourra ensuite v\u00e9rifier la forme du vecteur par rapport \u00e0 son manifeste avant de l'activer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05e7\u05df \u05de\u05d5\u05d3\u05dc \u05d6\u05d4 \u05ea\u05d7\u05d9\u05dc\u05d4. \u05dc\u05d0\u05d7\u05e8 \u05de\u05db\u05df \u05db\u05e8\u05d8\u05d9\u05e1 \u05d6\u05d4 \u05d9\u05d5\u05db\u05dc \u05dc\u05d1\u05d3\u05d5\u05e7 \u05d0\u05ea \u05e6\u05d5\u05e8\u05ea \u05d4\u05d5\u05d5\u05e7\u05d8\u05d5\u05e8 \u05de\u05d5\u05dc \u05d4\u05de\u05e0\u05d9\u05e4\u05e1\u05d8 \u05e9\u05dc\u05d5 \u05dc\u05e4\u05e0\u05d9 \u05d4\u05e4\u05e2\u05dc\u05ea\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0939\u0932\u0947 \u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u094b \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902\u0964 \u092b\u093f\u0930 \u092f\u0939 \u0915\u093e\u0930\u094d\u0921 \u0938\u0915\u094d\u0937\u092e \u0915\u0930\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0935\u0947\u0915\u094d\u091f\u0930 \u0915\u0947 \u0906\u0915\u093e\u0930 \u0915\u0940 \u0909\u0938\u0915\u0947 \u092e\u0948\u0928\u093f\u092b\u093c\u0947\u0938\u094d\u091f \u0938\u0947 \u091c\u093e\u0902\u091a \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang model ini terlebih dahulu. Kemudian kartu ini dapat memeriksa bentuk vektor terhadap manifesnya sebelum mengaktifkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa prima questo modello. Quindi questa scheda pu\u00f2 verificare la forma del vettore rispetto al suo manifesto prima di abilitarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6700\u521d\u306b\u3053\u306e\u30e2\u30c7\u30eb\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u304f\u3060\u3055\u3044\u3002\u305d\u306e\u5f8c\u3001\u3053\u306e\u30ab\u30fc\u30c9\u3067\u30de\u30cb\u30d5\u30a7\u30b9\u30c8\u3068\u30d9\u30af\u30c8\u30eb\u306e\u5f62\u72b6\u3092\u78ba\u8a8d\u3057\u3066\u304b\u3089\u6709\u52b9\u306b\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uba3c\uc800 \uc774 \ubaa8\ub378\uc744 \uc124\uce58\ud558\uc138\uc694. \uadf8\ub7ec\uba74 \uc774 \uce74\ub4dc\uc5d0\uc11c \ud65c\uc131\ud654\ud558\uae30 \uc804\uc5d0 \ubca1\ud130 \ud615\uc0c1\uc744 \ub9e4\ub2c8\ud398\uc2a4\ud2b8\uc640 \ube44\uad50\ud558\uc5ec \ud655\uc778\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer eerst dit model. Dan kan deze kaart de vorm van de vector verifi\u00ebren aan de hand van het manifest voordat deze wordt ingeschakeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zainstaluj ten model. Nast\u0119pnie ta karta mo\u017ce sprawdzi\u0107 kszta\u0142t wektora z manifestem przed jego w\u0142\u0105czeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale este modelo primeiro. Depois, este cart\u00e3o pode verificar a forma do vetor em rela\u00e7\u00e3o ao seu manifesto antes de ativ\u00e1-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u044d\u0442\u0443 \u043c\u043e\u0434\u0435\u043b\u044c. \u0417\u0430\u0442\u0435\u043c \u044d\u0442\u0430 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0441\u043c\u043e\u0436\u0435\u0442 \u043f\u0440\u043e\u0432\u0435\u0440\u0438\u0442\u044c \u0444\u043e\u0440\u043c\u0443 \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u043f\u043e \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u0443 \u043f\u0435\u0440\u0435\u0434 \u0435\u0433\u043e \u0432\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0435\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera denna modell f\u00f6rst. Sedan kan detta kort kontrollera vektorns form mot dess manifest innan den aktiveras."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6nce bu modeli y\u00fckleyin. Ard\u0131ndan bu kart, vekt\u00f6r\u00fc etkinle\u015ftirmeden \u00f6nce \u015feklini manifestosuyla kar\u015f\u0131la\u015ft\u0131rabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u0446\u044e \u043c\u043e\u0434\u0435\u043b\u044c. \u041f\u043e\u0442\u0456\u043c \u0446\u044f \u043a\u0430\u0440\u0442\u043a\u0430 \u0437\u043c\u043e\u0436\u0435 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0438\u0442\u0438 \u0444\u043e\u0440\u043c\u0443 \u0432\u0435\u043a\u0442\u043e\u0440\u0430 \u0437\u0430 \u0439\u043e\u0433\u043e \u043c\u0430\u043d\u0456\u0444\u0435\u0441\u0442\u043e\u043c \u043f\u0435\u0440\u0435\u0434 \u0443\u0432\u0456\u043c\u043a\u043d\u0435\u043d\u043d\u044f\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y c\u00e0i \u0111\u1eb7t m\u00f4 h\u00ecnh n\u00e0y tr\u01b0\u1edbc. Sau \u0111\u00f3 th\u1ebb n\u00e0y c\u00f3 th\u1ec3 ki\u1ec3m tra h\u00ecnh d\u1ea1ng vector so v\u1edbi b\u1ea3n k\u00ea khai tr\u01b0\u1edbc khi b\u1eadt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u5b89\u88c5\u6b64\u6a21\u578b\u3002\u7136\u540e\uff0c\u6b64\u5361\u7247\u53ef\u4ee5\u5728\u542f\u7528\u4e4b\u524d\u6839\u636e\u5176\u6e05\u5355\u68c0\u67e5\u5411\u91cf\u5f62\u72b6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u5b89\u88dd\u6b64\u6a21\u578b\u3002\u7136\u5f8c\uff0c\u6b64\u5361\u7247\u53ef\u4ee5\u5728\u555f\u7528\u4e4b\u524d\u6839\u64da\u5176\u6e05\u55ae\u6aa2\u67e5\u5411\u91cf\u5f62\u72c0\u3002"
          }
        }
      }
    },
    "Live steering edits activations at runtime. The model does not need to be pre-abliterated, but a refusal vector should be extracted for this exact checkpoint.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062a\u0648\u062c\u064a\u0647 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u064a\u062d\u0631\u0631 \u0627\u0644\u062a\u0646\u0634\u064a\u0637\u0627\u062a \u0623\u062b\u0646\u0627\u0621 \u0627\u0644\u062a\u0634\u063a\u064a\u0644. \u0644\u0627 \u064a\u0644\u0632\u0645 \u062a\u062c\u0631\u064a\u062f \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0645\u0633\u0628\u0642\u064b\u0627\u060c \u0648\u0644\u0643\u0646 \u064a\u062c\u0628 \u0627\u0633\u062a\u062e\u0631\u0627\u062c \u0645\u062a\u062c\u0647 \u0627\u0644\u0631\u0641\u0636 \u0644\u0646\u0642\u0637\u0629 \u0627\u0644\u0641\u062d\u0635 \u0647\u0630\u0647 \u0628\u0627\u0644\u0636\u0628\u0637."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-Steering bearbeitet Aktivierungen zur Laufzeit. Das Modell muss nicht vorab abliteriert werden, aber es sollte ein Weigerungsvektor f\u00fcr diesen exakten Pr\u00fcfpunkt extrahiert werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live steering edits activations at runtime. The model does not need to be pre-abliterated, but a refusal vector should be extracted for this exact checkpoint."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El direccionamiento en vivo edita las activaciones en tiempo de ejecuci\u00f3n. No es necesario desliterar el modelo previamente, pero se debe extraer un vector de rechazo para este punto de control exacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le guidage en direct modifie les activations \u00e0 l'ex\u00e9cution. Le mod\u00e8le n'a pas besoin d'\u00eatre pr\u00e9-oblit\u00e9r\u00e9, mais un vecteur de refus doit \u00eatre extrait pour ce point de contr\u00f4le exact."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d9\u05d2\u05d5\u05d9 \u05d7\u05d9 \u05e2\u05d5\u05e8\u05da \u05d4\u05e4\u05e2\u05dc\u05d5\u05ea \u05d1\u05d6\u05de\u05df \u05e8\u05d9\u05e6\u05d4. \u05d4\u05de\u05d5\u05d3\u05dc \u05d0\u05d9\u05e0\u05d5 \u05e6\u05e8\u05d9\u05da \u05dc\u05e2\u05d1\u05d5\u05e8 \u05d0\u05d1\u05dc\u05e6\u05d9\u05d4 \u05de\u05e8\u05d0\u05e9, \u05d0\u05da \u05d9\u05e9 \u05dc\u05d7\u05dc\u05e5 \u05d5\u05e7\u05d8\u05d5\u05e8 \u05e1\u05d9\u05e8\u05d5\u05d1 \u05e2\u05d1\u05d5\u05e8 \u05e0\u05e7\u05d5\u05d3\u05ea \u05d1\u05d3\u05d9\u05e7\u05d4 \u05de\u05d3\u05d5\u05d9\u05e7\u05ea \u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u093e\u0907\u0935 \u0938\u094d\u091f\u0940\u092f\u0930\u093f\u0902\u0917 \u0930\u0928\u091f\u093e\u0907\u092e \u092a\u0930 \u0938\u0915\u094d\u0930\u093f\u092f\u0923 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u092e\u0949\u0921\u0932 \u0915\u094b \u092a\u0939\u0932\u0947 \u0938\u0947 \u0928\u0937\u094d\u091f \u0915\u0930\u0928\u0947 \u0915\u0940 \u0906\u0935\u0936\u094d\u092f\u0915\u0924\u093e \u0928\u0939\u0940\u0902 \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u0907\u0938 \u0938\u091f\u0940\u0915 \u091a\u0947\u0915\u092a\u0949\u0907\u0902\u091f \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0907\u0928\u0915\u093e\u0930 \u0935\u0947\u0915\u094d\u091f\u0930 \u0928\u093f\u0915\u093e\u0932\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemudi langsung mengedit aktivasi saat runtime. Model tidak perlu di-ablitasi sebelumnya, tetapi vektor penolakan harus diekstrak untuk titik pemeriksaan yang tepat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo steering in tempo reale modifica le attivazioni in fase di esecuzione. Il modello non deve essere pre-obliterato, ma deve essere estratto un vettore di rifiuto per questo checkpoint esatto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u30b9\u30c6\u30a2\u30ea\u30f3\u30b0\u306f\u5b9f\u884c\u6642\u306b\u30a2\u30af\u30c6\u30a3\u30d9\u30fc\u30b7\u30e7\u30f3\u3092\u7de8\u96c6\u3057\u307e\u3059\u3002\u30e2\u30c7\u30eb\u306f\u4e8b\u524d\u306b\u9664\u53bb\u51e6\u7406\u3055\u308c\u3066\u3044\u308b\u5fc5\u8981\u306f\u3042\u308a\u307e\u305b\u3093\u304c\u3001\u3053\u306e\u6b63\u78ba\u306a\u30c1\u30a7\u30c3\u30af\u30dd\u30a4\u30f3\u30c8\u7528\u306b\u62d2\u5426\u30d9\u30af\u30c8\u30eb\u3092\u62bd\u51fa\u3059\u308b\u5fc5\u8981\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\uc2dc\uac04 \uc870\ud5a5\uc740 \ub7f0\ud0c0\uc784\uc5d0 \ud65c\uc131\ud654\ub97c \ud3b8\uc9d1\ud569\ub2c8\ub2e4. \ubaa8\ub378\uc744 \uc0ac\uc804 \uc81c\uac70\ud560 \ud544\uc694\ub294 \uc5c6\uc9c0\ub9cc, \uc774 \uc815\ud655\ud55c \uccb4\ud06c\ud3ec\uc778\ud2b8\uc5d0 \ub300\ud55c \uac70\ubd80 \ubca1\ud130\ub97c \ucd94\ucd9c\ud574\uc57c \ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Live-sturing bewerkt activaties tijdens runtime. Het model hoeft niet vooraf geabliteerd te zijn, maar er moet een weigeringsvector worden ge\u00ebxtraheerd voor dit exacte controlepunt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sterowanie na \u017cywo modyfikuje aktywacje w czasie wykonywania. Model nie musi by\u0107 wst\u0119pnie zablokowany, ale nale\u017cy wyodr\u0119bni\u0107 wektor odmowy dla tego konkretnego punktu kontrolnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O direcionamento din\u00e2mico edita ativa\u00e7\u00f5es em tempo de execu\u00e7\u00e3o. O modelo n\u00e3o precisa ser pr\u00e9-abliterado, mas um vetor de recusa deve ser extra\u00eddo para este ponto de verifica\u00e7\u00e3o exato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u0438\u043d\u0430\u043c\u0438\u0447\u0435\u0441\u043a\u043e\u0435 \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u0435 \u0438\u0437\u043c\u0435\u043d\u044f\u0435\u0442 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0438\u0438 \u0432\u043e \u0432\u0440\u0435\u043c\u044f \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u044f. \u041c\u043e\u0434\u0435\u043b\u044c \u043d\u0435 \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u044c\u043d\u043e \u0434\u043e\u043b\u0436\u043d\u0430 \u0431\u044b\u0442\u044c \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u043e \u043e\u0431\u0440\u0430\u0431\u043e\u0442\u0430\u043d\u0430, \u043d\u043e \u0432\u0435\u043a\u0442\u043e\u0440 \u043e\u0442\u043a\u0430\u0437\u0430 \u0434\u043e\u043b\u0436\u0435\u043d \u0431\u044b\u0442\u044c \u0438\u0437\u0432\u043b\u0435\u0447\u0435\u043d \u0438\u043c\u0435\u043d\u043d\u043e \u0434\u043b\u044f \u044d\u0442\u043e\u0439 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0439 \u0442\u043e\u0447\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktstyrning redigerar aktiveringar under k\u00f6rning. Modellen beh\u00f6ver inte vara f\u00f6rablitrerad, men en avvisningsvektor b\u00f6r extraheras f\u00f6r just denna kontrollpunkt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canl\u0131 y\u00f6nlendirme, \u00e7al\u0131\u015fma zaman\u0131nda etkinle\u015ftirmeleri d\u00fczenler. Modelin \u00f6nceden ar\u0131nd\u0131r\u0131lm\u0131\u015f olmas\u0131 gerekmez, ancak tam olarak bu kontrol noktas\u0131 i\u00e7in bir ret vekt\u00f6r\u00fc \u00e7\u0131kar\u0131lmal\u0131d\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u0435\u0440\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u043b\u044c\u043e\u0442\u0443 \u0437\u043c\u0456\u043d\u044e\u0454 \u0430\u043a\u0442\u0438\u0432\u0430\u0446\u0456\u0457 \u043f\u0456\u0434 \u0447\u0430\u0441 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f. \u041c\u043e\u0434\u0435\u043b\u044c \u043d\u0435 \u043e\u0431\u043e\u0432'\u044f\u0437\u043a\u043e\u0432\u043e \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e \u043e\u0431\u0440\u043e\u0431\u043b\u0435\u043d\u0430, \u0430\u043b\u0435 \u0432\u0435\u043a\u0442\u043e\u0440 \u0432\u0456\u0434\u043c\u043e\u0432\u0438 \u043c\u0430\u0454 \u0431\u0443\u0442\u0438 \u0432\u0438\u043b\u0443\u0447\u0435\u043d\u043e \u0441\u0430\u043c\u0435 \u0434\u043b\u044f \u0446\u0456\u0454\u0457 \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u043e\u0457 \u0442\u043e\u0447\u043a\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110i\u1ec1u h\u01b0\u1edbng tr\u1ef1c ti\u1ebfp ch\u1ec9nh s\u1eeda c\u00e1c k\u00edch ho\u1ea1t khi ch\u1ea1y. M\u00f4 h\u00ecnh kh\u00f4ng c\u1ea7n ph\u1ea3i x\u00f3a b\u1ecf tr\u01b0\u1edbc, nh\u01b0ng c\u1ea7n tr\u00edch xu\u1ea5t vector t\u1eeb ch\u1ed1i cho \u0111i\u1ec3m ki\u1ec3m tra ch\u00ednh x\u00e1c n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9e\u65f6\u5f15\u5bfc\u5728\u8fd0\u884c\u65f6\u7f16\u8f91\u6fc0\u6d3b\u3002\u6a21\u578b\u4e0d\u9700\u8981\u9884\u5148\u6d88\u878d\uff0c\u4f46\u5e94\u4e3a\u6b64\u786e\u5207\u7684\u68c0\u67e5\u70b9\u63d0\u53d6\u62d2\u7edd\u5411\u91cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5373\u6642\u5f15\u5c0e\u5728\u57f7\u884c\u968e\u6bb5\u7de8\u8f2f\u6fc0\u6d3b\u3002\u6a21\u578b\u4e0d\u9700\u8981\u9810\u5148\u6d88\u878d\uff0c\u4f46\u61c9\u70ba\u6b64\u78ba\u5207\u7684\u6aa2\u67e5\u9ede\u64f7\u53d6\u62d2\u7d55\u5411\u91cf\u3002"
          }
        }
      }
    },
    "No control vectors registered for this profile.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u0648\u062c\u062f \u0645\u062a\u062c\u0647\u0627\u062a \u062a\u062d\u0643\u0645 \u0645\u0633\u062c\u0644\u0629 \u0644\u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "F\u00fcr dieses Profil sind keine Kontrollvektoren registriert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No control vectors registered for this profile."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay vectores de control registrados para este perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun vecteur de contr\u00f4le enregistr\u00e9 pour ce profil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05d5\u05e7\u05d8\u05d5\u05e8\u05d9 \u05d1\u05e7\u05e8\u05d4 \u05e8\u05e9\u05d5\u05de\u05d9\u05dd \u05e2\u05d1\u05d5\u05e8 \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc \u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0935\u0947\u0915\u094d\u091f\u0930 \u092a\u0902\u091c\u0940\u0915\u0943\u0924 \u0928\u0939\u0940\u0902 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada vektor kontrol yang terdaftar untuk profil ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun vettore di controllo registrato per questo profilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u306b\u767b\u9332\u3055\u308c\u3066\u3044\u308b\u30b3\u30f3\u30c8\u30ed\u30fc\u30eb\u30d9\u30af\u30c8\u30eb\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub85c\ud544\uc5d0 \ub4f1\ub85d\ub41c \uc81c\uc5b4 \ubca1\ud130\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen controlevectoren geregistreerd voor dit profiel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak wektor\u00f3w kontrolnych zarejestrowanych dla tego profilu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum vetor de controle registrado para este perfil."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0438\u043b\u044f \u043d\u0435 \u0437\u0430\u0440\u0435\u0433\u0438\u0441\u0442\u0440\u0438\u0440\u043e\u0432\u0430\u043d\u044b \u0432\u0435\u043a\u0442\u043e\u0440\u044b \u0443\u043f\u0440\u0430\u0432\u043b\u0435\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga kontrollvektorer registrerade f\u00f6r denna profil."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu profil i\u00e7in kay\u0131tl\u0131 kontrol vekt\u00f6r\u00fc yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043f\u0440\u043e\u0444\u0456\u043b\u044e \u043d\u0435 \u0437\u0430\u0440\u0435\u0454\u0441\u0442\u0440\u043e\u0432\u0430\u043d\u043e \u043a\u043e\u043d\u0442\u0440\u043e\u043b\u044c\u043d\u0438\u0445 \u0432\u0435\u043a\u0442\u043e\u0440\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 vector \u0111i\u1ec1u khi\u1ec3n n\u00e0o \u0111\u01b0\u1ee3c \u0111\u0103ng k\u00fd cho h\u1ed3 s\u01a1 n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u4e2a\u4eba\u8d44\u6599\u672a\u6ce8\u518c\u63a7\u5236\u5411\u91cf\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u500b\u4eba\u6a94\u6848\u672a\u8a3b\u518a\u63a7\u5236\u5411\u91cf\u3002"
          }
        }
      }
    },
    "The selection is used when a model loads. A currently loaded session changes only after reload.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062a\u0645 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u062d\u062f\u064a\u062f \u0639\u0646\u062f \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c. \u062a\u062a\u063a\u064a\u0631 \u0627\u0644\u062c\u0644\u0633\u0629 \u0627\u0644\u0645\u062d\u0645\u0644\u0629 \u062d\u0627\u0644\u064a\u064b\u0627 \u0641\u0642\u0637 \u0628\u0639\u062f \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u062a\u062d\u0645\u064a\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Auswahl wird beim Laden eines Modells verwendet. Eine aktuell geladene Sitzung \u00e4ndert sich erst nach dem Neuladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The selection is used when a model loads. A currently loaded session changes only after reload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La selecci\u00f3n se usa al cargar un modelo. Una sesi\u00f3n cargada actualmente cambia solo despu\u00e9s de recargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La s\u00e9lection est utilis\u00e9e lors du chargement d'un mod\u00e8le. Une session actuellement charg\u00e9e ne change qu'apr\u00e8s rechargement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d1\u05d7\u05d9\u05e8\u05d4 \u05de\u05e9\u05de\u05e9\u05ea \u05d1\u05e2\u05ea \u05d8\u05e2\u05d9\u05e0\u05ea \u05de\u05d5\u05d3\u05dc. \u05d4\u05e4\u05e2\u05dc\u05d4 \u05d8\u05e2\u05d5\u05e0\u05d4 \u05db\u05e2\u05ea \u05de\u05e9\u05ea\u05e0\u05d4 \u05e8\u05e7 \u05dc\u05d0\u05d7\u05e8 \u05d8\u05e2\u05d9\u05e0\u05d4 \u05de\u05d7\u05d3\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0939\u094b\u0928\u0947 \u092a\u0930 \u091a\u092f\u0928 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u092e\u0947\u0902 \u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0938\u0924\u094d\u0930 \u0915\u0947\u0935\u0932 \u092a\u0941\u0928\u0903 \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926 \u092c\u0926\u0932\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilihan digunakan saat model dimuat. Sesi yang sedang dimuat hanya berubah setelah dimuat ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La selezione viene utilizzata quando viene caricato un modello. Una sessione attualmente caricata cambia solo dopo il ricaricamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u306e\u30ed\u30fc\u30c9\u6642\u306b\u9078\u629e\u304c\u4f7f\u7528\u3055\u308c\u307e\u3059\u3002\u73fe\u5728\u30ed\u30fc\u30c9\u3055\u308c\u3066\u3044\u308b\u30bb\u30c3\u30b7\u30e7\u30f3\u306f\u3001\u518d\u30ed\u30fc\u30c9\u5f8c\u306b\u306e\u307f\u5909\u66f4\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc774 \ub85c\ub4dc\ub420 \ub54c \uc120\ud0dd \ud56d\ubaa9\uc774 \uc0ac\uc6a9\ub429\ub2c8\ub2e4. \ud604\uc7ac \ub85c\ub4dc\ub41c \uc138\uc158\uc740 \ub2e4\uc2dc \ub85c\ub4dc\ud55c \ud6c4\uc5d0\ub9cc \ubcc0\uacbd\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De selectie wordt gebruikt wanneer een model laadt. Een momenteel geladen sessie verandert pas na opnieuw laden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyb\u00f3r jest u\u017cywany podczas \u0142adowania modelu. Aktualnie za\u0142adowana sesja zmienia si\u0119 dopiero po ponownym za\u0142adowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sele\u00e7\u00e3o \u00e9 usada quando um modelo \u00e9 carregado. Uma sess\u00e3o carregada no momento muda apenas ap\u00f3s o recarregamento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u043e\u0440 \u043f\u0440\u0438\u043c\u0435\u043d\u044f\u0435\u0442\u0441\u044f \u043f\u0440\u0438 \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435 \u043c\u043e\u0434\u0435\u043b\u0438. \u0422\u0435\u043a\u0443\u0449\u0430\u044f \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u043d\u0430\u044f \u0441\u0435\u0441\u0441\u0438\u044f \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u043f\u043e\u0441\u043b\u0435 \u043f\u0435\u0440\u0435\u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Valet anv\u00e4nds n\u00e4r en modell l\u00e4ses in. En f\u00f6r n\u00e4rvarande inl\u00e4st session \u00e4ndras f\u00f6rst efter oml\u00e4sning."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00e7im, bir model y\u00fcklendi\u011finde kullan\u0131l\u0131r. \u015eu anda y\u00fckl\u00fc olan oturum yaln\u0131zca yeniden y\u00fcklemeden sonra de\u011fi\u015fir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0456\u0440 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454\u0442\u044c\u0441\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f \u043c\u043e\u0434\u0435\u043b\u0456. \u041f\u043e\u0442\u043e\u0447\u043d\u0438\u0439 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u0438\u0439 \u0441\u0435\u0430\u043d\u0441 \u0437\u043c\u0456\u043d\u044e\u0454\u0442\u044c\u0441\u044f \u043b\u0438\u0448\u0435 \u043f\u0456\u0441\u043b\u044f \u043f\u0435\u0440\u0435\u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u1ef1a ch\u1ecdn \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng khi m\u00f4 h\u00ecnh t\u1ea3i. Phi\u00ean hi\u1ec7n \u0111ang t\u1ea3i ch\u1ec9 thay \u0111\u1ed5i sau khi t\u1ea3i l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u8f7d\u6a21\u578b\u65f6\u4f1a\u4f7f\u7528\u8be5\u9009\u62e9\u3002\u5f53\u524d\u5df2\u52a0\u8f7d\u7684\u4f1a\u8bdd\u4ec5\u5728\u91cd\u65b0\u52a0\u8f7d\u540e\u624d\u4f1a\u66f4\u6539\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f09\u5165\u6a21\u578b\u6642\u6703\u4f7f\u7528\u8a72\u9078\u64c7\u3002\u76ee\u524d\u5df2\u8f09\u5165\u7684\u6703\u8a71\u50c5\u5728\u91cd\u65b0\u8f09\u5165\u5f8c\u624d\u6703\u8b8a\u66f4\u3002"
          }
        }
      }
    },
