        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynak dosya art\u0131k \u00f6zg\u00fcn yolunda de\u011fil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0445\u0456\u0434\u043d\u0438\u0439 \u0444\u0430\u0439\u043b \u0431\u0456\u043b\u044c\u0448\u0435 \u043d\u0435 \u0437\u0430 \u0441\u0432\u043e\u0457\u043c \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u0438\u043c \u0448\u043b\u044f\u0445\u043e\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ec7p ngu\u1ed3n kh\u00f4ng c\u00f2n \u1edf \u0111\u01b0\u1eddng d\u1eabn ban \u0111\u1ea7u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6e90\u6587\u4ef6\u5df2\u4e0d\u5728\u5176\u539f\u59cb\u8def\u5f84\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f86\u6e90\u6a94\u6848\u5df2\u4e0d\u5728\u5176\u539f\u59cb\u8def\u5f91\u3002"
          }
        }
      }
    },
