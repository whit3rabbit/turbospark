    "Shown to the model in the agent listing and in Settings; state when this agent should be picked...": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0638\u0647\u0631 \u0644\u0644\u0646\u0645\u0648\u0630\u062c \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0648\u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a\u061b \u0627\u0630\u0643\u0631 \u0645\u062a\u0649 \u064a\u062c\u0628 \u0627\u062e\u062a\u064a\u0627\u0631 \u0647\u0630\u0627 \u0627\u0644\u0648\u0643\u064a\u0644\u2026"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird dem Modell in der Agentenliste und in den Einstellungen gezeigt; geben Sie an, wann dieser Agent gew\u00e4hlt werden soll\u2026"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shown to the model in the agent listing and in Settings; state when this agent should be picked..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se muestra al modelo en la lista de agentes y en Configuraci\u00f3n; indica cu\u00e1ndo debe elegirse este agente\u2026"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Affich\u00e9 au mod\u00e8le dans la liste des agents et dans les R\u00e9glages ; indiquez quand choisir cet agent\u2026"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d5\u05e6\u05d2 \u05dc\u05de\u05d5\u05d3\u05dc \u05d1\u05e8\u05e9\u05d9\u05de\u05ea \u05d4\u05e1\u05d5\u05db\u05e0\u05d9\u05dd \u05d5\u05d1\u05d4\u05d2\u05d3\u05e8\u05d5\u05ea; \u05e6\u05d9\u05d9\u05df \u05de\u05ea\u05d9 \u05dc\u05d1\u05d7\u05d5\u05e8 \u05d1\u05e1\u05d5\u05db\u05df \u05d4\u05d6\u05d4\u2026"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u091c\u0947\u0902\u091f \u0938\u0942\u091a\u0940 \u0914\u0930 \u0938\u0947\u091f\u093f\u0902\u0917 \u092e\u0947\u0902 \u092e\u0949\u0921\u0932 \u0915\u094b \u0926\u093f\u0916\u093e\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948; \u092c\u0924\u093e\u090f\u0901 \u0915\u093f \u0907\u0938 \u090f\u091c\u0947\u0902\u091f \u0915\u094b \u0915\u092c \u091a\u0941\u0928\u093e \u091c\u093e\u0928\u093e \u091a\u093e\u0939\u093f\u090f\u2026"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditampilkan ke model di daftar agen dan di Pengaturan; jelaskan kapan agen ini harus dipilih\u2026"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrato al modello nell\u2019elenco degli agenti e nelle Impostazioni; indica quando scegliere questo agente\u2026"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u4e00\u89a7\u3068\u8a2d\u5b9a\u3067\u30e2\u30c7\u30eb\u306b\u8868\u793a\u3055\u308c\u307e\u3059\u3002\u3053\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u3092\u9078\u3076\u3079\u304d\u5834\u9762\u3092\u66f8\u3044\u3066\u304f\u3060\u3055\u3044\u2026"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5d0\uc774\uc804\ud2b8 \ubaa9\ub85d\uacfc \uc124\uc815\uc5d0\uc11c \ubaa8\ub378\uc5d0 \ud45c\uc2dc\ub429\ub2c8\ub2e4. \uc774 \uc5d0\uc774\uc804\ud2b8\ub97c \uc120\ud0dd\ud574\uc57c \ud558\ub294 \uacbd\uc6b0\ub97c \uc801\uc73c\uc138\uc694\u2026"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt aan het model getoond in de agentlijst en in Instellingen; geef aan wanneer deze agent gekozen moet worden\u2026"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Widoczne dla modelu na li\u015bcie agent\u00f3w i w Ustawieniach; opisz, kiedy wybra\u0107 tego agenta\u2026"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrado ao modelo na lista de agentes e em Ajustes; diga quando este agente deve ser escolhido\u2026"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430\u0437\u044b\u0432\u0430\u0435\u0442\u0441\u044f \u043c\u043e\u0434\u0435\u043b\u0438 \u0432 \u0441\u043f\u0438\u0441\u043a\u0435 \u0430\u0433\u0435\u043d\u0442\u043e\u0432 \u0438 \u0432 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0430\u0445; \u0443\u043a\u0430\u0436\u0438\u0442\u0435, \u043a\u043e\u0433\u0434\u0430 \u0432\u044b\u0431\u0438\u0440\u0430\u0442\u044c \u044d\u0442\u043e\u0433\u043e \u0430\u0433\u0435\u043d\u0442\u0430\u2026"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visas f\u00f6r modellen i agentlistan och i Inst\u00e4llningar; ange n\u00e4r den h\u00e4r agenten ska v\u00e4ljas\u2026"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajan listesinde ve Ayarlar'da modele g\u00f6sterilir; bu ajan\u0131n ne zaman se\u00e7ilmesi gerekti\u011fini belirtin\u2026"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430\u0437\u0443\u0454\u0442\u044c\u0441\u044f \u043c\u043e\u0434\u0435\u043b\u0456 \u0443 \u0441\u043f\u0438\u0441\u043a\u0443 \u0430\u0433\u0435\u043d\u0442\u0456\u0432 \u0456 \u0432 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f\u0445; \u0432\u043a\u0430\u0436\u0456\u0442\u044c, \u043a\u043e\u043b\u0438 \u043e\u0431\u0438\u0440\u0430\u0442\u0438 \u0446\u044c\u043e\u0433\u043e \u0430\u0433\u0435\u043d\u0442\u0430\u2026"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi\u1ec3n th\u1ecb cho m\u00f4 h\u00ecnh trong danh s\u00e1ch t\u00e1c t\u1eed v\u00e0 trong C\u00e0i \u0111\u1eb7t; n\u00eau khi n\u00e0o n\u00ean ch\u1ecdn t\u00e1c t\u1eed n\u00e0y\u2026"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u667a\u80fd\u4f53\u5217\u8868\u548c\u8bbe\u7f6e\u4e2d\u5411\u6a21\u578b\u663e\u793a\uff1b\u8bf4\u660e\u4f55\u65f6\u5e94\u9009\u62e9\u6b64\u667a\u80fd\u4f53\u2026"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u4ee3\u7406\u5217\u8868\u8207\u8a2d\u5b9a\u4e2d\u5411\u6a21\u578b\u986f\u793a\uff1b\u8aaa\u660e\u4f55\u6642\u61c9\u9078\u64c7\u6b64\u4ee3\u7406\u2026"
          }
        }
      }
    },
