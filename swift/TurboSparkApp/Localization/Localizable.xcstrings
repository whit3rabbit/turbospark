    "Load a model to see the reasoning levels its chat template accepts.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062d\u0645\u0651\u0644 \u0646\u0645\u0648\u0630\u062c\u0627 \u0644\u0639\u0631\u0636 \u0645\u0633\u062a\u0648\u064a\u0627\u062a \u0627\u0644\u062a\u0641\u0643\u064a\u0631 \u0627\u0644\u062a\u064a \u064a\u0642\u0628\u0644\u0647\u0627 \u0642\u0627\u0644\u0628 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629 \u0627\u0644\u062e\u0627\u0635 \u0628\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Laden Sie ein Modell, um die Denkstufen zu sehen, die seine Chat-Vorlage akzeptiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Load a model to see the reasoning levels its chat template accepts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Carga un modelo para ver los niveles de razonamiento que acepta su plantilla de chat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chargez un mod\u00e8le pour voir les niveaux de raisonnement accept\u00e9s par son mod\u00e8le de discussion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d8\u05e2\u05df \u05de\u05d5\u05d3\u05dc \u05db\u05d3\u05d9 \u05dc\u05e8\u05d0\u05d5\u05ea \u05d0\u05d9\u05dc\u05d5 \u05e8\u05de\u05d5\u05ea \u05d7\u05e9\u05d9\u05d1\u05d4 \u05ea\u05d1\u05e0\u05d9\u05ea \u05d4\u05e9\u05d9\u05d7\u05d4 \u05e9\u05dc\u05d5 \u05de\u05e7\u05d1\u05dc\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0915\u0930\u0947\u0902 \u0924\u093e\u0915\u093f \u0909\u0938\u0915\u0940 \u091a\u0948\u091f \u091f\u0947\u092e\u094d\u092a\u0932\u0947\u091f \u0926\u094d\u0935\u093e\u0930\u093e \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u093f\u090f \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0947 \u0930\u0940\u091c\u093c\u0928\u093f\u0902\u0917 \u0938\u094d\u0924\u0930 \u0926\u093f\u0916 \u0938\u0915\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Muat model untuk melihat level penalaran yang diterima template obrolannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Carica un modello per vedere i livelli di ragionamento accettati dal suo modello di chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u3092\u8aad\u307f\u8fbc\u3080\u3068\u3001\u305d\u306e\u30c1\u30e3\u30c3\u30c8\u30c6\u30f3\u30d7\u30ec\u30fc\u30c8\u304c\u53d7\u3051\u4ed8\u3051\u308b\u63a8\u8ad6\u30ec\u30d9\u30eb\u304c\u8868\u793a\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc744 \ub85c\ub4dc\ud558\uba74 \ud574\ub2f9 \ucc44\ud305 \ud15c\ud50c\ub9bf\uc774 \ud5c8\uc6a9\ud558\ub294 \ucd94\ub860 \uc218\uc900\uc744 \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laad een model om te zien welke redeneerniveaus de chatsjabloon accepteert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytaj model, aby zobaczy\u0107 poziomy rozumowania akceptowane przez jego szablon czatu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carregue um modelo para ver os n\u00edveis de racioc\u00ednio que o template de chat dele aceita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c, \u0447\u0442\u043e\u0431\u044b \u0443\u0432\u0438\u0434\u0435\u0442\u044c \u0443\u0440\u043e\u0432\u043d\u0438 \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u0439, \u043a\u043e\u0442\u043e\u0440\u044b\u0435 \u043f\u0440\u0438\u043d\u0438\u043c\u0430\u0435\u0442 \u0435\u0435 \u0447\u0430\u0442-\u0448\u0430\u0431\u043b\u043e\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00e4s in en modell f\u00f6r att se vilka resonemangsniv\u00e5er dess chattmall accepterar."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sohbet \u015fablonunun kabul etti\u011fi ak\u0131l y\u00fcr\u00fctme d\u00fczeylerini g\u00f6rmek i\u00e7in bir model y\u00fckleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c, \u0449\u043e\u0431 \u043f\u043e\u0431\u0430\u0447\u0438\u0442\u0438 \u0440\u0456\u0432\u043d\u0456 \u043c\u0456\u0440\u043a\u0443\u0432\u0430\u043d\u044c, \u044f\u043a\u0456 \u043f\u0440\u0438\u0439\u043c\u0430\u0454 \u0457\u0457 \u0447\u0430\u0442-\u0448\u0430\u0431\u043b\u043e\u043d."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ea3i m\u1ed9t m\u00f4 h\u00ecnh \u0111\u1ec3 xem c\u00e1c m\u1ee9c suy lu\u1eadn m\u00e0 m\u1eabu tr\u00f2 chuy\u1ec7n c\u1ee7a n\u00f3 ch\u1ea5p nh\u1eadn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u8f7d\u6a21\u578b\u5373\u53ef\u67e5\u770b\u5176\u5bf9\u8bdd\u6a21\u677f\u63a5\u53d7\u7684\u63a8\u7406\u7ea7\u522b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8f09\u5165\u6a21\u578b\u5373\u53ef\u6aa2\u8996\u5176\u5c0d\u8a71\u7bc4\u672c\u63a5\u53d7\u7684\u63a8\u7406\u7b49\u7d1a\u3002"
          }
        }
      }
    },
