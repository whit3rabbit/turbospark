          "stringUnit": {
            "state": "translated",
            "value": "%@ \u306eSOUL.md\u3092\u8aad\u307f\u8fbc\u307f\u307e\u3057\u305f\u3002\u4f7f\u7528\u3059\u308b\u306b\u306fSOUL.md\u3092\u6709\u52b9\u306b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
