          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria originale potrebbe elencare ancora questo modello. Il modello funziona dalla sua nuova posizione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "元のライブラリの一覧にこのモデルが残っている場合があります。モデルは新しい場所から問題なく使えます。"
