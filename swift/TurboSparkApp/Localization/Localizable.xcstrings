        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0441\u0442\u0443\u043f\u043d\u0456\u0441\u0442\u044c, ID \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0456 \u0432\u0435\u0440\u0441\u0456\u044f \u0440\u0443\u0448\u0456\u044f."
