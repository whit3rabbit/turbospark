            "value": "Stopped. The rewrite is incomplete."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0648\u0642\u0651\u0641. \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0635\u064a\u0627\u063a\u0629 \u063a\u064a\u0631 \u0645\u0643\u062a\u0645\u0644\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestoppt. Die Umschreibung ist unvollst\u00e4ndig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detenido. La reescritura est\u00e1 incompleta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arr\u00eat\u00e9. La r\u00e9\u00e9criture est incompl\u00e8te."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05e2\u05e6\u05e8. \u05d4\u05d2\u05e8\u05e1\u05d4 \u05d4\u05de\u05d7\u05d5\u05d3\u05e9\u05ea \u05d0\u05d9\u05e0\u05d4 \u05de\u05dc\u05d0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u094b\u0915\u093e \u0917\u092f\u093e\u0964 \u092a\u0941\u0928\u0930\u094d\u0932\u0947\u0916\u0928 \u0905\u0927\u0942\u0930\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihentikan. Hasil tulis ulang belum lengkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrotto. La riscrittura \u00e8 incompleta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u505c\u6b62\u3057\u307e\u3057\u305f\u3002\u66f8\u304d\u76f4\u3057\u306f\u672a\u5b8c\u4e86\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc911\uc9c0\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \ub2e4\uc2dc \uc4f4 \uae00\uc774 \uc644\uc131\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestopt. De herschrijving is onvolledig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymano. Przepisany tekst jest niekompletny."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompido. A reescrita est\u00e1 incompleta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e. \u041f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442 \u043d\u0435\u043f\u043e\u043b\u043d\u044b\u0439."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppad. Omskrivningen \u00e4r ofullst\u00e4ndig."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Durduruldu. Yeniden yaz\u0131m tamamlanmad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0443\u043f\u0438\u043d\u0435\u043d\u043e. \u041f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442 \u043d\u0435\u043f\u043e\u0432\u043d\u0438\u0439."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 d\u1eebng. B\u1ea3n vi\u1ebft l\u1ea1i ch\u01b0a ho\u00e0n ch\u1ec9nh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u505c\u6b62\u3002\u6539\u5199\u4e0d\u5b8c\u6574\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u505c\u6b62\u3002\u6539\u5beb\u4e0d\u5b8c\u6574\u3002"
          }
        }
      }
    },
    "The draft has changed. Highlights compare with the version used for this rewrite.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The draft has changed. Highlights compare with the version used for this rewrite."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u063a\u064a\u0651\u0631\u062a \u0627\u0644\u0645\u0633\u0648\u062f\u0629. \u062a\u0642\u0627\u0631\u0646 \u0627\u0644\u062a\u0645\u064a\u064a\u0632\u0627\u062a \u0628\u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u062a\u064a \u0627\u0633\u062a\u064f\u062e\u062f\u0645\u062a \u0644\u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0635\u064a\u0627\u063a\u0629 \u0647\u0630\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Entwurf wurde ge\u00e4ndert. Die Markierungen vergleichen mit der Version, die f\u00fcr diese Umschreibung verwendet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El borrador ha cambiado. Los resaltados comparan con la versi\u00f3n usada para esta reescritura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le brouillon a chang\u00e9. Les surlignages comparent avec la version utilis\u00e9e pour cette r\u00e9\u00e9criture."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d8\u05d9\u05d5\u05d8\u05d4 \u05d4\u05e9\u05ea\u05e0\u05ea\u05d4. \u05d4\u05d4\u05d3\u05d2\u05e9\u05d5\u05ea \u05de\u05e9\u05d5\u05d5\u05ea \u05dc\u05d2\u05e8\u05e1\u05d4 \u05e9\u05e9\u05d9\u05de\u05e9\u05d4 \u05dc\u05e9\u05db\u05ea\u05d5\u05d1 \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0921\u094d\u0930\u093e\u092b\u093c\u094d\u091f \u092c\u0926\u0932 \u0917\u092f\u093e \u0939\u0948\u0964 \u0939\u093e\u0907\u0932\u093e\u0907\u091f \u0907\u0938 \u092a\u0941\u0928\u0930\u094d\u0932\u0947\u0916\u0928 \u092e\u0947\u0902 \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u0917\u090f \u0938\u0902\u0938\u094d\u0915\u0930\u0923 \u0938\u0947 \u0924\u0941\u0932\u0928\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Draf telah berubah. Sorotan dibandingkan dengan versi yang dipakai untuk tulis ulang ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La bozza \u00e8 cambiata. Le evidenziazioni confrontano con la versione usata per questa riscrittura."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0b\u66f8\u304d\u304c\u5909\u66f4\u3055\u308c\u307e\u3057\u305f\u3002\u30cf\u30a4\u30e9\u30a4\u30c8\u306f\u3053\u306e\u66f8\u304d\u76f4\u3057\u306b\u4f7f\u3063\u305f\u7248\u3068\u306e\u6bd4\u8f03\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucd08\uc548\uc774 \ubcc0\uacbd\ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uac15\uc870 \ud45c\uc2dc\ub294 \uc774\ubc88 \ub2e4\uc2dc \uc4f0\uae30\uc5d0 \uc0ac\uc6a9\ub41c \ubc84\uc804\uacfc \ube44\uad50\ud55c \uac83\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het concept is gewijzigd. De markeringen vergelijken met de versie die voor deze herschrijving is gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wersja robocza si\u0119 zmieni\u0142a. Wyr\u00f3\u017cnienia por\u00f3wnuj\u0105 z wersj\u0105 u\u017cyt\u0105 do tego przepisania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O rascunho mudou. Os destaques comparam com a vers\u00e3o usada nesta reescrita."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0435\u0440\u043d\u043e\u0432\u0438\u043a \u0438\u0437\u043c\u0435\u043d\u0438\u043b\u0441\u044f. \u0412\u044b\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0441\u0440\u0430\u0432\u043d\u0438\u0432\u0430\u0435\u0442 \u0441 \u0432\u0435\u0440\u0441\u0438\u0435\u0439, \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u043e\u0432\u0430\u043d\u043d\u043e\u0439 \u0434\u043b\u044f \u044d\u0442\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u043d\u0438\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utkastet har \u00e4ndrats. Markeringarna j\u00e4mf\u00f6r med versionen som anv\u00e4ndes f\u00f6r den h\u00e4r omskrivningen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslak de\u011fi\u015fti. Vurgular, bu yeniden yaz\u0131m i\u00e7in kullan\u0131lan s\u00fcr\u00fcmle kar\u015f\u0131la\u015ft\u0131r\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0427\u0435\u0440\u043d\u0435\u0442\u043a\u0443 \u0437\u043c\u0456\u043d\u0435\u043d\u043e. \u0412\u0438\u0434\u0456\u043b\u0435\u043d\u043d\u044f \u043f\u043e\u0440\u0456\u0432\u043d\u044e\u044e\u0442\u044c \u0456\u0437 \u0432\u0435\u0440\u0441\u0456\u0454\u044e, \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043e\u044e \u0434\u043b\u044f \u0446\u044c\u043e\u0433\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0443\u0432\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n nh\u00e1p \u0111\u00e3 thay \u0111\u1ed5i. Ph\u1ea7n t\u00f4 s\u00e1ng so v\u1edbi phi\u00ean b\u1ea3n \u0111\u00e3 d\u00f9ng cho l\u1ea7n vi\u1ebft l\u1ea1i n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8349\u7a3f\u5df2\u66f4\u6539\u3002\u9ad8\u4eae\u663e\u793a\u7684\u662f\u4e0e\u672c\u6b21\u6539\u5199\u6240\u7528\u7248\u672c\u7684\u5bf9\u6bd4\u3002"
          }
        },
