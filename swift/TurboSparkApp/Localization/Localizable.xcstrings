          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u751f\u6210\u5df2\u7ed3\u675f\uff0c\u4f46\u6ca1\u6709\u7ed3\u679c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
