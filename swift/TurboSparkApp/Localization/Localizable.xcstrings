    "An export entry has an unsafe path.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062d\u062a\u0648\u064a \u0623\u062d\u062f \u0625\u062f\u062e\u0627\u0644\u0627\u062a \u0627\u0644\u062a\u0635\u062f\u064a\u0631 \u0639\u0644\u0649 \u0645\u0633\u0627\u0631 \u063a\u064a\u0631 \u0622\u0645\u0646."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Exporteintrag hat einen unsicheren Pfad."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An export entry has an unsafe path."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una entrada de la exportaci\u00f3n tiene una ruta no segura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une entr\u00e9e de l'exportation a un chemin non s\u00fbr."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0\u05d7\u05ea \u05de\u05e8\u05e9\u05d5\u05de\u05d5\u05ea \u05d4\u05d9\u05d9\u05e6\u05d5\u05d0 \u05d9\u05e9 \u05e0\u05ea\u05d9\u05d1 \u05dc\u05d0 \u05d1\u05d8\u05d5\u05d7."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u0915\u0940 \u090f\u0915 \u092a\u094d\u0930\u0935\u093f\u0937\u094d\u091f\u093f \u0915\u093e \u092a\u0925 \u0905\u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebuah entri ekspor memiliki jalur yang tidak aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una voce dell'esportazione ha un percorso non sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f8\u304d\u51fa\u3057\u306e\u9805\u76ee\u306b\u5b89\u5168\u3067\u306a\u3044\u30d1\u30b9\u304c\u3042\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub0b4\ubcf4\ub0b4\uae30 \ud56d\ubaa9\uc5d0 \uc548\uc804\ud558\uc9c0 \uc54a\uc740 \uacbd\ub85c\uac00 \uc788\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
