        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d5\u05d3\u05dc \u05d7\u05d5\u05e9\u05d1 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d4\u05d5\u05d0 \u05de\u05e4\u05d9\u05e7 \u05ea\u05e9\u05d5\u05d1\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0909\u0924\u094d\u0924\u0930 \u0926\u0947\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0924\u0930\u094d\u0915 \u0915\u0930 \u0930\u0939\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model sedang bernalar sebelum menghasilkan respons"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello sta ragionando prima di rispondere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u306f\u5fdc\u7b54\u3092\u751f\u6210\u3059\u308b\u524d\u306b\u63a8\u8ad6\u3057\u3066\u3044\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
