            "value": "Kh\u00f4ng c\u00f3 b\u1ed9 nh\u1edb \u0111\u00e3 duy\u1ec7t n\u00e0o kh\u1edbp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u5339\u914d\u7684\u5df2\u6279\u51c6\u8bb0\u5fc6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u76f8\u7b26\u7684\u5df2\u6838\u51c6\u8a18\u61b6\u3002"
