            "value": "継続用のプロンプトがモデルのコンテキストウィンドウに収まらなくなりました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이어쓰기 프롬프트가 더 이상 모델 컨텍스트 창에 맞지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervolgprompt past niet meer in het contextvenster van het model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt kontynuacji nie mieści się już w oknie kontekstu modelu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prompt de continuação não cabe mais na janela de contexto do modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос продолжения больше не помещается в контекстное окно модели."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortsättningsprompten får inte längre plats i modellens kontextfönster."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam istemi artık modelin bağlam penceresine sığmıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит продовження більше не вміщується в контекстне вікно моделі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời nhắc tiếp tục không còn vừa với cửa sổ ngữ cảnh của mô hình."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续写提示已无法放入模型的上下文窗口。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "續寫提示已無法放入模型的上下文視窗。"
          }
        }
      }
    },
    "The conversation '%@' will be removed. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستتم إزالة المحادثة '%@'. لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konversation „%@“ wird entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The conversation '%@' will be removed. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
