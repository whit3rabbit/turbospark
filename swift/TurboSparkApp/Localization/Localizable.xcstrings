    "Everything here runs on your Mac. Nothing leaves it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything here runs on your Mac. Nothing leaves it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo esto se ejecuta en tu Mac. Nada sale de él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout s'exécute sur votre Mac. Rien n'en sort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles läuft auf deinem Mac. Nichts verlässt ihn."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto gira sul tuo Mac. Niente esce da qui."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo roda no seu Mac. Nada sai daqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё работает на вашем Mac. Ничего не покидает его."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてこのMac上で動作します。外部には何も送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 작업은 이 Mac에서 실행됩니다. 밖으로 나가는 것은 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在你的 Mac 上运行，没有任何数据离开本机。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "一切都在你的 Mac 上執行，沒有任何資料離開本機。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل شيء يعمل على جهاز Mac الخاص بك. لا شيء يغادره."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הכול רץ על ה-Mac שלך. שום דבר לא יוצא ממנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सब आपके Mac पर चलता है। कुछ भी बाहर नहीं जाता।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles draait op je Mac. Er gaat niets naar buiten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko działa na Twoim Macu. Nic go nie opuszcza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey Mac'inizde çalışır. Hiçbir şey dışarı çıkmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе працює на вашому Mac. Ніщо його не залишає."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Allt körs på din Mac. Ingenting lämnar den."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi thứ chạy trên máy Mac của bạn. Không có gì rời khỏi máy."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semuanya berjalan di Mac Anda. Tidak ada yang keluar."
          }
        }
      }
    },
