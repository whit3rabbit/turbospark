    "When a tool call is denied (by the user or by permissions)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0646\u062f \u0631\u0641\u0636 \u0627\u0633\u062a\u062f\u0639\u0627\u0621 \u0623\u062f\u0627\u0629 (\u0645\u0646 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0623\u0648 \u0628\u0633\u0628\u0628 \u0627\u0644\u0623\u0630\u0648\u0646\u0627\u062a)"
          }
        },
        "de": {
