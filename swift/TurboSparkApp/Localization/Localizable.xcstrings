            "state": "translated",
            "value": "\u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0627\u0644\u062a\u0644\u0642\u0627\u0626\u064a\u0629 \u0639\u0644\u0649 \u0627\u0644\u0623\u062f\u0648\u0627\u062a (\u062a\u062e\u0637\u064a \u0627\u0644\u0645\u0637\u0627\u0644\u0628\u0629 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0629)"
