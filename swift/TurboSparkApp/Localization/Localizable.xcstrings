    "Sets the sources and live text, and files new takes into a matching collection.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضبط المصادر والنص المباشر، ويضع التسجيلات الجديدة في المجموعة المطابقة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt Quellen und Live-Text fest und ordnet neue Aufnahmen der passenden Sammlung zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets the sources and live text, and files new takes into a matching collection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Define las fuentes y el texto en directo, y guarda las nuevas tomas en la colección correspondiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit les sources et le texte en direct, et range les nouvelles prises dans la collection correspondante."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגדיר את המקורות ואת הטקסט החי, ומתייק הקלטות חדשות באוסף המתאים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्रोत और लाइव टेक्स्ट सेट करता है, और नई रिकॉर्डिंग को मिलते-जुलते संग्रह में रखता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengatur sumber dan teks langsung, serta menyimpan rekaman baru ke koleksi yang sesuai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta le sorgenti e il testo in diretta e archivia le nuove registrazioni nella raccolta corrispondente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入力元とライブテキストを設定し、新しい録音を対応するコレクションに整理します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입력 소스와 실시간 텍스트를 설정하고 새 녹음을 맞는 컬렉션에 정리합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de bronnen en live tekst in en zet nieuwe opnamen in de bijbehorende collectie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia źródła i tekst na żywo oraz zapisuje nowe nagrania w pasującej kolekcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define as fontes e o texto ao vivo e arquiva as novas gravações na coleção correspondente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Задаёт источники и текст в реальном времени и помещает новые записи в подходящую коллекцию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställer in källor och livetext och sorterar nya inspelningar i en matchande samling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaynakları ve canlı metni ayarlar, yeni kayıtları eşleşen koleksiyona yerleştirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Задає джерела й текст наживо та додає нові записи до відповідної колекції."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt nguồn và văn bản trực tiếp, đồng thời xếp bản ghi mới vào bộ sưu tập phù hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置输入源和实时文字，并将新录音归入对应的合集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "設定輸入來源與即時文字，並將新錄音歸入對應的收藏。"
          }
        }
      }
    },
