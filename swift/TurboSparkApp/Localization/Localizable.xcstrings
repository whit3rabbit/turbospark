          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0942\u0932\u094d\u0938 \u0915\u094b \u0938\u094d\u0935\u091a\u093e\u0932\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0915\u0930\u0947\u0902 (\u0938\u0902\u0935\u093e\u0926\u093e\u0924\u094d\u092e\u0915 \u0938\u0902\u0915\u0947\u0924 \u091b\u094b\u0921\u093c\u0947\u0902)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setujui Alat Secara Otomatis (lewati perintah interaktif)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approva automaticamente gli strumenti (salta richiesta interattiva)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c4\u30fc\u30eb\u3092\u81ea\u52d5\u627f\u8a8d\uff08\u5bfe\u8a71\u578b\u30d7\u30ed\u30f3\u30d7\u30c8\u3092\u30b9\u30ad\u30c3\u30d7\uff09"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub3c4\uad6c \uc790\ub3d9 \uc2b9\uc778(\ub300\ud654\ud615 \ud504\ub86c\ud504\ud2b8 \uac74\ub108\ub6f0\uae30)"
          }
        },
        "nl": {
