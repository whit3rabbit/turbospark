        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0636\u0645\u064a\u0646 \u0647\u0630\u0627 \u0627\u0644\u0645\u0633\u0627\u0631 \u0641\u064a \u0641\u062d\u0635 \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0645\u062c\u062f\u062f\u064b\u0627"
