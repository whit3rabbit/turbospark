    "Installed on %@, which is not connected. Connect the drive to use it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثبَّت على %@، وهو غير متصل. صِل محرك الأقراص لاستخدامه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installiert auf %@, das nicht verbunden ist. Schließen Sie das Laufwerk an, um es zu verwenden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Installed on %@, which is not connected. Connect the drive to use it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado en %@, que no está conectado. Conecta la unidad para usarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé sur %@, qui n'est pas connecté. Connectez le disque pour l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מותקן ב-%@, שאינו מחובר. חבר את הכונן כדי להשתמש בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर इंस्टॉल है, जो कनेक्ट नहीं है। उपयोग करने के लिए ड्राइव कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terpasang di %@, yang tidak terhubung. Hubungkan drive untuk menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installato su %@, che non è collegato. Collega l'unità per usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にインストールされていますが、接続されていません。使用するにはドライブを接続してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@에 설치되어 있지만 연결되어 있지 않습니다. 사용하려면 드라이브를 연결하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geïnstalleerd op %@, dat niet is aangesloten. Sluit de schijf aan om het te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zainstalowano na %@, który nie jest podłączony. Podłącz dysk, aby z tego korzystać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instalado em %@, que não está conectado. Conecte a unidade para usá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Установлено на %@, который не подключён. Подключите диск, чтобы использовать модель."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installerad på %@, som inte är ansluten. Anslut enheten för att använda den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
