    "Only the Default user exists. Add one below to give it its own settings, chats, and skills.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the Default user exists. Add one below to give it its own settings, chats, and skills."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo existe el usuario predeterminado. Añade uno abajo para darle sus propios ajustes, chats y habilidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l'utilisateur par défaut existe. Ajoutez-en un ci-dessous pour lui donner ses propres réglages, discussions et compétences."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es existiert nur der Standardbenutzer. Fügen Sie unten einen hinzu, um ihm eigene Einstellungen, Chats und Skills zu geben."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esiste solo l'utente predefinito. Aggiungine uno qui sotto per dargli impostazioni, chat e competenze proprie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Existe apenas o usuário padrão. Adicione um abaixo para dar a ele configurações, chats e habilidades próprios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Существует только пользователь по умолчанию. Добавьте пользователя ниже, чтобы у него были свои настройки, чаты и навыки."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "既定のユーザーしか存在しません。独自の設定、チャット、スキルを持たせるには、下から追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 사용자만 있습니다. 아래에서 사용자를 추가하면 자체 설정, 대화, 스킬을 갖게 됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有默认用户。在下方添加一个用户，即可让其拥有独立的设置、对话和技能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前只有預設使用者。在下方新增一個使用者，即可讓其擁有獨立的設定、對話與技能。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يوجد سوى المستخدم الافتراضي. أضف مستخدما أدناه ليحصل على إعداداته ومحادثاته ومهاراته الخاصة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיים רק משתמש ברירת המחדל. הוסף משתמש למטה כדי שיהיו לו הגדרות, שיחות ומיומנויות משלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल डिफ़ॉल्ट उपयोगकर्ता मौजूद है। नीचे एक जोड़ें ताकि उसे अपनी सेटिंग्स, चैट और स्किल मिल सकें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de standaardgebruiker bestaat. Voeg er hieronder een toe om die eigen instellingen, chats en skills te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Istnieje tylko użytkownik domyślny. Dodaj poniżej kolejnego, aby miał własne ustawienia, czaty i umiejętności."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca varsayılan kullanıcı var. Kendi ayarları, sohbetleri ve becerileri olması için aşağıdan bir kullanıcı ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Існує лише типовий користувач. Додайте нижче ще одного, щоб він мав власні налаштування, чати й навички."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Endast standardanvändaren finns. Lägg till en nedan för att ge den egna inställningar, chattar och färdigheter."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ có người dùng mặc định. Thêm một người dùng bên dưới để họ có cài đặt, cuộc trò chuyện và kỹ năng riêng."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pengguna Default yang ada. Tambahkan satu di bawah agar memiliki pengaturan, obrolan, dan keterampilan sendiri."
          }
        }
      }
    },
