    "Import from Other Agents": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0645\u0646 \u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0627\u0644\u0623\u062e\u0631\u0649"
          }
        },
        "de": {
