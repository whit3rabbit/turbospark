    "Sets duration to maximum context limit (9,000 frames / 360s) supported by your hardware.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sets duration to maximum context limit (9,000 frames / 360s) supported by your hardware."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajusta la duración al límite máximo de contexto (9.000 fotogramas / 360 s) compatible con tu hardware."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit la durée sur la limite maximale du contexte (9 000 trames / 360s) prise en charge par votre matériel."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Setzt die Dauer auf das von Ihrer Hardware unterstützte maximale Kontextlimit (9.000 Frames / 360 s)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta la durata sul limite massimo di contesto (9.000 frame / 360s) supportato dal tuo hardware."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define a duração para o limite máximo de contexto (9.000 quadros / 360s) suportado pelo seu hardware."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt de duur in op de maximale contextlimiet (9.000 frames / 360s) die door uw hardware wordt ondersteund."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ställer in varaktigheten till den maximala kontextgränsen (9 000 bildrutor / 360s) som stöds av din hårdvara."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustawia czas trwania na maksymalny limit kontekstu (9000 klatek / 360 s) obsługiwany przez Twój sprzęt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливает максимальную продолжительность (9 000 кадров / 360 с), поддерживаемую вашим оборудованием."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлює тривалість на максимальну межу контексту (9 000 кадрів / 360 с), яку підтримує ваше обладнання."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Süreyi donanımınız tarafından desteklenen maksimum bağlam sınırına (9.000 kare / 360 sn) ayarlar."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لضبط المدة على الحد الأقصى للسياق (9,000 إطار / 360 ثانية) الذي يدعمه جهازك."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגדיר את משך הזמן למגבלת ההקשר המרבית (9,000 פריימים / 360 שניות) הנתמכת על ידי החומרה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अवधि को आपके हार्डवेयर द्वारा समर्थित अधिकतम संदर्भ सीमा (9,000 फ़्रेम / 360s) पर सेट करता है।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将时长设置为硬件支持的最大上下文限制 (9,000 帧 / 360秒)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將時長設定為硬體支援的最大上下文限制 (9,000 幀 / 360秒)。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間をハードウェアでサポートされる最大コンテキスト制限 (9,000 フレーム / 360秒) に設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "재생 시간을 하드웨어에서 지원하는 최대 컨텍스트 제한(9,000 프레임 / 360초)으로 설정합니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đặt thời lượng thành giới hạn ngữ cảnh tối đa (9.000 khung hình / 360 giây) được phần cứng hỗ trợ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyetel durasi ke batas konteks maksimum (9.000 bingkai / 360 detik) yang didukung perangkat keras Anda."
          }
        }
      }
    },
