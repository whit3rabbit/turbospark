        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Examen termin\u00e9. Le rapport est disponible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d1\u05d3\u05d9\u05e7\u05d4 \u05d4\u05d5\u05e9\u05dc\u05de\u05d4. \u05d4\u05d3\u05d5\u05d7 \u05d6\u05de\u05d9\u05df."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091c\u093e\u0902\u091a \u092a\u0942\u0930\u0940 \u0939\u0941\u0908\u0964 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\u0964"
