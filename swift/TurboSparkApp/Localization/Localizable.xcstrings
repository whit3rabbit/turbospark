        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub85c\uc81d\ud2b8\uc758 \ud604\uc7ac AGENTS.md, CLAUDE.md, CONTEXT.md, SOUL.md \ud30c\uc77c \ud655\uc778"
