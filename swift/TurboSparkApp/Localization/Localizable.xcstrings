    "Memory cost per window is unavailable for this model.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Memory cost per window is unavailable for this model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El coste de memoria por ventana no está disponible para este modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le coût mémoire par fenêtre n'est pas disponible pour ce modèle."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Speicherbedarf pro Fenster ist für dieses Modell nicht verfügbar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il costo di memoria per finestra non è disponibile per questo modello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O custo de memória por janela não está disponível para este modelo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Расход памяти на окно недоступен для этой модели."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このモデルではウィンドウごとのメモリ使用量を取得できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 모델은 창별 메모리 비용을 확인할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型无法获取每个窗口的内存开销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型無法取得每個視窗的記憶體開銷。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تكلفة الذاكرة لكل نافذة غير متاحة لهذا النموذج."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עלות הזיכרון לכל חלון אינה זמינה עבור מודל זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मॉडल के लिए प्रति विंडो मेमोरी लागत उपलब्ध नहीं है।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het geheugengebruik per venster is niet beschikbaar voor dit model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koszt pamięci na okno jest niedostępny dla tego modelu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu model için pencere başına bellek maliyeti yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Витрати пам'яті на вікно недоступні для цієї моделі."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Minnesåtgången per fönster är inte tillgänglig för den här modellen."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
