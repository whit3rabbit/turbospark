    "This will permanently remove the model files (%@) from disk at:\n%@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u064a\u0624\u062f\u064a \u0647\u0630\u0627 \u0625\u0644\u0649 \u0625\u0632\u0627\u0644\u0629 \u0645\u0644\u0641\u0627\u062a \u0627\u0644\u0646\u0645\u0648\u0630\u062c (%@) \u0646\u0647\u0627\u0626\u064a\u064b\u0627 \u0645\u0646 \u0627\u0644\u0642\u0631\u0635 \u0641\u064a:\n%@"
