        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u0928\u093f\u0930\u094d\u092f\u093e\u0924 \u092e\u093e\u0928\u0915 ZIP \u0906\u0915\u093e\u0930 \u0938\u0940\u092e\u093e \u0938\u0947 \u0905\u0927\u093f\u0915 \u0939\u0948\u0964"
