    "Ready to assist with code, reasoning, or ideas.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062c\u0627\u0647\u0632 \u0644\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0641\u064a \u0627\u0644\u0628\u0631\u0645\u062c\u0629 \u0648\u0627\u0644\u0627\u0633\u062a\u0646\u062a\u0627\u062c \u0648\u0627\u0644\u0623\u0641\u0643\u0627\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereit zur Unterst\u00fctzung bei Code, Logik oder Ideen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ready to assist with code, reasoning, or ideas."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Listo para ayudar con c\u00f3digo, razonamiento o ideas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pr\u00eat \u00e0 vous aider avec du code, du raisonnement ou des id\u00e9es."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d5\u05db\u05df \u05dc\u05e2\u05d6\u05d5\u05e8 \u05e2\u05dd \u05e7\u05d5\u05d3, \u05d7\u05e9\u05d9\u05d1\u05d4 \u05d0\u05d5 \u05e8\u05e2\u05d9\u05d5\u05e0\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0921, \u0924\u0930\u094d\u0915 \u092f\u093e \u0935\u093f\u091a\u093e\u0930\u094b\u0902 \u092e\u0947\u0902 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Siap membantu dengan kode, penalaran, atau ide."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto ad aiutarti con codice, ragionamento o idee."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30b3\u30fc\u30c9\u3001\u63a8\u8ad6\u3001\u30a2\u30a4\u30c7\u30a2\u306e\u30b5\u30dd\u30fc\u30c8\u6e96\u5099\u304c\u6574\u3044\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucf54\ub4dc, \ucd94\ub860, \uc544\uc774\ub514\uc5b4 \uc791\uc5c5\uc744 \ub3c4\uc6b8 \uc900\ube44\uac00 \ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klaar om te helpen met code, redeneren of idee\u00ebn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gotowy do pomocy przy kodzie, rozumowaniu lub pomys\u0142ach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pronto para ajudar com c\u00f3digo, racioc\u00ednio ou ideias."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u0442\u043e\u0432 \u043f\u043e\u043c\u043e\u0447\u044c \u0441 \u043a\u043e\u0434\u043e\u043c, \u0440\u0430\u0441\u0441\u0443\u0436\u0434\u0435\u043d\u0438\u044f\u043c\u0438 \u0438\u043b\u0438 \u0438\u0434\u0435\u044f\u043c\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Redo att hj\u00e4lpa till med kod, resonemang eller id\u00e9er."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod, mant\u0131k veya fikirler konusunda yard\u0131ma haz\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0413\u043e\u0442\u043e\u0432\u0438\u0439 \u0434\u043e\u043f\u043e\u043c\u043e\u0433\u0442\u0438 \u0437 \u043a\u043e\u0434\u043e\u043c, \u043b\u043e\u0433\u0456\u043a\u043e\u044e \u0447\u0438 \u0456\u0434\u0435\u044f\u043c\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u1eb5n s\u00e0ng h\u1ed7 tr\u1ee3 v\u1ec1 m\u00e3, l\u1eadp lu\u1eadn ho\u1eb7c \u00fd t\u01b0\u1edfng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u51c6\u5907\u597d\u534f\u52a9\u60a8\u5904\u7406\u4ee3\u7801\u3001\u63a8\u7406\u6216\u521b\u610f\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6e96\u5099\u597d\u5354\u52a9\u60a8\u8655\u7406\u7a0b\u5f0f\u78bc\u3001\u63a8\u7406\u6216\u5275\u610f\u3002"
          }
        }
      }
    },
