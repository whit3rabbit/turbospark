            "value": "Ollama \u5f62\u5f0f\u306e\u30e2\u30c7\u30eb\u4e00\u89a7\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama \ud615\uc2dd\uc758 \ubaa8\ub378 \ubaa9\ub85d."
          }
        },
        "nl": {
