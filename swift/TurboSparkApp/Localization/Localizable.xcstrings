    "%@ is not playing audio. Start playback in it, then try again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u0634\u063a\u0651\u0644 %@ \u0623\u064a \u0635\u0648\u062a. \u0627\u0628\u062f\u0623 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0641\u064a\u0647 \u062b\u0645 \u062d\u0627\u0648\u0644 \u0645\u0631\u0629 \u0623\u062e\u0631\u0649."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gibt kein Audio wieder. Starte die Wiedergabe und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not playing audio. Start playback in it, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no est\u00e1 reproduciendo audio. Inicia la reproducci\u00f3n y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne lit aucun son. Lancez la lecture, puis r\u00e9essayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u05d0\u05d9\u05e0\u05d5 \u05de\u05e0\u05d2\u05df \u05e9\u05de\u05e2. \u05d4\u05ea\u05d7\u05dc \u05e0\u05d9\u05d2\u05d5\u05df \u05d5\u05e0\u05e1\u05d4 \u05e9\u05d5\u05d1."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u0911\u0921\u093f\u092f\u094b \u0928\u0939\u0940\u0902 \u091a\u0932\u093e \u0930\u0939\u093e \u0939\u0948\u0964 \u0909\u0938\u092e\u0947\u0902 \u092a\u094d\u0932\u0947\u092c\u0948\u0915 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902, \u092b\u093f\u0930 \u092a\u0941\u0928\u0903 \u092a\u094d\u0930\u092f\u093e\u0938 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tidak memutar audio. Mulai pemutaran, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non sta riproducendo audio. Avvia la riproduzione, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u306f\u30aa\u30fc\u30c7\u30a3\u30aa\u3092\u518d\u751f\u3057\u3066\u3044\u307e\u305b\u3093\u3002\u518d\u751f\u3092\u958b\u59cb\u3057\u3066\u304b\u3089\u3001\u3082\u3046\u4e00\u5ea6\u304a\u8a66\u3057\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uc5d0\uc11c \uc624\ub514\uc624\uac00 \uc7ac\uc0dd\ub418\uace0 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc7ac\uc0dd\uc744 \uc2dc\uc791\ud55c \ud6c4 \ub2e4\uc2dc \uc2dc\ub3c4\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ speelt geen audio af. Start het afspelen en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nie odtwarza d\u017awi\u0119ku. Rozpocznij odtwarzanie i spr\u00f3buj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n\u00e3o est\u00e1 reproduzindo \u00e1udio. Inicie a reprodu\u00e7\u00e3o e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u043d\u0435 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0438\u0442 \u0437\u0432\u0443\u043a. \u041d\u0430\u0447\u043d\u0438\u0442\u0435 \u0432\u043e\u0441\u043f\u0440\u043e\u0438\u0437\u0432\u0435\u0434\u0435\u043d\u0438\u0435 \u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u0438\u0442\u0435 \u043f\u043e\u043f\u044b\u0442\u043a\u0443."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ spelar inte upp ljud. Starta uppspelningen och f\u00f6rs\u00f6k igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ses \u00e7alm\u0131yor. \u0130\u00e7inde oynatmay\u0131 ba\u015flat\u0131n, ard\u0131ndan tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u043d\u0435 \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u044e\u0454 \u0437\u0432\u0443\u043a. \u041f\u043e\u0447\u043d\u0456\u0442\u044c \u0432\u0456\u0434\u0442\u0432\u043e\u0440\u0435\u043d\u043d\u044f \u0442\u0430 \u0441\u043f\u0440\u043e\u0431\u0443\u0439\u0442\u0435 \u0449\u0435 \u0440\u0430\u0437."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kh\u00f4ng ph\u00e1t \u00e2m thanh. H\u00e3y b\u1eaft \u0111\u1ea7u ph\u00e1t r\u1ed3i th\u1eed l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u672a\u5728\u64ad\u653e\u97f3\u9891\u3002\u8bf7\u5148\u5f00\u59cb\u64ad\u653e\uff0c\u7136\u540e\u91cd\u8bd5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ \u672a\u5728\u64ad\u653e\u97f3\u8a0a\u3002\u8acb\u5148\u958b\u59cb\u64ad\u653e\uff0c\u7136\u5f8c\u518d\u8a66\u4e00\u6b21\u3002"
          }
        }
      }
    },
