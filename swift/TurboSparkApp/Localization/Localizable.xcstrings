            "state": "translated",
            "value": "\u30b3\u30f3\u30c6\u30ad\u30b9\u30c8\u30a8\u30f3\u30b8\u30f3\u306e\u30c7\u30fc\u30bf\u3092\u6d88\u53bb"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucee8\ud14d\uc2a4\ud2b8 \uc5d4\uc9c4 \ub370\uc774\ud130 \uc9c0\uc6b0\uae30"
          }
        },
