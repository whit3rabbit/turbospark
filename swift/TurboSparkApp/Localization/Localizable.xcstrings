        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um rascunho para reescrever."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0441\u0442\u0430\u0432\u044c\u0442\u0435 \u0447\u0435\u0440\u043d\u043e\u0432\u0438\u043a, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u043d\u0443\u0436\u043d\u043e \u043f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u0442\u044c."
