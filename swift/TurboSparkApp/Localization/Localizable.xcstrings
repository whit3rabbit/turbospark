          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profil \"%@\" importé depuis la sauvegarde. Basculez vers ce profil pour commencer à l'utiliser."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפרופיל \"%@\" יובא מגיבוי. עבור אליו כדי להתחיל להשתמש בו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोफ़ाइल \"%@\" बैकअप से आयात की गई। इसका उपयोग शुरू करने के लिए इस पर स्विच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
