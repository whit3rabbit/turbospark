        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen resonerar innan den svarar"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yan\u0131t \u00fcretmeden \u00f6nce ak\u0131l y\u00fcr\u00fct\u00fcyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c \u043c\u0456\u0440\u043a\u0443\u0454, \u043f\u0435\u0440\u0448 \u043d\u0456\u0436 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0441\u0442\u0438"
