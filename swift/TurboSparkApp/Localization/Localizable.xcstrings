    "Batch MCP tool calls inside one sandboxed script.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u062c\u0645\u064a\u0639 \u0627\u0633\u062a\u062f\u0639\u0627\u0621\u0627\u062a \u0623\u062f\u0648\u0627\u062a MCP \u062f\u0627\u062e\u0644 \u0646\u0635 \u0628\u0631\u0645\u062c\u064a \u0648\u0627\u062d\u062f \u0645\u0639\u0632\u0648\u0644."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fcndelt MCP-Tool-Aufrufe in einem einzigen isolierten Skript."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Batch MCP tool calls inside one sandboxed script."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa las llamadas a herramientas MCP en un \u00fanico script aislado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Regroupe les appels d\u2019outils MCP dans un seul script isol\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d0\u05d2\u05d3 \u05e7\u05e8\u05d9\u05d0\u05d5\u05ea \u05dc\u05db\u05dc\u05d9 MCP \u05d1\u05ea\u05d5\u05da \u05e1\u05e7\u05e8\u05d9\u05e4\u05d8 \u05de\u05d1\u05d5\u05d3\u05d3 \u05d0\u05d7\u05d3."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP \u091f\u0942\u0932 \u0915\u0949\u0932 \u0915\u094b \u090f\u0915 \u0938\u0948\u0902\u0921\u092c\u0949\u0915\u094d\u0938\u094d\u0921 \u0938\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f \u092e\u0947\u0902 \u090f\u0915 \u0938\u093e\u0925 \u091a\u0932\u093e\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menggabungkan panggilan alat MCP dalam satu skrip terisolasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Raggruppa le chiamate agli strumenti MCP in un unico script isolato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP \u30c4\u30fc\u30eb\u547c\u3073\u51fa\u3057\u3092 1 \u3064\u306e\u30b5\u30f3\u30c9\u30dc\u30c3\u30af\u30b9\u5316\u3055\u308c\u305f\u30b9\u30af\u30ea\u30d7\u30c8\u306b\u307e\u3068\u3081\u3066\u5b9f\u884c\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP \ub3c4\uad6c \ud638\ucd9c\uc744 \ud558\ub098\uc758 \uc0cc\ub4dc\ubc15\uc2a4 \uc2a4\ud06c\ub9bd\ud2b8\uc5d0\uc11c \uc77c\uad04 \uc2e4\ud589\ud569\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bundelt MCP-toolaanroepen in \u00e9\u00e9n ge\u00efsoleerd script."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Grupuje wywo\u0142ania narz\u0119dzi MCP w jednym odizolowanym skrypcie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Agrupa chamadas de ferramentas MCP em um \u00fanico script isolado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u044a\u0435\u0434\u0438\u043d\u044f\u0435\u0442 \u0432\u044b\u0437\u043e\u0432\u044b \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432 MCP \u0432 \u043e\u0434\u043d\u043e\u043c \u0438\u0437\u043e\u043b\u0438\u0440\u043e\u0432\u0430\u043d\u043d\u043e\u043c \u0441\u043a\u0440\u0438\u043f\u0442\u0435."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Samlar MCP-verktygsanrop i ett enda isolerat skript."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "MCP ara\u00e7 \u00e7a\u011fr\u0131lar\u0131n\u0131 tek bir yal\u0131t\u0131lm\u0131\u015f betikte toplu olarak \u00e7al\u0131\u015ft\u0131r\u0131r."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0431\u2019\u0454\u0434\u043d\u0443\u0454 \u0432\u0438\u043a\u043b\u0438\u043a\u0438 \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0456\u0432 MCP \u0432 \u043e\u0434\u043d\u043e\u043c\u0443 \u0456\u0437\u043e\u043b\u044c\u043e\u0432\u0430\u043d\u043e\u043c\u0443 \u0441\u043a\u0440\u0438\u043f\u0442\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u1ed9p c\u00e1c l\u1ec7nh g\u1ecdi c\u00f4ng c\u1ee5 MCP v\u00e0o m\u1ed9t t\u1eadp l\u1ec7nh c\u00e1ch ly duy nh\u1ea5t."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u5355\u4e2a\u6c99\u76d2\u811a\u672c\u4e2d\u6279\u91cf\u6267\u884c MCP \u5de5\u5177\u8c03\u7528\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u55ae\u4e00\u6c99\u76d2\u6307\u4ee4\u78bc\u4e2d\u6279\u6b21\u57f7\u884c MCP \u5de5\u5177\u547c\u53eb\u3002"
          }
        }
      }
    },
