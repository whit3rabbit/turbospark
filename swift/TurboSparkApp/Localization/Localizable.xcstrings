        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0434\u0430\u0447\u0430 \u043f\u0435\u0440\u0435\u043c\u0435\u043d\u043d\u044b\u0445 \u043e\u043a\u0440\u0443\u0436\u0435\u043d\u0438\u044f (\u043f\u043e \u043e\u0434\u043d\u043e\u043c\u0443 \u0418\u041c\u0415\u041d\u0418 \u0432 \u0441\u0442\u0440\u043e\u043a\u0435)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidarebefordran av milj\u00f6variabler (ett variabelNAMN per rad)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ortam aktar\u0131m\u0131 (her sat\u0131rda bir de\u011fi\u015fken ADI)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u0434\u0430\u0432\u0430\u043d\u043d\u044f \u0437\u043c\u0456\u043d\u043d\u0438\u0445 \u0441\u0435\u0440\u0435\u0434\u043e\u0432\u0438\u0449\u0430 (\u043f\u043e \u043e\u0434\u043d\u043e\u043c\u0443 \u0406\u041c\u0415\u041d\u0406 \u0432 \u0440\u044f\u0434\u043a\u0443)"
          }
        },
        "vi": {
