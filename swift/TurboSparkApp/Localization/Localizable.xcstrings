    "e.g. Lint before tool use, Auto-format on edit...": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062b\u0644: \u0641\u062d\u0635 \u0642\u0628\u0644 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u062f\u0627\u0629\u060c \u062a\u0646\u0633\u064a\u0642 \u062a\u0644\u0642\u0627\u0626\u064a \u0639\u0646\u062f \u0627\u0644\u062a\u0639\u062f\u064a\u0644\u2026"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "z. B. Lint vor Tool-Nutzung, automatisches Formatieren beim Bearbeiten\u2026"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "e.g. Lint before tool use, Auto-format on edit..."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ej., lint antes de usar herramientas, formato autom\u00e1tico al editar\u2026"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "p. ex. lint avant l\u2019utilisation d\u2019un outil, mise en forme automatique \u00e0 la modification\u2026"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d3\u05d5\u05d2\u05de\u05d4: \u05d1\u05d3\u05d9\u05e7\u05ea lint \u05dc\u05e4\u05e0\u05d9 \u05e9\u05d9\u05de\u05d5\u05e9 \u05d1\u05db\u05dc\u05d9, \u05e2\u05d9\u05e6\u05d5\u05d1 \u05d0\u05d5\u05d8\u05d5\u05de\u05d8\u05d9 \u05d1\u05e2\u05e8\u05d9\u05db\u05d4\u2026"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0926\u093e. \u091f\u0942\u0932 \u0909\u092a\u092f\u094b\u0917 \u0938\u0947 \u092a\u0939\u0932\u0947 lint, \u0938\u0902\u092a\u093e\u0926\u0928 \u092a\u0930 \u0911\u091f\u094b-\u092b\u093c\u0949\u0930\u094d\u092e\u0947\u091f\u2026"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "mis. Lint sebelum memakai alat, format otomatis saat mengedit\u2026"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "ad es. lint prima dell\u2019uso degli strumenti, formattazione automatica in modifica\u2026"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f8b: \u30c4\u30fc\u30eb\u4f7f\u7528\u524d\u306e lint\u3001\u7de8\u96c6\u6642\u306e\u81ea\u52d5\u30d5\u30a9\u30fc\u30de\u30c3\u30c8\u2026"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc608: \ub3c4\uad6c \uc0ac\uc6a9 \uc804 lint, \ud3b8\uc9d1 \uc2dc \uc790\ub3d9 \uc11c\uc2dd\u2026"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "bijv. lint v\u00f3\u00f3r toolgebruik, automatisch opmaken bij bewerken\u2026"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "np. lint przed u\u017cyciem narz\u0119dzia, automatyczne formatowanie przy edycji\u2026"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "ex.: lint antes de usar ferramentas, formata\u00e7\u00e3o autom\u00e1tica ao editar\u2026"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440, lint \u043f\u0435\u0440\u0435\u0434 \u0432\u044b\u0437\u043e\u0432\u043e\u043c \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430, \u0430\u0432\u0442\u043e\u0444\u043e\u0440\u043c\u0430\u0442\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u0435 \u043f\u0440\u0438 \u043f\u0440\u0430\u0432\u043a\u0435\u2026"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "t.ex. lint f\u00f6re verktygsanv\u00e4ndning, autoformatering vid redigering\u2026"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00f6r. Ara\u00e7 kullan\u0131m\u0131ndan \u00f6nce lint, d\u00fczenlemede otomatik bi\u00e7imlendirme\u2026"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434, lint \u043f\u0435\u0440\u0435\u0434 \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u0430\u043d\u043d\u044f\u043c \u0456\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u0430, \u0430\u0432\u0442\u043e\u0444\u043e\u0440\u043c\u0430\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u0456\u0434 \u0447\u0430\u0441 \u0440\u0435\u0434\u0430\u0433\u0443\u0432\u0430\u043d\u043d\u044f\u2026"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "v\u00ed d\u1ee5: lint tr\u01b0\u1edbc khi d\u00f9ng c\u00f4ng c\u1ee5, t\u1ef1 \u0111\u1ecbnh d\u1ea1ng khi s\u1eeda\u2026"
