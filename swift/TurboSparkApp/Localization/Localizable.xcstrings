            "state": "translated",
            "value": "\u5fa9\u539f\u7e7c\u627f\u7684\u4f86\u6e90"
          }
        }
      }
    },
    "Restores theme mode, colors, fonts, text size, dock icon, and every preference on this pane. Saved themes are kept.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0633\u062a\u0639\u064a\u062f \u0648\u0636\u0639 \u0627\u0644\u0633\u0645\u0629 \u0648\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0648\u0627\u0644\u062e\u0637\u0648\u0637 \u0648\u062d\u062c\u0645 \u0627\u0644\u0646\u0635 \u0648\u0623\u064a\u0642\u0648\u0646\u0629 Dock \u0648\u062c\u0645\u064a\u0639 \u0627\u0644\u062a\u0641\u0636\u064a\u0644\u0627\u062a \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u062c\u0632\u0621. \u064a\u062a\u0645 \u0627\u0644\u0627\u062d\u062a\u0641\u0627\u0638 \u0628\u0627\u0644\u0633\u0645\u0627\u062a \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Designmodus, Farben, Schriften, Textgr\u00f6\u00dfe, Dock-Symbol und alle Einstellungen in diesem Bereich wieder her. Gespeicherte Designs bleiben erhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores theme mode, colors, fonts, text size, dock icon, and every preference on this pane. Saved themes are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el modo de tema, colores, fuentes, tama\u00f1o de texto, icono del Dock y todas las preferencias de este panel. Se conservan los temas guardados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure le mode de th\u00e8me, les couleurs, les polices, la taille du texte, l'ic\u00f4ne du Dock et toutes les pr\u00e9f\u00e9rences de ce panneau. Les th\u00e8mes enregistr\u00e9s sont conserv\u00e9s."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e9\u05d7\u05d6\u05e8 \u05de\u05e6\u05d1 \u05e2\u05e8\u05db\u05ea \u05e0\u05d5\u05e9\u05d0, \u05e6\u05d1\u05e2\u05d9\u05dd, \u05d2\u05d5\u05e4\u05e0\u05d9\u05dd, \u05d2\u05d5\u05d3\u05dc \u05d8\u05e7\u05e1\u05d8, \u05e1\u05de\u05dc Dock \u05d5\u05db\u05dc \u05d4\u05e2\u05d3\u05e4\u05d4 \u05d1\u05d7\u05dc\u05d5\u05e0\u05d9\u05ea \u05d6\u05d5. \u05e2\u05e8\u05db\u05d5\u05ea \u05e0\u05d5\u05e9\u05d0 \u05e9\u05de\u05d5\u05e8\u05d5\u05ea \u05d9\u05d9\u05e9\u05de\u05e8\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0925\u0940\u092e \u092e\u094b\u0921, \u0930\u0902\u0917, \u092b\u093c\u0949\u0928\u094d\u091f, \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0906\u0915\u093e\u0930, \u0921\u0949\u0915 \u0906\u0907\u0915\u0928 \u0914\u0930 \u0907\u0938 \u092b\u0932\u0915 \u0915\u0940 \u0938\u092d\u0940 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e\u0913\u0902 \u0915\u094b \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0938\u0939\u0947\u091c\u0940 \u0917\u0908 \u0925\u0940\u092e \u092c\u0928\u0940 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan mode tema, warna, font, ukuran teks, ikon Dock, dan setiap preferensi pada panel ini. Tema yang disimpan tetap dipertahankan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina modalit\u00e0 tema, colori, caratteri, dimensioni testo, icona Dock e tutte le preferenze di questo riquadro. I temi salvati vengono mantenuti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c6\u30fc\u30de\u30e2\u30fc\u30c9\u3001\u8272\u3001\u30d5\u30a9\u30f3\u30c8\u3001\u30c6\u30ad\u30b9\u30c8\u30b5\u30a4\u30ba\u3001Dock \u30a2\u30a4\u30b3\u30f3\u3001\u3053\u306e\u30da\u30a4\u30f3\u306e\u3059\u3079\u3066\u306e\u74b0\u5883\u8a2d\u5b9a\u3092\u5fa9\u5143\u3057\u307e\u3059\u3002\u4fdd\u5b58\u3055\u308c\u305f\u30c6\u30fc\u30de\u306f\u4fdd\u6301\u3055\u308c\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud14c\ub9c8 \ubaa8\ub4dc, \uc0c9\uc0c1, \uae00\uaf34, \ud14d\uc2a4\ud2b8 \ud06c\uae30, Dock \uc544\uc774\ucf58 \ubc0f \uc774 \ucc3d\uc758 \ubaa8\ub4e0 \ud658\uacbd\uc124\uc815\uc744 \ubcf5\uc6d0\ud569\ub2c8\ub2e4. \uc800\uc7a5\ub41c \ud14c\ub9c8\ub294 \uc720\uc9c0\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt themamodus, kleuren, lettertypen, tekstgrootte, Dock-pictogram en alle voorkeuren in dit paneel. Opgeslagen thema's blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca tryb motywu, kolory, czcionki, rozmiar tekstu, ikon\u0119 Dock i wszystkie preferencje w tym panelu. Zapisane motywy zostaj\u0105 zachowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura o modo de tema, cores, fontes, tamanho do texto, \u00edcone do Dock e todas as prefer\u00eancias deste painel. Os temas salvos s\u00e3o mantidos."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0440\u0435\u0436\u0438\u043c \u0442\u0435\u043c\u044b, \u0446\u0432\u0435\u0442\u0430, \u0448\u0440\u0438\u0444\u0442\u044b, \u0440\u0430\u0437\u043c\u0435\u0440 \u0442\u0435\u043a\u0441\u0442\u0430, \u0437\u043d\u0430\u0447\u043e\u043a Dock \u0438 \u0432\u0441\u0435 \u043f\u0430\u0440\u0430\u043c\u0435\u0442\u0440\u044b \u043d\u0430 \u044d\u0442\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438. \u0421\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u044b\u0435 \u0442\u0435\u043c\u044b \u043e\u0441\u0442\u0430\u044e\u0442\u0441\u044f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5terst\u00e4ller temal\u00e4ge, f\u00e4rger, teckensnitt, textstorlek, dockningsikon och alla inst\u00e4llningar i denna panel. Sparade teman beh\u00e5lls."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema modunu, renkleri, yaz\u0131 tiplerini, metin boyutunu, Dock simgesini ve bu b\u00f6lmedeki her tercihi geri y\u00fckler. Kay\u0131tl\u0131 temalar korunur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043d\u043e\u0432\u043b\u044e\u0454 \u0440\u0435\u0436\u0438\u043c \u0442\u0435\u043c\u0438, \u043a\u043e\u043b\u044c\u043e\u0440\u0438, \u0448\u0440\u0438\u0444\u0442\u0438, \u0440\u043e\u0437\u043c\u0456\u0440 \u0442\u0435\u043a\u0441\u0442\u0443, \u043f\u0456\u043a\u0442\u043e\u0433\u0440\u0430\u043c\u0443 Dock \u0442\u0430 \u0432\u0441\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430 \u0446\u0456\u0439 \u043f\u0430\u043d\u0435\u043b\u0456. \u0417\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0456 \u0442\u0435\u043c\u0438 \u0437\u0430\u043b\u0438\u0448\u0430\u044e\u0442\u044c\u0441\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4i ph\u1ee5c ch\u1ebf \u0111\u1ed9 ch\u1ee7 \u0111\u1ec1, m\u00e0u s\u1eafc, ph\u00f4ng ch\u1eef, c\u1ee1 ch\u1eef, bi\u1ec3u t\u01b0\u1ee3ng Dock v\u00e0 m\u1ecdi t\u00f9y ch\u1ecdn tr\u00ean ng\u0103n n\u00e0y. C\u00e1c ch\u1ee7 \u0111\u1ec1 \u0111\u00e3 l\u01b0u \u0111\u01b0\u1ee3c gi\u1eef l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6062\u590d\u6b64\u9762\u677f\u4e0a\u7684\u4e3b\u9898\u6a21\u5f0f\u3001\u989c\u8272\u3001\u5b57\u4f53\u3001\u5b57\u53f7\u3001Dock \u56fe\u6807\u53ca\u6240\u6709\u504f\u597d\u8bbe\u7f6e\u3002\u4fdd\u5b58\u7684\u4e3b\u9898\u5c06\u88ab\u4fdd\u7559\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5fa9\u539f\u6b64\u9762\u677f\u4e0a\u7684\u4e3b\u984c\u6a21\u5f0f\u3001\u984f\u8272\u3001\u5b57\u578b\u3001\u6587\u5b57\u5927\u5c0f\u3001Dock \u5716\u793a\u53ca\u6240\u6709\u504f\u597d\u8a2d\u5b9a\u3002\u5132\u5b58\u7684\u4e3b\u984c\u5c07\u88ab\u4fdd\u7559\u3002"
          }
        }
      }
    },
    "Restores theme mode, colors, fonts, text size, dock icon, and every preference on this pane. This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0633\u062a\u0639\u064a\u062f \u0648\u0636\u0639 \u0627\u0644\u0633\u0645\u0629 \u0648\u0627\u0644\u0623\u0644\u0648\u0627\u0646 \u0648\u0627\u0644\u062e\u0637\u0648\u0637 \u0648\u062d\u062c\u0645 \u0627\u0644\u0646\u0635 \u0648\u0623\u064a\u0642\u0648\u0646\u0629 Dock \u0648\u0643\u0644 \u062a\u0641\u0636\u064a\u0644\u0627\u062a \u0647\u0630\u0647 \u0627\u0644\u0644\u0648\u062d\u0629. \u0644\u0627 \u064a\u0645\u0643\u0646 \u0627\u0644\u062a\u0631\u0627\u062c\u0639 \u0639\u0646 \u0647\u0630\u0627 \u0627\u0644\u0625\u062c\u0631\u0627\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stellt Themenmodus, Farben, Schriften, Textgr\u00f6\u00dfe, Dock-Symbol und alle Einstellungen dieses Bereichs wieder her. Dies kann nicht r\u00fcckg\u00e4ngig gemacht werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Restores theme mode, colors, fonts, text size, dock icon, and every preference on this pane. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura el modo de tema, los colores, las fuentes, el tama\u00f1o del texto, el icono del Dock y todas las preferencias de este panel. Esta acci\u00f3n no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaure le mode de th\u00e8me, les couleurs, les polices, la taille du texte, l'ic\u00f4ne du Dock et toutes les pr\u00e9f\u00e9rences de ce volet. Cette action est irr\u00e9versible."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05d7\u05d6\u05d9\u05e8 \u05d0\u05ea \u05de\u05e6\u05d1 \u05e2\u05e8\u05db\u05ea \u05d4\u05e2\u05d9\u05e6\u05d5\u05d1, \u05d4\u05e6\u05d1\u05e2\u05d9\u05dd, \u05d4\u05d2\u05d5\u05e4\u05e0\u05d9\u05dd, \u05d2\u05d5\u05d3\u05dc \u05d4\u05d8\u05e7\u05e1\u05d8, \u05e1\u05de\u05dc \u05d4-Dock \u05d5\u05d0\u05ea \u05db\u05dc \u05d4\u05d4\u05e2\u05d3\u05e4\u05d5\u05ea \u05d1\u05dc\u05d5\u05d7 \u05d6\u05d4. \u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05dc\u05d1\u05d8\u05dc \u05e4\u05e2\u05d5\u05dc\u05d4 \u05d6\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0925\u0940\u092e \u092e\u094b\u0921, \u0930\u0902\u0917, \u092b\u093c\u0949\u0928\u094d\u091f, \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0906\u0915\u093e\u0930, \u0921\u0949\u0915 \u0906\u0907\u0915\u0928 \u0914\u0930 \u0907\u0938 \u092a\u0948\u0928\u0932 \u0915\u0940 \u0939\u0930 \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u092a\u0941\u0928\u0930\u094d\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u0907\u0938\u0947 \u092a\u0942\u0930\u094d\u0935\u0935\u0924 \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memulihkan mode tema, warna, font, ukuran teks, ikon Dock, dan semua preferensi di panel ini. Tindakan ini tidak dapat dibatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripristina la modalit\u00e0 tema, i colori, i font, la dimensione del testo, l'icona del Dock e ogni preferenza di questo pannello. L'operazione non pu\u00f2 essere annullata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c6\u30fc\u30de\u30e2\u30fc\u30c9\u3001\u30ab\u30e9\u30fc\u3001\u30d5\u30a9\u30f3\u30c8\u3001\u30c6\u30ad\u30b9\u30c8\u30b5\u30a4\u30ba\u3001Dock\u30a2\u30a4\u30b3\u30f3\u3001\u304a\u3088\u3073\u3053\u306e\u30da\u30a4\u30f3\u306e\u3059\u3079\u3066\u306e\u8a2d\u5b9a\u3092\u5143\u306b\u623b\u3057\u307e\u3059\u3002\u3053\u306e\u64cd\u4f5c\u306f\u53d6\u308a\u6d88\u305b\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud14c\ub9c8 \ubaa8\ub4dc, \uc0c9\uc0c1, \ud3f0\ud2b8, \ud14d\uc2a4\ud2b8 \ud06c\uae30, Dock \uc544\uc774\ucf58 \ubc0f \uc774 \ud32c\uc758 \ubaa8\ub4e0 \ud658\uacbd\uc124\uc815\uc744 \ubcf5\uc6d0\ud569\ub2c8\ub2e4. \uc774 \uc791\uc5c5\uc740 \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelt themamodus, kleuren, lettertypen, tekstgrootte, het Dock-pictogram en elke voorkeur in dit venster. Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przywraca tryb motywu, kolory, czcionki, rozmiar tekstu, ikon\u0119 Docka i wszystkie ustawienia tego panelu. Nie mo\u017cna tego cofn\u0105\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaura o modo de tema, as cores, as fontes, o tamanho do texto, o \u00edcone do Dock e todas as prefer\u00eancias deste painel. N\u00e3o \u00e9 poss\u00edvel desfazer."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u0430\u0432\u043b\u0438\u0432\u0430\u0435\u0442 \u0440\u0435\u0436\u0438\u043c \u0442\u0435\u043c\u044b, \u0446\u0432\u0435\u0442\u0430, \u0448\u0440\u0438\u0444\u0442\u044b, \u0440\u0430\u0437\u043c\u0435\u0440 \u0442\u0435\u043a\u0441\u0442\u0430, \u0437\u043d\u0430\u0447\u043e\u043a \u0432 Dock \u0438 \u0432\u0441\u0435 \u043d\u0430\u0441\u0442\u0440\u043e\u0439\u043a\u0438 \u044d\u0442\u043e\u0439 \u043f\u0430\u043d\u0435\u043b\u0438. \u0414\u0435\u0439\u0441\u0442\u0432\u0438\u0435 \u043d\u0435\u043b\u044c\u0437\u044f \u043e\u0442\u043c\u0435\u043d\u0438\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00c5terst\u00e4ller temal\u00e4ge, f\u00e4rger, typsnitt, textstorlek, Dock-ikonen och alla inst\u00e4llningar i den h\u00e4r rutan. Detta g\u00e5r inte att \u00e5ngra."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tema modunu, renkleri, yaz\u0131 tiplerini, metin boyutunu, Dock simgesini ve bu b\u00f6lmedeki her tercihi geri y\u00fckler. Bu i\u015flem geri al\u0131namaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0456\u0434\u043d\u043e\u0432\u043b\u044e\u0454 \u0440\u0435\u0436\u0438\u043c \u0442\u0435\u043c\u0438, \u043a\u043e\u043b\u044c\u043e\u0440\u0438, \u0448\u0440\u0438\u0444\u0442\u0438, \u0440\u043e\u0437\u043c\u0456\u0440 \u0442\u0435\u043a\u0441\u0442\u0443, \u0437\u043d\u0430\u0447\u043e\u043a Dock \u0456 \u0432\u0441\u0456 \u043d\u0430\u043b\u0430\u0448\u0442\u0443\u0432\u0430\u043d\u043d\u044f \u0446\u0456\u0454\u0457 \u043f\u0430\u043d\u0435\u043b\u0456. \u0414\u0456\u044e \u043d\u0435\u043c\u043e\u0436\u043b\u0438\u0432\u043e \u0441\u043a\u0430\u0441\u0443\u0432\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4i ph\u1ee5c ch\u1ebf \u0111\u1ed9 giao di\u1ec7n, m\u00e0u s\u1eafc, ph\u00f4ng ch\u1eef, c\u1ee1 ch\u1eef, bi\u1ec3u t\u01b0\u1ee3ng Dock v\u00e0 m\u1ecdi t\u00f9y ch\u1ecdn trong khung n\u00e0y. Kh\u00f4ng th\u1ec3 ho\u00e0n t\u00e1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6062\u590d\u4e3b\u9898\u6a21\u5f0f\u3001\u989c\u8272\u3001\u5b57\u4f53\u3001\u6587\u5b57\u5927\u5c0f\u3001\u7a0b\u5e8f\u5762\u56fe\u6807\u4ee5\u53ca\u6b64\u9762\u677f\u4e0a\u7684\u6240\u6709\u504f\u597d\u8bbe\u7f6e\u3002\u6b64\u64cd\u4f5c\u65e0\u6cd5\u64a4\u9500\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9084\u539f\u4e3b\u984c\u6a21\u5f0f\u3001\u984f\u8272\u3001\u5b57\u9ad4\u3001\u6587\u5b57\u5927\u5c0f\u3001Dock \u5716\u793a\u4ee5\u53ca\u6b64\u9762\u677f\u4e0a\u7684\u6240\u6709\u504f\u597d\u8a2d\u5b9a\u3002\u6b64\u64cd\u4f5c\u7121\u6cd5\u5fa9\u539f\u3002"
          }
        }
      }
    },
