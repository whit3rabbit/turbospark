    "Explain how this project works": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0634\u0631\u062d \u0643\u064a\u0641\u064a\u0629 \u0639\u0645\u0644 \u0647\u0630\u0627 \u0627\u0644\u0645\u0634\u0631\u0648\u0639"
