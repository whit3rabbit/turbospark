    "Model ready to load. Select a model or enter a prompt to begin.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ready to load. Select a model or enter a prompt to begin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo listo para cargar. Selecciona un modelo o escribe un mensaje para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modèle prêt à être chargé. Sélectionnez un modèle ou saisissez une invite pour commencer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell bereit zum Laden. Wählen Sie ein Modell oder geben Sie einen Prompt ein."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello pronto per il caricamento. Seleziona un modello o inserisci un prompt per iniziare."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo pronto para carregar. Selecione um modelo ou digite um prompt para começar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель готова к загрузке. Выберите модель или введите запрос для начала."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを読み込む準備が整いました。モデルを選択するかプロンプトを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 로드할 준비가 되었습니다. 시작하려면 모델을 선택하거나 프롬프트를 입력하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型已就绪。选择模型或输入提示词以开始。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "模型已就緒。選取模型或輸入提示詞以開始。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "النموذج جاهز للتحميل. اختر نموذجًا أو أدخل نصًا للبدء."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मॉडल लोड करने के लिए तैयार है। शुरू करने के लिए कोई मॉडल चुनें या प्रॉम्प्ट दर्ज करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gereed om te laden. Selecteer een model of voer een prompt in om te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gotowy do załadowania. Wybierz model lub wprowadź prompt, aby rozpocząć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model yüklenmeye hazır. Başlamak için bir model seçin veya bir istem girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Модель готова до завантаження. Виберіть модель або введіть запит, щоб розпочати."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen är redo att laddas. Välj en modell eller ange en prompt för att börja."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mô hình đã sẵn sàng tải. Chọn một mô hình hoặc nhập lời nhắc để bắt đầu."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model siap dimuat. Pilih model atau masukkan prompt untuk memulai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המודל מוכן לטעינה. בחר מודל או הזן הנחיה כדי להתחיל."
          }
        }
      }
    },
