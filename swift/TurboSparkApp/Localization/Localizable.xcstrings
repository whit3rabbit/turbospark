          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選取代理以檢視其系統指令與能力。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر وكيلا لفحص تعليمات النظام والقدرات."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר סוכן כדי לבדוק הוראות מערכת ויכולות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम निर्देश और क्षमताएं देखने के लिए कोई एजेंट चुनें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecteer een agent om systeeminstructies en mogelijkheden te bekijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz agenta, aby zobaczyć instrukcje systemowe i możliwości."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem yönergelerini ve yetenekleri incelemek için bir aracı seçin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть агента, щоб переглянути системні інструкції та можливості."
          }
        },
        "sv": {
          "stringUnit": {
