        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042f \u0440\u043e\u0437\u0443\u043c\u0456\u044e, \u0449\u043e \u0446\u0435\u0439 ZIP \u043d\u0435 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u00f4i hi\u1ec3u t\u1ec7p ZIP n\u00e0y kh\u00f4ng \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6211\u4e86\u89e3\u6b64 ZIP \u672a\u52a0\u5bc6"
