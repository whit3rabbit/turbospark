        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e6\u05d2\u05ea \u05e7\u05d5\u05d1\u05e6\u05d9 \u200e.gguf \u05e9\u05d4\u05de\u05d0\u05d2\u05e8 \u05d4\u05d6\u05d4 \u05de\u05e4\u05e8\u05e1\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0930\u093f\u092a\u0949\u091c\u093f\u091f\u0930\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u092a\u094d\u0930\u0915\u093e\u0936\u093f\u0924 .gguf \u092b\u093c\u093e\u0907\u0932\u094b\u0902 \u0915\u0940 \u0938\u0942\u091a\u0940 \u0926\u093f\u0916\u093e\u090f\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan file .gguf yang diterbitkan repositori ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elenca i file .gguf pubblicati da questo repository"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30ea\u30dd\u30b8\u30c8\u30ea\u304c\u516c\u958b\u3057\u3066\u3044\u308b.gguf\u30d5\u30a1\u30a4\u30eb\u3092\u4e00\u89a7\u8868\u793a"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc800\uc7a5\uc18c\uac00 \uac8c\uc2dc\ud55c .gguf \ud30c\uc77c \ub098\uc5f4"
          }
        },
        "nl": {
