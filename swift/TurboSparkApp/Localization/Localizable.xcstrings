        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este arquivo excede o limite de 32 MB para vetores de controle."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u043e\u0442 \u0444\u0430\u0439\u043b \u043f\u0440\u0435\u0432\u044b\u0448\u0430\u0435\u0442 \u043f\u0440\u0435\u0434\u0435\u043b 32 \u041c\u0411 \u0434\u043b\u044f \u0443\u043f\u0440\u0430\u0432\u043b\u044f\u044e\u0449\u0438\u0445 \u0432\u0435\u043a\u0442\u043e\u0440\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r filen \u00f6verskrider gr\u00e4nsen p\u00e5 32 MB f\u00f6r styrvektorer."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu dosya 32 MB'l\u0131k kontrol vekt\u00f6r\u00fc s\u0131n\u0131r\u0131n\u0131 a\u015f\u0131yor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435\u0439 \u0444\u0430\u0439\u043b \u043f\u0435\u0440\u0435\u0432\u0438\u0449\u0443\u0454 \u043e\u0431\u043c\u0435\u0436\u0435\u043d\u043d\u044f 32 \u041c\u0411 \u0434\u043b\u044f \u043a\u0435\u0440\u0443\u0432\u0430\u043b\u044c\u043d\u0438\u0445 \u0432\u0435\u043a\u0442\u043e\u0440\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ec7p n\u00e0y v\u01b0\u1ee3t qu\u00e1 gi\u1edbi h\u1ea1n 32 MB cho vect\u01a1 \u0111i\u1ec1u khi\u1ec3n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6587\u4ef6\u8d85\u51fa\u4e86\u63a7\u5236\u5411\u91cf 32 MB \u7684\u9650\u5236\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a94\u6848\u8d85\u51fa\u4e86\u63a7\u5236\u5411\u91cf 32 MB \u7684\u9650\u5236\u3002"
          }
        }
      }
    },
