    "Selected but not in memory. Press Load to open it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u062d\u062f\u062f \u0644\u0643\u0646\u0647 \u063a\u064a\u0631 \u0645\u0648\u062c\u0648\u062f \u0641\u064a \u0627\u0644\u0630\u0627\u0643\u0631\u0629. \u0627\u0636\u063a\u0637 \u062a\u062d\u0645\u064a\u0644 \u0644\u0641\u062a\u062d\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgew\u00e4hlt, aber nicht im Speicher. Klicke auf Laden, um es zu \u00f6ffnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Selected but not in memory. Press Load to open it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seleccionado, pero no est\u00e1 en memoria. Pulsa Cargar para abrirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u00e9lectionn\u00e9 mais pas en m\u00e9moire. Appuyez sur Charger pour l'ouvrir."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05d1\u05d7\u05e8 \u05d0\u05da \u05dc\u05d0 \u05e0\u05de\u05e6\u05d0 \u05d1\u05d6\u05d9\u05db\u05e8\u05d5\u05df. \u05dc\u05d7\u05e5 \u05e2\u05dc \u05d8\u05e2\u05df \u05db\u05d3\u05d9 \u05dc\u05e4\u05ea\u05d5\u05d7 \u05d0\u05d5\u05ea\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u0941\u0928\u093e \u0917\u092f\u093e \u0939\u0948, \u0932\u0947\u0915\u093f\u0928 \u092e\u0947\u092e\u094b\u0930\u0940 \u092e\u0947\u0902 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0907\u0938\u0947 \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0932\u094b\u0921 \u0926\u092c\u093e\u090f\u0901\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dipilih tetapi belum ada di memori. Tekan Muat untuk membukanya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Selezionato ma non in memoria. Premi Carica per aprirlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u6e08\u307f\u3067\u3059\u304c\u30e1\u30e2\u30ea\u306b\u3042\u308a\u307e\u305b\u3093\u3002\u300c\u8aad\u307f\u8fbc\u3080\u300d\u3092\u62bc\u3057\u3066\u958b\u3044\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\ub418\uc5c8\uc9c0\ub9cc \uba54\ubaa8\ub9ac\uc5d0 \uc5c6\uc2b5\ub2c8\ub2e4. \ub85c\ub4dc\ub97c \ub20c\ub7ec \uc5ec\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geselecteerd maar niet in het geheugen. Klik op Laden om het te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybrany, ale nie w pami\u0119ci. Naci\u015bnij Za\u0142aduj, aby go otworzy\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Selecionado, mas n\u00e3o est\u00e1 na mem\u00f3ria. Pressione Carregar para abri-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0440\u0430\u043d\u0430, \u043d\u043e \u043d\u0435 \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d\u0430 \u0432 \u043f\u0430\u043c\u044f\u0442\u044c. \u041d\u0430\u0436\u043c\u0438\u0442\u0435 \u00ab\u0417\u0430\u0433\u0440\u0443\u0437\u0438\u0442\u044c\u00bb, \u0447\u0442\u043e\u0431\u044b \u043e\u0442\u043a\u0440\u044b\u0442\u044c \u0435\u0451."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vald men inte i minnet. Tryck p\u00e5 Ladda f\u00f6r att \u00f6ppna den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00e7ili ancak bellekte de\u011fil. A\u00e7mak i\u00e7in Y\u00fckle'ye bas\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0440\u0430\u043d\u043e, \u0430\u043b\u0435 \u043d\u0435 \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e \u0432 \u043f\u0430\u043c'\u044f\u0442\u044c. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c \u00ab\u0417\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u0442\u0438\u00bb, \u0449\u043e\u0431 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 ch\u1ecdn nh\u01b0ng ch\u01b0a c\u00f3 trong b\u1ed9 nh\u1edb. Nh\u1ea5n T\u1ea3i \u0111\u1ec3 m\u1edf."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u9009\u62e9\u4f46\u672a\u5728\u5185\u5b58\u4e2d\u3002\u6309\u201c\u52a0\u8f7d\u201d\u4ee5\u6253\u5f00\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u9078\u64c7\u4f46\u672a\u5728\u8a18\u61b6\u9ad4\u4e2d\u3002\u6309\u300c\u8f09\u5165\u300d\u4ee5\u958b\u555f\u3002"
          }
        }
      }
    },
