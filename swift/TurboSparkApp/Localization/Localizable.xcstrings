    "Model ready to load. Select a model or enter a prompt to begin.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0646\u0645\u0648\u0630\u062c \u062c\u0627\u0647\u0632 \u0644\u0644\u062a\u062d\u0645\u064a\u0644. \u0627\u062e\u062a\u0631 \u0646\u0645\u0648\u0630\u062c\u064b\u0627 \u0623\u0648 \u0623\u062f\u062e\u0644 \u0646\u0635\u064b\u0627 \u0644\u0644\u0628\u062f\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Modell bereit zum Laden. W\u00e4hlen Sie ein Modell oder geben Sie einen Prompt ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ready to load. Select a model or enter a prompt to begin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo listo para cargar. Selecciona un modelo o escribe un mensaje para comenzar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mod\u00e8le pr\u00eat \u00e0 \u00eatre charg\u00e9. S\u00e9lectionnez un mod\u00e8le ou saisissez une invite pour commencer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d5\u05d3\u05dc \u05de\u05d5\u05db\u05df \u05dc\u05d8\u05e2\u05d9\u05e0\u05d4. \u05d1\u05d7\u05e8 \u05de\u05d5\u05d3\u05dc \u05d0\u05d5 \u05d4\u05d6\u05df \u05d4\u05e0\u05d7\u05d9\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0949\u0921\u0932 \u0932\u094b\u0921 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0924\u0948\u092f\u093e\u0930 \u0939\u0948\u0964 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092e\u0949\u0921\u0932 \u091a\u0941\u0928\u0947\u0902 \u092f\u093e \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model siap dimuat. Pilih model atau masukkan prompt untuk memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modello pronto per il caricamento. Seleziona un modello o inserisci un prompt per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30e2\u30c7\u30eb\u3092\u8aad\u307f\u8fbc\u3080\u6e96\u5099\u304c\u6574\u3044\u307e\u3057\u305f\u3002\u30e2\u30c7\u30eb\u3092\u9078\u629e\u3059\u308b\u304b\u30d7\u30ed\u30f3\u30d7\u30c8\u3092\u5165\u529b\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub378\uc744 \ub85c\ub4dc\ud560 \uc900\ube44\uac00 \ub418\uc5c8\uc2b5\ub2c8\ub2e4. \uc2dc\uc791\ud558\ub824\uba74 \ubaa8\ub378\uc744 \uc120\ud0dd\ud558\uac70\ub098 \ud504\ub86c\ud504\ud2b8\ub97c \uc785\ub825\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gereed om te laden. Selecteer een model of voer een prompt in om te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model gotowy do za\u0142adowania. Wybierz model lub wprowad\u017a prompt, aby rozpocz\u0105\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelo pronto para carregar. Selecione um modelo ou digite um prompt para come\u00e7ar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c \u0433\u043e\u0442\u043e\u0432\u0430 \u043a \u0437\u0430\u0433\u0440\u0443\u0437\u043a\u0435. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043c\u043e\u0434\u0435\u043b\u044c \u0438\u043b\u0438 \u0432\u0432\u0435\u0434\u0438\u0442\u0435 \u0437\u0430\u043f\u0440\u043e\u0441 \u0434\u043b\u044f \u043d\u0430\u0447\u0430\u043b\u0430."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen \u00e4r redo att laddas. V\u00e4lj en modell eller ange en prompt f\u00f6r att b\u00f6rja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Model y\u00fcklenmeye haz\u0131r. Ba\u015flamak i\u00e7in bir model se\u00e7in veya bir istem girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c \u0433\u043e\u0442\u043e\u0432\u0430 \u0434\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043d\u044f. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043c\u043e\u0434\u0435\u043b\u044c \u0430\u0431\u043e \u0432\u0432\u0435\u0434\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0442, \u0449\u043e\u0431 \u0440\u043e\u0437\u043f\u043e\u0447\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 h\u00ecnh \u0111\u00e3 s\u1eb5n s\u00e0ng t\u1ea3i. Ch\u1ecdn m\u1ed9t m\u00f4 h\u00ecnh ho\u1eb7c nh\u1eadp l\u1eddi nh\u1eafc \u0111\u1ec3 b\u1eaft \u0111\u1ea7u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6a21\u578b\u5df2\u5c31\u7eea\u3002\u9009\u62e9\u6a21\u578b\u6216\u8f93\u5165\u63d0\u793a\u8bcd\u4ee5\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6a21\u578b\u5df2\u5c31\u7dd2\u3002\u9078\u53d6\u6a21\u578b\u6216\u8f38\u5165\u63d0\u793a\u8a5e\u4ee5\u958b\u59cb\u3002"
          }
        }
      }
    },
