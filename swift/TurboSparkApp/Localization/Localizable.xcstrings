        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega un borrador para reescribirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez un brouillon \u00e0 r\u00e9\u00e9crire."
