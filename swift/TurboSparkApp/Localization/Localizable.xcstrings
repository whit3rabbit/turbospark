        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paroladan anahtar t\u00fcretilemedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043e\u0442\u0440\u0438\u043c\u0430\u0442\u0438 \u043a\u043b\u044e\u0447 \u0456\u0437 \u0444\u0440\u0430\u0437\u0438-\u043f\u0430\u0440\u043e\u043b\u044f."
