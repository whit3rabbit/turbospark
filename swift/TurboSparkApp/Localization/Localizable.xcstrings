        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0430\u0442\u0438\u0432\u043d\u0438\u0439 \u0444\u043e\u0440\u043c\u0430\u0442 Apple MLX .gturbo \u0437 \u0432\u0438\u043a\u043e\u043d\u0430\u043d\u043d\u044f\u043c \u043d\u0430 Metal \u0431\u0435\u0437 \u043a\u043e\u043f\u0456\u044e\u0432\u0430\u043d\u043d\u044f"
