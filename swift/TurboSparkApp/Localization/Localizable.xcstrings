          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05de\u05d5\u05d3\u05dc \u05de\u05d5\u05ea\u05e7\u05df \u05e9\u05ea\u05d5\u05d0\u05dd \u05dc-'%@'."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u0907\u0902\u0938\u094d\u091f\u0949\u0932 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u092e\u0949\u0921\u0932 '%@' \u0938\u0947 \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada model terpasang yang cocok dengan '%@'."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello installato corrisponde a '%@'."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u306b\u4e00\u81f4\u3059\u308b\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u6e08\u307f\u30e2\u30c7\u30eb\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc640(\uacfc) \uc77c\uce58\ud558\ub294 \uc124\uce58\ub41c \ubaa8\ub378\uc774 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ge\u00efnstalleerd model komt overeen met '%@'."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017baden zainstalowany model nie pasuje do '%@'."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo instalado corresponde a '%@'."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043d\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438, \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u044e\u0449\u0435\u0439 '%@'."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen installerad modell matchar '%@'."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ile e\u015fle\u015fen y\u00fckl\u00fc model yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043c\u0430\u0454 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u043b\u0435\u043d\u043e\u0457 \u043c\u043e\u0434\u0435\u043b\u0456, \u0449\u043e \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 '%@'."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 m\u00f4 h\u00ecnh \u0111\u00e3 c\u00e0i \u0111\u1eb7t n\u00e0o kh\u1edbp v\u1edbi '%@'."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u4e0e '%@' \u5339\u914d\u7684\u5df2\u5b89\u88c5\u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u8207 '%@' \u76f8\u7b26\u7684\u5df2\u5b89\u88dd\u6a21\u578b\u3002"
          }
        }
      }
    },
    "No matching approved memories.": {
