            "value": "\u05dc\u05db\u05d9\u05d3\u05ea \u05ea\u05e6\u05d5\u05d2\u05d5\u05ea \u05de\u05e7\u05d3\u05d9\u05de\u05d5\u05ea \u05e9\u05dc \u05d8\u05e7\u05e1\u05d8"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0947\u0915\u094d\u0938\u094d\u091f \u092a\u0942\u0930\u094d\u0935\u093e\u0935\u0932\u094b\u0915\u0928 \u0915\u0948\u092a\u094d\u091a\u0930 \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
