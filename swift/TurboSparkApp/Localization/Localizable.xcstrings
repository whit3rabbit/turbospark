    "Speaker labels appear here after a take's final transcript, when labels are on for its mode.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظهر المتحدثون هنا بعد النص النهائي للتسجيل، إذا كان تحديد المتحدثين مفعّلًا لوضعه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprecher erscheinen hier nach der endgültigen Transkription einer Aufnahme, wenn die Sprecherzuordnung für ihren Modus aktiv ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speaker labels appear here after a take's final transcript, when labels are on for its mode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los hablantes aparecen aquí tras la transcripción final de una toma, si la identificación está activada en su modo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les locuteurs apparaissent ici après la transcription finale d'une prise, si l'identification est activée pour son mode."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדוברים מופיעים כאן אחרי התמליל הסופי של ההקלטה, אם זיהוי הדוברים פעיל במצב שלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यदि उसके मोड के लिए वक्ता चिह्नित करना चालू है, तो रिकॉर्डिंग के अंतिम ट्रांसक्रिप्ट के बाद वक्ता यहाँ दिखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembicara muncul di sini setelah transkrip akhir rekaman, jika label pembicara aktif untuk modenya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I parlanti compaiono qui dopo la trascrizione finale di una registrazione, se l'identificazione è attiva per la sua modalità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モードで話者の識別がオンの場合、録音の最終的な文字起こしの後に話者がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모드에서 화자 구분이 켜져 있으면 녹음의 최종 텍스트 변환 후 여기에 화자가 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprekers verschijnen hier na de definitieve transcriptie van een opname, als sprekers labelen aan staat voor de modus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mówcy pojawią się tu po końcowej transkrypcji nagrania, jeśli w jego trybie włączono oznaczanie mówców."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os falantes aparecem aqui após a transcrição final de uma gravação, se a identificação estiver ativada no modo dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Говорящие появятся здесь после итоговой расшифровки записи, если для её режима включено определение говорящих."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Talare visas här efter en tagnings slutliga transkription, om talarmärkning är på för dess läge."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modunda konuşmacı etiketleme açıksa, konuşmacılar kaydın son dökümünden sonra burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мовці з'являться тут після остаточної розшифровки запису, якщо для його режиму ввімкнено визначення мовців."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Người nói xuất hiện ở đây sau bản chép lời cuối của bản ghi, nếu chế độ của nó bật gắn nhãn người nói."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果该模式开启了说话人标注，录音完成最终转写后说话人会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "如果該模式開啟了說話者標註，錄音完成最終轉寫後說話者會顯示在這裡。"
          }
        }
      }
    },
