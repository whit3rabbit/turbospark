            "state": "translated",
            "value": "La recuperaci\u00f3n se reintent\u00f3 correctamente. Intento: %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle tentative de r\u00e9cup\u00e9ration a r\u00e9ussi. Tentative : %lld."
