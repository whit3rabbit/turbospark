        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u201c\u8bbe\u7f6e\u201d\u4e2d\u9009\u62e9\u56fe\u50cf\u6a21\u578b\u4ee5\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u300c\u8a2d\u5b9a\u300d\u4e2d\u9078\u64c7\u5f71\u50cf\u6a21\u578b\u4ee5\u958b\u59cb\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u0646\u0645\u0648\u0630\u062c \u0635\u0648\u0631\u0629 \u0641\u064a \u0627\u0644\u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0644\u0644\u0628\u062f\u0621."
