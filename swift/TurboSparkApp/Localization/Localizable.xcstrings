          "stringUnit": {
            "state": "translated",
            "value": "\uc2a4\ud14c\uc774\uc9d5 \ud3f4\ub354\ub97c \ub9cc\ub4e4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "kan geen staging-map aanmaken"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "nie mo\u017cna utworzy\u0107 folderu tymczasowego"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "n\u00e3o foi poss\u00edvel criar uma pasta tempor\u00e1ria de prepara\u00e7\u00e3o"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u043d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0441\u043e\u0437\u0434\u0430\u0442\u044c \u043f\u0440\u043e\u043c\u0435\u0436\u0443\u0442\u043e\u0447\u043d\u0443\u044e \u043f\u0430\u043f\u043a\u0443"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "det gick inte att skapa en mellanlagringsmapp"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "haz\u0131rl\u0131k klas\u00f6r\u00fc olu\u015fturulamad\u0131"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u043d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0441\u0442\u0432\u043e\u0440\u0438\u0442\u0438 \u043f\u0440\u043e\u043c\u0456\u0436\u043d\u0443 \u0442\u0435\u043a\u0443"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "kh\u00f4ng th\u1ec3 t\u1ea1o th\u01b0 m\u1ee5c t\u1ea1m"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0\u6cd5\u521b\u5efa\u6682\u5b58\u6587\u4ef6\u5939"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u5efa\u7acb\u66ab\u5b58\u8cc7\u6599\u593e"
          }
        }
      }
    },
    "no API key: any process on this machine can reach it": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u0644\u0627 \u0645\u0641\u062a\u0627\u062d API: \u064a\u0645\u0643\u0646 \u0644\u0623\u064a \u0639\u0645\u0644\u064a\u0629 \u0639\u0644\u0649 \u0647\u0630\u0627 \u0627\u0644\u062c\u0647\u0627\u0632 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064a\u0647"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "kein API-Schl\u00fcssel: Jeder Prozess auf diesem Computer kann darauf zugreifen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "no API key: any process on this machine can reach it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "sin clave de API: cualquier proceso de este equipo puede acceder"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "aucune cl\u00e9 API : tout processus sur cette machine peut y acc\u00e9der"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05dc\u05d0 \u05de\u05e4\u05ea\u05d7 API: \u05db\u05dc \u05ea\u05d4\u05dc\u05d9\u05da \u05d1\u05de\u05d7\u05e9\u05d1 \u05d4\u05d6\u05d4 \u05d9\u05db\u05d5\u05dc \u05dc\u05d2\u05e9\u05ea \u05d0\u05dc\u05d9\u05d5"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 API \u0915\u0941\u0902\u091c\u0940 \u0928\u0939\u0940\u0902: \u0907\u0938 \u092e\u0936\u0940\u0928 \u0915\u0940 \u0915\u094b\u0908 \u092d\u0940 \u092a\u094d\u0930\u094b\u0938\u0947\u0938 \u0907\u0938 \u0924\u0915 \u092a\u0939\u0941\u0901\u091a \u0938\u0915\u0924\u0940 \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "tanpa kunci API: proses apa pun di mesin ini dapat mengaksesnya"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "nessuna chiave API: qualsiasi processo su questo computer pu\u00f2 accedervi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "API\u30ad\u30fc\u306a\u3057: \u3053\u306e\u30de\u30b7\u30f3\u4e0a\u306e\u3069\u306e\u30d7\u30ed\u30bb\u30b9\u304b\u3089\u3082\u30a2\u30af\u30bb\u30b9\u3067\u304d\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "API \ud0a4 \uc5c6\uc74c: \uc774 \ucef4\ud4e8\ud130\uc758 \ubaa8\ub4e0 \ud504\ub85c\uc138\uc2a4\uac00 \uc811\uadfc\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "geen API-sleutel: elk proces op deze computer kan erbij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "brak klucza API: ka\u017cdy proces na tym komputerze ma do niego dost\u0119p"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sem chave de API: qualquer processo nesta m\u00e1quina pode acess\u00e1-lo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0431\u0435\u0437 \u043a\u043b\u044e\u0447\u0430 API: \u043a \u043d\u0435\u043c\u0443 \u043c\u043e\u0436\u0435\u0442 \u043e\u0431\u0440\u0430\u0442\u0438\u0442\u044c\u0441\u044f \u043b\u044e\u0431\u043e\u0439 \u043f\u0440\u043e\u0446\u0435\u0441\u0441 \u043d\u0430 \u044d\u0442\u043e\u043c \u043a\u043e\u043c\u043f\u044c\u044e\u0442\u0435\u0440\u0435"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "ingen API-nyckel: alla processer p\u00e5 den h\u00e4r datorn kan n\u00e5 den"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "API anahtar\u0131 yok: bu makinedeki herhangi bir i\u015flem ona eri\u015febilir"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0431\u0435\u0437 \u043a\u043b\u044e\u0447\u0430 API: \u0431\u0443\u0434\u044c-\u044f\u043a\u0438\u0439 \u043f\u0440\u043e\u0446\u0435\u0441 \u043d\u0430 \u0446\u044c\u043e\u043c\u0443 \u043a\u043e\u043c\u043f'\u044e\u0442\u0435\u0440\u0456 \u043c\u043e\u0436\u0435 \u0434\u043e \u043d\u044c\u043e\u0433\u043e \u0437\u0432\u0435\u0440\u043d\u0443\u0442\u0438\u0441\u044f"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "kh\u00f4ng c\u00f3 kh\u00f3a API: m\u1ecdi ti\u1ebfn tr\u00ecnh tr\u00ean m\u00e1y n\u00e0y \u0111\u1ec1u c\u00f3 th\u1ec3 truy c\u1eadp"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u65e0 API \u5bc6\u94a5\uff1a\u6b64\u673a\u5668\u4e0a\u7684\u4efb\u4f55\u8fdb\u7a0b\u90fd\u80fd\u8bbf\u95ee\u5b83"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121 API \u91d1\u9470\uff1a\u6b64\u6a5f\u5668\u4e0a\u7684\u4efb\u4f55\u7a0b\u5e8f\u90fd\u80fd\u5b58\u53d6\u5b83"
          }
        }
      }
    },
    "openkindd could not start on %@. The port may already be in use, possibly by an openkindd left running by a previous session: quit it (Activity Monitor or `pkill openkindd`) or choose another port.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0639\u0630\u0651\u0631 \u0628\u062f\u0621 openkindd \u0639\u0644\u0649 %@. \u0642\u062f \u064a\u0643\u0648\u0646 \u0627\u0644\u0645\u0646\u0641\u0630 \u0645\u0633\u062a\u062e\u062f\u0645\u064b\u0627 \u0628\u0627\u0644\u0641\u0639\u0644\u060c \u0631\u0628\u0645\u0627 \u0628\u0648\u0627\u0633\u0637\u0629 openkindd \u062a\u064f\u0631\u0643 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0645\u0646 \u062c\u0644\u0633\u0629 \u0633\u0627\u0628\u0642\u0629: \u0623\u0646\u0647\u0650\u0647 (\u0645\u0631\u0627\u0642\u0628 \u0627\u0644\u0646\u0634\u0627\u0637 \u0623\u0648 `pkill openkindd`) \u0623\u0648 \u0627\u062e\u062a\u0631 \u0645\u0646\u0641\u0630\u064b\u0627 \u0622\u062e\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd konnte nicht auf %@ starten. Der Port wird m\u00f6glicherweise bereits verwendet, eventuell von einem openkindd, das aus einer fr\u00fcheren Sitzung noch l\u00e4uft: Beenden Sie es (Aktivit\u00e4tsanzeige oder `pkill openkindd`) oder w\u00e4hlen Sie einen anderen Port."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd could not start on %@. The port may already be in use, possibly by an openkindd left running by a previous session: quit it (Activity Monitor or `pkill openkindd`) or choose another port."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd no pudo iniciarse en %@. Es posible que el puerto ya est\u00e9 en uso, quiz\u00e1 por un openkindd que qued\u00f3 en ejecuci\u00f3n de una sesi\u00f3n anterior: ci\u00e9rralo (Monitor de Actividad o `pkill openkindd`) o elige otro puerto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd n'a pas pu d\u00e9marrer sur %@. Le port est peut-\u00eatre d\u00e9j\u00e0 utilis\u00e9, \u00e9ventuellement par un openkindd rest\u00e9 actif depuis une session pr\u00e9c\u00e9dente : quittez-le (Moniteur d'activit\u00e9 ou `pkill openkindd`) ou choisissez un autre port."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05d9\u05ea\u05df \u05d4\u05d9\u05d4 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea openkindd \u05d1-%@. \u05d9\u05d9\u05ea\u05db\u05df \u05e9\u05d4\u05d9\u05e6\u05d9\u05d0\u05d4 \u05db\u05d1\u05e8 \u05d1\u05e9\u05d9\u05de\u05d5\u05e9, \u05d0\u05d5\u05dc\u05d9 \u05e2\u05dc \u05d9\u05d3\u05d9 openkindd \u05e9\u05e0\u05e9\u05d0\u05e8 \u05e4\u05d5\u05e2\u05dc \u05de\u05d4\u05e4\u05e2\u05dc\u05d4 \u05e7\u05d5\u05d3\u05de\u05ea: \u05e1\u05d2\u05d5\u05e8 \u05d0\u05d5\u05ea\u05d5 (\u05de\u05d5\u05e0\u05d9\u05d8\u05d5\u05e8 \u05d4\u05e4\u05e2\u05d9\u05dc\u05d5\u05ea \u05d0\u05d5 `pkill openkindd`) \u05d0\u05d5 \u05d1\u05d7\u05e8 \u05d9\u05e6\u05d9\u05d0\u05d4 \u05d0\u05d7\u05e8\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd %@ \u092a\u0930 \u0936\u0941\u0930\u0942 \u0928\u0939\u0940\u0902 \u0939\u094b \u0938\u0915\u093e\u0964 \u092a\u094b\u0930\u094d\u091f \u0936\u093e\u092f\u0926 \u092a\u0939\u0932\u0947 \u0938\u0947 \u0909\u092a\u092f\u094b\u0917 \u092e\u0947\u0902 \u0939\u0948, \u0938\u0902\u092d\u0935\u0924\u0903 \u092a\u093f\u091b\u0932\u0947 \u0938\u0924\u094d\u0930 \u0938\u0947 \u091a\u0932 \u0930\u0939\u0947 \u0915\u093f\u0938\u0940 openkindd \u0926\u094d\u0935\u093e\u0930\u093e: \u0909\u0938\u0947 \u092c\u0902\u0926 \u0915\u0930\u0947\u0902 (\u0917\u0924\u093f\u0935\u093f\u0927\u093f \u092e\u0949\u0928\u093f\u091f\u0930 \u092f\u093e `pkill openkindd`) \u092f\u093e \u0915\u094b\u0908 \u0926\u0942\u0938\u0930\u093e \u092a\u094b\u0930\u094d\u091f \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd tidak dapat dimulai di %@. Port mungkin sudah digunakan, mungkin oleh openkindd yang masih berjalan dari sesi sebelumnya: hentikan (Monitor Aktivitas atau `pkill openkindd`) atau pilih port lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare openkindd su %@. La porta potrebbe essere gi\u00e0 in uso, forse da un openkindd rimasto in esecuzione da una sessione precedente: chiudilo (Monitoraggio Attivit\u00e0 o `pkill openkindd`) o scegli un'altra porta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u3092 %@ \u3067\u8d77\u52d5\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002\u30dd\u30fc\u30c8\u304c\u3059\u3067\u306b\u4f7f\u7528\u4e2d\u306e\u53ef\u80fd\u6027\u304c\u3042\u308a\u307e\u3059\u3002\u4ee5\u524d\u306e\u30bb\u30c3\u30b7\u30e7\u30f3\u3067\u5b9f\u884c\u3055\u308c\u305f\u307e\u307e\u306e openkindd \u304c\u539f\u56e0\u304b\u3082\u3057\u308c\u307e\u305b\u3093\u3002\u7d42\u4e86\u3059\u308b\uff08\u30a2\u30af\u30c6\u30a3\u30d3\u30c6\u30a3\u30e2\u30cb\u30bf\u307e\u305f\u306f `pkill openkindd`\uff09\u304b\u3001\u5225\u306e\u30dd\u30fc\u30c8\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\uc5d0\uc11c openkindd\ub97c \uc2dc\uc791\ud560 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ud3ec\ud2b8\uac00 \uc774\ubbf8 \uc0ac\uc6a9 \uc911\uc77c \uc218 \uc788\uc73c\uba70, \uc774\uc804 \uc138\uc158\uc5d0\uc11c \uc2e4\ud589\ub41c \ucc44\ub85c \ub0a8\uc544 \uc788\ub294 openkindd \ub54c\ubb38\uc77c \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud574\ub2f9 \ud504\ub85c\uc138\uc2a4\ub97c \uc885\ub8cc\ud558\uac70\ub098(\ud65c\uc131 \uc0c1\ud0dc \ubcf4\uae30 \ub610\ub294 `pkill openkindd`) \ub2e4\ub978 \ud3ec\ud2b8\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd kon niet starten op %@. De poort is mogelijk al in gebruik, misschien door een openkindd die nog draait van een eerdere sessie: stop deze (Activiteitenweergave of `pkill openkindd`) of kies een andere poort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie uda\u0142o si\u0119 uruchomi\u0107 openkindd na %@. Port mo\u017ce by\u0107 ju\u017c zaj\u0119ty, by\u0107 mo\u017ce przez openkindd pozostawiony uruchomiony z poprzedniej sesji: zako\u0144cz go (Monitor aktywno\u015bci lub `pkill openkindd`) albo wybierz inny port."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "N\u00e3o foi poss\u00edvel iniciar o openkindd em %@. A porta pode j\u00e1 estar em uso, talvez por um openkindd que ficou em execu\u00e7\u00e3o de uma sess\u00e3o anterior: encerre-o (Monitor de Atividade ou `pkill openkindd`) ou escolha outra porta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u044c openkindd \u043d\u0430 %@. \u041f\u043e\u0440\u0442, \u0432\u043e\u0437\u043c\u043e\u0436\u043d\u043e, \u0443\u0436\u0435 \u0437\u0430\u043d\u044f\u0442, \u043d\u0430\u043f\u0440\u0438\u043c\u0435\u0440 openkindd, \u043e\u0441\u0442\u0430\u0432\u0448\u0438\u043c\u0441\u044f \u043e\u0442 \u043f\u0440\u0435\u0434\u044b\u0434\u0443\u0449\u0435\u0433\u043e \u0441\u0435\u0430\u043d\u0441\u0430: \u0437\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u0435\u0433\u043e (\u041c\u043e\u043d\u0438\u0442\u043e\u0440\u0438\u043d\u0433 \u0441\u0438\u0441\u0442\u0435\u043c\u044b \u0438\u043b\u0438 `pkill openkindd`) \u0438\u043b\u0438 \u0432\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0434\u0440\u0443\u0433\u043e\u0439 \u043f\u043e\u0440\u0442."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd kunde inte starta p\u00e5 %@. Porten kanske redan anv\u00e4nds, m\u00f6jligen av en openkindd som l\u00e4mnats ig\u00e5ng fr\u00e5n en tidigare session: avsluta den (Aktivitetskontroll eller `pkill openkindd`) eller v\u00e4lj en annan port."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd %@ \u00fczerinde ba\u015flat\u0131lamad\u0131. Ba\u011flant\u0131 noktas\u0131 zaten kullan\u0131mda olabilir, belki \u00f6nceki bir oturumdan \u00e7al\u0131\u015f\u0131r durumda kalan bir openkindd taraf\u0131ndan: onu kapat\u0131n (Etkinlik Monit\u00f6r\u00fc veya `pkill openkindd`) ya da ba\u015fka bir ba\u011flant\u0131 noktas\u0131 se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u0437\u0430\u043f\u0443\u0441\u0442\u0438\u0442\u0438 openkindd \u043d\u0430 %@. \u041f\u043e\u0440\u0442, \u043c\u043e\u0436\u043b\u0438\u0432\u043e, \u0443\u0436\u0435 \u0437\u0430\u0439\u043d\u044f\u0442\u0438\u0439, \u043d\u0430\u043f\u0440\u0438\u043a\u043b\u0430\u0434 openkindd, \u0449\u043e \u0437\u0430\u043b\u0438\u0448\u0438\u0432\u0441\u044f \u0437 \u043f\u043e\u043f\u0435\u0440\u0435\u0434\u043d\u044c\u043e\u0433\u043e \u0441\u0435\u0430\u043d\u0441\u0443: \u0437\u0430\u0432\u0435\u0440\u0448\u0456\u0442\u044c \u0439\u043e\u0433\u043e (\u041c\u043e\u043d\u0456\u0442\u043e\u0440 \u0430\u043a\u0442\u0438\u0432\u043d\u043e\u0441\u0442\u0456 \u0430\u0431\u043e `pkill openkindd`) \u0430\u0431\u043e \u0432\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0456\u043d\u0448\u0438\u0439 \u043f\u043e\u0440\u0442."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng th\u1ec3 kh\u1edfi \u0111\u1ed9ng openkindd tr\u00ean %@. C\u1ed5ng c\u00f3 th\u1ec3 \u0111ang \u0111\u01b0\u1ee3c s\u1eed d\u1ee5ng, c\u00f3 th\u1ec3 b\u1edfi m\u1ed9t openkindd v\u1eabn ch\u1ea1y t\u1eeb phi\u00ean tr\u01b0\u1edbc: h\u00e3y tho\u00e1t n\u00f3 (Tr\u00ecnh theo d\u00f5i ho\u1ea1t \u0111\u1ed9ng ho\u1eb7c `pkill openkindd`) ho\u1eb7c ch\u1ecdn c\u1ed5ng kh\u00e1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u65e0\u6cd5\u5728 %@ \u4e0a\u542f\u52a8\u3002\u7aef\u53e3\u53ef\u80fd\u5df2\u88ab\u5360\u7528\uff0c\u53ef\u80fd\u662f\u4e4b\u524d\u4f1a\u8bdd\u9057\u7559\u8fd0\u884c\u7684 openkindd\uff1a\u8bf7\u9000\u51fa\u5b83\uff08\u6d3b\u52a8\u76d1\u89c6\u5668\u6216 `pkill openkindd`\uff09\uff0c\u6216\u9009\u62e9\u5176\u4ed6\u7aef\u53e3\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u7121\u6cd5\u5728 %@ \u4e0a\u555f\u52d5\u3002\u9023\u63a5\u57e0\u53ef\u80fd\u5df2\u88ab\u4f54\u7528\uff0c\u53ef\u80fd\u662f\u5148\u524d\u5de5\u4f5c\u968e\u6bb5\u907a\u7559\u57f7\u884c\u7684 openkindd\uff1a\u8acb\u7d50\u675f\u5b83\uff08\u6d3b\u52d5\u76e3\u8996\u5668\u6216 `pkill openkindd`\uff09\uff0c\u6216\u9078\u64c7\u5176\u4ed6\u9023\u63a5\u57e0\u3002"
          }
        }
      }
    },
    "openkindd is missing. Build the app bundle or set OPENKINDD_BINARY for development.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u0645\u0641\u0642\u0648\u062f. \u0623\u0646\u0634\u0626 \u062d\u0632\u0645\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0648 \u0627\u0636\u0628\u0637 OPENKINDD_BINARY \u0644\u0623\u063a\u0631\u0627\u0636 \u0627\u0644\u062a\u0637\u0648\u064a\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd fehlt. Erstellen Sie das App-Bundle oder setzen Sie OPENKINDD_BINARY f\u00fcr die Entwicklung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd is missing. Build the app bundle or set OPENKINDD_BINARY for development."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta openkindd. Compila el paquete de la app o define OPENKINDD_BINARY para desarrollo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd est introuvable. Compilez le paquet de l'app ou d\u00e9finissez OPENKINDD_BINARY pour le d\u00e9veloppement."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u05d7\u05e1\u05e8. \u05d1\u05e0\u05d4 \u05d0\u05ea \u05d7\u05d1\u05d9\u05dc\u05ea \u05d4\u05d9\u05d9\u05e9\u05d5\u05dd \u05d0\u05d5 \u05d4\u05d2\u05d3\u05e8 \u05d0\u05ea OPENKINDD_BINARY \u05dc\u05e6\u05d5\u05e8\u05db\u05d9 \u05e4\u05d9\u05ea\u05d5\u05d7."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u092e\u094c\u091c\u0942\u0926 \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0910\u092a \u092c\u0902\u0921\u0932 \u092c\u0928\u093e\u090f\u0901 \u092f\u093e \u0921\u0947\u0935\u0932\u092a\u092e\u0947\u0902\u091f \u0915\u0947 \u0932\u093f\u090f OPENKINDD_BINARY \u0938\u0947\u091f \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd tidak ditemukan. Bangun bundel aplikasi atau atur OPENKINDD_BINARY untuk pengembangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd non trovato. Compila il bundle dell'app o imposta OPENKINDD_BINARY per lo sviluppo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3002\u30a2\u30d7\u30ea\u30d0\u30f3\u30c9\u30eb\u3092\u30d3\u30eb\u30c9\u3059\u308b\u304b\u3001\u958b\u767a\u7528\u306b OPENKINDD_BINARY \u3092\u8a2d\u5b9a\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd\uac00 \uc5c6\uc2b5\ub2c8\ub2e4. \uc571 \ubc88\ub4e4\uc744 \ube4c\ub4dc\ud558\uac70\ub098 \uac1c\ubc1c\uc6a9\uc73c\ub85c OPENKINDD_BINARY\ub97c \uc124\uc815\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd ontbreekt. Bouw de app-bundel of stel OPENKINDD_BINARY in voor ontwikkeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak openkindd. Zbuduj pakiet aplikacji lub ustaw OPENKINDD_BINARY na potrzeby programowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd n\u00e3o encontrado. Compile o pacote do app ou defina OPENKINDD_BINARY para desenvolvimento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u043e\u0442\u0441\u0443\u0442\u0441\u0442\u0432\u0443\u0435\u0442. \u0421\u043e\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0430\u043a\u0435\u0442 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438\u043b\u0438 \u0437\u0430\u0434\u0430\u0439\u0442\u0435 OPENKINDD_BINARY \u0434\u043b\u044f \u0440\u0430\u0437\u0440\u0430\u0431\u043e\u0442\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd saknas. Bygg appaketet eller ange OPENKINDD_BINARY f\u00f6r utveckling."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd eksik. Uygulama paketini derleyin veya geli\u015ftirme i\u00e7in OPENKINDD_BINARY de\u011fi\u015fkenini ayarlay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "openkindd \u0432\u0456\u0434\u0441\u0443\u0442\u043d\u0456\u0439. \u0417\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0430\u043a\u0435\u0442 \u043f\u0440\u043e\u0433\u0440\u0430\u043c\u0438 \u0430\u0431\u043e \u0437\u0430\u0434\u0430\u0439\u0442\u0435 OPENKINDD_BINARY \u0434\u043b\u044f \u0440\u043e\u0437\u0440\u043e\u0431\u043a\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thi\u1ebfu openkindd. H\u00e3y build g\u00f3i \u1ee9ng d\u1ee5ng ho\u1eb7c \u0111\u1eb7t OPENKINDD_BINARY \u0111\u1ec3 ph\u00e1t tri\u1ec3n."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f3a\u5c11 openkindd\u3002\u8bf7\u6784\u5efa\u5e94\u7528\u5305\uff0c\u6216\u5728\u5f00\u53d1\u65f6\u8bbe\u7f6e OPENKINDD_BINARY\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7f3a\u5c11 openkindd\u3002\u8acb\u5efa\u7f6e App \u5957\u4ef6\uff0c\u6216\u5728\u958b\u767c\u6642\u8a2d\u5b9a OPENKINDD_BINARY\u3002"
          }
        }
      }
    },
    "that archive has no profile-backup manifest": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u064a\u062d\u062a\u0648\u064a \u0647\u0630\u0627 \u0627\u0644\u0623\u0631\u0634\u064a\u0641 \u0639\u0644\u0649 \u0628\u064a\u0627\u0646 \u0646\u0633\u062e\u0629 \u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0644\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dieses Archiv enth\u00e4lt kein Profil-Backup-Manifest"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "that archive has no profile-backup manifest"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "ese archivo comprimido no tiene manifiesto de copia de seguridad de perfil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cette archive ne contient pas de manifeste de sauvegarde de profil"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d0\u05e8\u05db\u05d9\u05d5\u05df \u05d0\u05d9\u05df \u05de\u05e0\u05d9\u05e4\u05e1\u05d8 \u05e9\u05dc \u05d2\u05d9\u05d1\u05d5\u05d9 \u05e4\u05e8\u05d5\u05e4\u05d9\u05dc"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0909\u0938 \u0906\u0930\u094d\u0915\u093e\u0907\u0935 \u092e\u0947\u0902 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932-\u092c\u0948\u0915\u0905\u092a \u092e\u0948\u0928\u093f\u092b\u093c\u0947\u0938\u094d\u091f \u0928\u0939\u0940\u0902 \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "arsip tersebut tidak memiliki manifes cadangan profil"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "quell'archivio non ha un manifest di backup del profilo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u306e\u30a2\u30fc\u30ab\u30a4\u30d6\u306b\u306f\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306e\u30de\u30cb\u30d5\u30a7\u30b9\u30c8\u304c\u3042\u308a\u307e\u305b\u3093"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud574\ub2f9 \uc544\uce74\uc774\ube0c\uc5d0 \ud504\ub85c\ud544 \ubc31\uc5c5 \ub9e4\ub2c8\ud398\uc2a4\ud2b8\uac00 \uc5c6\uc2b5\ub2c8\ub2e4"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "dat archief heeft geen manifest voor profielback-up"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "to archiwum nie ma manifestu kopii zapasowej profilu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "esse pacote n\u00e3o tem manifesto de backup de perfil"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0432 \u044d\u0442\u043e\u043c \u0430\u0440\u0445\u0438\u0432\u0435 \u043d\u0435\u0442 \u043c\u0430\u043d\u0438\u0444\u0435\u0441\u0442\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0439 \u043a\u043e\u043f\u0438\u0438 \u043f\u0440\u043e\u0444\u0438\u043b\u044f"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "arkivet saknar manifest f\u00f6r profils\u00e4kerhetskopia"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu ar\u015fivde profil yede\u011fi manifest dosyas\u0131 yok"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0443 \u0446\u044c\u043e\u043c\u0443 \u0430\u0440\u0445\u0456\u0432\u0456 \u043d\u0435\u043c\u0430\u0454 \u043c\u0430\u043d\u0456\u0444\u0435\u0441\u0442\u0443 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u043e\u0457 \u043a\u043e\u043f\u0456\u0457 \u043f\u0440\u043e\u0444\u0456\u043b\u044e"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "kho l\u01b0u tr\u1eef \u0111\u00f3 kh\u00f4ng c\u00f3 t\u1ec7p k\u00ea khai sao l\u01b0u h\u1ed3 s\u01a1"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8be5\u5f52\u6863\u6ca1\u6709\u914d\u7f6e\u6863\u6848\u5907\u4efd\u6e05\u5355"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a72\u5c01\u5b58\u6a94\u6c92\u6709\u8a2d\u5b9a\u6a94\u5099\u4efd\u6e05\u55ae"
          }
        }
      }
    },
    "that backup uses format %lld, which this app does not read; update the app first": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0633\u062a\u062e\u062f\u0645 \u0647\u0630\u0647 \u0627\u0644\u0646\u0633\u062e\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0637\u064a\u0629 \u0627\u0644\u062a\u0646\u0633\u064a\u0642 %lld \u0627\u0644\u0630\u064a \u0644\u0627 \u064a\u0642\u0631\u0624\u0647 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u061b \u062d\u062f\u0651\u062b \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0648\u0644\u064b\u0627"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "dieses Backup verwendet Format %lld, das diese App nicht lesen kann; aktualisieren Sie zuerst die App"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "that backup uses format %lld, which this app does not read; update the app first"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "esa copia de seguridad usa el formato %lld, que esta app no puede leer; actualiza la app primero"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "cette sauvegarde utilise le format %lld, que cette app ne sait pas lire ; mettez d'abord l'app \u00e0 jour"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d2\u05d9\u05d1\u05d5\u05d9 \u05de\u05e9\u05ea\u05de\u05e9 \u05d1\u05e4\u05d5\u05e8\u05de\u05d8 %lld, \u05e9\u05d4\u05d9\u05d9\u05e9\u05d5\u05dd \u05d4\u05d6\u05d4 \u05d0\u05d9\u05e0\u05d5 \u05e7\u05d5\u05e8\u05d0; \u05e2\u05d3\u05db\u05df \u05ea\u05d7\u05d9\u05dc\u05d4 \u05d0\u05ea \u05d4\u05d9\u05d9\u05e9\u05d5\u05dd"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0939 \u092c\u0948\u0915\u0905\u092a \u092b\u093c\u0949\u0930\u094d\u092e\u0947\u091f %lld \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u093e \u0939\u0948, \u091c\u093f\u0938\u0947 \u092f\u0939 \u0910\u092a \u0928\u0939\u0940\u0902 \u092a\u0922\u093c \u0938\u0915\u0924\u093e; \u092a\u0939\u0932\u0947 \u0910\u092a \u0905\u092a\u0921\u0947\u091f \u0915\u0930\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "cadangan tersebut menggunakan format %lld, yang tidak dapat dibaca aplikasi ini; perbarui aplikasi terlebih dahulu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "quel backup usa il formato %lld, che questa app non legge; aggiorna prima l'app"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u305d\u306e\u30d0\u30c3\u30af\u30a2\u30c3\u30d7\u306f\u5f62\u5f0f %lld \u3092\u4f7f\u7528\u3057\u3066\u304a\u308a\u3001\u3053\u306e\u30a2\u30d7\u30ea\u3067\u306f\u8aad\u307f\u53d6\u308c\u307e\u305b\u3093\u3002\u5148\u306b\u30a2\u30d7\u30ea\u3092\u30a2\u30c3\u30d7\u30c7\u30fc\u30c8\u3057\u3066\u304f\u3060\u3055\u3044"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud574\ub2f9 \ubc31\uc5c5\uc740 \ud615\uc2dd %lld\uc744(\ub97c) \uc0ac\uc6a9\ud558\uba70 \uc774 \uc571\uc5d0\uc11c \uc77d\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc571\uc744 \uc5c5\ub370\uc774\ud2b8\ud558\uc138\uc694"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "die back-up gebruikt formaat %lld, dat deze app niet kan lezen; werk eerst de app bij"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ta kopia zapasowa u\u017cywa formatu %lld, kt\u00f3rego ta aplikacja nie odczytuje; najpierw zaktualizuj aplikacj\u0119"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "esse backup usa o formato %lld, que este app n\u00e3o l\u00ea; atualize o app primeiro"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u044d\u0442\u0430 \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430\u044f \u043a\u043e\u043f\u0438\u044f \u0438\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0435\u0442 \u0444\u043e\u0440\u043c\u0430\u0442 %lld, \u043a\u043e\u0442\u043e\u0440\u044b\u0439 \u044d\u0442\u043e \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435 \u043d\u0435 \u0447\u0438\u0442\u0430\u0435\u0442; \u0441\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0431\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u0440\u0438\u043b\u043e\u0436\u0435\u043d\u0438\u0435"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "s\u00e4kerhetskopian anv\u00e4nder format %lld, som den h\u00e4r appen inte kan l\u00e4sa; uppdatera appen f\u00f6rst"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu yedek, bu uygulaman\u0131n okuyamad\u0131\u011f\u0131 %lld bi\u00e7imini kullan\u0131yor; \u00f6nce uygulamay\u0131 g\u00fcncelleyin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0446\u044f \u0440\u0435\u0437\u0435\u0440\u0432\u043d\u0430 \u043a\u043e\u043f\u0456\u044f \u0432\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0454 \u0444\u043e\u0440\u043c\u0430\u0442 %lld, \u044f\u043a\u0438\u0439 \u0446\u0435\u0439 \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a \u043d\u0435 \u0447\u0438\u0442\u0430\u0454; \u0441\u043f\u0435\u0440\u0448\u0443 \u043e\u043d\u043e\u0432\u0456\u0442\u044c \u0437\u0430\u0441\u0442\u043e\u0441\u0443\u043d\u043e\u043a"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "b\u1ea3n sao l\u01b0u \u0111\u00f3 d\u00f9ng \u0111\u1ecbnh d\u1ea1ng %lld m\u00e0 \u1ee9ng d\u1ee5ng n\u00e0y kh\u00f4ng \u0111\u1ecdc \u0111\u01b0\u1ee3c; h\u00e3y c\u1eadp nh\u1eadt \u1ee9ng d\u1ee5ng tr\u01b0\u1edbc"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8be5\u5907\u4efd\u4f7f\u7528\u683c\u5f0f %lld\uff0c\u6b64\u5e94\u7528\u65e0\u6cd5\u8bfb\u53d6\uff1b\u8bf7\u5148\u66f4\u65b0\u5e94\u7528"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a72\u5099\u4efd\u4f7f\u7528\u683c\u5f0f %lld\uff0c\u6b64 App \u7121\u6cd5\u8b80\u53d6\uff1b\u8acb\u5148\u66f4\u65b0 App"
          }
        }
      }
    },
