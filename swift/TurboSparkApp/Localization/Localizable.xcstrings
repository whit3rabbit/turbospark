            "value": "\u6b7b\u6d3b\u78ba\u8a8d\u3001\u63a5\u7d9a\u4e2d\u306e\u30e2\u30c7\u30eb ID\u3001\u30a8\u30f3\u30b8\u30f3\u306e\u30d0\u30fc\u30b8\u30e7\u30f3\u3002"
