    "That folder is not a plugin: it has no %@ and no commands/, agents/, skills/, hooks/ or .mcp.json.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0647\u0630\u0627 \u0627\u0644\u0645\u062c\u0644\u062f \u0644\u064a\u0633 \u0645\u0644\u062d\u0642\u064b\u0627: \u0644\u0627 \u064a\u062d\u062a\u0648\u064a \u0639\u0644\u0649 %@ \u0648\u0644\u0627 \u0639\u0644\u0649 commands/ \u0623\u0648 agents/ \u0623\u0648 skills/ \u0623\u0648 hooks/ \u0623\u0648 .mcp.json."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner ist kein Plugin: Er enth\u00e4lt weder %@ noch commands/, agents/, skills/, hooks/ oder .mcp.json."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That folder is not a plugin: it has no %@ and no commands/, agents/, skills/, hooks/ or .mcp.json."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa carpeta no es un plugin: no tiene %@ ni commands/, agents/, skills/, hooks/ o .mcp.json."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier n'est pas un plugin : il ne contient ni %@, ni commands/, agents/, skills/, hooks/ ou .mcp.json."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05d4\u05d6\u05d5 \u05d0\u05d9\u05e0\u05d4 \u05ea\u05d5\u05e1\u05e3: \u05d0\u05d9\u05df \u05d1\u05d4 %@ \u05d5\u05d0\u05d9\u05df \u05d1\u05d4 commands/, agents/, skills/, hooks/ \u05d0\u05d5 .mcp.json."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0935\u0939 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u092a\u094d\u0932\u0917\u0907\u0928 \u0928\u0939\u0940\u0902 \u0939\u0948: \u0909\u0938\u092e\u0947\u0902 \u0928 %@ \u0939\u0948 \u0914\u0930 \u0928 \u0939\u0940 commands/, agents/, skills/, hooks/ \u092f\u093e .mcp.json\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder itu bukan plugin: tidak ada %@ dan tidak ada commands/, agents/, skills/, hooks/, atau .mcp.json."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella cartella non \u00e8 un plugin: non contiene %@ n\u00e9 commands/, agents/, skills/, hooks/ o .mcp.json."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d5\u30a9\u30eb\u30c0\u306f\u30d7\u30e9\u30b0\u30a4\u30f3\u3067\u306f\u3042\u308a\u307e\u305b\u3093: %@ \u3082 commands/\u3001agents/\u3001skills/\u3001hooks/\u3001.mcp.json \u3082\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud3f4\ub354\ub294 \ud50c\ub7ec\uadf8\uc778\uc774 \uc544\ub2d9\ub2c8\ub2e4. %@\ub3c4 \uc5c6\uace0 commands/, agents/, skills/, hooks/, .mcp.json\ub3c4 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die map is geen plug-in: er staat geen %@ in en geen commands/, agents/, skills/, hooks/ of .mcp.json."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten folder nie jest wtyczk\u0105: nie zawiera %@ ani commands/, agents/, skills/, hooks/ czy .mcp.json."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa pasta n\u00e3o \u00e9 um plugin: n\u00e3o tem %@ nem commands/, agents/, skills/, hooks/ ou .mcp.json."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u042d\u0442\u0430 \u043f\u0430\u043f\u043a\u0430 \u043d\u0435 \u044f\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u043f\u043b\u0430\u0433\u0438\u043d\u043e\u043c: \u0432 \u043d\u0435\u0439 \u043d\u0435\u0442 \u043d\u0438 %@, \u043d\u0438 commands/, agents/, skills/, hooks/ \u0438\u043b\u0438 .mcp.json."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den mappen \u00e4r inte ett till\u00e4gg: den saknar %@ och har ingen commands/, agents/, skills/, hooks/ eller .mcp.json."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu klas\u00f6r bir eklenti de\u011fil: %@ yok, commands/, agents/, skills/, hooks/ veya .mcp.json da yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u044f \u0442\u0435\u043a\u0430 \u043d\u0435 \u0454 \u043f\u043b\u0430\u0433\u0456\u043d\u043e\u043c: \u0443 \u043d\u0456\u0439 \u043d\u0435\u043c\u0430\u0454 \u043d\u0456 %@, \u043d\u0456 commands/, agents/, skills/, hooks/ \u0447\u0438 .mcp.json."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Th\u01b0 m\u1ee5c \u0111\u00f3 kh\u00f4ng ph\u1ea3i l\u00e0 plugin: kh\u00f4ng c\u00f3 %@ v\u00e0 c\u0169ng kh\u00f4ng c\u00f3 commands/, agents/, skills/, hooks/ ho\u1eb7c .mcp.json."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8be5\u6587\u4ef6\u5939\u4e0d\u662f\u63d2\u4ef6\uff1a\u5176\u4e2d\u6ca1\u6709 %@\uff0c\u4e5f\u6ca1\u6709 commands/\u3001agents/\u3001skills/\u3001hooks/ \u6216 .mcp.json\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8a72\u8cc7\u6599\u593e\u4e0d\u662f\u5916\u639b\uff1a\u5176\u4e2d\u6c92\u6709 %@\uff0c\u4e5f\u6c92\u6709 commands/\u3001agents/\u3001skills/\u3001hooks/ \u6216 .mcp.json\u3002"
          }
        }
      }
    },
