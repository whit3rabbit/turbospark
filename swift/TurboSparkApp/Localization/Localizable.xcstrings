    "Switch to another profile before deleting this one.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0628\u062f\u0651\u0644 \u0625\u0644\u0649 \u0645\u0644\u0641 \u0634\u062e\u0635\u064a \u0622\u062e\u0631 \u0642\u0628\u0644 \u062d\u0630\u0641 \u0647\u0630\u0627 \u0627\u0644\u0645\u0644\u0641."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wechseln Sie zu einem anderen Profil, bevor Sie dieses l\u00f6schen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to another profile before deleting this one."
