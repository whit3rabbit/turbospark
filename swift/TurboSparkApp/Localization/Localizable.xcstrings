          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilo \"%@\" importato dal backup. Passa a questo profilo per iniziare a usarlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロファイル \"%@\" をバックアップからインポートしました。使用を開始するには、このプロファイルに切り替えてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업에서 프로필 \"%@\"을(를) 가져왔습니다. 사용하려면 이 프로필로 전환하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Profiel \"%@\" geïmporteerd uit back-up. Schakel ernaar over om het te gaan gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
