    "Reopen recordings and takes, or start with an audio file.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reopen recordings and takes, or start with an audio file."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrir grabaciones y tomas, o empieza con un archivo de audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez des enregistrements et des prises, ou commencez avec un fichier audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ffne Aufnahmen und Takes erneut oder beginne mit einer Audiodatei."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riapri registrazioni e take, oppure inizia con un file audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabra grava\u00e7\u00f5es e tomadas ou comece com um arquivo de \u00e1udio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open opnamen en takes opnieuw of begin met een audiobestand."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6ppna inspelningar och tagningar igen eller b\u00f6rja med en ljudfil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otw\u00f3rz ponownie nagrania i wersje lub zacznij od pliku audio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kay\u0131tlar\u0131 ve \u00e7ekimleri yeniden a\u00e7\u0131n veya bir ses dosyas\u0131yla ba\u015flay\u0131n."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka kembali rekaman dan take, atau mulai dengan berkas audio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041e\u0442\u043a\u0440\u043e\u0439\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u0438 \u0434\u0443\u0431\u043b\u0438 \u0437\u0430\u043d\u043e\u0432\u043e \u0438\u043b\u0438 \u043d\u0430\u0447\u043d\u0438\u0442\u0435 \u0441 \u0430\u0443\u0434\u0438\u043e\u0444\u0430\u0439\u043b\u0430."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u043d\u043e\u0432\u0443 \u0432\u0456\u0434\u043a\u0440\u0438\u0439\u0442\u0435 \u0437\u0430\u043f\u0438\u0441\u0438 \u0442\u0430 \u0434\u0443\u0431\u043b\u0456 \u0430\u0431\u043e \u043f\u043e\u0447\u043d\u0456\u0442\u044c \u0437 \u0430\u0443\u0434\u0456\u043e\u0444\u0430\u0439\u043b\u0443."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u1edf l\u1ea1i b\u1ea3n ghi v\u00e0 l\u01b0\u1ee3t thu, ho\u1eb7c b\u1eaft \u0111\u1ea7u b\u1eb1ng t\u1ec7p \u00e2m thanh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9332\u97f3\u3084\u30c6\u30a4\u30af\u3092\u958b\u304d\u76f4\u3059\u304b\u3001\u97f3\u58f0\u30d5\u30a1\u30a4\u30eb\u304b\u3089\u59cb\u3081\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub179\uc74c\uacfc \ud14c\uc774\ud06c\ub97c \ub2e4\uc2dc \uc5f4\uac70\ub098 \uc624\ub514\uc624 \ud30c\uc77c\ub85c \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u65b0\u6253\u5f00\u5f55\u97f3\u548c\u751f\u6210\u7248\u672c\uff0c\u6216\u4ece\u97f3\u9891\u6587\u4ef6\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u91cd\u65b0\u958b\u555f\u9304\u97f3\u548c\u751f\u6210\u7248\u672c\uff0c\u6216\u5f9e\u97f3\u8a0a\u6a94\u6848\u958b\u59cb\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0639\u062f \u0641\u062a\u062d \u0627\u0644\u062a\u0633\u062c\u064a\u0644\u0627\u062a \u0648\u0627\u0644\u0646\u0633\u062e \u0623\u0648 \u0627\u0628\u062f\u0623 \u0628\u0645\u0644\u0641 \u0635\u0648\u062a\u064a."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e4\u05ea\u05d7 \u05de\u05d7\u05d3\u05e9 \u05d4\u05e7\u05dc\u05d8\u05d5\u05ea \u05d5\u05d8\u05d9\u05d9\u05e7\u05d9\u05dd, \u05d0\u05d5 \u05d4\u05ea\u05d7\u05dc \u05de\u05e7\u05d5\u05d1\u05e5 \u05e9\u05de\u05e2."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u0914\u0930 \u091f\u0947\u0915 \u092b\u093f\u0930 \u0938\u0947 \u0916\u094b\u0932\u0947\u0902 \u092f\u093e \u0911\u0921\u093f\u092f\u094b \u092b\u093c\u093e\u0907\u0932 \u0938\u0947 \u0936\u0941\u0930\u0942 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
