        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune d\u00e9finition d'agent ne correspond au filtre de port\u00e9e s\u00e9lectionn\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d0\u05d9\u05df \u05d4\u05d2\u05d3\u05e8\u05d5\u05ea \u05e1\u05d5\u05db\u05df \u05e9\u05ea\u05d5\u05d0\u05de\u05d5\u05ea \u05dc\u05de\u05e1\u05e0\u05df \u05d4\u05d4\u05d9\u05e7\u05e3 \u05e9\u05e0\u05d1\u05d7\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091a\u092f\u0928\u093f\u0924 \u0938\u094d\u0915\u094b\u092a \u092b\u093c\u093f\u0932\u094d\u091f\u0930 \u0938\u0947 \u0915\u094b\u0908 \u090f\u091c\u0947\u0902\u091f \u092a\u0930\u093f\u092d\u093e\u0937\u093e \u092e\u0947\u0932 \u0928\u0939\u0940\u0902 \u0916\u093e\u0924\u0940\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada definisi agen yang cocok dengan filter cakupan terpilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna definizione di agente corrisponde al filtro di ambito selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u629e\u3057\u305f\u30b9\u30b3\u30fc\u30d7\u30d5\u30a3\u30eb\u30bf\u306b\u4e00\u81f4\u3059\u308b\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u5b9a\u7fa9\u306f\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc120\ud0dd\ud55c \ubc94\uc704 \ud544\ud130\uc640 \uc77c\uce58\ud558\ub294 \uc5d0\uc774\uc804\ud2b8 \uc815\uc758\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen agentdefinities komen overeen met het geselecteerde bereikfilter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "\u017badna definicja agenta nie pasuje do wybranego filtra zakresu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma defini\u00e7\u00e3o de agente corresponde ao filtro de escopo selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0438 \u043e\u0434\u043d\u043e \u043e\u043f\u0440\u0435\u0434\u0435\u043b\u0435\u043d\u0438\u0435 \u0430\u0433\u0435\u043d\u0442\u0430 \u043d\u0435 \u0441\u043e\u043e\u0442\u0432\u0435\u0442\u0441\u0442\u0432\u0443\u0435\u0442 \u0432\u044b\u0431\u0440\u0430\u043d\u043d\u043e\u043c\u0443 \u0444\u0438\u043b\u044c\u0442\u0440\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga agentdefinitioner matchar det valda omf\u00e5ngsfiltret."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Se\u00e7ilen kapsam filtresiyle e\u015fle\u015fen arac\u0131 tan\u0131m\u0131 yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0416\u043e\u0434\u043d\u0435 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f \u0430\u0433\u0435\u043d\u0442\u0430 \u043d\u0435 \u0432\u0456\u0434\u043f\u043e\u0432\u0456\u0434\u0430\u0454 \u0432\u0438\u0431\u0440\u0430\u043d\u043e\u043c\u0443 \u0444\u0456\u043b\u044c\u0442\u0440\u0443 \u043e\u0431\u043b\u0430\u0441\u0442\u0456."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng c\u00f3 \u0111\u1ecbnh ngh\u0129a t\u00e1c nh\u00e2n n\u00e0o kh\u1edbp b\u1ed9 l\u1ecdc ph\u1ea1m vi \u0111\u00e3 ch\u1ecdn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6ca1\u6709\u4ee3\u7406\u5b9a\u4e49\u7b26\u5408\u6240\u9009\u7684\u8303\u56f4\u7b5b\u9009\u6761\u4ef6\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6c92\u6709\u4ee3\u7406\u5b9a\u7fa9\u7b26\u5408\u6240\u9078\u7684\u7bc4\u570d\u7be9\u9078\u689d\u4ef6\u3002"
          }
        }
      }
    },
