        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0930\u0947\u0902\u0921\u0930 \u0915\u093f\u090f \u0917\u090f \u092a\u0947\u091c \u0914\u0930 \u0909\u0938\u0915\u0947 \u0938\u094d\u0930\u094b\u0924 \u0915\u0947 \u092c\u0940\u091a \u092c\u0926\u0932\u0947\u0902"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
