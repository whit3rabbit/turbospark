    "The voice-cloning encoder in this model is a community re-upload. Its origin and license have not been verified.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice-cloning encoder in this model is a community re-upload. Its origin and license have not been verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El codificador de clonaci\u00f3n de voz de este modelo es una resubida de la comunidad. Su origen y su licencia no se han verificado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encodeur de clonage vocal de ce mod\u00e8le est une republication communautaire. Son origine et sa licence n'ont pas \u00e9t\u00e9 v\u00e9rifi\u00e9es."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stimmklon-Encoder dieses Modells ist ein erneuter Upload aus der Community. Herkunft und Lizenz wurden nicht \u00fcberpr\u00fcft."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'encoder di clonazione vocale di questo modello \u00e8 un ricaricamento della community. Origine e licenza non sono state verificate."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O codificador de clonagem de voz deste modelo \u00e9 um reenvio da comunidade. A origem e a licen\u00e7a n\u00e3o foram verificadas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0434\u0438\u0440\u043e\u0432\u0449\u0438\u043a \u0434\u043b\u044f \u043a\u043b\u043e\u043d\u0438\u0440\u043e\u0432\u0430\u043d\u0438\u044f \u0433\u043e\u043b\u043e\u0441\u0430 \u0432 \u044d\u0442\u043e\u0439 \u043c\u043e\u0434\u0435\u043b\u0438 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0437\u0430\u0433\u0440\u0443\u0436\u0435\u043d \u0441\u043e\u043e\u0431\u0449\u0435\u0441\u0442\u0432\u043e\u043c. \u0415\u0433\u043e \u043f\u0440\u043e\u0438\u0441\u0445\u043e\u0436\u0434\u0435\u043d\u0438\u0435 \u0438 \u043b\u0438\u0446\u0435\u043d\u0437\u0438\u044f \u043d\u0435 \u043f\u0440\u043e\u0432\u0435\u0440\u0435\u043d\u044b."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30e2\u30c7\u30eb\u306e\u97f3\u58f0\u30af\u30ed\u30fc\u30f3\u7528\u30a8\u30f3\u30b3\u30fc\u30c0\u30fc\u306f\u3001\u30b3\u30df\u30e5\u30cb\u30c6\u30a3\u306b\u3088\u308b\u518d\u30a2\u30c3\u30d7\u30ed\u30fc\u30c9\u3067\u3059\u3002\u51fa\u6240\u3068\u30e9\u30a4\u30bb\u30f3\u30b9\u306f\u78ba\u8a8d\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ubaa8\ub378\uc758 \uc74c\uc131 \ubcf5\uc81c \uc778\ucf54\ub354\ub294 \ucee4\ubba4\ub2c8\ud2f0\uac00 \ub2e4\uc2dc \uc5c5\ub85c\ub4dc\ud55c \uac83\uc785\ub2c8\ub2e4. \ucd9c\ucc98\uc640 \ub77c\uc774\uc120\uc2a4\ub294 \ud655\uc778\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u4e2d\u7684\u58f0\u97f3\u514b\u9686\u7f16\u7801\u5668\u7531\u793e\u533a\u91cd\u65b0\u4e0a\u4f20\uff0c\u5176\u6765\u6e90\u548c\u8bb8\u53ef\u8bc1\u5c1a\u672a\u7ecf\u8fc7\u6838\u5b9e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u6a21\u578b\u4e2d\u7684\u8072\u97f3\u8907\u88fd\u7de8\u78bc\u5668\u7531\u793e\u7fa4\u91cd\u65b0\u4e0a\u50b3\uff0c\u5176\u4f86\u6e90\u548c\u6388\u6b0a\u5c1a\u672a\u7d93\u904e\u6838\u5be6\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u064f\u0631\u0645\u0650\u0651\u0632 \u0627\u0633\u062a\u0646\u0633\u0627\u062e \u0627\u0644\u0635\u0648\u062a \u0641\u064a \u0647\u0630\u0627 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0623\u0639\u0627\u062f \u0627\u0644\u0645\u062c\u062a\u0645\u0639 \u0631\u0641\u0639\u0647. \u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642 \u0645\u0646 \u0645\u0635\u062f\u0631\u0647 \u0648\u062a\u0631\u062e\u064a\u0635\u0647."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05de\u05e7\u05d5\u05d3\u05d3 \u05e9\u05db\u05e4\u05d5\u05dc \u05d4\u05e7\u05d5\u05dc \u05d1\u05de\u05d5\u05d3\u05dc \u05d4\u05d6\u05d4 \u05d4\u05d5\u05d0 \u05d4\u05e2\u05dc\u05d0\u05d4 \u05d7\u05d5\u05d6\u05e8\u05ea \u05e9\u05dc \u05d4\u05e7\u05d4\u05d9\u05dc\u05d4. \u05de\u05e7\u05d5\u05e8\u05d5 \u05d5\u05d4\u05e8\u05d9\u05e9\u05d9\u05d5\u05df \u05e9\u05dc\u05d5 \u05dc\u05d0 \u05d0\u05d5\u05de\u05ea\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u092e\u0949\u0921\u0932 \u0915\u093e \u0935\u0949\u0907\u0938-\u0915\u094d\u0932\u094b\u0928\u093f\u0902\u0917 \u090f\u0928\u0915\u094b\u0921\u0930 \u0938\u092e\u0941\u0926\u093e\u092f \u0926\u094d\u0935\u093e\u0930\u093e \u0926\u094b\u092c\u093e\u0930\u093e \u0905\u092a\u0932\u094b\u0921 \u0915\u093f\u092f\u093e \u0917\u092f\u093e \u0939\u0948\u0964 \u0907\u0938\u0915\u0947 \u0938\u094d\u0930\u094b\u0924 \u0914\u0930 \u0932\u093e\u0907\u0938\u0947\u0902\u0938 \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0928\u0939\u0940\u0902 \u0939\u0941\u0908 \u0939\u0948\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De stemkloon-encoder in dit model is een herupload uit de community. De herkomst en licentie zijn niet gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koder klonowania g\u0142osu w tym modelu to ponowne przes\u0142anie przez spo\u0142eczno\u015b\u0107. Jego pochodzenie i licencja nie zosta\u0142y zweryfikowane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu modeldeki ses klonlama kodlay\u0131c\u0131s\u0131 topluluk taraf\u0131ndan yeniden y\u00fcklenmi\u015ftir. Kayna\u011f\u0131 ve lisans\u0131 do\u011frulanmad\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041a\u043e\u0434\u0443\u0432\u0430\u043b\u044c\u043d\u0438\u043a \u0434\u043b\u044f \u043a\u043b\u043e\u043d\u0443\u0432\u0430\u043d\u043d\u044f \u0433\u043e\u043b\u043e\u0441\u0443 \u0432 \u0446\u0456\u0439 \u043c\u043e\u0434\u0435\u043b\u0456 \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e \u0437\u0430\u0432\u0430\u043d\u0442\u0430\u0436\u0438\u043b\u0430 \u0441\u043f\u0456\u043b\u044c\u043d\u043e\u0442\u0430. \u0419\u043e\u0433\u043e \u043f\u043e\u0445\u043e\u0434\u0436\u0435\u043d\u043d\u044f \u0442\u0430 \u043b\u0456\u0446\u0435\u043d\u0437\u0456\u044e \u043d\u0435 \u043f\u0435\u0440\u0435\u0432\u0456\u0440\u0435\u043d\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00f6stkloningskodaren i den h\u00e4r modellen \u00e4r en ny uppladdning fr\u00e5n communityn. Ursprung och licens har inte kontrollerats."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ed9 m\u00e3 h\u00f3a nh\u00e2n b\u1ea3n gi\u1ecdng n\u00f3i trong m\u00f4 h\u00ecnh n\u00e0y do c\u1ed9ng \u0111\u1ed3ng t\u1ea3i l\u1ea1i. Ngu\u1ed3n g\u1ed1c v\u00e0 gi\u1ea5y ph\u00e9p c\u1ee7a n\u00f3 ch\u01b0a \u0111\u01b0\u1ee3c x\u00e1c minh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoder kloning suara dalam model ini diunggah ulang oleh komunitas. Asal dan lisensinya belum diverifikasi."
          }
        }
      }
    },
    "Install a supported Qwen3-TTS, Kokoro, or MegaTTS3 model in Audio Studio first.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install a supported Qwen3-TTS, Kokoro, or MegaTTS3 model in Audio Studio first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala primero un modelo compatible de Qwen3-TTS, Kokoro o MegaTTS3 en Audio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez d'abord un mod\u00e8le Qwen3-TTS, Kokoro ou MegaTTS3 pris en charge dans Audio."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie zuerst ein unterst\u00fctztes Qwen3-TTS-, Kokoro- oder MegaTTS3-Modell unter Audio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa prima un modello Qwen3-TTS, Kokoro o MegaTTS3 supportato in Audio."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale primeiro um modelo Qwen3-TTS, Kokoro ou MegaTTS3 compat\u00edvel em \u00c1udio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u0443\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c Qwen3-TTS, Kokoro \u0438\u043b\u0438 MegaTTS3 \u0432 \u0440\u0430\u0437\u0434\u0435\u043b\u0435 \u00ab\u0410\u0443\u0434\u0438\u043e\u00bb."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5148\u306b\u300c\u97f3\u58f0\u300d\u3067\u3001\u30b5\u30dd\u30fc\u30c8\u3055\u308c\u3066\u3044\u308b Qwen3-TTS\u3001Kokoro\u3001\u307e\u305f\u306f MegaTTS3 \u30e2\u30c7\u30eb\u3092\u30a4\u30f3\u30b9\u30c8\u30fc\u30eb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uba3c\uc800 \uc624\ub514\uc624\uc5d0\uc11c \uc9c0\uc6d0\ub418\ub294 Qwen3-TTS, Kokoro \ub610\ub294 MegaTTS3 \ubaa8\ub378\uc744 \uc124\uce58\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u5148\u5728\u97f3\u9891\u4e2d\u5b89\u88c5\u53d7\u652f\u6301\u7684 Qwen3-TTS\u3001Kokoro \u6216 MegaTTS3 \u6a21\u578b\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u5148\u5728\u97f3\u8a0a\u4e2d\u5b89\u88dd\u652f\u63f4\u7684 Qwen3-TTS\u3001Kokoro \u6216 MegaTTS3 \u6a21\u578b\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0642\u0645 \u0628\u062a\u062b\u0628\u064a\u062a \u0646\u0645\u0648\u0630\u062c Qwen3-TTS \u0623\u0648 Kokoro \u0623\u0648 MegaTTS3 \u0627\u0644\u0645\u062f\u0639\u0648\u0645 \u0641\u064a \u0627\u0644\u0635\u0648\u062a \u0623\u0648\u0644\u0627\u064b."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05e7\u05df \u05ea\u05d7\u05d9\u05dc\u05d4 \u05de\u05d5\u05d3\u05dc Qwen3-TTS, Kokoro \u05d0\u05d5 MegaTTS3 \u05e0\u05ea\u05de\u05da \u05d1\u05e7\u05d8\u05e2 \"\u05e9\u05de\u05e2\"."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u0939\u0932\u0947 \u0911\u0921\u093f\u092f\u094b \u092e\u0947\u0902 \u090f\u0915 \u0938\u092e\u0930\u094d\u0925\u093f\u0924 Qwen3-TTS, Kokoro \u092f\u093e MegaTTS3 \u092e\u0949\u0921\u0932 \u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer eerst een ondersteund Qwen3-TTS-, Kokoro- of MegaTTS3-model in Audio."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zainstaluj obs\u0142ugiwany model Qwen3-TTS, Kokoro lub MegaTTS3 w sekcji Audio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6nce Ses b\u00f6l\u00fcm\u00fcnde desteklenen bir Qwen3-TTS, Kokoro veya MegaTTS3 modeli y\u00fckleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043f\u043e\u0447\u0430\u0442\u043a\u0443 \u0432\u0441\u0442\u0430\u043d\u043e\u0432\u0456\u0442\u044c \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0443 \u043c\u043e\u0434\u0435\u043b\u044c Qwen3-TTS, Kokoro \u0430\u0431\u043e MegaTTS3 \u0432 \u0440\u043e\u0437\u0434\u0456\u043b\u0456 \u00ab\u0410\u0443\u0434\u0456\u043e\u00bb."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera f\u00f6rst en Qwen3-TTS-, Kokoro- eller MegaTTS3-modell som st\u00f6ds i Ljud."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tr\u01b0\u1edbc ti\u00ean h\u00e3y c\u00e0i \u0111\u1eb7t m\u00f4 h\u00ecnh Qwen3-TTS, Kokoro ho\u1eb7c MegaTTS3 \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 trong \u00c2m thanh."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang model Qwen3-TTS, Kokoro, atau MegaTTS3 yang didukung di Audio terlebih dahulu."
          }
        }
      }
    },
