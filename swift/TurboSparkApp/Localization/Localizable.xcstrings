        }
      }
    },
    "The current workspace folder is not tracked by Git. Initialize a repository to enable version control, change inspection, and diffs.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلد مساحة العمل الحالي غير متتبع بواسطة Git. هيّئ مستودعا لتفعيل التحكم بالإصدارات وفحص التغييرات والفروق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Arbeitsbereichsordner wird nicht von Git verfolgt. Initialisieren Sie ein Repository, um Versionskontrolle, Änderungsprüfung und Diffs zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current workspace folder is not tracked by Git. Initialize a repository to enable version control, change inspection, and diffs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de trabajo actual no está bajo seguimiento de Git. Inicializa un repositorio para habilitar el control de versiones, la inspección de cambios y las diferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de travail actuel n'est pas suivi par Git. Initialisez un dépôt pour activer le contrôle de version, l'inspection des modifications et les différences."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקיית סביבת העבודה הנוכחית אינה במעקב של Git. אתחל מאגר כדי לאפשר בקרת גרסאות, בדיקת שינויים והשוואות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान वर्कस्पेस फ़ोल्डर Git द्वारा ट्रैक नहीं किया जा रहा। संस्करण नियंत्रण, बदलाव निरीक्षण और डिफ़ सक्षम करने के लिए रिपॉजिटरी आरंभ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ruang kerja saat ini tidak dilacak Git. Inisialisasi repositori untuk mengaktifkan kontrol versi, pemeriksaan perubahan, dan diff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella dell'area di lavoro corrente non è tracciata da Git. Inizializza un repository per abilitare il controllo di versione, l'ispezione delle modifiche e le differenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のワークスペースフォルダは Git で管理されていません。バージョン管理、変更の確認、差分を有効にするにはリポジトリを初期化してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업 공간 폴더는 Git으로 추적되지 않습니다. 버전 관리, 변경 사항 확인, 차이 보기를 사용하려면 리포지토리를 초기화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige werkruimtemap wordt niet door Git bijgehouden. Initialiseer een repository om versiebeheer, wijzigingsinspectie en verschillen in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżący folder obszaru roboczego nie jest śledzony przez Git. Zainicjuj repozytorium, aby włączyć kontrolę wersji, przegląd zmian i różnice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de trabalho atual não é rastreada pelo Git. Inicialize um repositório para habilitar controle de versão, inspeção de alterações e diferenças."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая папка рабочей области не отслеживается Git. Инициализируйте репозиторий, чтобы включить контроль версий, просмотр изменений и различия."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktuella arbetsytemappen spåras inte av Git. Initiera en utvecklingskatalog för att aktivera versionshantering, ändringsgranskning och skillnader."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli çalışma alanı klasörü Git tarafından izlenmiyor. Sürüm denetimi, değişiklik incelemesi ve farkları etkinleştirmek için bir depo başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточна папка робочої області не відстежується Git. Ініціалізуйте репозиторій, щоб увімкнути контроль версій, перегляд змін і відмінності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục không gian làm việc hiện tại chưa được Git theo dõi. Khởi tạo một kho để bật quản lý phiên bản, xem thay đổi và so sánh khác biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前工作区文件夹未被 Git 跟踪。初始化仓库即可启用版本控制、变更查看和差异比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前工作區資料夾未被 Git 追蹤。初始化儲存庫即可啟用版本控制、變更檢視與差異比較。"
          }
        }
      }
    },
    "The name the `agent` tool and /slash commands resolve. Fixed once created.": {
