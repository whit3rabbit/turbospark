        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05ea\u05de\u05d5\u05e0\u05d5\u05ea \u05d4\u05e9\u05de\u05d5\u05e8\u05d5\u05ea \u05e9\u05dc\u05da \u05d9\u05d5\u05e4\u05d9\u05e2\u05d5 \u05db\u05d0\u05df."
