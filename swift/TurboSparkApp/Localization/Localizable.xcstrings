    "Queued message. Click to edit it before it sends.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0631\u0633\u0627\u0644\u0629 \u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631. \u0627\u0646\u0642\u0631 \u0644\u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0642\u0628\u0644 \u0625\u0631\u0633\u0627\u0644\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wartende Nachricht. Klicke, um sie vor dem Senden zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued message. Click to edit it before it sends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensaje en cola. Haz clic para editarlo antes de que se env\u00ede."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Message en file d'attente. Cliquez pour le modifier avant son envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05d3\u05e2\u05d4 \u05d1\u05ea\u05d5\u05e8. \u05dc\u05d7\u05e5 \u05db\u05d3\u05d9 \u05dc\u05e2\u05e8\u05d5\u05da \u05d0\u05d5\u05ea\u05d4 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05ea\u05d9\u05e9\u05dc\u05d7."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0924\u093e\u0930 \u092e\u0947\u0902 \u0938\u0902\u0926\u0947\u0936\u0964 \u092d\u0947\u091c\u0947 \u091c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesan dalam antrean. Klik untuk mengeditnya sebelum dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messaggio in coda. Fai clic per modificarlo prima dell'invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ad\u30e5\u30fc\u306b\u5165\u3063\u305f\u30e1\u30c3\u30bb\u30fc\u30b8\u3067\u3059\u3002\u9001\u4fe1\u524d\u306b\u7de8\u96c6\u3059\u308b\u306b\u306f\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub300\uae30 \uc911\uc778 \uba54\uc2dc\uc9c0\uc785\ub2c8\ub2e4. \ubcf4\ub0b4\uae30 \uc804\uc5d0 \ud3b8\uc9d1\ud558\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bericht in de wachtrij. Klik om het te bewerken voordat het wordt verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiadomo\u015b\u0107 w kolejce. Kliknij, aby j\u0105 edytowa\u0107 przed wys\u0142aniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mensagem na fila. Clique para edit\u00e1-la antes do envio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043e\u043e\u0431\u0449\u0435\u043d\u0438\u0435 \u0432 \u043e\u0447\u0435\u0440\u0435\u0434\u0438. \u041d\u0430\u0436\u043c\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0435\u0433\u043e \u0434\u043e \u043e\u0442\u043f\u0440\u0430\u0432\u043a\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "K\u00f6at meddelande. Klicka f\u00f6r att redigera det innan det skickas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0131radaki mesaj. G\u00f6nderilmeden \u00f6nce d\u00fczenlemek i\u00e7in t\u0131klay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u0432\u0456\u0434\u043e\u043c\u043b\u0435\u043d\u043d\u044f \u0432 \u0447\u0435\u0440\u0437\u0456. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0439\u043e\u0433\u043e \u0434\u043e \u043d\u0430\u0434\u0441\u0438\u043b\u0430\u043d\u043d\u044f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tin nh\u1eafn \u0111ang ch\u1edd. Nh\u1ea5p \u0111\u1ec3 s\u1eeda tr\u01b0\u1edbc khi g\u1eedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6392\u961f\u7684\u6d88\u606f\u3002\u70b9\u6309\u5373\u53ef\u5728\u53d1\u9001\u524d\u7f16\u8f91\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6392\u5165\u4f47\u5217\u7684\u8a0a\u606f\u3002\u6309\u4e00\u4e0b\u5373\u53ef\u5728\u50b3\u9001\u524d\u7de8\u8f2f\u3002"
          }
        }
      }
    },
    "Queued: sends after the current turn. Click to edit it now.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0641\u064a \u0642\u0627\u0626\u0645\u0629 \u0627\u0644\u0627\u0646\u062a\u0638\u0627\u0631: \u062a\u064f\u0631\u0633\u0644 \u0628\u0639\u062f \u0627\u0644\u062f\u0648\u0631 \u0627\u0644\u062d\u0627\u0644\u064a. \u0627\u0646\u0642\u0631 \u0644\u062a\u0639\u062f\u064a\u0644\u0647\u0627 \u0627\u0644\u0622\u0646."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In der Warteschlange: wird nach der aktuellen Runde gesendet. Klicke, um sie jetzt zu bearbeiten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Queued: sends after the current turn. Click to edit it now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cola: se env\u00eda despu\u00e9s del turno actual. Haz clic para editarlo ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En file d'attente : envoy\u00e9 apr\u00e8s le tour en cours. Cliquez pour le modifier maintenant."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05ea\u05d5\u05e8: \u05ea\u05d9\u05e9\u05dc\u05d7 \u05d0\u05d7\u05e8\u05d9 \u05d4\u05ea\u05d5\u05e8 \u05d4\u05e0\u05d5\u05db\u05d7\u05d9. \u05dc\u05d7\u05e5 \u05db\u05d3\u05d9 \u05dc\u05e2\u05e8\u05d5\u05da \u05d0\u05d5\u05ea\u05d4 \u05e2\u05db\u05e9\u05d9\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u0924\u093e\u0930 \u092e\u0947\u0902: \u0935\u0930\u094d\u0924\u092e\u093e\u0928 \u091a\u0930\u0923 \u0915\u0947 \u092c\u093e\u0926 \u092d\u0947\u091c\u093e \u091c\u093e\u090f\u0917\u093e\u0964 \u0905\u092d\u0940 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094d\u0932\u093f\u0915 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam antrean: dikirim setelah giliran saat ini. Klik untuk mengeditnya sekarang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In coda: viene inviato dopo il turno corrente. Fai clic per modificarlo ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ad\u30e5\u30fc\u5f85\u3061: \u73fe\u5728\u306e\u30bf\u30fc\u30f3\u306e\u5f8c\u306b\u9001\u4fe1\u3055\u308c\u307e\u3059\u3002\u4eca\u3059\u3050\u7de8\u96c6\u3059\u308b\u306b\u306f\u30af\u30ea\u30c3\u30af\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub300\uae30 \uc911: \ud604\uc7ac \ud134\uc774 \ub05d\ub09c \ub4a4 \uc804\uc1a1\ub429\ub2c8\ub2e4. \uc9c0\uae08 \ud3b8\uc9d1\ud558\ub824\uba74 \ud074\ub9ad\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In de wachtrij: wordt na de huidige beurt verzonden. Klik om het nu te bewerken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W kolejce: zostanie wys\u0142ana po bie\u017c\u0105cej turze. Kliknij, aby edytowa\u0107 teraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Na fila: ser\u00e1 enviada ap\u00f3s o turno atual. Clique para editar agora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412 \u043e\u0447\u0435\u0440\u0435\u0434\u0438: \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u0441\u044f \u043f\u043e\u0441\u043b\u0435 \u0442\u0435\u043a\u0443\u0449\u0435\u0433\u043e \u0445\u043e\u0434\u0430. \u041d\u0430\u0436\u043c\u0438\u0442\u0435, \u0447\u0442\u043e\u0431\u044b \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0441\u0435\u0439\u0447\u0430\u0441."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "I k\u00f6: skickas efter den aktuella turen. Klicka f\u00f6r att redigera nu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "S\u0131rada: mevcut turdan sonra g\u00f6nderilir. \u015eimdi d\u00fczenlemek i\u00e7in t\u0131klay\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u0447\u0435\u0440\u0437\u0456: \u043d\u0430\u0434\u0456\u0448\u043b\u0435\u0442\u044c\u0441\u044f \u043f\u0456\u0441\u043b\u044f \u043f\u043e\u0442\u043e\u0447\u043d\u043e\u0433\u043e \u0445\u043e\u0434\u0443. \u041d\u0430\u0442\u0438\u0441\u043d\u0456\u0442\u044c, \u0449\u043e\u0431 \u0437\u043c\u0456\u043d\u0438\u0442\u0438 \u0437\u0430\u0440\u0430\u0437."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110ang ch\u1edd: s\u1ebd g\u1eedi sau l\u01b0\u1ee3t hi\u1ec7n t\u1ea1i. Nh\u1ea5p \u0111\u1ec3 s\u1eeda ngay."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6392\u961f\uff1a\u5c06\u5728\u5f53\u524d\u8f6e\u6b21\u540e\u53d1\u9001\u3002\u70b9\u6309\u5373\u53ef\u7acb\u5373\u7f16\u8f91\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5df2\u6392\u5165\u4f47\u5217\uff1a\u5c07\u5728\u76ee\u524d\u8f2a\u6b21\u5f8c\u50b3\u9001\u3002\u6309\u4e00\u4e0b\u5373\u53ef\u7acb\u5373\u7de8\u8f2f\u3002"
          }
        }
      }
    },
