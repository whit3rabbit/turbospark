    "For code tasks, provide signatures, expected inputs/outputs, or small working scaffolds.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في مهام البرمجة، قدّم التواقيع أو المدخلات والمخرجات المتوقعة أو هياكل صغيرة عاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib bei Code-Aufgaben Signaturen, erwartete Ein- und Ausgaben oder kleine lauffähige Gerüste an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For code tasks, provide signatures, expected inputs/outputs, or small working scaffolds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para tareas de código, proporciona firmas, entradas y salidas esperadas o pequeños esqueletos funcionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour le code, fournissez des signatures, les entrées et sorties attendues ou de petits squelettes fonctionnels."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "במשימות קוד, ספק חתימות, קלטים ופלטים צפויים או שלדים קטנים שעובדים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोड कार्यों के लिए सिग्नेचर, अपेक्षित इनपुट/आउटपुट या छोटे चलने वाले ढाँचे दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk tugas kode, berikan signature, input/output yang diharapkan, atau kerangka kecil yang berfungsi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per il codice, fornisci firme, input e output attesi o piccoli scheletri funzionanti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コードのタスクでは、シグネチャ、期待する入出力、または小さな動作する雛形を示します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "코드 작업에는 시그니처, 예상 입력/출력 또는 작게 동작하는 뼈대를 제공하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef bij codetaken signaturen, verwachte in- en uitvoer of kleine werkende opzetjes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W zadaniach programistycznych podaj sygnatury, oczekiwane wejścia i wyjścia lub małe działające szkielety."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Em tarefas de código, forneça assinaturas, entradas e saídas esperadas ou pequenos esqueletos funcionais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для задач с кодом приведите сигнатуры, ожидаемые входные и выходные данные или небольшие рабочие заготовки."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ange signaturer, förväntade in- och utdata eller små fungerande skelett för koduppgifter."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod görevlerinde imzaları, beklenen girdi ve çıktıları veya küçük çalışan iskeletleri verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для завдань із кодом наведіть сигнатури, очікувані вхідні й вихідні дані або невеликі робочі заготовки."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Với tác vụ lập trình, hãy cung cấp chữ ký hàm, đầu vào/đầu ra mong đợi hoặc khung mã nhỏ chạy được."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "对于代码任务，请提供函数签名、预期的输入输出或可运行的小型脚手架。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "對於程式碼任務，請提供函式簽章、預期的輸入輸出或可執行的小型骨架。"
          }
        }
      }
    },
    "For tools that only speak Ollama. Streams NDJSON, not SSE.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "للأدوات التي لا تتعامل إلا مع Ollama. تبث NDJSON وليس SSE."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Werkzeuge, die nur Ollama sprechen. Streamt NDJSON, nicht SSE."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For tools that only speak Ollama. Streams NDJSON, not SSE."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para herramientas que solo hablan Ollama. Transmite NDJSON, no SSE."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les outils qui ne parlent qu'Ollama. Diffuse du NDJSON, pas du SSE."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכלים שמדברים רק Ollama. משדר NDJSON ולא SSE."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन टूल के लिए जो केवल Ollama समझते हैं। SSE नहीं, NDJSON स्ट्रीम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Untuk alat yang hanya mendukung Ollama. Streaming NDJSON, bukan SSE."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per gli strumenti che parlano solo Ollama. Trasmette NDJSON, non SSE."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama のみに対応するツール向け。SSE ではなく NDJSON でストリーミングします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ollama만 지원하는 도구용. SSE가 아닌 NDJSON으로 스트리밍합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor tools die alleen Ollama spreken. Streamt NDJSON, geen SSE."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla narzędzi obsługujących tylko Ollama. Strumieniuje NDJSON, nie SSE."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para ferramentas que só falam Ollama. Transmite NDJSON, não SSE."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для инструментов, которые понимают только Ollama. Передаёт NDJSON, а не SSE."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För verktyg som bara talar Ollama. Strömmar NDJSON, inte SSE."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca Ollama konuşan araçlar için. SSE değil, NDJSON akışı yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для інструментів, що розуміють лише Ollama. Передає NDJSON, а не SSE."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cho công cụ chỉ hỗ trợ Ollama. Truyền NDJSON, không phải SSE."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "适用于只支持 Ollama 的工具。流式返回 NDJSON，而非 SSE。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "適用於只支援 Ollama 的工具。串流傳回 NDJSON，而非 SSE。"
          }
        }
      }
    },
