            "value": "\u0623\u062e\u0630 \u0627\u0644\u0639\u064a\u0646\u0627\u062a \u0644\u0647\u0630\u0647 \u0627\u0644\u0645\u062d\u0627\u062f\u062b\u0629"
          }
        },
