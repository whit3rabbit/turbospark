    "Change the cursor to a pointer when hovering over interactive elements": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0645\u0624\u0634\u0631 \u0625\u0644\u0649 \u064a\u062f \u0639\u0646\u062f \u0627\u0644\u062a\u0645\u0631\u064a\u0631 \u0641\u0648\u0642 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u064a\u0629"
