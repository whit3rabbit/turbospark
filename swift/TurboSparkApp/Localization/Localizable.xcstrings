        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05e9\u05ea\u05e7\u05d1\u05dc \u05d2\u05d9\u05e9\u05ea macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \u090f\u0915\u094d\u0938\u0947\u0938 \u0926\u0947\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih folder untuk diberi akses macOS."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli una cartella a cui concedere l'accesso di macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS\u306e\u30a2\u30af\u30bb\u30b9\u3092\u8a31\u53ef\u3059\u308b\u30d5\u30a9\u30eb\u30c0\u3092\u9078\u629e\u3057\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS \uc811\uadfc \uad8c\ud55c\uc744 \ubd80\uc5ec\ud560 \ud3f4\ub354\ub97c \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een map waaraan macOS-toegang wordt verleend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz folder, kt\u00f3remu macOS ma przyzna\u0107 dost\u0119p."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha uma pasta para conceder acesso do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043f\u0430\u043f\u043a\u0443, \u043a \u043a\u043e\u0442\u043e\u0440\u043e\u0439 macOS \u043f\u0440\u0435\u0434\u043e\u0441\u0442\u0430\u0432\u0438\u0442 \u0434\u043e\u0441\u0442\u0443\u043f."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "V\u00e4lj en mapp att ge macOS-\u00e5tkomst till."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS eri\u015fimi verilecek bir klas\u00f6r se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043f\u0430\u043f\u043a\u0443, \u0434\u043e \u044f\u043a\u043e\u0457 macOS \u043d\u0430\u0434\u0430\u0441\u0442\u044c \u0434\u043e\u0441\u0442\u0443\u043f."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn m\u1ed9t th\u01b0 m\u1ee5c \u0111\u1ec3 c\u1ea5p quy\u1ec1n truy c\u1eadp macOS."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u8981\u6388\u4e88 macOS \u8bbf\u95ee\u6743\u9650\u7684\u6587\u4ef6\u5939\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u8981\u6388\u4e88 macOS \u53d6\u7528\u6b0a\u9650\u7684\u6a94\u6848\u593e\u3002"
          }
        }
      }
    },
