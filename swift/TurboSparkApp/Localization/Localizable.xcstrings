    "The rewrite looks like a different language than the original.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0628\u062f\u0648 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0628\u0644\u063a\u0629 \u0645\u062e\u062a\u0644\u0641\u0629 \u0639\u0646 \u0627\u0644\u0646\u0635 \u0627\u0644\u0623\u0635\u0644\u064a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Umschreibung wirkt wie eine andere Sprache als das Original."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The rewrite looks like a different language than the original."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La reescritura parece estar en un idioma distinto al original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La r\u00e9\u00e9criture semble \u00eatre dans une autre langue que l'original."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e0\u05e8\u05d0\u05d4 \u05e9\u05d4\u05d2\u05e8\u05e1\u05d4 \u05d4\u05de\u05d7\u05d5\u05d3\u05e9\u05ea \u05d1\u05e9\u05e4\u05d4 \u05d0\u05d7\u05e8\u05ea \u05de\u05d4\u05de\u05e7\u05d5\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0926\u094b\u092c\u093e\u0930\u093e \u0932\u093f\u0916\u093e \u0917\u092f\u093e \u092a\u093e\u0920 \u092e\u0942\u0932 \u092a\u093e\u0920 \u0938\u0947 \u0905\u0932\u0917 \u092d\u093e\u0937\u093e \u092e\u0947\u0902 \u0932\u0917\u0924\u093e \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil tulis ulang tampak dalam bahasa yang berbeda dari teks asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La riscrittura sembra in una lingua diversa dall'originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u66f8\u304d\u76f4\u3057\u306e\u8a00\u8a9e\u304c\u5143\u306e\u6587\u7ae0\u3068\u7570\u306a\u308b\u3088\u3046\u3067\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\uc2dc \uc4f4 \uae00\uc774 \uc6d0\ubb38\uacfc \ub2e4\ub978 \uc5b8\uc5b4\ub85c \ubcf4\uc785\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De herschrijving lijkt in een andere taal dan het origineel."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisany tekst wydaje si\u0119 by\u0107 w innym j\u0119zyku ni\u017c orygina\u0142."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A reescrita parece estar em um idioma diferente do original."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0439 \u0442\u0435\u043a\u0441\u0442, \u043f\u043e\u0445\u043e\u0436\u0435, \u043d\u0430 \u0434\u0440\u0443\u0433\u043e\u043c \u044f\u0437\u044b\u043a\u0435, \u0447\u0435\u043c \u043e\u0440\u0438\u0433\u0438\u043d\u0430\u043b."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Omskrivningen verkar vara p\u00e5 ett annat spr\u00e5k \u00e4n originalet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden yaz\u0131m, orijinalden farkl\u0131 bir dilde g\u00f6r\u00fcn\u00fcyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043f\u0438\u0441\u0430\u043d\u0438\u0439 \u0442\u0435\u043a\u0441\u0442, \u0441\u0445\u043e\u0436\u0435, \u0456\u043d\u0448\u043e\u044e \u043c\u043e\u0432\u043e\u044e, \u043d\u0456\u0436 \u043e\u0440\u0438\u0433\u0456\u043d\u0430\u043b."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u1ea3n vi\u1ebft l\u1ea1i c\u00f3 v\u1ebb d\u00f9ng ng\u00f4n ng\u1eef kh\u00e1c v\u1edbi b\u1ea3n g\u1ed1c."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6539\u5199\u7ed3\u679c\u7684\u8bed\u8a00\u4f3c\u4e4e\u4e0e\u539f\u6587\u4e0d\u540c\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6539\u5beb\u7d50\u679c\u7684\u8a9e\u8a00\u4f3c\u4e4e\u8207\u539f\u6587\u4e0d\u540c\u3002"
          }
        }
      }
    },
    "The rewrite copies long phrases from the original.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u0646\u0633\u062e \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0643\u062a\u0627\u0628\u0629 \u0639\u0628\u0627\u0631\u0627\u062a \u0637\u0648\u064a\u0644\u0629 \u0645\u0646 \u0627\u0644\u0646\u0635 \u0627\u0644\u0623\u0635\u0644\u064a."
