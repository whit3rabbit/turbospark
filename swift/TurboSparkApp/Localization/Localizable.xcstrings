    "Record a meeting, add markers, and keep the original audio.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Record a meeting, add markers, and keep the original audio."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Graba una reuni\u00f3n, a\u00f1ade marcadores y conserva el audio original."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez une r\u00e9union, ajoutez des rep\u00e8res et conservez l'audio original."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm ein Meeting auf, f\u00fcge Markierungen hinzu und behalte das Originalaudio."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una riunione, aggiungi marcatori e conserva l'audio originale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Grave uma reuni\u00e3o, adicione marcadores e mantenha o \u00e1udio original."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neem een vergadering op, voeg markeringen toe en behoud de oorspronkelijke audio."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Spela in ett m\u00f6te, l\u00e4gg till mark\u00f6rer och beh\u00e5ll originalljudet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagraj spotkanie, dodaj znaczniki i zachowaj oryginalny d\u017awi\u0119k."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir toplant\u0131y\u0131 kaydedin, i\u015faretler ekleyin ve orijinal sesi koruyun."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekam rapat, tambahkan penanda, dan simpan audio aslinya."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0448\u0438\u0442\u0435 \u0432\u0441\u0442\u0440\u0435\u0447\u0443, \u0434\u043e\u0431\u0430\u0432\u044c\u0442\u0435 \u043c\u0435\u0442\u043a\u0438 \u0438 \u0441\u043e\u0445\u0440\u0430\u043d\u0438\u0442\u0435 \u0438\u0441\u0445\u043e\u0434\u043d\u043e\u0435 \u0430\u0443\u0434\u0438\u043e."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0437\u0443\u0441\u0442\u0440\u0456\u0447, \u0434\u043e\u0434\u0430\u0439\u0442\u0435 \u043c\u0456\u0442\u043a\u0438 \u0442\u0430 \u0437\u0431\u0435\u0440\u0435\u0436\u0456\u0442\u044c \u043f\u043e\u0447\u0430\u0442\u043a\u043e\u0432\u0435 \u0430\u0443\u0434\u0456\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi l\u1ea1i cu\u1ed9c h\u1ecdp, th\u00eam d\u1ea5u m\u1ed1c v\u00e0 gi\u1eef \u00e2m thanh g\u1ed1c."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4f1a\u8b70\u3092\u9332\u97f3\u3057\u3001\u30de\u30fc\u30ab\u30fc\u3092\u8ffd\u52a0\u3057\u3066\u3001\u5143\u306e\u97f3\u58f0\u3092\u4fdd\u5b58\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ud68c\uc758\ub97c \ub179\uc74c\ud558\uace0 \ub9c8\ucee4\ub97c \ucd94\uac00\ud558\uba70 \uc6d0\ubcf8 \uc624\ub514\uc624\ub97c \ubcf4\uad00\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5f55\u5236\u4f1a\u8bae\u3001\u6dfb\u52a0\u6807\u8bb0\u5e76\u4fdd\u7559\u539f\u59cb\u97f3\u9891\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9304\u88fd\u6703\u8b70\u3001\u65b0\u589e\u6a19\u8a18\u4e26\u4fdd\u7559\u539f\u59cb\u97f3\u8a0a\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0633\u062c\u0651\u0644 \u0627\u062c\u062a\u0645\u0627\u0639\u0627\u064b \u0648\u0623\u0636\u0641 \u0639\u0644\u0627\u0645\u0627\u062a \u0648\u0627\u062d\u062a\u0641\u0638 \u0628\u0627\u0644\u0635\u0648\u062a \u0627\u0644\u0623\u0635\u0644\u064a."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e7\u05dc\u05d8 \u05e4\u05d2\u05d9\u05e9\u05d4, \u05d4\u05d5\u05e1\u05e3 \u05e1\u05de\u05e0\u05d9\u05dd \u05d5\u05e9\u05de\u05d5\u05e8 \u05d0\u05ea \u05d4\u05e9\u05de\u05e2 \u05d4\u05de\u05e7\u05d5\u05e8\u05d9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u0940\u091f\u093f\u0902\u0917 \u0930\u093f\u0915\u0949\u0930\u094d\u0921 \u0915\u0930\u0947\u0902, \u092e\u093e\u0930\u094d\u0915\u0930 \u091c\u094b\u0921\u093c\u0947\u0902 \u0914\u0930 \u092e\u0942\u0932 \u0911\u0921\u093f\u092f\u094b \u0930\u0916\u0947\u0902\u0964"
          }
        }
      }
    },
