    "No importable content found in other agent locations.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u0639\u062b\u0631 \u0639\u0644\u0649 \u0645\u062d\u062a\u0648\u0649 \u0642\u0627\u0628\u0644 \u0644\u0644\u0627\u0633\u062a\u064a\u0631\u0627\u062f \u0641\u064a \u0645\u0648\u0627\u0642\u0639 \u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0648\u0643\u0644\u0627\u0621 \u0627\u0644\u0623\u062e\u0631\u0649."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine importierbaren Inhalte an anderen Agent-Speicherorten gefunden."
          }
        },
        "en": {
          "stringUnit": {
