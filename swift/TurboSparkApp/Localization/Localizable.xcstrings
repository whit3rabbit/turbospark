        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inget att sammanfatta \u00e4n."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hen\u00fcz \u00f6zetlenecek bir \u015fey yok."
