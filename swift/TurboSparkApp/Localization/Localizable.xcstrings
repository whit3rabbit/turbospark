    "Explore supported audio operations and inspect model details.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore supported audio operations and inspect model details."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Explora las operaciones de audio compatibles y consulta los detalles del modelo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Explorez les op\u00e9rations audio prises en charge et consultez les d\u00e9tails du mod\u00e8le."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erkunde unterst\u00fctzte Audiofunktionen und pr\u00fcfe die Modelldetails."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esplora le operazioni audio supportate e consulta i dettagli del modello."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Explore as opera\u00e7\u00f5es de \u00e1udio compat\u00edveis e consulte os detalhes do modelo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verken ondersteunde audiobewerkingen en bekijk modeldetails."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utforska ljud\u00e5tg\u00e4rder som st\u00f6ds och granska modellinformation."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznaj obs\u0142ugiwane operacje audio i sprawd\u017a szczeg\u00f3\u0142y modelu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Desteklenen ses i\u015flemlerini ke\u015ffedin ve model ayr\u0131nt\u0131lar\u0131n\u0131 inceleyin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelajahi operasi audio yang didukung dan periksa detail model."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0437\u0443\u0447\u0438\u0442\u0435 \u043f\u043e\u0434\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0435\u043c\u044b\u0435 \u0430\u0443\u0434\u0438\u043e\u043e\u043f\u0435\u0440\u0430\u0446\u0438\u0438 \u0438 \u0441\u0432\u0435\u0434\u0435\u043d\u0438\u044f \u043e \u043c\u043e\u0434\u0435\u043b\u0438."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0414\u043e\u0441\u043b\u0456\u0434\u0436\u0443\u0439\u0442\u0435 \u043f\u0456\u0434\u0442\u0440\u0438\u043c\u0443\u0432\u0430\u043d\u0456 \u0430\u0443\u0434\u0456\u043e\u043e\u043f\u0435\u0440\u0430\u0446\u0456\u0457 \u0442\u0430 \u0432\u0456\u0434\u043e\u043c\u043e\u0441\u0442\u0456 \u043f\u0440\u043e \u043c\u043e\u0434\u0435\u043b\u044c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00e1m ph\u00e1 c\u00e1c thao t\u00e1c \u00e2m thanh \u0111\u01b0\u1ee3c h\u1ed7 tr\u1ee3 v\u00e0 xem chi ti\u1ebft m\u00f4 h\u00ecnh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bfe\u5fdc\u3059\u308b\u97f3\u58f0\u51e6\u7406\u3092\u8a66\u3057\u3001\u30e2\u30c7\u30eb\u306e\u8a73\u7d30\u3092\u78ba\u8a8d\u3067\u304d\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc9c0\uc6d0\ub418\ub294 \uc624\ub514\uc624 \uc791\uc5c5\uc744 \uc0b4\ud3b4\ubcf4\uace0 \ubaa8\ub378 \uc138\ubd80 \uc815\ubcf4\ub97c \ud655\uc778\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a2\u7d22\u652f\u6301\u7684\u97f3\u9891\u64cd\u4f5c\u5e76\u67e5\u770b\u6a21\u578b\u8be6\u60c5\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u63a2\u7d22\u652f\u63f4\u7684\u97f3\u8a0a\u64cd\u4f5c\u4e26\u67e5\u770b\u6a21\u578b\u8a73\u7d30\u8cc7\u8a0a\u3002"
          }
        },
        "ar": {
          "stringUnit": {
