    "Are you sure you want to delete this personality? This action cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you sure you want to delete this personality? This action cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Estás seguro de que deseas eliminar esta personalidad? Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous vraiment supprimer cette personnalité ? Cette action ne peut pas être annulée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Möchten Sie diese Persönlichkeit wirklich löschen? Diese Aktion kann nicht rückgängig gemacht werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei sicuro di voler eliminare questa personalità? Questa azione non può essere annullata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tem certeza de que deseja excluir esta personalidade? Esta ação não pode ser desfeita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weet u zeker dat u deze persoonlijkheid wilt verwijderen? Deze actie kan niet ongedaan worden gemaakt."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Är du säker på att du vill ta bort den här personligheten? Den här åtgärden kan inte ångras."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy na pewno chcesz usunąć tę osobowość? Tej operacji nie można cofnąć."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы действительно хотите удалить эту индивидуальность? Это действие нельзя отменить."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви дійсно бажаєте видалити цю особистість? Цю дію не можна скасувати."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kişiliği silmek istediğinizden emin misiniz? Bu işlem geri alınamaz."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل أنت متأكد من أنك تريد حذف هذه الشخصية؟ لا يمكن التراجع عن هذا الإجراء."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האם אתה בטוח שברצונך למחוק אישיות זו? לא ניתן לבטל פעולה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या आप वाकई इस व्यक्तित्व को हटाना चाहते हैं? यह क्रिया पूर्ववत नहीं की जा सकती।"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确定要删除此人设吗？此操作无法撤消。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "確定要刪除此人設嗎？此操作無法復原。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この個性を削除してもよろしいですか？この操作は取り消せません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 성격을 삭제하시겠습니까? 이 작업은 취소할 수 없습니다."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có chắc chắn muốn xóa tính cách này không? Thao tác này không thể hoàn tác."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apakah Anda yakin ingin menghapus kepribadian ini? Tindakan ini tidak dapat dibatalkan."
          }
        }
      }
    },
