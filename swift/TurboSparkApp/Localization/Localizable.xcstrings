    "Import servers from Claude, Codex, Cursor, or Gemini global configs; they are added disabled": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استيراد الخوادم من الإعدادات العامة لـ Claude أو Codex أو Cursor أو Gemini؛ تُضاف معطّلة"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Server aus den globalen Konfigurationen von Claude, Codex, Cursor oder Gemini importieren; sie werden deaktiviert hinzugefügt"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Import servers from Claude, Codex, Cursor, or Gemini global configs; they are added disabled"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa servidores de las configuraciones globales de Claude, Codex, Cursor o Gemini; se agregan desactivados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Importer des serveurs depuis les configurations globales de Claude, Codex, Cursor ou Gemini ; ils sont ajoutés désactivés"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ייבוא שרתים מתצורות גלובליות של Claude, Codex, Cursor או Gemini; הם נוספים כשהם מושבתים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Codex, Cursor या Gemini के ग्लोबल कॉन्फ़िग से सर्वर आयात करें; वे अक्षम रूप में जोड़े जाते हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Impor server dari konfigurasi global Claude, Codex, Cursor, atau Gemini; server ditambahkan dalam keadaan nonaktif"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa server dalle configurazioni globali di Claude, Codex, Cursor o Gemini; vengono aggiunti disattivati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude、Codex、Cursor、Gemini のグローバル設定からサーバーを読み込みます。無効の状態で追加されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Claude, Codex, Cursor, Gemini의 전역 설정에서 서버를 가져옵니다. 비활성화된 상태로 추가됩니다"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Servers importeren uit de globale configuraties van Claude, Codex, Cursor of Gemini; ze worden uitgeschakeld toegevoegd"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj serwery z globalnych konfiguracji Claude, Codex, Cursor lub Gemini; są dodawane jako wyłączone"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa servidores das configurações globais do Claude, Codex, Cursor ou Gemini; eles são adicionados desativados"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Импорт серверов из глобальных конфигураций Claude, Codex, Cursor или Gemini; они добавляются отключёнными"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera servrar från de globala konfigurationerna för Claude, Codex, Cursor eller Gemini; de läggs till inaktiverade"
