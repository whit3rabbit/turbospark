          "stringUnit": {
            "state": "translated",
            "value": "Añade aquí una carpeta para resolver de antemano el aviso de acceso de macOS."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier ici pour lever à l'avance la demande d'accès de macOS."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie hier einen Ordner hinzu, um die macOS-Zugriffsabfrage vorab zu erledigen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi qui una cartella per risolvere in anticipo la richiesta di accesso di macOS."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione uma pasta aqui para resolver antecipadamente o aviso de acesso do macOS."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте сюда папку, чтобы заранее снять запрос доступа macOS."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここにフォルダを追加すると、macOS のアクセス許可ダイアログを事前に解消できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기에 폴더를 추가하면 macOS 접근 권한 요청을 미리 처리할 수 있습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在此添加文件夹，可提前处理 macOS 的访问授权提示。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在此新增資料夾，可預先處理 macOS 的存取授權提示。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف مجلدا هنا لتجاوز طلب الوصول في macOS مسبقا."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף כאן תיקייה כדי לטפל מראש בבקשת הגישה של macOS."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहां फ़ोल्डर जोड़ें ताकि macOS की एक्सेस अनुमति पहले ही निपट जाए।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg hier een map toe om de macOS-toegangsvraag vooraf af te handelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj tutaj folder, aby z góry obsłużyć monit o dostęp w macOS."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "macOS erişim istemini önceden gidermek için buraya bir klasör ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте сюди папку, щоб заздалегідь зняти запит доступу macOS."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till en mapp här för att i förväg hantera macOS åtkomstfråga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm thư mục tại đây để xử lý trước lời nhắc cấp quyền của macOS."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan folder di sini untuk menyelesaikan permintaan akses macOS lebih awal."
          }
        }
      }
    },
    "Add external MCP servers (like memory, GitHub, filesystem, database, or browser tools) to extend assistant capabilities.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add external MCP servers (like memory, GitHub, filesystem, database, or browser tools) to extend assistant capabilities."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade servidores MCP externos (como memoria, GitHub, sistema de archivos, base de datos o herramientas de navegador) para ampliar las capacidades del asistente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez des serveurs MCP externes (mémoire, GitHub, système de fichiers, base de données ou outils de navigateur) pour étendre les capacités de l'assistant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügen Sie externe MCP-Server hinzu (etwa Speicher, GitHub, Dateisystem, Datenbank oder Browser-Tools), um die Fähigkeiten des Assistenten zu erweitern."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi server MCP esterni (come memoria, GitHub, file system, database o strumenti del browser) per ampliare le capacità dell'assistente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione servidores MCP externos (como memória, GitHub, sistema de arquivos, banco de dados ou ferramentas de navegador) para ampliar os recursos do assistente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте внешние серверы MCP (память, GitHub, файловая система, база данных или браузерные инструменты), чтобы расширить возможности ассистента."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "外部 MCP サーバー (メモリ、GitHub、ファイルシステム、データベース、ブラウザツールなど) を追加して、アシスタントの機能を拡張します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "외부 MCP 서버(메모리, GitHub, 파일 시스템, 데이터베이스, 브라우저 도구 등)를 추가해 어시스턴트 기능을 확장합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加外部 MCP 服务器 (如内存、GitHub、文件系统、数据库或浏览器工具) 以扩展助手能力。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新增外部 MCP 伺服器 (如記憶體、GitHub、檔案系統、資料庫或瀏覽器工具) 以擴充助理能力。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف خوادم MCP خارجية (مثل الذاكرة أو GitHub أو نظام الملفات أو قاعدة البيانات أو أدوات المتصفح) لتوسيع قدرات المساعد."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הוסף שרתי MCP חיצוניים (זיכרון, GitHub, מערכת קבצים, מסד נתונים או כלי דפדפן) כדי להרחיב את יכולות העוזר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "असिस्टेंट की क्षमताएं बढ़ाने के लिए बाहरी MCP सर्वर (जैसे मेमोरी, GitHub, फ़ाइल सिस्टम, डेटाबेस या ब्राउज़र टूल) जोड़ें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg externe MCP-servers toe (zoals geheugen, GitHub, bestandssysteem, database of browsertools) om de mogelijkheden van de assistent uit te breiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj zewnętrzne serwery MCP (np. pamięć, GitHub, system plików, bazę danych lub narzędzia przeglądarki), aby rozszerzyć możliwości asystenta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Asistanın yeteneklerini genişletmek için harici MCP sunucuları (bellek, GitHub, dosya sistemi, veritabanı veya tarayıcı araçları gibi) ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте зовнішні сервери MCP (пам'ять, GitHub, файлова система, база даних або браузерні інструменти), щоб розширити можливості асистента."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Lägg till externa MCP-servrar (som minne, GitHub, filsystem, databas eller webbläsarverktyg) för att utöka assistentens förmåga."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm máy chủ MCP bên ngoài (như bộ nhớ, GitHub, hệ thống tệp, cơ sở dữ liệu hoặc công cụ trình duyệt) để mở rộng khả năng của trợ lý."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan server MCP eksternal (seperti memori, GitHub, sistem berkas, basis data, atau alat peramban) untuk memperluas kemampuan asisten."
          }
        }
      }
    },
