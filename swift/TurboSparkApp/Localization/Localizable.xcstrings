          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05d4\u05e0\u05d7\u05d9\u05d4, \u05e2\u05e8\u05d5\u05da \u05d0\u05d5\u05ea\u05d4, \u05d0\u05d5 \u05db\u05ea\u05d5\u05d1 \u05de\u05e9\u05dc\u05da."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0915\u094b\u0908 \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u091a\u0941\u0928\u0947\u0902, \u0909\u0938\u0947 \u0938\u0902\u092a\u093e\u0926\u093f\u0924 \u0915\u0930\u0947\u0902, \u092f\u093e \u0905\u092a\u0928\u093e \u0932\u093f\u0916\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
