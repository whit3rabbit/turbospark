        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05ea\u05e6\u05d5\u05d2\u05ea \u05de\u05d3\u05d3\u05d9\u05dd: \u05d2\u05e8\u05e4\u05d9\u05dd \u05d7\u05d9\u05d9\u05dd (\u05dc\u05d7\u05e5 \u05db\u05d3\u05d9 \u05dc\u05e2\u05d1\u05d5\u05e8 \u05dc\u05de\u05e1\u05e4\u05e8\u05d9\u05dd)"
