        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9ad8\u30ea\u30b9\u30af\u306a\u64cd\u4f5c\u304c\u691c\u51fa\u3055\u308c\u307e\u3057\u305f"
