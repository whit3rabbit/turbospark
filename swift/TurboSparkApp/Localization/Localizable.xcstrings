    "Automatically enabled for LLMs that support tool calling. Can be toggled per project or underneath the prompt composer.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفعَّل تلقائيًا للنماذج اللغوية التي تدعم استدعاء الأدوات. يمكن تبديله لكل مشروع أو أسفل محرر الطلب."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird für LLMs mit Tool-Aufrufen automatisch aktiviert. Lässt sich pro Projekt oder unter dem Prompt-Editor umschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically enabled for LLMs that support tool calling. Can be toggled per project or underneath the prompt composer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se activa automáticamente en los LLM compatibles con llamadas a herramientas. Se puede cambiar por proyecto o debajo del editor de prompts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé automatiquement pour les LLM qui prennent en charge l'appel d'outils. Modifiable par projet ou sous l'éditeur de prompt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מופעל אוטומטית עבור מודלי שפה שתומכים בקריאה לכלים. ניתן להחליף לכל פרויקט או מתחת לעורך ההנחיה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टूल कॉलिंग का समर्थन करने वाले LLM के लिए अपने आप चालू होता है। इसे हर प्रोजेक्ट के लिए या प्रॉम्प्ट कंपोज़र के नीचे बदला जा सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Otomatis aktif untuk LLM yang mendukung pemanggilan alat. Dapat diubah per proyek atau di bawah penyusun prompt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivato automaticamente per gli LLM che supportano la chiamata di strumenti. Si può attivare o disattivare per progetto o sotto l'editor del prompt."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ツール呼び出しに対応した LLM では自動的に有効になります。プロジェクトごと、またはプロンプト入力欄の下で切り替えられます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "도구 호출을 지원하는 LLM에서는 자동으로 켜집니다. 프로젝트별로 또는 프롬프트 입력란 아래에서 전환할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt automatisch ingeschakeld voor LLM's die toolaanroepen ondersteunen. Per project of onder de prompteditor te wisselen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączane automatycznie dla modeli LLM obsługujących wywoływanie narzędzi. Można przełączać dla projektu lub pod edytorem promptu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ativado automaticamente para LLMs que oferecem suporte a chamadas de ferramentas. Pode ser alternado por projeto ou abaixo do editor de prompt."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включается автоматически для LLM с поддержкой вызова инструментов. Можно переключать для каждого проекта или под полем ввода запроса."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiveras automatiskt för LLM:er som stöder verktygsanrop. Kan växlas per projekt eller under promptredigeraren."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Araç çağırmayı destekleyen LLM'ler için otomatik olarak etkinleşir. Proje başına veya istem düzenleyicisinin altından değiştirilebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вмикається автоматично для LLM із підтримкою виклику інструментів. Можна перемикати для кожного проєкту або під полем введення запиту."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động bật cho các LLM hỗ trợ gọi công cụ. Có thể bật tắt theo từng dự án hoặc bên dưới trình soạn lời nhắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持工具调用的 LLM 会自动启用。可按项目或在提示词编辑器下方切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支援工具呼叫的 LLM 會自動啟用。可依專案或在提示編輯器下方切換。"
          }
        }
      }
    },
