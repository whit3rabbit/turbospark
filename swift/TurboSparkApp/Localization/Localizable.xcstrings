          "stringUnit": {
            "state": "translated",
            "value": "Bentornato! Su cosa stiamo lavorando?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お帰りなさい！何に取り組みましょうか？"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다시 오신 것을 환영합니다! 어떤 작업을 진행할까요?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Welkom terug! Waar werken we aan?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Witaj z powrotem! Nad czym pracujemy?"
          }
        },
