        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u52a0\u5bc6\u91d1\u9470\u5c01\u88dd\u683c\u5f0f\u932f\u8aa4\u3002"
          }
        }
      }
    },
    "The passphrase is incorrect or the encrypted key was modified.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0639\u0628\u0627\u0631\u0629 \u0627\u0644\u0645\u0631\u0648\u0631 \u063a\u064a\u0631 \u0635\u062d\u064a\u062d\u0629 \u0623\u0648 \u062a\u0645 \u062a\u0639\u062f\u064a\u0644 \u0627\u0644\u0645\u0641\u062a\u0627\u062d \u0627\u0644\u0645\u0634\u0641\u0631."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Passphrase ist falsch oder der verschl\u00fcsselte Schl\u00fcssel wurde ver\u00e4ndert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The passphrase is incorrect or the encrypted key was modified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La frase de contrase\u00f1a es incorrecta o se modific\u00f3 la clave cifrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La phrase secr\u00e8te est incorrecte ou la cl\u00e9 chiffr\u00e9e a \u00e9t\u00e9 modifi\u00e9e."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d9\u05d8\u05d5\u05d9 \u05d4\u05e1\u05d9\u05e1\u05de\u05d4 \u05e9\u05d2\u05d5\u05d9 \u05d0\u05d5 \u05e9\u05d4\u05de\u05e4\u05ea\u05d7 \u05d4\u05de\u05d5\u05e6\u05e4\u05df \u05e9\u05d5\u05e0\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092a\u093e\u0938\u092b\u093c\u094d\u0930\u0947\u091c\u093c \u0917\u0932\u0924 \u0939\u0948 \u092f\u093e \u090f\u0928\u094d\u0915\u094d\u0930\u093f\u092a\u094d\u091f\u0947\u0921 \u0915\u0941\u0902\u091c\u0940 \u092c\u0926\u0932\u0940 \u0917\u0908 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Frasa sandi salah atau kunci terenkripsi telah diubah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La passphrase non \u00e8 corretta oppure la chiave cifrata \u00e8 stata modificata."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30d1\u30b9\u30d5\u30ec\u30fc\u30ba\u304c\u6b63\u3057\u304f\u306a\u3044\u304b\u3001\u6697\u53f7\u5316\u3055\u308c\u305f\u9375\u304c\u5909\u66f4\u3055\u308c\u3066\u3044\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc554\ud638\uac00 \uc62c\ubc14\ub974\uc9c0 \uc54a\uac70\ub098 \uc554\ud638\ud654\ub41c \ud0a4\uac00 \uc218\uc815\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wachtzin is onjuist of de versleutelde sleutel is gewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Has\u0142o jest nieprawid\u0142owe lub zaszyfrowany klucz zosta\u0142 zmodyfikowany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A frase secreta est\u00e1 incorreta ou a chave criptografada foi modificada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0432\u0435\u0440\u043d\u0430\u044f \u0444\u0440\u0430\u0437\u0430-\u043f\u0430\u0440\u043e\u043b\u044c, \u0438\u043b\u0438 \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u043a\u043b\u044e\u0447 \u0431\u044b\u043b \u0438\u0437\u043c\u0435\u043d\u0435\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00f6senfrasen \u00e4r felaktig eller s\u00e5 har den krypterade nyckeln \u00e4ndrats."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Parola yanl\u0131\u015f veya \u015fifreli anahtar de\u011fi\u015ftirilmi\u015f."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u043f\u0440\u0430\u0432\u0438\u043b\u044c\u043d\u0430 \u0444\u0440\u0430\u0437\u0430-\u043f\u0430\u0440\u043e\u043b\u044c, \u0430\u0431\u043e \u0437\u0430\u0448\u0438\u0444\u0440\u043e\u0432\u0430\u043d\u0438\u0439 \u043a\u043b\u044e\u0447 \u0431\u0443\u043b\u043e \u0437\u043c\u0456\u043d\u0435\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u1ee5m m\u1eadt kh\u1ea9u kh\u00f4ng \u0111\u00fang ho\u1eb7c kh\u00f3a \u0111\u01b0\u1ee3c m\u00e3 h\u00f3a \u0111\u00e3 b\u1ecb s\u1eeda \u0111\u1ed5i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u53e3\u4ee4\u4e0d\u6b63\u786e\uff0c\u6216\u8005\u52a0\u5bc6\u5bc6\u94a5\u5df2\u88ab\u4fee\u6539\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5bc6\u8a9e\u4e0d\u6b63\u78ba\uff0c\u6216\u52a0\u5bc6\u91d1\u9470\u5df2\u88ab\u4fee\u6539\u3002"
          }
        }
      }
    },
    "Touch ID or Mac login authentication is not available.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u0645\u0635\u0627\u062f\u0642\u0629 \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 Touch ID \u0623\u0648 \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0625\u0644\u0649 Mac \u063a\u064a\u0631 \u0645\u062a\u0627\u062d\u0629."
