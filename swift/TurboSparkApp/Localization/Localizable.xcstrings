            "value": "Menyimpan semuanya dan meluncurkan ulang aplikasi sebagai profil ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva tutto e riavvia l'app con questo profilo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3059\u3079\u3066\u3092\u4fdd\u5b58\u3057\u3001\u3053\u306e\u30d7\u30ed\u30d5\u30a1\u30a4\u30eb\u3067\u30a2\u30d7\u30ea\u3092\u518d\u8d77\u52d5\u3057\u307e\u3059"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ubaa8\ub4e0 \ub0b4\uc6a9\uc744 \uc800\uc7a5\ud558\uace0 \uc774 \ud504\ub85c\ud544\ub85c \uc571\uc744 \ub2e4\uc2dc \uc2e4\ud589\ud569\ub2c8\ub2e4"
          }
