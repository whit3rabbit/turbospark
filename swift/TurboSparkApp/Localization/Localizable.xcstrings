    "The model was unloaded before this prompt could be sent.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u064f\u0644\u063a\u064a \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c \u0642\u0628\u0644 \u0623\u0646 \u064a\u062a\u0633\u0646\u0649 \u0625\u0631\u0633\u0627\u0644 \u0647\u0630\u0627 \u0627\u0644\u0645\u0648\u062c\u0651\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Modell wurde entladen, bevor dieser Prompt gesendet werden konnte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The model was unloaded before this prompt could be sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El modelo se descarg\u00f3 antes de que se pudiera enviar este prompt."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le mod\u00e8le a \u00e9t\u00e9 d\u00e9charg\u00e9 avant que ce prompt puisse \u00eatre envoy\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05de\u05d5\u05d3\u05dc \u05e0\u05e4\u05e8\u05e7 \u05dc\u05e4\u05e0\u05d9 \u05e9\u05e0\u05d9\u05ea\u05df \u05d4\u05d9\u05d4 \u05dc\u05e9\u05dc\u05d5\u05d7 \u05d0\u05ea \u05d4\u05e4\u05e8\u05d5\u05de\u05e4\u05d8 \u05d4\u05d6\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u092a\u094d\u0930\u0949\u092e\u094d\u092a\u094d\u091f \u092d\u0947\u091c\u0947 \u091c\u093e\u0928\u0947 \u0938\u0947 \u092a\u0939\u0932\u0947 \u092e\u0949\u0921\u0932 \u0905\u0928\u0932\u094b\u0921 \u0939\u094b \u0917\u092f\u093e\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model dibongkar sebelum prompt ini dapat dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modello \u00e8 stato scaricato prima che questo prompt potesse essere inviato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u30d7\u30ed\u30f3\u30d7\u30c8\u3092\u9001\u4fe1\u3059\u308b\u524d\u306b\u30e2\u30c7\u30eb\u304c\u30a2\u30f3\u30ed\u30fc\u30c9\u3055\u308c\u307e\u3057\u305f\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \ud504\ub86c\ud504\ud2b8\ub97c \ubcf4\ub0b4\uae30 \uc804\uc5d0 \ubaa8\ub378\uc774 \uc5b8\ub85c\ub4dc\ub418\uc5c8\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het model is ontladen voordat deze prompt kon worden verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Model zosta\u0142 wy\u0142adowany, zanim mo\u017cna by\u0142o wys\u0142a\u0107 ten prompt."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O modelo foi descarregado antes que este prompt pudesse ser enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c \u0431\u044b\u043b\u0430 \u0432\u044b\u0433\u0440\u0443\u0436\u0435\u043d\u0430 \u0434\u043e \u0442\u043e\u0433\u043e, \u043a\u0430\u043a \u044d\u0442\u043e\u0442 \u043f\u0440\u043e\u043c\u043f\u0442 \u0443\u0434\u0430\u043b\u043e\u0441\u044c \u043e\u0442\u043f\u0440\u0430\u0432\u0438\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Modellen laddades ur innan den h\u00e4r prompten kunde skickas."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu istem g\u00f6nderilemeden model bo\u015falt\u0131ld\u0131."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c \u0431\u0443\u043b\u043e \u0432\u0438\u0432\u0430\u043d\u0442\u0430\u0436\u0435\u043d\u043e \u0434\u043e \u0442\u043e\u0433\u043e, \u044f\u043a \u0446\u0435\u0439 \u043f\u0440\u043e\u043c\u043f\u0442 \u0432\u0434\u0430\u043b\u043e\u0441\u044f \u043d\u0430\u0434\u0456\u0441\u043b\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 h\u00ecnh \u0111\u00e3 b\u1ecb d\u1ee1 b\u1ecf tr\u01b0\u1edbc khi c\u00f3 th\u1ec3 g\u1eedi prompt n\u00e0y."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728\u53d1\u9001\u6b64\u63d0\u793a\u8bcd\u4e4b\u524d\uff0c\u6a21\u578b\u5df2\u88ab\u5378\u8f7d\u3002"
          }
