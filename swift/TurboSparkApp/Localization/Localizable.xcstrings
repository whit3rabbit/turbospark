          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Importa da altri strumenti agent\u2026"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ed6\u306e\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u30c4\u30fc\u30eb\u304b\u3089\u30a4\u30f3\u30dd\u30fc\u30c8\u2026"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub2e4\ub978 \uc5d0\uc774\uc804\ud2b8 \ub3c4\uad6c\uc5d0\uc11c \uac00\uc838\uc624\uae30\u2026"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importeren vanuit andere agent-tools\u2026"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Importuj z innych narz\u0119dzi agent\u00f3w\u2026"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Importar de outras ferramentas de agente\u2026"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u043c\u043f\u043e\u0440\u0442 \u0438\u0437 \u0434\u0440\u0443\u0433\u0438\u0445 \u0430\u0433\u0435\u043d\u0442\u0441\u043a\u0438\u0445 \u0438\u043d\u0441\u0442\u0440\u0443\u043c\u0435\u043d\u0442\u043e\u0432\u2026"
          }
        },
        "sv": {
