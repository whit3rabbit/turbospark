    "Chunked GPU prefill for long prompts without watchdog timeouts": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ملء مسبق مجزأ عبر GPU للمطالبات الطويلة دون انتهاء مهلة المراقب"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU-Prefill in Blöcken für lange Prompts ohne Watchdog-Timeouts"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chunked GPU prefill for long prompts without watchdog timeouts"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prellenado por bloques en la GPU para prompts largos sin agotar el tiempo del watchdog"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Préremplissage GPU par blocs pour les longs prompts sans délai d’attente du watchdog"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מילוי מוקדם במקטעים ב-GPU להנחיות ארוכות בלי פסקי זמן של ה-watchdog"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉचडॉग टाइमआउट के बिना लंबे प्रॉम्प्ट के लिए चंक्ड GPU प्रीफ़िल"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefill GPU bertahap untuk prompt panjang tanpa batas waktu watchdog"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefill GPU a blocchi per prompt lunghi senza timeout del watchdog"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォッチドッグのタイムアウトなしで長いプロンプトを処理するチャンク化GPUプリフィル"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "워치독 시간 초과 없이 긴 프롬프트를 처리하는 청크 GPU 프리필"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU-prefill in blokken voor lange prompts zonder watchdog-time-outs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefill GPU w porcjach dla długich promptów bez przekroczeń czasu watchdoga"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefill na GPU em blocos para prompts longos sem tempo limite do watchdog"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предзаполнение на GPU блоками для длинных промптов без тайм-аутов сторожевого таймера"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "GPU-prefill i block för långa prompter utan watchdog-tidsgränser"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Watchdog zaman aşımı olmadan uzun istemler için parçalı GPU ön doldurma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попереднє заповнення на GPU блоками для довгих промптів без тайм-аутів сторожового таймера"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Prefill GPU theo khối cho prompt dài mà không bị watchdog hết thời gian"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分块 GPU 预填充，长提示词也不会触发看门狗超时"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分塊 GPU 預填充，長提示詞也不會觸發看門狗逾時"
          }
        }
      }
    },
