            "value": "لم يعد '%@' في قائمة النماذج."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ist nicht mehr in der Modellliste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is no longer in the model list."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ya no está en la lista de modelos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ne figure plus dans la liste des modèles."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' כבר אינו ברשימת המודלים."
          }
        },
        "hi": {
          "stringUnit": {
