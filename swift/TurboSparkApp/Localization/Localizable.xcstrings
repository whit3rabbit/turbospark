          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0438\u0439 \u0437\u0430\u043f\u0438\u0441 \u0430\u0431\u043e \u0456\u043c\u043f\u043e\u0440\u0442\u0443\u0439\u0442\u0435 \u0430\u0443\u0434\u0456\u043e, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u1ecdn b\u1ea3n ghi \u0111\u00e3 l\u01b0u ho\u1eb7c nh\u1eadp \u00e2m thanh \u0111\u1ec3 b\u1eaft \u0111\u1ea7u."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4fdd\u5b58\u3057\u305f\u9332\u97f3\u3092\u9078\u629e\u3059\u308b\u304b\u3001\u97f3\u58f0\u3092\u8aad\u307f\u8fbc\u3093\u3067\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc800\uc7a5\ub41c \ub179\uc74c\uc744 \uc120\ud0dd\ud558\uac70\ub098 \uc624\ub514\uc624\ub97c \uac00\uc838\uc640 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9009\u62e9\u5df2\u4fdd\u5b58\u7684\u5f55\u97f3\u6216\u5bfc\u5165\u97f3\u9891\u4ee5\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u9078\u64c7\u5df2\u5132\u5b58\u7684\u9304\u97f3\u6216\u532f\u5165\u97f3\u8a0a\u4ee5\u958b\u59cb\u3002"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u062e\u062a\u0631 \u062a\u0633\u062c\u064a\u0644\u0627\u064b \u0645\u062d\u0641\u0648\u0638\u0627\u064b \u0623\u0648 \u0627\u0633\u062a\u0648\u0631\u062f \u0635\u0648\u062a\u0627\u064b \u0644\u0644\u0628\u062f\u0621."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d1\u05d7\u05e8 \u05d4\u05e7\u05dc\u05d8\u05d4 \u05e9\u05de\u05d5\u05e8\u05d4 \u05d0\u05d5 \u05d9\u05d9\u05d1\u05d0 \u05e9\u05de\u05e2 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u0947\u091c\u0940 \u0917\u0908 \u0930\u093f\u0915\u0949\u0930\u094d\u0921\u093f\u0902\u0917 \u091a\u0941\u0928\u0947\u0902 \u092f\u093e \u0911\u0921\u093f\u092f\u094b \u0906\u092f\u093e\u0924 \u0915\u0930\u0947\u0902\u0964"
          }
        }
      }
    },
