        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخرج واحدًا باستخدام scripts/extract_direction.py، أو استخدم مجموعة منشورة. يحتوي docs/OBLITERATION.md على القياسات، بما في ذلك ما يحدث بالقوة الكاملة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrahieren Sie einen mit scripts/extract_direction.py oder verwenden Sie ein veröffentlichtes Set. docs/OBLITERATION.md enthält die Messungen, einschließlich der Auswirkungen bei voller Stärke."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extract one with scripts/extract_direction.py, or use a published set. docs/OBLITERATION.md has the measurements, including what happens at full strength."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrae uno con scripts/extract_direction.py o usa un conjunto publicado. docs/OBLITERATION.md contiene las mediciones, incluido lo que ocurre a máxima intensidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrayez-en un avec scripts/extract_direction.py, ou utilisez un ensemble publié. docs/OBLITERATION.md contient les mesures, y compris ce qui se passe à pleine intensité."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חלץ אחד באמצעות scripts/extract_direction.py, או השתמש בערכה שפורסמה. ב-docs/OBLITERATION.md יש את המדידות, כולל מה שקורה בעוצמה מלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "scripts/extract_direction.py के साथ एक निकालें, या प्रकाशित सेट का उपयोग करें। docs/OBLITERATION.md में माप हैं, जिसमें यह भी शामिल है कि पूरी ताकत पर क्या होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstrak satu dengan scripts/extract_direction.py, atau gunakan set yang dipublikasikan. docs/OBLITERATION.md memiliki pengukurannya, termasuk apa yang terjadi pada kekuatan penuh."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Estraine uno con scripts/extract_direction.py, o usa un set pubblicato. docs/OBLITERATION.md contiene le misurazioni, compreso cosa accade a piena intensità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "scripts/extract_direction.py で抽出するか、公開されたセットを使用してください。docs/OBLITERATION.md には、最大強度で何が起こるかを含む測定結果が記載されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "scripts/extract_direction.py로 추출하거나 공개된 세트를 사용하세요. docs/OBLITERATION.md에 전체 강도에서 일어나는 현상을 포함한 측정 결과가 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraheer er een met scripts/extract_direction.py, of gebruik een gepubliceerde set. docs/OBLITERATION.md bevat de metingen, inclusief wat er gebeurt bij volle sterkte."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyodrębnij wektor za pomocą scripts/extract_direction.py lub użyj opublikowanego zestawu. docs/OBLITERATION.md zawiera pomiary, w tym informacje o tym, co dzieje się przy pełnej sile."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Extraia um com scripts/extract_direction.py ou use um conjunto publicado. docs/OBLITERATION.md contém as medições, incluindo o que acontece em intensidade total."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Извлеките вектор с помощью scripts/extract_direction.py или используйте опубликованный набор. В docs/OBLITERATION.md приведены измерения, включая последствия при полной силе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Extrahera en med scripts/extract_direction.py, eller använd ett publicerat set. docs/OBLITERATION.md har mätningarna, inklusive vad som händer vid full styrka."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "scripts/extract_direction.py ile bir tane ayıklayın veya yayınlanmış bir set kullanın. docs/OBLITERATION.md tam güçte ne olduğu dahil ölçümlere sahiptir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучіть вектор за допомогою scripts/extract_direction.py або скористайтеся опублікованим набором. У docs/OBLITERATION.md наведено вимірювання, зокрема те, що відбувається на повній силі."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trích xuất một hướng bằng scripts/extract_direction.py hoặc sử dụng một bộ đã xuất bản. docs/OBLITERATION.md có các phép đo, bao gồm những gì xảy ra ở cường độ tối đa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 scripts/extract_direction.py 提取向量，或使用公开发布的集合。docs/OBLITERATION.md 载有测试数据，包括全强度下的表现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 scripts/extract_direction.py 擷取向量，或使用公開發布的集合。docs/OBLITERATION.md 載有測試數據，包括全強度下的表現。"
          }
        }
      }
    },
