    "Live or last run decoding throughput (tokens per second)": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0639\u062f\u0644 \u0641\u0643 \u0627\u0644\u062a\u0634\u0641\u064a\u0631 \u0627\u0644\u0645\u0628\u0627\u0634\u0631 \u0623\u0648 \u0644\u0622\u062e\u0631 \u062a\u0634\u063a\u064a\u0644 (\u0631\u0645\u0648\u0632 \u0641\u064a \u0627\u0644\u062b\u0627\u0646\u064a\u0629)"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dekodierdurchsatz live oder des letzten Laufs (Token pro Sekunde)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Live or last run decoding throughput (tokens per second)"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rendimiento de decodificaci\u00f3n en vivo o de la \u00faltima ejecuci\u00f3n (tokens por segundo)"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D\u00e9bit de d\u00e9codage en direct ou de la derni\u00e8re ex\u00e9cution (tokens par seconde)"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05e6\u05d1 \u05e4\u05e2\u05e0\u05d5\u05d7 \u05d7\u05d9 \u05d0\u05d5 \u05e9\u05dc \u05d4\u05d4\u05e8\u05e6\u05d4 \u05d4\u05d0\u05d7\u05e8\u05d5\u05e0\u05d4 (\u05d8\u05d5\u05e7\u05e0\u05d9\u05dd \u05dc\u05e9\u05e0\u05d9\u05d9\u05d4)"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0932\u093e\u0907\u0935 \u092f\u093e \u092a\u093f\u091b\u0932\u0947 \u0930\u0928 \u0915\u093e \u0921\u093f\u0915\u094b\u0921\u093f\u0902\u0917 \u0925\u094d\u0930\u0942\u092a\u0941\u091f (\u091f\u094b\u0915\u0928 \u092a\u094d\u0930\u0924\u093f \u0938\u0947\u0915\u0902\u0921)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Throughput dekode langsung atau proses terakhir (token per detik)"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Velocit\u00e0 di decodifica in tempo reale o dell'ultima esecuzione (token al secondo)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30ea\u30a2\u30eb\u30bf\u30a4\u30e0\u307e\u305f\u306f\u524d\u56de\u5b9f\u884c\u306e\u30c7\u30b3\u30fc\u30c9\u901f\u5ea6 (\u30c8\u30fc\u30af\u30f3/\u79d2)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc2e4\uc2dc\uac04 \ub610\ub294 \ub9c8\uc9c0\ub9c9 \uc2e4\ud589\uc758 \ub514\ucf54\ub529 \ucc98\ub9ac\ub7c9(\ucd08\ub2f9 \ud1a0\ud070)"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decodeersnelheid live of van de laatste run (tokens per seconde)"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepustowo\u015b\u0107 dekodowania na \u017cywo lub z ostatniego uruchomienia (tokeny na sekund\u0119)"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Taxa de decodifica\u00e7\u00e3o ao vivo ou da \u00faltima execu\u00e7\u00e3o (tokens por segundo)"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0421\u043a\u043e\u0440\u043e\u0441\u0442\u044c \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438 \u0441\u0435\u0439\u0447\u0430\u0441 \u0438\u043b\u0438 \u0432 \u043f\u043e\u0441\u043b\u0435\u0434\u043d\u0435\u043c \u0437\u0430\u043f\u0443\u0441\u043a\u0435 (\u0442\u043e\u043a\u0435\u043d\u043e\u0432 \u0432 \u0441\u0435\u043a\u0443\u043d\u0434\u0443)"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Avkodningshastighet live eller fr\u00e5n senaste k\u00f6rningen (tokens per sekund)"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Canl\u0131 veya son \u00e7al\u0131\u015ft\u0131rmadaki kod \u00e7\u00f6zme h\u0131z\u0131 (saniye ba\u015f\u0131na belirte\u00e7)"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0428\u0432\u0438\u0434\u043a\u0456\u0441\u0442\u044c \u0434\u0435\u043a\u043e\u0434\u0443\u0432\u0430\u043d\u043d\u044f \u043d\u0430\u0436\u0438\u0432\u043e \u0430\u0431\u043e \u043e\u0441\u0442\u0430\u043d\u043d\u044c\u043e\u0433\u043e \u0437\u0430\u043f\u0443\u0441\u043a\u0443 (\u0442\u043e\u043a\u0435\u043d\u0456\u0432 \u0437\u0430 \u0441\u0435\u043a\u0443\u043d\u0434\u0443)"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "T\u1ed1c \u0111\u1ed9 gi\u1ea3i m\u00e3 tr\u1ef1c ti\u1ebfp ho\u1eb7c c\u1ee7a l\u1ea7n ch\u1ea1y g\u1ea7n nh\u1ea5t (token m\u1ed7i gi\u00e2y)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5b9e\u65f6\u6216\u4e0a\u6b21\u8fd0\u884c\u7684\u89e3\u7801\u541e\u5410\u91cf\uff08\u6bcf\u79d2 Token \u6570\uff09"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5373\u6642\u6216\u4e0a\u6b21\u57f7\u884c\u7684\u89e3\u78bc\u541e\u5410\u91cf\uff08\u6bcf\u79d2 Token \u6578\uff09"
          }
        }
      }
    },
