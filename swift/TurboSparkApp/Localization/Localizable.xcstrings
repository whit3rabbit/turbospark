    "'%@' is attached to the running server. Detach it there first.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0645\u0631\u0641\u0642 \u0628\u0627\u0644\u062e\u0627\u062f\u0645 \u0642\u064a\u062f \u0627\u0644\u062a\u0634\u063a\u064a\u0644. \u0627\u0641\u0635\u0644\u0647 \u0645\u0646 \u0647\u0646\u0627\u0643 \u0623\u0648\u0644\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' ist mit dem laufenden Server verbunden. Trennen Sie es zuerst dort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is attached to the running server. Detach it there first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' est\u00e1 adjunto al servidor en ejecuci\u00f3n. Sep\u00e1ralo all\u00ed primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' est joint au serveur en cours d'ex\u00e9cution. D\u00e9tachez-le d'abord depuis le serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u05de\u05e6\u05d5\u05e8\u05e3 \u05dc\u05e9\u05e8\u05ea \u05d4\u05e4\u05d5\u05e2\u05dc. \u05e0\u05ea\u05e7 \u05d0\u05d5\u05ea\u05d5 \u05e9\u05dd \u05ea\u05d7\u05d9\u05dc\u05d4."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u091a\u0932 \u0930\u0939\u0947 \u0938\u0930\u094d\u0935\u0930 \u0938\u0947 \u0938\u0902\u0932\u0917\u094d\u0928 \u0939\u0948\u0964 \u092a\u0939\u0932\u0947 \u0909\u0938\u0947 \u0935\u0939\u093e\u0902 \u0938\u0947 \u0905\u0932\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' terlampir ke server yang sedang berjalan. Lepaskan di sana terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u00e8 collegato al server in esecuzione. Scollegalo prima da l\u00ec."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u306f\u5b9f\u884c\u4e2d\u306e\u30b5\u30fc\u30d0\u30fc\u306b\u63a5\u7d9a\u3055\u308c\u3066\u3044\u307e\u3059\u3002\u5148\u306b\u30b5\u30fc\u30d0\u30fc\u5074\u3067\u5207\u308a\u96e2\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@'\uc774(\uac00) \uc2e4\ud589 \uc911\uc778 \uc11c\ubc84\uc5d0 \uc5f0\uacb0\ub418\uc5b4 \uc788\uc2b5\ub2c8\ub2e4. \uba3c\uc800 \uc11c\ubc84\uc5d0\uc11c \ubd84\ub9ac\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' is gekoppeld aan de actieve server. Ontkoppel het daar eerst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' jest do\u0142\u0105czony do dzia\u0142aj\u0105cego serwera. Najpierw od\u0142\u0105cz go tam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' est\u00e1 anexado ao servidor em execu\u00e7\u00e3o. Desanexe-o l\u00e1 primeiro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c '%@' \u043f\u043e\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u0430 \u043a \u0440\u0430\u0431\u043e\u0442\u0430\u044e\u0449\u0435\u043c\u0443 \u0441\u0435\u0440\u0432\u0435\u0440\u0443. \u0421\u043d\u0430\u0447\u0430\u043b\u0430 \u043e\u0442\u0441\u043e\u0435\u0434\u0438\u043d\u0438\u0442\u0435 \u0435\u0451 \u0442\u0430\u043c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u00e4r ansluten till den k\u00f6rande servern. Koppla fr\u00e5n den d\u00e4r f\u00f6rst."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u00e7al\u0131\u015fan sunucuya ba\u011fl\u0131. \u00d6nce oradan ay\u0131r\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041c\u043e\u0434\u0435\u043b\u044c '%@' \u043f\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043e \u0434\u043e \u0437\u0430\u043f\u0443\u0449\u0435\u043d\u043e\u0433\u043e \u0441\u0435\u0440\u0432\u0435\u0440\u0430. \u0421\u043f\u0435\u0440\u0448\u0443 \u0432\u0456\u0434'\u0454\u0434\u043d\u0430\u0439\u0442\u0435 \u0457\u0457 \u0442\u0430\u043c."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u0111ang \u0111\u01b0\u1ee3c g\u1eafn v\u00e0o m\u00e1y ch\u1ee7 \u0111ang ch\u1ea1y. H\u00e3y t\u00e1ch r\u1eddi n\u00f3 \u1edf \u0111\u00f3 tr\u01b0\u1edbc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u5df2\u6302\u8f7d\u5230\u6b63\u5728\u8fd0\u884c\u7684\u670d\u52a1\u5668\u3002\u8bf7\u5148\u5728\u670d\u52a1\u5668\u4e2d\u5c06\u5176\u5206\u79bb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "'%@' \u5df2\u639b\u8f09\u5230\u6b63\u5728\u57f7\u884c\u7684\u4f3a\u670d\u5668\u3002\u8acb\u5148\u5728\u4f3a\u670d\u5668\u4e2d\u5c07\u5176\u5206\u96e2\u3002"
          }
        }
      }
    },
    "'%@' matches %lld models: %@. Be more specific.": {
