    },
    "The copied files did not match the original, so the move was stopped.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تتطابق الملفات المنسوخة مع الأصل، لذلك تم إيقاف النقل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die kopierten Dateien stimmten nicht mit dem Original überein, daher wurde das Verschieben abgebrochen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copied files did not match the original, so the move was stopped."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos copiados no coincidían con el original, así que se detuvo el movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers copiés ne correspondaient pas à l'original ; le déplacement a donc été arrêté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקבצים שהועתקו לא תאמו למקור, ולכן ההעברה הופסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉपी की गई फ़ाइलें मूल से मेल नहीं खाईं, इसलिए स्थानांतरण रोक दिया गया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "File yang disalin tidak cocok dengan aslinya, jadi pemindahan dihentikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file copiati non corrispondevano all'originale, quindi lo spostamento è stato interrotto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コピーしたファイルが元のファイルと一致しなかったため、移動を中止しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사된 파일이 원본과 일치하지 않아 이동이 중단되었습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De gekopieerde bestanden kwamen niet overeen met het origineel, dus het verplaatsen is gestopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowane pliki nie zgadzały się z oryginałem, więc przenoszenie zostało zatrzymane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos copiados não coincidiam com o original, então a movimentação foi interrompida."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопированные файлы не совпали с оригиналом, поэтому перемещение остановлено."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De kopierade filerna stämde inte med originalet, så flytten avbröts."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kopyalanan dosyalar aslıyla eşleşmedi, bu yüzden taşıma durduruldu."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скопійовані файли не збігаються з оригіналом, тому переміщення зупинено."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các tệp đã sao chép không khớp với bản gốc, nên quá trình di chuyển đã dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "复制的文件与原件不一致，因此已停止移动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "複製的檔案與原件不一致，因此已停止移動。"
          }
        }
      }
    },
    "The current workspace folder is not tracked by Git. Initialize a repository to enable version control, change inspection, and diffs.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مجلد مساحة العمل الحالي غير متتبع بواسطة Git. هيّئ مستودعا لتفعيل التحكم بالإصدارات وفحص التغييرات والفروق."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der aktuelle Arbeitsbereichsordner wird nicht von Git verfolgt. Initialisieren Sie ein Repository, um Versionskontrolle, Änderungsprüfung und Diffs zu aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current workspace folder is not tracked by Git. Initialize a repository to enable version control, change inspection, and diffs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carpeta de trabajo actual no está bajo seguimiento de Git. Inicializa un repositorio para habilitar el control de versiones, la inspección de cambios y las diferencias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le dossier de travail actuel n'est pas suivi par Git. Initialisez un dépôt pour activer le contrôle de version, l'inspection des modifications et les différences."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיקיית סביבת העבודה הנוכחית אינה במעקב של Git. אתחל מאגר כדי לאפשר בקרת גרסאות, בדיקת שינויים והשוואות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वर्तमान वर्कस्पेस फ़ोल्डर Git द्वारा ट्रैक नहीं किया जा रहा। संस्करण नियंत्रण, बदलाव निरीक्षण और डिफ़ सक्षम करने के लिए रिपॉजिटरी आरंभ करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Folder ruang kerja saat ini tidak dilacak Git. Inisialisasi repositori untuk mengaktifkan kontrol versi, pemeriksaan perubahan, dan diff."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartella dell'area di lavoro corrente non è tracciata da Git. Inizializza un repository per abilitare il controllo di versione, l'ispezione delle modifiche e le differenze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のワークスペースフォルダは Git で管理されていません。バージョン管理、変更の確認、差分を有効にするにはリポジトリを初期化してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 작업 공간 폴더는 Git으로 추적되지 않습니다. 버전 관리, 변경 사항 확인, 차이 보기를 사용하려면 리포지토리를 초기화하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De huidige werkruimtemap wordt niet door Git bijgehouden. Initialiseer een repository om versiebeheer, wijzigingsinspectie en verschillen in te schakelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bieżący folder obszaru roboczego nie jest śledzony przez Git. Zainicjuj repozytorium, aby włączyć kontrolę wersji, przegląd zmian i różnice."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A pasta de trabalho atual não é rastreada pelo Git. Inicialize um repositório para habilitar controle de versão, inspeção de alterações e diferenças."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Текущая папка рабочей области не отслеживается Git. Инициализируйте репозиторий, чтобы включить контроль версий, просмотр изменений и различия."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den aktuella arbetsytemappen spåras inte av Git. Initiera en utvecklingskatalog för att aktivera versionshantering, ändringsgranskning och skillnader."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçerli çalışma alanı klasörü Git tarafından izlenmiyor. Sürüm denetimi, değişiklik incelemesi ve farkları etkinleştirmek için bir depo başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поточна папка робочої області не відстежується Git. Ініціалізуйте репозиторій, щоб увімкнути контроль версій, перегляд змін і відмінності."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư mục không gian làm việc hiện tại chưa được Git theo dõi. Khởi tạo một kho để bật quản lý phiên bản, xem thay đổi và so sánh khác biệt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前工作区文件夹未被 Git 跟踪。初始化仓库即可启用版本控制、变更查看和差异比较。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前工作區資料夾未被 Git 追蹤。初始化儲存庫即可啟用版本控制、變更檢視與差異比較。"
          }
        }
      }
    },
    "The declared category is weaker than what this tool really does, so the effective category is enforced instead.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الفئة المعلنة أضعف مما تفعله هذه الأداة فعلاً، لذلك تُطبَّق الفئة الفعلية بدلاً منها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die angegebene Kategorie ist schwächer als das, was dieses Werkzeug tatsächlich tut. Daher gilt stattdessen die wirksame Kategorie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The declared category is weaker than what this tool really does, so the effective category is enforced instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoría declarada es más débil de lo que esta herramienta hace realmente, así que se aplica la categoría efectiva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La catégorie déclarée est plus faible que ce que fait réellement cet outil. La catégorie effective est donc appliquée à sa place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקטגוריה המוצהרת חלשה ממה שהכלי עושה בפועל, ולכן נאכפת הקטגוריה בפועל במקומה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "घोषित श्रेणी उस काम से कमज़ोर है जो यह टूल वास्तव में करता है, इसलिए इसके बदले प्रभावी श्रेणी लागू की जाती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kategori yang dinyatakan lebih lemah daripada yang sebenarnya dilakukan alat ini, sehingga kategori efektif yang diberlakukan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La categoria dichiarata è più debole di ciò che lo strumento fa davvero, quindi viene applicata la categoria effettiva."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "宣言されたカテゴリはこのツールの実際の動作より弱いため、代わりに実際のカテゴリが適用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선언된 카테고리가 이 도구의 실제 동작보다 약하므로, 대신 실제 적용 카테고리가 사용됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De opgegeven categorie is zwakker dan wat deze tool echt doet, dus de effectieve categorie wordt afgedwongen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadeklarowana kategoria jest słabsza niż rzeczywiste działanie tego narzędzia, więc obowiązuje kategoria rzeczywista."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A categoria declarada é mais fraca do que o que esta ferramenta realmente faz, então a categoria efetiva é aplicada no lugar dela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявленная категория слабее, чем реальные действия инструмента, поэтому вместо неё применяется фактическая категория."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den deklarerade kategorin är svagare än vad verktyget faktiskt gör, så den gällande kategorin tillämpas i stället."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirilen kategori, bu aracın gerçekte yaptığından daha zayıf; bu yüzden onun yerine geçerli kategori uygulanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявлена категорія слабша за те, що інструмент робить насправді, тому замість неї застосовується фактична категорія."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh mục được khai báo yếu hơn những gì công cụ này thực sự làm, nên danh mục có hiệu lực được áp dụng thay thế."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明的类别比该工具的实际行为更宽松,因此改为强制使用实际生效的类别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "宣告的類別比此工具的實際行為更寬鬆,因此改為強制使用實際生效的類別。"
          }
        }
      }
    },
    "The default for most SDKs and editor plugins. Point the base URL here.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
