          }
        }
      }
    },
    "It rewrites text so it reads like a person wrote it. About 12.7 GB.": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u064a\u062f \u0643\u062a\u0627\u0628\u0629 \u0627\u0644\u0646\u0635 \u0644\u064a\u0628\u062f\u0648 \u0648\u0643\u0623\u0646 \u0625\u0646\u0633\u0627\u0646\u064b\u0627 \u0643\u062a\u0628\u0647. \u062d\u062c\u0645\u0647 \u0646\u062d\u0648 12.7 \u062c\u064a\u062c\u0627\u0628\u0627\u064a\u062a."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es schreibt Text so um, dass er wie von einem Menschen geschrieben klingt. Etwa 12,7 GB."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It rewrites text so it reads like a person wrote it. About 12.7 GB."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescribe el texto para que parezca escrito por una persona. Unos 12,7 GB."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il r\u00e9\u00e9crit un texte pour qu'il paraisse \u00e9crit par une personne. Environ 12,7 Go."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05d5\u05d0 \u05db\u05d5\u05ea\u05d1 \u05de\u05d7\u05d3\u05e9 \u05d8\u05e7\u05e1\u05d8 \u05db\u05da \u05e9\u05d9\u05d9\u05e8\u05d0\u05d4 \u05db\u05d0\u05d9\u05dc\u05d5 \u05d0\u05d3\u05dd \u05db\u05ea\u05d1 \u05d0\u05d5\u05ea\u05d5. \u05db-12.7 \u05d2\u05f3\u05d9\u05d2\u05d4-\u05d1\u05d9\u05d9\u05d8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092f\u0939 \u091f\u0947\u0915\u094d\u0938\u094d\u091f \u0915\u094b \u0907\u0938 \u0924\u0930\u0939 \u0926\u094b\u092c\u093e\u0930\u093e \u0932\u093f\u0916\u0924\u093e \u0939\u0948 \u0915\u093f \u0935\u0939 \u0915\u093f\u0938\u0940 \u0907\u0902\u0938\u093e\u0928 \u0915\u093e \u0932\u093f\u0916\u093e \u0932\u0917\u0947\u0964 \u0932\u0917\u092d\u0917 12.7 GB\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Model ini menulis ulang teks agar terbaca seperti ditulis manusia. Sekitar 12,7 GB."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riscrive il testo in modo che sembri scritto da una persona. Circa 12,7 GB."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6587\u7ae0\u3092\u3001\u4eba\u304c\u66f8\u3044\u305f\u3088\u3046\u306b\u8aad\u3081\u308b\u5f62\u306b\u66f8\u304d\u76f4\u3057\u307e\u3059\u3002\u7d0412.7 GB\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uae00\uc744 \uc0ac\ub78c\uc774 \uc4f4 \uac83\ucc98\ub7fc \uc77d\ud788\ub3c4\ub85d \ub2e4\uc2dc \uc368 \uc90d\ub2c8\ub2e4. \uc57d 12.7 GB."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het herschrijft tekst zodat die klinkt alsof een mens hem schreef. Ongeveer 12,7 GB."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przepisuje tekst tak, aby brzmia\u0142, jakby napisa\u0142 go cz\u0142owiek. Oko\u0142o 12,7 GB."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Reescreve o texto para que pare\u00e7a escrito por uma pessoa. Cerca de 12,7 GB."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u0442\u0435\u043a\u0441\u0442 \u0442\u0430\u043a, \u0447\u0442\u043e\u0431\u044b \u043e\u043d \u0447\u0438\u0442\u0430\u043b\u0441\u044f \u043a\u0430\u043a \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u043d\u044b\u0439 \u0447\u0435\u043b\u043e\u0432\u0435\u043a\u043e\u043c. \u041e\u043a\u043e\u043b\u043e 12,7 \u0413\u0411."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den skriver om text s\u00e5 att den l\u00e5ter som om en m\u00e4nniska skrivit den. Cirka 12,7 GB."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Metni bir insan yazm\u0131\u015f gibi okunacak \u015fekilde yeniden yazar. Yakla\u015f\u0131k 12,7 GB."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0435\u0440\u0435\u043f\u0438\u0441\u0443\u0454 \u0442\u0435\u043a\u0441\u0442 \u0442\u0430\u043a, \u0449\u043e\u0431 \u0432\u0456\u043d \u0447\u0438\u0442\u0430\u0432\u0441\u044f \u044f\u043a \u043d\u0430\u043f\u0438\u0441\u0430\u043d\u0438\u0439 \u043b\u044e\u0434\u0438\u043d\u043e\u044e. \u0411\u043b\u0438\u0437\u044c\u043a\u043e 12,7 \u0413\u0411."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "M\u00f4 h\u00ecnh vi\u1ebft l\u1ea1i v\u0103n b\u1ea3n \u0111\u1ec3 \u0111\u1ecdc nh\u01b0 do con ng\u01b0\u1eddi vi\u1ebft. Kho\u1ea3ng 12,7 GB."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c06\u6587\u672c\u6539\u5199\u5f97\u50cf\u771f\u4eba\u5199\u7684\u4e00\u6837\u3002\u7ea6 12.7 GB\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c07\u6587\u5b57\u6539\u5beb\u5f97\u50cf\u771f\u4eba\u5beb\u7684\u4e00\u6a23\u3002\u7d04 12.7 GB\u3002"
          }
        }
      }
    },
