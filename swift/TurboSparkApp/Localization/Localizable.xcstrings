    "Seed must be an unsigned integer or blank for random.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن تكون البذرة عددًا صحيحًا غير سالب، أو تُترك فارغة لقيمة عشوائية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Seed muss eine vorzeichenlose Ganzzahl sein oder für Zufall leer bleiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed must be an unsigned integer or blank for random."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La semilla debe ser un entero sin signo o quedar vacía para un valor aleatorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La graine doit être un entier non signé, ou vide pour une valeur aléatoire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הסיד חייב להיות מספר שלם אי-שלילי, או ריק לערך אקראי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सीड एक अहस्ताक्षरित पूर्णांक होना चाहिए, या यादृच्छिक के लिए खाली छोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed harus berupa bilangan bulat tak bertanda atau kosong untuk acak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il seed deve essere un intero senza segno o vuoto per un valore casuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シードには符号なし整数を指定するか、ランダムにする場合は空欄にしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시드는 부호 없는 정수여야 하며, 무작위로 하려면 비워 두세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed moet een geheel getal zonder teken zijn, of leeg voor willekeurig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziarno musi być liczbą całkowitą bez znaku lub puste dla wartości losowej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O seed deve ser um inteiro sem sinal ou ficar em branco para aleatório."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сид должен быть целым числом без знака или пустым для случайного значения."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Seed måste vara ett icke-negativt heltal eller tomt för slumpmässigt värde."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohum işaretsiz bir tam sayı olmalı veya rastgele için boş bırakılmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сід має бути цілим числом без знака або порожнім для випадкового значення."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hạt giống phải là số nguyên không dấu, hoặc để trống để chọn ngẫu nhiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随机种子必须是无符号整数，留空则随机生成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨機種子必須是無號整數，留空則隨機產生。"
          }
        }
      }
    },
