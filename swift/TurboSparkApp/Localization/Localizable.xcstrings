    "Temporary chat: this conversation can't be recovered.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporary chat: this conversation can't be recovered."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporal: esta conversación no se puede recuperar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Discussion temporaire : cette conversation ne peut pas être récupérée."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Temporärer Chat: Diese Unterhaltung kann nicht wiederhergestellt werden."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporanea: questa conversazione non può essere recuperata."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chat temporário: esta conversa não pode ser recuperada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Временный чат: эту беседу нельзя восстановить."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一時的なチャットです。この会話は復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 대화: 이 대화는 복구할 수 없습니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "临时对话: 此会话无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時對話: 此對話無法復原。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محادثة مؤقتة: لا يمكن استعادة هذه المحادثة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
