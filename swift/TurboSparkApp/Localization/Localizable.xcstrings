    "Upper bound on the agent's autonomous turns (1 to %lld).": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u0639\u0644\u0649 \u0644\u0644\u0623\u062f\u0648\u0627\u0631 \u0627\u0644\u0645\u0633\u062a\u0642\u0644\u0629 \u0644\u0644\u0648\u0643\u064a\u0644 (1 \u0625\u0644\u0649 %lld)."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Obergrenze f\u00fcr autonome Agentenrunden (1 bis %lld)."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upper bound on the agent's autonomous turns (1 to %lld)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00edmite superior para los turnos aut\u00f3nomos del agente (de 1 a %lld)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite sup\u00e9rieure des tours autonomes de l'agent (1 \u00e0 %lld)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d2\u05d1\u05d5\u05dc \u05e2\u05dc\u05d9\u05d5\u05df \u05dc\u05ea\u05d5\u05e8\u05d5\u05ea \u05d4\u05d0\u05d5\u05d8\u05d5\u05e0\u05d5\u05de\u05d9\u05d9\u05dd \u05e9\u05dc \u05d4\u05e1\u05d5\u05db\u05df (1 \u05e2\u05d3 %lld)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u090f\u091c\u0947\u0902\u091f \u0915\u0947 \u0938\u094d\u0935\u093e\u092f\u0924\u094d\u0924 \u092e\u094b\u0921\u093c\u094b\u0902 \u0915\u0940 \u090a\u092a\u0930\u0940 \u0938\u0940\u092e\u093e (1 \u0938\u0947 %lld)\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Batas atas putaran otonom agen (1 hingga %lld)."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite superiore dei turni autonomi dell'agente (da 1 a %lld)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30a8\u30fc\u30b8\u30a7\u30f3\u30c8\u306e\u81ea\u5f8b\u30bf\u30fc\u30f3\u306e\u4e0a\u9650\uff081 \u301c %lld\uff09\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc5d0\uc774\uc804\ud2b8\uc758 \uc790\uc728 \ud134\uc5d0 \ub300\ud55c \uc0c1\ud55c(1~%lld)."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bovengrens voor autonome beurten van de agent (1 tot %lld)."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00f3rny limit autonomicznych tur agenta (od 1 do %lld)."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Limite superior para os turnos aut\u00f4nomos do agente (1 a %lld)."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0440\u0445\u043d\u0438\u0439 \u043f\u0440\u0435\u0434\u0435\u043b \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u044b\u0445 \u0434\u0435\u0439\u0441\u0442\u0432\u0438\u0439 \u0430\u0433\u0435\u043d\u0442\u0430 (\u043e\u0442 1 \u0434\u043e %lld)."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "\u00d6vre gr\u00e4ns f\u00f6r agentens autonoma turer (1 till %lld)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arac\u0131n\u0131n \u00f6zerk turlar\u0131 i\u00e7in \u00fcst s\u0131n\u0131r (1 ila %lld)."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0435\u0440\u0445\u043d\u044f \u043c\u0435\u0436\u0430 \u0430\u0432\u0442\u043e\u043d\u043e\u043c\u043d\u0438\u0445 \u0434\u0456\u0439 \u0430\u0433\u0435\u043d\u0442\u0430 (\u0432\u0456\u0434 1 \u0434\u043e %lld)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gi\u1edbi h\u1ea1n tr\u00ean cho c\u00e1c l\u01b0\u1ee3t t\u1ef1 tr\u1ecb c\u1ee7a t\u00e1c nh\u00e2n (1 \u0111\u1ebfn %lld)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u667a\u80fd\u4f53\u81ea\u4e3b\u8f6e\u6b21\u7684\u4e0a\u9650\uff081 \u5230 %lld\uff09\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4ee3\u7406\u81ea\u4e3b\u8f2a\u6b21\u7684\u4e0a\u9650\uff081 \u5230 %lld\uff09\u3002"
          }
        }
      }
    },
