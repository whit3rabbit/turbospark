    "the archive contains unsafe paths (%@) and was refused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u062d\u062a\u0648\u064a \u0627\u0644\u0623\u0631\u0634\u064a\u0641 \u0639\u0644\u0649 \u0645\u0633\u0627\u0631\u0627\u062a \u063a\u064a\u0631 \u0622\u0645\u0646\u0629 (%@) \u0648\u062a\u0645 \u0631\u0641\u0636\u0647"
          }
        },
        "de": {
