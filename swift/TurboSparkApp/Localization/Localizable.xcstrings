        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu deponun yay\u0131mlad\u0131\u011f\u0131 .gguf dosyalar\u0131n\u0131 listele"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u043e\u043a\u0430\u0437\u0430\u0442\u0438 \u0444\u0430\u0439\u043b\u0438 .gguf, \u043e\u043f\u0443\u0431\u043b\u0456\u043a\u043e\u0432\u0430\u043d\u0456 \u0432 \u0446\u044c\u043e\u043c\u0443 \u0440\u0435\u043f\u043e\u0437\u0438\u0442\u043e\u0440\u0456\u0457"
