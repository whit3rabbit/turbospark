    "Project sources include user sources. Removing a source keeps installed items.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Project sources include user sources. Removing a source keeps installed items."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las fuentes del proyecto incluyen las fuentes del usuario. Eliminar una fuente conserva los elementos instalados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les sources du projet incluent les sources utilisateur. La suppression d'une source conserve les éléments installés."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektquellen enthalten Benutzerquellen. Beim Entfernen einer Quelle bleiben installierte Elemente erhalten."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le origini del progetto includono le origini utente. La rimozione di un'origine mantiene gli elementi installati."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As fontes do projeto incluem fontes do usuário. Remover uma fonte mantém os itens instalados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Источники проекта включают источники пользователя. Удаление источника сохраняет установленные элементы."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクトソースにはユーザーソースが含まれます。ソースを削除してもインストール済みの項目は保持されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 소스에는 사용자 소스가 포함됩니다. 소스를 제거해도 설치된 항목은 유지됩니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "项目源包含用户源。移除源会保留已安装的项目。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "專案來源包含使用者來源。移除來源會保留已安裝的項目。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتضمن مصادر المشروع مصادر المستخدم. إزالة المصدر تحافظ على العناصر المثبتة."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מקורות הפרויקט כוללים מקורות משתמש. הסרת מקור שומרת על פריטים מותקנים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोजेक्ट स्रोतों में उपयोगकर्ता स्रोत शामिल हैं। स्रोत हटाने पर स्थापित आइटम बने रहते हैं।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projectbronnen omvatten gebruikersbronnen. Het verwijderen van een bron behoudt geïnstalleerde items."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Źródła projektu obejmują źródła użytkownika. Usunięcie źródła zachowuje zainstalowane elementy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proje kaynakları kullanıcı kaynaklarını içerir. Bir kaynağı kaldırmak yüklü öğeleri korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Джерела проекту включають джерела користувача. Видалення джерела зберігає встановлені елементи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Projektkällor inkluderar användarkällor. Att ta bort en källa behåller installerade objekt."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nguồn dự án bao gồm nguồn người dùng. Xóa nguồn vẫn giữ lại các mục đã cài đặt."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumber proyek mencakup sumber pengguna. Menghapus sumber tetap menyimpan item yang terpasang."
          }
        }
      }
    },
