        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0437\u0430\u043f\u0438\u0442, \u0432\u0456\u0434\u0440\u0435\u0434\u0430\u0433\u0443\u0439\u0442\u0435 \u0439\u043e\u0433\u043e \u0430\u0431\u043e \u043d\u0430\u043f\u0438\u0448\u0456\u0442\u044c \u0432\u043b\u0430\u0441\u043d\u0438\u0439."
