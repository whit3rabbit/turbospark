    "No local models found in ~/.turbospark. Choose a recommended model below to start.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u064a\u064f\u0639\u062b\u0631 \u0639\u0644\u0649 \u0646\u0645\u0627\u0630\u062c \u0645\u062d\u0644\u064a\u0629 \u0641\u064a \u200e~/.turbospark. \u0627\u062e\u062a\u0631 \u0646\u0645\u0648\u0630\u062c\u0627 \u0645\u0648\u0635\u0649 \u0628\u0647 \u0623\u062f\u0646\u0627\u0647 \u0644\u0644\u0628\u062f\u0621."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine lokalen Modelle in ~/.turbospark gefunden. W\u00e4hlen Sie unten ein empfohlenes Modell, um zu beginnen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No local models found in ~/.turbospark. Choose a recommended model below to start."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se han encontrado modelos locales en ~/.turbospark. Elige abajo un modelo recomendado para empezar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun mod\u00e8le local trouv\u00e9 dans ~/.turbospark. Choisissez ci-dessous un mod\u00e8le recommand\u00e9 pour commencer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05d0 \u05e0\u05de\u05e6\u05d0\u05d5 \u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05de\u05e7\u05d5\u05de\u05d9\u05d9\u05dd \u05d1-\u200e~/.turbospark. \u05d1\u05d7\u05e8 \u05de\u05d5\u05d3\u05dc \u05de\u05d5\u05de\u05dc\u05e5 \u05dc\u05de\u05d8\u05d4 \u05db\u05d3\u05d9 \u05dc\u05d4\u05ea\u05d7\u05d9\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.turbospark \u092e\u0947\u0902 \u0915\u094b\u0908 \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092e\u0949\u0921\u0932 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e\u0964 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0928\u0940\u091a\u0947 \u0915\u094b\u0908 \u0905\u0928\u0941\u0936\u0902\u0938\u093f\u0924 \u092e\u0949\u0921\u0932 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada model lokal di ~/.turbospark. Pilih model yang direkomendasikan di bawah untuk memulai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun modello locale trovato in ~/.turbospark. Scegli qui sotto un modello consigliato per iniziare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.turbospark \u306b\u30ed\u30fc\u30ab\u30eb\u30e2\u30c7\u30eb\u304c\u898b\u3064\u304b\u308a\u307e\u305b\u3093\u3002\u4e0b\u304b\u3089\u63a8\u5968\u30e2\u30c7\u30eb\u3092\u9078\u3093\u3067\u958b\u59cb\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.turbospark\uc5d0\uc11c \ub85c\uceec \ubaa8\ub378\uc744 \ucc3e\uc9c0 \ubabb\ud588\uc2b5\ub2c8\ub2e4. \uc544\ub798\uc5d0\uc11c \ucd94\ucc9c \ubaa8\ub378\uc744 \uc120\ud0dd\ud574 \uc2dc\uc791\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen lokale modellen gevonden in ~/.turbospark. Kies hieronder een aanbevolen model om te beginnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono modeli lokalnych w ~/.turbospark. Wybierz poni\u017cej zalecany model, aby zacz\u0105\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum modelo local encontrado em ~/.turbospark. Escolha abaixo um modelo recomendado para come\u00e7ar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u044b\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 \u0432 ~/.turbospark \u043d\u0435 \u043d\u0430\u0439\u0434\u0435\u043d\u044b. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u043d\u0438\u0436\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u0443\u0435\u043c\u0443\u044e \u043c\u043e\u0434\u0435\u043b\u044c, \u0447\u0442\u043e\u0431\u044b \u043d\u0430\u0447\u0430\u0442\u044c."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inga lokala modeller hittades i ~/.turbospark. V\u00e4lj en rekommenderad modell nedan f\u00f6r att komma ig\u00e5ng."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "~/.turbospark i\u00e7inde yerel model bulunamad\u0131. Ba\u015flamak i\u00e7in a\u015fa\u011f\u0131dan \u00f6nerilen bir model se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041b\u043e\u043a\u0430\u043b\u044c\u043d\u0438\u0445 \u043c\u043e\u0434\u0435\u043b\u0435\u0439 \u0443 ~/.turbospark \u043d\u0435 \u0437\u043d\u0430\u0439\u0434\u0435\u043d\u043e. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u043d\u0438\u0436\u0447\u0435 \u0440\u0435\u043a\u043e\u043c\u0435\u043d\u0434\u043e\u0432\u0430\u043d\u0443 \u043c\u043e\u0434\u0435\u043b\u044c, \u0449\u043e\u0431 \u043f\u043e\u0447\u0430\u0442\u0438."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kh\u00f4ng t\u00ecm th\u1ea5y m\u00f4 h\u00ecnh c\u1ee5c b\u1ed9 trong ~/.turbospark. Ch\u1ecdn m\u1ed9t m\u00f4 h\u00ecnh \u0111\u01b0\u1ee3c \u0111\u1ec1 xu\u1ea5t b\u00ean d\u01b0\u1edbi \u0111\u1ec3 b\u1eaft \u0111\u1ea7u."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 ~/.turbospark \u4e2d\u672a\u627e\u5230\u672c\u5730\u6a21\u578b\u3002\u8bf7\u5728\u4e0b\u65b9\u9009\u62e9\u4e00\u4e2a\u63a8\u8350\u6a21\u578b\u5f00\u59cb\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5728 ~/.turbospark \u4e2d\u627e\u4e0d\u5230\u672c\u6a5f\u6a21\u578b\u3002\u8acb\u5728\u4e0b\u65b9\u9078\u64c7\u4e00\u500b\u63a8\u85a6\u6a21\u578b\u958b\u59cb\u3002"
          }
        }
      }
    },
