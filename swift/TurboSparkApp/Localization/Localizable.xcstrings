          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0648\u062c\u062f \u062e\u0627\u062f\u0645 \u0628\u0627\u0633\u0645 '%@' \u0628\u0627\u0644\u0641\u0639\u0644."
