            "state": "translated",
            "value": "Pages load only local files from the artifact's own folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las páginas solo cargan archivos locales de la propia carpeta del artefacto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les pages ne chargent que des fichiers locaux issus du dossier de l'artefact."
          }
