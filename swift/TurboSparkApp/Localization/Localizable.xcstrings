    "This will permanently remove the model files (%@) from disk at:\n%@": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيؤدي هذا إلى إزالة ملفات النموذج (%@) نهائيًا من القرص في:\n%@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden die Modelldateien (%@) dauerhaft von der Festplatte gelöscht unter:\n%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will permanently remove the model files (%@) from disk at:\n%@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto eliminará permanentemente los archivos del modelo (%@) del disco en:\n%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprimera définitivement les fichiers du modèle (%@) du disque à l'emplacement :\n%@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פעולה זו תסיר לצמיתות את קבצי המודל (%@) מהדיסק בכתובת:\n%@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डिस्क से मॉडल फ़ाइलों (%@) को यहाँ से स्थायी रूप से हटा देगा:\n%@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menghapus file model (%@) secara permanen dari disk di:\n%@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciò rimuoverà definitivamente i file del modello (%@) dal disco in:\n%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより、ディスク上の次の場所にあるモデルファイル（%@）が完全に削除されます:\n%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 하면 디스크의 다음 위치에서 모델 파일(%@)이 영구적으로 제거됩니다:\n%@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiermee worden de modelbestanden (%@) permanent van de schijf verwijderd op:\n%@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spowoduje to trwałe usunięcie plików modelu (%@) z dysku w lokalizacji:\n%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso removerá permanentemente os arquivos do modelo (%@) do disco em:\n%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это приведет к безвозвратному удалению файлов модели (%@) с диска по адресу:\n%@"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Detta tar permanent bort modellfilerna (%@) från disken på:\n%@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem, model dosyalarını (%@) şu konumdaki diskten kalıcı olarak kaldıracaktır:\n%@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це назавжди видалить файли моделі (%@) з диска за шляхом:\n%@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác này sẽ xóa vĩnh viễn các tệp mô hình (%@) khỏi đĩa tại:\n%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将从磁盘上的以下位置永久删除模型文件（%@）：\n%@"
