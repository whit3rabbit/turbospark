    "Up/Down to navigate, Enter to open, Esc to close": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0623\u0639\u0644\u0649/\u0623\u0633\u0641\u0644 \u0644\u0644\u062a\u0646\u0642\u0644\u060c Enter \u0644\u0644\u0641\u062a\u062d\u060c Esc \u0644\u0644\u0625\u063a\u0644\u0627\u0642"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf/Ab zum Navigieren, Eingabetaste zum \u00d6ffnen, Esc zum Schlie\u00dfen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Up/Down to navigate, Enter to open, Esc to close"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arriba/Abajo para navegar, Intro para abrir, Esc para cerrar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut/Bas pour naviguer, Entr\u00e9e pour ouvrir, \u00c9chap pour fermer"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05de\u05e2\u05dc\u05d4/\u05dc\u05de\u05d8\u05d4 \u05dc\u05e0\u05d9\u05d5\u05d5\u05d8, Enter \u05dc\u05e4\u05ea\u05d9\u05d7\u05d4, Esc \u05dc\u05e1\u05d2\u05d9\u05e8\u05d4"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0928\u0947\u0935\u093f\u0917\u0947\u091f \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f Up/Down, \u0916\u094b\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f Enter, \u092c\u0902\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f Esc"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Naik/Turun untuk navigasi, Enter untuk membuka, Esc untuk menutup"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su/Gi\u00f9 per spostarsi, Invio per aprire, Esc per chiudere"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0a\u4e0b\u3067\u79fb\u52d5\u3001Enter \u3067\u958b\u304f\u3001Esc \u3067\u9589\u3058\u308b"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc704/\uc544\ub798\ub85c \uc774\ub3d9, Enter\ub85c \uc5f4\uae30, Esc\ub85c \ub2eb\uae30"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omhoog/Omlaag om te navigeren, Enter om te openen, Esc om te sluiten"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "G\u00f3ra/D\u00f3\u0142 do nawigacji, Enter aby otworzy\u0107, Esc aby zamkn\u0105\u0107"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cima/Baixo para navegar, Enter para abrir, Esc para fechar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0432\u0435\u0440\u0445/\u0412\u043d\u0438\u0437 \u2014 \u043d\u0430\u0432\u0438\u0433\u0430\u0446\u0438\u044f, Enter \u2014 \u043e\u0442\u043a\u0440\u044b\u0442\u044c, Esc \u2014 \u0437\u0430\u043a\u0440\u044b\u0442\u044c"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Upp/Ner f\u00f6r att navigera, Enter f\u00f6r att \u00f6ppna, Esc f\u00f6r att st\u00e4nga"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gezinmek i\u00e7in Yukar\u0131/A\u015fa\u011f\u0131, a\u00e7mak i\u00e7in Enter, kapatmak i\u00e7in Esc"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0433\u043e\u0440\u0443/\u0412\u043d\u0438\u0437 \u2014 \u043d\u0430\u0432\u0456\u0433\u0430\u0446\u0456\u044f, Enter \u2014 \u0432\u0456\u0434\u043a\u0440\u0438\u0442\u0438, Esc \u2014 \u0437\u0430\u043a\u0440\u0438\u0442\u0438"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "L\u00ean/Xu\u1ed1ng \u0111\u1ec3 \u0111i\u1ec1u h\u01b0\u1edbng, Enter \u0111\u1ec3 m\u1edf, Esc \u0111\u1ec3 \u0111\u00f3ng"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0a/\u4e0b\u952e\u5bfc\u822a\uff0c\u56de\u8f66\u6253\u5f00\uff0cEsc \u5173\u95ed"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u4e0a/\u4e0b\u9375\u5c0e\u89bd\uff0cEnter \u958b\u555f\uff0cEsc \u95dc\u9589"
          }
        }
      }
    },
