        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d9\u05d9\u05df \u05d1\u05de\u05e8\u05db\u05d6 \u05d0\u05d5 \u05d4\u05d5\u05e1\u05e3 \u05ea\u05d9\u05e7\u05d9\u05d9\u05d4 \u05de\u05e7\u05d5\u05de\u05d9\u05ea \u05e9\u05de\u05db\u05d9\u05dc\u05d4 \u200e.claude-plugin/plugin.json."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092e\u093e\u0930\u094d\u0915\u0947\u091f\u092a\u094d\u0932\u0947\u0938 \u092c\u094d\u0930\u093e\u0909\u091c\u093c \u0915\u0930\u0947\u0902, \u092f\u093e .claude-plugin/plugin.json \u0935\u093e\u0932\u093e \u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092b\u093c\u094b\u0932\u094d\u0921\u0930 \u091c\u094b\u0921\u093c\u0947\u0902\u0964"
          }
        },
        "id": {
