    "This library has no large model file to read yet. Install a model on it, then test again.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تحتوي هذه المكتبة على ملف نموذج كبير للقراءة بعد. ثبّت نموذجًا عليها ثم أعد الاختبار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Bibliothek enthält noch keine große Modelldatei zum Lesen. Installieren Sie ein Modell darauf und testen Sie dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This library has no large model file to read yet. Install a model on it, then test again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca aún no tiene ningún archivo de modelo grande que leer. Instala un modelo en ella y vuelve a probar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette bibliothèque ne contient pas encore de gros fichier de modèle à lire. Installez-y un modèle, puis relancez le test."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בספרייה הזו עדיין אין קובץ מודל גדול לקריאה. התקן בה מודל ובדוק שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस लाइब्रेरी में पढ़ने के लिए अभी कोई बड़ी मॉडल फ़ाइल नहीं है। इसमें कोई मॉडल इंस्टॉल करें, फिर दोबारा जांचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pustaka ini belum memiliki file model besar untuk dibaca. Instal model di dalamnya, lalu uji lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa libreria non contiene ancora un file di modello grande da leggere. Installa un modello al suo interno, poi riprova il test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このライブラリには、読み取れる大きなモデルファイルがまだありません。モデルをインストールしてから、もう一度テストしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 라이브러리에는 읽을 수 있는 큰 모델 파일이 아직 없습니다. 모델을 설치한 다음 다시 테스트하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze bibliotheek bevat nog geen groot modelbestand om te lezen. Installeer er een model op en test opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta biblioteka nie ma jeszcze dużego pliku modelu do odczytu. Zainstaluj w niej model i przetestuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta biblioteca ainda não tem um arquivo de modelo grande para ler. Instale um modelo nela e teste novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В этой библиотеке пока нет большого файла модели для чтения. Установите в неё модель и повторите проверку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det här biblioteket har ännu ingen stor modellfil att läsa. Installera en modell i det och testa igen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kitaplıkta henüz okunacak büyük bir model dosyası yok. İçine bir model yükleyin, ardından yeniden test edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У цій бібліотеці ще немає великого файлу моделі для читання. Установіть у неї модель і повторіть перевірку."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư viện này chưa có tệp mô hình lớn nào để đọc. Hãy cài một mô hình vào đó rồi kiểm tra lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型库中还没有可供读取的大型模型文件。请先在其中安装一个模型，然后再次测试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此模型庫中還沒有可供讀取的大型模型檔案。請先在其中安裝一個模型，然後再次測試。"
          }
        }
      }
    },
    "This model family does not support live steering.": {
      "extractionState": "manual",
