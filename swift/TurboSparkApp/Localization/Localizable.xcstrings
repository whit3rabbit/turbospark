        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "SOUL.md van %@ ge\u00efmporteerd. Schakel SOUL.md in om het te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaimportowano SOUL.md z %@. W\u0142\u0105cz SOUL.md, aby go u\u017cywa\u0107."
