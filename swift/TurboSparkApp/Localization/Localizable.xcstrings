    "Anthropic-native. Overrides stale saved gateway settings; starts with the loaded model.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متوافق أصلًا مع Anthropic. يتجاوز إعدادات البوابة القديمة المحفوظة ويبدأ بالنموذج المحمّل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativ für Anthropic. Überschreibt veraltete gespeicherte Gateway-Einstellungen und startet mit dem geladenen Modell."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic-native. Overrides stale saved gateway settings; starts with the loaded model."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativo de Anthropic. Sustituye la configuración de pasarela guardada y obsoleta; empieza con el modelo cargado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Natif Anthropic. Remplace les anciens réglages de passerelle enregistrés ; démarre avec le modèle chargé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תואם Anthropic באופן מקורי. עוקף הגדרות שער שמורות שאינן עדכניות; מתחיל עם המודל הטעון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic-नेटिव। पुरानी सहेजी गई गेटवे सेटिंग्स को बदल देता है; लोड किए गए मॉडल के साथ शुरू होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Native Anthropic. Menimpa pengaturan gateway tersimpan yang usang; dimulai dengan model yang dimuat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativo Anthropic. Sostituisce le impostazioni del gateway salvate e obsolete; si avvia con il modello caricato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic ネイティブ。保存済みの古いゲートウェイ設定を上書きし、読み込み済みのモデルで起動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic 네이티브. 저장된 오래된 게이트웨이 설정을 덮어쓰고 로드된 모델로 시작합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic-native. Overschrijft verouderde opgeslagen gatewayinstellingen; start met het geladen model."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natywnie zgodny z Anthropic. Zastępuje nieaktualne zapisane ustawienia bramy; uruchamia się z załadowanym modelem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nativo da Anthropic. Substitui configurações de gateway salvas e desatualizadas; inicia com o modelo carregado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативно для Anthropic. Переопределяет устаревшие сохранённые настройки шлюза; запускается с загруженной моделью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic-nativ. Ersätter gamla sparade gateway-inställningar och startar med den inlästa modellen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic'e özgü. Eski kayıtlı ağ geçidi ayarlarını geçersiz kılar; yüklü modelle başlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нативно для Anthropic. Перевизначає застарілі збережені налаштування шлюзу; запускається із завантаженою моделлю."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tương thích gốc với Anthropic. Ghi đè cài đặt cổng đã lưu cũ; khởi động với mô hình đã tải."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic 原生。会覆盖已保存的过时网关设置，并以已加载的模型启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Anthropic 原生。會覆寫已儲存的過時閘道設定，並以已載入的模型啟動。"
          }
        }
      }
    },
