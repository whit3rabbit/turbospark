            "value": "Messages, \u05e2\u05dd \u05db\u05dc\u05d9\u05dd, \u05d7\u05e9\u05d9\u05d1\u05d4 \u05d5\u05ea\u05de\u05d5\u05e0\u05d5\u05ea."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u091f\u0942\u0932, \u0925\u093f\u0902\u0915\u093f\u0902\u0917 \u0914\u0930 \u0907\u092e\u0947\u091c \u0915\u0947 \u0938\u093e\u0925 Messages\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, dengan alat, pemikiran, dan gambar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Messages, con strumenti, ragionamento e immagini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u30c4\u30fc\u30eb\u3001\u601d\u8003\u3001\u753b\u50cf\u306b\u5bfe\u5fdc\u3057\u305f Messages\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ub3c4\uad6c, \uc0ac\uace0, \uc774\ubbf8\uc9c0\ub97c \uc9c0\uc6d0\ud558\ub294 Messages."
          }
        },
        "nl": {
          "stringUnit": {
