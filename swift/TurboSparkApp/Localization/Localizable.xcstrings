    "Refused even if the allowlist would permit them.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرفض حتى لو سمحت بها قائمة السماح."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden abgelehnt, selbst wenn die Zulassungsliste sie erlauben würde."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refused even if the allowlist would permit them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se rechazan aunque la lista de permitidos los autorizara."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refusés même si la liste d'autorisation les permettrait."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נדחים גם אם רשימת ההיתר הייתה מתירה אותם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमत-सूची द्वारा अनुमति दिए जाने पर भी अस्वीकार किए जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ditolak meskipun daftar izin mengizinkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rifiutati anche se l'elenco consentito li permetterebbe."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "許可リストで認められている場合でも拒否されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "허용 목록이 허가하더라도 거부됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Worden geweigerd, zelfs als de toegestane lijst ze zou toelaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrzucane, nawet jeśli lista dozwolonych by je przepuściła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Recusados mesmo que a lista de permitidos os autorize."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отклоняются, даже если список разрешений их допускает."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Nekas även om tillåtelselistan skulle tillåta dem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin listesi izin verse bile reddedilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відхиляються, навіть якщо список дозволів їх допускає."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bị từ chối ngay cả khi danh sách cho phép chấp nhận chúng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使允许名单会放行，也会被拒绝。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使允許清單會放行，也會被拒絕。"
          }
        }
      }
    },
