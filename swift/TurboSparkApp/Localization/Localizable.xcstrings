    "System audio could not be read. Stop and select the source again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio could not be read. Stop and select the source again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer el audio del sistema. Detén la grabación y vuelve a seleccionar la fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire l'audio système. Arrêtez l'enregistrement et sélectionnez à nouveau la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Systemaudio konnte nicht gelesen werden. Stoppe die Aufnahme und wähle die Quelle erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere l'audio di sistema. Interrompi e seleziona nuovamente la sorgente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler o áudio do sistema. Pare e selecione a fonte novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeemaudio kon niet worden gelezen. Stop en selecteer de bron opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemljudet kunde inte läsas. Stoppa och välj källan igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać dźwięku systemowego. Zatrzymaj nagrywanie i ponownie wybierz źródło."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem sesi okunamadı. Durdurun ve kaynağı yeniden seçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio sistem tidak dapat dibaca. Hentikan dan pilih sumber kembali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось прочитать системный звук. Остановите запись и выберите источник снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося прочитати системний звук. Зупиніть запис і виберіть джерело знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể đọc âm thanh hệ thống. Dừng và chọn lại nguồn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム音声を読み取れませんでした。停止してソースを選択し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 오디오를 읽을 수 없습니다. 중지한 후 소스를 다시 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取系统音频。请停止并重新选择来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取系統音訊。請停止並重新選擇來源。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة صوت النظام. أوقف التسجيل وحدد المصدر مجدداً."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לקרוא את שמע המערכת. עצור ובחר שוב את המקור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम ऑडियो पढ़ा नहीं जा सका। रोकें और स्रोत फिर चुनें।"
          }
        }
      }
    },
    "System audio returned an invalid buffer. Stop and select the source again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System audio returned an invalid buffer. Stop and select the source again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El audio del sistema devolvió un búfer no válido. Detén la grabación y vuelve a seleccionar la fuente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio système a renvoyé un tampon invalide. Arrêtez l'enregistrement et sélectionnez à nouveau la source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Systemaudio hat einen ungültigen Puffer geliefert. Stoppe die Aufnahme und wähle die Quelle erneut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'audio di sistema ha restituito un buffer non valido. Interrompi e seleziona nuovamente la sorgente."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O áudio do sistema retornou um buffer inválido. Pare e selecione a fonte novamente."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Systeemaudio heeft een ongeldige buffer geleverd. Stop en selecteer de bron opnieuw."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Systemljudet returnerade en ogiltig buffert. Stoppa och välj källan igen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dźwięk systemowy zwrócił nieprawidłowy bufor. Zatrzymaj nagrywanie i ponownie wybierz źródło."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sistem sesi geçersiz bir arabellek döndürdü. Durdurun ve kaynağı yeniden seçin."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Audio sistem mengembalikan buffer tidak valid. Hentikan dan pilih sumber kembali."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Системный звук вернул недопустимый буфер. Остановите запись и выберите источник снова."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Системний звук повернув недопустимий буфер. Зупиніть запис і виберіть джерело знову."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Âm thanh hệ thống trả về bộ đệm không hợp lệ. Dừng và chọn lại nguồn."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "システム音声から無効なバッファが返されました。停止してソースを選択し直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시스템 오디오가 잘못된 버퍼를 반환했습니다. 중지한 후 소스를 다시 선택하세요."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "系统音频返回了无效的缓冲区。请停止并重新选择来源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "系統音訊傳回了無效的緩衝區。請停止並重新選擇來源。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد صوت النظام مخزناً مؤقتاً غير صالح. أوقف التسجيل وحدد المصدر مجدداً."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמע המערכת החזיר מאגר לא תקין. עצור ובחר שוב את המקור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिस्टम ऑडियो ने अमान्य बफ़र लौटाया। रोकें और स्रोत फिर चुनें।"
          }
        }
      }
    },
