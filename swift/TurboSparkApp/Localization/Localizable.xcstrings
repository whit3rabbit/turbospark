        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0110\u00e3 c\u00f3 t\u1ec7p t\u00e1c t\u1eed t\u00ean '%@'. H\u00e3y \u0111\u1ed5i t\u00ean t\u00e1c t\u1eed m\u1edbi ho\u1eb7c x\u00f3a t\u1ec7p c\u0169 tr\u01b0\u1edbc."
