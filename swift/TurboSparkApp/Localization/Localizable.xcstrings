    "Install models locally from the curated catalog or Hugging Face.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install models locally from the curated catalog or Hugging Face."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala modelos localmente desde el catálogo curado o desde Hugging Face."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez des modèles en local depuis le catalogue sélectionné ou depuis Hugging Face."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie Modelle lokal aus dem kuratierten Katalog oder von Hugging Face."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa modelli in locale dal catalogo curato o da Hugging Face."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale modelos localmente a partir do catálogo curado ou do Hugging Face."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливайте модели локально из курируемого каталога или с Hugging Face."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳選カタログまたは Hugging Face からモデルをローカルにインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선별된 카탈로그나 Hugging Face에서 모델을 로컬에 설치합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从精选目录或 Hugging Face 在本地安装模型。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從精選目錄或 Hugging Face 在本機安裝模型。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت النماذج محليا من الكتالوج المنسق أو من Hugging Face."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקן מודלים מקומית מהקטלוג האצור או מ-Hugging Face."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्यूरेटेड कैटलॉग या Hugging Face से मॉडल स्थानीय रूप से इंस्टॉल करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer modellen lokaal vanuit de samengestelde catalogus of vanaf Hugging Face."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluj modele lokalnie z wyselekcjonowanego katalogu lub z Hugging Face."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modelleri seçilmiş katalogdan veya Hugging Face'ten yerel olarak kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлюйте моделі локально з добірного каталогу або з Hugging Face."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera modeller lokalt från den kurerade katalogen eller från Hugging Face."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt mô hình cục bộ từ danh mục tuyển chọn hoặc từ Hugging Face."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasang model secara lokal dari katalog kurasi atau Hugging Face."
          }
        }
      }
    },
    "Install servers from a catalog published in a Git repository or a local folder.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install servers from a catalog published in a Git repository or a local folder."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Instala servidores desde un catálogo publicado en un repositorio de Git o en una carpeta local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez des serveurs depuis un catalogue publié dans un dépôt Git ou un dossier local."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Installieren Sie Server aus einem Katalog, der in einem Git-Repository oder einem lokalen Ordner veröffentlicht ist."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Installa server da un catalogo pubblicato in un repository Git o in una cartella locale."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Instale servidores a partir de um catálogo publicado em um repositório Git ou em uma pasta local."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Устанавливайте серверы из каталога, опубликованного в репозитории Git или в локальной папке."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Git リポジトリまたはローカルフォルダに公開されたカタログからサーバーをインストールします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Git 리포지토리나 로컬 폴더에 게시된 카탈로그에서 서버를 설치합니다."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从发布在 Git 仓库或本地文件夹中的目录安装服务器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "從發布在 Git 儲存庫或本機資料夾中的目錄安裝伺服器。"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ثبّت الخوادم من كتالوج منشور في مستودع Git أو مجلد محلي."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התקן שרתים מקטלוג שפורסם במאגר Git או בתיקייה מקומית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Git रिपॉजिटरी या स्थानीय फ़ोल्डर में प्रकाशित कैटलॉग से सर्वर इंस्टॉल करें।"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Installeer servers vanuit een catalogus die is gepubliceerd in een Git-repository of een lokale map."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Instaluj serwery z katalogu opublikowanego w repozytorium Git lub w folderze lokalnym."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir Git deposunda veya yerel klasörde yayımlanmış bir katalogdan sunucu kurun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Встановлюйте сервери з каталогу, опублікованого в репозиторії Git або в локальній папці."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Installera servrar från en katalog som publicerats i en Git-utvecklingskatalog eller en lokal mapp."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cài đặt máy chủ từ danh mục được công bố trong kho Git hoặc thư mục cục bộ."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
