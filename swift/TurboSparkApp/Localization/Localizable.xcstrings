            "value": "\u05d6\u05db\u05d5\u05e8 \u05de\u05e4\u05ea\u05d7 \u05d6\u05d4 \u05d1\u05de\u05d7\u05d6\u05d9\u05e7 \u05d4\u05de\u05e4\u05ea\u05d7\u05d5\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
