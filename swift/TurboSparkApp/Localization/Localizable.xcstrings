    "Approving runs this server's commands on this machine. Auto-approval stays off: tool calls still ask unless you opt in later.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تؤدي الموافقة إلى تشغيل أوامر هذا الخادم على هذا الجهاز. تبقى الموافقة التلقائية معطلة: ستظل استدعاءات الأدوات تطلب التأكيد ما لم تفعّلها لاحقا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durch Genehmigen werden die Befehle dieses Servers auf diesem Rechner ausgeführt. Die automatische Genehmigung bleibt aus: Tool-Aufrufe fragen weiterhin nach, sofern Sie sie nicht später aktivieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approving runs this server's commands on this machine. Auto-approval stays off: tool calls still ask unless you opt in later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprobar ejecuta los comandos de este servidor en este equipo. La aprobación automática sigue desactivada: las llamadas a herramientas seguirán pidiendo confirmación salvo que la actives más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Approuver exécute les commandes de ce serveur sur cette machine. L'approbation automatique reste désactivée : les appels d'outils continueront de demander confirmation tant que vous ne l'activez pas."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אישור מריץ את הפקודות של השרת הזה במחשב הזה. אישור אוטומטי נשאר כבוי: קריאות לכלים ימשיכו לבקש אישור עד שתפעיל אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुमोदन करने पर इस सर्वर के कमांड इस मशीन पर चलते हैं। स्वतः-अनुमोदन बंद रहता है: जब तक आप बाद में इसे चालू नहीं करते, टूल कॉल हर बार पूछेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menyetujui akan menjalankan perintah server ini di komputer ini. Persetujuan otomatis tetap nonaktif: panggilan alat tetap meminta konfirmasi kecuali Anda mengaktifkannya nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Approvando esegui i comandi di questo server su questo computer. L'approvazione automatica resta disattivata: le chiamate agli strumenti continueranno a chiedere conferma finché non la attivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "承認すると、このサーバーのコマンドがこのマシンで実行されます。自動承認はオフのままです。後で有効にしない限り、ツール呼び出しは毎回確認を求めます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "승인하면 이 서버의 명령이 이 컴퓨터에서 실행됩니다. 자동 승인은 꺼진 상태로 유지되며, 나중에 켜지 않는 한 도구 호출은 계속 확인을 요청합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Goedkeuren voert de opdrachten van deze server uit op deze computer. Automatisch goedkeuren blijft uit: tool-aanroepen blijven om bevestiging vragen tenzij u dit later inschakelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatwierdzenie uruchamia polecenia tego serwera na tym komputerze. Automatyczne zatwierdzanie pozostaje wyłączone: wywołania narzędzi nadal będą pytać, dopóki go nie włączysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Aprovar executa os comandos deste servidor nesta máquina. A aprovação automática continua desativada: as chamadas de ferramentas ainda pedem confirmação até que você a ative."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одобрение запускает команды этого сервера на этом компьютере. Автоодобрение остается выключенным: вызовы инструментов по-прежнему будут запрашивать подтверждение, пока вы его не включите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Att godkänna kör serverns kommandon på den här datorn. Automatiskt godkännande förblir avstängt: verktygsanrop frågar fortfarande om du inte aktiverar det senare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamak, bu sunucunun komutlarını bu makinede çalıştırır. Otomatik onay kapalı kalır: daha sonra açmadığınız sürece araç çağrıları yine de sorar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Схвалення запускає команди цього сервера на цьому комп'ютері. Автосхвалення залишається вимкненим: виклики інструментів і надалі запитуватимуть підтвердження, доки ви його не ввімкнете."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phê duyệt sẽ chạy các lệnh của máy chủ này trên máy tính này. Tự động phê duyệt vẫn tắt: các lệnh gọi công cụ vẫn hỏi trừ khi bạn bật sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "批准后将在本机上运行该服务器的命令。自动批准仍为关闭状态: 除非你之后选择启用，否则工具调用仍会询问。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核准後將在本機執行該伺服器的指令。自動核准仍為關閉狀態: 除非你之後選擇啟用，否則工具呼叫仍會詢問。"
          }
        }
      }
    },
    "Approximate timing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
