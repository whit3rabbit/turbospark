            "value": "\u65e0\u6cd5\u5206\u79bb\u8bed\u97f3\u5408\u6210\u6a21\u578b\uff1a%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u7121\u6cd5\u5206\u96e2\u8a9e\u97f3\u5408\u6210\u6a21\u578b\uff1a%@"
          }
        }
