    "Useful for regions with restricted Hugging Face access, e.g. https://hf-mirror.com": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفيد في المناطق التي يكون فيها الوصول إلى Hugging Face مقيدا، مثل https://hf-mirror.com"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nützlich in Regionen mit eingeschränktem Zugriff auf Hugging Face, z. B. https://hf-mirror.com"
          }
        },
