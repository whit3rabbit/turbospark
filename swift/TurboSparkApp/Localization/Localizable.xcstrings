    "Files are collapsed for large diffs. Select a file to expand it.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u062a\u064f\u0637\u0648\u0649 \u0627\u0644\u0645\u0644\u0641\u0627\u062a \u0639\u0646\u062f \u0648\u062c\u0648\u062f \u0641\u0631\u0648\u0642 \u0643\u0628\u064a\u0631\u0629. \u0627\u062e\u062a\u0631 \u0645\u0644\u0641\u0627 \u0644\u062a\u0648\u0633\u064a\u0639\u0647."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei gro\u00dfen Diffs werden Dateien eingeklappt. W\u00e4hlen Sie eine Datei aus, um sie aufzuklappen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are collapsed for large diffs. Select a file to expand it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos se contraen en diferencias grandes. Selecciona un archivo para expandirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers sont r\u00e9duits pour les grandes diff\u00e9rences. S\u00e9lectionnez un fichier pour le d\u00e9velopper."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e7\u05d1\u05e6\u05d9\u05dd \u05de\u05db\u05d5\u05d5\u05e6\u05d9\u05dd \u05db\u05d0\u05e9\u05e8 \u05d4\u05d4\u05d1\u05d3\u05dc\u05d9\u05dd \u05d2\u05d3\u05d5\u05dc\u05d9\u05dd. \u05d1\u05d7\u05e8 \u05e7\u05d5\u05d1\u05e5 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e8\u05d7\u05d9\u05d1 \u05d0\u05d5\u05ea\u05d5."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u092c\u0921\u093c\u0947 \u0921\u093f\u092b\u093c \u092e\u0947\u0902 \u092b\u093c\u093e\u0907\u0932\u0947\u0902 \u0938\u0902\u0915\u094d\u0937\u093f\u092a\u094d\u0924 \u0930\u0939\u0924\u0940 \u0939\u0948\u0902\u0964 \u0935\u093f\u0938\u094d\u0924\u0943\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092b\u093c\u093e\u0907\u0932 \u091a\u0941\u0928\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berkas diciutkan untuk perbedaan besar. Pilih berkas untuk memperluasnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per differenze estese i file sono compressi. Seleziona un file per espanderlo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5dee\u5206\u304c\u5927\u304d\u3044\u5834\u5408\u3001\u30d5\u30a1\u30a4\u30eb\u306f\u6298\u308a\u305f\u305f\u307e\u308c\u307e\u3059\u3002\u5c55\u958b\u3059\u308b\u306b\u306f\u30d5\u30a1\u30a4\u30eb\u3092\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\ucc28\uc774\uac00 \ud070 \uacbd\uc6b0 \ud30c\uc77c\uc774 \uc811\ud600 \uc788\uc2b5\ub2c8\ub2e4. \ud3bc\uce58\ub824\uba74 \ud30c\uc77c\uc744 \uc120\ud0dd\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bij grote verschillen worden bestanden ingeklapt. Selecteer een bestand om het uit te klappen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy du\u017cych r\u00f3\u017cnicach pliki s\u0105 zwini\u0119te. Wybierz plik, aby go rozwin\u0105\u0107."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os arquivos ficam recolhidos em diferen\u00e7as grandes. Selecione um arquivo para expandi-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041f\u0440\u0438 \u0431\u043e\u043b\u044c\u0448\u0438\u0445 \u0440\u0430\u0437\u043b\u0438\u0447\u0438\u044f\u0445 \u0444\u0430\u0439\u043b\u044b \u0441\u0432\u0435\u0440\u043d\u0443\u0442\u044b. \u0412\u044b\u0431\u0435\u0440\u0438\u0442\u0435 \u0444\u0430\u0439\u043b, \u0447\u0442\u043e\u0431\u044b \u0440\u0430\u0437\u0432\u0435\u0440\u043d\u0443\u0442\u044c \u0435\u0433\u043e."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Filer f\u00e4lls ihop vid stora skillnader. V\u00e4lj en fil f\u00f6r att expandera den."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "B\u00fcy\u00fck farklarda dosyalar daralt\u0131l\u0131r. Geni\u015fletmek i\u00e7in bir dosya se\u00e7in."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0417\u0430 \u0432\u0435\u043b\u0438\u043a\u0438\u0445 \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u0441\u0442\u0435\u0439 \u0444\u0430\u0439\u043b\u0438 \u0437\u0433\u043e\u0440\u043d\u0443\u0442\u043e. \u0412\u0438\u0431\u0435\u0440\u0456\u0442\u044c \u0444\u0430\u0439\u043b, \u0449\u043e\u0431 \u0440\u043e\u0437\u0433\u043e\u0440\u043d\u0443\u0442\u0438 \u0439\u043e\u0433\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "C\u00e1c t\u1ec7p \u0111\u01b0\u1ee3c thu g\u1ecdn khi kh\u00e1c bi\u1ec7t l\u1edbn. Ch\u1ecdn m\u1ed9t t\u1ec7p \u0111\u1ec3 m\u1edf r\u1ed9ng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5dee\u5f02\u8f83\u5927\u65f6\u6587\u4ef6\u4f1a\u6298\u53e0\u3002\u9009\u62e9\u6587\u4ef6\u5373\u53ef\u5c55\u5f00\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5dee\u7570\u8f03\u5927\u6642\u6a94\u6848\u6703\u6298\u758a\u3002\u9078\u53d6\u6a94\u6848\u5373\u53ef\u5c55\u958b\u3002"
          }
        }
      }
    },
