    "Shortcuts are fixed. There is no rebinding in this version.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاختصارات ثابتة. لا يمكن إعادة تعيينها في هذا الإصدار."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kurzbefehle sind fest. In dieser Version ist keine Neubelegung möglich."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shortcuts are fixed. There is no rebinding in this version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los atajos son fijos. En esta versión no se pueden reasignar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les raccourcis sont fixes. Aucune réaffectation n'est possible dans cette version."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קיצורי הדרך קבועים. אין אפשרות לשנות אותם בגרסה הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "शॉर्टकट निश्चित हैं। इस संस्करण में इन्हें बदला नहीं जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pintasan bersifat tetap. Tidak ada pengubahan pada versi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le scorciatoie sono fisse. In questa versione non è possibile riassegnarle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ショートカットは固定です。このバージョンでは再割り当てできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단축키는 고정되어 있습니다. 이 버전에서는 재지정할 수 없습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De sneltoetsen liggen vast. In deze versie is opnieuw toewijzen niet mogelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skróty są stałe. W tej wersji nie można ich zmieniać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os atalhos são fixos. Não há reatribuição nesta versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетания клавиш фиксированы. В этой версии их нельзя переназначить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kortkommandona är fasta. Det går inte att ändra dem i den här versionen."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısayollar sabittir. Bu sürümde yeniden atama yapılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Комбінації клавіш фіксовані. У цій версії їх не можна перепризначити."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các phím tắt là cố định. Phiên bản này không hỗ trợ gán lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "快捷键是固定的。此版本不支持重新绑定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
