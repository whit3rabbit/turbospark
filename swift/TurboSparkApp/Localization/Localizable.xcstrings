        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05d0\u05e8 \u05e8\u05d9\u05e7 \u05db\u05d3\u05d9 \u05dc\u05d4\u05e4\u05e2\u05d9\u05dc \u05d0\u05ea \u05d4\u05e9\u05e8\u05ea \u05d1\u05ea\u05d9\u05e7\u05d9\u05d9\u05ea \u05d4\u05e9\u05d5\u05e8\u05e9 \u05e9\u05dc \u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05d4\u05e4\u05e2\u05d9\u05dc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u0915\u094d\u0930\u093f\u092f \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u0915\u0940 \u0930\u0942\u091f \u092e\u0947\u0902 \u0938\u0930\u094d\u0935\u0930 \u0936\u0941\u0930\u0942 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0916\u093e\u0932\u0940 \u091b\u094b\u0921\u093c\u0947\u0902\u0964"
