            "value": "Chuy\u1ec3n ti\u1ebfp bi\u1ebfn m\u00f4i tr\u01b0\u1eddng (m\u1ed7i d\u00f2ng m\u1ed9t T\u00caN bi\u1ebfn)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u73af\u5883\u53d8\u91cf\u900f\u4f20 (\u6bcf\u884c\u4e00\u4e2a\u53d8\u91cf\u540d)"
          }
        },
        "zh-Hant": {
