    "Rescans local model directories and reloads recommendations": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u064a\u0639\u064a\u062f \u0641\u062d\u0635 \u0645\u062c\u0644\u062f\u0627\u062a \u0627\u0644\u0646\u0645\u0627\u0630\u062c \u0627\u0644\u0645\u062d\u0644\u064a\u0629 \u0648\u064a\u0639\u064a\u062f \u062a\u062d\u0645\u064a\u0644 \u0627\u0644\u062a\u0648\u0635\u064a\u0627\u062a"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Durchsucht lokale Modellordner erneut und l\u00e4dt die Empfehlungen neu"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rescans local model directories and reloads recommendations"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a escanear los directorios de modelos locales y recarga las recomendaciones"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "R\u00e9analyse les dossiers de mod\u00e8les locaux et recharge les recommandations"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e1\u05d5\u05e8\u05e7 \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05ea\u05d9\u05e7\u05d9\u05d5\u05ea \u05d4\u05de\u05d5\u05d3\u05dc\u05d9\u05dd \u05d4\u05de\u05e7\u05d5\u05de\u05d9\u05d5\u05ea \u05d5\u05d8\u05d5\u05e2\u05df \u05de\u05d7\u05d3\u05e9 \u05d0\u05ea \u05d4\u05d4\u05de\u05dc\u05e6\u05d5\u05ea"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0938\u094d\u0925\u093e\u0928\u0940\u092f \u092e\u0949\u0921\u0932 \u0928\u093f\u0930\u094d\u0926\u0947\u0936\u093f\u0915\u093e\u0913\u0902 \u0915\u094b \u092b\u093f\u0930 \u0938\u0947 \u0938\u094d\u0915\u0948\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0905\u0928\u0941\u0936\u0902\u0938\u093e\u090f\u0902 \u092b\u093f\u0930 \u0938\u0947 \u0932\u094b\u0921 \u0915\u0930\u0924\u093e \u0939\u0948"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Memindai ulang direktori model lokal dan memuat ulang rekomendasi"
          }
        },
        "it": {
          "stringUnit": {
