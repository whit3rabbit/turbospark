          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Restaurar fonte herdada"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u043e\u0441\u0441\u0442\u0430\u043d\u043e\u0432\u0438\u0442\u044c \u0443\u043d\u0430\u0441\u043b\u0435\u0434\u043e\u0432\u0430\u043d\u043d\u044b\u0439 \u0438\u0441\u0442\u043e\u0447\u043d\u0438\u043a"
          }
        },
        "sv": {
          "stringUnit": {
