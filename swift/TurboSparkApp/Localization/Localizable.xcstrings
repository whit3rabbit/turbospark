          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u8981\u7d20\u306f\u5909\u66f4\u3055\u308c\u307e\u3057\u305f\u3002\u3082\u3046\u4e00\u5ea6\u9078\u629e\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
