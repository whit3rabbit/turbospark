    "This saved image has no request metadata to regenerate.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0627 \u062a\u062d\u062a\u0648\u064a \u0647\u0630\u0647 \u0627\u0644\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u062d\u0641\u0648\u0638\u0629 \u0639\u0644\u0649 \u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0635\u0641\u064a\u0629 \u0644\u0644\u0637\u0644\u0628 \u0644\u0625\u0639\u0627\u062f\u0629 \u0625\u0646\u0634\u0627\u0626\u0647\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses gespeicherte Bild enth\u00e4lt keine Anfrage-Metadaten zum Neugenerieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This saved image has no request metadata to regenerate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagen guardada no tiene metadatos de solicitud para regenerarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette image enregistr\u00e9e ne contient aucune m\u00e9tadonn\u00e9e de requ\u00eate pour la r\u00e9g\u00e9n\u00e9rer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05dc\u05ea\u05de\u05d5\u05e0\u05d4 \u05d4\u05e9\u05de\u05d5\u05e8\u05d4 \u05d4\u05d6\u05d5 \u05d0\u05d9\u05df \u05de\u05d8\u05d0-\u05e0\u05ea\u05d5\u05e0\u05d9 \u05d1\u05e7\u05e9\u05d4 \u05dc\u05d9\u05e6\u05d9\u05e8\u05d4 \u05de\u05d7\u05d3\u05e9."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0907\u0938 \u0938\u0939\u0947\u091c\u0940 \u0917\u0908 \u091b\u0935\u093f \u092e\u0947\u0902 \u092a\u0941\u0928\u0903 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0928\u0941\u0930\u094b\u0927 \u092e\u0947\u091f\u093e\u0921\u0947\u091f\u093e \u0928\u0939\u0940\u0902 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar tersimpan ini tidak memiliki metadata permintaan untuk dibuat ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa immagine salvata non ha metadati della richiesta per rigenerarla."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u3053\u306e\u4fdd\u5b58\u6e08\u307f\u753b\u50cf\u306b\u306f\u3001\u518d\u751f\u6210\u306b\u5fc5\u8981\u306a\u30ea\u30af\u30a8\u30b9\u30c8\u30e1\u30bf\u30c7\u30fc\u30bf\u304c\u3042\u308a\u307e\u305b\u3093\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc774 \uc800\uc7a5\ub41c \uc774\ubbf8\uc9c0\uc5d0\ub294 \ub2e4\uc2dc \uc0dd\uc131\ud560 \uc694\uccad \uba54\ud0c0\ub370\uc774\ud130\uac00 \uc5c6\uc2b5\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze opgeslagen afbeelding heeft geen aanvraagmetadata om opnieuw te genereren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zapisany obraz nie ma metadanych \u017c\u0105dania potrzebnych do ponownego wygenerowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta imagem salva n\u00e3o tem metadados de solicita\u00e7\u00e3o para gerar novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0423 \u044d\u0442\u043e\u0433\u043e \u0441\u043e\u0445\u0440\u0430\u043d\u0435\u043d\u043d\u043e\u0433\u043e \u0438\u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u0438\u044f \u043d\u0435\u0442 \u043c\u0435\u0442\u0430\u0434\u0430\u043d\u043d\u044b\u0445 \u0437\u0430\u043f\u0440\u043e\u0441\u0430 \u0434\u043b\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0439 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0438\u0438."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den h\u00e4r sparade bilden saknar beg\u00e4randemetadata f\u00f6r att genereras om."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kay\u0131tl\u0131 g\u00f6r\u00fcnt\u00fcde yeniden olu\u015fturmak i\u00e7in istek meta verisi yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0426\u0435 \u0437\u0431\u0435\u0440\u0435\u0436\u0435\u043d\u0435 \u0437\u043e\u0431\u0440\u0430\u0436\u0435\u043d\u043d\u044f \u043d\u0435 \u043c\u0430\u0454 \u043c\u0435\u0442\u0430\u0434\u0430\u043d\u0438\u0445 \u0437\u0430\u043f\u0438\u0442\u0443 \u0434\u043b\u044f \u043f\u043e\u0432\u0442\u043e\u0440\u043d\u043e\u0457 \u0433\u0435\u043d\u0435\u0440\u0430\u0446\u0456\u0457."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00ecnh \u1ea3nh \u0111\u00e3 l\u01b0u n\u00e0y kh\u00f4ng c\u00f3 si\u00eau d\u1eef li\u1ec7u y\u00eau c\u1ea7u \u0111\u1ec3 t\u1ea1o l\u1ea1i."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u5df2\u4fdd\u5b58\u56fe\u50cf\u6ca1\u6709\u53ef\u7528\u4e8e\u91cd\u65b0\u751f\u6210\u7684\u8bf7\u6c42\u5143\u6570\u636e\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u6b64\u5df2\u5132\u5b58\u5f71\u50cf\u6c92\u6709\u53ef\u7528\u65bc\u91cd\u65b0\u7522\u751f\u7684\u8acb\u6c42\u4e2d\u7e7c\u8cc7\u6599\u3002"
          }
        }
      }
    },
