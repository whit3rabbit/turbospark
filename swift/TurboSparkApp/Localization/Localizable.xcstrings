            "value": "Geen overeenkomende goedgekeurde herinneringen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak pasuj\u0105cych zatwierdzonych wpis\u00f3w pami\u0119ci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma mem\u00f3ria aprovada correspondente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u041d\u0435\u0442 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0445 \u043e\u0434\u043e\u0431\u0440\u0435\u043d\u043d\u044b\u0445 \u0437\u0430\u043f\u0438\u0441\u0435\u0439 \u043f\u0430\u043c\u044f\u0442\u0438."
