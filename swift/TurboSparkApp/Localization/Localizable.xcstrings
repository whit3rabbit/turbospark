    "Not indexed yet. Indexing starts when the project is selected.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0644\u0645 \u062a\u062a\u0645 \u0627\u0644\u0641\u0647\u0631\u0633\u0629 \u0628\u0639\u062f. \u062a\u0628\u062f\u0623 \u0627\u0644\u0641\u0647\u0631\u0633\u0629 \u0639\u0646\u062f \u062a\u062d\u062f\u064a\u062f \u0627\u0644\u0645\u0634\u0631\u0648\u0639."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht indiziert. Die Indizierung beginnt, wenn das Projekt ausgew\u00e4hlt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not indexed yet. Indexing starts when the project is selected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A\u00fan sin indexar. La indexaci\u00f3n empieza cuando se selecciona el proyecto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore index\u00e9. L'indexation commence lorsque le projet est s\u00e9lectionn\u00e9."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05e2\u05d3\u05d9\u05d9\u05df \u05dc\u05d0 \u05e2\u05d1\u05e8 \u05d0\u05d9\u05e0\u05d3\u05d5\u05e7\u05e1. \u05d4\u05d0\u05d9\u05e0\u05d3\u05d5\u05e7\u05e1 \u05de\u05ea\u05d7\u05d9\u05dc \u05db\u05e9\u05d4\u05e4\u05e8\u05d5\u05d9\u05e7\u05d8 \u05e0\u05d1\u05d7\u05e8."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0905\u092d\u0940 \u0907\u0902\u0921\u0947\u0915\u094d\u0938 \u0928\u0939\u0940\u0902 \u0939\u0941\u0906 \u0939\u0948\u0964 \u092a\u094d\u0930\u094b\u091c\u0947\u0915\u094d\u091f \u091a\u0941\u0928\u0947 \u091c\u093e\u0928\u0947 \u092a\u0930 \u0907\u0902\u0921\u0947\u0915\u094d\u0938\u093f\u0902\u0917 \u0936\u0941\u0930\u0942 \u0939\u094b\u0924\u0940 \u0939\u0948\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum diindeks. Pengindeksan dimulai saat proyek dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ancora indicizzato. L'indicizzazione inizia quando il progetto viene selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\u307e\u3060\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u3055\u308c\u3066\u3044\u307e\u305b\u3093\u3002\u30d7\u30ed\u30b8\u30a7\u30af\u30c8\u3092\u9078\u629e\u3059\u308b\u3068\u30a4\u30f3\u30c7\u30c3\u30af\u30b9\u4f5c\u6210\u304c\u59cb\u307e\u308a\u307e\u3059\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "\uc544\uc9c1 \uc778\ub371\uc2f1\ub418\uc9c0 \uc54a\uc558\uc2b5\ub2c8\ub2e4. \ud504\ub85c\uc81d\ud2b8\ub97c \uc120\ud0dd\ud558\uba74 \uc778\ub371\uc2f1\uc774 \uc2dc\uc791\ub429\ub2c8\ub2e4."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog niet ge\u00efndexeerd. Het indexeren begint wanneer het project wordt geselecteerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nie zindeksowano. Indeksowanie rozpocznie si\u0119 po wybraniu projektu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda n\u00e3o indexado. A indexa\u00e7\u00e3o come\u00e7a quando o projeto \u00e9 selecionado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0415\u0449\u0451 \u043d\u0435 \u043f\u0440\u043e\u0438\u043d\u0434\u0435\u043a\u0441\u0438\u0440\u043e\u0432\u0430\u043d\u043e. \u0418\u043d\u0434\u0435\u043a\u0441\u0430\u0446\u0438\u044f \u043d\u0430\u0447\u043d\u0451\u0442\u0441\u044f, \u043a\u043e\u0433\u0434\u0430 \u043f\u0440\u043e\u0435\u043a\u0442 \u0431\u0443\u0434\u0435\u0442 \u0432\u044b\u0431\u0440\u0430\u043d."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inte indexerat \u00e4n. Indexeringen startar n\u00e4r projektet v\u00e4ljs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hen\u00fcz dizinlenmedi. Dizinleme, proje se\u00e7ildi\u011finde ba\u015flar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0429\u0435 \u043d\u0435 \u043f\u0440\u043e\u0456\u043d\u0434\u0435\u043a\u0441\u043e\u0432\u0430\u043d\u043e. \u0406\u043d\u0434\u0435\u043a\u0441\u0443\u0432\u0430\u043d\u043d\u044f \u043f\u043e\u0447\u043d\u0435\u0442\u044c\u0441\u044f, \u043a\u043e\u043b\u0438 \u043f\u0440\u043e\u0454\u043a\u0442 \u0431\u0443\u0434\u0435 \u0432\u0438\u0431\u0440\u0430\u043d\u043e."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ch\u01b0a \u0111\u01b0\u1ee3c l\u1eadp ch\u1ec9 m\u1ee5c. Vi\u1ec7c l\u1eadp ch\u1ec9 m\u1ee5c b\u1eaft \u0111\u1ea7u khi d\u1ef1 \u00e1n \u0111\u01b0\u1ee3c ch\u1ecdn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u5efa\u7acb\u7d22\u5f15\u3002\u9009\u62e9\u8be5\u9879\u76ee\u540e\u5c06\u5f00\u59cb\u5efa\u7acb\u7d22\u5f15\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u5c1a\u672a\u5efa\u7acb\u7d22\u5f15\u3002\u9078\u53d6\u8a72\u5c08\u6848\u5f8c\u5c07\u958b\u59cb\u5efa\u7acb\u7d22\u5f15\u3002"
          }
        }
      }
    },
    "Reindex project for the context engine": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0625\u0639\u0627\u062f\u0629 \u0641\u0647\u0631\u0633\u0629 \u0627\u0644\u0645\u0634\u0631\u0648\u0639 \u0644\u0645\u062d\u0631\u0643 \u0627\u0644\u0633\u064a\u0627\u0642"
