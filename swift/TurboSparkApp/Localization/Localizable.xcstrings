    "Prompt to PNG. Requires an attached image model; returns base64 JSON.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0645\u0646 \u0645\u0648\u062c\u0651\u0647 \u0625\u0644\u0649 PNG. \u064a\u062a\u0637\u0644\u0628 \u0646\u0645\u0648\u0630\u062c \u0635\u0648\u0631 \u0645\u064f\u0631\u0641\u0642\u064b\u0627\u060c \u0648\u064a\u0639\u064a\u062f JSON \u0628\u062a\u0631\u0645\u064a\u0632 base64."
          }
        },
        "de": {
