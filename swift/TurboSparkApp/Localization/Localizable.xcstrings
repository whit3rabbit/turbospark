            "value": "Never import or run this server, and do not ask again"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No importar ni ejecutar nunca este servidor y no volver a preguntar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne jamais importer ni exécuter ce serveur, et ne plus demander"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לעולם אל תייבא או תפעיל שרת זה, ואל תשאל שוב"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सर्वर कभी आयात या न चलाएँ, और दोबारा न पूछें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jangan pernah impor atau jalankan server ini, dan jangan tanya lagi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non importare né eseguire mai questo server e non chiedere più"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサーバーを読み込みも実行もせず、今後は確認しない"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 서버를 가져오거나 실행하지 않고 다시 묻지 않기"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze server nooit importeren of uitvoeren en niet meer vragen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nigdy nie importuj ani nie uruchamiaj tego serwera i nie pytaj ponownie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca importar nem executar este servidor e não perguntar de novo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Никогда не импортировать и не запускать этот сервер и больше не спрашивать"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Importera eller kör aldrig den här servern och fråga inte igen"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu sunucuyu asla içe aktarma veya çalıştırma ve bir daha sorma"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ніколи не імпортувати й не запускати цей сервер і більше не питати"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không bao giờ nhập hoặc chạy máy chủ này và không hỏi lại"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
