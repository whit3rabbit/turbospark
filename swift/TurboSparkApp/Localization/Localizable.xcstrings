    "Use a passphrase between 15 and 1,024 characters.": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0627\u0633\u062a\u062e\u062f\u0645 \u0639\u0628\u0627\u0631\u0629 \u0645\u0631\u0648\u0631 \u064a\u062a\u0631\u0627\u0648\u062d \u0637\u0648\u0644\u0647\u0627 \u0628\u064a\u0646 15 \u06481024 \u062d\u0631\u0641\u064b\u0627."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie eine Passphrase mit 15 bis 1.024 Zeichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a passphrase between 15 and 1,024 characters."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una frase de contrase\u00f1a de entre 15 y 1024 caracteres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une phrase secr\u00e8te de 15 \u00e0 1 024 caract\u00e8res."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "\u05d4\u05e9\u05ea\u05de\u05e9 \u05d1\u05d1\u05d9\u05d8\u05d5\u05d9 \u05e1\u05d9\u05e1\u05de\u05d4 \u05d1\u05d0\u05d5\u05e8\u05da 15 \u05e2\u05d3 1,024 \u05ea\u05d5\u05d5\u05d9\u05dd."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "15 \u0938\u0947 1,024 \u0935\u0930\u094d\u0923\u094b\u0902 \u0915\u0947 \u092c\u0940\u091a \u0915\u093e \u092a\u093e\u0938\u092b\u093c\u094d\u0930\u0947\u091c\u093c \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0947\u0902\u0964"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan frasa sandi dengan panjang 15 hingga 1.024 karakter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una passphrase di lunghezza compresa tra 15 e 1.024 caratteri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "15\u301c1,024 \u6587\u5b57\u306e\u30d1\u30b9\u30d5\u30ec\u30fc\u30ba\u3092\u4f7f\u7528\u3057\u3066\u304f\u3060\u3055\u3044\u3002"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "15\uc790\uc5d0\uc11c 1,024\uc790 \uc0ac\uc774\uc758 \uc554\ud638\ub97c \uc0ac\uc6a9\ud558\uc138\uc694."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een wachtzin van 15 tot 1.024 tekens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "U\u017cyj has\u0142a o d\u0142ugo\u015bci od 15 do 1024 znak\u00f3w."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use uma frase secreta com 15 a 1.024 caracteres."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0418\u0441\u043f\u043e\u043b\u044c\u0437\u0443\u0439\u0442\u0435 \u0444\u0440\u0430\u0437\u0443-\u043f\u0430\u0440\u043e\u043b\u044c \u0434\u043b\u0438\u043d\u043e\u0439 \u043e\u0442 15 \u0434\u043e 1024 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Anv\u00e4nd en l\u00f6senfras p\u00e5 mellan 15 och 1 024 tecken."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "15 ile 1.024 karakter aras\u0131nda bir parola kullan\u0131n."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u0439\u0442\u0435 \u0444\u0440\u0430\u0437\u0443-\u043f\u0430\u0440\u043e\u043b\u044c \u0437\u0430\u0432\u0434\u043e\u0432\u0436\u043a\u0438 \u0432\u0456\u0434 15 \u0434\u043e 1024 \u0441\u0438\u043c\u0432\u043e\u043b\u0456\u0432."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "H\u00e3y d\u00f9ng c\u1ee5m m\u1eadt kh\u1ea9u d\u00e0i t\u1eeb 15 \u0111\u1ebfn 1.024 k\u00fd t\u1ef1."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8bf7\u4f7f\u7528 15 \u5230 1,024 \u4e2a\u5b57\u7b26\u7684\u53e3\u4ee4\u3002"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "\u8acb\u4f7f\u7528 15 \u5230 1,024 \u500b\u5b57\u5143\u7684\u5bc6\u8a9e\u3002"
          }
        }
      }
    },
