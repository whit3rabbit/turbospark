<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
The languages the app's MAIN bundle declares. AppKit honors the AppleLanguages
key the in-app language picker writes only for a language listed here, so the
menu bar, system panels and Locale.current stay English without it.

Package.swift embeds this file into the SwiftPM executable (__TEXT,__info_plist)
and scripts/make-app-bundle.sh copies the list into the .app Info.plist.
ProcessLocalizationTests pins the list to AppLanguage.

No CFBundleIdentifier on purpose: in a bare executable it would move the
UserDefaults domain of debug builds away from "TurboSparkApp".
-->
<dict>
    <key>CFBundleDevelopmentRegion</key>
    <string>en</string>
    <key>CFBundleLocalizations</key>
    <array>
        <string>en</string>
        <string>es</string>
        <string>fr</string>
        <string>de</string>
        <string>it</string>
        <string>pt-BR</string>
        <string>ru</string>
        <string>ja</string>
        <string>ko</string>
        <string>zh-Hans</string>
        <string>zh-Hant</string>
        <string>ar</string>
        <string>hi</string>
        <string>nl</string>
        <string>pl</string>
        <string>tr</string>
        <string>uk</string>
        <string>sv</string>
        <string>vi</string>
        <string>id</string>
        <string>he</string>
    </array>
</dict>
</plist>
