{
  "name": "mode-candidate",
  "description": "a kernel mode priced before it is judged: hashed bench curves, a base profile, a null floor, a projection (tslab project) from those, the paired A/B of the mode's switch, then the calibration of the projection against that verdict",
  "requires": ["knob", "candidate"],
  "vars": {"prompt": "protocol:long-synthesis", "decode": "64", "bench": "int4_matmul", "rows": "1,2,4,8", "x": "1"},
  "steps": [
    {"id": "kernels", "command": "kernel",
     "args": {"model": "{model}", "experiment": "{experiment}", "bench": "{bench}", "rows": "{rows}", "hash": true}},
    {"id": "base", "command": "profile", "when": ["runs"],
     "args": {"model": "{model}", "experiment": "{experiment}", "prompt": "{prompt}", "decode": "{decode}", "rounds": 3, "arm": ["base"]}},
    {"id": "null", "command": "ab", "when": ["runs"], "needs": ["base"],
     "args": {"model": "{model}", "experiment": "{experiment}", "prompt": "{prompt}", "decode": "{decode}", "null": true}},
    {"id": "project", "command": "project", "needs": ["kernels", "base", "null"],
     "args": {"knob": "{knob}", "curves": "{experiment}", "x": "{x}", "base-from": "{experiment}:base",
              "floor-from": "{experiment}", "experiment": "{experiment}"}},
    {"id": "ab", "command": "ab", "when": ["runs"], "needs": ["project"],
     "args": {"model": "{model}", "experiment": "{experiment}", "prompt": "{prompt}", "decode": "{decode}",
              "metric": "decode_tok_s", "baseline": "base", "candidate": "cand:{candidate}"}},
    {"id": "calibrate", "command": "calibrate", "needs": ["project", "ab"], "continue_on_error": true,
     "args": {"projection": "{experiment}", "verdict": "{experiment}", "experiment": "{experiment}"}},
    {"id": "report", "command": "report",
     "args": {"experiment": "{experiment}", "html": "{lab}/{experiment}/report.html", "force": true}}
  ]
}
