{
  "model_type": "dramabox-tts",
  "sample_rate": 8000,
  "text_encoder": "tiny-gemma",
  "text_encoder_hidden_size": 8,
  "num_gemma_layers": 3,
  "transformer": {
    "num_layers": 2,
    "audio_num_attention_heads": 4,
    "audio_attention_head_dim": 8,
    "audio_in_channels": 16,
    "audio_out_channels": 16,
    "audio_cross_attention_dim": 32,
    "norm_eps": 1e-06,
