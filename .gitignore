# Cargo build output (large, fully derived from sources).
/target

# macOS Finder metadata.
.DS_Store

# AI
CLAUDE.local.md
.syntext/
.mcp.json
.agent-config-mcp.json
# Local Claude Code state, EXCEPT `.claude/docs/`. That directory holds agent
# context split out of AGENTS.md (the per-family gate matrix, the checkpoint
# installs, the power harness, the cross-engine KL arms, the header probes),
# and it is committed because AGENTS.md links to it: a pointer to a file that
# exists on one machine is a dead link for everyone else. Spelled `.claude/*`
# rather than `.claude/`, because git does not descend into an excluded
# directory and so cannot see a re-include underneath one.
.claude/*
!.claude/docs/
.synrepo/
.zcode/
.codex/
.agents/

# scripts/kld_llamacpp.py imports scripts/kld.py, so running it byte-compiles
# a sibling module here.
__pycache__/

# Local
compile_flags.txt
# Build products the SwiftPM package needs beside its module map. Both are
# COPIED there by `scripts/swift-lib.sh`; the canonical header is
# crates/ffi/include/turbospark.h and the archive is a cargo artifact.
/swift/TurboSpark/Sources/CTurboSpark/libturbospark_ffi.a
/swift/TurboSpark/Sources/CTurboSpark/turbospark.h
/swift/*/.build

# Compiled from swift/TurboSparkApp/Localization/Localizable.xcstrings by
# scripts/compile-strings.sh; that catalog is the source of truth.
/swift/TurboSparkApp/Sources/TurboSparkApp/Resources/*.lproj

# Release staging: TurboSpark.app and the DMG, built by scripts/make-app-bundle.sh
# and scripts/make-dmg.sh (`make dmg`). Fully derived, and large.
/dist
# security-audit output (vulnerability inventory — do not commit)
.security-audit/
# security-audit output (vulnerability inventory — do not commit)
.security-audit/

# mf: pages are committed, the index is derived (managed by mf setup)
mf.sqlite3
mf.sqlite3-*
notes/
.eatahorse*/

.venv/
ig2-work/
.build/